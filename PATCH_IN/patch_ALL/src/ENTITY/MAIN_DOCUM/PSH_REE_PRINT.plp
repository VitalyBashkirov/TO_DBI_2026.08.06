class MAIN_DOCUM;

@check_type_compatibility(false)
@this(create_on_start:=true)
@name('ПСХ. Печать реестра')
@tag('COPIED')
batch method PSH_REE_PRINT is

@name('Дата') public V_DATE_PROV [DATE];
PSH_REE_PRINT (
	@name('Выбор вида реестра') P_CHOICE    in [ONE_FROM_THREE],
	@name('Исполнитель')        P_WORKER    in [USER_REF],
	@name('Контролер')          P_CONTROLER in [USER_REF]
) is

validate is
begin
	if p_message = 'DEFAULT' then
		V_DATE_PROV := this(1).[DATE_PROV];
		P_WORKER := stdlib.user_id;
	else
		null;
	end if;
		
end;

execute is
/*********************************************************************
Назначение:

VCRSJ, последнее изменение 16 Февраль 2002 г.
*********************************************************************/
-- md ref [MAIN_DOCUM];
begin
    if 	  P_CHOICE.[0]=1 Then
    	if this.count > 0 then
	    	::[MAIN_DOCUM].[PSH_PRINT_REE].docs := this;
	    	::[MAIN_DOCUM].[PSH_PRINT_REE].dat := V_DATE_PROV;
	    	::[MAIN_DOCUM].[PSH_PRINT_REE].v_worker := p_worker;
	    	::[MAIN_DOCUM].[PSH_PRINT_REE].v_controler := p_controler;
	  		stdio.put_line_buf('<% CALL MAIN_DOCUM PSH_PRINT_REE '||this(1)%id||'%>');
  		end if;
	ElsIf P_CHOICE.[0]=2 Then
		    ::[MAIN_DOCUM].[PRN_REE_WIDE].docs := this;
			stdio.put_line_buf('<% CALL MAIN_DOCUM PRN_REE_WIDE '||this(1)%id||' %>');
        null;
    ElsIF P_CHOICE.[0]=3 Then
		    ::[MAIN_DOCUM].[PSH_PRINT_REE_P].docs := this;
   	    	::[MAIN_DOCUM].[PSH_PRINT_REE_P].dat := V_DATE_PROV;
	    	::[MAIN_DOCUM].[PSH_PRINT_REE_P].v_worker := p_worker;
	    	::[MAIN_DOCUM].[PSH_PRINT_REE_P].v_controler := p_controler;
 			stdio.put_line_buf('<% CALL MAIN_DOCUM PSH_PRINT_REE_P '||this(1)%id||' %>');
	    null;
	End if;
end;
end;
end;
