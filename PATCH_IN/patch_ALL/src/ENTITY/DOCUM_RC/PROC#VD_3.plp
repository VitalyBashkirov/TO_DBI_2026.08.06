		end loop;
		-- подсветка полей, требующих утверждения
		if this_state = 'S_5' and V_TYPED_COD in ('103', '103+','200', '202') then
			declare
				v_col_fields	varchar2(4000);
				str				varchar2(128);
				num				pls_integer := 1;
			begin
				[STR].get_par(this.[BLOCK_DATA], 'color_fields', v_col_fields);

				if v_col_fields	is not null then
					str := regexp_substr(v_col_fields, '[^,]+', 1, num);
					while (str is not null) loop
						case substr(str, 1, 2) of
						:'13':
							csmd.command(V_VB,'For i = 0 to Grid13C.Rows'
									||NL$||	'	Grid13C.CellBackColor(i, 0, i, 0) = &h00D2D2FF'
									||NL$||	'Next');			
						:'20':
							csmd.command(V_VB, 'txtTRN.BackColor = &h00D2D2FF');
						:'21':
							csmd.command(V_VB, 'txtRef.BackColor = &h00D2D2FF');
						:'23':
							csmd.command(V_VB,'For i = 0 to Grid23E.Rows'
									||NL$||	'	Grid23E.CellBackColor(i, 0, i, 0) = &h00D2D2FF'
									||NL$||	'Next');
						:'26':
							csmd.command(V_VB, 'txt26T.BackColor = &h00D2D2FF');
						:'32':
							case substr(str, 3) of
							:'SUM':
								csmd.command(V_VB, 'txtSumma.BackColor = &h00D2D2FF');
							:'VAL':
								csmd.command(V_VB, 'ft_iso.BackColor = &h00D2D2FF');
							:'DAT':
								csmd.command(V_VB, 'txtDValue.BackColor = &h00D2D2FF');
							end;
						:'33':
							csmd.command(V_VB, 'txt33B.BackColor = &h00D2D2FF');
						:'36':
							csmd.command(V_VB, 'num36.BackColor = &h00D2D2FF');
						:'50':
							case substr(str, 3) of
							:'OPT':
								csmd.command(V_VB, 'txtOpt50.BackColor = &h00D2D2FF');
							:'BNK':
								csmd.command(V_VB, 'code50.BackColor = &h00D2D2FF');
							:'ACC':
								csmd.command(V_VB, 'txtAcc50.BackColor = &h00D2D2FF');
							:'NAME':
								csmd.command(V_VB, 'swt50.BackColor = &h00D2D2FF');
							else
								csmd.command(V_VB, 'txtOpt50.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'code50.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'txtAcc50.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'swt50.BackColor = &h00D2D2FF');
							end;
						:'52':
							case substr(str, 3) of
							:'OPT':
								csmd.command(V_VB, 'txtOpt52.BackColor = &h00D2D2FF');
							:'BNK':
								csmd.command(V_VB, 'pbic.BackColor = &h00D2D2FF');
							:'BACC':
								csmd.command(V_VB, 'txtAcc52.BackColor = &h00D2D2FF');
							:'NAME':
								csmd.command(V_VB, 'swt52.BackColor = &h00D2D2FF');
							else
								csmd.command(V_VB, 'txtOpt52.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'pbic.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'txtAcc52.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'swt52.BackColor = &h00D2D2FF');
							end;
						:'53':
							case substr(str, 3) of
							:'OPT':
								csmd.command(V_VB, 'objOpt53.BackColor = &h00D2D2FF');
							:'BNK':
								csmd.command(V_VB, 'Text90.BackColor = &h00D2D2FF');
							:'ACC':
								csmd.command(V_VB, 'txtAcc53.BackColor = &h00D2D2FF');
							:'NAME':
								csmd.command(V_VB, 'swt53.BackColor = &h00D2D2FF');
							else
								csmd.command(V_VB, 'objOpt53.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'Text90.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'txtAcc53.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'swt53.BackColor = &h00D2D2FF');
							end;
						:'54':
							case substr(str, 3) of
							:'OPT':
								csmd.command(V_VB, 'objOpt54.BackColor = &h00D2D2FF');
							:'BNK':
								csmd.command(V_VB, 'Text98.BackColor = &h00D2D2FF');
							:'ACC':
								csmd.command(V_VB, 'txtAcc54.BackColor = &h00D2D2FF');
							:'NAME':
								csmd.command(V_VB, 'swt54.BackColor = &h00D2D2FF');
							else
								csmd.command(V_VB, 'objOpt54.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'Text98.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'txtAcc54.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'swt54.BackColor = &h00D2D2FF');
							end;
						:'55':
							case substr(str, 3) of
							:'OPT':
								csmd.command(V_VB, 'objOpt55.BackColor = &h00D2D2FF');
							:'BNK':
								csmd.command(V_VB, 'Text105.BackColor = &h00D2D2FF');
							:'ACC':
								csmd.command(V_VB, 'txtAcc55.BackColor = &h00D2D2FF');
							:'NAME':
								csmd.command(V_VB, 'swt55.BackColor = &h00D2D2FF');
							else
								csmd.command(V_VB, 'objOpt55.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'Text105.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'txtAcc55.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'swt55.BackColor = &h00D2D2FF');
							end;
						:'56':
							case substr(str, 3) of
							:'OPT':
								csmd.command(V_VB, 'txtOpt56.BackColor = &h00D2D2FF');
							:'BNK':
								csmd.command(V_VB, 'T_i_bic.BackColor = &h00D2D2FF');
							:'ACC':
								csmd.command(V_VB, 'txtAcc56.BackColor = &h00D2D2FF');
							:'NAME':
								csmd.command(V_VB, 'swt56.BackColor = &h00D2D2FF');
							else
								csmd.command(V_VB, 'txtOpt56.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'T_i_bic.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'txtAcc56.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'swt56.BackColor = &h00D2D2FF');
							end;
						:'57':	
							case substr(str, 3) of
							:'OPT':
								csmd.command(V_VB, 'txtOpt57.BackColor = &h00D2D2FF');
							:'BNK':
								csmd.command(V_VB, 'rbic.BackColor = &h00D2D2FF');
							:'ACC':
								csmd.command(V_VB, 'txtAcc57.BackColor = &h00D2D2FF');
							:'NAME':
								csmd.command(V_VB, 'swt57.BackColor = &h00D2D2FF');
							else
								csmd.command(V_VB, 'txtOpt57.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'rbic.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'txtAcc57.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'swt57.BackColor = &h00D2D2FF');
							end;
						:'58':
							case substr(str, 3) of
							:'OPT':
								csmd.command(V_VB, 'txtOpt58.BackColor = &h00D2D2FF');
							:'BNK':
								csmd.command(V_VB, 'T_r_bic.BackColor = &h00D2D2FF');
							:'ACC':
								csmd.command(V_VB, 'txtAcc59.BackColor = &h00D2D2FF');
							:'NAME':
								csmd.command(V_VB, 'swt59.BackColor = &h00D2D2FF');
							else
								csmd.command(V_VB, 'txtOpt58.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'T_r_bic.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'txtAcc59.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'swt59.BackColor = &h00D2D2FF');
							end;
						:'59':
							case substr(str, 3) of
							:'OPT':
								csmd.command(V_VB, 'txtOpt59.BackColor = &h00D2D2FF');
							:'ACC':
								csmd.command(V_VB, 'txtAcc59.BackColor = &h00D2D2FF');
							:'NAME':
								csmd.command(V_VB, 'swt59.BackColor = &h00D2D2FF');
							else
								csmd.command(V_VB, 'txtOpt59.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'txtAcc59.BackColor = &h00D2D2FF');
								csmd.command(V_VB, 'swt59.BackColor = &h00D2D2FF');
							end;
						:'70':
							csmd.command(V_VB, 'swt70.BackColor = &h00D2D2FF');
						:'71':
							case substr(str, 3) of
							:'A':			
								csmd.command(V_VB, 'T_charges.BackColor = &h00D2D2FF');
							:'G':
								csmd.command(V_VB, 'txt71G.BackColor = &h00D2D2FF');
							:'F':
								csmd.command(V_VB,'For i = 0 to Grid71F.Rows'
										||NL$||	'	Grid71F.CellBackColor(i, 0, i, 0) = &h00D2D2FF'
										||NL$||	'Next');
							end;
						:'72':
							csmd.command(V_VB, 'swt72.BackColor = &h00D2D2FF');
						:'77':
							csmd.command(V_VB, 'swt77B.BackColor = &h00D2D2FF');
						end;
						
						num := num + 1;
						str := regexp_substr(v_col_fields, '[^,]+', 1, num);
					end loop;
				end if;
			end;
		end if;
		
		if ::[TRC].[GET_FLAG]('UFEBS_COS_ED503') then
			V_TO_ED503 := ::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'USE_ED503') or ::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'USE_SPFS');
		end if;		
		
		--		V_VB := V_VB || get_depend_of_type_script(V_TYPED_COD, null, false);
		--stdio.put_line_buf('V_VB=' || V_VB);
							--------------------------'VALIDATE'------------------------------

	elsif P_MESSAGE = 'VALIDATE' then	
		last_error := this.[REFREASON] || this.[REFREASON2]; -- avs при формировании проводки могла случится новая ошибка, поэтому освежим вопрос пользователю
		if P_INFO = '%VAR%.V_PANEL.0' then
			if V_PANEL.[0] = 4 then
				-- Покажем SWIFTовку
				if V_TYPED_COD = 'SWT' then --(kozlova)
					if P_DOPINFO/*replace(replace(ORI_DOC_RC.[DOC_TEXT] || ORI_DOC_RC.[DOPINFO], ';', ' '), 'NO_UPDATE')*/ is null then
						begin
							&sp(sp2)
							::[DOCUM_RC].[SWIFT_LIB].INIT_EXP_FORMAT;
							P_DOPINFO := 'При экспорте в SWIFT будет сформирован следующий текст:' || NL$
								|| ::[DOCUM_RC].[SWIFT_LIB_EXP].get_block_4(this, V_TYPED_COD, ::[TRC].[INI].TODAY, false, null, false,
																			::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'MT103COV'));
						exception when OTHERS then
							&rb(sp2)
						end;
						::[DOCUM_RC].[T_LIB].RESET_ERRS;
					end if;
				else
--<<(kozlova)				
					declare						
						v_temp_errm				[STRING];
						v_temp_first_time		boolean;
						v_temp_last_error		string(1000);
						v_temp_add_rec_com		::[DOCUM_RC].[ADD_REC].COM%size;	
					begin		
						if vTextFirstDoc is not null then					
							P_DOPINFO := 'Текст входящего документа:'||NL$||vTextFirstDoc||NL$||NL$;	
						else
							P_DOPINFO := null;
						end if;	
						if vTextExpDoc is null then
							vTextExpDoc := 'При экспорте в SWIFT будет сформирован следующий текст:'||NL$||get_dopinfo(this); 		
						end if;		
						if P_VAR.[0] = 2 then
							v_temp_errm := V_ERRM;
							v_temp_first_time := first_time;
							v_temp_last_error := last_error;
							v_temp_add_rec_com := ::[DOCUM_RC].[ADD_REC].COM;
							&sp(readdress)
							section_ok;
							if ORI_DOG_IN.[FINTOOL] = P_GET_INPUT.[FINTOOL] and ORI_DOG_OUT.[FINTOOL] = P_GET_OUTPUT.[FINTOOL] then
								this.[READDRESS](V_READDR, NULL, NULL, NULL);
							end if;

							P_DOPINFO := P_DOPINFO||'Текст переадресованного документа:'||NL$||get_dopinfo(this.[NEXT_REF]);	
							
							&rb(readdress)
							V_ERRM := v_temp_errm;
							first_time := v_temp_first_time;
							last_error := v_temp_last_error;
							::[DOCUM_RC].[ADD_REC].COM := v_temp_add_rec_com ;
							new_doc = new_doc_ref := null;	
						else
							P_DOPINFO := P_DOPINFO||vTextExpDoc; 											
						end if;							
					exception when OTHERS then
						&rb(readdress)
					end;
				end if;
--(kozlova)>>										
			end if;
--Переписка
		elsif P_INFO = 'Инфо' then
			stdio.put_line_buf('<% PLPCALL %THIS%.[LOOK_EXT_INFO](%PARAM%.P_MESS_TYPE => ''ExtInfo'')%>');
		elsif P_INFO = '%VAR%.V_INV' then
			if v_inf_inv is not null then
				--Если нет исходного документа, либо исходный документ не в деле, то можно менять дело
				if ::[INVESTIGATION].[LIB].get_inv(V_ORIG_EPD) is not null then
					V_INV  := v_inf_inv;
				end if;
			end if;
			check_open_inv;
			
		elsif P_INFO = '%VAR%.V_ORIG_EPD' then
			--Выбрали исходный документ, необходимо привязать его. Если есть дело, то привязать в дело

			if V_ORIG_EPD is null and v_one_esid then
				V_ORIG_EPD := v_inf_epd;
				stdio.put_line_buf('Невозможно удалить исходный документ ID=' || V_ORIG_EPD%id || ', т.к. он связан с текущим делом №' || v_inf_inv.[NUM_INV]);
			end if;
			V_INV := ::[INVESTIGATION].[LIB].get_inv(V_ORIG_EPD);
			
			if v_inf_inv is not null and V_INV != v_inf_inv and v_esid_inv is not null then
				stdio.put_line_buf('Невозможно указать исходный документ ID=' || V_ORIG_EPD%id || ', т.к. он связан с делом №' || V_INV.[NUM_INV]
								|| ', а обрабатываемый документ является исходным для текущего дела №' || v_inf_inv.[NUM_INV]);
				V_INV := v_inf_inv;
				V_ORIG_EPD := v_inf_epd;
			end if;

			
			if v_inf_inv is not null and V_INV is null and v_esid_inv is not null then
				stdio.put_line_buf('Обрабатываемый документ является исходным по делу №' || v_inf_inv.[NUM_INV] || '. Дело изменено не будет.');
				V_INV := v_inf_inv;
			end if;

			V_ORIG_EPD := ::[DOCUM_RC].[LIB_VIEW].GetLast(V_ORIG_EPD);
			V_ORIG_DOC_NUM := ::[DOCUM_RC].[LIB_QA].get_reference(V_ORIG_EPD);						
			
			if V_INV is null then
				csmd.Set_Validate_Prop( V_VB, 'V_INV', 'V', '.ViewFilter ="1=1" ', true);
			else
				csmd.Set_Validate_Prop( V_VB, 'V_INV', 'V', '.ViewFilter ="ID = '||V_INV%id||'" ', true);
			end if;
			check_open_inv;
--//Переписка		

		elsif P_INFO = 'P_VAR.0' then
			if P_VAR.[0] != 2 then
				V_READDR := null;
			end if;
			
			if P_VAR.[0] = 1 then  --Подтвердить отказ
				V_STATE := 'REJECT';

			elsif P_VAR.[0] = 2 then -- Переадресовать
				V_READDR := ::[DOCUM_RC].[LIB_VAL].get_part_val( this);	
				V_STATE := 'READDR';
				-- если валюта счета проводки по кредиту не совпадает с валютой договора рц по кредиту,
				-- то возможно, уже жали "на проводку" и договор выбрался другой, вернем договор который был
				if acc_rc_fintool != ORI_DOG_OUT.[FINTOOL] then
					P_GET_OUTPUT := nvl(::[TRC].[LIB].get_dog(V_READDR,
															  err_msg,
															  false,
															  ORI_DOG_OUT.[FINTOOL]), P_GET_OUTPUT);
					P_INFO := 'P_GET_OUTPUT';
				end if;
			elsif P_VAR.[0] = 3 then -- Удалить отказ
				V_STATE := 'REJECTED';

			elsif P_VAR.[0] = 5 then --Возврат средств
				V_STATE  := 'REFAUND';

			elsif P_VAR.[0] = 7 then -- На проводку
				if V_SCHEMA is null then
					if P_MAIN_DOC is null and ORI_DOC_RC.[BEGDATE] <= ::[TRC].[INI].TODAY then
						[LIB].create_main_doc(this, false);
						P_MAIN_DOC := this.[MAIN_DOC];
					end if;
				end if;
				V_STATE := 'PROV';
				V_MAIN_DOC := ::[DOCUM_RC].[SWIFT_DOC_LIB].get_docs_list_id( P_MAIN_DOC, this.[QUIT_DOC]);
				acc_rc_fintool := nvl(P_MAIN_DOC.[ACC_KT].[FINTOOL], ORI_DOG_OUT.[FINTOOL]);
				if	acc_rc_fintool != ORI_DOG_OUT.[FINTOOL] or
					P_GET_OUTPUT != ORI_DOG_OUT -- BS00506659 Возможно, уже выбирали вариант "переадресация" и договор РЦ получателя переопределился, поищем его еще раз
				then
					-- если валюта счета проводки по кредиту не совпадает с валютой договора рц по кредиту, поищем договор рц в нужной валюте
					P_GET_OUTPUT := nvl(::[TRC].[LIB].get_dog(/*::[DOCUM_RC].[LIB_VAL].get_part_val(this),*/ P_RCCL, -- BS00478139 avs 29/04/13 при подтверждении документа берем участника на которого он уже идет, а не тот который вычислится - участника надо менять (только?) при переадресации
															  err_msg,
															  false,
															  acc_rc_fintool), P_GET_OUTPUT);
					-- для того, чтобы все завилидировалось по измененому договору кредита
					P_INFO := 'P_GET_OUTPUT';
				end if;
				if P_MAIN_DOC is not null then
					put_to_47416(true); -- BS00132505
				end if;
			end if;

		elsif P_INFO = 'P_VAR.REJECT.CODE' then
			if P_VAR.[REJECT].[REZ] is null then
				P_VAR.[REJECT].[REZ] := P_VAR.[REJECT].[CODE].[NAME];
			end if;
		end if;
		
		-- Переадресация - необходимо перевычислить договора
		if P_INFO = '%VAR%.V_READDR' and V_READDR is not null then
			if ORI_DOC_RC.[TYPE_DOC] in ('001', '005') then
				-- Договор получателя
				P_GET_OUTPUT := nvl(::[TRC].[LIB].get_dog(V_READDR, err_msg, false, P_GET_OUTPUT.[FINTOOL]), P_GET_OUTPUT);
			else
				-- Договор отправителя
				P_GET_INPUT := nvl(::[TRC].[LIB].get_dog(V_READDR, err_msg, true, P_GET_INPUT.[FINTOOL]), P_GET_INPUT);
			end if;
			if err_msg is not null then
				stdio.put_line_buf(err_msg);
			end if;
		end if;

		-- Изменились валюты
		if P_INFO in ('P_GET_INPUT', 'P_GET_OUTPUT') then
			tmp_in_iso := P_GET_INPUT.[FINTOOL];
			tmp_out_iso := P_GET_OUTPUT.[FINTOOL];
			if tmp_in_iso != ORI_ISO and tmp_out_iso != ORI_ISO or P_GET_INPUT is null or P_GET_OUTPUT is null then
				-- вернем прежние значения
				if P_INFO = 'P_GET_INPUT' then
					P_GET_INPUT := in_dog;
				else
					P_GET_OUTPUT := out_dog;
				end if;
			else
				if P_INFO = 'P_GET_INPUT' then
					in_dog := P_GET_INPUT;
					in_iso := tmp_in_iso;
				elsif P_INFO = 'P_GET_OUTPUT' then
					out_dog := P_GET_OUTPUT;
					out_iso := tmp_out_iso;
				end if;
--				16.03.10
				P_RATE := ::[DOCUM_RC].[VCHK_NEW].[CALC_RATE](in_iso, out_iso, &LV.get_date_rate(P_GET_INPUT, P_VALDATE));
				P_BACK_RATE := true;
/*				if P_BACK_RATE then
					P_RATE := 1 / P_RATE;
				end if;*/
--				16.03.10
				
				if tmp_in_iso != tmp_out_iso then
					V_CONV := true;
				else
					V_CONV := false;
				end if;
			end if;
		elsif P_INFO = 'P_BACK_RATE' then
			P_RATE := 1 / P_RATE;
			P_INFO := 'P_RATE';
		end if;
		
		if P_INFO = 'SHOW_AUDIT' then
			stdio.put_line_buf('<% CALL DOCUM_RC AUDIT ' || this%id || '%>');
		end if;
		
		-- Формирование новых проводок
		if P_INFO in ('P_GET_INPUT', 'P_GET_OUTPUT', 'P_RATE', '%VAR%.V_SCHEMA', 'P_UKNOWN') then
		
			if P_INFO = 'P_UKNOWN' then
				-- Решили поставить документ на счет невыясненных сумм
				-- Если поменяли договора, то ставить нельзя
				if P_UKNOWN then
					if in_iso != out_iso then
						-- pragma error('Невозможна постановка на невыяненные с конверсией платежа');	-- avs 25/11/13 BS00584188 не взрываемся, а меняем валюту договора
						ORI_DOG_OUT := P_GET_OUTPUT;
						P_GET_OUTPUT := ::[TRC].[LIB].get_dog(::[TRC].[INI].OUR_PART, err_msg, false, in_iso);
						out_iso := in_iso;
					end if;
					put_to_47416(false); -- BS00132505
				else
					-- На случай, если флаг "Поставлен на невыясненные" сначала установили а потом сбросили
					-- Удалим имеющуюся проводку, дабы не задублироваться
					P_GET_OUTPUT := ORI_DOG_OUT;
					out_iso := ORI_DOG_OUT.[FINTOOL];
					::[DOCUM_RC].[LIB].delete_main_doc(this, true, false, false, 'DELETED');
					P_MAIN_DOC := [LIB].create_main_doc(this);
					::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'UNKNOWN', '');
					this.[DONE] := replace(this.[DONE],';PROV_PAST_WO_QUIT;');
				end if;
			else
				if P_UKNOWN and in_iso != out_iso then
					pragma error('Невозможна постановка на невыясненные с конверсией платежа');
				end if;

				-- Если документ с конверсией от собственного участника и меняется курс, то необходимо перезаполнить поле 36 и 33B
				if P_GET_INPUT.[FINTOOL] <> P_GET_OUTPUT.[FINTOOL] then							-- 16.03.10
					::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'p_rate', P_RATE); 			-- 16.03.10
					::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'p_back_rate', P_BACK_RATE); 	-- 16.03.10
				end if;																			-- 16.03.10
				if P_INFO = 'P_RATE' and P_ISO != P_GET_INPUT.[FINTOOL] and P_GET_INPUT.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'Z') then
					if P_BACK_RATE then
						V_33B_SUM := P_SUMMA / P_RATE;
					else
						V_33B_SUM := P_SUMMA * P_RATE;
					end if;
					-- BFS00032808 Имеет смысл только для МТ103
					if V_TYPED_COD like '103%' then
						P_MT103.[F_36] = this.[MT103].[F_36] := P_RATE;
						V_33B_VAL := P_GET_INPUT.[FINTOOL];
						P_MT103.[F_33B] = this.[MT103].[F_33B] := Get_F33B(V_33B_VAL, V_33B_SUM);
					end if;
					
					-- RP0262042 а операции редактировании документа присутствует следующий блок, удаляюший имеющуюся квитовку:
					if  this.[QUIT_DOC] is not null and this.[MAIN_DOC] is not null then
						if this.[MAIN_DOC].[IN_FOLDER] is not null then
							for		doc
							in		this.[MAIN_DOC].[IN_FOLDER].[DOCS_IN_FOLD]
							where	doc.[DOCUMENT]->([MAIN_DOCUM])[KOD_NAZN_PAY] = ::[KOD_N_PAY]([KOD_NAZN] = 'QUIT_DOC')
								and nvl(trunc(doc.[DOCUMENT]->(MAIN_DOCUM)[DATE_PROV]), ::[SYSTEM].[VARIABLES].OpDate) >= ::[SYSTEM].[VARIABLES].OpDate
							loop
								-- istomin. RP0544705: При комиссии BEN с будущей ДВ квитовок может быть две. Вторая достается из папки платежей.
								doc.[DOCUMENT].[DEL_COMISS](false, true, 'EDIT');
								::[DOCUM_RC].[LIB_1].delete_one(doc.[DOCUMENT], 'Квитовка удалена в связи c изменением даты валютирования', true, this, to_postponed == ::[MAIN_DOCUM].[MD_FUN_ADD].is_postponed_part(P_GET_OUTPUT.[CLIENT]));				
							end loop;
						end if;	
						if nvl(trunc(this.[QUIT_DOC]->(MAIN_DOCUM)[DATE_PROV]), ::[SYSTEM].[VARIABLES].OpDate) >= ::[SYSTEM].[VARIABLES].OpDate then -- RP0540011 квитовку с будущей ДВ тоже удалим
							this.[QUIT_DOC].[DEL_COMISS](false, true, 'EDIT');
							::[DOCUM_RC].[LIB_1].delete_one(this.[QUIT_DOC], 'Квитовка удалена в связи c изменением даты валютирования', true, this, to_postponed == ::[MAIN_DOCUM].[MD_FUN_ADD].is_postponed_part(P_GET_OUTPUT.[CLIENT]));	
							::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'QUIT_EXIST', false); --(kozlova)
						end if;					
					end if;
					
					P_MAIN_DOC := ::[DOCUM_RC].[LIB_VAL].make_prov(this, ORI_ISO, ORI_SUMMA, P_GET_INPUT, in_iso, P_GET_OUTPUT, out_iso, P_RATE, P_BACK_RATE, V_SCHEMA, P_VALDATE, new_summa_doc, true, false, V_33B_SUM);
				else
					if P_VAR.[0] = 7 then
						if P_INFO = 'P_GET_OUTPUT' and acc_rc_fintool <> P_GET_OUTPUT.[FINTOOL] and P_GET_OUTPUT.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'Z') then 	-- если выбрали договор в другой валюте,
							P_MAIN_DOC.[ACC_KT] := null;												-- зачистим счет, иначе make_prov не будет его перевычислять
						end if;
						P_MAIN_DOC := ::[DOCUM_RC].[LIB_VAL].make_prov(this, ORI_ISO, ORI_SUMMA, P_GET_INPUT, in_iso, P_GET_OUTPUT, out_iso, P_RATE, P_BACK_RATE, V_SCHEMA, P_VALDATE, new_summa_doc, true);
						acc_rc_fintool := P_MAIN_DOC.[ACC_KT].[FINTOOL];
						if P_INFO = 'P_GET_OUTPUT' and acc_rc_fintool <> P_GET_OUTPUT.[FINTOOL] then -- если счет в документе не соответствует валюте выбранного догоаора
							P_MAIN_DOC.[ACC_KT] := ::[TRC].[LIB].calculate_acc(P_GET_OUTPUT, null, null, false, 'STRANGE_ACC'); -- заменим его на счет н/с
							acc_rc_fintool := P_GET_OUTPUT.[FINTOOL];
						end if;
					end if;
				end if;
			end if;
			V_MAIN_DOC := ::[DOCUM_RC].[SWIFT_DOC_LIB].get_docs_list_id(P_MAIN_DOC, this.[QUIT_DOC]);
		end if;
		
		if P_INFO = 'OK' and (P_VAR.[0] = 7 or P_VAR.[0] = 2 and
			ORI_DOG_IN.[FINTOOL] != P_GET_INPUT.[FINTOOL] or ORI_DOG_OUT.[FINTOOL] != P_GET_OUTPUT.[FINTOOL])
		then ----Переспрашивание
			section_ok;
		end if;
		
		if ::[RUNTIME].[LOB_UTILS].lob_check_validate_info(P_INFO) then			
			::[RUNTIME].[LOB_UTILS].lob_validate(P_INFO, V_LOB_BUFF, mx_blob);
			return;
		end if;
	end if;
END;


execute is
	v_new_inv		ref [INVESTIGATION];
	v_old_inv		ref [INVESTIGATION];
	v_request_type	ref [INV_STATES];
	v_reverse_type	ref [INV_STATES];
	v_message			string;
	v_rev_message		string;
	v_link_type		ref [RC_LINK_TYPE];
	v_epd 			ref [DOCUM_RC];
	v_inv_type		ref [INV_TYPES];
	v_inv_state		ref [INV_STATES];
	v_cr_inv		ref [INVESTIGATION];
BEGIN
	::[TRC].[LIB_MFIL].check_context(this.[FILIAL]);

	--Статистика обработки
	::[DOCUM_RC].[LIB_NEW].put_sla_event(&METHOD$CLASS, this);
	-- выполним подмену для 007
	if this.[TYPE_DOC] = '007' then
		P_CLINFO := rpad(V_COMMENT, 6*(35 + length(NL$))-length(NL$)) || V_77A;
		P_DEST := V_DOPINFO;
	end if;

    if P_VAR.[0] = 1 then -- Подтвердить отказ
		this.[MAIN_DOC] := P_MAIN_DOC;
		this.[DO_REJECT](P_VAR.[REJECT].[CODE], P_VAR.[REJECT].[REZ]);
	elsif P_VAR.[0] = 2 and ORI_DOG_IN.[FINTOOL] = P_GET_INPUT.[FINTOOL] and ORI_DOG_OUT.[FINTOOL] = P_GET_OUTPUT.[FINTOOL] then -- Переадресовать
		::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'UNKNOWN', ''); -- BS00141341 сбросим признак установки на НС при переадресации
		this.[READDRESS](V_READDR, NULL, NULL, NULL);
	elsif P_VAR.[0] = 3 then -- Удалить отказ
		this.[DELETE_REJ];
	end if;
	
	/*if &LV.is_COM_BEN(P_CHARGE, docum_rc == this) then -- в [BLOCK_DATA] пропишем признак того, что комиссию BEN уже взяли -- а может, и надо...
		::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'TAKE_COM_BEN', true);
	else
		::[RUNTIME].[STR].get_bool_par(this.[BLOCK_DATA], 'TAKE_COM_BEN', true);
	end if;*/
	
	if V_CR_210 then
		::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'MT210', true);
	else
		::[RUNTIME].[STR].get_bool_par(this.[BLOCK_DATA], 'MT210', true);
	end if;

	--RP0013708 Сохранение опций открытия дела
	if V_APP_INV then
		::[DEFVALS].[SLIB].SaveBool(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'P_OPEN_INV',V_OPEN_INV);
		::[DEFVALS].[SLIB].SaveBool(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'P_CREATE_MT195',V_CREATE_MT195);
		::[DEFVALS].[SLIB].SaveBool(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'P_OPEN_INV_INF',V_OPEN_INV_INF);
		--Если включена опция "В дело", то создаем дело
		if V_OPEN_INV and P_UKNOWN and V_INV is null and P_VAR.[0] = 7 then
			::[INVESTIGATION].[CREATE_INV](::[INV_TYPES]([CODE] = 'SWIFT_UNDEF_SUM'), ::[INV_STATES]([CODE] = 'SW_DOC_TO_UNDEF'), this, this.[MAIN_DOC], null, P_NOTES == last_error);
		end if;
	end if;
	
	-- сброс подсветки полей
	if ORI_DOC_RC%state <> this%state then
		::[RUNTIME].[STR].set_par(this.[BLOCK_DATA], 'color_fields', '');
	end if;
			
	if ORI_DOC_RC.[TYPE_DOC] = '007' then
		--Выясним тип запроса
		v_request_type := ::[INVESTIGATION].[LIB].get_state(V_TYPED_COD, P_99_TYPE,v_inf_is_in, v_link_type, v_message);
		v_reverse_type := ::[INVESTIGATION].[LIB].get_rev_state(V_TYPED_COD, P_99_TYPE,v_inf_is_in, v_link_type, v_rev_message);

		if substr(V_TYPED_COD, 2, 2) = '99' then
			::[RUNTIME].[STR].set_par(this.[BLOCK_DATA], 'P_99_TYPE', p_99_type.[0]);	
		end if;
		

		--Отвязываем предыдущий документ, если поменялся, либо был заполнен и удалили
		if v_inf_epd is not null and v_inf_epd != nvl(V_ORIG_EPD,0)  then
			::[DOCUM_RC].[LIB_QA].del_sw_original_epd(this, v_inf_epd, v_link_type);
			if V_APP_INV then
				v_old_inv := ::[INVESTIGATION].[LIB].get_inv_on_rd(this);
				if v_old_inv is not null then
					::[INVESTIGATION].[LIB].proc_swift_inv(v_old_inv,  v_reverse_type, 'MT'||V_TYPED_COD, v_message, this, p_reverse == true);
				end if;						
			end if;
		end if;

		--Сбрасываем флаги множества документов
		if V_ORIG_EPD is not null then
			::[RUNTIME].[STR].set_par(this.[BLOCK_DATA], 'MANY_DOCS', '');
			::[RUNTIME].[STR].set_par(this.[BLOCK_DATA], 'MANY_DOC_IDS', '');

			--Если документ поменялся								
			if 	nvl(v_inf_epd,0) != V_ORIG_EPD then	
	
				--Привязываем исходный новый документ
				v_epd := ::[DOCUM_RC].[LIB_QA].set_sw_original_epd(this, V_ORIG_EPD, v_link_type);
				if V_APP_INV then
					v_new_inv := ::[INVESTIGATION].[LIB].get_inv_on_epd(v_epd);
					::[INVESTIGATION].[LIB].proc_swift_inv(v_new_inv,  v_request_type, 'MT'||V_TYPED_COD, v_message, this);
				end if;		
			end if;				
		end if;
		
		--Привязали новое дело, необходимо привязать документ
		if  nvl(V_INV,0) != nvl(v_inf_inv,0) and V_APP_INV then
			--Если дело привязали ранее, то ничего обрабатываем, иначе привязываем документ к делу
			if v_new_inv is  null then
				--Если дело сменили сначала отвязываем старое
				if v_inf_inv is not null and v_inf_inv != nvl(V_INV,0) then
					::[INVESTIGATION].[LIB].proc_swift_inv(v_inf_inv,  v_reverse_type, 'MT'||V_TYPED_COD, v_rev_message, this, p_reverse == true);
				end if;
				--n99 просто привязываем к делу
				if v_request_type is null then
					--Сообщение уже привязано ранее
					null;
				else
					::[INVESTIGATION].[LIB].proc_swift_inv(V_INV,  v_request_type, 'MT'||V_TYPED_COD, v_message, this);
				end if;
			end if;
		--Если дело не указано, то проверяем опцию открытия дела и создаем его.
		else
			if V_APP_INV and P_VAR.[0] = 7 then		
				if V_OPEN_INV_INF then
					if v_inf_is_in then
						v_inv_type := ::[INV_TYPES]([CODE] = 'SWIFT_IN_REQ');
						v_inv_state := ::[INV_STATES]([CODE] = 'SW_REQ_RECEIVED');
					else
						v_inv_type := ::[INV_TYPES]([CODE] = 'SWIFT_OUT_REQ');
						v_inv_state := ::[INV_STATES]([CODE] = 'SW_REQ_CREATED');
						
					end if;
					
					if ::[DOCUM_RC].[LIB_NEW].is_fin_doc(V_ORIG_EPD.[TYPE_DOC])  then
						::[INVESTIGATION].[CREATE_INV](v_inv_type, v_inv_state, V_ORIG_EPD, V_ORIG_EPD.[MAIN_DOC], this, P_NOTES == last_error);
					else
						v_cr_inv := ::[INVESTIGATION].[CREATE_INV](v_inv_type, v_inv_state, null, null, this, P_NOTES == last_error);	
						if V_ORIG_EPD is not null then
							::[INVESTIGATION].[LIB].proc_swift_inv(v_cr_inv, null, 'MT'||::[DOCUM_RC].[LIB_VIEW].get_type_doc_sform(V_ORIG_EPD), 'Исходное сообщение', V_ORIG_EPD);
						end if;
					end if;
				else
				--Может измениться только тип 99
					if nvl(v_99_type,1) != P_99_TYPE.[0] and P_99_TYPE.[0] in (2,3) then
						::[INVESTIGATION].[LIB].proc_swift_inv(V_INV,  v_request_type, 'MT'||V_TYPED_COD, v_message, this);
					end if;
				end if;
			end if;
		end if;
	end if;

	--Если включено приложение "Расследования SWIFT", документ поставлен на выясненные и включена опция "Создать запрос"
	if V_APP_INV and V_CREATE_MT195 and P_UKNOWN then
		--В качестве шаблона необходимо передать шаблон по умолчанию
		V_CASE.[0] := 4;
	
		stdio.put_line_buf('<% PLPCALL %PARAM%.P_MAIN_DOC.[INF_MES_BY_DOC](%PARAM%.P_DOC_RC_REF => '''|| this%id ||''', %PARAM%.P_CASE => %VAR%.V_CASE )%>' || NL$);	
	end if;
	--//RP0013708

	if P_PRINT then
		stdio.put_line_buf('<% CALL DOCUM_RC PRINT_SWIFT ' || this%id || '%>' || NL$);
	end if;

	--Статистика обработки
	::[DOCUM_RC].[LIB_NEW].put_sla_event_f(&METHOD$CLASS, this);
END;
end;
end;
