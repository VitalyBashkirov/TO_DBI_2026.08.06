--Получение списка трудовой деятельности
public function getWorkActivity(p_msg_struct in out &prx_cit.data2pack_type) return &lib_cl.WorkActivityTable is 
WorkActivity	&lib_cl.WorkActivityTable;
arr_cnt			integer;
arr_cnt2		integer;
cnt				integer;
value			varchar2(2000);
begin
	&i_get_str('WORK_ACTIVITY',1, arr_cnt, value)
	if arr_cnt > 0 then
		for i in 1..arr_cnt
		loop
			&i_get_str('CORP',i, cnt, WorkActivity(i).CORP)
			&i_get_str('INN_CORP',i, cnt, WorkActivity(i).INN_CORP)
			&i_get_str('JOB_ADDRESS',i, arr_cnt2, value)
			if arr_cnt2 > 0 then
				&i_get_str('ADDR_TYPE',1, cnt, WorkActivity(i).JOB_ADDRESS.ADDR_TYPE)
				&i_get_str('COUNTRY',1, cnt, WorkActivity(i).JOB_ADDRESS.COUNTRY)
				&i_get_str('KLADR_CODE',1, cnt, WorkActivity(i).JOB_ADDRESS.KLADR_CODE)
				&i_get_str('POST_CODE',1, cnt, WorkActivity(i).JOB_ADDRESS.POST_CODE)
				&i_get_str('REGION',1, cnt, WorkActivity(i).JOB_ADDRESS.REGION)
				&i_get_str('DISTRICT',1, cnt, WorkActivity(i).JOB_ADDRESS.DISTRICT)
				&i_get_str('CITY_TYPE',1, cnt, WorkActivity(i).JOB_ADDRESS.CITY_TYPE)
				&i_get_str('CITY',1, cnt, WorkActivity(i).JOB_ADDRESS.CITY)
				&i_get_str('STREET',1, cnt, WorkActivity(i).JOB_ADDRESS.STREET)
				&i_get_str('HOUSE',1, cnt, WorkActivity(i).JOB_ADDRESS.HOUSE)
				&i_get_str('KORPUS',1, cnt, WorkActivity(i).JOB_ADDRESS.KORPUS)
				&i_get_str('FLAT',1, cnt, WorkActivity(i).JOB_ADDRESS.FLAT)
				&i_get_str('IMP_STR',1, cnt, WorkActivity(i).JOB_ADDRESS.IMP_STR)
				&i_get_end_coll
			end if;
			&i_get_str('RANGE',i, cnt, WorkActivity(i).RANGE)
			&i_get_date('START_DATE',i, cnt, WorkActivity(i).START_DATE)
			&i_get_str('PHONE',i, cnt, WorkActivity(i).PHONE)
		end loop;
		&i_get_end_coll
	end if;
	return WorkActivity;
end;

/*********************************************************************
Процедуры формирования откликов из структур в формат Интегратора.
Основные процедуры.
*********************************************************************/
--Генерация отклика на создание досье физического лица
public procedure putAnsClPriv(AnsClPriv AnsClPrivType) is 
begin
	-- at: инициализация нужна, для того, что бы в респонс не попадало досье, сформированное cl_priv_ref.[PASS_TO_RETAIL] 
	&out_ini
	&out_put_coll('ANS_CL_PRIV',1)
		&out_put_val('ID_INT',1,AnsClPriv.ID_INT)		--ID в RBO
		&out_put_val('ID_EXT',1,AnsClPriv.ID_EXT)		--ID в IBSO
		&out_put_val('RESULT',1,AnsClPriv.RESULT)		--Результат обработки: accept - клиент создан/обновлен, reject - запрос не обработан
		&out_put_val('MESSAGE',1,AnsClPriv.MESSAGE_)	--Причина отказа  (при RESULT = reject)
	&out_put_end_coll
end;

public procedure doLegalChecksClient(cl_priv_ref ref [CL_PRIV]) is
	type t_checkClient is table of ref [CLIENT];
	v_checkClient	t_checkClient;
	l_check			::[CLIENT].[IS_CL_SUSPECT_L].CLIENT_CHECKS_G_TABLE;
	cv_fpTuneLegalChecksListRef	const ref [FP_TUNE] := ::[FP_TUNE]([GROUP_ID] = 'BSS' and [CODE] = 'BSS_CL_CHECKS');
begin
--	set_debug_pipe('DEBUG_108');

	v_checkClient(1) := cl_priv_ref;

	&start_timer(cv_legalChecksTimerCode)
	for (
		 select x(rownum	:c_num
		 		 ,c			:c_id
		 		 ,c.[NAME]	:c_name
		 		 ,c.[CODE]	:c_code
		 )
		 in (::[FP_TUNE] :x)
		  , (::[CLIENT_CHECKS] :c)
		 where x = cv_fpTuneLegalChecksListRef
		   and x.[VALUES].[VALUE] = '1'
		   and c = cast_to([FP_TUNE_VAL_REF], x.[VALUES]%id).[GET_CANON](1)
		)
	loop
		-- TERROR_LIST проверяется автоматом при создании клиента - тут не реализовываю
		if x.c_code in ('LIST_OON', 'BLACKLIST', 'DENY_LIST', 'LIST_CONTR_PERS', 'LIST_FOREIGN_AG', 'LIST_ILLEGAL_CONTR', 'NOCONSENT_LIST', 'OFAC_LIST') then
			l_check(x.c_num)%id			:= x.c_id;
			l_check(x.c_num).[NAME]		:= x.c_name;
			l_check(x.c_num).[CODE]		:= x.c_code;
			l_check(x.c_num).[CHOOSE]	:= true;

			declare
				l_choice		[ONE_FROM_THREE];
			begin
				l_choice.[0] := 1;	-- только выделенных клиентов
				::[CLIENT].[IS_CL_SUSPECT_L].V_MAIN_STREAM := true;
				v_checkClient.[IS_CL_SUSPECT_L]( P_CHECKS			== l_check
												,P_CALL_METH		== &METHOD$ID
												,P_CHOICE_CLIENT	== l_choice
												,P_BRANCH			== null
												,P_CHECK_BANK		== null
												,P_NEED_CHECK		== null
												,P_MANUAL			== null
												,P_FULL_LOG			== false
												,P_LOG2PIPE			== false
												);
			end;
		elsif x.c_code = 'FREEZE_LIST' then
			declare
				l_choice	[CASE_BETWEEN_TWO];
			begin
				l_choice.[0] := 1;	-- только выделенных клиентов
				::[CLIENT].[IS_CL_FREEZE].V_MAIN_STREAM := true;
				v_checkClient.[IS_CL_FREEZE](P_CHOICE	== l_choice
											,P_FILIAL	== null
											,P_TERR_TAB	== null
											,P_DIS_INT == false
											);
			end;
		elsif x.c_code = 'TERR_ADDRESS' then
			declare
				l_choice		[ONE_FROM_THREE];
			begin
				l_choice.[0] := 1;	-- только выделенных клиентов
				::[CLIENT].[IS_ADDR_SUSPECT].V_MAIN_STREAM := true;
				v_checkClient.[IS_ADDR_SUSPECT]( P_CHOICE	== l_choice
												,P_FILIAL	== null
												,P_TERR_TAB	== null
												,P_LOG2PIPE == false
												);
			end;
		end if;
	end loop;
	&finish_timer(cv_legalChecksTimerCode)
end;


/** Установить стартовую точку отсчета таймера.  Если таймер не существует, он будет создан.
 * @param p_timer_code	Код таймера
 */
public procedure start_timer(p_timer_code varchar2(64)) is
begin
	v_timers(p_timer_code).stime := utils.get_time;
end;

/**
 * Завершение измерения времени. Если таймер не существует, он будет создан с нулевым временем работы.
 * @param p_timer_code	Код таймера
 * @param p_agg			Признак добавления результата к предыдущим измерениям и увеличения счётчика выполнений таймера
 */
public procedure finish_timer(p_timer_code varchar2(64), p_agg boolean := false) is
	v_timer t_timer_rec;
	function getInterval return number is
		v_finish number;
	begin
		if v_timer.stime is null then
			return 0;
		end if;
		v_finish := utils.get_time;	-- utils.get_time циклично возвращает миллисекунды с -2147483648 по 2147483647.
		-- Если при текущем измерении был переход на следующую итерацию, надо внести корректировку.
		return (v_finish - v_timer.stime)  + case when v_timer.stime <= v_finish then 0 else 4294967296 end;
	end;
begin
	if p_timer_code is not null and v_timers.exists (p_timer_code) then
		v_timer := v_timers(p_timer_code);
	end if;
	v_timer.ttime := getInterval + case when p_agg then nvl(v_timer.ttime,0) else 0 end;
	v_timer.tcount := 1 + case when p_agg then nvl(v_timer.tcount,0) else 0 end;
	v_timers(p_timer_code) := v_timer;
end;

/**
 * Получить время работы таймера в миллисекундах
 * @param p_timer_code	Код таймера
 */
public function get_timer(p_timer_code varchar2(64)) return number is
begin
	if p_timer_code is not null and v_timers.exists(p_timer_code) then
		return v_timers(p_timer_code).ttime;
	end if;
	return null;
end;

/**
 * Установить время работы таймера в миллисекундах
 * @param p_timer_code	Код таймера
 * @param p_time		Время работы таймера в миллисекундах
 */
public procedure set_timer(p_timer_code varchar2(64), p_time number) is
begin
	v_timers(p_timer_code).ttime := p_time;
end;


/* Инициализация */
begin
	timerCodeTable(1) := cv_legalChecksTimerCode;
	timerCodeTable(2) := cv_findClientTimerCode;
	timerCodeTable(3) := cv_updateClientTimerCode;
	timerCodeTable(4) := cv_regClientTimerCode;
	timerCodeTable(5) := cv_callHookTimerCode;

	timerCodeTable(6) := cv_deqTimerCode;
	timerCodeTable(7) := cv_enqTimerCode;
	timerCodeTable(8) := cv_recTimerCode;
	timerCodeTable(9) := cv_xinTimerCode;
	timerCodeTable(10) := cv_getTimerCode;
	timerCodeTable(11) := cv_intTimerCode;
	timerCodeTable(12) := cv_pckTimerCode;
	timerCodeTable(13) := cv_xouTimerCode;
end;

end;
