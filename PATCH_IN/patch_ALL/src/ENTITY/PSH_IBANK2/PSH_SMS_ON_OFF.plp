class PSH_IBANK2;

@name('[ПСБ] Подключить/Отключить СМС информирование')
method PSH_SMS_ON_OFF is
dp integer:=0;	--управление debug_pipe

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

fmt	string(10):='dd/mm/yyyy';
PSH_SMS_ON_OFF (
	@name('Подключить') P_ON   in [BOOLEAN],
	@name('С даты')     P_DATE in [DATE]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE := [SYSTEM]::[OP_DATE];
end if;
-- End initialization of parameters and variables
	begin
		if P_MESSAGE = 'DEFAULT' then
			P_ON:=true;
		end if;
	end;
end;

execute is
/*********************************************************************
Назначение:

bashkirov, последнее изменение 5 Октябрь 2018 г.
*********************************************************************/
fl_add boolean:=true;
msg string(1000);
NewProp ref [PROPERTIES];
begin
	msg:='Договор №'||this.[NUM_DOG]||' от '||to_char(this.[DATE_OPEN],fmt)||' '||trim(this.[CLIENT].[NAME],'.');
	
	if this.[CLIENT]%class in ('CL_PRIV','CL_ORG') then null;
	else pragma error('Операция предназначена только для Клиентов - Юридических или Физических лиц!');
	end if;
	
	if P_DATE is null then
		if P_ON then pragma error('Укажите дату подключения СМС информирования Клента!');
		else		 pragma error('Укажите дату отключения СМС информирования Клента!');
		end if;
	end if;
	
	if P_ON then
		for ap in this.[CLIENT].[ADD_PROP]
		where ap.[GROUP_PROP]=::[PROPERTY_GRP]([CODE]='SMS_IBANK2') --Платная услуга СМС
		    and (nvl(ap.[DATE_BEG],P_DATE)<=P_DATE and P_DATE<=nvl(ap.[DATE_END],P_DATE))
		order by ap.[DATE_BEG]
		loop
			fl_add:=false;
			msg:=msg||LF$||'Найдено доп.свойство "'||ap.[GROUP_PROP].[NAME]||'"'||LF$||
				iif(ap.[DATE_BEG] is not null,' Дата начала действия '   ||to_char(ap.[DATE_BEG],fmt),'')||LF$||
				iif(ap.[DATE_END] is not null,' Дата окончания действия '||to_char(ap.[DATE_END],fmt),'')||LF$||
				iif(ap.[BOOL],' Подключена',' Отключена')||LF$;
				
			if ap.[DATE_BEG] is null then
				ap.[DATE_BEG]:=P_DATE;
				msg:=msg||'Откорректирована Дата начала действия '||to_char(ap.[DATE_BEG],fmt)||LF$;
			end if;
			if   ap.[BOOL] then   msg:=msg||'Услуга уже подключена!'||LF$||LF$;
			else
				ap.[BOOL]:=true; 				                       msg:=msg||'Услуга ПОДКЛЮЧЕНА!'||LF$;
				if ap.[DATE_END] is not null then ap.[DATE_END]:=null; msg:=msg||'СБРОШЕНА Дата окончания действия!'||LF$||LF$; end if;
			end if;
		end loop;
		
		if fl_add then
			NewProp:=this.[CLIENT].[ADD_PROP].NEW#AUTO(
				P_DATE,	--Дата начала действия
				null,	--Дата окончания действия
				::[PROPERTY_GRP]([CODE]='SMS_IBANK2'),	--Группа свойств
				null, 	--Свойство
				null,	--Текстовое значение
				null,	--Числовое значение
				null,	--Значение Даты
				null,	--Разрешать пустые значения
				true,	--Логическое значение
				null);	--Значение. Ссылка
				
			msg:=msg||LF$||'ДОБАВЛЕНО доп.свойство "'||NewProp.[GROUP_PROP].[NAME]||'"'||LF$||
				iif(NewProp.[DATE_BEG] is not null,'Дата начала действия '   ||to_char(NewProp.[DATE_BEG],fmt),'')||LF$||
				'Услуга ПОДКЛЮЧЕНА!'||LF$||LF$;
		end if;
	else
		for ap in this.[CLIENT].[ADD_PROP]
		where ap.[GROUP_PROP]=::[PROPERTY_GRP]([CODE]='SMS_IBANK2') --Платная услуга СМС
			and (nvl(ap.[DATE_BEG],P_DATE)<=P_DATE and P_DATE<=nvl(ap.[DATE_END],P_DATE))
		order by ap.[DATE_BEG]
		loop
			fl_add:=false;
			msg:=msg||LF$||'Найдено доп.свойство "'||ap.[GROUP_PROP].[NAME]||'"'||LF$||
				iif(ap.[DATE_BEG] is not null,' Дата начала действия '   ||to_char(ap.[DATE_BEG],fmt),'')||LF$||
				iif(ap.[DATE_END] is not null,' Дата окончания действия '||to_char(ap.[DATE_END],fmt),'')||LF$||
				iif(ap.[BOOL],' Подключена',' Отключена')||LF$;
				
			ap.[DATE_END]:=P_DATE;		                                      msg:=msg||'Откорректирована Дата окончания действия '||to_char(ap.[DATE_END],fmt)||LF$;
			if ap.[DATE_BEG]>ap.[DATE_END] then ap.[DATE_BEG]:=ap.[DATE_END]; msg:=msg||'Откорректирована Дата начала действия '||to_char(ap.[DATE_BEG],fmt)||LF$; end if;

			if   ap.[BOOL] then ap.[BOOL]:=false; msg:=msg||'Услуга ОТЛЮЧЕНА!'||LF$||LF$;
			else  								  msg:=msg||'Услуга уже отключена!'||LF$||LF$;
			end if;
		end loop;
		
		if fl_add then
			msg:=msg||LF$||'НЕТ НЕОБХОДИМОСТЬ ДОБАВЛЯТЬ доп.свойство '||::[PROPERTY_GRP]([CODE]='SMS_IBANK2').[NAME]||LF$||
				'Дата начала действия '   ||to_char(P_DATE,fmt)||LF$||
				'Дата окончания действия '||to_char(P_DATE,fmt)||LF$||
				'Услуга не подключалась!'||LF$||LF$;
		end if;
	end if;
	debug_pipe(msg,dp);
end;
end;
end;
