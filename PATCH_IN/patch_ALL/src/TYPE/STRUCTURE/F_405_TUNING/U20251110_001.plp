class F_405_TUNING;

@generate_ansi_joins(true)
@name('Создание профиля настроек отчета 0409405 в редакции 7047-У')
library U20251110_001
is

pragma include(::[REPS_DATA].[LIB_VIEW]);
pragma include(::[RUNTIME].[LIB_MACRO]);

pragma macro(rt,		'::[REPS_TUNING].[SLIB]');
pragma macro(lib_fill,	'::[REPS_TUNING].[LIB_FILL]');
pragma macro(upd_prof,	'::[REPS_TUNING].[UPD_PROF]');
pragma macro(formula,	'::[REPS_TUNING].[LIB_FORMULA]');
pragma macro(lc,		'::[REPS_TUNING].[LIB_CONV]');
pragma macro(lp,		'::[REPS_TUNING].[LIB_PARAM]');
pragma macro(lib_str,	'::[REPS_DATA].[SLIB_STR_PAPAM]');
pragma macro(lib_type,	'::[REPS_DATA].[LIB_TYPE]');
pragma macro(str,		'::[RUNTIME].[STR]');
pragma macro(wm,		'::[REPS_TUNING].[UPD_PROF].PrintMsg([1], lvLogType)', substitute);

-- Структура профиля
lcrecFillInfo	const		&lib_fill.recFill	:=	::[F_405_TUNING].[FILL_013].GetFillInfo;
-- Соответствующее стандартное заполнение
lcvFillCode		const	varchar2(16)		:=	'FILL_013';
-- Ссылка на отчет
lcrRep			const	ref	[REPS]				:=	::[REPS].[SLIB].rp('F_405');
-- Предыдущее указание (доступное для конвертации)
lcvOldUkaz		const		varchar2(50)		:=	'6800';
-- описание сути изменений, происходящих при выполнении операции конвертации
lcvDescription	const		varchar2(4000)		:=	'Настройки и конфигурация профиля будут скопированы из профиля-источника."&vbCrLf&"В новом профиле будут изменены настройки на основании Указания 7047-У: изменено наименование существующих настроек с кодами 1, 1.1, 1.2."&vbCrLf&""&vbCrLf&"В созданном профиле настроек обновляется список операций конфигурации и шаблон печати."&vbCrLf&""&vbCrLf&"Дата начала действия профиля - 01.01.2026.';
-- описание требований к профилю или настройкам для возможности выполнения над ним операции конвертации
lcvRequirement	const		varchar2(4000)		:=	'Конвертация возможна для профилей, созданных на основании 6800-У, в которых присутствует хотя бы одна настройка.';

-- Максимальный размер для наименования аналитического признака
lcAnalyticSize	const		number	:= ::[ANALYTIC_CODE].[NAME]%size;

-- Структура хранящая данные по типам фильтра настроек. Ключом является "<код настройки>|<код категории выборки>"
type map_TuneFilters is table of &lc.tpRecordTunPatt index by varchar2(257);

-- структура значения шаблона
type rec_ValPatt is record
		(
			vPrefix		varchar2(32767)	-- префикс значения шаблона (слева от основной части)
		,	vBase		varchar2(32767)	-- основная часть значения шаблона (числовая)
		,	vPostfix	varchar2(32767)	-- постфикс значения шаблона (справа от основной части)
		);

-- Вариант вывода сообщений
lvLogType		varchar2(4)	:=	'CONV';
-- Перечень настроек уже существующих в редактируемом профиле над которыми не нужно выполнять действия по преобразованию
lmSkipTun		&lib_type.map_int;
-- Данные по фильтрам настроек
lmTuneFilters	map_TuneFilters;


/**
 * Функция для идентификации операции в качестве конвертации
 * 
 * @return:	'1' в случае, если является операцией конвертации, у прочих операций такой функции быть не должно
 */
public function IsUpd
	return	varchar2(1)
is
begin
	return '1';
end;


/**
 * Получение описания операции конвертации
 * 
 */
public procedure GetUpdInfo
is
	recUpdInfo	&upd_prof.UPD_INFO;
begin
	-- Заполнение полей для отображения информации об операции конвертации:
	-- описание требований к профилю или настройкам для возможности выполнения над ним операции конвертации
	recUpdInfo.vRequirement	:=	lcvRequirement;
	-- описание сути изменений, происходящих при выполнении операции конвертации
	recUpdInfo.vDescription	:=	lcvDescription;
	-- номера указаний, для которых может быть выполнена операция конвертации; если #, то для любых версий
	recUpdInfo.vNumIn		:=	'#' || lcvOldUkaz || '#';
	-- номер указания целевого профиля, если таковой создается в результате конвертации
	recUpdInfo.vNumOut		:=	lcrecFillInfo.vProfVers;
	-- признак создания профиля при выполнении операции конвертации
	recUpdInfo.bCreateProf	:=	true;
	-- отчет (для определения принадлежности конвертации, если в ТБП настройки для нескольких отчетов)
	recUpdInfo.rRep			:=	lcrRep;

	-- инициализация данных в интерфейсной операции обновления
	&upd_prof.SetUpdInfo(recUpdInfo);
end;


/**
 * Получение кода предыдущего нормативного акта
 * 
 * @return:	Код предыдущего нормативного акта
 */
public function GetOldUkaz
	return	varchar2(50)
is
begin
	return lcvOldUkaz;
end;


/**
 * Получение кода нового нормативного акта
 * 
 * @return:	Код нового нормативного акта
 */
public function GetNewUkaz
	return	varchar2(50)
is
begin
	return lcrecFillInfo.vProfVers;
end;


/**
 * Получение даты нового нормативного акта
 * 
 * @return:	Дата нового нормативного акта
 */
public function GetUkazDate
	return	date
is
begin
	return lcrecFillInfo.recProf.[DATE_BEGIN];
end;


/**
 * Проверка профиля на возможность конвертации
 * 
 * @param	P_PROF:				Профиль настроек
 * @param	P_CHECK_ALL:		Признак выполнения всех проверок для получения полной информации о соответствии профиля требованиям операции конвертации
 * 							(в обычной ситуации проверка будет выполняться до первого несоответствия)
 * @param	P_FROM_AUTO_CONV:	Признак проверки из автоматической конвертации
 * @param	P_CHECK_PROF_UDP:	Признак проверки профиля на конвертируемость
 * 
 * @return:	результат прохождения проверок: '1' - пройдены, '0' - не пройдены.
 */
public function CheckProf
					(
						P_PROF				ref	[REPS_PROF_TUN]
					,	P_CHECK_ALL				boolean	:=	false
					,	P_FROM_AUTO_CONV		boolean	:=	false
					,	P_CHECK_PROF_UDP		boolean	:=	false
					)
	return	varchar2(1)
is
	tiCheckList		&upd_prof.CHECK_LIST;
	recCheckParams	&upd_prof.CHECK_PARAMS;

	vRet	varchar2(1)	:=	'1';
begin
	-- проверка актуальности профиля
	recCheckParams.bCheckDateClose	:=	P_FROM_AUTO_CONV;
	-- проверка на возможность обновления профиля
	recCheckParams.bIsProfUpdatable	:=	P_CHECK_PROF_UDP;
	-- проверка наличия настроек в профиле
	recCheckParams.vTunesStr		:=	'%';
	-- проверка профиля на указание
	recCheckParams.vUkaz			:=	'#' || lcvOldUkaz || '#';
	recCheckParams.vProfUkaz		:=	'#' || ::[REPS_PROF_TUN].[SLIB].GetUkaz(P_PROF) || '#';

	-- выполнение проверок
	vRet := &upd_prof.CheckProf(P_PROF, recCheckParams, P_CHECK_ALL, tiCheckList);

	-- возвращаемые значения
	&upd_prof.SetCheckList(tiCheckList);

	return vRet;
end;


-- Проверка существования ссылки на настройку и вывод информации в лог при ее отсутствии
function IsExistTune
			(
				P_TUNE	ref	[REPS_TUNING]
			,	P_CODE		varchar2(30)
			)
	return	boolean
is
begin
	if P_TUNE is null then
		&wm('	Настройка [' || P_CODE || '] не найдена!');
		return false;
	end if;

	return true;
end;


-- Проверка нужно пропускать обработку настройки или нет
function IsSkipTune
			(
				P_TUNE	ref	[REPS_TUNING]
			)
	return	boolean
is
begin
	-- Если не передана ссылка на настройку, то не пропускать ее обработку
	if P_TUNE is null then
		return false;
	end if;
	-- Если настройка должна быть пропущена при обработке
	if lmSkipTun.exists(P_TUNE.[CODE]) then
		&wm('Настройка [' || P_TUNE.[CODE] || '] пропущена при обработке.');
		return true;
	end if;
	-- Проверить родительскую настройку
	-- Рекурсия
	return IsSkipTune(P_TUNE.[PARENT]);
end;


-- Проверка возможности внесения изменений по настройке
function IsEditableTune
			(
				P_TUNE	ref	[REPS_TUNING]
			,	P_CODE		varchar2(30)
			)
	return	boolean
is
begin
	if		IsExistTune(P_TUNE, P_CODE)
		and	not IsSkipTune(P_TUNE)
	then
		return true;
	end if;

	return false;
end;





-- Изменение параметров настройки
procedure EditTune	(
						-- Профиль настройки
						P_PROF				ref	[REPS_PROF_TUN]
					,	-- Ссылка на настройку
						P_TUN				ref	[REPS_TUNING]
					,	-- Код настройки
						P_TUN_CODE				varchar2(30)
					,	-- Новое значение кода настройки
						P_NEW_CODE				varchar2(30)	default null
					,	-- Новое значение наименования настройки
						P_NEW_NAME				varchar2(1000)	default null
					,	-- Новое значение признака для расчета
						P_NEW_CALC				varchar2(1)		default null
					,	-- Новое значение кода для формул
						P_NEW_FCODE				varchar2(30)	default null
					,	-- Новое значение формулы
						P_NEW_FORM				varchar2(2000)	default null
					,	-- Новое значение для признака редактируемая настройка или нет
						P_NEW_EDITABLE			varchar2(1)		default null
					,	-- Новое значение для признака неограниченной точности
						P_NEW_ACCUR				varchar2(1)			default null
					,	-- Изменение значения архивная настройка или нет
						P_NEW_ARCH				varchar2(1)		default null
					,	-- Новое значение родительской настройки
						P_NEW_PARENT_CODE		varchar2(30)	default null
					,	-- Строка содержащая перечень изменений в подзкаске настройки и в подсказках по типам фильтров
						P_NEW_PURP				varchar2(128)	default null
					,	-- Признак определяющий необходимость изменений в описании аналитического признака
						P_CHG_AC				boolean			default false
					,	-- Признак определяющий необходимость изменений настройки при ситуации когда изменяется код настройки на тот, который уже существует в профиле
						P_CHANGE_EXST_TUN		boolean			default false
					,	-- Код предыдущей настройки для корректировки сортировки настроек
						P_PREV_CODE_FOR_ORDER	varchar2(30)	default null
					,	-- Новое значение для маски вывода
						P_NEW_OUTPUT_MASK		varchar2(32767)	default null
					)
is
	-- Ссылка на обрабатываемую настройку
	rTun		ref	[REPS_TUNING];
	rTunNew		ref	[REPS_TUNING];
	rTunParent	ref	[REPS_TUNING];
	rAC			ref	[ANALYTIC_CODE];
	bCalc			boolean;
	vInfo			::[REPS_TUNING].[INFO]%type;
	bAccur			boolean;
	vInfoName		varchar2(128);
	vInfoParam		varchar2(2000);
	nOrder			number;
begin
	&wm('	Выполнение изменения настройки [' || P_TUN_CODE || ']:');

	-- Получить ссылку на настройку по коду
	rTun	:= P_TUN;

	-- Если необходимо изменить код настройки
	if P_NEW_CODE is not null then
		-- Проверить чтобы в данном профиле отсутствовала настройка с указанным новым кодом
		rTunNew := &lc.FindTun(P_PROF, P_NEW_CODE);

		-- Если такая настройка уже есть
		if rTunNew is not null then
			&wm('		При попытке изменении кода настройки на [' || P_NEW_CODE || '] в данном профиле уже существует настройка с таким кодом.');
			-- Изменить существующую настройку
			if P_CHANGE_EXST_TUN then
				&wm('		Изменения коснуться настройки [' || P_NEW_CODE || '], а настройка [' || P_TUN_CODE || '] останется без изменений.');
				rTun := rTunNew;
			else
				lmSkipTun(P_NEW_CODE)	:= 1;
				&wm('	Изменения по настройке [' || P_TUN_CODE || '] не выполнены.');
				return;
			end if;
		end if;
	end if;

	-- Если указанан предыдущая настройка для корректировки сортировки
	if P_PREV_CODE_FOR_ORDER is not null then
		select	x	(max(x.[ORDER]))
		in		::[REPS_TUNING] all
		where	x.[PROF] = P_PROF
			and	upper(x.[CODE]) like upper(P_PREV_CODE_FOR_ORDER)
			and	x.[ORDER] is not null
		into	nOrder;

		if nOrder is not null then
			nOrder	:= nOrder + 0.0001;
		end if;
	end if;

	-- если изменяется родительская настройка
	if		P_NEW_PARENT_CODE is not null
		and	P_NEW_PARENT_CODE <> 'null'
	then
		rTunParent := &lc.FindTun(P_PROF, P_NEW_PARENT_CODE);
	end if;

	-- если изменяется признак для расчета
	if P_NEW_CALC is not null then
		-- Имеет значение либо "true", либо null
		bCalc := char_bool(replace(P_NEW_CALC, '0'));
	else
		bCalc	:= rTun.[CALC];
	end if;

	-- если изменяется признак неограниченной точности
	if P_NEW_ACCUR is not null then
		-- Имеет значение либо "true", либо null
		bAccur	:= char_bool(replace(P_NEW_ACCUR, '0'));
	else
		bAccur	:= rTun.[ACCUR];
	end if;

	-- если изменяется признак редактируемости настройки
	if		P_NEW_EDITABLE is not null
		-- Или изменяются подсказка по настройке или подсказки по фильтрам
		or	P_NEW_PURP is not null
		-- или изменяется маска вывода
		or	P_NEW_OUTPUT_MASK is not null
	then
		for	(
				select	x	(
								x.[INFO]	:	C_INFO
							)
				in		::[REPS_TUNING] all
				where	x = rTun
			)
		loop
			vInfo := x.C_INFO;
			-- При изменении признака нередактируемости настройки
			if P_NEW_EDITABLE is not null then
				&str.Set_par(vInfo, 'NOT_EDITABLE', P_NEW_EDITABLE);
			end if;

			-- При изменении описаний к типам фильтров
			if P_NEW_PURP is not null then
				-- Цикл по всем параментрам описанным в строке "P_NEW_PURP"
				for		i
					in	1 .. 30
				loop
					vInfoName := &str.Get_par_name(P_NEW_PURP, i);
					exit when vInfoName is null;
					-- Получить значение параметра
					&str.Get_par(P_NEW_PURP, vInfoName, vInfoParam);

					if vInfoParam = 'NULL' then
						-- Удалить из информационной строки описание по данному фильтру
						vInfoParam	:= &str.Get_str_par(vInfo, vInfoName, true);
					else
						&str.Set_par(vInfo, vInfoName, vInfoParam);
					end if;
				end loop;
			end if;

			-- При изменении маски вывода
			if P_NEW_OUTPUT_MASK is not null then
				if P_NEW_OUTPUT_MASK = 'NULL' then
					-- Удалить из информационной строки старую маску вывода
					&str.Set_par(vInfo, 'OUT_MASK', '');
				else
					&str.Set_par(vInfo, 'OUT_MASK', P_NEW_OUTPUT_MASK);
				end if;
			end if;
		end loop;
	end if;

	if		P_NEW_CODE			is not null
		or	P_NEW_NAME			is not null
		or	P_NEW_CALC			is not null
		or	P_NEW_FCODE			is not null
		or	P_NEW_FORM			is not null
		or	P_NEW_EDITABLE		is not null
		or	P_NEW_PARENT_CODE	is not null
		or	P_NEW_ACCUR			is not null
		or	P_NEW_PURP			is not null
		or	P_NEW_OUTPUT_MASK	is not null
	then
		-- Обновить параметры настройки
		update	t	(
						t.[CODE]	=	coalesce(&set_null(P_NEW_CODE), t.[CODE])
					,	t.[NAME]	=	coalesce(&set_null(P_NEW_NAME), t.[NAME])
					,	t.[CALC]	=	bCalc
					,	t.[F_CODE]	=	coalesce(&set_null(P_NEW_FCODE), t.[F_CODE])
					,	t.[FORMULA]	=	(
											case
												-- При необходимости обнуления формулы в качестве входного параметра передается значение "null"
												when P_NEW_FORM = 'null' then
													null
												else
													coalesce(&set_null(P_NEW_FORM), t.[FORMULA])
											end
										)
					,	t.[PARENT]	=	(
											case
												-- При необходимости обнуления ссылки на родительскую настройку в качестве входного параметра передается значение "null"
												when P_NEW_PARENT_CODE = 'null' then
													null
												else
													coalesce(rTunParent, t.[PARENT])
											end
										)
					,	t.[INFO]	=	coalesce(&set_null(vInfo), t.[INFO])
					,	t.[ACCUR]	=	bAccur
					,	t.[ORDER]	=	coalesce(nOrder, t.[ORDER])
					)
		in		::[REPS_TUNING] all
		where	t = rTun;
	end if;

	-- Если нужны изменения в аналитическом признаке (при изменении в коде, в наименовании или в признаке архивности настройки и наличии типов фильтров)
	if P_CHG_AC then
		-- заменим код и наименование аналитического признака
		for			a
			in		::[ANALYTIC_CODE] all
			where	a%collection = rTun.[ANALYTIC]%collection
		loop
			if rAC is null then
				rAC	:= a;
			-- если АП несколько, то ничего не меняем
			else
				rAC	:= null;
				exit;
			end if;
		end loop;

		if rAC is not null then
			-- временные переменные новых значений реквизитов АП
			var	vACNewCodeTmp	varchar2(100);
			var	vACNewNameTmp	varchar2(250);
			var	bACNewArchTmp	boolean;

			vACNewCodeTmp	:=	regexp_replace(P_NEW_CODE, '_TEMP$');
			vACNewNameTmp	:=	substr(P_NEW_NAME, 1, lcAnalyticSize);
			bACNewArchTmp	:=	char_bool(P_NEW_ARCH);
							
			-- Изменить код, наименование или признак архива для аналитического признака
			update	ac	(
							ac.[CODE]			=	coalesce(&set_null(vACNewCodeTmp),	ac.[CODE])
						,	ac.[NAME]			=	coalesce(&set_null(vACNewNameTmp),	ac.[NAME])
						,	ac.[NUMBER_VALUE]	=	coalesce(bACNewArchTmp,				ac.[NUMBER_VALUE])
						)
			in		::[ANALYTIC_CODE] all
			where	ac = rAC;
		else
			&wm('		Аналитический признак не найден! Изменение кода или наименования признака не выполнено!');
		end if;
	end if;

	&wm('	Настройка [' || P_TUN_CODE || '] изменена.');
end;










-- Изменение настроек в указанном профиле
procedure ChangeTunings
			(
				-- Изменяемый профиль настроек
				P_PROF	ref	[REPS_PROF_TUN]
			)
is
	rTun			ref	[REPS_TUNING];
	rTunPar			ref	[REPS_TUNING];
	vIN					varchar2(32767);
	vEXL				varchar2(32767);
	mTunPattNorm		&lc.tpRecordTunPatt;
begin
	lmSkipTun	:= null;
	lmTuneFilters.delete;
	-- Инициализация профиля P_PROF
	&rt.ClearTunLevelCash;
	&lc.Init(lvLogType);
	&formula.InitFormulaComponents(p_prof);

	-- Приводим к единообразному варианту параметр "Для расчета" в настройках
	update t(t.[CALC] = nvl(t.[CALC], false))
	in ::[REPS_TUNING] all
	where	t.[PROF] = P_PROF;

	-- Изменение настройки [1]
	rTun	:=	&lc.FindTun(P_PROF, '1');
	if IsEditableTune(rTun, '1') then
		-- Изменить параметры настройки [1]
		EditTune	(
						P_PROF
					,	rTun
					,	'1'
					,	P_NEW_NAME				==	'Раздел 1. Сведения об операциях с ценными бумагами, долями, недвижимым имуществом, паями, вкладами в имущество и цифровыми финансовыми активами, совершенных между резидентами и нерезидентами'
					);
	end if;

	-- Изменение настройки [1.1]
	rTun	:=	&lc.FindTun(P_PROF, '1.1');
	if IsEditableTune(rTun, '1.1') then
		-- Изменить параметры настройки [1.1]
		EditTune	(
						P_PROF
					,	rTun
					,	'1.1'
					,	P_NEW_NAME				==	'Подраздел 1.1. Операции по выпуску ценных бумаг, цифровых финансовых активов, покупке и продаже ценных бумаг, долей, недвижимого имущества, паев, цифровых финансовых активов, внесению вкладов в имущество, а также операции по договорам с обратной продажей (репо)'
					);
	end if;

	-- Изменение настройки [1.2]
	rTun	:=	&lc.FindTun(P_PROF, '1.2');
	if IsEditableTune(rTun, '1.2') then
		-- Изменить параметры настройки [1.2]
		EditTune	(
						P_PROF
					,	rTun
					,	'1.2'
					,	P_NEW_NAME				==	'Подраздел 1.2. Операции по погашению основного долга (корпуса), выплатам дивидендов по акциям, процентов (купонов) по облигациям и иным ценным бумагам, цифровым финансовым активам, выкупу долей, паев, выплате распределенной части прибыли'
					);
	end if;

	-- Нормализация сортировки
	&rt.NormOrder(p_prof);

end;


-- выполнение конвертации профиля
public function DoConvert	(
								-- ссылка на профиль-источник
								P_PROF		ref	[REPS_PROF_TUN]
							,	-- Вариант вывода сообщений. Возможные значения: CONV - использование &wm; PIPE - использование debug_pipe 0-го уровня.
								P_LOG_TYPE		varchar2(4)		default 'CONV'
							)
							-- возвращается ссылка на профиль настроек в случае, если он был создан в результате выполнения конвертации
	return	ref	[REPS_PROF_TUN]
is
	-- Ссылка на предыдущий профиль
	rProfOld	ref	[REPS_PROF_TUN];
	-- Данные предыдущего профиля
	recProfOld		[REPS_PROF_TUN];
	-- Ссылка на текущий профиль
	rProfNew	ref	[REPS_PROF_TUN];
	-- Данные нового профиля
	recProfNew		[REPS_PROF_TUN];
	-- Ссылка на справочник указаний по указанию нового профиля
	rCbAct		ref	[REPS_CB_ACTS]	:= ::[REPS_CB_ACTS].[LIB].GetRepCbAct(lcrRep, lcrecFillInfo.vProfVers);
begin
	lvLogType					:= P_LOG_TYPE;
	recProfOld	=	rProfOld	:= P_PROF;

	-- если данные по нормативному акту еще не добавлены в тип "ОП Нормативные акты ЦБ"
	if rCbAct is null then
		-- заполнение структуры указаний
		&wm('Выполняется стандартное заполнение структуры "' || ::[REPS_CB_ACTS]%class || '" для отчета с кодом [F_405].');

		::[REPS_CB_ACTS].[FILL_ACTS_F_405]();

		&wm('Завершено стандартное заполнение структуры "' || ::[REPS_CB_ACTS]%class || '" для отчета с кодом [F_405].');
	else
		&wm('В структуре "' || ::[REPS_CB_ACTS]%class || '" существует запись с кодом [' || lcrecFillInfo.vProfVers || '] для отчета с кодом [F_405]. Заполнение справочника не требуется.');
	end if;

	if rProfOld is null then
		&wm('	Создание профиля на основании Указания ' || lcrecFillInfo.vProfVers || '-У');
		&wm('		Стандартное заполнение настройками профиля "' || recProfNew.[CODE] || '"');
		-- Стандартное заполнение созданного профиля
		recProfNew = rProfNew	:= &lib_fill.ScriptFill	(
															-- ссылка на профиль
															P_PROF	== null
														,	-- ссылка на отчет
															P_REP	== lcrRep
														,	-- признак необходимости очистки профиля
															P_CLEAR	== false
														,	-- метод к которому надо обратиться, если null то к последнему СЗ
															P_METH	== lcvFillCode
														);
		&wm('		Выполнено стандартное заполнение настройками профиля "' || recProfNew.[CODE] || '"');
		&wm('	Завершено создание профиля на основании Указания ' || lcrecFillInfo.vProfVers || '-У');
	else
		&wm('	Конвертация профиля "' || recProfOld.[NAME] || '"' || ' (' || recProfOld.[CODE] || ')');
		&wm('		Копирование настроек профиля "' || recProfOld.[CODE] || '"');
		-- Стандартное заполнение созданного профиля
		recProfNew = rProfNew	:= &lib_fill.ScriptCopyProf	(
																-- ссылка на профиль
																P_PROF			== rProfOld
															,	-- метод к которому надо обратиться, если null то к последнему СЗ
																P_METH			== lcvFillCode
															,	-- признак необходимости закрывать профиль источник
																P_PROF_CLOSE	== true
															);
		&wm('		Выполнено копирование настроек профиля "' || recProfOld.[CODE] || '" в профиль: "' || recProfNew.[CODE] || '"');

		&wm('		Изменение настроек профиля "' || recProfNew.[CODE] || '"');
		-- Изменение настроек в соответствии с новым указанием
		ChangeTunings(rProfNew);
		&wm('		Выполнено изменение настроек профиля "' || recProfNew.[CODE] || '"');

		&wm('		Нормализация настроек профиля "' || recProfNew.[CODE] || '"');
		::[ANALYTIC_CODE].[ANALYTIC_NORMAL](P_PROF == rProfNew);
		&wm('		Выполнена нормализация настроек профиля "' || recProfNew.[CODE] || '"');

		begin
			&wm('		Сохранение истории изменения настроек профиля "' || recProfNew.[CODE] || '"');
			::[REPS_TUN_HIST].[LIB].SaveProf(rProfNew);
			&wm('		Выполнено сохранение истории изменения настроек профиля "' || recProfNew.[CODE] || '"');
		exception
			when message.APP_EXCEPTION then
				&wm('		Сохранение истории изменений настроек профиля не произведено: "' || ::[RUNTIME].[UTILS].error_stack(true) || '"!');

				raise;
		end;

		&wm('	Завершена конвертация профиля "' || recProfOld.[NAME] || '"' || ' (' || recProfOld.[CODE] || ')');
	end if;

	&upd_prof.InitNewProf(rProfNew);

	return rProfNew;
end;

end;
