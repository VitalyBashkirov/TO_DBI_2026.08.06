class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Реестр документов по главам')
static method PSH_DOCUM_GL is
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma macro (xl,'::[OOXML].[API_XL]');

procedure print(P_DATE date, P_CREAT [STRING_50], P_PODPIS ref [USER], P_PL_POR boolean, sh integer default null, ch integer) is
	iRow		number;
	nRow		number;
	nSum        number;
	gl varchar2(1);
	rUser		ref [USER] := ::[RUNTIME].[STDLIB].userid;
	iBorder		integer;	
begin
   	if    sh = 1 then gl := 'А';
   	elsif sh = 2 then gl := 'В';
   	elsif sh = 3 then gl := 'Г';
   	end if;
   	&xl.Open_Sheet(sh);			
   	&xl.RenameSheet(sh, 'Глава ' || gl || ' '|| to_char(P_DATE,'dd.mm.yy') || case when ch = 2 then ' (рубли)' when ch = 3 then ' (валюта)' end); 			
	
	iRow := 4;
	nRow := 0;
	nSum := 0;
	iBorder := &xl.get_border(p_top==&xl.xl_b_thin, p_bottom==&xl.xl_b_thin, p_left==&xl.xl_b_thin, p_right==&xl.xl_b_thin);

    &xl.put(1, 9, 'Реестр документов главы ' || gl || ' за '||to_char(P_DATE,'dd.mm.yyyy') ||' года' || case when ch = 2 then ' (рубли)' when ch = 3 then ' (валюта)' end);
    &xl.set_autofilter(4,4,1,14);

	for (
	        select d(
				      d  						: c_id		
				    , d.[DOCUMENT_NUM]      	: c_document_num
				    , d.[VID_DOC].SHORT_CODE	: c_vid_doc_cod
				    , d.[VID_DOC].SHORT_NAME	: c_vid_doc_name
				    , d.[DATE_EXEC]         	: c_date_exec
				    , d.[VALUTA].CODE_ISO    	: c_valute
				    , d.[SUM]					: c_sum
				    , d.[SUM_NT]				: c_sum_nt
				    , d.[ACC_DT].[MAIN_V_ID]	: c_num_dt
				    , d.[ACC_KT].[MAIN_V_ID]	: c_num_kt				    
					, d.[NAZN]   				: c_nazn
					, d.[PRIORITET]   			: c_prioritet
					, d.[DOCUMENT_UNO]   		: c_doc_uno
					,coalesce(d.[KL_DT].[2].[2], d.[KL_DT].[1].[1].[NAME])	: c_name_d
					,coalesce(d.[KL_KT].[2].[2], d.[KL_KT].[1].[1].[NAME])	: c_name_k
				) in ::[MAIN_DOCUM] all
				where P_CREAT like '%' || d.[DOCUMENT_USER].[USERNAME] || '%'
					and d.[DATE_PROV] >= P_DATE
					and d.[DATE_PROV] <  P_DATE + 1
					and d%state = 'PROV'
					and d.[ACC_DT].[MAIN_USV]->(false, [PL_USV])[USV_US]->(false, [PL_US])[NEW_BS1].[RASD].[CHAPTER].[CHAPTER] = gl
					and ((not(P_PL_POR) and d.[VID_DOC] <> ::[NAME_PAYDOC]([CODE] = 'БЕЗН_ПЛ_ПОРУЧ')) 
						 or P_PL_POR
					    )
					and (ch = 1 or (ch = 2 and d.[ACC_DT].[FINTOOL] = ::[SYSTEM].[SYS_MAIN_VAL]) or (ch = 3 and d.[ACC_DT].[FINTOOL] <> ::[SYSTEM].[SYS_MAIN_VAL]))
				order by 5,6
			)		
	loop
	    
		iRow :=	iRow + 1;	
		nRow :=	nRow + 1;
		&xl.Ins_Row(iRow,1,sh,true);

        &xl.put(iRow,1, nRow);      
        &xl.put(iRow,2, to_char(d.c_date_exec,'dd/mm/yyyy')); 
        &xl.put(iRow,3, d.c_vid_doc_name);
        &xl.put(iRow,4, d.c_vid_doc_cod);
        &xl.put(iRow,5, d.c_document_num);
        &xl.put(iRow,6, d.c_sum);	
        &xl.put(iRow,7, d.c_sum_nt);	
        &xl.put(iRow,8, d.c_valute);	
        &xl.put(iRow,9, d.c_num_dt);	
        &xl.put(iRow,10, d.c_num_kt);
        &xl.put(iRow,11, d.c_nazn);
        &xl.put(iRow,12, d.c_name_d);      
        &xl.put(iRow,13, d.c_name_k);    
        &xl.put(iRow,14, d.c_prioritet);
        nSum := nSum + d.c_sum_nt;    
	end loop;
	&xl.Set_Format_Range(4, 1, iRow, 14, p_borderId == iBorder);
	
	iRow:=iRow+1;
	
	&xl.put(iRow,6, 'ИТОГО: ');		
	&xl.Formula(iRow,7,'=SUM(G4:G'||to_char(iRow - 1)||')');
	&xl.put(iRow,8, '643');
	&xl.Set_Format_Range(iRow, 1, iRow, 14, p_fontId  == &xl.get_font('Calibri', 2, 11, 1, false, false, true));
	   
	&xl.put(iRow + 3,1, 'Количество документов '||nRow|| ' на сумму '||to_char( nSum ,'FM99,999,999,999,990.00')|| ' ('||::[RUNTIME].[STDLIB].N2Str(nSum, 'NatCur') ||')');   
	
	&xl.put(iRow + 5,1, rUser.[CASTA].[VALUE]);    
	&xl.put(iRow + 5,7, ::[RUNTIME].[STDLIB].fio(rUser.[NAME], 'Ф И.О.'));    
	&xl.put(iRow + 7,1, P_PODPIS.[CASTA].[VALUE]);    
	&xl.put(iRow + 7,7, ::[RUNTIME].[STDLIB].fio(P_PODPIS.[NAME], 'Ф И.О.'));    
end;
PSH_DOCUM_GL (
	@name('Дата')                         P_DATE   in [DATE],
	@name('Создатели документов')         P_CREAT  in [STRING_50],
	@name('Подписант')                    P_PODPIS in [USER_REF],
	@name('Включать платежные поручения') P_PL_POR in [BOOLEAN],
	@name('Фильтр по валюте')             P_CH_VAL in [ONE_FROM_THREE]
) is

validate is
	xl_tmpl 	blob := empty_blob();
begin
	if P_MESSAGE = 'DEFAULT' then
		P_DATE := CALENDAR.Next_Date('HOLIDAYS', '0', ::[SYSTEM].[OP_DATE], -2);
		P_CREAT := ::[RUNTIME].[STDLIB].userid.[USERNAME];
		P_PODPIS := ::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_PODPIS');			

	elsif P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'OK' then
			::[SHABLON_DOC].[LIB_OOXML].load_blob('PSB_REESTR_SBP', xl_tmpl, null, null, null, null);
			     
			if xl_tmpl is null then 
				pragma error('Не найден шаблон отчета'); 
			elsif not &xl.open_file(xl_tmpl) then 
				pragma error('Ошибка при открытии печатной формы шаблона');	
			end if;		  
	       	
			-- скопируем сразу первый лист
			&xl.AddCopySheet('1', '2');
			&xl.AddCopySheet('1', '3');

			print(P_DATE,P_CREAT,P_PODPIS, nvl(P_PL_POR, false), 1, P_CH_VAL.[0]);
			print(P_DATE,P_CREAT,P_PODPIS, nvl(P_PL_POR, false), 2, P_CH_VAL.[0]);
			print(P_DATE,P_CREAT,P_PODPIS, nvl(P_PL_POR, false), 3, P_CH_VAL.[0]);
			
		    &xl.finish(xl_tmpl);
			[OOXML]::[API_ORSA].putReport2RunExtProc(xl_tmpl,'xlsx','Реестр документов за '||to_char(P_DATE,'dd.mm.yy')||' '|| case when P_CH_VAL.[0] = 2 then 'рубли' when P_CH_VAL.[0] = 3 then 'валюта' end);														
		end if;
	end if;
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_PODPIS', P_PODPIS, 'USER');
end;

execute is
begin
	null;							
end;
end;
end;
