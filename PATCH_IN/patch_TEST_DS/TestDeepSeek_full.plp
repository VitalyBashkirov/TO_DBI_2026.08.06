-- ============================================================================
-- Правило 42: v50.SQL.TABLE_SELECT.п.1.13 - Замена SELECT FROM TABLE()
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена SELECT FROM TABLE()
--   Подробное описание: Синтаксис выборки из коллекций не формализован в ANSI SQL. Поддержана выборка из скалярных ассоциативных массивов.
--   Пример кода для корректировки: select * from table(collection)
--   Пример исправленного кода: поддерживается для скалярных массивов
--   Теги: collection, array, table
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Синтаксис выборки из коллекций не формализован в ANSI SQL и имеет разную реализацию в Oracle и PostgreSQL. Поддержана выборка из скалярных ассоциативных массивов и из массивов объектных типов.
--   plplus_materials_note: При обращении к метаданным нельзя выполнять join с varray.
--   search_prompt: Найти SELECT FROM TABLE() конструкции.
--   regex_patterns.for_search: \bSELECT\s+.*\s+FROM\s+TABLE\s*\(
--   code_example_bad: select * from table(collection)
--   fix_instruction: Использовать поддержанные синтаксисы для скалярных массивов.
--   fix_prompt: Замени SELECT FROM TABLE() на поддержанный синтаксис.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.TABLE_SELECT.п.1.13'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.FUNCTIONS
--   source_files: v50.docx
--   source_sections: п.1.13
-- ============================================================================
PROCEDURE v50_SQL_TABLE_SELECT_p_1_13 IS
	TYPE t_numbers IS TABLE OF NUMBER;
	v_arr t_numbers;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		select * from table(v_arr);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		select column_value from table(v_arr);
	-- end pl/sql
END;

-- ============================================================================
-- Правило 43: v50.SQL.HINTS.п.1.18 - Удаление подсказок оптимизатора
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Удаление подсказок оптимизатора
--   Подробное описание: В PostgreSQL нет возможности управлять логикой работы Planner/Optimizer. Подсказки не работают, рекомендуется их удалять.
--   Пример кода для корректировки: select /*+ INDEX(t idx) */ ...
--   Пример исправленного кода: select ...
--   Теги: hints, optimizer
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: В PostgreSQL нет возможности управлять логикой работы Planner/Optimizer, поэтому не рекомендуется использование подсказок (hints) для универсальной функциональности.
--   plplus_materials_note: Подсказки не работают в DBI.
--   search_prompt: Найти подсказки оптимизатора в комментариях: /*+ ... */
--   regex_patterns.for_search: /\*\+.*\*/
--   code_example_bad: select /*+ INDEX(t idx) */ * from t
--   fix_instruction: Удалить подсказки оптимизатора.
--   fix_prompt: Удали подсказки оптимизатора.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.HINTS.п.1.18'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.OTHER
--   source_files: v50.docx
--   source_sections: п.1.18
-- ============================================================================
PROCEDURE v50_SQL_HINTS_p_1_18 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		select /*+ INDEX(t idx) */ * from t;
		select /*+ LEADING(t1 t2) */ * from t1, t2 where t1.id = t2.id;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		select * from t;
		select * from t1, t2 where t1.id = t2.id;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 44: v50.SQL.PSEUDO.п.1.20 - Запрет псевдоколонок Oracle
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Запрет псевдоколонок Oracle
--   Подробное описание: Псевдоколонки OBJECT_ID, OBJECT_VALUE, ORA_ROWSCN, ROWID, ROWNUM, XMLDATA не поддерживаются.
--   Пример кода для корректировки: select rowid, rownum from t
--   Пример исправленного кода: исключить
--   Теги: pseudocolumn, oracle
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Обращение к псевдоколонкам недопустимо.
--   plplus_materials_note: В PostgreSQL нет аналогов Oracle псевдоколонок.
--   search_prompt: Найти обращения к псевдоколонкам Oracle.
--   regex_patterns.for_search: \b(ROWID|ROWNUM|ORA_ROWSCN|OBJECT_ID|OBJECT_VALUE|XMLDATA)\b
--   code_example_bad: select rowid, rownum from t
--   fix_instruction: Исключить псевдоколонки или заменить на прикладную логику.
--   fix_prompt: Исключи обращения к псевдоколонкам.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.PSEUDO.п.1.20'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.PSEUDOCOLUMNS
--   source_files: v50.docx
--   source_sections: п.1.20
-- ============================================================================
PROCEDURE v50_SQL_PSEUDO_p_1_20 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		select rowid, id from t;
		select rownum, name from clients;
		select ora_rowscn, status from documents;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		select id from t;
		select name from clients;
		select status from documents;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 45: v50.SQL.DDL.п.1.24 - Указание схемы в DDL
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Указание схемы в DDL
--   Подробное описание: При выполнении DDL из прикладного кода обязательно указывать имя схемы.
--   Пример кода для корректировки: create table Z#TEMP (id number)
--   Пример исправленного кода: create table "app"."Z#TEMP" (id number)
--   Теги: ddl, schema
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: В PostgreSQL в отличии от Oracle, при создании объекта БД без указания схемы, объект будет создан на схеме, указанной первой в search_path. Поэтому, при выполнении DDL из прикладного кода, обязательно указывайте имя схемы.
--   plplus_materials_note: Имя схемы app может быть изменено.
--   search_prompt: Найти DDL команды (CREATE, ALTER, DROP, TRUNCATE) без указания схемы.
--   regex_patterns.for_search: \b(CREATE|ALTER|DROP|TRUNCATE)\s+(TABLE|INDEX|VIEW|SEQUENCE)\s+[A-Z#]+\b
--   code_example_bad: create table Z#TEMP (id number)
--   fix_instruction: Добавить схему: create table "app"."Z#TEMP"
--   fix_prompt: Добавь указание схемы в DDL.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.DDL.п.1.24'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.OTHER
--   source_files: v50.docx
--   source_sections: п.1.24
-- ============================================================================
PROCEDURE v50_SQL_DDL_p_1_24 IS
	v_schema VARCHAR2(100);
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		create table Z#TEMP (id number);
		truncate table Z#TEMP;
		drop table Z#TEMP;
		create index IDX_TEMP on Z#TEMP(id);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		v_schema := ::[RUNTIME].[DB].get_scheme_tbp('TEMP')[1];
		execute immediate 'create table "' || v_schema || '"."Z#TEMP" (id number)';
		execute immediate 'truncate table "' || v_schema || '"."Z#TEMP"';
		execute immediate 'create index "' || v_schema || '"."IDX_TEMP" on "' || v_schema || '"."Z#TEMP"(id)';
	-- end pl/sql
END;

-- ============================================================================
-- Правило 46: v50.SQL.FETCH_EXISTS.тдс20240828.стр.5 - Запрет fetch в подзапросе EXISTS
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Запрет fetch в подзапросе EXISTS
--   Подробное описание: В подзапросе EXISTS нельзя использовать fetch — это вызывает полную выборку подзапроса.
--   Пример кода для корректировки: exists (select 1 from t fetch first 1)
--   Пример исправленного кода: exists (select 1 from t)
--   Теги: fetch, exists, subquery
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: В подзапросе EXISTS нельзя использовать fetch — это вызывает полную выборку подзапроса.
--   plplus_materials_note: EXISTS должен проверять только существование.
--   search_prompt: Найти EXISTS подзапросы с FETCH FIRST.
--   regex_patterns.for_search: EXISTS\s*\(\s*SELECT.*FETCH\s+FIRST
--   code_example_bad: exists (select 1 from t fetch first 1)
--   fix_instruction: Убрать fetch из подзапроса EXISTS.
--   fix_prompt: Удали fetch из подзапроса EXISTS.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.FETCH_EXISTS.тдс20240828.стр.5'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.LIMIT
--   source_files: тдс20240828
--   source_sections: стр.5
-- ============================================================================
PROCEDURE v50_SQL_FETCH_EXISTS_p_1_5 IS
	v_exists NUMBER;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		select count(*) into v_exists from dual
		where exists (select 1 from t fetch first 1 rows only);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		select count(*) into v_exists from dual
		where exists (select 1 from t);
	-- end pl/sql
END;

-- ============================================================================
-- Правило 47: v50.PROC.DYNAMIC_SQL.п.3.3 - Замена DBMS_SQL на [RUNTIME].[CALC]
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена DBMS_SQL на [RUNTIME].[CALC]
--   Подробное описание: Динамический SQL через DBMS_SQL заменить на ::[RUNTIME].[CALC] или ::[RUNTIME].[PLP].
--   Пример кода для корректировки: dbms_sql.open_cursor
--   Пример исправленного кода: ::[RUNTIME].[CALC].plp_c
--   Теги: dynamic sql, dbms_sql
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Динамический SQL через DBMS_SQL заменить на ::[RUNTIME].[CALC] или ::[RUNTIME].[PLP].
--   plplus_materials_note: DBMS_SQL — Oracle пакет.
--   search_prompt: Найти вызовы DBMS_SQL.
--   regex_patterns.for_search: \bDBMS_SQL\.\w+\b
--   code_example_bad: dbms_sql.open_cursor
--   fix_instruction: Заменить DBMS_SQL на ::[RUNTIME].[CALC] или ::[RUNTIME].[PLP].
--   fix_prompt: Выполни замену DBMS_SQL на RUNTIME.CALC или RUNTIME.PLP.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.DYNAMIC_SQL.п.3.3'.
--   examples.calc.bad: dbms_sql.open_cursor
--   examples.calc.good: ::[RUNTIME].[CALC].plp_c
--   priority: high
--   category: PROC
--   subcategory: PROC.SQL
--   source_files: v50.docx
--   source_sections: п.3.3
-- ============================================================================
PROCEDURE v50_PROC_DYNAMIC_SQL_p_3_3 IS
	v_cursor INTEGER;
	v_sql VARCHAR2(1000);
	v_rows NUMBER;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		v_cursor := dbms_sql.open_cursor();
		dbms_sql.parse(v_cursor, 'select * from t', dbms_sql.native);
		v_rows := dbms_sql.execute(v_cursor);
		dbms_sql.close_cursor(v_cursor);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		v_cursor := ::[RUNTIME].[CALC].plp_c();
		::[RUNTIME].[CALC].plp_parse(v_cursor, 'select * from t');
		v_rows := ::[RUNTIME].[CALC].plp_execute(v_cursor);
		::[RUNTIME].[CALC].plp_close(v_cursor);
	-- end pl/sql
END;
