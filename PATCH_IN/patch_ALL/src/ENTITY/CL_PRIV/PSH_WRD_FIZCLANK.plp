--	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_CHARACTER_REL'); --but по-старому
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_CHARACTER_REL');
	 		elsif p_info = 'ЦЕЛИ_ФИНХОЗ_ДЕЯТ' then
