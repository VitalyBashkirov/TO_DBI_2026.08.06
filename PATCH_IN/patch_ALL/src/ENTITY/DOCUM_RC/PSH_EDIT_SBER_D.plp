@name('Исходный документ')                          public V_ORIG_EPD                  [DOCUM_RC_REF];
@name('Номер исходного документа')                  public V_ORIG_DOC_NUM              [STRING_16];
@name('Открыть дело')                               public V_OPEN_INV                  [BOOLEAN];
@name('Создать запрос')                             public V_CREATE_MT195              [BOOLEAN];
@name('Тип сообщения')                              public V_CASE                      [SIXTH_CHOICE];
@name('Открыть дело для инф. документа')            public V_OPEN_INV_INF              [BOOLEAN];
@name('Связанные документы')                        public V_LINK_DOCS        ref      [DOCUM_RC];
@name('Список связанных документов')                public V_LD_STR                    [STRING_32000];
@name('Надпись на кнопке связи')                    public V_BC                        [STRING_20];
@name('Код идентификации клиента 59F')              public V_IDENT59F                  [VAL_IDENT50F_REF];
@name('Срочный платеж')                             public V_URGENT                    [BOOLEAN];
@name('Текст MX')                                   public V_MX                        [MEMO_32767];
@name('Счет 50 в формате IBAN')                     public V_IBAN_50                   [BOOLEAN];
@name('Отправить в ED503')                          public V_TO_ED503                  [BOOLEAN];
@name('Буфер обмена для LOB')                      	public V_LOB_BUFF       		   [STRING_32000];

public ON_CONTROL	boolean;
pragma INCLUDE( ::[DOCUM_RC].[DEF_PARTITION]);
