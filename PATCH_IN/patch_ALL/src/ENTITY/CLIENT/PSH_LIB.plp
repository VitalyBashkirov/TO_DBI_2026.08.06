class CLIENT;

@name('ПСХ. Библиотека')
library PSH_LIB is





-- Функция IsClientBank возвращает 1 если клиент является пользователем ДБО, и 0 если нет
-- В случае если второй параметр p_date равен NULL, то он инициализируется датой операционного дня
-- При поиске период 12.01.14-16.03.2014 расширяется до 01.01.14-31.03.2014

public function IsClientBank(p_client ref [CLIENT], p_date	[DATE] default null) return number is 
begin
	p_date	:= nvl(p_date, ::[SYSTEM].[OP_DATE]);
	--debug_pipe('p_date='||to_char(p_date, 'dd.mm.yyyy'), 0);
	--debug_pipe('First_day='||to_char((add_months(last_day(p_date), -1) + 1), 'dd.mm.yyyy'), 0);
	--debug_pipe('Last_day='||to_char(last_day(p_date), 'dd.mm.yyyy'), 0);
	
	for z in p_client.[ADD_PROP]
		where z.[GROUP_PROP]= ::[PROPERTY_GRP]([CODE]='CLIENT_BANK')
			and (z.[DATE_BEG] is null or add_months(last_day(z.[DATE_BEG]), -1) + 1 <= p_date)
			--and (z.[DATE_END] is null or p_date <= last_day(z.[DATE_END])) and z.[bool] = true
			and (z.[DATE_END] is null or p_date <= last_day(z.[DATE_END])) and upper(z.[str]) = 'ДА'
	loop
--		debug_pipe('z.[DATE_BEG]='||to_char(z.[DATE_BEG], 'dd.mm.yyyy'), 0);
--		debug_pipe('z.[DATE_END]='||to_char(z.[DATE_END], 'dd.mm.yyyy'), 0);
		return 1;
	end loop;	
	return 0;
end;


function checkNaznPlat_ZRP (a_st string ) return boolean is
begin
	if 	upper(a_st) like upper('%зараб%')
	or 	upper(a_st) like upper('%зарп%')
	or 	upper(a_st) like upper('%з/п%')
	or 	upper(a_st) like upper('%труда%')
	or	upper(a_st) like upper('%декрет%')
	or	upper(a_st) like upper('%увольн%')
	--or upper(a_st) like upper('%аванс%')
	or upper(a_st) like upper('%отпускн%')
	or upper(a_st) like upper('%по уходу%')
	or upper(a_st) like upper('%ребен%')
	or upper(a_st) like upper('%больнич%')
	or upper(a_st) like upper('%нетруд%')
	or upper(a_st) like upper('%з.п.%')
	or upper(a_st) like upper('%з.плата%')
	or upper(a_st) like upper('%з. плата%')
	then
		return true;
	else
		return false;
	end if;
end;

function checkNaznPlat_NONDS (a_st string ) return boolean is
begin
	if 	upper(a_st) like upper('%без НДС%')
	or 	upper(a_st) like upper('%без налога%')
	or 	upper(a_st) like upper('%не облагается%')
	or 	upper(a_st) like upper('%не предусмотрен%')
	or	upper(a_st) like upper('%без учета%')
	or	upper(a_st) like upper('%отсутст%')
	then
		return true;
	else
		return false;
	end if;
end;

function checkNaznPlat_NDS (a_st string ) return boolean is
begin
	if 	upper(a_st) like upper('%в том числе НДС%')
	or 	upper(a_st) like upper('%в т.ч. НДС%')
	or 	upper(a_st) like upper('%в т.ч.НДС%')
	or 	upper(a_st) like upper('%в т. ч. НДС%')
	or 	upper(a_st) like upper('%в т. ч.НДС%')
	or 	upper(a_st) like upper('%с учетом НДС%')
	or 	upper(a_st) like upper('%НДС перечислен%')
	then
		return true;
	else
		return false;
	end if;
end;


public function FirstAcc_for_view (p_client ref [CLIENT], p_d_beg	[DATE], p_d_end	[DATE]) return varchar(1) is 
ret varchar(1);
opened_in_period boolean;
opened_in_past 	 boolean;

begin

	ret  := '0';
	opened_in_period  := false;
	opened_in_past 	  := false;
	
	for acc in [AC_FIN] where acc.[CLIENT_V] = p_client and substr(acc.[MAIN_V_ID], 1,5) not in ('40905','40909','40910','40911','40912','40913')
								and  (acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] >= p_d_beg)
								and (acc.[COM_STATUS].[CODE] not in ('TO_OPEN') or acc.[COM_STATUS] is null)
								and acc.[DATE_OP]<=p_d_end -- or acc.[DATE_CLOSE]

	-- бежим по открытым
	loop
		-- если открыт в диапазоне
		if acc.[DATE_OP] >= p_d_beg then
			opened_in_period := true;
			--ret := '1';
		end if;
		-- если открыт до диапазона
		if acc.[DATE_OP] < p_d_beg then
			opened_in_past  := true;
		end if;
		
	end loop;
	
	if opened_in_period and not opened_in_past then
		ret := '1';
	end if;
	
	return ret;
end;

public function FirstAcc_for_view2 (p_client ref [CLIENT], p_d_beg	[DATE], p_d_end	[DATE]) return ref [AC_FIN] is 
ret varchar(1);
opened_in_period boolean;
opened_in_past 	 boolean;
acc_id ref [AC_FIN];

begin

	ret  := '0';
	opened_in_period  := false;
	opened_in_past 	  := false;
	
	for acc in [AC_FIN] where acc.[CLIENT_V] = p_client and substr(acc.[MAIN_V_ID], 1,5) not in ('40905','40909','40910','40911','40912','40913')
								and  (acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] >= p_d_beg)
								and (acc.[COM_STATUS].[CODE] not in ('TO_OPEN') or acc.[COM_STATUS] is null)
								and acc.[DATE_OP]<=p_d_end-- or acc.[DATE_CLOSE]
								order by acc.[DATE_OP] desc
	-- бежим по открытым
	loop
		-- если открыт в диапазоне
		if acc.[DATE_OP] >= p_d_beg then
			opened_in_period := true;
			acc_id:=acc;
			--ret := '1';
		end if;
		-- если открыт до диапазона
		if acc.[DATE_OP] < p_d_beg then
			opened_in_past  := true;
		end if;
		
	end loop;
	
	if opened_in_period and not opened_in_past then
		ret := '1';
	end if;
	
	if ret=1 then return acc_id;
	else return null;
	end if;
	
end;



public function LastAcc_for_view  	(p_client ref [CLIENT], p_d_beg	[DATE], p_d_end	[DATE]) return varchar(1) is 
ret varchar(1);
closed_in_period boolean;
has_opened 	 boolean;

begin

	ret  := '0';
	closed_in_period  := false;
	has_opened 	      := false;
	
	--debug_pipe('p_d_beg='||p_d_beg||' '||'p_d_end='||p_d_end,0 );
	
	for acc in [AC_FIN] where acc.[CLIENT_V] = p_client and substr(acc.[MAIN_V_ID], 1,5) not in ('40905','40909','40910','40911','40912','40913')
	--and (acc.[DATE_CLOSE] acc.[DATE_CLOSE] >= p_d_beg)-- or acc.[DATE_CLOSE]
	-- бежим по счетам
	loop
		-- если закрыт в диапазоне
		if acc.[DATE_CLOSE] >= p_d_beg and  acc.[DATE_CLOSE] <= p_d_end  then
			closed_in_period := true;
		end if;
		-- если есть открытые
		if acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] > p_d_end then
			has_opened  := true;
		end if;
		
	end loop;
	
	if closed_in_period and not has_opened then
		ret := '1';
	end if;
	
	return ret;
end;

public function LastAcc_for_view2 	(p_client ref [CLIENT], p_d_beg	[DATE], p_d_end	[DATE]) return ref [AC_FIN] is 
ret varchar(1);
closed_in_period boolean;
has_opened 	 boolean;
acc_id ref [AC_FIN];

begin

	ret  := '0';
	closed_in_period  := false;
	has_opened 	      := false;
	
	--debug_pipe('p_d_beg='||p_d_beg||' '||'p_d_end='||p_d_end,0 );
	
	for acc in [AC_FIN] where acc.[CLIENT_V] = p_client and substr(acc.[MAIN_V_ID], 1,5) not in ('40905','40909','40910','40911','40912','40913')
	order by acc.[DATE_CLOSE]
	--and (acc.[DATE_CLOSE] acc.[DATE_CLOSE] >= p_d_beg)-- or acc.[DATE_CLOSE]
	-- бежим по счетам
	loop
		-- если закрыт в диапазоне
		if acc.[DATE_CLOSE] >= p_d_beg and  acc.[DATE_CLOSE] <= p_d_end  then
			closed_in_period := true;
			acc_id:=acc;
		end if;
		-- если есть открытые
		if acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] > p_d_end then
			has_opened  := true;
		end if;
		
	end loop;
	
	if closed_in_period and not has_opened then
		ret := '1';
	end if;
	
	if ret=1 then return acc_id;
	else return null;
	end if;
	
end;

public function isCheckURtoFIZ 	(p_client ref [CLIENT], p_d_beg	[DATE], p_d_end	[DATE]) return varchar(1) is 
ret varchar(1);
closed_in_period boolean;
has_opened 	 boolean;
--acc_id ref [AC_FIN];
sm number(18,2);

begin

	ret  := '0';
	closed_in_period  := false;
	has_opened 	      := false;
	
	--debug_pipe('p_d_beg='||p_d_beg||' '||'p_d_end='||p_d_end,0 );
	sm := 0;
	for acc in [AC_FIN] where 	acc.[CLIENT_V] = p_client
								and  (acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] >= p_d_beg)
								and acc.[DATE_OP]<=p_d_end -- or acc.[DATE_CLOSE]
	order by acc.[DATE_CLOSE]
	-- бежим по счетам
	loop
	
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_DT] = acc
									and (
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,5) in ('40817','40820','30232','30233','40802') ))
											or
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,3) in ('423', '426')) )
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) in ('40817','40820','30232','30233','40802')) )
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,3) in ('423', '426') ))
										)
		loop
			if not checkNaznPlat_ZRP(md.[NAZN])
			then
					sm := sm + md.[SUM_NT];
					if sm >= 100000 then
						ret  := '1';
						return ret;
					end if;
			end if;
			--exit;
		end loop;
	
	end loop;
	
	return ret;
	
end;

-- переводы от Юриков Физикам - если больше 100000 по всем плат от Юр.
public function isCheckURtoFIZSM		(p_client ref [CLIENT], p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is 
sm number(18,2);
begin

	sm := 0;	
	for acc in [AC_FIN] where 	acc.[CLIENT_V] = p_client
								--and substr(acc.[MAIN_V_ID], 1,5) not in ('40905','40909','40910','40911','40912','40913')
								and  (acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] >= p_d_beg)
								--and (acc.[COM_STATUS].[CODE] not in ('TO_OPEN') or acc.[COM_STATUS] is null)
								and acc.[DATE_OP]<=p_d_end -- or acc.[DATE_CLOSE]
	loop
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_DT] = acc
									and (
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,5) in ('40817','40820','30232','40802') ))
											or
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,3) in ('423', '426')) )
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) in ('40817','40820','30232','40802')) )
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,3) in ('423', '426') ))
										)
		loop
			if not checkNaznPlat_ZRP(md.[NAZN]) then
				sm := sm + md.[SUM_NT];
			end if;
		end loop;
	end loop;
	return sm;
end;

