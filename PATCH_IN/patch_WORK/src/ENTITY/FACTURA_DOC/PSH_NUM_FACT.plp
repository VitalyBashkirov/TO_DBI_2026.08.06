class FACTURA_DOC;

@name('[ПСБ] Редактировать Номер счета-фактуры, Дату оплаты и Информацию о док-те')
method PSH_NUM_FACT is
PSH_NUM_FACT (
	@name('Номер счета-фактуры')                       P_NUM_FACT        in [STRING_35],
	@name('Дата оплаты')                               P_DATE_PAY        in [DATE],
	@name('Информация о платежно-расчетном документе') P_INFO_MAIN_DOCUM in [MEMO_4000]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_NUM_FACT := this.[NUM_FACT];
	P_DATE_PAY := this.[DATE_PAY];
	P_INFO_MAIN_DOCUM := this.[INFO_MAIN_DOCUM];
end if;
-- End initialization of parameters and variables
end;

execute is
/*********************************************************************
Назначение:

Bashkirov, последнее изменение 31 Август 2022 г.
*********************************************************************/
begin
	this.[NUM_FACT]:=P_NUM_FACT;
	this.[DATE_PAY]:=P_DATE_PAY;
	this.[INFO_MAIN_DOCUM]:=P_INFO_MAIN_DOCUM;
end;
end;
end;
