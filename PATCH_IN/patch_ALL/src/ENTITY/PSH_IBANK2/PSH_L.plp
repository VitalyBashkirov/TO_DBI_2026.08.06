class PSH_IBANK2;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Библиотека')
library PSH_L is
pragma macro (lj_lib,'::[PSH_LOCAL_JOB].[PSH_LIB]');  -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25 -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 14/10/25
l_30232_b	const ref [PL_USV]:=::[PL_USV]([NUM] = '30232' and [FILIAL]=1985880 and [FINTOOL]=43353); 
l_30233_b	const ref [PL_USV]:=::[PL_USV]([NUM] = '30233' and [FILIAL]=1985880 and [FINTOOL]=43353); 
l_30232_c	const ref [AC_FIN]:=::[AC_FIN]([MAIN_V_ID] = '30232810400000001104'); 
l_30233_c	const ref [AC_FIN]:=::[AC_FIN]([MAIN_V_ID] = '30233810700000001104');
l_70601 	const ref [AC_FIN]:=::[AC_FIN]([MAIN_V_ID] = '70601810801002740828');
vid_doc_bo const ref [NAME_PAYDOC] := ::[NAME_PAYDOC]([CODE] = 'БЕЗН_БАНК_ОРД');
vid_doc_mo const ref [NAME_PAYDOC] := ::[NAME_PAYDOC]([CODE] = 'БЕЗН_МЕМО_ОРД');
l_rec		ref [PSH_LOCAL_JOB]:=::[PSH_LOCAL_JOB]([CODE]='EXEC_QUERY'); -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
l_VO99090 const ref  [CURR_OPERATION]:= ::[CURR_OPERATION]([FULL_CODE] = '99090');
l_VO99010 const ref  [CURR_OPERATION]:= ::[CURR_OPERATION]([FULL_CODE] = '99010');

function MAIN_DOCUM_CREATE(P_DOCUMENT_NUM string,P_DATE_DOC date,P_VID_DOC ref [NAME_PAYDOC],P_SUM_DT number,P_PRIORITET number,P_NAZN [MEMO],P_DATE_VAL date,l_CL_DT [REQ_CLIENT],P#VIB_DT [CASE_BETWEEN_TWO] ,l_CL_KT [REQ_CLIENT],P#VIB_KT [CASE_BETWEEN_TWO],P_FILIAL ref [BRANCH],P_DEPART ref [DEPART], V_CUR_OP ref [CURR_OPERATION]
                           ) return ref [MAIN_DOCUM]
is
begin
 					if V_CUR_OP is not null then ::[MAIN_DOCUM].[NEW#DOC].V_CURR_OPER := V_CUR_OP; 
 					else ::[MAIN_DOCUM].[NEW#DOC].V_CURR_OPER := null;
 					end if; -->> Valishin 10/12/2024
 					
 					return	::[MAIN_DOCUM].[NEW#DOC](
					 P_DOCUMENT_NUM--P#DOCUMENT_NUM		--Номер
					,P_DATE_DOC--P#DATE_DOC		--Дата документа
					,P_VID_DOC--P#VID_DOC		--Вид документа
					,P_SUM_DT--P#SUM		--Сумма в валюте платежа
					,null--P#DATE_PL		--Срок оплаты
					,P_PRIORITET--P#PRIORITET		--Срочность платежа
					,null--P#DOC_SEND_REF		--Почта/телеграф
					,P_NAZN--P#NAZN		--Назначение платежа
					,null--P#SUM_CARD		--Сумма в картотеке
					,null--NEW_STATE		--Отправка документа
					,null--CODE_DOC		--Условное обозначение(шифр) пл.документа
					,null--P#KOD_NAZN_PAY		--Код назначения платежа
					,null--P#ACC_PROV		--Корсчет проводки
					,null--P#SSS		--Строка
					,null--P_VID_OBOROTA		--Вид оборота
					,null--P_BUDGET_PAYMENT		--Бюджетный платеж
					,null--P#ACC_PROV_DT		--Корсчет проводки дебет
					,null--P#SSS_DT		--Строка дебет
					,P_DATE_VAL--P#DATE_VAL		--Дата валютирования
					,null--P#INNDt		--ИНН для фильтра (плательщик)
					,null--P#INNCt		--ИНН для фильтра (получатель)
					,null--P#BICDt		--БИК для фильтра (плательщик)
					,null--P#BICCt		--БИК для фильтра  (получатель)
					,l_CL_DT.[1]--P#CL_DT_1		--Внутренние реквизиты ДТ
					,l_CL_DT.[2]--P#CL_DT_2		--Внешние реквизиты ДТ
					,P#VIB_DT--P#VIB_DT		--Выбор ДТ
					,l_CL_KT.[1]--P#CL_KT_1		--Внутренние реквизиты КТ
					,l_CL_KT.[2]--P#CL_KT_2		--Внешние реквизиты КТ
					,P#VIB_KT--P#VIB_KT		--Выбор КТ
					,null--P#SUM_PO		--Сумма зачисления	
					,null--P#SUM_NT		--Сумма нац.покрытия
					,null--P#MULTICURR		--Свойство валютности
					,null--P_PACHKA		--Пачка
					,null--P_BUD_REQS		--Дополнительные реквизиты бюджетного документа
					,null--P_USER_TYPE		--Пользовательский тип
					,null--P_NUMB_BASE_DOC		--Количество ПУД
					,null--P_LIST_BASE_DOC		--Количество листов в ПУД
					,null--P_PUD_APPLIED_TO		--Пуд приложен к
					,null--P_REP_1ST_SIGN		--Представитель для первой подписи
					,null--P_KL_BNK		--Вид перевода
					,null--P_ACC_COM		--Счет для удержания комиссии по документу
					,P_FILIAL--P_FILIAL	--Филиал
					,P_DEPART--P_DEPART		--Подразделение
					,null--P_CODE		--Код
					);


end;


--Дата 
--ИНН 
--МСС-код 
--Номер счета (из АБС) 
--Тип операции (Покупка, Возврат-резервирование, Возврат-списание, Выплата-резервирование, Выплата-списание) 
--Сумма 
--Комиссия 
--Валюта
	
--  P_OPER  1- покупка 2 возврат-резерв 3- возврат-списание 4 выплата-резервирование 5  выплата-списание
--  6 -  отмена  возврата    7 -  отмена  выплаты
--  8  диспут 
-- проверить наличие счета в абс



public function EXECUTE_QUERY(P_DATE_DOC  date, P_INN varchar2(12), P_MCC varchar2, P_ACCOUNT varchar2(20),P_OPER integer,P_AMOUNT number, P_COMMISSION number, P_OREDER varchar2,P_TRANSACTION IN OUT NOCOPY varchar2) return number
is
		l_main_doc 		ref	[MAIN_DOCUM];
		l_acc			ref	[AC_FIN];
		l_CL_KT			[REQ_CLIENT];	
		l_CL_DT			[REQ_CLIENT];	
		main_doc		ref [MAIN_DOCUM];
		P_DOCUMENT_NUM	string; 			-- Номер
		-- P_DATE_DOC		date; 			-- Дата документа
		P_VID_DOC		ref [NAME_PAYDOC];	-- Вид документа
		P_SUM_DT		number;				-- Сумма Дт.
		P_PRIORITET		number;
		P_NAZN			[MEMO];			 	-- Назначение платежа
		P_DATE_VAL		date;				-- Дата валютирования
		P#VIB_DT		[CASE_BETWEEN_TWO];
		P#VIB_KT		[CASE_BETWEEN_TWO];
		P_FILIAL		ref [BRANCH];		-- Филиал документа
		P_DEPART		ref [DEPART];		-- Подразделение документа
		l_acc_kt		ref [AC_FIN];
		l_acc_mvd_kt	varchar2;
		l_dt			date;
		l_folder		ref [FOLDER_PAY]; 
        l_str			MEMO_BIG;
       	l_RCPT_NAME		varchar2;
    	l_RCPT_LEGAL_NAME	varchar2;
    	l_transaction  varchar2;
    	l_30232			ref [AC_FIN];
		l_30233			ref [AC_FIN];
		l_client_v		ref[CLIENT];


begin 
-- STDIO.PUT_LINE_PIPE('==================','SS');  

--::[SYSTEM].[VARIABLES].set_system_vars_by_user(32303141); 
--::[END_OD_INTERFACE].[PRX_DOCUMENT].trc_set_var_current;


l_str:= 'P_DATE_DOC=> To_date('''||TO_CHAR( P_DATE_DOC, 'DD.MM.YYYY HH24:MI:SS') || ''' ,''dd.mm.yyyy hh24:mi:ss''), P_INN=> ''' ||nvl(P_INN, ' ') || ''', P_MCC=>'''||nvl(P_MCC , ' ')||''', P_ACCOUNT=>''' ||nvl(P_ACCOUNT, ' ') ||''',P_OPER=>'''|| nvl(P_OPER, -1) || ''', P_AMOUNT=>''' ||nvl(P_AMOUNT,0) || ''', P_COMMISSION=>'''|| nvl(P_COMMISSION, 0)  || ''', P_OREDER=>'''|| nvl(P_OREDER, ' ') ||''', P_TRANSACTION=>''' || nvl(regexp_replace(P_TRANSACTION,'[^[[:digit:]]]*'), ' '||'''');    
--l_str:= 'P_DATE_DOC=> '||TO_CHAR(P_DATE_DOC,'DD.MM.YYYY HH24:MI:SS')  || 									  ', P_INN=> ' ||nvl(P_INN, ' ') || ''', P_MCC=>'''||nvl(P_MCC , ' ')||''', P_ACCOUNT=>''' ||nvl(P_ACCOUNT, ' ') ||''',P_OPER=>'''|| nvl(P_OPER, -1) || ''', P_AMOUNT=>''' ||nvl(P_AMOUNT,0) || ''', P_COMMISSION=>'''|| nvl(P_COMMISSION, 0)  || ''', P_OREDER=>'''|| nvl(P_OREDER, ' ') ||''', P_TRANSACTION=>''' || nvl(regexp_replace(P_TRANSACTION,'[^[[:digit:]]]*'), ' '||'''');    
-- STDIO.PUT_LINE_PIPE(to_char(sysdate,'hh:mi:ss')|| ' '||l_str,'SS');
 --l_rec.[TEXT_LIST].[CFB_NEW](null,false,false,sysdate,rtrim(ltrim(l_str)));
 &lj_lib.write_log('EXEC_QUERY',l_str);
 l_transaction:=P_TRANSACTION;
 P_TRANSACTION:=0; 
-- STDIO.PUT_LINE_PIPE('write_log','SS');  

-- 1 ========================================================================================================================				 
 if  P_OPER=1   then
 	
					P_DOCUMENT_NUM := '1';
					--l_dt := ::[SYSTEM].[OP_DATE]; -- trunc(sysdate);
					l_dt := trunc(P_DATE_DOC);					
					P_DATE_VAL :=l_dt;
					P_PRIORITET := 5;
                    
                    --::[FP_TUNE].[LIB].get_date_value('PSB_DATE_SBP', null, '0')
																									
					P_VID_DOC := vid_doc_bo; 
					--if nvl(P_COMMISSION,0)=0 then 
					--   P_SUM_DT := P_AMOUNT/100-round(0.007*P_AMOUNT/100,2);
					--else
					  P_SUM_DT := (P_AMOUNT-P_COMMISSION)/100;
					--end if;   
					
                   for  l_main_doc in ::[MAIN_DOCUM] where l_main_doc.[DOCUMENT_UNO] = 'SBP' ||to_char(P_OREDER) and  trunc(l_main_doc.[DATE_PROV])=trunc(P_DATE_DOC) loop
                      if l_main_doc.[SUM]=P_SUM_DT and l_main_doc%state = 'PROV'   then 
                          &lj_lib.write_log('EXEC_QUERY','документ найден '||l_main_doc%id);
                          --STDIO.PUT_LINE_PIPE('документ найден '||l_main_doc%id,'SS');       
                         P_TRANSACTION := l_main_doc%id;
                        return 1; 
                      end if;
                   end loop; 


					for l_ac_fin in ::[AC_FIN] where l_ac_fin.[MAIN_V_ID] = P_ACCOUNT loop
					   if  nvl(l_ac_fin.[CLIENT_V].[INN],0)!=P_INN  then  &lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -1');  return -1;  end if;-- STDIO.PUT_LINE_PIPE( l_ac_fin.[CLIENT_V].[INN] || ' !!!==== ' || P_INN,'SS');      
					   if l_ac_fin.[DATE_CLOSE] is not null  then &lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -2'); return -2; end if;-- STDIO.PUT_LINE_PIPE( l_ac_fin.[MAIN_V_ID]|| ' счет зактрыт  '|| to_char( l_ac_fin.[DATE_CLOSE],'dd.mm.yyyy' ) ,'SS');       
					   l_acc_kt :=l_ac_fin;
					   l_client_v:=l_ac_fin.[CLIENT_V];
					end loop;
					
				    if l_acc_kt is null then &lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -3'); return -3; end if;  	


                    for ac_30233 in ::[AC_FIN] where ac_30233.[MAIN_USV] = l_30233_b  and ac_30233.[CLIENT_V]= l_client_v  
	                    loop
	                      if substr(ac_30233.[MAIN_V_ID],17,1)='1' then 
	                         l_30233:=ac_30233;
	                         exit; 
	                      end if;  
	                    end loop;
                    if l_30233 is null then &lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -4');	return -4;  end if;
                    
                    --STDIO.PUT_LINE_PIPE(substr(l_30233.[NAME],instr(l_30233.[NAME],' по договору '),instr(l_30233.[NAME],' по операц')-instr(l_30233.[NAME],' по договору ')),'SS');  
					P_NAZN := 'Перечисление денежных средств по операции оплаты с использованием СБП за '||to_char(l_dt,'dd.mm.yy')||  substr(l_30233.[NAME],instr(l_30233.[NAME],' по договору '),instr(l_30233.[NAME],' по операц')-instr(l_30233.[NAME],' по договору '));
					P_NAZN := P_NAZN||'. Комиссия '|| to_char( nvl(P_COMMISSION/100,0 ),'FM99,999,999,999,990.00')||' руб. НДС не облагается.';
					if substr(P_ACCOUNT,1,5) in ('40807') then 	P_NAZN :='{VO99090}'||P_NAZN; end if; 
                    
                    l_acc := l_30233; --l_30233_c
                    
   					P_FILIAL	:= l_acc.[FILIAL];
					P_DEPART	:= l_acc.[DEPART]; --8935433


					P#VIB_DT.[0] := 1;
					l_CL_DT.[0] := 1;
					l_CL_DT.[1].[1] := l_client_v;
					l_CL_DT.[1].[2] := l_acc;

					P#VIB_KT.[0] := 1;
					l_CL_KT.[0] := 1;
					l_CL_KT.[1].[1] := l_client_v;
					l_CL_KT.[1].[2] := l_acc_kt;
                   begin                           
                   
                    --savepoint A1_PSB_IBANK2_L; 
                   
                   -- STDIO.PUT_LINE_PIPE('1.===='||to_char(sysdate,'hh:mi:ss'),'SS');     
                    -->> Valihin 10/12/2024
                    if substr(P_ACCOUNT,1,5) in ('40807') then
                    	main_doc:=MAIN_DOCUM_CREATE(P_DOCUMENT_NUM,l_dt,P_VID_DOC,P_SUM_DT,P_PRIORITET,P_NAZN,P_DATE_VAL,l_CL_DT,P#VIB_DT,l_CL_KT,P#VIB_KT,P_FILIAL,P_DEPART,l_VO99090);
                    else
                    	main_doc:=MAIN_DOCUM_CREATE(P_DOCUMENT_NUM,l_dt,P_VID_DOC,P_SUM_DT,P_PRIORITET,P_NAZN,P_DATE_VAL,l_CL_DT,P#VIB_DT,l_CL_KT,P#VIB_KT,P_FILIAL,P_DEPART,null);
                    end if;
                    --<< Valihin 10/12/2024
                        
 					/*main_doc := 	::[MAIN_DOCUM].[NEW#DOC](
					P_DOCUMENT_NUM--P#DOCUMENT_NUM		--Номер
					,P_DATE_DOC--P#DATE_DOC		--Дата документа
					,P_VID_DOC--P#VID_DOC		--Вид документа
					,P_SUM_DT--P#SUM		--Сумма в валюте платежа
					,null--P#DATE_PL		--Срок оплаты
					,P_PRIORITET--P#PRIORITET		--Срочность платежа
					,null--P#DOC_SEND_REF		--Почта/телеграф
					,P_NAZN--P#NAZN		--Назначение платежа
					,null--P#SUM_CARD		--Сумма в картотеке
					,null--NEW_STATE		--Отправка документа
					,null--CODE_DOC		--Условное обозначение(шифр) пл.документа
					,null--P#KOD_NAZN_PAY		--Код назначения платежа
					,null--P#ACC_PROV		--Корсчет проводки
					,null--P#SSS		--Строка
					,null--P_VID_OBOROTA		--Вид оборота
					,null--P_BUDGET_PAYMENT		--Бюджетный платеж
					,null--P#ACC_PROV_DT		--Корсчет проводки дебет
					,null--P#SSS_DT		--Строка дебет
					,P_DATE_VAL--P#DATE_VAL		--Дата валютирования
					,null--P#INNDt		--ИНН для фильтра (плательщик)
					,null--P#INNCt		--ИНН для фильтра (получатель)
					,null--P#BICDt		--БИК для фильтра (плательщик)
					,null--P#BICCt		--БИК для фильтра  (получатель)
					,l_CL_DT.[1]--P#CL_DT_1		--Внутренние реквизиты ДТ
					,l_CL_DT.[2]--P#CL_DT_2		--Внешние реквизиты ДТ
					,P#VIB_DT--P#VIB_DT		--Выбор ДТ
					,l_CL_KT.[1]--P#CL_KT_1		--Внутренние реквизиты КТ
					,l_CL_KT.[2]--P#CL_KT_2		--Внешние реквизиты КТ
					,P#VIB_KT--P#VIB_KT		--Выбор КТ
					,null--P#SUM_PO		--Сумма зачисления	
					,null--P#SUM_NT		--Сумма нац.покрытия
					,null--P#MULTICURR		--Свойство валютности
					,null--P_PACHKA		--Пачка
					,null--P_BUD_REQS		--Дополнительные реквизиты бюджетного документа
					,null--P_USER_TYPE		--Пользовательский тип
					,null--P_NUMB_BASE_DOC		--Количество ПУД
					,null--P_LIST_BASE_DOC		--Количество листов в ПУД
					,null--P_PUD_APPLIED_TO		--Пуд приложен к
					,null--P_REP_1ST_SIGN		--Представитель для первой подписи
					,null--P_KL_BNK		--Вид перевода
					,null--P_ACC_COM		--Счет для удержания комиссии по документу
					,P_FILIAL--P_FILIAL	--Филиал
					,P_DEPART--P_DEPART		--Подразделение
					,null --P_CODE		--Код
					,null --P_RESERVE --Резервное поле
					,null --P_NAZN_CODE --Назначение платежа кодовое
					); --*/
				--	&lj_lib.write_log('EXEC_QUERY', main_doc%id);
																										--&msg('        main_doc:' || main_doc);
					main_doc.[DOCUMENT_UNO] := 'SBP' ||to_char(P_OREDER);
					main_doc.[DATE_VAL]:=l_dt;
					main_doc.[DATE_DOC]:=l_dt;
				--	if substr(P_ACCOUNT,1,5) in ('40807') then 		main_doc.[CURR_OPER] := l_VO99090; end if; -->> Valihin 10/12/2024
				--	main_doc.[DOCUMENT_NUM] := to_char(P_OREDER);
					
					
					--main_doc.[KL_KT].[2].[2] := l_RCPT_NAME;
					--для финмона
					/*if doc.doc_type = 'sbp_payment_services' then
						main_doc.[KL_KT].[2].[2] := ::[CFB_IBANK2].[L1].GET_ATTR(l_ref_msg, 'RCPT_LEGAL_NAME');
					else
						main_doc.[KL_KT].[2].[2] := ::[CFB_IBANK2].[L1].GET_ATTR(l_ref_msg, 'RCPT_LAST_NAME') || ' ' || ::[CFB_IBANK2].[L1].GET_ATTR(l_ref_msg, 'RCPT_FIRST_NAME') || ' ' || ::[CFB_IBANK2].[L1].GET_ATTR(l_ref_msg, 'RCPT_MIDDLE_NAME');
					end if;--*/
					/*if l_folder is not Null then
						l_ref_msg.[OBJ] := l_folder;
					else
						l_ref_msg.[OBJ] := main_doc;
					end if;--*/
					
					 --main_doc.[DOC_TO_PROV];
					 
                   for  l_main_doc in ::[MAIN_DOCUM] where l_main_doc.[DOCUMENT_UNO] = 'SBP' ||to_char(P_OREDER) and  trunc(l_main_doc.[DATE_PROV])=trunc(P_DATE_DOC) loop
                      if l_main_doc.[SUM]=P_SUM_DT and l_main_doc%state = 'PROV'   then 
                       
                          --&lj_lib.write_log('EXEC_QUERY','SBP' ||to_char(P_OREDER)|| ' удалить '||main_doc%);
                          &lj_lib.write_log('EXEC_QUERY','SBP' ||to_char(P_OREDER)|| ' уже проведен '||l_main_doc%id);
                         P_TRANSACTION := l_main_doc%id;
                        return 1; 
                      end if;
                   end loop; 
					 
					
					-- main_doc%state:= 'PROV';
                     main_doc.[DOC_TO_PROV]();
					if main_doc%state = 'TO_RKO' then
						main_doc.[DOC_TO_PROV]();
					end if;
																								
					if main_doc%state != 'PROV'  then
					   
						--STDIO.PUT_LINE_PIPE('документ не провелся'||nvl(main_doc.[TEXT_VOZV],'') ,'SS');       
						&lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -100 '||nvl(main_doc.[TEXT_VOZV],''));						
						/*if main_doc.[TEXT_VOZV] is not Null then
							pragma error(main_doc.[TEXT_VOZV]);
						else
							pragma error('документ не провелся');
						end if;--*/
				     end if;
    				--STDIO.PUT_LINE_PIPE('провелся '||to_char(sysdate,'hh:mi:ss'),'SS');       
                    P_TRANSACTION := main_doc%id;
                    
					P_VID_DOC := vid_doc_mo; 
					--STDIO.PUT_LINE_PIPE('nvl(P_COMMISSION,0) '||nvl(P_COMMISSION,0),'SS');  
					--if nvl(P_COMMISSION,0)=0 then 
					--  P_SUM_DT := round(0.007*P_AMOUNT/100,2);
					--else 
					 P_SUM_DT := P_COMMISSION/100;
					--end if;
					  
					P_PRIORITET := 5;
                    P_NAZN := 'Комиссия по операции с использованием СБП за '||to_char(l_dt,'dd.mm.yy')||  substr(l_30233.[NAME],instr(l_30233.[NAME],' по договору '),instr(l_30233.[NAME],' по операц')-instr(l_30233.[NAME],' по договору '));

					P_FILIAL	:= l_acc.[FILIAL];
					P_DEPART	:= l_acc.[DEPART]; 

                    
                    /*for ac_30232 in ::[AC_FIN] where ac_30232.[MAIN_USV] = l_30232_b  and ac_30232.[CLIENT_R]= l_client_v  
	                    loop
	                      l_30232:=ac_30232;
	                    end loop;
                    if l_30232 is null then 	return -4;  end if;
                    
                    l_acc := l_30232; --l_30232_c
                    */
                    l_acc := l_30233; --l_30232_c
                    
                    l_acc_kt:=l_70601;

					P#VIB_DT.[0] := 1;
					l_CL_DT.[0] := 1;
					l_CL_DT.[1].[1] := l_client_v;
					l_CL_DT.[1].[2] := l_acc;
					P#VIB_KT.[0] := 1;
					l_CL_KT.[0] := 1;
					l_CL_KT.[1].[1] := l_client_v;
					l_CL_KT.[1].[2] := l_acc_kt;
				     
				     main_doc:=MAIN_DOCUM_CREATE(P_DOCUMENT_NUM,l_dt,P_VID_DOC,P_SUM_DT,P_PRIORITET,P_NAZN,P_DATE_VAL,l_CL_DT,P#VIB_DT,l_CL_KT,P#VIB_KT,P_FILIAL,P_DEPART,null);
				     main_doc.[DOCUMENT_UNO] := 'SBP' ||to_char(P_OREDER);
				    main_doc.[DATE_VAL]:=l_dt;
					main_doc.[DATE_DOC]:=l_dt;
				     
				     
       				--STDIO.PUT_LINE_PIPE('комиссия '||main_doc%id,'SS');       
				     --main_doc%state:= 'PROV';
				     main_doc.[DOC_TO_PROV]();
       				--STDIO.PUT_LINE_PIPE('провелся '||to_char(sysdate,'hh:mi:ss'),'SS');       
				     
				      --*/

		
   
 				exception when others then
    			    &lj_lib.write_log('EXEC_QUERY', SubStr(sqlerrm,1,200));
    			    --STDIO.PUT_LINE_PIPE('exception == '  || SubStr(sqlerrm,1,200),'SS');      
					--rollback to A1_PSB_IBANK2_L;
					--l_rec.[TEXT_LIST].[CFB_NEW](null,false,false,sysdate,rtrim(ltrim(sqlerrm)));
					--pragma error (SQLERRM);
					P_TRANSACTION :=0;
					return 0;
				end;
-- 2 ========================================================================================================================				
	elsif  P_OPER =  2  or P_OPER =  4  or P_OPER =  8  then  
 					P_DOCUMENT_NUM := '1';
					--l_dt := ::[SYSTEM].[OP_DATE]; --trunc(sysdate);
					l_dt := P_DATE_DOC;
					P_DATE_DOC := l_dt;
					P_DATE_VAL := l_dt;

					P_VID_DOC := vid_doc_bo; 
					P_PRIORITET := 5;

					P_SUM_DT :=  P_AMOUNT/100;
					
					-- на возвратах дублей нет
					
                  /*for  l_main_doc in ::[MAIN_DOCUM] where l_main_doc.[DOCUMENT_UNO] = 'SBPV' ||to_char(P_OREDER) and  trunc(l_main_doc.[DATE_PROV])=trunc(P_DATE_DOC) loop
                      if l_main_doc.[SUM]=P_SUM_DT and l_main_doc%state = 'PROV'   then 
                          --STDIO.PUT_LINE_PIPE('документ найден '||l_main_doc%id,'SS');       
                           &lj_lib.write_log('EXEC_QUERY','документ найден '||l_main_doc%id);
                          
                         P_TRANSACTION := l_main_doc%id;
                        return 1; 
                      end if;
                   end loop; 					--*/  
					
					for l_ac_fin in ::[AC_FIN] where l_ac_fin.[MAIN_V_ID] = P_ACCOUNT loop
					   if  nvl(l_ac_fin.[CLIENT_V].[INN],0)!=P_INN  then &lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -5'); return -5; end if;   --STDIO.PUT_LINE_PIPE( l_ac_fin.[CLIENT_V].[INN] || ' !!!==== ' || P_INN,'SS');       
					   if l_ac_fin.[DATE_CLOSE] is not null  then &lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -6'); return -6; end if;  --STDIO.PUT_LINE_PIPE( l_ac_fin.[MAIN_V_ID]|| ' счет зактрыт  '|| to_char( l_ac_fin.[DATE_CLOSE],'dd.mm.yyyy' ) ,'SS');       
					   l_acc :=l_ac_fin;
					   l_client_v:=l_ac_fin.[CLIENT_V];
					end loop;
					
					 for ac_30233 in ::[AC_FIN] where ac_30233.[MAIN_USV] = l_30233_b  and ac_30233.[CLIENT_V]= l_client_v  --29533218
	                    loop
	                      if substr(ac_30233.[MAIN_V_ID],17,1)='1' then 
	                         l_30233:=ac_30233;
	                         exit; 
	                      end if;  
	                    end loop;
					
					if  P_OPER =  2  or P_OPER =  4  then
					    P_NAZN := 'Возврат средств по операциям отмена/возврат СБП за '||to_char(l_dt,'dd.mm.yy')|| substr(l_30233.[NAME],instr(l_30233.[NAME],' по договору '),instr(l_30233.[NAME],' по операц')-instr(l_30233.[NAME],' по договору '));
                    elsif  P_OPER =  8 then 
					   P_NAZN := 'Списание средств по операциям диспута СБП за '||to_char(l_dt,'dd.mm.yy')|| substr(l_30233.[NAME],instr(l_30233.[NAME],' по договору '),instr(l_30233.[NAME],' по операц')-instr(l_30233.[NAME],' по договору '));
					end if;   
					
    				if substr(P_ACCOUNT,1,5) in ('40807') then 	P_NAZN :='{VO99010}'||P_NAZN; end if; 

					if l_acc is null then &lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -7'); return -7;  end if;  	
				    

                    
                    for ac_30233 in ::[AC_FIN] where ac_30233.[MAIN_USV] = l_30233_b and ac_30233.[CLIENT_V]= l_client_v  --29533129
	                    loop
   	                      if substr(ac_30233.[MAIN_V_ID],17,1)='1' then 
	                         l_30233:=ac_30233;
	                         exit; 
	                      end if;  
	                      
	                    end loop;
	                if l_30233 is null then &lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -11'); return -11; end if; 
                    
                    l_acc_kt := l_30233;

					P#VIB_DT.[0] := 1;
					l_CL_DT.[0] := 1;
					l_CL_DT.[1].[1] := l_acc.[CLIENT_V];
					l_CL_DT.[1].[2] := l_acc;
					
					P_FILIAL	:= l_acc.[FILIAL];
					P_DEPART	:= l_acc.[DEPART]; --8935433

                    
                    P#VIB_KT.[0] := 1;
					l_CL_KT.[0] := 1;
					l_CL_KT.[1].[1] := l_acc_kt.[CLIENT_V];
					l_CL_KT.[1].[2] := l_acc_kt;
                   begin                           
                   
                  --  savepoint A1_PSB_IBANK2_L; 
                   
                   
                 -- STDIO.PUT_LINE_PIPE('1.===='||to_char(sysdate,'hh:mi:ss'),'SS');       
                    -->> Valihin 10/12/2024
                    if substr(P_ACCOUNT,1,5) in ('40807') then
                    	main_doc:=MAIN_DOCUM_CREATE(P_DOCUMENT_NUM,P_DATE_DOC,P_VID_DOC,P_SUM_DT,P_PRIORITET,P_NAZN,P_DATE_VAL,l_CL_DT,P#VIB_DT,l_CL_KT,P#VIB_KT,P_FILIAL,P_DEPART,l_VO99010);
                    else
                    	main_doc:=MAIN_DOCUM_CREATE(P_DOCUMENT_NUM,P_DATE_DOC,P_VID_DOC,P_SUM_DT,P_PRIORITET,P_NAZN,P_DATE_VAL,l_CL_DT,P#VIB_DT,l_CL_KT,P#VIB_KT,P_FILIAL,P_DEPART,null);
                    end if;
					--<< Valihin 10/12/2024
  					--&lj_lib.write_log('EXEC_QUERY', main_doc%id);
  				   --STDIO.PUT_LINE_PIPE('2.===='||to_char(sysdate,'hh:mi:ss'),'SS');  
																										--&msg('        main_doc:' || main_doc);
					
					 if P_OPER =  2   then 
					     main_doc.[DOCUMENT_UNO] := 'SBPV' ||to_char(P_OREDER);
					 elsif P_OPER =  4   then 
					    main_doc.[DOCUMENT_UNO] := 'SBPW' ||to_char(P_OREDER); 
					 elsif  P_OPER =  8   then 
				       main_doc.[DOCUMENT_UNO] := 'SBPD' ||to_char(P_OREDER);
				     end if;
					
					
					main_doc.[DATE_VAL]:=l_dt;
					main_doc.[DATE_DOC]:=l_dt;					
					
					-- if substr(P_ACCOUNT,1,5) in ('40807') then 		main_doc.[CURR_OPER] := l_VO99010; end if;  -->> Valihin 10/12/2024
					
					--main_doc.[DOCUMENT_NUM] := to_char(P_OREDER);
				 	main_doc.[DOC_TO_PROV];
					--main_doc%state:= 'PROV';
					
					-->> Valihin 10/12/2024
					if main_doc%state = 'TO_RKO' then
						main_doc.[DOC_TO_PROV]();
					end if;
					--<< Valihin 10/12/2024

					if main_doc%state != 'PROV' then
						
						--STDIO.PUT_LINE_PIPE('документ не провелся'||nvl(main_doc.[TEXT_VOZV],''),'SS');       
						&lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -100');
						return -100;
					end if;

                --  STDIO.PUT_LINE_PIPE('провелся '||to_char(sysdate,'hh:mi:ss'),'SS');       
                  --*/
                   
                  P_TRANSACTION := main_doc%id;
                  &lj_lib.write_log('EXEC_QUERY',P_TRANSACTION  || ' провелся '||to_char(sysdate,'hh:mi:ss'));
               --   &lj_lib.write_log('EXEC_QUERY','Создан документ '||P_TRANSACTION);
               
                  if P_OPER =  4    then 
                    
					P_VID_DOC := vid_doc_mo; 
					P_SUM_DT :=P_COMMISSION/100;
					
					P_PRIORITET := 5;
                    P_NAZN := 'Комиссия по операции с использованием СБП за '||to_char(l_dt,'dd.mm.yy')|| substr(l_30233.[NAME],instr(l_30233.[NAME],' по договору '),instr(l_30233.[NAME],' по операц')-instr(l_30233.[NAME],' по договору '));
					P_FILIAL	:= l_acc.[FILIAL];
					P_DEPART	:= l_acc.[DEPART]; 

                    l_acc := l_acc; 
                    l_acc_kt:=l_30233;

					P#VIB_DT.[0] := 1;
					l_CL_DT.[0] := 1;
					l_CL_DT.[1].[1] := l_client_v;
					l_CL_DT.[1].[2] := l_acc;
					P#VIB_KT.[0] := 1;
					l_CL_KT.[0] := 1;
					l_CL_KT.[1].[1] := l_client_v;
					l_CL_KT.[1].[2] := l_acc_kt;
				     
				     main_doc:=MAIN_DOCUM_CREATE(P_DOCUMENT_NUM,P_DATE_DOC,P_VID_DOC,P_SUM_DT,P_PRIORITET,P_NAZN,P_DATE_VAL,l_CL_DT,P#VIB_DT,l_CL_KT,P#VIB_KT,P_FILIAL,P_DEPART,null);
				     
				     if P_OPER =  4   then 
				       main_doc.[DOCUMENT_UNO] := 'SBPW' ||to_char(P_OREDER); 
				   --  else 
				   --    main_doc.[DOCUMENT_UNO] := 'SBPV' ||to_char(P_OREDER);
				     end if;
					main_doc.[DATE_VAL]:=l_dt;
					main_doc.[DATE_DOC]:=l_dt;
				     
				     
       			--	STDIO.PUT_LINE_PIPE('комиссия '||main_doc%id,'SS');       
				     --main_doc%state:= 'PROV';
				     main_doc.[DOC_TO_PROV]();
       				--STDIO.PUT_LINE_PIPE('провелся '||to_char(sysdate,'hh:mi:ss'),'SS');       
       				
       				
					P_VID_DOC := vid_doc_mo; 
					P_SUM_DT := P_COMMISSION/100;
					P_PRIORITET := 5;
                    P_NAZN := 'Комиссия по операции с использованием СБП за '||to_char(l_dt,'dd.mm.yy')|| substr(l_30233.[NAME],instr(l_30233.[NAME],' по договору '),instr(l_30233.[NAME],' по операц')-instr(l_30233.[NAME],' по договору '));
					P_FILIAL	:= l_acc.[FILIAL];
					P_DEPART	:= l_acc.[DEPART]; 

                    l_acc := l_30233; 
                    l_acc_kt:=l_70601;

					P#VIB_DT.[0] := 1;
					l_CL_DT.[0] := 1;
					l_CL_DT.[1].[1] := l_client_v;
					l_CL_DT.[1].[2] := l_acc;
					P#VIB_KT.[0] := 1;
					l_CL_KT.[0] := 1;
					l_CL_KT.[1].[1] := l_client_v;
					l_CL_KT.[1].[2] := l_acc_kt;
				     
				     main_doc:=MAIN_DOCUM_CREATE(P_DOCUMENT_NUM,P_DATE_DOC,P_VID_DOC,P_SUM_DT,P_PRIORITET,P_NAZN,P_DATE_VAL,l_CL_DT,P#VIB_DT,l_CL_KT,P#VIB_KT,P_FILIAL,P_DEPART,null);
				     if P_OPER =  4   then main_doc.[DOCUMENT_UNO] := 'SBPW' ||to_char(P_OREDER); 
				     else 
				       main_doc.[DOCUMENT_UNO] := 'SBPV' ||to_char(P_OREDER);
				     end if;
				     
					main_doc.[DATE_VAL]:=l_dt;
					main_doc.[DATE_DOC]:=l_dt;
       				--STDIO.PUT_LINE_PIPE('комиссия '||main_doc%id,'SS');       
				     --main_doc%state:= 'PROV';
				     main_doc.[DOC_TO_PROV]();
       			--	STDIO.PUT_LINE_PIPE('провелся '||to_char(sysdate,'hh:mi:ss'),'SS');       
                  end if;    
                      
	          --STDIO.PUT_LINE_PIPE(to_char(sysdate,'hh:mi:ss')||' ' ||P_TRANSACTION,'SS');   
	          commit;   
			  return 1;                      
                      
 				exception when others then
    			    &lj_lib.write_log('EXEC_QUERY', SubStr(sqlerrm,1,200));
    			    --STDIO.PUT_LINE_PIPE('exception '  || SubStr(sqlerrm,1,200),'SS');      
					--rollback to A1_PSB_IBANK2_L;
					--l_rec.[TEXT_LIST].[CFB_NEW](null,false,false,sysdate,rtrim(ltrim(sqlerrm)));
					--pragma error (SQLERRM);
					P_TRANSACTION :=0;
					return 0;
				end;
 
         
 	
 	
 	elsif  P_OPER =  3 or P_OPER =  5   then 
 	  
 			  	begin
  				    
  				   -- STDIO.PUT_LINE_PIPE('@@@ '  || l_transaction || '@@@','SS');      
  				    locate l_main_doc in ::[MAIN_DOCUM] where l_main_doc%id = regexp_replace(l_transaction,'[^[[:digit:]]]*') ;
  				    
  				    --replace(ltrim(rtrim(P_TRANSACTION)),' ','');
  				    if l_main_doc%state = 'PROV' then 
  				      -- STDIO.PUT_LINE_PIPE('документ проведен '  ,'SS');       
  				      return 1;
  				    else 
  				          --STDIO.PUT_LINE_PIPE('документ не проведен '  ,'SS');       
  				          &lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -8');
  				          return -8; 
  				     end if;
				    		
				exception
						when NO_DATA_FOUND then 
						    --STDIO.PUT_LINE_PIPE('нет документа '  ,'SS');      
							P_TRANSACTION:=0;  
							&lj_lib.write_log('EXEC_QUERY',P_OREDER|| '== -9');
							return -9;

    			end;
 	  
 	
 	--elsif  P_OPER =  4  then null; 
 	--elsif  P_OPER =  5  then null; 
 	elsif  P_OPER =  6  or P_OPER =  7  then 
 	  begin
         --STDIO.PUT_LINE_PIPE('Отмена документа '||l_transaction  ,'SS');       
  		 &lj_lib.write_log('EXEC_QUERY','Отмена документа '||l_transaction);

 	    locate l_main_doc in ::[MAIN_DOCUM] where l_main_doc%id = regexp_replace(l_transaction,'[^[[:digit:]]]*') ;
  		 if l_main_doc%state = 'PROV' then 
  		      l_main_doc%state := 'DELETED';
  		      
  		      if l_main_doc%state != 'DELETED'  then  
  		             --STDIO.PUT_LINE_PIPE('не отменился.. '||l_transaction  ,'SS');       
  		            &lj_lib.write_log('EXEC_QUERY','не отменился '||l_transaction);
  		      
  		         return 0; 
  		      
  		      end if;
  		 else
  		 	
  		 	return 1;
  		 	  
  		 end if;   
  		 
  				exception
		when NO_DATA_FOUND then 
		    --STDIO.PUT_LINE_PIPE('нет документа ' || l_transaction ,'SS');      
			P_TRANSACTION:=0;  
			&lj_lib.write_log('EXEC_QUERY','нет документа ' || l_transaction);
			return 1;
		when others then
    			    &lj_lib.write_log('EXEC_QUERY', SubStr(sqlerrm,1,200));
    			    --STDIO.PUT_LINE_PIPE('exception '  || SubStr(sqlerrm,1,200),'SS');      
					P_TRANSACTION :=0;
					return 0;

		end;	 
  		 

 	end if;
  	
commit;	 	  	

 return 1;
 
 
end;

public function mac_lowest(P_MAC string) return string
is
	res	string;
	i	integer := 1;
begin
	while regexp_substr(P_MAC,'[^;]+', 1, i) is not null
	loop
		if res is null or res > regexp_substr(P_MAC,'[^;]+', 1, i) then
			res := regexp_substr(P_MAC,'[^;]+', 1, i);
		end if;
		i := i + 1;
	end loop;
	return regexp_replace(res, '(.{2})(.{2})(.{2})(.{2})(.{2})(.{2})', '\1:\2:\3:\4:\5:\6');
end;
end;
