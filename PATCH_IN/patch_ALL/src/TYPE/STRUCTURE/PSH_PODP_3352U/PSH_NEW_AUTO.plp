class PSH_PODP_3352U;

@import_plsql(true)
@name('[ПСБ] Добавить')
@tag('CREATED')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('Касса')                      P_KASSA              in [S_NOTRADE],
	@name('Кассир')                     P_KASSIR             in [CASHIER_REF],
	@name('Контролёр')                  P_KONTROL            in [USER_REF],
	@name('Создатель')                  P_SOZDAT             in [USER_REF],
	@name('Пользователь')               P_USER               in [USER_REF],
	@name('Не заполнять Кассира')       P_NOT_KASSIR         in [BOOLEAN],
	@name('Не заполнять Контролёра')    P_NOT_KONTROL        in [BOOLEAN],
	@name('Не заполнять Создателя')     P_NOT_SOZDAT         in [BOOLEAN],
	@name('Взять Кассира из ценностей') P_TAKE_CENOST_KASSIR in [BOOLEAN]
) return ref [PSH_PODP_3352U] is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_KASSA := this.[KASSA];
	P_KASSIR := this.[KASSIR];
	P_KONTROL := this.[KONTROL];
	P_SOZDAT := this.[SOZDAT];
	P_USER := this.[USER];
	P_NOT_KASSIR := this.[NOT_KASSIR];
	P_NOT_KONTROL := this.[NOT_KONTROL];
	P_NOT_SOZDAT := this.[NOT_SOZDAT];
	P_TAKE_CENOST_KASSIR := this.[CENNOST_KASSIR];
end if;
-- End initialization of parameters and variables
begin
if P_MESSAGE = 'DEFAULT' then
	if  Security.Check_Equal(STDLIB.USERID.USERNAME, 'PSH_PODPIS_3352U') ='1' then null;
	elsif Security.Check_Equal(STDLIB.USERID.USERNAME, 'ADMIN_GRP') ='1' then null;
	else P_USER:=STDLIB.USERID;
	end if;
elsif P_MESSAGE = 'VALIDATE' then -- переход между полями
	--debug_pipe('P_INFO ='||P_INFO,0);
	if P_INFO = 'P_NOT_KASSIR' then if P_NOT_KASSIR then 	P_TAKE_CENOST_KASSIR:=false;
															--P_KASSIR:=null;
									end if;
	elsif P_INFO = 'P_TAKE_CENOST_KASSIR' then 	if P_TAKE_CENOST_KASSIR then	P_NOT_KASSIR:=false;
																				--P_KASSIR:=null;
												end if;
	elsif P_INFO = 'P_KASSIR' then 	if nvl(P_KASSIR,0)!=0 then 	P_NOT_KASSIR:=false;
																P_TAKE_CENOST_KASSIR:=false;
									end if;
	--elsif P_INFO = 'P_NOT_KONTROL' then if P_NOT_KONTROL then P_KONTROL:=null;	end if;
	elsif P_INFO = 'P_KONTROL' then if nvl(P_KONTROL,0)!=0 then P_NOT_KONTROL:=false; end if;	
	--elsif P_INFO = 'P_NOT_SOZDAT' then if P_NOT_SOZDAT then P_SOZDAT:=null;	end if;
	elsif P_INFO = 'P_SOZDAT' then if nvl(P_SOZDAT,0)!=0 then P_NOT_SOZDAT:=false; end if;																															
	end if;		
end if;
end;	
end;

execute is
nalichie number:=0;
begin

if nvl(P_USER,0) = 0 then
	select x (count(x)) in ::[PSH_PODP_3352U] where x.[USER] is null and x.[KASSA]=P_KASSA into nalichie;
	if nalichie>0 then pragma error('Уже есть такая касса не привязанная к пользователю в справочнике.'||CHR(10)||'Меняйте её по операции "Изменить"');end if;
else
	select x (count(x)) in ::[PSH_PODP_3352U] where x.[USER]=P_USER into nalichie;
	if nalichie>0 then pragma error('Уже есть такой пользователь в справочнике.'||CHR(10)||'Меняйте его по операции "Изменить"');end if;
end if;

if  Security.Check_Equal(STDLIB.USERID.USERNAME, 'PSH_PODPIS_3352U') ='1' and nvl(P_USER,0)=0 then null;
elsif P_USER = STDLIB.USERID then null;
elsif Security.Check_Equal(STDLIB.USERID.USERNAME, 'ADMIN_GRP') ='1' then null;
else pragma error ('Вам запрещено добавлять чужие записи!'||chr(10)||'Выберите своего "Пользователя" в соответствующей кнопке.');
end if;

if nvl(P_KASSA,0)=0 then pragma error ('Касса не может быть пустой!');
end if;

	-- Установка значения реквизита "Касса"
	[KASSA] := P_KASSA;
	-- Установка значения реквизита "Кассир"
	[KASSIR] := P_KASSIR;
	-- Установка значения реквизита "Контролёр"
	[KONTROL] := P_KONTROL;
	-- Установка значения реквизита "Создатель"
	[SOZDAT] := P_SOZDAT;
	-- Установка значения реквизита "Пользователь"
	[USER] := P_USER;
	-- Установка значения реквизита "Не заполнять Кассира"
	[NOT_KASSIR] := P_NOT_KASSIR;
	-- Установка значения реквизита "Не заполнять Контролёра"
	[NOT_KONTROL] := P_NOT_KONTROL;
	-- Установка значения реквизита "Не заполнять Создателя"
	[NOT_SOZDAT] := P_NOT_SOZDAT;
	-- Установка значения реквизита "Взять Кассира из ценностей"
	[CENNOST_KASSIR] := P_TAKE_CENOST_KASSIR;
end;
end;
end;
