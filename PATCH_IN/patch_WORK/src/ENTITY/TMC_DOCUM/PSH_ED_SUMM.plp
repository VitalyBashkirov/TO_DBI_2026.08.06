class TMC_DOCUM;

@name('[ПСБ] Редактировать суммы и даты документа (служебная)')
method PSH_ED_SUMM is
PSH_ED_SUMM (
	@name('Сумма амортизации')            P_SUM_DEPR   in [SUMMA],
	@name('Сумма балансовая')             P_SUM_BAL    in [SUMMA],
	@name('Сумма в валюте')               P_SUM_VAL    in [SUMMA],
	@name('Сумма накладных расходов')     P_SUM_RASH   in [SUMMA],
	@name('Сумма НДС')                    P_SUM_NDS    in [SUMMA],
	@name('Сумма по документу')           P_SUM_DOC    in [SUMMA],
	@name('Сумма расходов на посредника') P_SUM_POSR   in [SUMMA],
	@name('Сумма таможенных расходов')    P_SUM_TAMOG  in [SUMMA],
	@name('Дата документа')               P_DATE_DOC   in [DATE],
	@name('Дата проводки')                P_DATE_PROVE in [DATE],
	@name('Принадлежность папке')         P_IN_FOLDER  in [FOLDER_PAY_REF]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_SUM_DEPR := this.[SUM_DEPR];
	P_SUM_BAL := this.[SUM_BAL];
	P_SUM_VAL := this.[SUM_VAL];
	P_SUM_RASH := this.[SUM_RASH];
	P_SUM_NDS := this.[SUM_NDS];
	P_SUM_DOC := this.[SUM_DOC];
	P_SUM_POSR := this.[SUM_POSR];
	P_SUM_TAMOG := this.[SUM_TAMOG];
	P_DATE_DOC := this.[DATE_DOC];
	P_DATE_PROVE := this.[DATE_PROVE];
	P_IN_FOLDER := this.[IN_FOLDER];
end if;
-- End initialization of parameters and variables
end;

execute is
/*********************************************************************
Назначение:

bashkirov, последнее изменение 21 Январь 2019 г.
*********************************************************************/
begin
	this.[SUM_DEPR]  := P_SUM_DEPR;
	this.[SUM_BAL]   := P_SUM_BAL;
	this.[SUM_VAL]   := P_SUM_VAL;
	this.[SUM_RASH]  := P_SUM_RASH;
	this.[SUM_NDS]   := P_SUM_NDS;
	this.[SUM_DOC]   := P_SUM_DOC;
	this.[SUM_POSR]  := P_SUM_POSR;
	this.[SUM_TAMOG] := P_SUM_TAMOG;
	this.[DATE_DOC]  :=P_DATE_DOC;
	this.[DATE_PROVE]:=P_DATE_PROVE;
	this.[IN_FOLDER]:=P_IN_FOLDER;
end;
end;
end;
