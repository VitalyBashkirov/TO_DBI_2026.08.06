class MAIN_DOCUM;

@name('[ПСБ] 639-П. Разрешить проводку документа')
method PSH_PROV_550 is
PSH_PROV_550 (
	@name('Подтвердить проводку') P_CHECKED in [BOOLEAN]
) is

validate is
vHist [HISTORY_STATES];
begin
	if p_message = 'DEFAULT' then
		begin
			locate vHist in this.[HISTORY_STATE] where vHist.[STATE] = 'PSH_CHECK550P';
			P_CHECKED := true;
			exception
				when NO_DATA_FOUND then P_CHECKED :=false;
				when TOO_MANY_ROWS then P_CHECKED := true;
		end;	
	end if;
end;

execute is
/*********************************************************************
Назначение:

kokorin, последнее изменение 13 Июль 2017 г.
*********************************************************************/
begin
	if nvl(P_CHECKED, false) = true then
		this.[HISTORY_STATE].[NEW#AUTO](
			'PSH_CHECK550P'	/*P#STATE*/		--Состояние
			,stdlib.Userid.[NAME]	/*P#ADD_INFO*/	--Дополнительная информация
			,null			/*P#BUS_OP*/	--Бизнес-операция
			,sysdate		/*P#DATE*/		--Дата
		);
	elsif nvl(P_CHECKED, false) = false then
		for hist in this.[HISTORY_STATE] where hist.[STATE] = 'PSH_CHECK550P' loop
			hist.[DELETE#AUTO];
		end loop;
	end if;	
end;
end;
end;
