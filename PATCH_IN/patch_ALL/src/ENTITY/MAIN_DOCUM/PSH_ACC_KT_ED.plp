class MAIN_DOCUM;

@name('[ПСБ] Редактировать счет по Дт/Кт (по документам из РКЦ)')
method PSH_ACC_KT_ED is

@name('Строка валидации') public V_VB [STRING_32000];
PSH_ACC_KT_ED (
	@name('Счет Кредит') P_ACC_KT in [AC_FIN_REF]
) is

validate is
doc_rc	ref [DOCUM_RC];
begin
	if P_MESSAGE = 'DEFAULT' then
		::[RUNTIME].[CSMD].Init_Form( V_VB, &METHOD$CLASS, &METHOD$SNAME );
		
		if 	not(
				(    this.[ACC_DT].[MAIN_V_ID] like '30102%'
				 and this.[ACC_KT].[MAIN_V_ID] like '47416%')
			   or
				(	 this.[ACC_DT].[MAIN_V_ID] like '47417%'
			 	 and this.[ACC_KT].[MAIN_V_ID] like '30102%')
			   )
		then
			pragma error('Операция предназначена для входящих документов из РКЦ на невыясненные!');
		end if;
		
		doc_rc := ::[DOCUM_RC].[LIB_VIEW].getdocrc(this);

		if doc_rc is null
			or doc_rc.[CRCLCODE] <> '0020000000'
			or doc_rc%state not in ('S_5','S_55','S_6','S_65')
		then
			pragma error('Операция предназначена только для документов связанных с входящим документом РЦ в статусах 5 или 6!');
		end if;
		
		if this.[ACC_DT].[MAIN_V_ID] like '30102%' then
			P_ACC_KT := this.[ACC_KT];
		elsif this.[ACC_KT].[MAIN_V_ID] like '30102%' then
			::[RUNTIME].[CSMD].Command(V_VB, 'Object1.Caption = "'|| 'Счет Дт' ||'"');
			P_ACC_KT := this.[ACC_DT];
		end if;
	end if;
end;

execute is
begin
	if P_ACC_KT is null then
		pragma error('Ошибка. Указан пустой номер счета!');
	end if; 
	
	if this.[ACC_DT].[MAIN_V_ID] like '30102%' then
		if P_ACC_KT = this.[ACC_KT] then
			pragma error('Ошибка. Номер счета не изменён!');
		end if; 
		this.[ACC_KT] := P_ACC_KT;
		this.[NUM_KT] := P_ACC_KT.[MAIN_V_ID];
		this.[KL_KT].[1].[2] := P_ACC_KT;
		this.[KL_DT].[1].[1] := nvl(P_ACC_KT.[CLIENT_V], P_ACC_KT.[CLIENT_R]);
		if P_ACC_KT.[TO_PRODUCT].[CODE] in ('BANKS_LOANS', 'PR_CRED', 'OVERDRAFT') then
			this%state := 'TO_KRED';
		end if;

	elsif this.[ACC_KT].[MAIN_V_ID] like '30102%' then
		if P_ACC_KT = this.[ACC_DT] then
			pragma error('Ошибка. Номер счета не изменён!');
		end if; 
		this.[ACC_DT] := P_ACC_KT;
		this.[NUM_DT] := P_ACC_KT.[MAIN_V_ID];
		this.[KL_DT].[1].[2] := P_ACC_KT;
		this.[KL_DT].[1].[1] := nvl(P_ACC_KT.[CLIENT_V], P_ACC_KT.[CLIENT_R]);
	end if;
end;
end;
end;
