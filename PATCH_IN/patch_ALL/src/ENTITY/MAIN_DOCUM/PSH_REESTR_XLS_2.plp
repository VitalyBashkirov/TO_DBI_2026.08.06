class MAIN_DOCUM;

@name('[ПСБ] СШИВ. Реестр документов')
@tag('COPIED')
static method PSH_REESTR_XLS_2 is

@name('V_DEST') public V_DEST [MEMO_32767];
public vUserFilial ref [BRANCH] 	:= ::[SYSTEM].[VARIABLES].OurBranch;
PSH_REESTR_XLS_2 (
	@name('Дата начала')       P_DATE     in [DATE],
	@name('Дата конца')        P_DATE_END in [DATE],
	@name('Пользователь')      P_USER     in [USER_REF],
	@name('Подразделение')     P_DEPART   in [DEPART_REF],
	@name('№ в журнале')       P_USER_ID  in [STRING_17],
	@name('Кому документы РЦ') P_WHO_RC   in [USER_REF],
	@name('Кому валютные ДБО') P_WHO_DBO  in [USER_REF]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE := [SYSTEM]::[OP_DATE];
	P_DATE_END := [SYSTEM]::[OP_DATE];

end if;
-- End initialization of parameters and variables
declare
pragma include( ::[PR_CRED].[LIB_MACRO] );

i 			number;
itog_kol    integer;
itog_sum    number;
itog_kol_A number;
itog_sum_A number;
itog_kol_B number;
itog_sum_B number;
itog_kol_V number;
itog_sum_V number;
itog_kol_G number;
itog_sum_G number;
itog_kol_D number;
itog_sum_D number;
j 			number;
vColCount 	number; -- колво колонок в отчете
vLineCount 	number; -- первая строка в Excel
vFileName 	varchar2(250); -- имя Excel-шаблона
formula varchar2(100); -- для суммы в Экселе
--j number;
poditog varchar2(5);
del_page boolean;

tmpUser ref [USER];
begin
  if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
		[EXCEL].Init_Xls;
		P_USER := STDLIB.USERID;
		P_DEPART := STDLIB.USERID.depart;
		P_USER_ID := P_USER%id;
		if STDLIB.USERID.depart.code like '001%' then    P_WHO_RC=P_WHO_DBO:=2875484692; --1579697195; --369253377;--90068704;
		elsif STDLIB.USERID.depart.code like '101%' then P_WHO_RC=P_WHO_DBO:=2875484692; --1579697195;
		end if;
		
					
  elsif P_MESSAGE = 'VALIDATE' then -- переход между полями

  		If P_INFO='P_USER' then
  		P_USER_ID := P_USER%id;
  		P_DEPART := P_USER.depart;
  		 P_WHO_RC=P_WHO_DBO:=P_USER;
  		end if;
  		
  		If P_INFO='P_DATE' then
  		P_DATE_END := P_DATE;
  		end if;

		if p_info = 'OK' then
  			
  			if P_DATE is null or P_DATE_END is null then
  				pragma error('Дата начала и конца обязательно для заполнения!');
  			end if;
			if P_DEPART is null then
  				pragma error('Поле "Подразделение" обязательно для заполнения!');
  			end if;
			if P_USER is null then
  				pragma error('Поле "Пользователь" обязательно для заполнения!');
  			end if;
  			
  			
  			vFileName := 'PSH_Реестр_докум_сшив.xls';
  			  			  	
			if [EXCEL].F_Click then
				[EXCEL].F_Click := False;

				vColCount := 5; -- всего колонок в отчете
				vLineCount := 6; -- первая строка в Excel
				i:=vLineCount;
				j:=i;
				del_page:=true;
				itog_kol :=0;
				itog_sum :=0;
				itog_kol_A:=0;
				itog_sum_A:=0;
				itog_kol_B:=0;
				itog_sum_B:=0;
				itog_kol_V:=0;
				itog_sum_V:=0;
				itog_kol_G:=0;
				itog_sum_G:=0;
				itog_kol_D:=0;
				itog_sum_D:=0;				
				-- обнуляем переменные

				
				-- запуск Excel
				[EXCEL].open_file(::[REPS].[SLIB].GetPath('PATH_PRINT_EXCEL', vFileName),false);

				[EXCEL].Write(2, 1, 'Реестр документов № ' || nvl(P_USER.[OTVET],P_USER%id) ||' (Рубли)');
				if P_DATE != P_DATE_END then
				[EXCEL].Write(3, 1, 'За период с '||to_char(P_DATE,'DD.MM.YYYY')||' по '||to_char(P_DATE_END,'DD.MM.YYYY'));
				else [EXCEL].Write(3, 1, 'За '||to_char(P_DATE,'DD.MM.YYYY'));
				end if;
				
				--[EXCEL].AddCopySheet('Безналичные РУБЛЬ','Безналичные вклады ВАЛЮТА');
				--[EXCEL].Write(2, 1, 'Реестр документов № ' || P_USER%id ||' (операции физических лиц Валюта)');
				[EXCEL].AddCopySheet('Безналичные РУБЛЬ','Безналичные вклады РУБЛЬ');
				[EXCEL].Write(2, 1, 'Реестр документов № ' || P_USER%id ||' (операции физических лиц Рубли)');
				[EXCEL].AddCopySheet('Безналичные РУБЛЬ','Безналичные ВАЛЮТА');
				[EXCEL].Write(2, 1, 'Реестр документов № ' || P_USER%id ||' (Валюта)');
				[EXCEL].Open_Sheet('Безналичные РУБЛЬ');

				-- цикл по договорам
				for (select distinct doc (doc.[ACC_DT].[MAIN_V_ID] :C_DT_ACC
				--for (select 	doc (doc.[ACC_DT].[MAIN_V_ID] :C_DT_ACC
									,doc.[DOCUMENT_NUM] :C_NUM
									,doc.[ACC_KT].[MAIN_V_ID] :C_KT_ACC
									,doc.[SUM] :C_SUM
									,doc.[SUM_NT] :C_SUM_NT
									,doc.[ACC_DT].[MAIN_USV].[USV_US].[NEW_BS1].[RASD].[CHAPTER].[CHAPTER] :C_GL
									,doc.[NAZN] :C_NAZN
									,doc.[DOCUMENT_USER].[USERNAME] :C_DOCUMENT_USER_USERNAME
									,doc.[PROV_USER].[USERNAME] :C_PROV_USER_USERNAME
									
									,doc.[DATE_PROV] :C_DATE_PROV
									,doc%state :C_STATE
									,doc.[FILIAL] :C_FILIAL
									,doc.[PROV_USER] :C_PROV_USER
									,doc.[DOCUMENT_USER] :C_DOCUMENT_USER
									) in ::[MAIN_DOCUM]
											where --doc%id=4656074933
											/**/
												P_DATE<=trunc(doc.[DATE_PROV])and trunc(doc.[DATE_PROV])<=P_DATE_END
												and doc%state='PROV'
												and P_DEPART.[FILIAL]=doc.[FILIAL]
												and (decode(doc.[DOCUMENT_USER].[USERNAME]	,'IBANK',doc.[PROV_USER]
																							,'IBANK_101',doc.[PROV_USER]
																							,'IBS',doc.[PROV_USER]
																							,'ADM_001',doc.[PROV_USER]
																							,'ADM_101',doc.[PROV_USER]
																							,'SCAN_101',doc.[PROV_USER]
																							,doc.[DOCUMENT_USER])=P_USER
													or (doc.[DOCUMENT_USER].[USERNAME] like ('TRC%') and doc.[PROV_USER]=P_WHO_RC)
													)																							
												and (
												    (substr(doc.[ACC_DT].[MAIN_V_ID],1,5) not in ('20202','40820','47411') --'40817', Башкиров В.Г. 05.12.2024 Jira CFT-278
													and substr(doc.[ACC_DT].[MAIN_V_ID],1,3) not in ('423','426')
													and substr(doc.[ACC_KT].[MAIN_V_ID],1,5) not in ('20202')
													) or substr(doc.[ACC_DT].[MAIN_V_ID],1,5) in ('30102')
													)
												and substr(doc.[ACC_DT].[MAIN_V_ID],6,3) in ('810','643')
											/**/
									order by doc.[ACC_DT].[MAIN_USV].[USV_US].[NEW_BS1].[RASD].[CHAPTER].[CHAPTER], substr(doc.[ACC_DT].[MAIN_V_ID],1,5)
				)loop
					------------
					/** /
					if	P_DATE<=trunc(doc.C_DATE_PROV)and trunc(doc.C_DATE_PROV)<=P_DATE_END then debug_pipe('1',0);
						if doc.C_STATE='PROV' then debug_pipe('2',0);
							if P_DEPART.[FILIAL]=doc.C_FILIAL then debug_pipe('3',0);
								if doc.C_DOCUMENT_USER_USERNAME in ( 'IBANK'    
																	,'IBANK_101'
																	,'IBS'      
																	,'ADM_001'  
																	,'ADM_101'  
																	,'SCAN_101' )
								then
									tmpUser:=doc.C_PROV_USER;
								end if;
		
								if tmpUser=doc.C_PROV_USER or doc.C_DOCUMENT_USER=P_USER
										or (doc.C_DOCUMENT_USER_USERNAME like ('TRC%') and doc.C_PROV_USER=P_WHO_RC)
										then debug_pipe('4',0);
									if (   (substr(doc.C_DT_ACC,1,5) not in ('20202','40820','47411') --'40817',
										and substr(doc.C_DT_ACC,1,3) not in ('423','426')
										and substr(doc.C_KT_ACC,1,5) not in ('20202')
										) or substr(doc.C_DT_ACC,1,5) in ('30102')
										) then debug_pipe('5',0);
										if substr(doc.C_DT_ACC,6,3) in ('810','643') then debug_pipe('6',0); goto nnn;
										end if;
									end if;
								end if;
							end if;
						end if;
					end if;
					exit;
					<<nnn>>
					/**/
					------------
					del_page:=false;
					itog_kol :=itog_kol+1;
					itog_sum :=itog_sum+to_number(doc.C_SUM_NT);
					if doc.C_GL='А' then
					itog_kol_A:=itog_kol_A+1;
					itog_sum_A:=itog_sum_A+to_number(doc.C_SUM_NT);
					elsif doc.C_GL='Б' then
					itog_kol_B:=itog_kol_B+1;
					itog_sum_B:=itog_sum_B+to_number(doc.C_SUM_NT);
					elsif doc.C_GL='В' then
					itog_kol_V:=itog_kol_V+1;
					itog_sum_V:=itog_sum_V+to_number(doc.C_SUM_NT);
					elsif doc.C_GL='Г' then
					itog_kol_G:=itog_kol_G+1;
					itog_sum_G:=itog_sum_G+to_number(doc.C_SUM_NT);
					elsif doc.C_GL='Д' then
					itog_kol_D:=itog_kol_D+1;
					itog_sum_D:=itog_sum_D+to_number(doc.C_SUM_NT);
					end if;					
					-- вывод в Ексель
					
				if substr(doc.C_DT_ACC,1,5)!=poditog and i>6 then
					[EXCEL].Write(i, 2, ''''||poditog,true,null,null,null,'R');
					poditog:=substr(doc.C_DT_ACC,1,5);
					formula:='=SUM(R[-'||(i-j)||']C:R[-1]C)';
					[EXCEL].Formula(i,5,formula);
					i:=i+1;
					j := i;
				else poditog:=substr(doc.C_DT_ACC,1,5);
				end if;		
				
				[EXCEL].Write(i, 1,doc.C_NUM);
				[EXCEL].Write(i, 2,''''||doc.C_DT_ACC);
				[EXCEL].Write(i, 3,''''||doc.C_KT_ACC);
				[EXCEL].Write(i, 4,doc.C_SUM);
				[EXCEL].Write(i, 5,doc.C_SUM_NT);
				i := i + 1;

				end loop;
				
				
				[EXCEL].Write(i, 2, ''''||poditog,true,null,null,null,'R');
				formula:='=SUM(R[-'||(i-j)||']C:R[-1]C)';
				[EXCEL].Formula(i,5,formula);				
				--[EXCEL].Formula(i,2,formula,vColCount-1);
				
				[EXCEL].Set_number_Format(vLineCount+1,2,i,vColCount,2);
				[EXCEL].Borders(vLineCount, 1, i, vColCount, 'RLBTVH'); 		-- границы всюду
				
				i:=i+4;
				[EXCEL].Write(i, 1,'Общее количество документов '||itog_kol||' на сумму '|| to_char(itog_sum,'99G999G999G999D99') ||' в нац. покрытии',true);
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum)||')');
				i:=i+2;
				[EXCEL].Write(i, 1,'Из них:',true,false,9,'C');
				i:=i+2;
				if itog_kol_A>0 then
				[EXCEL].Write(i, 1,'Глава А. '||'Общее количество документов '||itog_kol_A||' на сумму '|| to_char(itog_sum_A,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_A)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;
				if itog_kol_B>0 then
				[EXCEL].Write(i, 1,'Глава Б. '||'Общее количество документов '||itog_kol_B||' на сумму '|| to_char(itog_sum_B,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_B)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;
				if itog_kol_V>0 then
				[EXCEL].Write(i, 1,'Глава В. '||'Общее количество документов '||itog_kol_V||' на сумму '|| to_char(itog_sum_V,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_V)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;
				if itog_kol_G>0 then
				[EXCEL].Write(i, 1,'Глава Г. '||'Общее количество документов '||itog_kol_G||' на сумму '|| to_char(itog_sum_G,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_G)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;
				if itog_kol_D>0 then
				[EXCEL].Write(i, 1,'Глава Д. '||'Общее количество документов '||itog_kol_D||' на сумму '|| to_char(itog_sum_D,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_D)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;
				-- Башкиров В.Г. 14.05.2025 CFT-1618
				if nvl(::[FP_TUNE].[LIB].get_bool_value('PSH_REESTR_XLS_2', null, '0'), false) then
					tmpUser := STDLIB.USERID;
					[EXCEL].Write(i, 1,tmpUser.[CASTA].[VALUE]||' ______________________ '||::[RUNTIME].[STDLIB].FIO(tmpUser.[NAME]));
				else
					[EXCEL].Write(i, 1,P_USER.[CASTA].[VALUE]||' ______________________ '||::[RUNTIME].[STDLIB].FIO(P_USER.[NAME]));
				end if;
				/*if del_page then [EXCEL].Delete_Sheet('Безналичные РУБЛЬ');
				end if;*/
/*-----------------------------------------------------------------------------------------------------------------------*/				
				-- обнуляем переменные
				vColCount := 5; -- всего колонок в отчете
				vLineCount := 6; -- первая строка в Excel
				i:=vLineCount;
				j:=i;
				del_page:=true;
				itog_kol :=0;
				itog_sum :=0;
				itog_kol_A:=0;
				itog_sum_A:=0;
				itog_kol_B:=0;
				itog_sum_B:=0;
				itog_kol_V:=0;
				itog_sum_V:=0;
				itog_kol_G:=0;
				itog_sum_G:=0;
				itog_kol_D:=0;
				itog_sum_D:=0;				
				-- запуск Excel
				[EXCEL].Open_Sheet('Безналичные ВАЛЮТА');
				-- цикл по договорам
				for (select distinct doc (	doc.[ACC_DT].[MAIN_V_ID] :C_DT_ACC
									,doc.[DOCUMENT_NUM] :C_NUM
									,doc.[ACC_KT].[MAIN_V_ID] :C_KT_ACC
									,doc.[SUM] :C_SUM
									,doc.[SUM_NT] :C_SUM_NT
									,doc.[ACC_DT].[MAIN_USV].[USV_US].[NEW_BS1].[RASD].[CHAPTER].[CHAPTER] :C_GL
									,doc.[NAZN] :C_NAZN
									,doc.[DOCUMENT_USER].[USERNAME] :C_DOCUMENT_USER_USERNAME
									,doc.[PROV_USER].[USERNAME] :C_PROV_USER_USERNAME
									) in ::[MAIN_DOCUM]
												where P_DATE<=trunc(doc.[DATE_PROV]) and trunc(doc.[DATE_PROV])<=P_DATE_END
												and doc%state='PROV'
												--and P_DEPART.[CODE] like ('%'||doc.[DEPART].[CODE]||'%')
												--and substr(P_DEPART.[CODE],1,3) = substr(doc.[DEPART].[CODE],1,3)
												and P_DEPART.[FILIAL]=doc.[FILIAL]
												and (decode(doc.[DOCUMENT_USER].[USERNAME]	--,'IBANK',doc.[PROV_USER]
																							--,'IBANK_101',doc.[PROV_USER]
																							,'IBS',doc.[PROV_USER]
																							,'ADM_001',doc.[PROV_USER]
																							,'ADM_101',doc.[PROV_USER]
																							--,'TRC',doc.[PROV_USER]
																							--,'TRC_101',doc.[PROV_USER]
																							,'SCAN_101',doc.[PROV_USER]
																							,doc.[DOCUMENT_USER])=P_USER
													--or (doc.[DOCUMENT_USER].[USERNAME] like ('TRC%') and P_WHO_RC=P_USER)
													--or (doc.[DOCUMENT_USER].[USERNAME] like ('IBANK%') and P_WHO_DBO=P_USER)
													or (doc.[DOCUMENT_USER].[USERNAME] like ('TRC%') and doc.[PROV_USER]=P_WHO_RC)
													or (doc.[DOCUMENT_USER].[USERNAME] like ('IBANK%') and doc.[PROV_USER]=P_WHO_DBO)
													)
												--and not exists (select p(p) in ::[DEPN] where p.[ACCOUNT]=doc.[ACC_DT] and substr(p.[ACCOUNT].[MAIN_V_ID],1,5) in ('40817','40820'))
												--and not exists (select p2(p2) in ::[DEPN] where p2.[ACCOUNT]=doc.[ACC_KT] and substr(p2.[ACCOUNT].[MAIN_V_ID],1,5) in ('40817','40820'))
												and ((substr(doc.[ACC_DT].[MAIN_V_ID],1,5) not in ('20202','40820','47411') --'40817', Башкиров В.Г. 05.12.2024 Jira CFT-278
													and substr(doc.[ACC_DT].[MAIN_V_ID],1,3) not in ('423','426')
													and substr(doc.[ACC_KT].[MAIN_V_ID],1,5) not in ('20202')
													--and substr(doc.[ACC_KT].[MAIN_V_ID],1,5) not in ('20202','40817','40820')
													--and substr(doc.[ACC_KT].[MAIN_V_ID],1,3) not in ('423','426')
													) or substr(doc.[ACC_DT].[MAIN_V_ID],1,5) in ('30102')
													)
												--and (doc.[VALUTA].[CUR_SHORT]!='RUB' or doc.[VALUTA_PO].[CUR_SHORT]!='RUB')
												--and (substr(doc.[ACC_DT].[MAIN_V_ID],6,3) not in ('810','643') or substr(doc.[ACC_KT].[MAIN_V_ID],6,3) not in ('810','643'))
												and substr(doc.[ACC_DT].[MAIN_V_ID],6,3) not in ('810','643')
									order by doc.[ACC_DT].[MAIN_USV].[USV_US].[NEW_BS1].[RASD].[CHAPTER].[CHAPTER], substr(doc.[ACC_DT].[MAIN_V_ID],1,5)
				)loop
				 	del_page:=false;
				 	itog_kol :=itog_kol+1;
					itog_sum :=itog_sum+to_number(doc.C_SUM_NT);
					if doc.C_GL='А' then
					itog_kol_A:=itog_kol_A+1;
					itog_sum_A:=itog_sum_A+to_number(doc.C_SUM_NT);
					elsif doc.C_GL='Б' then
					itog_kol_B:=itog_kol_B+1;
					itog_sum_B:=itog_sum_B+to_number(doc.C_SUM_NT);
					elsif doc.C_GL='В' then
					itog_kol_V:=itog_kol_V+1;
					itog_sum_V:=itog_sum_V+to_number(doc.C_SUM_NT);
					elsif doc.C_GL='Г' then
					itog_kol_G:=itog_kol_G+1;
					itog_sum_G:=itog_sum_G+to_number(doc.C_SUM_NT);
					elsif doc.C_GL='Д' then
					itog_kol_D:=itog_kol_D+1;
					itog_sum_D:=itog_sum_D+to_number(doc.C_SUM_NT);
					end if;
					-- вывод в Ексель
					
				if substr(doc.C_DT_ACC,1,5)!=poditog and i>6 then
					[EXCEL].Write(i, 2, ''''||poditog,true,null,null,null,'R');
					poditog:=substr(doc.C_DT_ACC,1,5);
					formula:='=SUM(R[-'||(i-j)||']C:R[-1]C)';
					[EXCEL].Formula(i,5,formula);
					i:=i+1;
					j := i;
				else poditog:=substr(doc.C_DT_ACC,1,5);
				end if;		
				
				[EXCEL].Write(i, 1,doc.C_NUM);
				[EXCEL].Write(i, 2,''''||doc.C_DT_ACC);
				[EXCEL].Write(i, 3,''''||doc.C_KT_ACC);
				[EXCEL].Write(i, 4,doc.C_SUM);
				[EXCEL].Write(i, 5,doc.C_SUM_NT);
				i := i + 1;

				end loop;
				
				
				[EXCEL].Write(i, 2, ''''||poditog,true,null,null,null,'R');
				formula:='=SUM(R[-'||(i-j)||']C:R[-1]C)';
				[EXCEL].Formula(i,5,formula);				
				--[EXCEL].Formula(i,2,formula,vColCount-1);
				
				[EXCEL].Set_number_Format(vLineCount+1,2,i,vColCount,2);
				[EXCEL].Borders(vLineCount, 1, i, vColCount, 'RLBTVH'); 		-- границы всюду
				i:=i+4;
				[EXCEL].Write(i, 1,'Общее количество документов '||itog_kol||' на сумму '|| to_char(itog_sum,'99G999G999G999D99') ||' в нац. покрытии',true);
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum)||')');
				i:=i+2;
				[EXCEL].Write(i, 1,'Из них:',true,false,9,'C');
				i:=i+2;
				if itog_kol_A>0 then
				[EXCEL].Write(i, 1,'Глава А. '||'Общее количество документов '||itog_kol_A||' на сумму '|| to_char(itog_sum_A,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_A)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;
				if itog_kol_B>0 then
				[EXCEL].Write(i, 1,'Глава Б. '||'Общее количество документов '||itog_kol_B||' на сумму '|| to_char(itog_sum_B,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_B)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;
				if itog_kol_V>0 then
				[EXCEL].Write(i, 1,'Глава В. '||'Общее количество документов '||itog_kol_V||' на сумму '|| to_char(itog_sum_V,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_V)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;
				if itog_kol_G>0 then
				[EXCEL].Write(i, 1,'Глава Г. '||'Общее количество документов '||itog_kol_G||' на сумму '|| to_char(itog_sum_G,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_G)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;
				if itog_kol_D>0 then
				[EXCEL].Write(i, 1,'Глава Д. '||'Общее количество документов '||itog_kol_D||' на сумму '|| to_char(itog_sum_D,'99G999G999G999D99') ||' в нац. покрытии',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum_D)||')',true,false,9,'C');
				[EXCEL].Merge(i,1,i,vColCount);				
				i:=i+2;
				end if;				
				[EXCEL].Write(i, 1,P_USER.[CASTA].[VALUE]||' ______________________ '||::[RUNTIME].[STDLIB].FIO(P_USER.[NAME]));				
				if del_page then [EXCEL].Delete_Sheet('Безналичные ВАЛЮТА');
				end if;		
				
/*-----------------------------------------------------------------------------------------------------------------------*/				
				-- обнуляем переменные
				vColCount := 5; -- всего колонок в отчете
				vLineCount := 6; -- первая строка в Excel
				i:=vLineCount;
				j:=i;
				del_page:=true;
				itog_kol :=0;
				itog_sum :=0;				
				-- запуск Excel
				[EXCEL].Open_Sheet('Безналичные вклады РУБЛЬ');
				-- цикл по договорам
				for (select distinct doc (	doc.[ACC_DT].[MAIN_V_ID] :C_DT_ACC
									,doc.[DOCUMENT_NUM] :C_NUM
									,doc.[ACC_KT].[MAIN_V_ID] :C_KT_ACC
									,doc.[SUM] :C_SUM
									,doc.[SUM_NT] :C_SUM_NT
									,doc.[NAZN] :C_NAZN
									,doc.[DOCUMENT_USER].[USERNAME] :C_DOCUMENT_USER_USERNAME
									,doc.[PROV_USER].[USERNAME] :C_PROV_USER_USERNAME
										)	in ::[MAIN_DOCUM]
												where trunc(doc.[DATE_PROV])>=P_DATE and trunc(doc.[DATE_PROV])<=P_DATE_END
												and doc%state='PROV'
												--and P_DEPART.[CODE] like ('%'||doc.[DEPART].[CODE]||'%')
												--and substr(P_DEPART.[CODE],1,3) = substr(doc.[DEPART].[CODE],1,3)
												and P_DEPART.[FILIAL]=doc.[FILIAL]
												and (decode(doc.[DOCUMENT_USER].[USERNAME]	,'IBANK',doc.[PROV_USER]
																							,'IBANK_101',doc.[PROV_USER]
																							,'IBS',doc.[PROV_USER]
																							,'ADM_001',doc.[PROV_USER]
																							,'ADM_101',doc.[PROV_USER]
																							--,'TRC',doc.[PROV_USER]
																							--,'TRC_101',doc.[PROV_USER]
																							,'SCAN_101',doc.[PROV_USER]
																							,doc.[DOCUMENT_USER])=P_USER
												  --or (doc.[DOCUMENT_USER].[USERNAME] like ('TRC%') and P_WHO_RC=P_USER)
													or (doc.[DOCUMENT_USER].[USERNAME] like ('TRC%') and doc.[PROV_USER]=P_WHO_RC)
													)
												--and not exists (select p(p) in ::[DEPN] where p.[ACCOUNT]=doc.[ACC_DT] and substr(p.[ACCOUNT].[MAIN_V_ID],1,5) in ('40817','40820'))
												--and not exists (select p2(p2) in ::[DEPN] where p2.[ACCOUNT]=doc.[ACC_KT] and substr(p2.[ACCOUNT].[MAIN_V_ID],1,5) in ('40817','40820'))
												and substr(doc.[ACC_DT].[MAIN_V_ID],1,5) not in ('20202')
												and substr(doc.[ACC_KT].[MAIN_V_ID],1,5) not in ('20202')
												and (
													substr(doc.[ACC_DT].[MAIN_V_ID],1,3) in ('423','426') or substr(doc.[ACC_DT].[MAIN_V_ID],1,5) in ('40817','40820','47411')
													)
													--or substr(doc.[ACC_KT].[MAIN_V_ID],1,3) in ('423','426') or substr(doc.[ACC_KT].[MAIN_V_ID],1,5) in ('40817','40820'))
												--and doc.[VALUTA].[CUR_SHORT]='RUB'
												--and doc.[VALUTA_PO].[CUR_SHORT]='RUB'
												--and (substr(doc.[ACC_DT].[MAIN_V_ID],6,3) in ('810','643') and substr(doc.[ACC_KT].[MAIN_V_ID],6,3) in ('810','643'))
												--and substr(doc.[ACC_DT].[MAIN_V_ID],6,3) in ('810','643')
												and substr(doc.[ACC_DT].[MAIN_V_ID],1,5) not in ('30102')	
									order by substr(doc.[ACC_DT].[MAIN_V_ID],1,5)
				)loop
				 	del_page:=false;
				 	itog_kol :=itog_kol+1;
					itog_sum :=itog_sum+to_number(doc.C_SUM_NT);
					-- вывод в Ексель
					
				if substr(doc.C_DT_ACC,1,5)!=poditog and i>6 then
					[EXCEL].Write(i, 2, ''''||poditog,true,null,null,null,'R');
					poditog:=substr(doc.C_DT_ACC,1,5);
					formula:='=SUM(R[-'||(i-j)||']C:R[-1]C)';
					[EXCEL].Formula(i,5,formula);
					i:=i+1;
					j := i;
				else poditog:=substr(doc.C_DT_ACC,1,5);
				end if;		
				
				[EXCEL].Write(i, 1,doc.C_NUM);
				[EXCEL].Write(i, 2,''''||doc.C_DT_ACC);
				[EXCEL].Write(i, 3,''''||doc.C_KT_ACC);
				[EXCEL].Write(i, 4,doc.C_SUM);
				[EXCEL].Write(i, 5,doc.C_SUM_NT);
				i := i + 1;

				end loop;
				
				
				[EXCEL].Write(i, 2, ''''||poditog,true,null,null,null,'R');
				formula:='=SUM(R[-'||(i-j)||']C:R[-1]C)';
				[EXCEL].Formula(i,5,formula);				
				--[EXCEL].Formula(i,2,formula,vColCount-1);
				
				[EXCEL].Set_number_Format(vLineCount+1,2,i,vColCount,2);
				[EXCEL].Borders(vLineCount, 1, i, vColCount, 'RLBTVH'); 		-- границы всюду
				i:=i+4;
				[EXCEL].Write(i, 1,'Общее количество документов '||itog_kol||' на сумму '|| to_char(itog_sum,'99G999G999G999D99') ||' в нац. покрытии',true);
				i:=i+1;
				[EXCEL].Write(i, 1,'('||::[RUNTIME].[STDLIB].N2Str(itog_sum)||')');
				i:=i+2;
				[EXCEL].Write(i, 1,P_USER.[CASTA].[VALUE]||' ______________________ '||::[RUNTIME].[STDLIB].FIO(P_USER.[NAME]));				
				if del_page then [EXCEL].Delete_Sheet('Безналичные вклады РУБЛЬ');
				end if;				

/*-----------------------------------------------------------------------------------------------------------------------*/	
