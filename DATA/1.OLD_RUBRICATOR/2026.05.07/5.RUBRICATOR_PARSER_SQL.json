{
  "version": "2.0.0",
  "description": "Алгоритмический парсер SQL для преобразования Oracle/PLPlus синтаксиса в ANSI SQL для DBI. Гибридный подход: быстрое решение (regex) + алгоритмический парсер.",
  "last_updated": "2026-05-05",
  "hybrid_mode": true,
  "total_rules": 12,
  "rules": [
    {
      "rule_code": "v50.SQL.OUTERJOIN.п.1.1",
      "priority": 1,
      "patterns": [
        {
          "name": "oracle_outer_plus_right",
          "regex": "(\\w+)\\.(\\w+)\\s*=\\s*(\\w+)\\.(\\w+)\\(\\+\\)",
          "description": "Oracle (+) справа",
          "transform_type": "regex",
          "transform": "left join {right_table} on {left_table}.{left_column} = {right_table}.{right_column}",
          "example_in": "t1.id = t2.id(+)",
          "example_out": "left join t2 on t1.id = t2.id"
        },
        {
          "name": "oracle_outer_plus_left",
          "regex": "(\\w+)\\.(\\w+)\\(\\+\\)\\s*=\\s*(\\w+)\\.(\\w+)",
          "description": "Oracle (+) слева",
          "transform_type": "regex",
          "transform": "right join {right_table} on {left_table}.{left_column} = {right_table}.{right_column}",
          "example_in": "t1.id(+) = t2.id",
          "example_out": "right join t2 on t1.id = t2.id"
        },
        {
          "name": "plplus_collection_true",
          "regex": "(\\w+)\\.\\[(\\w+)\\]\\s*=\\s*(\\w+)&collection\\(true\\)",
          "description": "PLPlus коллекция с параметром true",
          "transform_type": "hybrid",
          "algorithmic_hint": "Определить таблицу для коллекции {collection_alias}",
          "transform": "left join (::[{table}] all : {alias}) on {left_table}.[{left_column}] = {alias}&collection",
          "fallback_instruction": "-- ВАЖНО: преобразовать в LEFT JOIN. Определите таблицу для коллекции '{alias}' и выполните замену: left join (::[TABLE_NAME] all : {alias}) on {left_table}.[{left_column}] = {alias}&collection",
          "example_in": "cr.[LIST_PAY] = fo&collection(true)",
          "example_out": "left join (::[FACT_OPER] all : fo) on cr.[LIST_PAY] = fo&collection"
        }
      ]
    },
    {
      "rule_code": "v50.SQL.ROWNUM.п.1.2",
      "priority": 1,
      "patterns": [
        {
          "name": "rownum_equal",
          "regex": "\\bROWNUM\\s*=\\s*(\\d+)",
          "description": "ROWNUM = N",
          "transform_type": "regex",
          "transform": "fetch first {limit} rows only",
          "example_in": "where rownum = 1",
          "example_out": "fetch first 1 rows only"
        },
        {
          "name": "rownum_less_equal",
          "regex": "\\bROWNUM\\s*<=\\s*(\\d+)",
          "description": "ROWNUM <= N",
          "transform_type": "regex",
          "transform": "fetch first {limit} rows only",
          "example_in": "where rownum <= 10",
          "example_out": "fetch first 10 rows only"
        },
        {
          "name": "rownum_with_offset",
          "regex": "\\bROWNUM\\s+BETWEEN\\s+(\\d+)\\s+AND\\s+(\\d+)",
          "description": "ROWNUM BETWEEN",
          "transform_type": "regex",
          "transform": "offset on {offset-1} fetch first {limit} rows only",
          "example_in": "rownum between 5 and 10",
          "example_out": "offset on 4 fetch first 6 rows only"
        }
      ]
    },
    {
      "rule_code": "v50.SQL.CAST.п.1.5",
      "priority": 1,
      "patterns": [
        {
          "name": "string_plus_number",
          "regex": "(\\w+)\\s*\\+\\s*(\\d+)",
          "description": "Сложение строки с числом",
          "transform_type": "regex",
          "transform": "to_number({left}) + {right}",
          "example_in": "c_code + 1",
          "example_out": "to_number(c_code) + 1"
        },
        {
          "name": "number_like",
          "regex": "(\\w+)\\s+LIKE\\s+['\"]",
          "description": "LIKE с числовым полем",
          "transform_type": "regex",
          "transform": "to_char({field}) like",
          "example_in": "id like '123%'",
          "example_out": "to_char(id) like '123%'"
        }
      ]
    },
    {
      "rule_code": "v50.STOR.DATE.п.2.2",
      "priority": 1,
      "patterns": [
        {
          "name": "date_type_declaration",
          "regex": "\\b(\\w+)\\s+date\\b",
          "description": "Объявление переменной типа DATE",
          "transform_type": "regex",
          "transform": "{var_name} date_time",
          "example_in": "DateTimeEnd date;",
          "example_out": "DateTimeEnd date_time;"
        },
        {
          "name": "date_parameter",
          "regex": "(\\w+)\\s+in\\s+date\\b",
          "description": "Параметр типа DATE",
          "transform_type": "regex",
          "transform": "{param_name} in date_time",
          "example_in": "p_date in date",
          "example_out": "p_date in date_time"
        }
      ]
    },
    {
      "rule_code": "v50.SQL.DECODE.п.1.6.1",
      "priority": 1,
      "patterns": [
        {
          "name": "decode_simple",
          "regex": "DECODE\\s*\\(\\s*(\\w+)\\s*,\\s*(\\w+)\\s*,\\s*('[^']*')\\s*,\\s*(\\w+)\\s*,\\s*('[^']*')\\s*,\\s*('[^']*')\\s*\\)",
          "description": "DECODE с двумя условиями",
          "transform_type": "regex",
          "transform": "case {expr} when {v1} then {r1} when {v2} then {r2} else {default} end",
          "example_in": "decode(status,1,'A',2,'B','?')",
          "example_out": "case status when 1 then 'A' when 2 then 'B' else '?' end"
        },
        {
          "name": "decode_complex",
          "regex": "DECODE\\s*\\([^)]+\\)",
          "description": "Сложный DECODE",
          "transform_type": "hybrid",
          "algorithmic_hint": "Разобрать аргументы DECODE и преобразовать в CASE WHEN",
          "fallback_instruction": "-- ВАЖНО: заменить DECODE на CASE WHEN. Пример: case expr when v1 then r1 when v2 then r2 else default end"
        }
      ]
    },
    {
      "rule_code": "v50.SQL.CONNECTBY.п.1.8",
      "priority": 2,
      "patterns": [
        {
          "name": "connect_by_simple",
          "regex": "CONNECT\\s+BY\\s+PRIOR\\s+(\\w+)\\s*=\\s*(\\w+)",
          "description": "CONNECT BY PRIOR id = parent_id",
          "transform_type": "hybrid",
          "algorithmic_hint": "Полный разбор иерархического запроса, преобразование в WITH RECURSIVE",
          "fallback_instruction": "-- ВАЖНО: преобразовать CONNECT BY в WITH RECURSIVE. Пример: with recursive cte as (select * from t where start_condition union all select t2.* from t t2 join cte on t2.parent_id = cte.id) select * from cte",
          "example_in": "select * from t connect by prior id = parent_id start with parent_id is null",
          "example_out": "with recursive cte as (select * from t where parent_id is null union all select t2.* from t t2 join cte on t2.parent_id = cte.id) select * from cte"
        }
      ]
    },
    {
      "rule_code": "v50.PROC.EXECUTE.п.3.3",
      "priority": 1,
      "patterns": [
        {
          "name": "execute_immediate_no_quotes",
          "regex": "EXECUTE\\s+IMMEDIATE\\s+'([^']*\\bZ#\\w+\\b[^']*)'",
          "description": "EXECUTE IMMEDIATE с именем таблицы без кавычек",
          "transform_type": "regex",
          "transform": "execute immediate '{quoted_sql}'",
          "note": "Добавить двойные кавычки вокруг имени таблицы: \"Z#TABLE\"",
          "example_in": "execute immediate 'truncate table Z#T'",
          "example_out": "execute immediate 'truncate table \"Z#T\"'"
        }
      ]
    },
    {
      "rule_code": "v50.PROC.WHENOTHERS.п.3.5",
      "priority": 1,
      "patterns": [
        {
          "name": "when_others_no_rollback",
          "regex": "WHEN\\s+OTHERS\\s+THEN\\s+(?!.*?(ROLLBACK|RAISE))",
          "description": "WHEN OTHERS без ROLLBACK или RAISE",
          "transform_type": "regex",
          "transform": "when others then\n            rollback;\n            raise;",
          "note": "Добавить ROLLBACK и RAISE",
          "example_in": "exception when others then null;",
          "example_out": "exception when others then rollback; raise;"
        }
      ]
    },
    {
      "rule_code": "v50.PROC.EMPTY_STRING.п.3.2",
      "priority": 1,
      "patterns": [
        {
          "name": "empty_string_comparison",
          "regex": "=\\s*''|''\\s*=",
          "description": "Сравнение с пустой строкой",
          "transform_type": "regex",
          "transform": "is null",
          "note": "В PostgreSQL '' is not null, заменить на is null",
          "example_in": "where name = ''",
          "example_out": "where name is null"
        }
      ]
    }
  ],
  "global_settings": {
    "fallback_instruction_template": "-- ВАЖНО: автоматическое преобразование не выполнено. {instruction}",
    "preserve_original_comments": true,
    "log_transformations": true
  }
}