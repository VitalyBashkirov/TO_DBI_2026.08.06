public function getCertificates(p_msg_struct in out &prx_cit.data2pack_type) return &lib_cl.CertificTable is 
Certificates	&lib_cl.CertificTable;
arr_cnt		integer;
cnt			integer;
value		varchar2(2000);
begin
	&i_get_str('CERTIFICATES',1, arr_cnt, value)
	if arr_cnt > 0 then
		for i in 1..arr_cnt
		loop
			&i_get_str('TYPE',i, cnt, Certificates(i).TYPE_)
			&i_get_str('SER',i, cnt, Certificates(i).SER)
			&i_get_str('NUM',i, cnt, Certificates(i).NUM)
			&i_get_str('WHO',i, cnt, Certificates(i).WHO)
			&i_get_date('DATE',i, cnt, Certificates(i).DATE_)
			&i_get_date('DATE_END',i, cnt, Certificates(i).DATE_END)
			&i_get_str('DEPART_CODE',i, cnt, Certificates(i).DEPART_CODE)
			&i_get_str('PLACE',i, cnt, Certificates(i).PLACE)
