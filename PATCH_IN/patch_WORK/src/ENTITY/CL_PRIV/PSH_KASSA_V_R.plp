			  (r.[OPER_BLOK] is null or r.[OPER_BLOK] = false) and
			  (r.[KASSIR] is null or r.[KASSIR] = V_CASHIER_INFO.[KASSIR]) loop
		V_AVAIL_OPERS_STR := V_AVAIL_OPERS_STR || r.[OPERATION].[KOD_OPER] || ',';
	end loop;
	V_AVAIL_OPERS_STR := nvl(V_AVAIL_OPERS_STR, 'ALL');

	&client.Get_Req_Cl(ClPrivRef, vCUST_PROPS);
	vCUST_DOC_TYPE				:= ClPrivRef.[DOC].[TYPE];
	vCUST_PROPS.[NAME]			:= upper(trim(vCUST_PROPS.[NAME]));
	vCUST_PROPS.[REZIDENT]		:= nvl(vCUST_PROPS.[REZIDENT], true);
	V_REZIDENT.[0] 				:= nvl(bool_num(vCUST_PROPS.[REZIDENT],1,2),3);
	vCUST_PROPS.[PASSPORT]		:= substr(trim(vCUST_DOC_TYPE.[FULL_NAME]), 1, vCUST_PROPS.[PASSPORT]%size);
	V_WHO_V						:= vCUST_PROPS.[WHO_V];
	
	vPHONE:=::[PSH_LOCAL_JOB].[PSH_LIB].GetPhoneNumber(ClPrivRef.[CONTACTS]);
	
	declare
		m_card ref [MIGRATION_CARD];
	begin
		locate m_card in ClPrivRef.[MIGR_CARD]
		where m_card.[DATE_END] is null or m_card.[DATE_END] >= trunc(sysdate)
		order by m_card.[DATE_END] desc, m_card.[DATE_BEG] desc;
		V_MIGR_CARD := m_card;
	exception when NO_DATA_FOUND then V_MIGR_CARD := null;
	end;
	
	V_DOC_ARR%delete;
	&srv.set_doc_arr(ClPrivRef->(::[CL_PRIV])[DOC_ARR], V_DOC_ARR);

	if vCUST_DOC_TYPE.[MASK_SERIA] is not Null or (vCUST_DOC_TYPE.[MASK_SERIA] is Null and vCUST_DOC_TYPE.[MASK_NUMBER] is Null) then
		 V_SHOW_SERIA := True;
	else V_SHOW_SERIA := False;
	end if;

	if vCUST_PROPS.[COUNTRY].[HAVE_TERROR] then
		V_LABEL207P		 := 'Страна входит в перечень гос-в по статье 6 ФЗ115';
		V_LABEL207P_2	 := null;
		V_SUSPECT_COUNTRY:= true;
	end if;
	
