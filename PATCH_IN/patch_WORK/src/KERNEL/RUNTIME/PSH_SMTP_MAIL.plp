public procedure SendMail5
	(sToEMail varchar2
		/* Один или несколько адресов, разделенных ";" или ",". */
	,sSubject varchar2
		/* Тема письма. */
	,sBodyMessage clob
		/* Текст письма. */
	,sFromEMail varchar2 default null
		/* Отправитель письма. */
	,attach_file_name varchar2 default null
		/* Имя файла. */
	,attach in blob default null
		/* Содержимое бинарного файла. */
	,bThrowExc boolean default false
		/* Признак вызова ошибки при неудачной отправке. */
	,isHtml boolean default false
		/* Признак того, что тип MIME для текста письма должен быть text/html. */
	) is 
	v_err varchar2(32767);
	v_attach [EMAIL].attach_array;
begin
	set_param_email;
	if attach is not null and dbms_lob.getlength(attach) > 0 then
		v_attach.init;
		v_attach.extend(1);
		v_attach(v_attach.last).filename := attach_file_name;
		v_attach(v_attach.last).bdata := attach;
	end if;
	v_err := [EMAIL].send
		(p_recipients == ::[PCORE_INTERFACE].[INT_EMAIL_001].get_addresses_from_str(sToEMail)
		,p_sender == ::[PCORE_INTERFACE].[INT_EMAIL_001].get_address_from_str(sFromEMail)
		,p_subject == sSubject
		,p_message == sBodyMessage
		,p_mimetype == case when isHtml then 'text/html' else 'text/plain' end
		,p_attachments == v_attach
		,p_raise_error == bThrowExc
		);
	if v_err is not null then
		debug_pipe('Ошибка при отправке сообщения по электронной почте: '||v_err);
	end if;
end;

public function send
/* Выполняет отправку письма по электронной почте заданным адресатам. */
	(p_recipients in address_array
		/* Список адресатов. */
	,p_sender in address_rec
		/* Отправитель письма. */
	,p_subject in varchar2(4000)
		/* Тема письма. */
	,p_message in clob
		/* Текст письма. */
	,p_mimetype in varchar2(100) default 'text/plain'
		/* Тип MIME для текста письма. */
	,p_attachments in attach_array := null
		/* Список вложений. */
	,p_priority in number := null
		/* Приоритет письма: 1,2,3,4,5. */
	,p_raise_error boolean := null
		/* Признак вызова ошибки при неудачной отправке. */
	,p_message_base64 boolean default null
		/* Признак необходимости кодирования текста письма в base64. */
	)
	/* Текст ошибки, если отправка была неудачной. */
	return varchar2 is 
begin
	set_param_email;
	return [EMAIL].send
		(p_recipients == p_recipients
		,p_sender == p_sender
		,p_subject == p_subject
		,p_message == p_message
		,p_mimetype == nvl(p_mimetype,'text/plain')
		,p_attachments == p_attachments
		,p_priority == p_priority
		,p_raise_error == p_raise_error
		,p_message_base64 == p_message_base64
		);
end;

public function get_addresses_from_str
/* Разбирает строку с адресатами, разделёнными ";" и возвращает массив записей с информацией об адресатах. */
	(p_str varchar2(32767)
		/* Строка с адресатами, разделёнными ";".
			Каждый адрес в строке может быть записан в одном из следующих форматов:
			- user@mail.ru
			- <user@mail.ru>
			- Имя адресата <user@mail.ru>
			- "Имя адресата" <user@mail.ru>
		*/
	)
	/* Массив записей с информацией об адресатах. */
	return address_array is 
begin
	return ::[PCORE_INTERFACE].[INT_EMAIL_001].get_addresses_from_str(p_str);
end;

public function get_address_from_str
/* Разбирает строку и возвращает запись с информацией об адресате. */
	(p_str varchar2(32767)
		/* Строка с информацие об адресате в одном из следующих форматов:
		- user@mail.ru
		- <user@mail.ru>
		- Имя адресата <user@mail.ru>
		- "Имя адресата" <user@mail.ru>
	*/
	)
	/* Запись с информацией об адресате. */
	return address_rec is 
begin
	return ::[PCORE_INTERFACE].[INT_EMAIL_001].get_address_from_str(p_str);
end;




-- !!! DEPRECATED !!!
srv_reply utl_smtp.reply%type;

procedure view_reply(srv_reply utl_smtp.reply%type) is
begin
	debug_pipe('>'||srv_reply.code||'>'||srv_reply.text);
end;

FUNCTION get_address(addr_list IN OUT VARCHAR2) RETURN VARCHAR2 IS
	addr VARCHAR2(256);
	i    pls_integer;
	FUNCTION lookup_unquoted_char(str  IN VARCHAR2, chrs IN VARCHAR2) RETURN pls_integer is
		c	VARCHAR2(5);
		i	pls_integer;
		len	pls_integer;
		inside_quote BOOLEAN;
	begin
		inside_quote := false;
		i := 1;
		len := length(str);
		while (i <= len) loop
			c := substr(str, i, 1);
			if (inside_quote) then
				if (c = '"') then
					inside_quote := false;
				elsif (c = '\') then
					i := i + 1; -- Skip the quote character
				end if;
			elsif (c = '"') then
				inside_quote := true;
			elsif (instr(chrs, c) >= 1) then
				return i;
			end if;
			i := i + 1;
		end loop;
		return 0;
    END;
BEGIN
	addr_list := ltrim(addr_list);
	i := lookup_unquoted_char(addr_list, ',;');
	IF (i >= 1) THEN
		addr      := substr(addr_list, 1, i - 1);
		addr_list := substr(addr_list, i + 1);
	ELSE
		addr := addr_list;
		addr_list := '';
	END IF;
	i := lookup_unquoted_char(addr, '<');
	IF (i >= 1) THEN
		addr := substr(addr, i + 1);
		i := instr(addr, '>');
		IF (i >= 1) THEN
			addr := substr(addr, 1, i - 1);
		END IF;
	END IF;
	RETURN addr;
END;

-- Write a MIME header
PROCEDURE write_mime_header
	(conn  IN OUT NOCOPY utl_smtp.connection
	,name  IN VARCHAR2
	,value IN VARCHAR2
	)
IS
BEGIN
	utl_smtp.write_data(conn, name || ': ' || value || utl_tcp.CRLF);
END;

-- Mark a message-part boundary.  Set <last> to TRUE for the last boundary.
PROCEDURE write_boundary
	(conn  IN OUT NOCOPY utl_smtp.connection
	,last  IN	     BOOLEAN DEFAULT FALSE
	)
is
BEGIN
	IF (last) THEN
		utl_smtp.write_data(conn, LAST_BOUNDARY);
	ELSE
		utl_smtp.write_data(conn, FIRST_BOUNDARY);
	END IF;
END;

public PROCEDURE mail
/* DEPRECATED
Выполняет отправку письма. */
	(sender     IN VARCHAR2
		/* Отправитель. */
	,recipients IN VARCHAR2
		/* список получателей, разделённых ";" или ",". */
	,subject    IN VARCHAR2
		/* Тема письма. */
	,message    IN VARCHAR2
		/* Текст письма. */
	) is 
	conn utl_smtp.connection;
BEGIN
	conn := begin_mail(sender, recipients, subject);
	write_text(conn, message);
	end_mail(conn);
END;

public FUNCTION begin_mail
/* DEPRECATED
Создаёт соединение smtp и Формирует заголовок (служебную часть) письма. */
	(sender     IN VARCHAR2
		/* Отправитель. */
	,recipients IN VARCHAR2
		/* список получателей, разделённых ";" или ",". */
	,subject    IN VARCHAR2
		/* Тема письма. */
	,mime_type  IN VARCHAR2    DEFAULT 'text/plain'
		/* Тип MIME */
	,priority   IN PLS_INTEGER DEFAULT NULL
		/* Приоритет письма (1,2,3,4,5). */
	)
	/* Идентификатор соединения smtp. */
	RETURN utl_smtp.connection is 
	conn utl_smtp.connection;
BEGIN
	conn := begin_session;
	begin_mail_in_session(conn, sender, recipients, subject, mime_type, priority);
	RETURN conn;
END;

public PROCEDURE write_text
/* DEPRECATED
Выводит текст ascii в сообщение. */
	(conn    IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	,message IN VARCHAR2
		/* Текст ascii. */
	) is 
BEGIN
	utl_smtp.write_data(conn, message);
END;

public PROCEDURE write_mb_text
/* DEPRECATED
Выводит текст в сообщение, преобразуя его к бинарному виду. */
	(conn    IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	,message IN            VARCHAR2
		/* Текст. */
	) is 
BEGIN
	utl_smtp.write_raw_data(conn, utl_raw.cast_to_raw(message));
END;

public PROCEDURE write_raw
/* DEPRECATED
Выводит в сообщение бинарные данные. */
	(conn    IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	,message IN RAW
		/* Бинарные данные. */
	) is 
BEGIN
	utl_smtp.write_raw_data(conn, message);
END;

public PROCEDURE attach_text
/* DEPRECATED
Размещает в письме текстовое вложение. */
	(conn         IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	,data         IN VARCHAR2
		/* Текст вложения. */
	,mime_type    IN VARCHAR2 DEFAULT 'text/plain'
		/* Тип MIME. */
	,inline       IN BOOLEAN  DEFAULT TRUE
		/* Признак отображения вложения в тексте письма. */
	,filename     IN VARCHAR2 DEFAULT NULL
		/* Имя файла */
	,last         IN BOOLEAN  DEFAULT FALSE
		/* Признак формирования нижней границы вложения. */
	) is 
BEGIN
	begin_attachment(conn, mime_type, inline, filename);
	write_text(conn, data);
	end_attachment(conn, last);
END;

public PROCEDURE attach_base64
/* DEPRECATED
Размещает в письме бинарное вложение. */
	(conn         IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	,data         IN RAW
		/* Бинарные данные. */
	,mime_type    IN VARCHAR2 DEFAULT 'application/octet'
		/* Тип MIME. */
	,inline       IN BOOLEAN  DEFAULT TRUE
		/* Признак отображения вложения в тексте письма. */
	,filename     IN VARCHAR2 DEFAULT NULL
		/* Имя файла */
	,last         IN BOOLEAN  DEFAULT FALSE
		/* Признак формирования нижней границы вложения. */
	) is 
	i   PLS_INTEGER;
	len PLS_INTEGER;
BEGIN
	begin_attachment(conn, mime_type, inline, filename, 'base64');
	i   := 1;
	len := utl_raw.length(data);
	WHILE (i < len) LOOP
		IF (i + MAX_BASE64_LINE_WIDTH < len) THEN
			utl_smtp.write_raw_data(conn,utl_encode.base64_encode(utl_raw.substr(data, i, MAX_BASE64_LINE_WIDTH)));
		ELSE
			utl_smtp.write_raw_data(conn,utl_encode.base64_encode(utl_raw.substr(data, i)));
		END IF;
		utl_smtp.write_data(conn, utl_tcp.CRLF);
		i := i + MAX_BASE64_LINE_WIDTH;
	END LOOP;
	end_attachment(conn, last);
END;

public PROCEDURE begin_attachment
/* DEPRECATED
Открывает вложение: формирует верхнюю границу и заголовок. */
	(conn         IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	,mime_type    IN VARCHAR2 DEFAULT 'text/plain'
		/* Тип MIME. */
	,inline       IN BOOLEAN  DEFAULT TRUE
		/* Признак отображения вложения в тексте письма. */
	,filename     IN VARCHAR2 DEFAULT NULL
		/* Имя файла */
	,transfer_enc IN VARCHAR2 DEFAULT NULL
		/* Тип конвертации вложения ("7bit", "quoted-printable", "base64", "8bit", "binary"). */
	) is 
BEGIN
	write_boundary(conn);
	write_mime_header(conn, 'Content-Type', mime_type);
	IF (filename IS NOT NULL) THEN
		IF (inline) THEN
			write_mime_header(conn, 'Content-Disposition','inline; filename="'||filename||'"');
		ELSE
			write_mime_header(conn, 'Content-Disposition','attachment; filename="'||filename||'"');
		END IF;
	END IF;
	IF (transfer_enc IS NOT NULL) THEN
		write_mime_header(conn, 'Content-Transfer-Encoding', transfer_enc);
	END IF;
	utl_smtp.write_data(conn, utl_tcp.CRLF);
END;

public PROCEDURE end_attachment
/* DEPRECATED
Закрывает вложение. */
	(conn IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	,last IN BOOLEAN DEFAULT FALSE
		/* Признак формирования нижней границы вложения. */
	) is 
BEGIN
	utl_smtp.write_data(conn, utl_tcp.CRLF);
	IF (last) THEN
		write_boundary(conn, last);
	END IF;
END;

public PROCEDURE end_mail
/* DEPRECATED
Закрывает письмо и соединение smtp. */
	(conn IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	) is 
BEGIN
	end_mail_in_session(conn);
	end_session(conn);
END;

public FUNCTION begin_session
/* DEPRECATED
Создаёт соединение smtp. */
		/* Идентификатор соединения smtp. */
	RETURN utl_smtp.connection is 
	conn utl_smtp.connection;
BEGIN
	if host is null then
		init_;
	end if;
	srv_reply := utl_smtp.open_connection(HOST, PORT, conn);
	view_reply(srv_reply);
	srv_reply := utl_smtp.helo(conn, HELO);
	view_reply(srv_reply);
	RETURN conn;
END;

public PROCEDURE begin_mail_in_session
/* DEPRECATED
Формирует заголовок (служебную часть) письма в заданном соединении smtp. */
	(conn       IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	,sender     IN VARCHAR2
		/* Отправитель. */
	,recipients IN VARCHAR2
		/* список получателей, разделённых ";" или ",". */
	,subject    IN VARCHAR2
		/* Тема письма. */
	,mime_type  IN VARCHAR2  DEFAULT 'text/plain'
		/* Тип MIME */
	,priority   IN PLS_INTEGER DEFAULT NULL
		/* Приоритет письма (1,2,3,4,5). */
	) is 
	my_recipients VARCHAR2(32767) := recipients;
	my_sender     VARCHAR2(32767) := sender;
BEGIN
	srv_reply := utl_smtp.mail(conn, get_address(my_sender));
	WHILE (my_recipients IS NOT NULL) LOOP
		srv_reply := utl_smtp.rcpt(conn, get_address(my_recipients));
	END LOOP;
	srv_reply := utl_smtp.open_data(conn);
	write_mime_header(conn, 'From', sender);
	write_mime_header(conn, 'To', recipients);
	write_mime_header(conn, 'Subject', subject);
	write_mime_header(conn, 'Content-Type', mime_type);
	write_mime_header(conn, 'X-Mailer', MAILER_ID);
	IF (priority IS NOT NULL) THEN
		write_mime_header(conn, 'X-Priority', priority);
	END IF;
	utl_smtp.write_data(conn, utl_tcp.CRLF);
	IF (mime_type LIKE 'multipart/mixed%') THEN
		write_text(conn, 'This is a multi-part message in MIME format.' ||utl_tcp.crlf);
	END IF;
END;

public PROCEDURE end_mail_in_session
/* DEPRECATED
Закрывает письмо для заданного соединения smtp. */
	(conn IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	) is 
BEGIN
	srv_reply := utl_smtp.close_data(conn);
END;

public PROCEDURE end_session
/* DEPRECATED
Завершает сессию smtp. */
	(conn IN OUT NOCOPY utl_smtp.connection
		/* Идентификатор соединения smtp. */
	) is 
BEGIN
	srv_reply := utl_smtp.quit(conn);
END;

procedure set_param_email;
public procedure init_
/* Инициализация значений настроек
Прямой вызов не требуется - вызывается при инициализации пакета
*/ is 
begin
	HELO := ::[SYSTEM_PARAMS].[GET](tuneHelo);
	HOST := ::[SYSTEM_PARAMS].[GET](tuneHost);
	DEF_EMAIL := ::[SYSTEM_PARAMS].[GET](tuneDefEMail);
	PORT := ::[SYSTEM_PARAMS].[GET](tunePort);
	if HOST is null then
		pragma error('Инциализация библиотеки для отправки EMail: Не найден сервер SMTP (Настройка '||tuneHost||')!');
	elsif HELO is null then
		pragma error('Инциализация библиотеки для отправки EMail: Не найден домен отправителя (Настройка '||tuneHelo||')!');
	elsif DEF_EMAIL is null then
		pragma error('Инциализация библиотеки для отправки EMail: Не найден E-Mail отправителя по умолчанию (Настройка '||tuneDefEMail||')!');		
	elsif PORT is null then
		pragma error('Инциализация библиотеки для отправки EMail: Не найдено значение порта SMPT сервера (Настройка '||tunePort||')!');		
	end if;
	set_param_email;
end;


-- инициализация
begin
	init_;
end;
end;
