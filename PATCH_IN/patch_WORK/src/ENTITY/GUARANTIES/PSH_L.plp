class GUARANTIES;

@name('[ПСБ] Библиотека')
library PSH_L is
dp number:=null; --управление debug_pipe
fmt string(10):='dd/mm/yyyy';

--% ставка
public function GetPrc (gua ref GUARANTIES, d [DATE] default null) return [PRC12P6] is 
ExPrc [PRC12P6];
TmpSum [SUMMA]:=0;

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	for (select lf(lf.[REG_CURRENCY_SUM] : C_REG_CURRENCY_SUM) in gua.[LIST_FACT]
	where lf.[DATE]<=d and lf.[OPER]=::[VID_OPER_DOG]([CODE]='ГАШ_УЧ_КОММ_ГАРАНТ')) --МСФО. Гашение учтенной комиссии за гарантию
	loop
		TmpSum:=TmpSum+lf.C_REG_CURRENCY_SUM;
	end loop;
	ExPrc:=TmpSum/gua.[SUMMA]*100;
	return ExPrc;
end;

--Процент резерва МСФО,% PRC_DEVAL_HIST
public function GetPrcDevalHist(gua ref GUARANTIES, d [DATE] default null) return [NUM_38_20] is 
ExPrc [NUM_38_20];
begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	for (select pdh(pdh.[DEVAL_PRC] : C_DEVAL_PRC) in ::[PRC_DEVAL_HIST] all
	where pdh.[PRODUCT]=gua%id and nvl(pdh.[DATE_BEGIN],d)<=d and d<=nvl(pdh.[DATE_END],d)  order by pdh.date_begin  )
	loop
		ExPrc:=pdh.C_DEVAL_PRC;
		exit;
	end loop;
	
	
	for (select pdh(pdh.[DEVAL_PRC] : C_DEVAL_PRC) in ::[PRC_DEVAL_HIST] all
	where pdh.[PRODUCT]=gua%id and nvl(pdh.[DATE_BEGIN],d)<=d  order by pdh.date_begin desc  )
	loop
		ExPrc:=pdh.C_DEVAL_PRC;
		exit;
	end loop;
	
	return ExPrc;
end;


--Категория качества
public function GetServiceQualSign(gua ref GUARANTIES, d [DATE] default null) return [SHORT2] is 

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	for (select gr(gr.[RISK_GROUP].[GROUP_NUM] : C_RISK_GROUP_GROUP_NUM) in gua.[GR_RISK_HIST]
	where gr.[DATE_START]<=d and d<=gr.[DATE_END]
	order by gr.[DATE_END])
	loop
		return gr.C_RISK_GROUP_GROUP_NUM;
	end loop;
	return null;
end;

--Расчетный % резерва
public function GetPrcReserv(gua ref GUARANTIES, d [DATE] default null) return [PRC12P6] is 

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	for (select gr(gr.[PRC_RESERV] : C_PRC_RESERV) in gua.[GR_RISK_HIST]
	where gr.[DATE_START]<=d and d<=gr.[DATE_END]
	order by gr.[DATE_END])
	loop
		return gr.C_PRC_RESERV;
	end loop;
	return null;
end;

--Сумма расчетного резерва
public function GetSumCalcReserv(gua ref GUARANTIES, d [DATE] default null) return [SUMMA] is 

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	return gua.[SUMMA]*GetPrcReserv(gua)/100;
end;

--Наименование ПОТ
public function GetResPortKindName(gua ref GUARANTIES, d [DATE] default null) return [NAME] is 
rp_ref ref [RES_PORT];
AccGuar ref [AC_FIN];

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	AccGuar:=gua.[VNB_ACCOUNT];
	for rav in ::[RES_ACC_VAL] all
	where rav.[RES_ACC]=AccGuar and
		rav.[DATE_BEGIN]<=d and d<=rav.[DATE_END]
	order by rav.[DATE_END]
	loop
		rp_ref:=rav%parent;
		return rp_ref.[RES_PORT_KIND].[NAME];
	end loop;
	return null;
end;

--Сумма обеспечения
public function GetSumZalog (gua ref GUARANTIES, d [DATE] default null) return [SUMMA] is 
z_ref ref [ZALOG];
TmpSum [SUMMA]:=0;
flOk boolean:=false;

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	for ptl in ::[PART_TO_LOAN] all where ptl.[PRODUCT]=gua
	loop
		z_ref:=ptl%parent;
		flOk:=true;
		TmpSum:=TmpSum+z_ref.[SUMMA];
	end loop;
	if flOk then
		return TmpSum;
	end if;
	return null;
end;

--Наименование обеспечения
public function GetZalogName (gua ref GUARANTIES, d [DATE] default null) return string(32767) is 
z_ref ref [ZALOG];
ExStr string(32767);
nn number:=0;

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	for ptl in ::[PART_TO_LOAN] all where ptl.[PRODUCT]=gua
	loop
		z_ref:=ptl%parent;
		ExStr:=SubStr(ExStr||'('||to_char(z_ref.[SUMMA],'9999,999,999.99')||') '||z_ref.[VID_GUARANTEE].[NAME]||LF$,1,32767);
		nn:=nn+1;
	end loop;
	if nn=0 then return null; end if;
	return '['||nn||']'||trim(trim(ExStr,chr(10)),chr(13));
end;

--Дата выдачи гарантии
public function GetDateOutGua (gua ref GUARANTIES, d [DATE] default null) return [DATE] is 

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	for (select lf(lf.[DATE] : C_DATE) in gua.[LIST_FACT]
	where lf.[DATE]<=d and lf.[OPER]=::[VID_OPER_DOG]([CODE]='УЧТЕНА_НА_ВНЕБ') --Внебалансовый учет гарантии
	order by lf.[DATE])
	loop
		return lf.C_DATE;
	end loop;
	return null;
end;

--Сумма выплаченной комиссии
public function GetSumCom (gua ref GUARANTIES, d [DATE] default null) return [SUMMA] is 
TmpSum [SUMMA]:=0;

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	for (select lf(lf.[REG_CURRENCY_SUM] : C_REG_CURRENCY_SUM) in gua.[LIST_FACT]
	where lf.[DATE]<=d and lf.[OPER]=::[VID_OPER_DOG]([CODE]='ГАШ_УЧ_КОММ_ГАРАНТ')) --МСФО. Гашение учтенной комиссии за гарантию
	loop
		TmpSum:=TmpSum+lf.C_REG_CURRENCY_SUM;
	end loop;
	return TmpSum;
end;

--Кол-во дней до погашения
public function GetDaysDateEnd (gua ref GUARANTIES, d [DATE] default null) return number is 
n number;

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	n:=gua.[DATE_ENDING]-d;
	if n<0 then n:=null; end if;
	return n;
end;

--фактически сформированный резерв - остаток на счете резерва 47425,
--соответствующий счету 91315 в продукте "Резервирование" за дату отчета.
--Для гарантий в ПОТе указывается резерв, равный расчетному из колонки 10
--Фактически сформированный резерв
public function GetSumFactReserv(gua ref GUARANTIES, d [DATE] default null) return [SUMMA] is 
AccGuar ref [AC_FIN];

begin
	d:=nvl(d,::[GUARANTIES].Z1522841621.GetDateCalc);
	if GetResPortKindName(gua) is not null then
		return GetSumCalcReserv(gua);
	end if;

	AccGuar:=gua.[VNB_ACCOUNT];
	for (select rba(rba.[RES_ACC] : C_RES_ACC) in ::[RES_BASE_ACCS]
		where rba.[ACC]=AccGuar)
	loop
		return abs(F.A('И'||rba.C_RES_ACC%id||'СН',d));	--Сумма в валюте счета
	end loop;
	return null;
end;

public function GetPropVal
( p_prod ref [PRODUCT]
, p_on_date date default [SYSTEM].[OP_DATE]
, rProp ref [PROPERTY_GRP]
) return varchar2 is 
	p_kind_prop ref [KIND_PROP_PROD];
	g ref [GUARANTIES];
begin
	if p_prod is null or p_on_date is null or rProp is null then
		return null;
	end if;

	if p_prod%class='GUARANTIES' then
		g:=p_prod;
		return ::[PROPERTIES].[L].GetStr(g.[PROPERTIES],rProp,p_on_date);
	else
		pragma error('Требуется доработка для '||p_prod%class);
	end if;
end;

--Основной ОКВЭД
public function GetOkvedPrimary (gua ref GUARANTIES, d [DATE], TypeInfo number default 0) return [STRING_1000] is 
ExInfo [STRING_1000];
ClRef ref [CLIENT];
begin
	if d is null then d:=[SYSTEM].[OP_DATE]; end if;
	
	if TypeInfo<10 then ClRef:=gua.[PRINCIPAL];
	else				ClRef:=gua.[BENEFICIARY];
	end if;
	for (select oip(oip.[OKVED].[CODE]:C_OKVED_CODE, oip.[OKVED].[NAME]:C_OKVED_NAME) in ClRef.[OKVED_IN_PERIOD]
	where oip.[PRIMARY] and oip.[DATE_BEGIN]<=d and d<=nvl(oip.[DATE_END],d)
	order by oip.[DATE_BEGIN] desc)
	loop
		if    TypeInfo=0 or TypeInfo=10 then return oip.C_OKVED_CODE;
		elsif TypeInfo=1 or TypeInfo=11 then return oip.C_OKVED_NAME;
		end if;
	end loop;
	return null;
end;

public function GetPropValDepn
( p_prod ref [DEPN]
, p_on_date date default [SYSTEM].[OP_DATE]
, rProp ref [PROPERTY_TYPE] default ::[PROPERTY_TYPE]([CODE]='GUARANTEE_DEP')
) return varchar2 is 
ExStr varchar2;
begin
	if p_on_date is null then p_on_date:=[SYSTEM].[OP_DATE]; end if;
	
	if p_prod is null or p_on_date is null or rProp is null then
		return null;
	end if;
	
	ExStr:=::[PROPERTY].[LIB].get_property(rProp,p_on_date,p_prod.[PROPERTY_ARR]);
	debug_pipe('.GetPropValDepn -- На '||to_char(p_on_date,fmt)||' '||rProp.[NAME]||' p_prod.[PROPERTY_ARR]='||p_prod.[PROPERTY_ARR]||'{'||p_prod.[PROPERTY_ARR]%size(0)||'} -> '||ExStr,dp);
	return ExStr;
end;
end;
