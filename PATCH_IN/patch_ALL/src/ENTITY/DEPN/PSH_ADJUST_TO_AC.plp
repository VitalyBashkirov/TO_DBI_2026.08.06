class DEPN;

@import_plsql(true)
@this(create_on_start:=true)
@optimize(declarations:=true,this:=false,code:=true,descriptions:=true)
@name('[ПСБ] МСФО. Корректировка стоимости')
@tag('COPIED')
method PSH_ADJUST_TO_AC is

@name('Сумма %% по договору')             public V_SUMM_PRC_DOG    [SUMMA];
@name('Сумма %% по МСФО')                 public V_SUMM_PRC_IFRS   [SUMMA];
@name('Сумма корректировки')              public V_SUMM_ADJUSTMENT [SUMMA];
@name('Сумма корректировки операционная') public V_SUMM_ADJ_OPER   [SUMMA];

/*
 * Дата	    Автор       RP			Описание
 * -------- ----------- ----------- -----------------------------------------------------------------------------
 * 10.12.18	poljakova	RP0598744	Вызов функции сдвига даты ShiftDate осуществляется даже если нам передана дата P_DATE.
 * 25.12.18	poljakova	RP0600668	МСФО. Эффект при корректировке.
 * 29.01.19 mgavrilenko RP0602607	КОрректировка при непроведенных документах
 * 30.01.19 mgavrilenko	RP0603440 	В процедуре CalcSumms изменено определение даты начала получения %% для переходящих договоров
 * 01.02.19	mgavrilenko	RP0603452	Изменено определение условие получения ХФИ (выполняется, если корректировка не была запущена из модификации)
 * 12.04.19 mgavrilenko RP0606790 	В процедуре CalcSumms вызов функции GetPrcJournal_CASH заменен на GetPrcJournal
 * 02.04.19	akhmadiev	RP0599977	Сумма корректировки вычисляется и в валюте договора, и в нац. покрытии
 * 04.06.19 mgavrilenko	RP0608157	Добавлена проверка на выполнение модификации на дату запуска корректировки
 * 05.06.19 mgavrilenko	RP0595537 	Добавлена передача параметра P_MERGE_PERIOD в операцию CALC_PRC_IFRS
 * 18.07.19 mgavrilenko	RP0610752	Добавлена  обработка свойства prop_type_ifrs_delay_adj_to_ac со значением 0	
 * 25.07.19 brikin		RP0610111	Добавлена переменная V_Bus_Process, добавлено условия для определения бизнес-процесса
 * 26.07.19 mgavrilenko	RP0606995	В процедуре CalcSumms удалено условие на пролонгацию
 * 24.12.19 brikin		RP0617448	В строку доп параметров v_Adds передан тег IS_CRASH.
 * 04.03.20 mgavrilenko	RP0619600	Изменена логика функции GetMinDateBeg
 * 16.06.20 mgavrilenko	RP0623802	Изменена логика выполнненяи корректировки и расчета %% МСФО для ОК в последний рабочий день месяца != дате окончания
 * 29.06.20 mgavrilenko	RP0624604	в процедуре CalcSumms изменено определение vDateBeginCalc ( для ФИ без модификации и перехода)   	
 */

pragma include(::[DEPN].[LIB_MACRO]);
pragma include(::[RUNTIME].[MACRO_LIB]);
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma include(::[DEPN].[DEBUG_MACRO]);

pragma macro(fN,'LPAD([1],[2])||[3]',substitute);
pragma macro(fD,'to_char([1], ''dd.mm.yyyy'')||[2]',substitute);

public cn_sum_cor_proc_in		const ref [SUM_GUIDE] := ::[SUM_GUIDE]([COD] = 'DEP_КОР_ПРОЦ_ВХ');
public cn_sum_sum_ac			const ref [SUM_GUIDE] := ::[SUM_GUIDE]([COD] = 'DEP_СУММ_АС');
public cn_sum_cor_proc_reval	const ref [SUM_GUIDE] := ::[SUM_GUIDE]([COD] = 'DEP_КОР_ПРОЦ_ДООЦ');

public cn_sum_cor_oper_in		const ref [SUM_GUIDE] := ::[SUM_GUIDE]([COD] = 'DEP_КОР_ОПЕР_ВХ');
public cn_sum_cor_ss_pp			const ref [SUM_GUIDE] := ::[SUM_GUIDE]([COD] = 'DEP_КОР_СС_ПП');
public cn_sum_cor_ac_ef			const ref [SUM_GUIDE] := ::[SUM_GUIDE]([COD] = 'DEP_СУММ_АС_ЭФ');
public cn_sum_cor_oper_reval	const ref [SUM_GUIDE] := ::[SUM_GUIDE]([COD] = 'DEP_КОР_ОПЕР_ДООЦ');
public cn_sum_cor_oper_np_reval	const ref [SUM_GUIDE] := ::[SUM_GUIDE]([COD] = 'DEP_КОР_ОПЕР_ВН_ДООЦ');

cn_property_indicators		const ref [PROPERTY_TYPE] := ::[PROPERTY_TYPE]([CODE] = 'IS_CALC_IFRS_INDICATORS');

summ_adjustment_dog		[SUMMA];
sum_adj_oper_dog		[SUMMA];

function GetMinDateBeg ( p_depn			ref [DEPN]
						,p_OnDate		DATE
						,p_adds			varchar2(32000) default null
) return DATE is
	RetDate			DATE;
	dBegPeriod		DATE;
begin
	&debug('>--------GetMinDateBeg-------------',0)
	RetDate := ::[DEPN].[LIB_IFRS].GetDateBegAdjToAC(p_depn,p_OnDate);
	&debug('.GetMinDateBeg RetDate='||&d2cf(RetDate),1)
	--дата начала периода может быть передана из операции модификации
	dBegPeriod := [STR].get_date_par( p_adds, 'ADJ_PERIOD_BEG');
	&debug('.GetMinDateBeg dBegPeriod='||&d2cf(dBegPeriod),1)
	if dBegPeriod is not null then RetDate := least(dBegPeriod,RetDate); end if; 	
	&debug('<--------GetMinDateBeg------------- return '||&d2cf(RetDate),0)
	return RetDate;
end;

public procedure CalcSumms ( p_depn					ref [DEPN]
					, p_date					[DATE]
					, p_AddPar					varchar2(32000) default null
					, pOut_summ_prc_dog			OUT [SUMMA]
					, pOut_summ_prc_ifrs		OUT [SUMMA]
					, pOut_summ_adjustment		OUT [SUMMA]
					, pOut_summ_adjustment_dog	OUT [SUMMA]
					/*	Сумма корретировки в валюте ФИ	*/
					, pOut_sum_adj_oper			OUT [SUMMA]
					, pOut_sum_adj_oper_dog		OUT [SUMMA]
					/*	Сумма операционной корректировки в валюте	*/
					
) is
	v_SumCostAfter		[SUMMA];
	v_CB_COURCE			[SUMMA_16_6];
	v_DepAdjAC			[SUMMA];
	v_DepAdjOper		[SUMMA];
	recSum				::[DEPN_INTERFACE].[PRX_DEPN_TO_IFRS].tSumsRec;
	v_sum_prc_oper		[SUMMA];
	vDateBeginCalc		[DATE]; --Дата с которой получаем сумму %% по журналам
	
	course_date			date;
begin
	&Cash_Depn(p_depn)
	&debug('.CalcSumms p_depn='||p_depn||' p_date='||&d2cf(p_date),0)
	&debug('.CalcSumms p_AddPar='||p_AddPar,0)
	&debug('.CalcSumms &Depn.JOUR_CALC_PRC = ' || &Depn.JOUR_CALC_PRC, 0)
	&debug('.CalcSumms &Depn.JOUR_PENALTY = ' || &Depn.JOUR_PENALTY, 0)
	
	course_date := coalesce(to_date([STR].get_str_par( p_AddPar, 'COURSE_DATE'), 'DD.MM.YYYY'), p_date);
	&debug('.CalcSumms course_date: ' || to_char(course_date), 0)
	
	if [STR].get_bool_par( p_AddPar, 'IsModification' )
		and [STR].get_str_par( p_AddPar, 'OLD_IS_EIR' ) = false
		and	[STR].get_bool_par( p_AddPar, 'NEW_IS_EIR' ) = true
	then
		&debug('.CalcSumms Существенная модификация с изменением учета ФИ: ЛМ - ЭПС',0)
		vDateBeginCalc := p_date+1;
	else
		--проверим была ли существенная модификация по ДД до даты расчета
		--если да, то рассчитываем от даты модификации
		for (select prop (prop%id 			: id_
						,prop.[NUM_VALUE]	:num_value_						
						,prop.[DATE_BEGIN]	:date_beg_)
				in	::[PROPERTY] all
				where prop%collection = &depn.[PROPERTY_ARR]
				and prop.[PROPERTY_TYPE] = &L.prop_type_ifrs_modification
				and prop.[NUM_VALUE] = 3
				and prop.[DATE_BEGIN] <= P_DATE
				order by prop.[DATE_BEGIN] desc		
			)
		loop
			&debug('.CalcSumms выполнена модификация '||&d2cf(prop.date_beg_),3)
			--новые условия действию только для существенной модификации
			vDateBeginCalc := prop.date_beg_ + 1;
			exit;
		end loop;
		&debug('.CalcSumms vDateBeginCalc='||&d2cf(vDateBeginCalc),0)
		--если это не модификации определим дату начала действия ФИ, аэто дата постановки на учет +1 день
		-- с этой даты будем считать %% для корректировки (важно! для переходящих ДД с постановкой с даты последней пролонгации)
		-- если договор был открыт в последний рабочий день месяца и это не последний день месяца и выполнен сдвиг даты валютирования назад, то мы теряем ФО перво корректировки (за выходные),
		-- т.о. не нужно корректрировать дату начала с которой будем выполнять дальнейшие расчеты и дата начал а должна быть равна дата постновки на учет
		-- например 29.05 - пт, открыли договор, 31.05 выполнили корректировку стоимости, и с учетом сдвига документы проведены 29 числа, то брать дату начала учета как 30 - не корректно, задваиваются %
		if vDateBeginCalc is null then
			for (select prop (prop%id 			: id_
							,prop.[NUM_VALUE]	:num_value_						
							,prop.[DATE_BEGIN]	:date_beg_)
					in	::[PROPERTY] all
					where prop%collection = &depn.[PROPERTY_ARR]
					  and prop.[PROPERTY_TYPE] = cn_property_indicators	
					fetch 1
				)
			loop
				&debug('.CalcSumms дата начала учета ДД на по МСФО: '||prop.date_beg_,0)
				vDateBeginCalc :=prop.date_beg_;
			end loop;
		end if;
		&debug('.CalcSumms vDateBeginCalc='||&d2cf(vDateBeginCalc),0)
		vDateBeginCalc :=nvl(vDateBeginCalc,&Depn.[DATE_BEGINING]);
	end if;
	
	&debug('.CalcSumms vDateBeginCalc='||&d2cf(vDateBeginCalc),0)
	
	--Cумма процентов по договору																
	pOut_summ_prc_dog := ::[DEPN].[LIB_DEBT].GetPrcJournal(  J_Prc 	 		== &Depn.JOUR_CALC_PRC
															, J_Pen			== null
															, J_Tax			== null	
															, Since_Date		== vDateBeginCalc
															, On_Date	 		== p_date									 			
															, calcFintoolDepn	== true
															, rDepn				== &Depn.ID
																);	
																
	--Cумма процентов по МСФО
	::[DEPN_INTERFACE].[PRX_DEPN_TO_IFRS].getJournalPrcRecSums(   p_iPN 			== &Depn.[CLIENT].[PN]
																, p_nObjRef 		== &Depn.ID
																, p_rObjClass 		== &Depn.CLASS_ID
																, p_dFToolDateBeg 	== vDateBeginCalc
																, p_dDate 			== p_date
																, p_oSums		 	== recSum
																, p_tJournal 		== null 				-- из БД
																, p_bGenErr 		== false
																, p_dWithDate		== null
																);
																
	&debug('.CalcSumms recSum.nSumCostAfter='||recSum.nSumCostAfter||' recSum.nSumPrc='||recSum.nSumPrc||' recSum.nSumOperPrc='||recSum.nSumOperPrc||' recSum.nSumOperCorr='||recSum.nSumOperCorr,3)																
	-- АС после потоков
	v_SumCostAfter 		:= nvl( recSum.nSumCostAfter, 0 );
	--Сумма %% по ЭПС
	pOut_summ_prc_ifrs 	:= nvl( recSum.nSumPrc, 0 );
	--Сумма %% по ЭПС(операционная)
	v_sum_prc_oper  	:= nvl( recSum.nSumOperPrc, 0 );
	--Cумма операционной корректировки (по журналу)
	pOut_sum_adj_oper	:= nvl( recSum.nSumOperCorr, 0 );
	
	--Cумма всех выполненных корректировок по АС
	v_DepAdjAC := ::[DEPN].[LIB_DEBT].GetSummDebt(
						IdDep 		== &Depn.ID
						,VidDebt 	==  ::[VID_DEBT]([CODE] = 'КОР_БС_АС')
						,OnDate		== p_Date
						,WithDate	== vDateBeginCalc);
	
	v_DepAdjOper := ::[DEPN].[LIB_DEBT].GetSummDebt(
						IdDep		==	&Depn.ID
						,VidDebt	== ::[VID_DEBT]([CODE] = 'КОР_БС_ОПЕР')
						,OnDate		== p_Date
						,WithDate	== vDateBeginCalc);
	
	v_CB_COURCE := [HOOK]::[DEPN_COURCE]( &Depn.ID, course_date, &Depn.[FINTOOL], ::[SYSTEM].[SYS_MAIN_VAL], true);													
	
	&debug('.CalcSumms pOut_summ_prc_ifrs = ' || pOut_summ_prc_ifrs, 0)
	&debug('.CalcSumms pOut_summ_prc_dog = ' || pOut_summ_prc_dog, 0)
	&debug('.CalcSumms pOut_sum_adj_oper = '||pOut_sum_adj_oper,0)
	&debug('.CalcSumms v_sum_prc_oper = ' || v_sum_prc_oper, 0)
	&debug('.CalcSumms v_DepAdjAC = ' || v_DepAdjAC||' v_DepAdjOper='||v_DepAdjOper, 0)
	&debug('.CalcSumms Курс: ' || v_CB_COURCE, 0)
	
	--	pOut_summ_prc_ifrs, pOut_summ_prc_dog и v_DepAdjAC все типа SUMMA, поэтому при такой операции ничего не потеряем
	pOut_summ_adjustment_dog := pOut_summ_prc_ifrs - pOut_summ_prc_dog - v_DepAdjAC;
	
	pOut_summ_adjustment := pOut_summ_adjustment_dog * v_CB_COURCE;
	
	pOut_sum_adj_oper_dog := pOUt_sum_adj_oper - v_DepAdjOper;
	
	pOUt_sum_adj_oper	:= pOut_sum_adj_oper_dog * v_CB_COURCE;
	
	&debug('.CalcSumms pOut_summ_adjustment_dog = ' || pOut_summ_adjustment_dog, 0)
	&debug('.CalcSumms pOut_summ_adjustment = ' || pOut_summ_adjustment, 0)
	&debug('.CalcSumms pOut_sum_adj_oper_dog = ' || pOut_sum_adj_oper_dog, 0)
	&debug('.CalcSumms pOut_sum_adj_oper = ' || pOut_sum_adj_oper, 0)
	&Del_Depn
end;


