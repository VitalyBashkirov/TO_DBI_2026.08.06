		for ap in ClTmp.[ADD_PROP] where trunc(ap.[DATE_BEG])=trunc(P_DATE) and ap.[GROUP_PROP].[CODE]='SOURCE_MONEY_PROVIDED' loop
			V_SOURCE_MONEY_PROVIDED:=ap.[BOOL];
			V_NOTE:=ap.[STR];
			&debug('Нашли SOURCE_MONEY_PROVIDED ap.[BOOL]='||ap.[BOOL]||' ap.[STR]='||ap.[STR]||' ap.[OBJ]='||ap.[OBJ],dp)
		end loop;
	end if;

	if p_info is null then
