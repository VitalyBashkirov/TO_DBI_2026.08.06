class PL_US;

@import_plsql(true)
@name('[ПСБ] Удалить признак счета')
@tag('COPIED')
batch method PSH_PS_DEL is
PSH_PS_DEL (
	@name('Признак счета') P_PS in [PS$]
) is

execute is
	v_v_v_v_v_ps ref [PS];
	idx INTEGER;
	begin
		idx := this.first;
		while idx is not null

	v_v_v_v_v_ps ref [PS$];
	idx INTEGER DEFAULT 0;
begin
	idx := this.first;
	while idx is not null
	loop
		for v_ps in this(idx).[B_PS]
		where v_ps = P_PS
	end loop;
end;
	idx := this.first;
	while idx is not null
	loop
		for v_ps in this(idx).[B_PS] where v_ps = P_PS loop
		where v_ps = P_PS
		loop
		v_ps.[DELETE#AUTO];
		exit;
	end loop;
	idx := this.next(idx);

			v_ps.DELETE_AUTO;
			continue;
		end loop;

		idx := this.next(idx);
	end loop;

end;

end;

end;
end;
end;
