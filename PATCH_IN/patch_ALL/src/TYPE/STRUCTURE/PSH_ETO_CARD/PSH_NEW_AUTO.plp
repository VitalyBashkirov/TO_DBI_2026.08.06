class PSH_ETO_CARD;

@name('[ПСБ] Добавить')
@tag('CREATED')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('ID во внешней системе')               P_ID_EXT           in [VARCHAR_36],
	@name('Номер карты')                         P_CARD_NUMBER      in [STRING_24],
	@name('ID Клиента')                          P_CUSTOMER_ID      in [VARCHAR_36],
	@name('Дата истечения срока действия карты') P_EXP_DATE         in [DATE],
	@name('Тип продукта')                        P_PRODUCT_TYPE     in [STRING_2],
	@name('Номер счёта')                         P_ACCOUNT_NUMBER   in [STRING_32],
	@name('ID Карты')                            P_CARD_ID          in [VARCHAR_36],
	@name('Статус карты')                        P_HOT_CARD_STATUS  in [SHORT2],
	@name('Типа карты')                          P_CARD_TYPE_NAME   in [STRING_32],
	@name('ID Персоны')                          P_PERSON_ID        in [VARCHAR_36],
	@name('ID контракта карты')                  P_CARD_CONTRACT_ID in [VARCHAR_36],
	@name('Дата создания карты')                 P_CARD_CREATION_DT in [DATE],
	@name('Валюта (цифровой код)')               P_CURRENCY         in [STRING_3],
	@name('Валюта (буквенный код)')              P_CURRENCY_AL_CODE in [STRING_3],
	@name('Клиент')                              P_CLIENT           in [CL_PRIV_REF],
	@name('Счёт карты')                          P_CARD_ACCOUNT     in [AC_FIN_REF],
	@name('Счета карты')                         P_CARD_ACCOUNTS    in [PSH_ETO_C_AC_ARR]
) return ref [PSH_ETO_CARD] is

validate is
begin
	if p_message = 'DEFAULT' then
		P_ID_EXT := this.[ID_EXT];
		P_CARD_NUMBER := this.[CARD_NUMBER];
		P_CUSTOMER_ID := this.[CUSTOMER_ID];
		P_EXP_DATE := this.[EXP_DATE];
		P_PRODUCT_TYPE := this.[PRODUCT_TYPE];
		P_ACCOUNT_NUMBER := this.[ACCOUNT_NUMBER];
		P_CARD_ID := this.[CARD_ID];
		P_HOT_CARD_STATUS := this.[HOT_CARD_STATUS];
		P_CARD_TYPE_NAME := this.[CARD_TYPE_NAME];
		P_PERSON_ID := this.[PERSON_ID];
		P_CARD_CONTRACT_ID := this.[CARD_CONTRACT_ID];
		P_CARD_CREATION_DT := this.[CARD_CREATION_DT];
		P_CURRENCY := this.[CURRENCY];
		P_CURRENCY_AL_CODE := this.[CURRENCY_AL_CODE];
		P_CLIENT := this.[CLIENT];
		P_CARD_ACCOUNT := this.[CARD_ACCOUNT];
		P_CARD_ACCOUNTS := this.[CARD_ACCOUNTS];
	end if;
end;

execute is
begin
	[ID_EXT] := P_ID_EXT;
	[CARD_NUMBER] := P_CARD_NUMBER;
	[CUSTOMER_ID] := P_CUSTOMER_ID;
	[EXP_DATE] := P_EXP_DATE;
	[PRODUCT_TYPE] := P_PRODUCT_TYPE;
	[ACCOUNT_NUMBER] := P_ACCOUNT_NUMBER;
	[CARD_ID] := P_CARD_ID;
	[HOT_CARD_STATUS] := P_HOT_CARD_STATUS;
	[CARD_TYPE_NAME] := P_CARD_TYPE_NAME;
	[PERSON_ID] := P_PERSON_ID;
	[CARD_CONTRACT_ID] := P_CARD_CONTRACT_ID;
	[CARD_CREATION_DT] := P_CARD_CREATION_DT;
	[CURRENCY] := P_CURRENCY;
	[CURRENCY_AL_CODE] := P_CURRENCY_AL_CODE;
	[CLIENT] := P_CLIENT;
	[CARD_ACCOUNT] := P_CARD_ACCOUNT;
	[CARD_ACCOUNTS] := P_CARD_ACCOUNTS;
end;
end;
end;
