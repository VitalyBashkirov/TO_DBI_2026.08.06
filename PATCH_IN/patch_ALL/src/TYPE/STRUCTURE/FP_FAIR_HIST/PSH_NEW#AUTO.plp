class FP_FAIR_HIST;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Добавить')
@tag('COPIED')
constructor PSH_NEW#AUTO is

@name('Класс ЦБ')                                        public V_CLASS          [STRING_16];
@name('Переоценка активов и обязательств по разным ТСС') public V_REV_SEP_FAIR_V [BOOLEAN];
V_NS ref [PAPER];

public function calc_fair_value(	v_date_def 		date,
							v_ns 		ref [PAPER],
							v_class 		varchar2(16),
							v_ns_price 		number,
							v_pkd 			number
						) return number is 
	rv number;
begin
	if v_class = 'OBLIGATION' then
		if v_date_def is null then
			rv := null;
		else
			rv := nvl([OBLIGATION].[LIB_P].get_nom4date(v_ns, v_date_def) * v_ns_price, 0) / 100 + nvl(v_pkd, 0);
		end if;			
	else
		rv := v_ns_price;
	end if;
	return rv;
end;
PSH_NEW#AUTO (
	@name('Дата определения справедливой стоимости')             P_DATE_DEF       in [DATE],
	@name('Вид стоимости')                                       P_TYPE_VALUE     in [FP_FAIR_TYPE_REF],
	@name('Источник')                                            P_SOURCE         in [SVU_SR_MRKT__REF],
	@name('Цена ЦБ')                                             P_NS_PRICE       in [NUMBER],
	@name('Валюта')                                              P_CUR            in [FT_MONEY_REF],
	@name('Процентный купонный доход на дату определения ст-ти') P_PKD            in [NUMBER],
	@name('Справедливая стоимость')                              P_VALUE          in [NUMBER],
	@name('Справедливая стоимость для обязательств')             P_VALUE_OBL      in [NUMBER]           default null,
	@name('Цена ЦБ для обязательств')                            P_NS_PRICE_OBL   in [NUMBER]           default null,
	@name('Валюта для обязательств')                             P_CUR_OBL        in [FT_MONEY_REF]     default null,
	@name('Вид стоимости для обязательств')                      P_TYPE_VALUE_OBL in [FP_FAIR_TYPE_REF] default null,
	@name('Источник цены для обязательств')                      P_SOURCE_OBL     in [SVU_SR_MRKT__REF] default null,
	@name('Активный рынок')                                      P_IS_ACT         in [BOOLEAN]          default null,
	@name('Признак наблюдаемости')                               P_IS_OBSERVE     in [BOOLEAN]          default null
) return ref [FP_FAIR_HIST] is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE_DEF := this.[DATE_DEF];
	P_TYPE_VALUE := this.[TYPE_VALUE];
	P_SOURCE := this.[SOURCE];
	P_NS_PRICE := this.[NS_PRICE];
	P_CUR := this.[CUR];
	P_PKD := this.[PKD];
	P_VALUE := this.[VALUE];
	P_VALUE_OBL := this.[VALUE_OBL];
	P_NS_PRICE_OBL := this.[NS_PRICE_OBL];
	P_CUR_OBL := this.[CUR_OBL];
	P_TYPE_VALUE_OBL := this.[TYPE_VALUE_OBL];
	P_SOURCE_OBL := this.[SOURCE_OBL];
	P_IS_ACT := this.[IS_ACT];
	P_IS_OBSERVE := this.[IS_OBSERVE];

end if;
-- End initialization of parameters and variables
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE_DEF := this.[DATE_DEF];
	P_TYPE_VALUE := this.[TYPE_VALUE];
	P_SOURCE := this.[SOURCE];
	P_NS_PRICE := this.[NS_PRICE];
	P_CUR := this.[CUR];
	P_PKD := this.[PKD];
	P_VALUE := this.[VALUE];
	P_VALUE_OBL := this.[VALUE_OBL];
	P_NS_PRICE_OBL := this.[NS_PRICE_OBL];
	P_CUR_OBL := this.[CUR_OBL];
	P_TYPE_VALUE_OBL := this.[TYPE_VALUE_OBL];
	P_SOURCE_OBL := this.[SOURCE_OBL];
	P_IS_ACT := this.[IS_ACT];
	P_IS_OBSERVE := this.[IS_OBSERVE];

end if;
-- End initialization of parameters and variables
declare
	coupon ref [COUPON];
begin
	if P_MESSAGE = 'DEFAULT' then
		V_NS:=this%parent->(::[FP_FAIR_VALUE])[NS];
		if V_NS is null then
			pragma error('Не задана ЦБ');
		end if;
		P_IS_ACT		 := nvl(P_IS_ACT,true);
		P_IS_OBSERVE	 := nvl(P_IS_OBSERVE,true);
		V_REV_SEP_FAIR_V := [FP_TUNE].[LIB].get_bool_value('EMIS_REV_SEP_FAIR_V');
					
		if P_TYPE_VALUE is null then
			P_TYPE_VALUE := ::[FP_FAIR_TYPE]([CODE]='MARKET_VALUE');
		end if;
		if V_REV_SEP_FAIR_V and P_TYPE_VALUE_OBL is null then
			P_TYPE_VALUE_OBL := ::[FP_FAIR_TYPE]([CODE]='MARKET_VALUE');
		end if;
		if [LIB].IS_PARENT('OBLIGATION',V_NS%class) then
			V_CLASS := 'OBLIGATION';
			P_CUR:=nvl(P_CUR,V_NS.[CUR_ONE].[CURRENCY]);
			if V_REV_SEP_FAIR_V then
				P_CUR_OBL := nvl(P_CUR_OBL,V_NS.[CUR_ONE].[CURRENCY]);
			end if;
		elsif [LIB].IS_PARENT('DR_SHARE',V_NS%class) 		
		      or
		      [LIB].IS_PARENT('SHARE',V_NS%class)
		then	
			V_CLASS := V_NS%class;
			P_CUR	:= coalesce(P_CUR,V_NS.[CUR_ONE].[CURRENCY],[FT_MONEY].[LIB].get_money(null));
		else
			V_CLASS := V_NS%class;			
			P_CUR	:= nvl(P_CUR,[FT_MONEY].[LIB].get_money(null));
			
			if V_REV_SEP_FAIR_V then
				P_CUR_OBL:=nvl(P_CUR_OBL,[FT_MONEY].[LIB].get_money(null));
			end if;
		end if;
	elsif P_MESSAGE = 'VALIDATE' then
		if p_info = 'P_DATE_DEF' then
			P_VALUE := calc_fair_value(P_DATE_DEF, V_NS, V_CLASS, P_NS_PRICE, P_PKD);
			if V_REV_SEP_FAIR_V then
				P_VALUE_OBL := calc_fair_value(P_DATE_DEF, V_NS, V_CLASS, P_NS_PRICE_OBL, P_PKD);
			end if;
		elsif p_info = 'P_NS_PRICE' then
			P_VALUE := calc_fair_value(P_DATE_DEF, V_NS, V_CLASS, P_NS_PRICE, P_PKD);
		elsif p_info = 'P_NS_PRICE_OBL' then
			P_VALUE_OBL := calc_fair_value(P_DATE_DEF, V_NS, V_CLASS, P_NS_PRICE_OBL, P_PKD);
		elsif p_info = 'P_PKD' then
			P_VALUE := calc_fair_value(P_DATE_DEF, V_NS, V_CLASS, P_NS_PRICE, P_PKD);
			if V_REV_SEP_FAIR_V then
				P_VALUE_OBL := calc_fair_value(P_DATE_DEF, V_NS, V_CLASS, P_NS_PRICE_OBL, P_PKD);
			end if;
		elsif p_info = 'Рассчитать' then			
			P_PKD := [COUPON].[LIBS].Recalc_Nkd(v_ns, 1, P_DATE_DEF, coupon);
			P_VALUE := calc_fair_value(P_DATE_DEF, V_NS, V_CLASS, P_NS_PRICE, P_PKD);
			if V_REV_SEP_FAIR_V then
				P_VALUE_OBL := calc_fair_value(P_DATE_DEF, V_NS, V_CLASS, P_NS_PRICE_OBL, P_PKD);
			end if;
		elsif p_info = 'P_IS_ACT' then
			if P_IS_ACT then
				P_IS_OBSERVE := true;
			end if;		
		end if;
	end if;
end;
end;
end;

execute is
v_parent ref [FP_FAIR_VALUE];
t_FP_FAIR_HIST	[FP_FAIR_HIST]%rowtable;	--Каждое поле - таблица
tmp ref [FP_FAIR_HIST]; --number; Башкиров В.Г. 08.12.2020
begin
	if P_DATE_DEF is null then
		pragma error('Не указана дата определения справедливой стоимости');
	end if;
	
	begin
		debug_pipe(this%class||'.'||this%id||' this%collection='||this%collection||' P_DATE_DEF='||to_char(P_DATE_DEF, 'dd/mm/yyyy')||' this%parentclass='||this%parentclass||'.'||this%parent%id,0);
		
	  --select x(1) in this%collection where x.[DATE_DEF] = P_DATE_DEF and x != this and rownum = 1 into tmp;
	  --select x(x%id) in this%collection where x.[DATE_DEF] = P_DATE_DEF and x != this and rownum = 1 into tmp;
		select x(x%id) in this%collection where x.[DATE_DEF] = P_DATE_DEF and x != this and rownum = 1 into tmp;
		
		-- Башкиров В.Г. 08.12.2020 --v--
	    if this%parent%id in (1630447480 --для ЦБ ROSN была оценка ТСС в 24.03.2020 и в RUB и в USD
	                         ,1635913312 --для ЦБ GAZP была оценка ТСС в 31.03.2020 и в RUB и в USD
	                         ,1671838877 --для ЦБ LKOH была оценка ТСС в 21.05.2020 и в RUB и в USD
	                         ,1631981379 --для ЦБ SBER была оценка ТСС в 28.05.2020 и в RUB и в USD
	                         ,1749207930 --для ЦБ FEES была оценка ТСС в 28.05.2020 и в RUB и в USD
	                         ,1762943903 --для ЦБ MGKN была оценка ТСС в 08.06.2020 и в RUB и в USD
	                         ,1705749569 --для ЦБ AFLT была оценка ТСС в 18.06.2020 и в RUB и в USD
	                         ,1756996298 --для ЦБ PLZL была оценка ТСС в 18.06.2020 и в RUB и в USD
							 ,1758603475 --для ЦБ CHMF была оценка ТСС в 18.06.2020 и в RUB и в USD
							 ,1756960551 --для ЦБ PIKK была оценка ТСС в 08.11.2020 и в RUB и в USD
							 ,1673528356 --для ЦБ TATNP была оценка ТСС в 18.11.2020 и в RUB и в USD
							 ,1747420343 --для ЦБ RSTI была оценка ТСС в 18.01.2021 и в RUB и в USD
							 ,1705704668 --для ЦБ DSKY была оценка ТСС в 07.04.2021 и в RUB и в USD
							 ,1785564260 --для ЦБ NVTK была оценка ТСС в 16.04.2021 и в RUB и в USD
							)
			or this%parent%id is not null -- Башкиров В.Г. 05.09.2021
	    then
	    	debug_pipe('>>> Игнорируем ош. Запись id='||tmp||' tmp.[DATE_DEF]='||to_char(tmp.[DATE_DEF],'dd/mm/yyyy')||' за дату ' || to_char(P_DATE_DEF, 'dd/mm/yyyy') || ' уже существует',0);
	    else
			pragma error('FP_FAIR_HIST.PSB_NEW#AUTO -- Запись id='||tmp%parentclass||'.'||tmp%parent||' tmp.[DATE_DEF]='||to_char(tmp.[DATE_DEF],'dd/mm/yyyy')||' за дату ' || to_char(P_DATE_DEF, 'dd/mm/yyyy') || ' уже существует');
	    end if;
		-- Башкиров В.Г. 08.12.2020 --^--

		--pragma error('Запись за дату ' || to_char(P_DATE_DEF, 'dd/mm/yyyy') || ' уже существует');
		exception when no_data_found then
		null;
	end;
	
	-- Установка значения реквизита "Дата определения справедливой стоимости"
	[DATE_DEF] := P_DATE_DEF;
	-- Установка значения реквизита "Вид стоимости"
	[TYPE_VALUE] := P_TYPE_VALUE;
	-- Установка значения реквизита "Вид стоимости для обязательств"
	[TYPE_VALUE_OBL] := P_TYPE_VALUE_OBL;
	-- Установка значения реквизита "Источник"
	[SOURCE] := P_SOURCE;
	-- Установка значения реквизита "Источник для обязательств"
	[SOURCE_OBL] := P_SOURCE_OBL;
	-- Установка значения реквизита "Цена ЦБ"
	[NS_PRICE] := P_NS_PRICE;
	-- Установка значения реквизита "Цена ЦБ для обязательств"
	[NS_PRICE_OBL] := P_NS_PRICE_OBL;
	-- Установка значения реквизита "Валюта"
	[CUR] := P_CUR;
	-- Установка значения реквизита "Валюта для обязательств"
	[CUR_OBL] := P_CUR_OBL;
	-- Установка значения реквизита "Процентный купонный доход на дату определения ст-ти"
	[PKD] := P_PKD;
	-- Установка значения реквизита "Справедливая стоимость"
	[VALUE] := P_VALUE;
	-- Установка значения реквизита "Справедливая стоимость для обязательств"
	[VALUE_OBL] := P_VALUE_OBL;
	-- Установка значения реквизита "Активный рынок"
	[IS_ACT] := P_IS_ACT;
	-- Установка значения реквизита "Признак наблюдаемости"
	[IS_OBSERVE] := P_IS_OBSERVE;
	--Изменить реквизиты хозяина
	select y(y%ID,
			y%class,
			y%collection,
			null,--state_id
			y%rowtype('nosys')
			)
		in this%collection,(select z(max(z.[DATE_DEF]):DATE_DEF) in this%collection)
		where y.[DATE_DEF]=z.DATE_DEF
		into t_FP_FAIR_HIST%rowtype;
	
	v_parent:=this%parent;
	
	debug_pipe('Изменить реквизиты хозяина '||v_parent%class||'.'||v_parent,0);
	update x(
		x.[CUR] 			= t_FP_FAIR_HIST.[CUR](1),
		x.[TYPE_VALUE] 		= t_FP_FAIR_HIST.[TYPE_VALUE](1),
		x.[VALUE]			= t_FP_FAIR_HIST.[VALUE](1),
		x.[CUR_OBL]			= t_FP_FAIR_HIST.[CUR_OBL](1),
		x.[TYPE_VALUE_OBL]	= t_FP_FAIR_HIST.[TYPE_VALUE_OBL](1),
		x.[VALUE_OBL]		= t_FP_FAIR_HIST.[VALUE_OBL](1),
		x.[DATE_CHECK]		= t_FP_FAIR_HIST.[DATE_DEF](1),
		x.[IS_ACT]			= t_FP_FAIR_HIST.[IS_ACT](1),
		x.[IS_OBSERVE]		= t_FP_FAIR_HIST.[IS_OBSERVE](1)
	)
	in ::[FP_FAIR_VALUE]
	where x=v_parent;
	debug_pipe(' x.[CUR]           ='||v_parent.[CUR].[CUR_SHORT],0);
	debug_pipe(' x.[TYPE_VALUE]    ='||v_parent.[TYPE_VALUE].[NAME],0);
	debug_pipe(' x.[VALUE]         ='||v_parent.[VALUE]			,0);
	debug_pipe(' x.[CUR_OBL]       ='||v_parent.[CUR_OBL]		,0);
	debug_pipe(' x.[TYPE_VALUE_OBL]='||v_parent.[TYPE_VALUE_OBL],0);
	debug_pipe(' x.[VALUE_OBL]     ='||v_parent.[VALUE_OBL]		,0);
	debug_pipe(' x.[DATE_CHECK]    ='||to_char(v_parent.[DATE_CHECK],'dd/mm/yyyy'),0);
	debug_pipe(' x.[IS_ACT]        ='||v_parent.[IS_ACT]		,0);
	debug_pipe(' x.[IS_OBSERVE]    ='||v_parent.[IS_OBSERVE]	,0);
end;
end;
end;
