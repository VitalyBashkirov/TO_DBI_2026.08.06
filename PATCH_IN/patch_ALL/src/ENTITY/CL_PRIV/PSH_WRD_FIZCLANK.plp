					where nvl(x.[DATE_END], ::[SYSTEM].op_date + 1) >= ::[SYSTEM].op_date
				)
				loop
					P_DATA := P_DATA || x.cert_type || NL$;
				end loop;
				P_DATA := rtrim(ltrim(P_DATA), NL$);
			elsif p_info = 'ДОП_ДОК_СЕРИЯ' then
				for (select x(x.[SER] : ser)
