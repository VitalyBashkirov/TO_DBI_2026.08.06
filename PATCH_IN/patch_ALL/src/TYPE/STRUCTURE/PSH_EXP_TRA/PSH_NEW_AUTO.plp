class PSH_EXP_TRA;

@generate_ansi_joins(true)
@name('[ПСБ] Добавить')
@tag('EXP_SWIFT')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('Приоритет')                                  P_PRIORITY    in [NUM10],
	@name('Наименование или часть наименования (рус.)') P_NAME_RUS    in [NAME],
	@name('Полное наименование (англ.)')                P_NAME_ENG    in [NAME],
	@name('Сокращенное наименование (англ.)')           P_SH_NAME_ENG in [NAME],
	@name('Тип адресного объекта')                      P_TYPE_OBJ    in [SHORT1],
	@name('Примечание')                                 P_NOTE        in [MEMO]
) return ref [PSH_EXP_TRA] is

execute is
begin
	if P_PRIORITY is null
	or P_NAME_RUS is null
	or P_NAME_ENG is null
	or P_SH_NAME_ENG is null
	or P_TYPE_OBJ is null
	then
		null;
	else
		for ett in ::[PSH_EXP_TRA] -- updated CHANGE_QUALIFIER EXP_TRANS_TAO->PSH_EXP_TRANS_TA 08/10/25 -- updated CHANGE_QUALIFIER PSH_EXP_TRANS_TA->PSH_EXP_TRA 08/10/25
		where ett.[TYPE_OBJ]=P_TYPE_OBJ
			and ett.[NAME_RUS]=P_NAME_RUS
			and ett.[NAME_ENG]=P_NAME_ENG
			and ett.[SH_NAME_ENG]=P_SH_NAME_ENG
			and ett%id<>this%id
		loop
			pragma error('Уже ЕСТЬ ТипАО:'||P_TYPE_OBJ
					||' "'||P_NAME_RUS||'"'
					||' "'||P_NAME_ENG||'"'
					||' "'||P_SH_NAME_ENG||'"');
			return;
		end loop;
	end if;

	-- Установка значения реквизита "Приоритет"
	if P_PRIORITY is null then
		pragma error('Не указан "Приоритет"');
	else
		for (select ett(ett%id : C_ID) in ::[PSH_EXP_TRA] -- updated CHANGE_QUALIFIER EXP_TRANS_TAO->PSH_EXP_TRANS_TA 08/10/25 -- updated CHANGE_QUALIFIER PSH_EXP_TRANS_TA->PSH_EXP_TRA 08/10/25
		where ett.[PRIORITY]=P_PRIORITY and ett%id<>this%id)
		loop
			pragma error('Уже ЕСТЬ запись (ID:'||ett.C_ID||') с приоритетом '||P_PRIORITY);
			return;
		end loop;
	end if;
	[PRIORITY] := P_PRIORITY;

	-- Установка значения реквизита "Наименование или часть наименования (рус.)"
	if P_NAME_RUS is null then
		pragma error('Не указано "Наименование или часть наименования (рус.)"');
	end if;
	[NAME_RUS] := P_NAME_RUS;

	-- Установка значения реквизита "Полное наименование (англ.)"
	if P_NAME_ENG is null then
		pragma error('Не указано "Полное наименование (англ.)"');
	end if;
	[NAME_ENG] := P_NAME_ENG;

	-- Установка значения реквизита "Сокращенное наименование (англ.)"
	if P_SH_NAME_ENG is null then
		pragma error('Не указано "Сокращенное наименование (англ.)"');
	end if;
	[SH_NAME_ENG] := P_SH_NAME_ENG;

	-- Установка значения реквизита "Тип адресного объекта"
	if P_TYPE_OBJ is null then
		pragma error('Не указано "Тип адресного объекта"');
	end if;
	[TYPE_OBJ] := P_TYPE_OBJ;

	-- Установка значения реквизита "Примечание"
	[NOTE] := nvl(P_NOTE,'"'||P_NAME_RUS||'"');
	::[PSH_EXP_TRA].[PSH_L].del_cash; -- updated CHANGE_QUALIFIER EXP_TRANS_TAO->PSH_EXP_TRANS_TA 08/10/25 -- updated CHANGE_QUALIFIER PSH_EXP_TRANS_TA->PSH_EXP_TRA 08/10/25 -- updated CHANGE_SHORT_NAME L->PSH_L 14/10/25
end;
end;
end;
