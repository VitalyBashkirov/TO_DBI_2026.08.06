class DAYDOCS;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Обнуление расчетов по итогам операции  (игнорируем отрицательное сальдо)')
@tag('COPIED')
static method PSH_OBNUL is
dp number(2):=0;	--управление debug_pipe

public bd_tbl [DAYDOCS].[PROCESS_SALDO].FP_BAS_DOC_TABLE;
pragma include(::[STOCK].[MSG]);

procedure make_comis_docs_new(p#prod ref [NS_OPER_DOG],
						p#folder in out ref [FOLDER_PAY],
						V_MARKET ref [MARKET_PLACE],
						V_MT_SEC ref [MT_SECTIONS],
						V_CUR_PAY ref [FT_MONEY],
						v_acc_30404 ref [SVU_FIN_AC],
						v_use_guarant number
					);
procedure make_pay_docs_new(p#prod ref [NS_OPER_DOG],
						p#folder in out ref [FOLDER_PAY],
						V_MARKET ref [MARKET_PLACE],
						V_MT_SEC ref [MT_SECTIONS],
						V_CUR_PAY ref [FT_MONEY],
						v_acc_30404 ref [SVU_FIN_AC],
						v_use_guarant number
					);

--AND Новый вариант процедуры, используемый в новой процедуре make_docs_2820_new
procedure PROCESS_NEW (	V_MODE 				number,
					V_SEC_IN_DOG 	ref [MT_SEC_IN_DOG],
					V_CURRENCY 		ref [FT_MONEY],
					V_SALDO_30404 		number default 0,
					p#prod_date			date,
					P#PROD			ref [NS_OPER_DOG],
					p#folder in out ref [FOLDER_PAY],
					ac_sec_rec			::[DAYDOCS].[ALIB].ac_sec_record --Сводные суммы по секции (и основной клиринговый, и клиринговый с обеспечением)
				) is	
	V_SCHEME 	ref [PATTERN_DOC];
	V_REQ_CLIENT	[REQ_CLIENT];				
	V_30402			[REQ_CLIENT];	-- торговый финансовый счет дилера
	V_30404			[REQ_CLIENT];	-- клиринговый финансовый счет секции (основной)
	V_47403_04		[REQ_CLIENT];	-- счет расчетов с биржей

	V_DOG_MARKET ref [DOG_MARKET];
	V_MT_SEC 	ref [MT_SECTIONS];
	V_MARKET 	ref [MARKET_PLACE];
	v_adds			[MEMO];
begin
	&dmess_var('Вошли в PROCESS_NEW', V_MODE);
	
	V_REQ_CLIENT.[0]		:= 1;
	V_REQ_CLIENT.[1].[1] := ::[SYSTEM].[VARIABLES].OurBank; 	-- наш банк

	-- счета, используемые в проводках
	V_30404 = V_30402 = V_47403_04 := V_REQ_CLIENT;

	--Найдем договор по секции
	V_DOG_MARKET := V_SEC_IN_DOG%parent;
	V_MT_SEC:=V_SEC_IN_DOG.[MT_SEC];
	V_MARKET:=V_DOG_MARKET.[MARKET];
	
	--Клиринговые счета секции (30424)
	if ac_sec_rec.ACC_30404 is not null then
		V_30404.[1].[2] := ac_sec_rec.ACC_30404.[ACC]; --средства участников РЦ ОРЦБ для обеспечения расчетов по операциям на ОРЦБ
	else
		--Если счет был не заполнен на этапе расчета сводных сумм по секции, значит возьмем клиринговый основной, а не с обеспечением.
		V_30404.[1].[2] := ::[SVU_FIN_AC].[LIBS].Get_Ac_Fin(V_SEC_IN_DOG.[FA_MT_SEC_ARR], V_CURRENCY); --средства участников РЦ ОРЦБ для обеспечения расчетов по операциям на ОРЦБ
	end if;
	
	if nvl(ac_sec_rec.use_guarant,0)=0 then--
		--Торговые счета секции (30413)
		if ac_sec_rec.ACC_30402 is not null then
			v_30402.[1].[2] := ac_sec_rec.ACC_30402.[ACC];
		else
			v_30402.[1].[2] := ::[SVU_FIN_AC].[LIBS].Get_Ac_Fin(V_SEC_IN_DOG.[FA_TRD_SEC_ARR], V_CURRENCY);
		end if;
	end if;	

	V_47403_04.[1].[2] := ::[DAYDOCS].[ALIB].get_47403_04(
							V_MARKET, -- торг.площадка
							V_MT_SEC, --секция торговой площадки AND 10/04/03
							V_CURRENCY, -- валюта
							P#PROD_DATE,
							false,
							ac_sec_rec.use_guarant);
	
	
	P#PROD.[ADD_ACC]( ::[TIP_ACC](COD = 'F_304_CLR'), V_30404);--30424 (основной клиринговый)
	P#PROD.[ADD_ACC]( ::[TIP_ACC](COD = 'F_304_TRD'), V_30402);--30413	
	P#PROD.[ADD_ACC]( ::[TIP_ACC](COD = 'ED_47403#04'), V_47403_04);

	--Обнуление 30404 по секции
	/*ВНИМАНИЕ! Входящий остаток используется на последнем этапе один раз
	*/
	--AND ВНИМАНИЕ!! Сумма возврата на торговый счет (30413) должна быть без суммы ГО
	if nvl(ac_sec_rec.use_guarant,0)=0 then
		P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_OBNUL'),
				nvl(V_SALDO_30404,0) + nvl(ac_sec_rec.SALDO, 0)); -- сумма без сумм по ГО
	else
		--Для счета "с гарантийным" не нужна сумма ED_SEC_OBNUL
		P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_OBNUL'),0);			
	end if;			
	&dmess_var('', V_SALDO_30404);
	&dmess_var('', ac_sec_rec.SALDO);
	&dmess_var('', ac_sec_rec.use_guarant);
	
	--Тепереь суммы с ГО и без ГО разделены на две записи по секции, и обрабатываются каждая в свою очередь.
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_DIL_BUY_AND_KOMIS'),
			nvl(ac_sec_rec.DIL_BUY, 0)+nvl(ac_sec_rec.DIL_KOMIS, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_DIL_BUY'),
			nvl(ac_sec_rec.DIL_BUY, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_DIL_KOMIS'),
			nvl(ac_sec_rec.DIL_KOMIS, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_DIL_SELL'),
			nvl(ac_sec_rec.DIL_SELL, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_BUY_AND_KOMIS'),
			nvl(ac_sec_rec.BUY, 0)+nvl(ac_sec_rec.KOMIS, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_SELL_AND_GASH'),
			nvl(ac_sec_rec.SELL, 0)+nvl(ac_sec_rec.GASH_SUM, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_COUP_GASH'),
			nvl(ac_sec_rec.GASH_SUM, 0));		
			
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_SALDO'),
			nvl(ac_sec_rec.SALDO, 0) );
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_BUY'),
			nvl(ac_sec_rec.BUY, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_KOMIS'),
			nvl(ac_sec_rec.KOMIS, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_SELL'),
			nvl(ac_sec_rec.SELL, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_OBL_GASH'),
			nvl(ac_sec_rec.GASH_OBL_SUM, 0));
	P#PROD.[ADD_SUM]( ::[SUM_GUIDE](COD = 'ED_SEC_OBL_DIL_GASH'),
			nvl(ac_sec_rec.DIL_GASH_OBL_SUM, 0));

	--Установка переменных для вычисления данных первичных документов в Б/О
	[PAT_ISSUE_NS].[SLIB].row.[BD_NAME] := ac_sec_rec.BD_NAME;
	[PAT_ISSUE_NS].[SLIB].row.[BD_NUM]	:= ac_sec_rec.BD_NUM;
	[PAT_ISSUE_NS].[SLIB].row.[BD_DATE]	:= ac_sec_rec.BD_DATE;
	
	&dmess_var('', ac_sec_rec.[MT_SEC].[NAME]);
	&dmess_var('', ac_sec_rec.DIL_BUY);
	&dmess_var('', ac_sec_rec.DIL_KOMIS);
	&dmess_var('', ac_sec_rec.DIL_SELL);
	&dmess_var('', ac_sec_rec.BUY);
	&dmess_var('', ac_sec_rec.KOMIS);
	&dmess_var('', ac_sec_rec.SELL);
	&dmess_var('', ac_sec_rec.GASH_SUM);
	&dmess_var('', ac_sec_rec.SALDO);
	&dmess_var('', ac_sec_rec.GASH_OBL_SUM);
	&dmess_var('', ac_sec_rec.DIL_GASH_OBL_SUM);

	--На самом деле - это вопрос, какие площадку секцию подкладывать для назначения платежа?
	--Текущую (V_MARKET) или главную (market)
	[SDELKA]::[LIB_VARS].V_MARKET := V_MARKET; -- здесь для Назначения платежа
	[SDELKA]::[LIB_VARS].V_MT_SEC := V_MT_SEC; -- здесь для Назначения платежа
	
	--Для того, чтобы можно было в Б/О использовать счета OP_47403/OP_47404 проинициализируем глобальные переменные
	[REG_PATT_ACC].[LIB_PATTERN].V_MARKET := V_MARKET;
	[REG_PATT_ACC].[LIB_PATTERN].V_MT_SEC := V_MT_SEC;
	[REG_PATT_ACC].[LIB_PATTERN].V_CUR	  := V_CURRENCY;
	[STR].set_par(v_adds,'P_CUR_BASE', V_CURRENCY);
	[STR].set_par(v_adds,'P_USE_GUAR', ac_sec_rec.use_guarant);
	
	&dmess('XXX [REG_PATT_ACC].[LIB_PATTERN].V_CUR=' || V_CURRENCY);
	
	-- Проводки по секции в заданной валюте
	/*
	F_304_CLR/ED_47403#04 [ED_SEC_SELL_AND_GASH]-[ED_SEC_BUY], если [ED_SEC_SELL_AND_GASH]>[ED_SEC_BUY]
		"Средства по итогам торгов на секции [ED_MT_SEC] [ED_MARKET] за [ED_DOG_DATE].[CP_NS_BASE_DOC]"
	ED_47403#04/F_304_CLR [ED_SEC_BUY]-[ED_SEC_SELL_AND_GASH], если [ED_SEC_SELL_AND_GASH]<[ED_SEC_BUY]
		"Средства по итогам торгов на секции [ED_MT_SEC] [ED_MARKET] за [ED_DOG_DATE].[CP_NS_BASE_DOC]"
	*/
	V_SCHEME := ::[PATTERN_DOC](PATTERN_CODE = 'F_SALDO_2820');
	&dmess('Сальдирование БО = ' || V_SCHEME.[PATTERN_CODE]||' P#PROD='||P#PROD||' ');
	::[FG_PATTERN_DOC].[BUSINESS_OP](V_SCHEME, null, P#PROD, NULL, NULL, false, P#FOLDER, P_ADDS==v_adds);
	
	--AND Отдельно формируем проводки по учету оплаченных комиссий по секциям+клиринговый счет
	make_comis_docs_new(P#PROD, P#FOLDER,V_MARKET,V_MT_SEC,V_CURRENCY,ac_sec_rec.ACC_30404,nvl(ac_sec_rec.use_guarant,0));
	--akhmadeeva Отдельно формируем проводки по выплатам контрагенту по сделкам РЕПО
	make_pay_docs_new(P#PROD, P#FOLDER,V_MARKET,V_MT_SEC,V_CURRENCY,ac_sec_rec.ACC_30404,nvl(ac_sec_rec.use_guarant,0));
	
	--AND ВНИМАНИЕ! Реализация предполагает наличия не более двух клиринговых счетов по секции - один основной, другой с обеспечением.	
	if nvl(ac_sec_rec.use_guarant,0)=0 then
		--Проверим полное сальдо по секции, так как обрабатывая клиринговый счет основной, будем формировать возвратную проводку
		--ВНИМАНИЕ! ac_sec_rec.SALDO без учета сумм по счету с обеспечением! В старов варианте операции PROCESS на данном шаге суммы ac_sec_rec уже также были освобождены от сумм ГО
		--Найдем все суммы по секции
		if nvl(V_SALDO_30404,0)+nvl(ac_sec_rec.SALDO,0)<0 then
			pragma error('Получено отрицательное сальдо '||(nvl(V_SALDO_30404,0)+nvl(ac_sec_rec.SALDO,0))||' '||V_CURRENCY.[CUR_SHORT]||' по счету '||V_30404.[1].[2].[MAIN_V_ID]||' секции '||V_MT_SEC.[NAME]||' торговой площадки '||V_MARKET.[NAME]);
		end if;
		/*
		AND Теперь новая БО в связи с изменением сальдовых проводок
		сумма [ED_SEC_OBNUL]=V_SALDO_30404 + nvl(ac_sec_rec.SALDO, 0),
		а сумма ac_sec_rec.SALDO содержит и покупки, и продажи, и гашения купонов, и комиссии, и ГАШЕНИЯ ОБЛИГАЦИИ (CUT).
		F_304_TRD/F_304_CLR [ED_SEC_OBNUL]
			"Средства по итогам торгов на секции [ED_MT_SEC] [ED_MARKET] за [ED_DOG_DATE].[CP_NS_BASE_DOC]"
		*/
		
		-- Необходимо повторно инициализировать библиотечные переменные, чтобы корретно отработала БО 'F_SALDO_2820_ADD'
		[SDELKA]::[LIB_VARS].V_MARKET := V_MARKET;
		[SDELKA]::[LIB_VARS].V_MT_SEC := V_MT_SEC;
		-- Также, необходимо повторно задать данные первичного учетного документа
		[PAT_ISSUE_NS].[SLIB].row.[BD_NAME] := ac_sec_rec.BD_NAME;
		[PAT_ISSUE_NS].[SLIB].row.[BD_NUM]	:= ac_sec_rec.BD_NUM;
		[PAT_ISSUE_NS].[SLIB].row.[BD_DATE]	:= ac_sec_rec.BD_DATE;
		
		V_SCHEME := ::[PATTERN_DOC](PATTERN_CODE = 'F_SALDO_2820_ADD');
		::[FG_PATTERN_DOC].[BUSINESS_OP](V_SCHEME, null, P#PROD, NULL, NULL, false, P#FOLDER, P_ADDS==v_adds);
	elsif nvl(ac_sec_rec.use_guarant,0)=1 then	
		--Проверка сводного остатка по счету с обеспечением нужно только для контроля,
		--так как проводки по возврату со счета обеспечения мы не формируем.
		--Башкиров В.Г. 07.03.2025
		debug_pipe('V_SALDO_30404='||V_SALDO_30404||' ac_sec_rec.SALDO='||ac_sec_rec.SALDO,dp);
		if nvl(V_SALDO_30404,0)+nvl(ac_sec_rec.SALDO,0)<0 then --ac_sec_rec.SALDO - суммы только по ГО
			--Башкиров В.Г. 07.03.2025
			--pragma error('Получено отрицательное сальдо '||(nvl(V_SALDO_30404,0)+nvl(ac_sec_rec.SALDO,0))||' '||V_CURRENCY.[CUR_SHORT]||' по счету с обеспечением '||V_30404.[1].[2].[MAIN_V_ID]||' секции '||V_MT_SEC.[NAME]||' торговой площадки '||V_MARKET.[NAME]);
			debug_pipe('Получено отрицательное сальдо '||(nvl(V_SALDO_30404,0)+nvl(ac_sec_rec.SALDO,0))||' '||V_CURRENCY.[CUR_SHORT]||' по счету с обеспечением '||V_30404.[1].[2].[MAIN_V_ID]||' секции '||V_MT_SEC.[NAME]||' торговой площадки '||V_MARKET.[NAME],dp);
		end if;
	end if;
	
	if P#FOLDER is not null and P#FOLDER.[DOCS_IN_FOLD]%size(1)>0 then
		-- Проставить признак вставки прошлой датой. Т.к. БО - классическая, придется сделать это здесь
		-- Оговорено с and 10.03.2010
		var v_insert ref [ACC_OPER] := ::[ACC_OPER](CODE='40'); -- Вставка обычной прошлой датой
		--BS00129026 Признак вставки документа прошлой датой проставляется всегда
		update x(	x.[ACC_OPER] = v_insert,
					x.[DATE_DOC] = P#PROD_DATE,
					x.[DATE_VAL] = ::[PAT_ISSUE_NS].[SLIB].get_date_val(P#PROD_DATE) --RP0487368 Вычисление даты валютирования
		)
		in ::[MAIN_DOCUM]
		where 	x%id in (select y(y.[DOCUMENT]) in P#FOLDER.[DOCS_IN_FOLD] where y.[DOCUMENT]%class = 'MAIN_DOCUM');
	end if;	
	
	[SDELKA]::[LIB_VARS].V_MARKET := null;
	[SDELKA]::[LIB_VARS].V_MT_SEC := null;
	[REG_PATT_ACC].[LIB_PATTERN].V_MARKET := null;
	[REG_PATT_ACC].[LIB_PATTERN].V_MT_SEC := null;
	[REG_PATT_ACC].[LIB_PATTERN].V_CUR	  := null;
end;

--AND Новый вариант процедуры make_docs_2820, использующий таблицу сумм по секциям ac_sec_new, индексированную по строке
--секция+валюта+клиринговый счет+признак "с обеспечением"
procedure make_docs_2820_new(p#prod_date 		date,
					p#prod		 	ref [NS_OPER_DOG],
					p#folder in out ref [FOLDER_PAY]
				) is
	v_level string;
	ac_sec_rec ::[DAYDOCS].[ALIB].ac_sec_record;
	V_SEC_IN_DOG ref [MT_SEC_IN_DOG];
	V_SALDO_304 number;
	t type_number_table:=type_number_table();			
	v_ost_id ref [SVU_MT_SEC_OSTS];
	v_is_guarant boolean;
	j number;
begin
	if [STOCK].[MSG].IS_DEBUG then
		v_level := ::[DAYDOCS].[ALIB].ac_sec_new.first;
		while v_level is not null
		loop
			&dmess('v_level = <' || v_level || '>');
			&dmess('Итоговая сумма за день торгов = <' || ::[DAYDOCS].[ALIB].ac_sec_new(v_level).SALDO || '>');
			&dmess('Итоговая сумма по покупкам = <' || ::[DAYDOCS].[ALIB].ac_sec_new(v_level).BUY || '>');
			&dmess('Итоговая сумма по продажам = <' || ::[DAYDOCS].[ALIB].ac_sec_new(v_level).SELL || '>');
			&dmess('Итоговая сумма по комиссиям = <' || ::[DAYDOCS].[ALIB].ac_sec_new(v_level).KOMIS || '>');
			if ::[DAYDOCS].[ALIB].ac_sec_new(v_level).acc_30404 is not null then
				&dmess('Счёт 30424, с которого велись торги = <' || ::[DAYDOCS].[ALIB].ac_sec_new(v_level).acc_30404.[ACC].[MAIN_V_ID] || '>');
				&dmess('Счёт обеспечения? = <' || ::[DAYDOCS].[ALIB].ac_sec_new(v_level).use_guarant || '>');
			end if;
			if ::[DAYDOCS].[ALIB].ac_sec_new(v_level).acc_30402 is not null then
				&dmess('Счёт 30413, с которого велись торги = <' || ::[DAYDOCS].[ALIB].ac_sec_new(v_level).acc_30402.[ACC].[MAIN_V_ID] || '>');
			end if;
			&dmess('--------------------');
			v_level := ::[DAYDOCS].[ALIB].ac_sec_new.next(v_level);
		end loop;
	end if;

		v_level := ::[DAYDOCS].[ALIB].ac_sec_new.first;
		t.delete;
		while v_level is not null loop
			ac_sec_rec := ::[DAYDOCS].[ALIB].ac_sec_new(v_level);
&dmess('make_docs_2820_new ac_sec_rec.acc_30404.[ACC]='||ac_sec_rec.acc_30404.[ACC].[MAIN_V_ID]||' ac_sec_rec.use_guarant='||ac_sec_rec.use_guarant);			
			--Ищем договор для этой секции, а в нем секцию по договору
			V_SEC_IN_DOG:=ac_sec_rec.MT_SEC_IN_DOG_REF;
			--Найдем входящий остаток на счете секции и признак "с обеспечением"
			V_SALDO_304:=null;
			if nvl(ac_sec_rec.use_guarant,0)=1 then
				v_is_guarant:=true;
			else
				v_is_guarant:=false;
			end if;	
			v_ost_id:=null;
&dmess('V_SEC_IN_DOG='||V_SEC_IN_DOG||' ac_sec_rec.CUR_PAY='||ac_sec_rec.CUR_PAY||' ac_sec_rec.acc_30404.[ACC]='||ac_sec_rec.acc_30404.[ACC]||' v_is_guarant='||v_is_guarant);			
			for (select x(x.[OST]:ost,
						x:id_
						) in p#prod->(DAYDOCS)[MT_SEC_OSTS]
				where  x.[MT_SEC_IN_DOG]=V_SEC_IN_DOG
				and x.[CURRENCY]=ac_sec_rec.CUR_PAY
				and x.[ACC_CLEAR]=ac_sec_rec.acc_30404.[ACC]
				and nvl(x.[IS_GUAR],false)=v_is_guarant
				)
			loop
				V_SALDO_304 := x.ost;
				v_ost_id := x.id_;
&dmess('INSIDE V_SALDO_304='||V_SALDO_304 || '. Входящая позиция по 304 - ' || ac_sec_rec.acc_30404.[ACC].[MAIN_V_ID]);
				
				exit;
			end loop;
			if v_ost_id is not null then
				t.extend(1);
				t(t.last):=v_ost_id;
			end if;	
			
			--Формирует документы по текущей секции/площадке
			PROCESS_NEW (1,
						V_SEC_IN_DOG,
						ac_sec_rec.CUR_PAY,
						V_SALDO_304,
						p#prod_date,
						P#PROD,
						p#folder,
						ac_sec_rec
					);
			v_level := ::[DAYDOCS].[ALIB].ac_sec_new.next(v_level);
		end loop;
		
		
		--Теперь секции, по которым был ввод, но не было сделок
		for(select x(x.[OST]:OST,
					x.[MT_SEC_IN_DOG]:MT_SEC_IN_DOG,
					x.[MT_SEC_IN_DOG].[MT_SEC]:MT_SEC,
					x.[CURRENCY]:CURRENCY,
					x.[ACC_CLEAR]:ACC_CLEAR,
					x.[IS_GUAR]:IS_GUAR	
					) in p#prod->(DAYDOCS)[MT_SEC_OSTS]
			where not exists (select y(1) in cast(t,type_number_table) where y.column_value=x)
			)
		loop
&dmess('Теперь секции, по которым был ввод, но не было сделок');		
			ac_sec_rec:=null;
			ac_sec_rec.CUR_PAY:=x.CURRENCY;
			ac_sec_rec.MT_SEC:=x.MT_SEC;
			ac_sec_rec.use_guarant:=nvl(x.IS_GUAR,0);

			--Находим соответствующую запись, и берем с нее данные
			j := bd_tbl.first;
			while j is not null loop
				if ac_sec_rec.[MT_SEC] = bd_tbl(j).[MT_SEC] then
					ac_sec_rec.[BD_NAME] := bd_tbl(j).[TEXT_NAZN];
					ac_sec_rec.[BD_NUM]	 := bd_tbl(j).[NUM];
					ac_sec_rec.[BD_DATE] := bd_tbl(j).[DATE_OP];
					j := null;
				else
					j := bd_tbl.next(j);
				end if;
			end loop;

			V_SALDO_304:=x.OST;
			if nvl(ac_sec_rec.use_guarant,0)=1 then
				v_is_guarant:=true;
			else
				v_is_guarant:=false;
			end if;	
			
			--Найти для клирингового финсчета x.ACC_CLEAR запись в массиве счетов секции на договоре с площадкой
			V_SEC_IN_DOG:=x.MT_SEC_IN_DOG;
			select a(min(a%id))
			in V_SEC_IN_DOG.[FA_MT_SEC_ARR]
			where a.[ACC]=x.ACC_CLEAR
			and a.[IS_GUARANT]=v_is_guarant
			into ac_sec_rec.acc_30404;
&dmess('ac_sec_rec.acc_30404='||ac_sec_rec.acc_30404.[ACC].[MAIN_V_ID]||' V_SEC_IN_DOG='||V_SEC_IN_DOG||' x.ACC_CLEAR='||x.ACC_CLEAR||' v_is_guarant='||v_is_guarant);					
			
			--Найти для для клирингового финсчета x.ACC_CLEAR запись в массиве Торгово-клиринговых счетов (собственных или клиентских),
			--чтобы определить финансовый торговый счет acc_30402
			
			--Клиенты по секциям
			for(select a(a.[MT_SEC_CLIENTS].[TRADE_ACCS].[FA_TRD_SEC]: fa_trd_sec)
				in ::[DOG_MARKET]
				where a.[MT_SEC_CLIENTS].[MT_SEC] = x.MT_SEC
				and a.[MT_SEC_CLIENTS].[TRADE_ACCS].[FA_MT_SEC]=ac_sec_rec.acc_30404
				union--Секции дилера
				select a(a.[MT_SECTIONS].[TRADE_ACCS].[FA_TRD_SEC]: fa_trd_sec)
				in ::[DOG_MARKET]
				where a.[MT_SECTIONS].[MT_SEC] = x.MT_SEC
				and a.[MT_SECTIONS].[TRADE_ACCS].[FA_MT_SEC]=ac_sec_rec.acc_30404
				)
			loop
				ac_sec_rec.acc_30402:=a.fa_trd_sec;
				exit;
			end loop;
&dmess('ac_sec_rec.acc_30402='||ac_sec_rec.acc_30402.[ACC].[MAIN_V_ID]);			
			PROCESS_NEW (	1,
						x.MT_SEC_IN_DOG,
						ac_sec_rec.CUR_PAY,
						V_SALDO_304,
						p#prod_date,
						P#PROD,
						p#folder,
						ac_sec_rec
					);
		end loop;
end;

procedure make_comis_docs_new(p#prod ref [NS_OPER_DOG],
						p#folder in out ref [FOLDER_PAY],
						V_MARKET ref [MARKET_PLACE],
						V_MT_SEC ref [MT_SECTIONS],
						V_CUR_PAY ref [FT_MONEY],
						v_acc_30404 ref [SVU_FIN_AC],
						v_use_guarant number
					)
is
v_level string;
v_level2 string;
v_com_rec ::[DAYDOCS].[ALIB].sec_comis_record;
V_47403_04	ref [ACCOUNT];	-- счет расчетов с биржей
V_30404 ref [ACCOUNT];
V_DOG_TO_MT ref [DOG_MARKET];
V_SEC_TO_MT ref [MT_SEC_IN_DOG];

bd_name varchar2(32767);--Наименование первичного документа
bd_num varchar2(32767); --Номер первичного документа
bd_date date;			--Дата первичного документа

V_SCHEME ref [PATTERN_DOC];
v_adds string;
begin
	::[PAT_ISSUE_NS].[SLIB].set_nulls;
	::[PAT_ISSUE_NS].[SLIB].arr_delete;
	v_level:=V_MT_SEC||'#'||V_CUR_PAY||'#'||v_acc_30404;
	if not ::[DAYDOCS].[ALIB].sec_comis.exists(v_level) then
		return;
	end if;
	V_47403_04 := ::[DAYDOCS].[ALIB].get_47403_04(
								V_MARKET, -- торг.площадка
								V_MT_SEC, --секция торговой площадки AND 10/04/03
								V_CUR_PAY, -- валюта
								p#prod.[DATE_BEGINING],
								false,
								v_use_guarant
								);
	--Ищем договор для этой секции, а в нем секцию по договору
	V_SEC_TO_MT:=null;
	V_DOG_TO_MT:=null;
	for (select x(x.[MT_SECTIONS]%id:SEC_IN_DOG,x:DOG) in ::[DOG_MARKET]
		where x%state in ('EXEC', 'EDIT', 'COMPLETED')
		and x.[MT_SECTIONS].[MT_SEC]=V_MT_SEC
		)
	loop
		::[DOG_MARKET].[LIB].GET_MARKET_SEC(x.SEC_IN_DOG,x.DOG,V_SEC_TO_MT,V_DOG_TO_MT);
		exit;
	end loop;			
	--Найти реквизиты первичных документов
	bd_name:=null; --Наименование первичного документа
	bd_num:=null; --Номер первичного документа
	bd_date:=null;--Дата первичного документа
	
	v_level2:=::[DAYDOCS].[ALIB].ac_sec_new.first;
	while v_level2 is not null
	loop
		if ::[DAYDOCS].[ALIB].ac_sec_new(v_level2).[MT_SEC] in (V_MT_SEC,V_SEC_TO_MT.[MT_SEC])  then
			bd_name:=::[DAYDOCS].[ALIB].ac_sec_new(v_level2).[BD_NAME]; --Наименование первичного документа
			bd_num:=::[DAYDOCS].[ALIB].ac_sec_new(v_level2).[BD_NUM]; --Номер первичного документа
			bd_date:=::[DAYDOCS].[ALIB].ac_sec_new(v_level2).[BD_DATE];--Дата первичного документа
			exit;
		end if;
		v_level2:=::[DAYDOCS].[ALIB].ac_sec_new.next(v_level2);
	end loop;
	
	v_level2:=::[DAYDOCS].[ALIB].sec_comis(v_level).first;
	while v_level2 is not null
	loop
	&dmess('ЦИКЛ 2');
		v_com_rec:=::[DAYDOCS].[ALIB].sec_comis(v_level)(v_level2);
		if v_com_rec.COMIS>0 then
			v_adds := null;
			[STR].set_par(v_adds,'CP_TRADE_ACC',v_com_rec.trade_acc);
			&dmess('v_adds = '||v_adds);
			::[PAT_ISSUE_NS].[SLIB].arr_NEW#AUTO(P_TYPE_COMIS	== v_com_rec.COM_TYPE --Для нового выч. параметра CP_COMIS_NAME
												,P_BD_NAME	== bd_name
												,P_BD_NUM	== bd_num
												,P_BD_DATE	== bd_date
												,P_ADDS_PAR == v_adds
												);
			::[PAT_ISSUE_NS].[SLIB].set_sum('SUM_COMIS', nvl(v_com_rec.comis,0));
			::[PAT_ISSUE_NS].[SLIB].set_sum('CP_CONDITION', nvl(v_use_guarant,0));
			if v_com_rec.ACC_30404 is not null then
				V_30404 := v_com_rec.ACC_30404.[ACC];
			else
				V_30404 := ::[SVU_FIN_AC].[LIBS].Get_Ac_Fin(V_SEC_TO_MT.[FA_MT_SEC_ARR], V_CUR_PAY);
			end if;	
			::[PAT_ISSUE_NS].[SLIB].set_acc([TIP_ACC](COD='F_304_CLR'), V_30404);	
			::[PAT_ISSUE_NS].[SLIB].set_acc([TIP_ACC](COD='ED_47403#04'), V_47403_04);
		end if;
		v_level2:=::[DAYDOCS].[ALIB].sec_comis(v_level).next(v_level2);
	end loop;	
	
	if [PAT_ISSUE_NS].[SLIB].arr.count > 0 then
		[REG_PATT_ACC]::[LIB_PATTERN].PROD_NS := p#prod;
		[REG_PATT_ACC]::[LIB_PATTERN].DATE_OPEN := p#prod.[DATE_BEGINING];
		[SDELKA]::[LIB_VARS].V_MARKET := V_MARKET; -- здесь для Назначения платежа
		[SDELKA]::[LIB_VARS].V_MT_SEC := V_MT_SEC; -- здесь для Назначения платежа
		[REG_PATT_ACC].[LIB_PATTERN].V_CUR:= V_CUR_PAY;
		/*
		ED_47403#04/F_304_CLR [SUM_COMIS], если [SUM_COMIS]>0
			Расчеты по [CP_COMIS_NAME_D] по итогам торгов на секции [ED_MT_SEC] [ED_MARKET] за [ED_DOG_DATE] [CP_NS_BASE_DOC]

		*/
		V_SCHEME:= ::[PATTERN_DOC]([PATTERN_CODE] = 'F_COMIS_SALDO');
		[FG_PATTERN_DOC]::[BUSINESS_OP](V_SCHEME,null,p#prod,NULL,NULL,false,p#folder);	-- Выполнить БО
		[PAT_ISSUE_NS].[SLIB].arr_delete();
		[REG_PATT_ACC]::[LIB_PATTERN].PROD_NS := null;
		[REG_PATT_ACC]::[LIB_PATTERN].DATE_OPEN := null;
		[SDELKA]::[LIB_VARS].V_MARKET := null;
		[SDELKA]::[LIB_VARS].V_MT_SEC := null;
		[REG_PATT_ACC].[LIB_PATTERN].V_CUR:= null;
	end if;

end;					

procedure make_pay_docs_new(p#prod ref [NS_OPER_DOG],
						p#folder in out ref [FOLDER_PAY],
						V_MARKET ref [MARKET_PLACE],
						V_MT_SEC ref [MT_SECTIONS],
						V_CUR_PAY ref [FT_MONEY],
						v_acc_30404 ref [SVU_FIN_AC],
						v_use_guarant number
					)
is
v_level string;
v_level2 string;
v_pay_rec ::[DAYDOCS].[ALIB].sec_pay_record;
V_47403_04	ref [ACCOUNT];	-- счет расчетов с биржей
V_30404 ref [ACCOUNT];
V_DOG_TO_MT ref [DOG_MARKET];
V_SEC_TO_MT ref [MT_SEC_IN_DOG];

bd_name varchar2(32767);--Наименование первичного документа
bd_num varchar2(32767); --Номер первичного документа
bd_date date;			--Дата первичного документа

V_SCHEME ref [PATTERN_DOC];
begin
	&dmess('зашли в make_pay_docs_new');
	::[PAT_ISSUE_NS].[SLIB].set_nulls;
	::[PAT_ISSUE_NS].[SLIB].arr_delete;
	v_level:=V_MT_SEC||'#'||V_CUR_PAY||'#'||v_acc_30404;
	if not ::[DAYDOCS].[ALIB].sec_pay.exists(v_level) then
		return;
	end if;
	V_47403_04 := ::[DAYDOCS].[ALIB].get_47403_04(
								V_MARKET, -- торг.площадка
								V_MT_SEC, --секция торговой площадки AND 10/04/03
								V_CUR_PAY, -- валюта
								p#prod.[DATE_BEGINING],
								false,
								v_use_guarant
								);
	--Ищем договор для этой секции, а в нем секцию по договору
	V_SEC_TO_MT:=null;
	V_DOG_TO_MT:=null;
	for (select x(x.[MT_SECTIONS]%id:SEC_IN_DOG,x:DOG) in ::[DOG_MARKET]
		where x%state in ('EXEC', 'EDIT', 'COMPLETED')
		and x.[MT_SECTIONS].[MT_SEC]=V_MT_SEC
		)
	loop
		::[DOG_MARKET].[LIB].GET_MARKET_SEC(x.SEC_IN_DOG,x.DOG,V_SEC_TO_MT,V_DOG_TO_MT);
		exit;
	end loop;			
	--Найти реквизиты первичных документов
	bd_name:=null; --Наименование первичного документа
	bd_num:=null; --Номер первичного документа
	bd_date:=null;--Дата первичного документа
	
	v_level2:=::[DAYDOCS].[ALIB].ac_sec_new.first;
	while v_level2 is not null
	loop
		if ::[DAYDOCS].[ALIB].ac_sec_new(v_level2).[MT_SEC] in (V_MT_SEC,V_SEC_TO_MT.[MT_SEC])  then
			bd_name:=::[DAYDOCS].[ALIB].ac_sec_new(v_level2).[BD_NAME]; --Наименование первичного документа
			bd_num:=::[DAYDOCS].[ALIB].ac_sec_new(v_level2).[BD_NUM]; --Номер первичного документа
			bd_date:=::[DAYDOCS].[ALIB].ac_sec_new(v_level2).[BD_DATE];--Дата первичного документа
			exit;
		end if;
		v_level2:=::[DAYDOCS].[ALIB].ac_sec_new.next(v_level2);
	end loop;
	
	v_level2:=::[DAYDOCS].[ALIB].sec_pay(v_level).first;
	while v_level2 is not null
	loop
	&dmess('ЦИКЛ 2');
		v_pay_rec:=::[DAYDOCS].[ALIB].sec_pay(v_level)(v_level2);
		::[PAT_ISSUE_NS].[SLIB].arr_NEW#AUTO(P_BD_NAME	== bd_name
												,P_BD_NUM	== bd_num
												,P_BD_DATE	== bd_date
												);
		&dmess('SUM_PAY='|| nvl(v_pay_rec.sum_pay,0));
		::[PAT_ISSUE_NS].[SLIB].set_sum('SUM_PAY', nvl(v_pay_rec.sum_pay,0));
		if v_pay_rec.ACC_30404 is not null then
			V_30404 := v_pay_rec.ACC_30404.[ACC];
		else
			V_30404 := ::[SVU_FIN_AC].[LIBS].Get_Ac_Fin(V_SEC_TO_MT.[FA_MT_SEC_ARR], V_CUR_PAY);
		end if;	
		::[PAT_ISSUE_NS].[SLIB].set_acc([TIP_ACC](COD='F_304_CLR'), V_30404);	
		::[PAT_ISSUE_NS].[SLIB].set_acc([TIP_ACC](COD='ED_47403#04'), V_47403_04);
		&dmess('V_30404='||V_30404);
		v_level2:=::[DAYDOCS].[ALIB].sec_pay(v_level).next(v_level2);
	end loop;	
	
	if [PAT_ISSUE_NS].[SLIB].arr.count > 0 then
		&dmess('[PAT_ISSUE_NS].[SLIB].arr.count='||[PAT_ISSUE_NS].[SLIB].arr.count);
		[REG_PATT_ACC]::[LIB_PATTERN].PROD_NS := p#prod;
		[REG_PATT_ACC]::[LIB_PATTERN].DATE_OPEN := p#prod.[DATE_BEGINING];
		[SDELKA]::[LIB_VARS].V_MARKET := V_MARKET; -- здесь для Назначения платежа
		[SDELKA]::[LIB_VARS].V_MT_SEC := V_MT_SEC; -- здесь для Назначения платежа
		[REG_PATT_ACC].[LIB_PATTERN].V_CUR:= V_CUR_PAY;
		V_SCHEME:= ::[PATTERN_DOC]([PATTERN_CODE] = 'F_PAY_REPO_SALDO');
		[FG_PATTERN_DOC]::[BUSINESS_OP](V_SCHEME,null,p#prod,NULL,NULL,false,p#folder);	-- Выполнить БО
		[PAT_ISSUE_NS].[SLIB].arr_delete();
		[REG_PATT_ACC]::[LIB_PATTERN].PROD_NS := null;
		[REG_PATT_ACC]::[LIB_PATTERN].DATE_OPEN := null;
		[SDELKA]::[LIB_VARS].V_MARKET := null;
		[SDELKA]::[LIB_VARS].V_MT_SEC := null;
		[REG_PATT_ACC].[LIB_PATTERN].V_CUR:= null;
	end if;

end;	
	
PSH_OBNUL (
	@name('Дата продукта')  P#PROD_DATE in     [DATE],
	@name('Продукт')        P#PROD      in     [NS_OPER_DOG_REF],
	@name('Операция')       P_OPER      in     [DOG_OPER_REF],
	@name('Папка платежей') P#FOLDER    in out [FOLDER_PAY_REF]
) is

execute is
	market 	ref [MARKET_PLACE];
	mt_sec 	ref [MT_SECTIONS];
	
	i pls_integer;
	ac_sec_rec ::[DAYDOCS].[ALIB].ac_sec_record;	
	tmp_tbl			rtl.integer_table;
begin
	make_docs_2820_new(	p#prod_date,
						p#prod,
						p#folder
					);			
end;
end;
end;
