--L
dp integer:=0;	--управление debug_pipe
dp2 integer:=0;
dp3 integer:=0;
dp4 integer:=0;
dp5 integer:=0;
dp6 integer:=0;	--CFT_SELECT
dp7 integer:=null;	--strStandartXxxName

