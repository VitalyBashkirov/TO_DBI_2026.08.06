	--------------------------------	
	begin
		locate mn_ref in ::[MAIN_DOCUM] where mn_ref%id = P_PROD%id;
		exception when NO_DATA_FOUND then
			mn_ref:=::[PATTERN_DOC].[BUSINESS_OP].doc_ref;
	end;
	if mn_ref is not null then
		if P_PAR = 'ОРЛ_СПКС_0309' then
			declare
				sm number;
				sm_10 number;
			begin
				begin
					sm := 0;
					sm_10 := 0;
					dtt := mn_ref.[DATE_PROV];
					dtt2 := LAST_DAY(ADD_MONTHS(dtt,-1))+1;
					dta := mn_ref.[ASTR_DATE_PROV];
					vacc := P_PROD->([RKO])[ACCOUNT];
					
					for doo in CURSOR mndc_b Loop null;
						--debug_pipe(doo.COUNT_DOC||' '||doo.SUMMA);
						for ksim in doo.dt.[SUM_KSPL] loop
							if ksim.[1].[1]<>40 and ksim.[1].[1]<>50 then
								sm_10 := sm_10 + ksim.[2];
								--debug_pipe(ksim.[2]);
							end if;
						end loop;
					end Loop;
					debug_pipe(sm_10);
					if sm_10 > 10000000 then
						ExMemo:= 6;
					end if;
					
					vacc := P_PROD->([RKO])[ACCOUNT];
					if mn_ref%state = 'PROV' then
						dtt := trunc(mn_ref.[DATE_PROV]);
						dta := mn_ref.[ASTR_DATE_PROV];
					else
						dtt := [SYSTEM]::[OP_DATE];
						dta := [SYSTEM]::[OP_DATE]+1;
					end if;
					
					for doo in CURSOR mndc_kas Loop null;
						for ksim in doo.dc.[SUM_KSPL] loop
							if ksim.[1].[1]<>40 and ksim.[1].[1]<>50 then
								sm := sm + ksim.[2];
								--debug_pipe(ksim.[2]);
							end if;
						end loop;
					end Loop;
					debug_pipe(sm);
					
					/*for ksim in mn_ref.[SUM_KSPL] loop
						if ksim.[1].[1]<>40 and ksim.[1].[1]<>50 then
							sm := sm + ksim.[2];
						end if;
					end loop;*/
					if sm<=10000 then
						ExMemo:= 1; goto nnn;
					elsif sm>10000 and sm<=100000 then
						ExMemo:= 2;
					elsif sm>100000 and sm<=1000000 then
						ExMemo:= 3; goto nnn;
					elsif sm>1000000 and sm<=5000000 then
						ExMemo:= 4;
					elsif sm>5000000 then
						ExMemo:= 5; goto nnn;
					end if;
				exception
				when NO_DATA_FOUND then
					Null;
				end;
				ExMemo:= Null;
			end;
		end if;
