		 	   P_DATA := trim(P_DATA);
	 		   P_DATA := substr(P_DATA,1,length(P_DATA)-1);
			elsif client_priv%id is not null then  -- для просто ФЛ
			   for cl_link in client_priv.[LINKS_OTHER] where
