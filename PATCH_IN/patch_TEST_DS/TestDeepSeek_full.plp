	-- end pl/sql
END;

-- ============================================================================
-- Правило 29: v50.PROC.TRIGGER.п.3.8 - Замена триггеров БД на операции-триггеры
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена триггеров БД на операции-триггеры
--   Подробное описание: Триггеры БД заменить на операции типа «Триггер» в PL+.
--   Пример кода для корректировки: create trigger trg on t
--   Пример исправленного кода: class T; trigger TVR_TRIG is ...
--   Теги: trigger, database, plsql
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Триггеры БД заменить на операции типа «Триггер» в PL+. Для совместимости добавить проверку attribute_mapping_service.is_enabled.
--   plplus_materials_note: Database triggers не поддерживаются в DBI.
--   search_prompt: Найти создание триггеров БД (CREATE TRIGGER).
--   regex_patterns.for_search: \bCREATE\s+TRIGGER\b
--   code_example_bad: create trigger trg on t
--   fix_instruction: Переписать триггер как операцию типа «Триггер» в PL+.
--   fix_prompt: Преобразуй триггер БД в операцию-триггер.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.TRIGGER.п.3.8'.
--   examples.trigger.bad: create trigger trg on t
--   examples.trigger.good: class T; trigger TVR_TRIG is ...
--   priority: high
--   category: PROC
--   subcategory: PROC.OTHER
--   source_files: v50.docx
--   source_sections: п.3.8
-- ============================================================================
PROCEDURE v50_PROC_TRIGGER_p_3_8 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		create trigger trg_update_client on clients after update as
		begin
			insert into audit_log values ('client updated');
		end;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		class CLIENT;
		trigger TRG_CLIENT_UPDATE is
		begin
			insert into audit_log values ('client updated');
		end;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 30: v50.PROC.XML.п.3.6 - Использование [RUNTIME].[XML_DB] для XML
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Использование [RUNTIME].[XML_DB] для XML
--   Подробное описание: Для работы с XML использовать только библиотеки [RUNTIME].[XML_DB], [RUNTIME].[XML_DOM], [RUNTIME].[XT], [RUNTIME].[XQ].
--   Пример кода для корректировки: dbms_xmldom
--   Пример исправленного кода: [RUNTIME].[XML_DB]
--   Теги: xml, parser, dom
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Для работы с XML использовать только библиотеки [RUNTIME].[XML_DB], [RUNTIME].[XML_DOM], [RUNTIME].[XT], [RUNTIME].[XQ].
--   plplus_materials_note: DBMS_XMLDOM и другие Oracle XML пакеты не поддерживаются.
--   search_prompt: Найти использование DBMS_XMLDOM, DBMS_XMLPARSER.
--   regex_patterns.for_search: \bDBMS_XMLDOM\b; \bDBMS_XMLPARSER\b
--   code_example_bad: dbms_xmldom
--   code_example_bad2: XMLType
--   fix_instruction: Заменить Oracle XML пакеты на [RUNTIME].[XML_DB] и связанные библиотеки.
--   fix_prompt: Выполни замену Oracle XML пакетов на RUNTIME.XML_DB.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.XML.п.3.6'.
--   examples.xml.bad: dbms_xmldom
--   examples.xml.good: [RUNTIME].[XML_DB]
--   priority: medium
--   category: PROC
--   subcategory: PROC.XML_JSON
--   source_files: v50.docx
--   source_sections: п.3.6
-- ============================================================================
PROCEDURE v50_PROC_XML_p_3_6 IS
	v_xml_doc DBMS_XMLDOM.DOMDocument;
	v_xml_db_doc ::[RUNTIME].[XML_DB].DOMDocument;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		v_xml_doc := DBMS_XMLDOM.newDomDocument();
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		v_xml_db_doc := ::[RUNTIME].[XML_DB].DOMDocument;
	-- end pl/sql
END;

