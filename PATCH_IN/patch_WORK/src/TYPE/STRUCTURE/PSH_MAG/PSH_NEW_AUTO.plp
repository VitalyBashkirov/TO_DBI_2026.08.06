class PSH_MAG;

@name('[ПСБ] Добавить')
@tag('CREATED')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('Дата, время вызова') P_DATE     in [DATE_TIME],
	@name('Пользователь')       P_USER     in [USER_REF],
	@name('Сетевое имя')        P_OS_USER  in [STRING_30],
	@name('Компьютер')          P_USERNAME in [STRING_30]
) return ref [PSH_MAG] is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE := this.[DATE];
	P_USER := this.[USER];
	P_OS_USER := this.[OS_USER];
	P_USERNAME := this.[USERNAME];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Дата, время вызова"
	[DATE] := P_DATE;
	-- Установка значения реквизита "Пользователь"
	[USER] := P_USER;
	-- Установка значения реквизита "Сетевое имя"
	[OS_USER] := P_OS_USER;
	-- Установка значения реквизита "Компьютер"
	[USERNAME] := P_USERNAME;
end;
end;
end;
