/*
Функция возвращает есть ли у счета продукты кроме данного депозита
Для карт проверяется наличие депозита.
*/
public function is_work_product_on_acc(p_depn	ref	[DEPN],
								/*ссылка на депозит*/
								p_date			[DATE] default sysdate ,
								/*дата на которую запрашиваем, если пустое, то на текущую дату*/
								p_str_product	varchar2(2000) default null)
								/*список классов(глобальных) через запятую. При пустом списке запрашивается по всем продуктам*/
return rec_prod_tbl is 
v_acc_str		varchar2(20);
i				integer := 1;
v_acc_ref	ref	[AC_FIN];
our_bank 	ref [CL_BANK_N] := [SYSTEM].[VARIABLES].[OURBANK];
v_rec_prod_tbl	rec_prod_tbl;
begin
	v_rec_prod_tbl.delete;
	v_acc_ref := p_depn.[ACCOUNT];
	v_acc_str := p_depn.[ACCOUNT].[MAIN_V_ID];

	if instr(p_str_product, 'DEPN') > 0 or p_str_product is null then
		for(	select	x(	x%id		:c_id,
							x%class		:c_class,
							x.[FILIAL]	:c_filial)
					in	[PRODUCT],
						([DEPN] all :d) all
				where	d%id <> p_depn and d%id =x%id and
						(d.[ACC_RETURN].[1].[2] = v_acc_ref or (d.[ACC_RETURN].[2].[3] = our_bank and d.[ACC_RETURN].[2].[1] = v_acc_str)) and
						least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) and
						nvl(x.[COM_STATUS],0) <> v_csp)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			i := i + 1;
		end loop;
	
		for(	select	x(	x%id		:c_id,
							x%class		:c_class,
							x.[FILIAL]	:c_filial)
					in	[PRODUCT],
						([DEPN] all :d) all
				where	d%id <> p_depn and d%id =x%id and
						(d.[ACC_ENROL_PRC].[1].[2] = v_acc_ref or (d.[ACC_ENROL_PRC].[2].[3] = our_bank and d.[ACC_ENROL_PRC].[2].[1] = v_acc_str)) and
						least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) and
						nvl(x.[COM_STATUS],0) <> v_csp)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			i := i + 1;
		end loop;
	end if;

	if instr(p_str_product, 'PR_CRED') > 0 or p_str_product is null then
		for(	select	x(	x%id		:c_id,
							x%class		:c_class,
							x.[FILIAL]	:c_filial)
					in	[PRODUCT],
						([PR_CRED] all :d) all
				where	d%id =x%id and
						(d.[CLIENT_REQ].[1].[2] = v_acc_ref or (d.[CLIENT_REQ].[2].[3] = our_bank and d.[CLIENT_REQ].[2].[1] = v_acc_str)) and
						least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) and
						nvl(x.[COM_STATUS],0) <> v_csp)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			i := i + 1;
		end loop;
	end if;

	if instr(p_str_product, 'VZ_CARDS') > 0 or p_str_product is null then
		for(	select	x(	x%id		:c_id,
							x%class		:c_class,
							x.[FILIAL]	:c_filial)
					in	[PRODUCT],
						(::[IP_ACCOUNTS]	all : IpAcc),
						(::[VZ_CARDS]		all : d)	all
				where	d%id =x%id and
						d.[IP_ACCOUNTS_REF] = IpAcc%id and
						IpAcc.[PROD_REF] = p_depn and
						d.[PAN] is not null and
						least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) and
						nvl(x.[COM_STATUS],0) <> v_csp)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			i := i + 1;
		end loop;
	end if;

	return v_rec_prod_tbl;
end;

/*
Функция возвращает есть ли у счета продукты кроме данного депозита
*/
public function is_work_product_on_acc_bool(	p_depn		ref	[DEPN],
										/*ссылка на депозит*/
										p_date			[DATE] default sysdate ,
										/*дата на которую запрашиваем, если пустое, то на текущую дату*/
										p_str_product	varchar2(2000) default null)
										/*список классов(глобальных) через запятую. При пустом списке запрашивается по всем продуктам*/
return	varchar2(100) is 
 v_rec_prod_tbl	rec_prod_tbl;
begin
	v_rec_prod_tbl.delete;
	v_rec_prod_tbl := is_work_product_on_acc(	p_depn,
												p_date,
												p_str_product);

	return v_rec_prod_tbl.count;

end;

end;
