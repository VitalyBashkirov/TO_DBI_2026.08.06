class AC_MAT;

@name('[ПСБ] Изменить (служебная)')
@tag('CREATED')
method PSH_EDIT_AUTO is
PSH_EDIT_AUTO (
	@name('Наименование')                                                          P_NAME             in [SBRF_NAME],
	@name('Создатель')                                                             P_USER_OP          in [USER_REF],
	@name('Владелец')                                                              P_CLIENT_V         in [CLIENT_REF],
	@name('Дата открытия')                                                         P_DATE_OP          in [DATE],
	@name('Дата закрытия')                                                         P_DATE_CLOSE       in [DATE],
	@name('Пользователь, закрывший счет')                                          P_USER_CLOSE       in [USER_REF],
	@name('Материальный счет')                                                     P_ACC_MAT          in [MAT_NUM],
	@name('Продукты по счету')                                                     P_PRODUCTS         in [ACC_PROD_ARR],
	@name('Подразделение')                                                         P_DEPART           in [DEPART_REF],
	@name('Учетный счет')                                                          P_ACC_FIN          in [AC_FIN_REF],
	@name('Внутренний код для импорта(служебный)')                                 P_INTERNAL_CODE    in [STRING_25],
	@name('Материально - ответственное лицо')                                      P_MOL              in [USER_REF],
	@name('Единица измерения (Код)')                                               P_UNIT_MES         in [STRING_10],
	@name('Категория информации')                                                  P_CATEGORY_INFO    in [CATEGORY_INF_REF],
	@name('Начальная амортизация')                                                 P_INIT_DEPR        in [SUMMA],
	@name('Срок эксплуатации')                                                     P_PER_EXPL         in [SHORT4],
	@name('Таблица движения')                                                      P_TAB_MOVE         in [TMC_MOVE_ARR],
	@name('Группа ТМЦ')                                                            P_GRUPPA           in [TMC_GRUP_REF],
	@name('Первоначальная цена')                                                   P_PRICE            in [SUMMA_16_6],
	@name('Инвентарный номер')                                                     P_INV_NUMB         in [STRING_16],
	@name('Код вида товара')                                                       P_TYPE_GOODS       in [TMC_TYPE_GOO_REF],
	@name('Заводской номер')                                                       P_ZAV_NUMB         in [STRING_32000],
	@name('Счетно-сортировальная машина')                                          P_CCM              in [BOOLEAN],
	@name('Характеристика')                                                        P_HARAKTER         in [STRING_250],
	@name('Дата последней инвентаризации')                                         P_DT_LAST_INV      in [DATE],
	@name('Последнее движение')                                                    P_LAST_MOVE        in [TMC_MOVE_REF],
	@name('Таблица  счетов')                                                       P_TAB_ACCOUNT      in [TMC_USER_ACC_ARR],
	@name('Сумма НДС')                                                             P_SUM_NDS          in [SUMMA],
	@name('Блокирующий документ')                                                  P_BLOCK_DOC        in [TMC_DOCUM_REF],
	@name('Вид использования')                                                     P_KIND_USER        in [TMC_KIND_REF],
	@name('Полный материальный счет')                                              P_FULL_ACC_MAT     in [ACCNUM],
	@name('Количество поступающее')                                                P_QUANT_IN         in [SUMMA_16_6],
	@name('Количество затребованное')                                              P_QUANT_OUT        in [SUMMA_16_6],
	@name('Старый номер счета')                                                    P_OLD_ACC_MAT      in [STRING_10],
	@name('Начало начисления амортизации')                                         P_BEG_DEPR         in [DATE],
	@name('Начальная переценка')                                                   P_INIT_EST_PRICE   in [SUMMA],
	@name('Начальная переоценка амортизации')                                      P_INIT_EST_DEPR    in [SUMMA],
	@name('Сумма поступающая')                                                     P_SUMMA_IN         in [SUMMA],
	@name('Сумма затребованная')                                                   P_SUMMA_OUT        in [SUMMA],
	@name('Шифр амортизации')                                                      P_SHIFR_DEPR       in [TMC_SHIFR_REF],
	@name('Первое движение')                                                       P_FIRST_MOVE       in [TMC_MOVE_REF],
	@name('Шифр ОКОФ')                                                             P_OKOF             in [TMC_OKOF_REF],
	@name('Дата последнего начисления амортизации')                                P_LAST_DEPR        in [DATE],
	@name('Дата выпуска')                                                          P_DATE_BEARTH      in [DATE],
	@name('Номер паспорта')                                                        P_PAS_NUMB         in [STRING_16],
	@name('Фактическое наличие')                                                   P_QUANT            in [SUMMA_16_6],
	@name('Коэффициент ускорения')                                                 P_USCORENIE        in [PRC12P6],
	@name('Единица измерения')                                                     P_UNIT_MESS        in [TMC_UNIT_REF],
	@name('Дата амортизации до конвертации')                                       P_LAST_CONV        in [DATE],
	@name('Старый инвентарный')                                                    P_OLD_INV          in [STRING_16],
	@name('Номер объекта')                                                         P_OBJ_NUMB         in [STRING_10],
	@name('Старый счет учета')                                                     P_OLD_MAIN         in [ACCNUM],
	@name('Старый счет амортизации')                                               P_OLD_DEPR         in [ACCNUM],
	@name('Старый счет переоценки')                                                P_OLD_ESTIM        in [ACCNUM],
	@name('Филиал (Отделение)')                                                    P_FILIAL           in [BRANCH_REF],
	@name('Налоговая инспекция')                                                   P_INSPECT          in [TAX_INSPECT_REF],
	@name('Дата последней амортизации по переоценке')                              P_LAST_ESTIM       in [DATE],
	@name('Дата последней амортизации для налоговой инспекции')                    P_LAST_NALOG       in [DATE],
	@name('Признак комплекта')                                                     P_SIGN_COMPL       in [BOOLEAN],
	@name('Комплект')                                                              P_COMPLECT         in [TMC_ACC_MAT_REF],
	@name('Дата оприходования')                                                    P_DATE_PRIH        in [DATE],
	@name('Номер документа прихода')                                               P_NUM_PRIH         in [STRING_16],
	@name('Дата ввода в эксплуатацию')                                             P_DATE_EXPL        in [DATE],
	@name('Номер документа ввода в эксплуатацию')                                  P_NUM_EXPL         in [STRING_16],
	@name('Комплектующие')                                                         P_TAB_COMP         in [TMC_COMP_ARR],
	@name('Признак запрета перерасчета')                                           P_SIGN_CALC        in [BOOLEAN],
	@name('Резервная сумма амортизации')                                           P_REZ_DEPR         in [SUMMA],
	@name('Резервная сумма переоценки')                                            P_REZ_ESTIM        in [SUMMA],
	@name('Внесистемный учет')                                                     P_UN_SYSTEM        in [BOOLEAN],
	@name('Признак полной амортизации')                                            P_SIGN_ALL_DEPR    in [BOOLEAN],
	@name('Сумма на счете с НДС')                                                  P_NDS_IN_SUM       in [BOOLEAN],
	@name('Лицевой счет учета')                                                    P_TMC_MAIN         in [ACCNUM],
	@name('Лицевой счет амортизации')                                              P_TMC_DEPR         in [ACCNUM],
	@name('Лицевой счет переоценки')                                               P_TMC_ESTIM        in [ACCNUM],
	@name('Лицевой счет кап/вложений')                                             P_TMC_CAPITAL      in [ACCNUM],
	@name('Список драгметаллов')                                                   P_TAB_LIST_DRM     in [TMC_LIST_DRM_ARR],
	@name('Лицевой счет реализации')                                               P_TMC_REALIZE      in [ACCNUM],
	@name('Окончание начисления амортизации')                                      P_END_DEPR         in [DATE],
	@name('Лицевой счет арендных обязательств')                                    P_TMC_ARENDA       in [ACCNUM],
	@name('Предельная сумма амортизации')                                          P_MAX_DEPR         in [SUMMA],
	@name('Группа амортизации')                                                    P_NAL_GR_DEPR      in [TMC_GR_DEPR_REF],
	@name('Срок полезного использования')                                          P_NAL_PER_EXPL     in [SHORT4],
	@name('Срок использования предыдущими собственникоми')                         P_NAL_PREF_EXPL    in [SHORT4],
	@name('Дата истечения срока полезного использования')                          P_NAL_END_EXPL     in [DATE],
	@name('Дата начала начисления амортизации для налогообложения')                P_NAL_BEG_DEPR     in [DATE],
	@name('Дата последнего начисления амортизации для налогообложения')            P_NAL_LAST_DEPR    in [DATE],
	@name('Дата окончания начисления амортизации для налогообложения')             P_NAL_END_DEPR     in [DATE],
	@name('Рыночная цена')                                                         P_NAL_PRICE        in [SUMMA],
	@name('Признак амортизации для налогообложения')                               P_NAL_DEPR         in [BOOLEAN],
	@name('Способ начисления амортизации для налогообложения')                     P_NAL_METHOD       in [ONE_FROM_THREE],
	@name('Дата начала прекращения начисления амортизации для налогообложения')    P_NAL_BEG_STOP     in [DATE],
	@name('Дата окончания прекращения начисления амортизации для налогообложения') P_NAL_END_STOP     in [DATE],
	@name('Сумма НДС затребованная')                                               P_SUMMA_NDS_OUT    in [SUMMA],
	@name('Сумма НДС поступающая')                                                 P_SUMMA_NDS_IN     in [SUMMA],
	@name('Импортное оборудование')                                                P_SIGN_IMPORT      in [BOOLEAN],
	@name('НДС к уплате в бюджет')                                                 P_NAL_NDS          in [SUMMA],
	@name('Автоматическое списание')                                               P_SIGN_SPIS        in [BOOLEAN],
	@name('Сумма переходного периода')                                             P_NAL_PER_SUMMA    in [SUMMA],
	@name('Страна происхождения')                                                  P_COUNTRY          in [COUNTRY_REF],
	@name('Номер таможенной декларации')                                           P_NUM_DECL         in [STRING_40],
	@name('Дополнительная стоимость')                                              P_ADD_SUMMA        in [SUMMA],
	@name('Класс ТМЦ')                                                             P_TMC_CLASS        in [TMC_CLASS_REF],
	@name('Хозяйственный договор')                                                 P_HOZ_DOGOVOR      in [AUR_DOCUM_REF],
	@name('Группа амортизации для GAAP')                                           P_GAAP_GR_DEPR     in [TMC_GR_GAAP_REF],
	@name('Дата последнего начисления амортизации для GAAP')                       P_GAAP_LAST_DEPR   in [DATE],
	@name('Льготируемое имущество')                                                P_SIGN_PRIVIL      in [BOOLEAN],
	@name('Добавленный срок использования с 01.01.02')                             P_NAL_ADD_EXPL     in [SUMMA],
	@name('Начальная амортизация для налогообложения')                             P_NAL_INIT_DEPR    in [SUMMA],
	@name('Балансовая стоимость на 01.01.02')                                      P_ACC_SUMMA_010102 in [SUMMA],
	@name('Начисленная амортизация на 01.01.02')                                   P_ALL_DEPR_010102  in [SUMMA],
	@name('Уникальный код')                                                        P_UNI_CODE         in [STRING_32],
	@name('Месячная сумма амортизации')                                            P_MONTH_DEPR       in [SUMMA],
	@name('Ставка НДС')                                                            P_NDS_RATE         in [PRC12P6],
	@name('Сумма амортизации затребованная')                                       P_SUMMA_DEPR_OUT   in [SUMMA],
	@name('Сумма налоговой амортизации затребованная')                             P_SUM_NAL_DEPR_OUT in [SUMMA],
	@name('Сумма амортизации поступающая')                                         P_SUMMA_DEPR_IN    in [SUMMA],
	@name('Сумма налоговой амортизации поступающая')                               P_SUM_NAL_DEPR_IN  in [SUMMA],
	@name('Дополнительные характеристики')                                         P_ADD_CHARACT      in [TMC_ADD_CHAR_ARR],
	@name('Карточка учета автомобиля')                                             P_CAR_REF          in [CARS_REF],
	@name('Местонахождение')                                                       P_PLACE            in [TMC_PLACE_REF],
	@name('Маска инв. номера')                                                     P_INV_MASK         in [TMC_INV_MASK_REF],
	@name('Последняя нал. амортизация до конвертации')                             P_NAL_LAST_CONV    in [DATE],
	@name('Таблица номеров')                                                       P_TAB_NUM          in [TMC_NUM_ARR],
	@name('Штрих код средства')                                                    P_SH_CODE          in [STRING_30],
	@name('Складской номер')                                                       P_SKLAD_NUM        in [STRING_50],
	@name('Закупающее подразделение')                                              P_PUR_DEPART       in [DEPART_REF],
	@name('Код по ОКПД')                                                           P_OKPD_CODE        in [OKPD_CODE_REF],
	@name('Статья бюджета расходов')                                               P_RASH_STATS_REF   in [TMC_RASH_ST_REF],
	@name('Данные для резервирования')                                             P_RESERV_DATA      in [TMC_RES_ACC_REF],
	@name('Распределение амортизации')                                             P_AMORT_DISTR      in [UU_ACC_AM_D_ARR],
	@name('Дополнительные параметры')                                              P_ADD_PARAM        in [PROPERTIES_ARR],
	@name('Расходы по дисконтированной стоимости')                                 P_DISCOUNT_TAB     in [TMC_DISCOUNT_ARR],
	@name('Массив КСЭ')                                                            P_COMPOUND         in [TMC_COMPOUND_ARR],
	@name('Прослеживаемый товар')                                                  P_TRACE_GOODS      in [BOOLEAN],
	@name('Кредитный договор')                                                     P_CRED_DOG_REF     in [REF_NUMBER],
	@name('Класс кредитного договора ')                                            P_CRED_DOG_CLASS   in [METACLASS_REF],
	@name('Залоговая ценность')                                                    P_ZC_REF           in [ZALOG_BODY_REF],
	@name('Отправленные уведомления')                                              P_SENT_NOTICE      in [SENT_NOTICE_ARR]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_NAME := this.[NAME];
	P_USER_OP := this.[USER_OP];
	P_CLIENT_V := this.[CLIENT_V];
	P_DATE_OP := this.[DATE_OP];
	P_DATE_CLOSE := this.[DATE_CLOSE];
	P_USER_CLOSE := this.[USER_CLOSE];
	P_ACC_MAT := this.[ACC_MAT];
	P_PRODUCTS := this.[PRODUCTS];
	P_DEPART := this.[DEPART];
	P_ACC_FIN := this.[ACC_FIN];
	P_INTERNAL_CODE := this.[INTERNAL_CODE];
	P_MOL := this.[MOL];
	P_UNIT_MES := this.[UNIT_MES];
	P_CATEGORY_INFO := this.[CATEGORY_INFO];
	P_INIT_DEPR := this.[INIT_DEPR];
	P_PER_EXPL := this.[PER_EXPL];
	P_TAB_MOVE := this.[TAB_MOVE];
	P_GRUPPA := this.[GRUPPA];
	P_PRICE := this.[PRICE];
	P_INV_NUMB := this.[INV_NUMB];
	P_TYPE_GOODS := this.[TYPE_GOODS];
	P_ZAV_NUMB := this.[ZAV_NUMB];
	P_CCM := this.[CCM];
	P_HARAKTER := this.[HARAKTER];
	P_DT_LAST_INV := this.[DT_LAST_INV];
	P_LAST_MOVE := this.[LAST_MOVE];
	P_TAB_ACCOUNT := this.[TAB_ACCOUNT];
	P_SUM_NDS := this.[SUM_NDS];
	P_BLOCK_DOC := this.[BLOCK_DOC];
	P_KIND_USER := this.[KIND_USER];
	P_FULL_ACC_MAT := this.[FULL_ACC_MAT];
	P_QUANT_IN := this.[QUANT_IN];
	P_QUANT_OUT := this.[QUANT_OUT];
	P_OLD_ACC_MAT := this.[OLD_ACC_MAT];
	P_BEG_DEPR := this.[BEG_DEPR];
	P_INIT_EST_PRICE := this.[INIT_EST_PRICE];
	P_INIT_EST_DEPR := this.[INIT_EST_DEPR];
	P_SUMMA_IN := this.[SUMMA_IN];
	P_SUMMA_OUT := this.[SUMMA_OUT];
	P_SHIFR_DEPR := this.[SHIFR_DEPR];
	P_FIRST_MOVE := this.[FIRST_MOVE];
	P_OKOF := this.[OKOF];
	P_LAST_DEPR := this.[LAST_DEPR];
	P_DATE_BEARTH := this.[DATE_BEARTH];
	P_PAS_NUMB := this.[PAS_NUMB];
	P_QUANT := this.[QUANT];
	P_USCORENIE := this.[USCORENIE];
	P_UNIT_MESS := this.[UNIT_MESS];
	P_LAST_CONV := this.[LAST_CONV];
	P_OLD_INV := this.[OLD_INV];
	P_OBJ_NUMB := this.[OBJ_NUMB];
	P_OLD_MAIN := this.[OLD_MAIN];
	P_OLD_DEPR := this.[OLD_DEPR];
	P_OLD_ESTIM := this.[OLD_ESTIM];
	P_FILIAL := this.[FILIAL];
	P_INSPECT := this.[INSPECT];
	P_LAST_ESTIM := this.[LAST_ESTIM];
	P_LAST_NALOG := this.[LAST_NALOG];
	P_SIGN_COMPL := this.[SIGN_COMPL];
	P_COMPLECT := this.[COMPLECT];
	P_DATE_PRIH := this.[DATE_PRIH];
	P_NUM_PRIH := this.[NUM_PRIH];
	P_DATE_EXPL := this.[DATE_EXPL];
	P_NUM_EXPL := this.[NUM_EXPL];
	P_TAB_COMP := this.[TAB_COMP];
	P_SIGN_CALC := this.[SIGN_CALC];
	P_REZ_DEPR := this.[REZ_DEPR];
	P_REZ_ESTIM := this.[REZ_ESTIM];
	P_UN_SYSTEM := this.[UN_SYSTEM];
	P_SIGN_ALL_DEPR := this.[SIGN_ALL_DEPR];
	P_NDS_IN_SUM := this.[NDS_IN_SUM];
	P_TMC_MAIN := this.[TMC_MAIN];
	P_TMC_DEPR := this.[TMC_DEPR];
	P_TMC_ESTIM := this.[TMC_ESTIM];
	P_TMC_CAPITAL := this.[TMC_CAPITAL];
	P_TAB_LIST_DRM := this.[TAB_LIST_DRM];
	P_TMC_REALIZE := this.[TMC_REALIZE];
	P_END_DEPR := this.[END_DEPR];
	P_TMC_ARENDA := this.[TMC_ARENDA];
	P_MAX_DEPR := this.[MAX_DEPR];
	P_NAL_GR_DEPR := this.[NAL_GR_DEPR];
	P_NAL_PER_EXPL := this.[NAL_PER_EXPL];
	P_NAL_PREF_EXPL := this.[NAL_PREF_EXPL];
	P_NAL_END_EXPL := this.[NAL_END_EXPL];
	P_NAL_BEG_DEPR := this.[NAL_BEG_DEPR];
	P_NAL_LAST_DEPR := this.[NAL_LAST_DEPR];
	P_NAL_END_DEPR := this.[NAL_END_DEPR];
	P_NAL_PRICE := this.[NAL_PRICE];
	P_NAL_DEPR := this.[NAL_DEPR];
	P_NAL_METHOD := this.[NAL_METHOD];
	P_NAL_BEG_STOP := this.[NAL_BEG_STOP];
	P_NAL_END_STOP := this.[NAL_END_STOP];
	P_SUMMA_NDS_OUT := this.[SUMMA_NDS_OUT];
	P_SUMMA_NDS_IN := this.[SUMMA_NDS_IN];
	P_SIGN_IMPORT := this.[SIGN_IMPORT];
	P_NAL_NDS := this.[NAL_NDS];
	P_SIGN_SPIS := this.[SIGN_SPIS];
	P_NAL_PER_SUMMA := this.[NAL_PER_SUMMA];
	P_COUNTRY := this.[COUNTRY];
	P_NUM_DECL := this.[NUM_DECL];
	P_ADD_SUMMA := this.[ADD_SUMMA];
	P_TMC_CLASS := this.[TMC_CLASS];
	P_HOZ_DOGOVOR := this.[HOZ_DOGOVOR];
	P_GAAP_GR_DEPR := this.[GAAP_GR_DEPR];
	P_GAAP_LAST_DEPR := this.[GAAP_LAST_DEPR];
	P_SIGN_PRIVIL := this.[SIGN_PRIVIL];
	P_NAL_ADD_EXPL := this.[NAL_ADD_EXPL];
	P_NAL_INIT_DEPR := this.[NAL_INIT_DEPR];
	P_ACC_SUMMA_010102 := this.[ACC_SUMMA_010102];
	P_ALL_DEPR_010102 := this.[ALL_DEPR_010102];
	P_UNI_CODE := this.[UNI_CODE];
	P_MONTH_DEPR := this.[MONTH_DEPR];
	P_NDS_RATE := this.[NDS_RATE];
	P_SUMMA_DEPR_OUT := this.[SUMMA_DEPR_OUT];
	P_SUM_NAL_DEPR_OUT := this.[SUM_NAL_DEPR_OUT];
	P_SUMMA_DEPR_IN := this.[SUMMA_DEPR_IN];
	P_SUM_NAL_DEPR_IN := this.[SUM_NAL_DEPR_IN];
	P_ADD_CHARACT := this.[ADD_CHARACT];
	P_CAR_REF := this.[CAR_REF];
	P_PLACE := this.[PLACE];
	P_INV_MASK := this.[INV_MASK];
	P_NAL_LAST_CONV := this.[NAL_LAST_CONV];
	P_TAB_NUM := this.[TAB_NUM];
	P_SH_CODE := this.[SH_CODE];
	P_SKLAD_NUM := this.[SKLAD_NUM];
	P_PUR_DEPART := this.[PUR_DEPART];
	P_OKPD_CODE := this.[OKPD_CODE];
	P_RASH_STATS_REF := this.[RASH_STATS_REF];
	P_RESERV_DATA := this.[RESERV_DATA];
	P_AMORT_DISTR := this.[AMORT_DISTR];
	P_ADD_PARAM := this.[ADD_PARAM];
	P_DISCOUNT_TAB := this.[DISCOUNT_TAB];
	P_COMPOUND := this.[COMPOUND];
	P_TRACE_GOODS := this.[TRACE_GOODS];
	P_CRED_DOG_REF := this.[CRED_DOG_REF];
	P_CRED_DOG_CLASS := this.[CRED_DOG_CLASS];
	P_ZC_REF := this.[ZC_REF];
	P_SENT_NOTICE := this.[SENT_NOTICE];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Наименование"
	[NAME] := P_NAME;
	-- Установка значения реквизита "Создатель"
	[USER_OP] := P_USER_OP;
	-- Установка значения реквизита "Владелец"
	[CLIENT_V] := P_CLIENT_V;
	-- Установка значения реквизита "Дата открытия"
	[DATE_OP] := P_DATE_OP;
	-- Установка значения реквизита "Дата закрытия"
	[DATE_CLOSE] := P_DATE_CLOSE;
	-- Установка значения реквизита "Пользователь, закрывший счет"
	[USER_CLOSE] := P_USER_CLOSE;
	-- Установка значения реквизита "Материальный счет"
	[ACC_MAT] := P_ACC_MAT;
	-- Установка значения реквизита "Подразделение"
	[DEPART] := P_DEPART;
	-- Установка значения реквизита "Учетный счет"
	[ACC_FIN] := P_ACC_FIN;
	-- Установка значения реквизита "Внутренний код для импорта(служебный)"
	[INTERNAL_CODE] := P_INTERNAL_CODE;
	-- Установка значения реквизита "Материально - ответственное лицо"
