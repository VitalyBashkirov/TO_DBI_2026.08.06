@name('Строка валидатора')                     public V_DEST_STR                  [STRING_32000];
@name('Признак выполнения групповой операции') public V_PRIV_OPER                 [BOOLEAN];
@name('File path')                             public P#PATH                      [STRING];
@name('File name')                             public P#NAME                      [STRING];
@name('Виды длительных распоряжений')          public V_LONG_ORDER_TYPES table of [LONG_ORDER_T_REF];
@name('Виды депозитных договоров')             public V_VID_DEPS         table of [VID_DEPOSIT_REF];
@name('Виды комиссий')                         public V_COMISS_TYPE      table of [CODE_TAR_RBS_REF];
--- Переменные для запуска операций
public SYS_USER 		ref [USER];
public DEPART_GROUP	[DEPART_GROUP];
public FILIAL			[BRANCH];
public STOP_FLAG_CODE	varchar2(32);
--public METHOD2CALL		[METHOD2CALL];
public MESSAGE_ROOT	[APP_ERROR_REF];
public V#STEAM#COUNT 	integer;
public V#STEAM#NUM 	integer;
-----------------------------------------------------
public ret		number; -- Количество повторений обработки

PRAGMA INCLUDE ([LAST_WILL]::[MACRO_LIB]);
PRAGMA INCLUDE([DEPN]::[LIB_MACRO]);
PRAGMA INCLUDE([RUNTIME]::[MACRO_LIB]);

IS_EOD_NEW			boolean;			--признак нового ЗОДа
stream_num			string;				--сконвертированный в текст номер потока
debug_on			boolean;			--признак вывода отладки в консоль

IdFile		integer;

type recEarlyProl is record (sId	number,
							 NumDog ::[DEPN].[NUM_DOG]%type,
							 DtBeg	date);
type tEarlyProl is table of recEarlyProl index by varchar2(50);
tblEarlyProl	tEarlyProl;
tblDepnProl		tEarlyProl;

ThisClass	varchar2(16);

pragma macro(mod$stream,'mod([1],P_STREAM_COUNT)=P_STREAM_NUM',substitute);

ComStatus_Work	   ref [COM_STATUS_PRD] := ::[COM_STATUS_PRD]([CODE] = 'WORK');
ComStatus_Prol	   ref [COM_STATUS_PRD] := ::[COM_STATUS_PRD]([CODE] = 'PROLONG');
ComStatus_AREST    ref [COM_STATUS_PRD] := ::[COM_STATUS_PRD]([CODE] = 'AREST');
ComStatus_TO_CLOSE ref [COM_STATUS_PRD] := ::[COM_STATUS_PRD]([CODE] = 'TO_CLOSE');

NatCur const ref [FT_MONEY] := [SYSTEM].[VARIABLES].NatCur;

type typeRec	is record 	(rec_num number --порядковый №
							,rec_type integer --тип записи (1 - депозит, 2 - длит.поручение)
							,rec_id number --№ депозитного договора
							,err_date date --дата возникновения ошибки
							,err_location varchar(500) --место возникновения ошибки
							,err_message varchar(2000) --ошибка
							);
type data_list  is table of typeRec;
tbl_data_view	data_list;

errRec typeRec;
idx number := 0;

cn_format_dd_mm_hh	const varchar2(16) := 'DD_MM_YYYY';
cn_format_hh_mi_ss	const varchar2(16) := 'HH24_MI_SS';

SysOpDate	date;
function GetOperDate
/* Получить дату операционного дня */
(
	p_FILIAL		ref [BRANCH]
	/* Ссылка на филиал */
)
return date
/* Дата операционного дня */
is
	v_op_date	date;
begin
	if p_FILIAL is null then
		v_op_date := ::[SYSTEM].[OP_DATE];
	else
		v_op_date := ::[SYSTEM].[VARIABLES].Br2OpDate(p_FILIAL);
	end if;
	return v_op_date;
end;

Function CheckHollidays(P_DATE_BEG in out date, P_DATE_END in out date, OnFilial ref [BRANCH]) return boolean is
Begin
	OnFilial := nvl(OnFilial, stdlib.user_id.[DEPART].[FILIAL]);
	-- такое может нам указали только завершение опердня
	-- следовательно дата начала и дата окончания у нас текущий опердень
	-- ищем последний рабочий день до этого
	for OpDay in ::[JOURNAL_OP_DAYS] all
	where OpDay%collection = OnFilial.[JOUR_OP_DAYS]
	and trunc(OpDay.[OP_DAY]) < P_DATE_BEG
	order by OpDay.[OP_DAY] desc
	loop
		if trunc(OpDay.[OP_DAY]) + 1 = P_DATE_BEG then
			return false;
		end if;
		-- Делаем выходные дни
		P_DATE_BEG := trunc(OpDay.[OP_DAY]) + 1; -- Начало выходных
		P_DATE_END := P_DATE_END - 1; -- Окончание выходных
		return true;
	end loop;
	return null; -- Такого не может быть...
End;

public procedure WrMess (mess varchar2(2000)) is
begin
	if IS_EOD_NEW then
	  --Башкиров В.Г. 17.12.2023
	  --[DEPN_INTERFACE].[PRX_DEPN_TO_END].EOD2_WrMess(stream_num||TB$||to_char(sysdate, 'dd/mm/yy hh24:mi:ss')||TB$||Mess);
		[DEPN_INTERFACE].[PRX_DEPN_TO_END].EOD_WrMess(stream_num||TB$||to_char(sysdate, 'dd/mm/yy hh24:mi:ss')||TB$||Mess);
	else
		[DEPN_INTERFACE].[PRX_DEPN_TO_END].EOD_WrMess(stream_num||TB$||to_char(sysdate, 'dd/mm/yy hh24:mi:ss')||TB$||Mess);

		if debug_on and APP_SECURITY.check_job() then		--для вывода в консоль
			debug_pipe('Поток ' || stream_num || ': ' || mess, 0);
		end if;
	end if;
end;

--Добавление записи в таблицу ошибок
procedure AddRecordInErrorLog (rec_id 		number
							,err_location 	varchar(500)
							,err_message 	varchar(2000)
							,rec_type 		number default 1 ) is
begin
	idx := idx + 1;
	errRec.rec_num := idx;
	errRec.rec_type:= rec_type;
	errRec.rec_id := rec_id;
	errRec.err_date := SYSDATE;
	errRec.err_location := err_location;
	errRec.err_message := err_message;
	tbl_data_view(idx) := errRec;
end;

--Сохранение таблицы ошибок в файл
procedure SaveErrorLog (FileName varchar(1000), FilePath varchar(1000)) is
	outStr varchar(2700);
begin
	begin
		IdFile := stdio.open(FilePath, FileName, 'а');
	exception
		--	если не удалось открыть файл на дозапись, значит такой файл не существует
		--	в таком случае открываем файл на запись, файл будет создан автоматически
		when others then
			IdFile := stdio.OPEN( FilePath, FileName , 'w' );
	end;
	
	stdio.put_line(IdFile,	'#|  type |rec_id|err_date|err_location|err_message'	, null, null, stdio.DOSTEXT);
	
	for idx in tbl_data_view.first..tbl_data_view.last loop
		errRec:=tbl_data_view(idx);
		outStr := tbl_data_view(idx).rec_num;
		case errRec.rec_type of
		: 1 :
			outStr := outStr || '|депозит|';
		: 2 :
			outStr := outStr || '|длпоруч|';
		else
			outStr := outStr || '|       |';
		end;
		outStr := outStr || errRec.rec_id;	
		outStr := outStr || '|' || to_char (errRec.err_date, 'dd.mm.yyyy hh24:mi:ss');	
		outStr := outStr || '|' || errRec.err_location;	
		outStr := outStr || '|' || errRec.err_message;	
		
		stdio.put_line(IdFile, outStr, null, null, stdio.DOSTEXT);
		
	end loop;	

	stdio.close(IdFile);
exception
	when others then
		stdio.close(IdFile);
		::[DEPN_INTERFACE].[PRX_DEPN_TO_END].EOD_WRMESS('Ошибка при сохранеии файла ошибок - ' || FileName || ' в каталог ' || FilePath ||'.');
		::[DEPN_INTERFACE].[PRX_DEPN_TO_END].EOD_WRMESS('Текст ошибки : '||sqlerrm);
end;
procedure WaitStopJobs(p_filial ref [BRANCH], p_timeout integer)
is

t1	integer;
t2	integer;

default_timeout	const integer	:= 60;

begin

	-- Время начала ожидания
	t1	:= utils.get_time;
	t2	:= utils.get_time;
	
	&nvl(p_timeout, default_timeout)
	
	loop

		begin
			[EOD_JOB_INFO]::[L].set_all_lock_eod(p_filial);
		exception
			when MESSAGE.APP_EXCEPTION then
			
				-- Текущее время
				t2	:= utils.get_time;
				
				if (t2 - t1)/100 > p_timeout then
					raise;
				else			
					-- Повторяем попытку блокировки
					continue;
				end if;
				
			when OTHERS then
				raise;
		end;
		
		exit;

	end loop;

end;

-- Возвращает единицу, если в таблице с видами депозитных договоров указан хотя бы один.
function CheckVidDeposits
return boolean is
	i	number;
begin
	if V_VID_DEPS is null then return false; end if;
	i := V_VID_DEPS.first;
	while i is not null loop
		if V_VID_DEPS(i) is not null then
			return true;
		end if;
		i := V_VID_DEPS.next(i);
	end loop;
	return false;
end;

function GetMilliSecsBetween( p_start	TIMESTAMP_TZ
							, p_end		TIMESTAMP_TZ
							)
return number
is
	vHours 			number;
	vMinutes		number;
	vSeconds		number;
	vMilliseconds	number;
	vFraction		number := 1000;
	function CharToNum ( p_time		TIMESTAMP_TZ
						,p_format	varchar(4)
						)
	return number
	is
	begin
		return to_number(to_char(p_time, p_format));
	end;
begin
	vHours 		  := (to_date( p_end, 'yyyy-mm-dd' ) - to_date( p_start, 'yyyy-mm-dd' )) * 24; -- разница в днях
	vHours 		  := vHours + CharToNum( p_end, 'HH24' ) - CharToNum( p_start, 'HH24' ) ;
	vMinutes 	  := CharToNum( p_end, 'MI' ) - CharToNum( p_start, 'MI' );
	vSeconds 	  := CharToNum( p_end, 'SS' ) - CharToNum( p_start, 'SS' );
	vMilliseconds := CharToNum( p_end, 'FF3' ) - CharToNum( p_start, 'FF3' );
	return vMilliseconds + vSeconds*vFraction + vMinutes*60*vFraction + vHours*3600*vFraction;
end;

--Башкиров В.Г. 17.12.2023 Скопировано с 23.1.10 ::[SYSTEM].[DAY_LIB].check_stop_commit
/** /
public function check_stop_commit(	P_METHOD_PROC		varchar2(200)
							,P_OBJECT_COUNT		integer default null
							,P_OBJECT_HANDLED	integer	default null
							,P_OBJ_HANDLE_ERROR	integer	default null
							) return boolean  is 
m ref [METHOD2CALL];
begin
	m%id:=METHOD2CALL%id;
	update a(	a.[METHOD_PROC]			= P_METHOD_PROC
				,a.[OBJECT_COUNT]		= P_OBJECT_COUNT
				,a.[OBJECT_HANDLED]		= P_OBJECT_HANDLED
				,a.[OBJ_HANDLE_ERROR]	= P_OBJ_HANDLE_ERROR
			) in ::[METHOD2CALL] all where a = m;
	commit;
	if ::[SYSTEM_FLAGS].[GET](STOP_FLAG_CODE) then
		return true;
	end if;
	return false;
end;
/**/
