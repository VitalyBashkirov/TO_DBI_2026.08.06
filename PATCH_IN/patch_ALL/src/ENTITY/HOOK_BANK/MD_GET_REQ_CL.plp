class HOOK_BANK;

@this(create_on_start:=true)
@name('Платежные документы. Получение реквизитов клиента для бизнес-операции')
@tag('COPIED')
method MD_GET_REQ_CL is
MD_GET_REQ_CL (
	@name('Тип счета')                TYPE_ACC in [TIP_ACC_REF],
	@name('Дополнительные параметры') P#ADDS   in [STRING_32000] default null
) return [REQ_CLIENT] is

execute is
/*******************************************************************************************/
/* Дополнение логики операции MAIN_DOCUM.GET_REQ_CLIENT                                    */
/* при необходимости следует переопределить операцию в типе Расширения. Банк               */
/* В возвращаемых реквизитах клиента поле [0] должно быть null если тип счета не обработан */
/* Хук вызывается после отрабатывания основной логики GET_REQ_CLIENT, т.е. переопределить  */
/* вычисление обрабатываемых в этой операции типов счетов не допускается                   */
/*******************************************************************************************/

req_cl		[REQ_CLIENT];	-- Реквизиты для заполнения
type_acc_cod	::[TIP_ACC].[COD]%type;
acc 		ref [AC_FIN];
begin
	--debug_pipe('TYPE_ACC = '|| TYPE_ACC.[COD],10);
	--debug_pipe('P#ADDS = '|| P#ADDS,10);
	
	type_acc_cod := TYPE_ACC.[COD];
	
	-->> PSH VRI 09/02/2026 CFT-3533 Конверсионная операция UPV 440 (для БО: TAX_PPV_EXEC)
	if type_acc_cod = 'INP_47408_CLL' then
		::[RUNTIME].[STR].get_par(P#ADDS, 'TAX_PP_ACC_DT', acc);
		for (select ac(ac obj)
				in ::[AC_FIN]
				where ac.[MAIN_V_ID] like '47408%'
					and ac.[FINTOOL] = acc.[FINTOOL]
					and ac.[DEPART] = ::[DEPART]([CODE] = '001-00')
					and ac.[DATE_CLOSE] is null
					fetch 1
			)
		loop
			req_cl.[0] := 1;
			req_cl.[1].[1] := ac.obj.[CLIENT_V];
			req_cl.[1].[2] := ac.obj;
		end loop;

	elsif type_acc_cod = 'OUT_47407_CLL' then
		::[RUNTIME].[STR].get_par(P#ADDS, 'TAX_PP_ACC_DT', acc);
		for (select ac(ac obj)
				in ::[AC_FIN]
				where ac.[MAIN_V_ID] like '47407%'
					and ac.[FINTOOL] = ::[SYSTEM].[VARIABLES].NatCur
					and ac.[DEPART] = ::[DEPART]([CODE] = '001-00')
					and ac.[DATE_CLOSE] is null
					fetch 1
			)
		loop
			req_cl.[0] := 1;
			req_cl.[1].[1] := ac.obj.[CLIENT_V];
			req_cl.[1].[2] := ac.obj;
		end loop;
	--<< PSH VRI 09/02/2026 CFT-3533 Конверсионная операция UPV 440 (для БО: TAX_PPV_EXEC)
	
	end if;
	return req_cl;
end;
end;
end;
