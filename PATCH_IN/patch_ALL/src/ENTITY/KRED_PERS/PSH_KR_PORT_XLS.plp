					--[EXCEL].Write(i,84,cr.INS,false,false,10,'Times New Roman','RT');
					--[EXCEL].Write(i,85,cr.MSB,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,86,cr.PTF);
					[EXCEL].Write(i,87,to_char(cr.PREVEND,'DD.MM.YYYY'));
					[EXCEL].Write(i,88,cr.PURP);
					[EXCEL].Set_Number_Format(i,89,i,89,2);
					[EXCEL].Write(i,89,cr.F115_SPR,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,90,''''||cr.ACC_PEN);
					[EXCEL].Set_Number_Format(i,91,i,91,2);
					[EXCEL].Write(i,91,cr.BAL_PEN,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,92,''''||cr.ACC_RESPEN);
					[EXCEL].Set_Number_Format(i,93,i,93,2);
					[EXCEL].Write(i,93,cr.BAL_RESPEN,false,false,10,'Times New Roman','RT');
					--[EXCEL].Write(i,94,cr.WRK);
					[EXCEL].Write(i,95,''''||cr.ACC_RASHET);
					[EXCEL].Set_Number_Format(i,96,i,96,2);
					[EXCEL].Write(i,96,cr.BAL_RASHET,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,97,''); --cr.VIP_RASHET);
					[EXCEL].Write(i,98,''''||cr.LIMRESACC);
					[EXCEL].Set_Number_Format(i,99,i,99,2);
					[EXCEL].Write(i,99,cr.LIMRESBAL,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,100,''''||cr.ACCGP);
					[EXCEL].Set_Number_Format(i,101,i,101,2);
					[EXCEL].Write(i,101,cr.BALGP,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,102,''''||cr.ACCGPRES);
					[EXCEL].Set_Number_Format(i,103,i,103,2);
					[EXCEL].Write(i,103,cr.ACCGPRESBAL,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,104,cr.itodex_180);
					
					i:=i+1;
					end loop;
				
				[EXCEL].Borders(3, 1, i-1, vColCount, 'RLBTVH');
								
				[EXCEL].Visible;
				[EXCEL].Release;
			end if;
			
			[EXCEL].Exec_Script(V_DEST);	
		end if;	
  end if;
end;
end;
end;
