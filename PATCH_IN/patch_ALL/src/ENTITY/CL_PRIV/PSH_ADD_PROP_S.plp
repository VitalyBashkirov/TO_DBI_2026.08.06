class CL_PRIV;

@name('[ПСБ] Добавление доп. свойства (Списочная)')
@tag('COPIED')
batch method PSH_ADD_PROP_S is

@name('Скрипт')          public V_DEST    [STRING_32000];
@name('Значение ссылки') public V_STR_OBJ [STRING_1000];
@name('Тип')             public V_TYPE    [NAME];
@name('Класс')           public V_CLASS   [NAME];
type t_id_arr is varray(0) of number;

type t_num_arr is table of number;

procedure init_arr(p_id_arr in out nocopy t_id_arr)
is
begin
	if p_id_arr is not null then
		p_id_arr.delete;
	else
		p_id_arr.init;
	end if;
end;

procedure clear_arr(p_id_arr in out nocopy t_id_arr)
is
begin
	if p_id_arr is not null then
		p_id_arr.delete;
	end if;
end;

procedure upd_props(P_DATE_CLOSE date,p_upd_id_prop_arr in out nocopy t_id_arr)
is
begin
	if p_upd_id_prop_arr is not null and p_upd_id_prop_arr.count>0 then
		update x
			(x.[DATE_END]=P_DATE_CLOSE)
		in ::[PROPERTIES] all
		where x%id in (select y(y) in p_upd_id_prop_arr);
		
		clear_arr(p_upd_id_prop_arr);
	end if;
end;

procedure ins_prop(p_coll_prop_arr in out nocopy t_num_arr,p_prop [PROPERTIES])
is
begin
	if p_coll_prop_arr is not null and p_coll_prop_arr.count>0 then
		insert into ::[PROPERTIES]
			for i in p_coll_prop_arr.first..p_coll_prop_arr.last loop
			x(x%collection=p_coll_prop_arr(i)
				,x.[GROUP_PROP]=p_prop.[GROUP_PROP]
				,x.[DATE_BEG]=p_prop.[DATE_BEG]
				,x.[V_DATE]=p_prop.[V_DATE]
				,x.[BOOL]=p_prop.[BOOL]
				,x.[OBJ]=p_prop.[OBJ]
				,x.[STR]=p_prop.[STR]
				,x.[NUM]=p_prop.[NUM]
				,x.[PROP]=p_prop.[PROP]
				
			);
			
		p_coll_prop_arr.delete;
	end if;
end;

procedure set_prop_value(P_GRP_PROP ref [PROPERTY_GRP]
					,P_PROP_VALUE varchar2
					, P_PROP_V ref [PROD_PROPERTY]
					,P_DATE_BEG date
					,p_prop in out [PROPERTIES]
					)
is
	type_value varchar2(50);
begin
	p_prop.[GROUP_PROP]:=P_GRP_PROP;
	p_prop.[DATE_BEG]:=P_DATE_BEG;
	
	type_value:=P_GRP_PROP.[TYPE_VALUE];
			
	if type_value = 'NUMBER'  then
		p_prop.[NUM] := to_number(P_PROP_VALUE);
	elsif type_value = 'DATE'    then
		p_prop.[V_DATE] := to_date(P_PROP_VALUE, 'dd.mm.yyyy');
	elsif type_value = 'STRING'  then
		p_prop.[STR] := P_PROP_VALUE;
	elsif type_value = 'BOOL'  then
		p_prop.[BOOL] := upper(P_PROP_VALUE) in ('ДА', 'TRUE', 'OK', 'ОК', 'ОK', 'OК', '1');
	elsif type_value = 'REF'  then
		begin
			p_prop.[OBJ]%id := P_PROP_VALUE;
		exception
			when NO_DATA_FOUND then
				p_prop.[OBJ]%id := null;
		end;
	elsif type_value is null then
		p_prop.[PROP]:=P_PROP_V;
	end if;
exception
	when OTHERS then
		pragma error('Ошибка присвоения значения свойству "'||P_GRP_PROP.name||'"');
end;

procedure valid_type
	( TBP        ::[PROPERTY_GRP].[TBP]%type
	, P_OBJ      ::[PROPERTIES].[OBJ]%type
	, TYPE_VALUE ::[PROPERTY_GRP].[TYPE_VALUE]%type
	, V_STR_OBJ  in out varchar2
	, V_VALID in out varchar2
	, V_TYPE in out varchar2
	) is
begin

	if TYPE_VALUE = 'STRING' then
		csmd.Show (V_VALID, 'P_STR');
		V_TYPE := 'Текст';
	else
		csmd.Hide (V_VALID, 'P_STR');
	end if;

	if TYPE_VALUE = 'NUMBER' then
		csmd.Show (V_VALID, 'P_NUM');
		V_TYPE := 'Число';
	else csmd.Hide (V_VALID, 'P_NUM');
	end if;

	if TYPE_VALUE = 'DATE' then
		csmd.Show (V_VALID, 'P_V_DATE');
		V_TYPE := 'Дата';
	else csmd.Hide (V_VALID, 'P_V_DATE');
	end if;

	if TYPE_VALUE = 'BOOL' then
		csmd.Show (V_VALID, 'P_BOOL');
		V_TYPE := 'Логика';
	else csmd.Hide (V_VALID, 'P_BOOL');
	end if;

	if TYPE_VALUE = 'REF' then
		csmd.Show (V_VALID, 'P_OBJ');
		csmd.Command(V_VALID, 'V_STR_OBJ.Visible=True');
		csmd.Command(V_VALID, 'P_OBJ.Caption = "'||replace(TBP.[NAME], '"', '""""')||'"');
		
		csmd.Command(V_VALID, 'P_OBJ.SetClassId("'|| ::[FP_TUNE].[SLIB].find_ref_by_type( TBP%ID ) ||'")');
		V_TYPE := 'Ссылка';
		
		if P_OBJ is null
			then V_STR_OBJ := null;
			else V_STR_OBJ := ::[RUNTIME].[OBJ].GetObjValue( P_OBJ%id, TBP );
		end if;

	else
		csmd.Hide (V_VALID, 'P_OBJ');
		csmd.Command(V_VALID, 'V_STR_OBJ.Visible=False');
	end if;
	
	if TYPE_VALUE is null then
		csmd.Show (V_VALID, 'P_PROP');
		V_TYPE := 'Выбор';
	else csmd.Hide (V_VALID, 'P_PROP');
	end if;

--if TYPE_VALUE is null then
--	csmd.Show (V_VALID, 'P_PROP');
--	V_TYPE := 'Выбор';
--else csmd.Hide (V_VALID, 'P_PROP');
--end if;
end;

function GetPropStr(V_TYPE varchar2,P_STR varchar2(32000),P_BOOL boolean ,P_DATE date ,p_OBJ varchar2(1000),P_NUM number, P_PROP ref [PROD_PROPERTY]) return varchar2(32000)
is
ret varchar2(32000);
begin
	if V_TYPE = 'Текст' then
		ret:= P_STR;
	elsif V_TYPE = 'Число' then
		ret:= to_char(P_NUM);
	elsif V_TYPE = 'Дата' then
		ret:= to_char(P_DATE,'dd.mm.yyyy');
	elsif V_TYPE = 'Логика' then
		if nvl(P_BOOL,false) then
			ret:='1';
		else
			ret:='0';
		end if;		
	elsif V_TYPE = 'Ссылка' then
		-- не текст а ссылка должна быть
		--ret:= V_STR_OBJ;
		-- http://jira-new/browse/SUPPORT-49135
		ret:= P_OBJ;
	elsif V_TYPE is null then
		ret:= P_PROP.[NAME];
	end if;
	return ret;					
end;
PSH_ADD_PROP_S (
	@name('Дата начала действия')                 P_DATE_BEG     in [DATE],
	@name('Группа свойств')                       P_GRP_PROP     in [PROPERTY_GRP_REF],
	@name('Значение свойства')                    P_PROP_VALUE   in [MEMO],
	@name('Закрывать ранее действующее свойство') P_IS_CLOSE_OLD in [BOOLEAN]          default null,
	@name('Текстовое значение')                   P_STR          in [MEMO],
	@name('Числовое значение')                    P_NUM          in [NUM_20_4],
	@name('Значение Даты')                        P_V_DATE       in [DATE],
	@name('Логическое значение')                  P_BOOL         in [BOOLEAN],
	@name('Значение. Ссылка')                     P_OBJ          in [REFERENCE],
	@name('Свойство')                             P_PROP         in [PROD_PROPERT_REF]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE_BEG := [SYSTEM]::[OP_DATE];

end if;
-- End initialization of parameters and variables
begin
	if P_MESSAGE = 'DEFAULT' then
		P_IS_CLOSE_OLD:=true;
		csmd.Init_Form(V_DEST, &METHOD$CLASS, &METHOD$SNAME );
		P_STR:='';
		V_STR_OBJ:='';
		P_NUM = P_V_DATE = P_BOOL = P_OBJ:=null;
		csmd.Hide   (V_DEST, 'P_STR');
		csmd.Hide   (V_DEST, 'P_NUM');
		csmd.Hide   (V_DEST, 'P_V_DATE');
		csmd.Hide   (V_DEST, 'P_BOOL');
		csmd.Hide   (V_DEST, 'P_OBJ');
		csmd.Command(V_DEST, 'V_STR_OBJ.Visible=False');
		valid_type(P_GRP_PROP.[TBP], P_OBJ, P_GRP_PROP.[TYPE_VALUE], V_STR_OBJ, V_DEST, V_TYPE);
		V_CLASS:=this(1)%class;
	elsif p_message = 'VALIDATE' then
		csmd.Init_Form(V_DEST, null, null);
		if p_info = 'P_GRP_PROP' then
			P_OBJ := null;
			V_STR_OBJ := null;
			--debug_pipe('P_GRP_PROP.[TYPE_VALUE]='||P_GRP_PROP.[TYPE_VALUE]);
			valid_type(P_GRP_PROP.[TBP], P_OBJ, P_GRP_PROP.[TYPE_VALUE], V_STR_OBJ, V_DEST, V_TYPE);
			P_STR := null;
			P_NUM := null;
			P_V_DATE := null;
			P_OBJ := null;
			V_STR_OBJ := null;
			P_PROP:=null;
			if P_GRP_PROP.[TYPE_VALUE] = 'REF' then
				csmd.Command(V_DEST, 'V_STR_OBJ.Enabled=False');
			else
				csmd.Command(V_DEST, 'V_STR_OBJ.Enabled=True');
			end if;
		elsif p_info = 'P_OBJ' then
			valid_type(P_GRP_PROP.[TBP], P_OBJ, P_GRP_PROP.[TYPE_VALUE], V_STR_OBJ, V_DEST, V_TYPE);
		end if;

	end if;
end;
end;

execute is
id_arr  t_id_arr;
coll_prop_arr t_num_arr; --t_id_arr;
prop [PROPERTIES];
rec_num number;
close_rec_num number;


upd_id_prop_arr t_id_arr;
err_coll_prop_arr t_id_arr;
type_value varchar2(50);

p_criterion ref [CL_FAIL_CRITERIA];
m ref [MONITORING_CRIT];

begin
	if P_DATE_BEG is null then
		pragma error('Поле "Дата начала действия" должно быть заполнено');
	elsif P_GRP_PROP is null then
		pragma error('Поле "Группа свойств" должно быть заполнено');
	end if;
	P_PROP_VALUE:= GetPropStr(V_TYPE, P_STR,P_BOOL,P_V_DATE,P_OBJ,P_NUM,P_PROP);
	debug_pipe('P_PROP_VALUE='||P_PROP_VALUE,0);
	debug_pipe('<*> Операция "'|| &METHOD$NAME ||'"',10);
	debug_pipe('<*> Запуск операции в '||sysdate,10);
	debug_pipe('Дата начала действия свойства: '||to_char(P_DATE_BEG,'DD.MM.YYYY'),10); --for test -- [31/03/2016] -- Yakovlev
	debug_pipe('<*> ----------------------------------',10);
	if this is not null and this.count>0 then
		init_arr(id_arr);
		--init_arr(coll_prop_arr);
		coll_prop_arr.delete;
		rec_num:=0;
		close_rec_num:=0;
		prop:=null;
		type_value:=P_GRP_PROP.[TYPE_VALUE];
		
		set_prop_value(P_GRP_PROP,P_PROP_VALUE,P_PROP,P_DATE_BEG,prop);
		
		for i in this.first..this.last
		loop
			id_arr.extend;
			id_arr(id_arr.count):=this(i);
		end loop;
		
		init_arr(err_coll_prop_arr);
						
		select cr(cr.[ADD_PROP] : prop_coll)
		in ::[CL_PRIV]
			,(::[PROPERTIES] all : prp)
			all
		where (cr%id in (select y(y) in id_arr))
			and prp%collection=cr.[ADD_PROP]
			and prp.[GROUP_PROP]=P_GRP_PROP
			and prp.[DATE_BEG]>P_DATE_BEG
		group by cr.[ADD_PROP]
		having count(1)>0
		into err_coll_prop_arr;
			
		
		if nvl(P_IS_CLOSE_OLD,false) then
			init_arr(upd_id_prop_arr);
			for (
				select cr(cr%id : id_cr
						,prp%id : old_prop_id
						,(select yy(1)
							in err_coll_prop_arr
							where yy.[COLUMN_VALUE]=cr.[ADD_PROP]
								and rownum=1) : have_err
						,decode(type_value
								,'NUMBER',to_char(prp.[NUM])
								,'DATE',to_char(prp.[V_DATE],'DD.MM.YYYY')
								,'BOOL',to_char(prp.[BOOL])
								,'REF',to_char(prp.[OBJ]%id)
								,prp.[STR]) : old_prop_value
						,decode(type_value
								,'NUMBER',to_char(prop.[NUM])
								,'DATE',to_char(prop.[V_DATE],'DD.MM.YYYY')
								,'BOOL',to_char(prop.[BOOL])
								,'REF',to_char(prop.[OBJ]%id)
								,prop.[STR]) : new_prop_value
						)
				in ::[CL_PRIV]
					,(::[PROPERTIES] all : prp)
					all
				where (cr%id in (select y(y) in id_arr))
					and prp%collection=cr.[ADD_PROP]
					and prp.[GROUP_PROP]=P_GRP_PROP
					and nvl(prp.[DATE_BEG],P_DATE_BEG)<=P_DATE_BEG
					and nvl(prp.[DATE_END],P_DATE_BEG+1)>P_DATE_BEG									
			)
			loop
				if cr.have_err is null then
					if cr.old_prop_value<>cr.new_prop_value
						and not (cr.old_prop_value is null
								and cr.new_prop_value is null)
					then
						upd_id_prop_arr.extend(1);
						upd_id_prop_arr(upd_id_prop_arr.count):=cr.old_prop_id;
						debug_pipe('<upd> Закрываем свойство с ID='||cr.old_prop_id||' на кредите с ID='||cr.id_cr,10);
						close_rec_num:=close_rec_num+1;
					else
						debug_pipe('<!> Свойство не обновлено: Значение старого (свойство с ID='||cr.old_prop_id||') и нового значения свойства совпадают ',10); --for test -- [01/04/2016] -- Yakovlev
					end if;
				/*else
					debug_pipe('<Ошибка> Свойство не добавлено, т.к. есть подобные свойства с более поздней датой начала действия на кредите с ID='||cr.id_cr,0);*/
				end if;
				
				if mod(close_rec_num,10000)=0 then
					upd_props(P_DATE_BEG-1,upd_id_prop_arr);
				end if;
			end loop;
			
			upd_props(P_DATE_BEG-1,upd_id_prop_arr);
			
			clear_arr(upd_id_prop_arr);
			
		end if;
				
		for (
			select cr(cr.[ADD_PROP] : prop_coll
					,cr%id : id_cr
					)
			in ::[CL_PRIV] all
			where (cr%id in (select y(y) in id_arr))
				and not exists(
							select x(1)
							in ::[PROPERTIES] all
							where x%collection=cr.[ADD_PROP]
								and x.[GROUP_PROP]=P_GRP_PROP
								and ((nvl(x.[DATE_BEG],P_DATE_BEG)<=P_DATE_BEG
										and nvl(x.[DATE_END],P_DATE_BEG+1)>P_DATE_BEG)
									or x.[DATE_BEG]>P_DATE_BEG
								)
							)
		)
		loop
			rec_num:=rec_num+1;
			
			debug_pipe('<***> Добавляем новое свойство на кредите с ID='||cr.id_cr,10);
			--coll_prop_arr.extend(1);
			coll_prop_arr(coll_prop_arr.count):=cr.prop_coll;
			
		    if mod(rec_num,10000)=0 then
				ins_prop(coll_prop_arr,prop);
			end if;
		end loop;
	
		ins_prop(coll_prop_arr,prop);	
		
		if err_coll_prop_arr is not null and err_coll_prop_arr.count>0 then
			for (
				select x(x%id : cr_id)
				in ::[CL_PRIV] all
				where x.[ADD_PROP] in (select y(y) in err_coll_prop_arr)				
			)
			loop
				debug_pipe('<Ошибка> Свойство не добавлено, т.к. есть подобные свойства с более поздней датой начала действия на кредите с ID='||x.cr_id,10);
			end loop;
		end if;
		
		clear_arr(err_coll_prop_arr);
		clear_arr(id_arr);
		coll_prop_arr.delete;
	end if;
	debug_pipe('<***> Добавлено новых свойств: '||rec_num,10);
	debug_pipe('<*> ----------------------------------',10);
	debug_pipe('<*> Окончание операции в '||sysdate,10);
end;
end;
end;
