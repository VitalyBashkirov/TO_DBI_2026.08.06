			      END IF;
			    END IF;				
				if suma <= SUMA_SH1 then
					varRet:= 0; goto nnn;
				elsif suma > SUMA_SH1 and suma <= SUMA_SH2 then
					--varRet:= suma - SUMA_SH1; goto nnn;
					varRet:= SUMA; goto nnn;
				else
					--varRet:= SUMA_SH2 - SUMA_SH1; goto nnn;
					varRet:= 0; goto nnn;
				end if;	
			elsif P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ3' THEN
			   IF NVL(SUM_DEN,0) > 0 THEN
                 IF (SUM_DEN + SUMA) > SUMA_SH2 THEN
			       IF SUM_DEN < SUMA_SH2 THEN
			          varRet:= (SUM_DEN + SUMA - SUMA_SH2); goto nnn;
			       ELSIF SUM_DEN > SUMA_SH2 THEN
			          varRet:= SUMA; goto nnn;
			       END IF;
                 ELSIF (SUM_DEN + SUMA) < SUMA_SH2 THEN
                      varRet:= 0; goto nnn;
                 END IF;
			   END IF;			
				if suma <= SUMA_SH2 then
					varRet:= 0; goto nnn;
				else
					--varRet:= suma - SUMA_SH2; goto nnn;
					varRet:= SUMA; goto nnn;
				end if;					
			end if;				
	       -- end yach
		end if;
	
	end if;

	&debug(TB$||'[06]',dp5)

	
	-- ************************************************************************************
	-- Параметры, вычисляемые исходя из документа       ***********************************
	
	
	--Возвращает "1", если есть ссылка на пл.документ	из справочника "ДБО: Подписи платежных документов", иначе "0"
	if P_PAR = 'ДОК_ИКБ' then		
		varRet:= EZP(md1); goto nnn;
	
	elsif P_PAR = 'ВР_ОТПРАВКИ' then
		declare dat_begin DATE_TIME;
				hor number;
		begin
			for d in ::[DOCUM_RC] where d.[MAIN_DOC] = md1 and d.[FLAG_EXPORT_DOC] and d.[OUT_DOC_1].[F_TIME] is not null
			loop
			  begin
				select b(min(b.[DATE]))
				in md1.[HISTORY_STATE]
				into dat_begin;
				&debug('--------------dat_begin='||to_number(to_char(dat_begin, 'hh24'))||' F_TIME='||to_number(to_char(d.[OUT_DOC_1].[F_TIME], 'hh24')),dp)
				&debug(to_number(to_char(d.[OUT_DOC_1].[F_TIME], 'dd')) - to_number(to_char(dat_begin, 'dd')),dp)
				hor := (to_number(to_char(d.[OUT_DOC_1].[F_TIME], 'dd')) - to_number(to_char(dat_begin, 'dd')))*24 + to_number(to_char(d.[OUT_DOC_1].[F_TIME], 'hh24')) - to_number(to_char(dat_begin, 'hh24'));
				&debug('--------------dat_begin='||to_char(dat_begin)||' F_TIME='||to_char(d.[OUT_DOC_1].[F_TIME]),dp)					
			  	exception when others then
			  		null;
			  end;	
				hor := nvl(hor, 0);
				varRet:= to_char(hor); goto nnn;
			end loop;
		end;
		varRet:= '0';	 goto nnn;
	
	elsif P_PAR = 'САМ_СЕБЕ' then
		mn_ref:=coalesce(P_DOC,::[PATTERN_DOC].[BUSINESS_OP].doc_ref,md,mn_ref); --Башкиров В.Г. 19.09.2019
		if 	MN_REF.[ACC_DT].[CLIENT_V]=MN_REF.[ACC_KT].[CLIENT_V] or MN_REF.[ACC_DT].[CLIENT_V]=MN_REF.[ACC_KT].[CLIENT_R] then
			varRet:= '1'; goto nnn;
		else
			varRet:= '0'; goto nnn;
		end if;				
	
	elsif P_PAR = 'ПАСПОРТ_СДЕЛКИ' then
		if 	md1.[DEAL_PASP] is null then
			varRet:= '0'; goto nnn;
		else
			varRet:= '1'; goto nnn;
		end if;	
	elsif P_PAR = 'ВАЛ_КОНТРОЛЬ' then
