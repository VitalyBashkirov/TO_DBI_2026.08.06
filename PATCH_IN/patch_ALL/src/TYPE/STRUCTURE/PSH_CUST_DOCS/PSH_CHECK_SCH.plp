class PSH_CUST_DOCS;

@import_plsql(true)
@name('[ПСБ] Проверить документ по XSD')
@tag('COPIED')
batch method PSH_CHECK_SCH is
pragma include(::[PSH_CUST_DOCS].[PSH_LIB]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
pragma include(::[PSH_CUST_DOCS].[PSH_LIB_TC]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
PSH_CHECK_SCH is

execute is
v_tab_docs	&lib.T_Doc;
v_app_mess	varchar2(128);
begin
	v_app_mess := ::[PSH_CUST_DOCS].[PSH_LIB_FUN].checkApp('1B028090'); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
	if v_app_mess is not null then
		pragma error(v_app_mess);
	end if;

	for i in this.first..this.last loop
		if this(i).[DOC_STATE] = &libtc.stCheckXSD then
			v_tab_docs(i).doc := this(i);
			v_tab_docs(i).doc_type := this(i).[DOC_TYPE];
			v_tab_docs(i).doc_state := this(i).[DOC_STATE];
			v_tab_docs(i).doc_content := this(i).[FILE_CONTENT];
			v_tab_docs(i).doc_version := this(i).[VERSION];
		end if;
	end loop;

	&lib.check_xsd(v_tab_docs);
end;
end;
end;
