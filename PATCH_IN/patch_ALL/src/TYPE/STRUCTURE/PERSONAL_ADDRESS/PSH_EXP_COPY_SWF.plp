class PERSONAL_ADDRESS;

@name('[ПСБ] Копировать в новый адрес (SWIFT)')
@speciality('copy')
method PSH_EXP_COPY_SWF is

@name('Допустимые типы адресов') public V_ADDR_TYPE [STRING_2000];
@name('Категория')               public V_CAT       [INTEGER];
PSH_EXP_COPY_SWF (
	@name('Тип адреса') P_TYPE in [ADDRESS_TYPE_REF]
) return [PERSONAL_ADD_REF] is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_TYPE := this.[TYPE];

end if;
-- End initialization of parameters and variables
declare
pragma include(::[RUNTIME].[MACRO_LIB]);

	oType [ADDRESS_TYPE];
	kladr_mode number;
	km number;
	km_null number;
	prnt_cl	string(50);
	
begin
	if p_message = 'DEFAULT' then
		P_TYPE := ::[ADDRESS_TYPE]([KOD] = 'SWIFT_ADDRESS');
		prnt_cl := this%parentclass;
		V_CAT := case when prnt_cl = ::[CL_PRIV]%class then 2 when prnt_cl in (&CLASS_CHILD_LIST('CL_CORP')) then 3 else 1 end;
		km_null := ::[FP_TUNE].[LIB].get_num_value('KLADR_MODE', null, '0');
		kladr_mode := coalesce(::[FP_TUNE].[LIB].get_num_value('KLADR_MODE', ::[FP_TUNE].[LIB].set_canons('ADDRESS_TYPE', this.[TYPE]%id), '0'), km_null);
		if kladr_mode is not null then
			for a in ::[ADDRESS_TYPE] loop
				km := coalesce(::[FP_TUNE].[LIB].get_num_value('KLADR_MODE', ::[FP_TUNE].[LIB].set_canons('ADDRESS_TYPE', a%id), '0'), km_null);
				if km is not null and km >= kladr_mode then
					V_ADDR_TYPE := V_ADDR_TYPE || bool_char(V_ADDR_TYPE is not null, ',', '') || a%id;
				end if;
			end loop;
		end if;
		
	elsif p_message = 'VALIDATE' then
		if p_info like '%P_TYPE%' then
			oType := P_TYPE;
			if P_TYPE is not null and not coalesce(oType.[IS_MULTIPLE],false) then
				for x in this%collection where x.[TYPE] = P_TYPE fetch 1 loop
					pragma error('Для типа адреса "'||oType.[NAME]||'" запрещено создание нескольких адресов!');
				end loop;
			end if;
		end if;
	end if;
end;
end;

execute is
	th_ref ref [PERSONAL_ADDRESS];
	coll_id [ADDRESSES];
	metro_st_ref ref [METRO_STATION];
begin
	if P_TYPE is null then
		pragma error('Не указан тип адреса!');
	end if;
	
	coll_id := this%collection;
	
	th_ref := coll_id.
	--[EXP_NEW_AUTO_SW](
	[NEW#AUTO](
	P_TYPE					--Тип адреса
	, this.[POST_CODE]		--Почтовый индекс
	, this.[CITY]			--Населенный пункт
	, this.[STREET_REF]		--Улица населенного пункта
	, this.[IMP_STR]		--Адрес строкой
	, this.[HOUSE]			--Дом
	, this.[KORPUS]			--Корпус
	, this.[FLAT]			--Квартира / комната
	, this.[DISTRICT]		--Район населенного пункта
	, this.[HOUSE_REF]		--Дом
	, this.[STREET_STR]		--Улица
	, this.[FIX_PRINT]		--Фиксировать
	, this.[REG_DATE]		--Дата регистрации
	, this.[REG_END_DATE]	--Дата окончания регистрации
	, this.[ADDR_OBJ]		--Адресный объект
  	, null --this.[STRUCT]			--Тип адресного деления
  	, this.[REG_PLACE_NAME] --Наименование регистрирующего органа
  	, this.[REG_PLACE_CODE] --Код подразделения, осуществившего регистрацию
	);
	-- станции метро
	for (select m(m.[STATION] : STATION, m.[DISTANCE] : DISTANCE) in this.[METRO_STATIONS]) loop
		metro_st_ref := th_ref.[METRO_STATIONS].[NEW_AUTO](m.STATION, m.DISTANCE);
	end loop;
	return th_ref;
end;
end;
end;
