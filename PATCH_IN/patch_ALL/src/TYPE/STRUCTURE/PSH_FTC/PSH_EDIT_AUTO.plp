class PSH_FTC;

@name('[ПСБ] Изменить')
@tag('CREATED')
method PSH_EDIT_AUTO uses PSH_NEW_AUTO is
PSH_EDIT_AUTO (
	@name('Имя файла')                  P_F_NAME     in [STRING_100],
	@name('Дата загрузки')              P_DATE_IN    in [DATE_TIME],
	@name('Действует')                  P_WORK       in [BOOLEAN],
	@name('ИНН участника ВЭД')          P_FTC_INN    in [STRING_12],
	@name('Наименование участника ВЭД') P_FTC_NAME   in [STRING_300],
	@name('Примечание')                 P_NOTE       in [MEMO],
	@name('Ссылка на Клиента в АБС')    P_FTC_CLIENT in [CLIENT_REF]
) is

validate is
	v_this ref [PSH_FTC]; -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25
begin
	if this is not null then
		v_this := this;
		&BASE$SETVARS;
		&BASE$VALIDATE(v_this);
		&BASE$GETVARS;
	end if;
end;

execute is
	v_this ref [PSH_FTC]; -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25
begin
	if this is not null then
		v_this := this;
		&BASE$SETVARS;
		v_this := &BASE$EXECUTE(v_this);
	end if;
end;
end;
end;
