									join (::[CL_ORG]  o ) 	on  o.LINKS_OTHER=d%collection  
									join (::[AC_FIN]  f ) 	on  f.[CLIENT_V]=o and substr(f.[MAIN_V_ID],1,5) in ('40807')	 all
								
									
								
