class CIT_INTERFACE;

@import_plsql(true)
@name('[ПСБ] ЕТО. Интерфейс создания карты')
library PSH_ETO_CARD_INT is

cv_action_create const varchar2(6) := 'create';
cv_action_update const varchar2(6) := 'update';
cv_action_switch const varchar2(6) := 'switch';

cv_result_accept const varchar2(6) := 'accept';
cv_result_reject const varchar2(6) := 'reject';

cv_tag_expDate_format		const varchar2(6) := 'yyyymm';

cv_tag_request	const varchar2(12) := 'ETO_CARD_REQ';
cv_tag_response	const varchar2(13) := 'ETO_CARD_RESP';

cv_tag_action				const varchar2(45) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/action/@Value';
cv_tag_ID_INT				const varchar2(45) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/ID_INT/@Value';
cv_tag_ID_EXT				const varchar2(45) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/ID_EXT/@Value';
cv_tag_cardNumber			const varchar2(49) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/cardNumber/@Value';
cv_tag_customerId			const varchar2(49) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/customerId/@Value';
cv_tag_expDate				const varchar2(46) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/expDate/@Value';
cv_tag_productType			const varchar2(50) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/productType/@Value';
cv_tag_accountNumber		const varchar2(52) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/accountNumber/@Value';
cv_tag_cardId				const varchar2(45) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/cardId/@Value';
cv_tag_hotCardStatus		const varchar2(52) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/hotCardStatus/@Value';
cv_tag_cardTypeName			const varchar2(51) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/cardTypeName/@Value';
cv_tag_personId				const varchar2(47) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/personId/@Value';
cv_tag_cardContractId		const varchar2(53) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/cardContractId/@Value';
cv_tag_cardCreationDate		const varchar2(55) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/cardCreationDate/@Value';
cv_tag_currency				const varchar2(47) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/currency/@Value';
cv_tag_currencyAlphaCode	const varchar2(56) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/currencyAlphaCode/@Value';


cv_tag_oldCardId			const varchar2(48) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/oldCardId/@Value';
cv_tag_oldCardNumber		const varchar2(52) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/oldCardNumber/@Value';
cv_tag_oldCardStatus		const varchar2(52) := '//CIT_REQUEST/DATA/' || cv_tag_request || '/oldCardStatus/@Value';

public type REQUEST_DATA_REC_TYPE is
	record ( action				varchar2(64)
			,ID_INT				varchar2(36)
			,ID_EXT				varchar2(36)
			,cardNumber			varchar2(24)
			,customerId			varchar2(36)
			,expDate			date
			,productType		varchar2(2)
			,accountNumber		varchar2(20)
			,cardId				varchar2(36)
			,hotCardStatus		integer
			,cardTypeName		varchar2(32)
			,personId			varchar2(36)
			,cardContractId		varchar2(36)
			,cardCreationDate	date
			,currency			varchar2(3)
			,currencyAlphaCode	varchar2(3)
			,oldCardId			varchar2(36)
			,oldCardNumber		varchar2(24)
			,oldCardStatus		integer
	);

public type RESPONSE_DATA_REC_TYPE is
	record ( idInt			varchar2(36)
			,idExt			varchar2(36)
			,cardNumber		varchar2(24)
			,result			varchar2(64)
			,message		varchar2(4000)
			);

public type PROCESSING_CONTEXT_REC_TYPE is
	record (
			 requestData		REQUEST_DATA_REC_TYPE
			,responseData		RESPONSE_DATA_REC_TYPE
			,previousCard		[PSH_ETO_CARD]
			,card				[PSH_ETO_CARD]
			,returnValue		integer
			,citInRequest		ref [CIT_IN_REQUEST]
			,citAbonent			ref [CIT_ABONENT]
			,isCustomerLocked	boolean := false
			,isCardLocked		boolean := false
			);



function processActionCreate(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function processActionUpdate(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function processActionSwitch(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function tryCreateCard(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function tryUpdateCard(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function tryCreateClientIfNeed(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function tryOpenAccount(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function tryOpenAccount4Update(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function tryExecuteBoMovement(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function tryCloseAccount(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer;
function writeCard(pEtoCard [PSH_ETO_CARD]) return integer;
function writeCardAccounts(pEtoCard [PSH_ETO_CARD]) return integer;
function getRequestData(pReqXml xmltype) return REQUEST_DATA_REC_TYPE;
function getCardFromRequestData(pReqData REQUEST_DATA_REC_TYPE) return [PSH_ETO_CARD];
function processAndGetResponse(pReqRes in out nocopy clob, pMsgStruct [CIT_BO].[TLIB].data2pack_type) return integer;
function getResponse(pEtoCard [PSH_ETO_CARD], pResult varchar2, pMessage varchar2 := null) return clob;
function getResponse4Exception(pReq clob, pResult varchar2, pMessage varchar2 := null) return clob;
function getTagValue(pXmlClob in out nocopy clob, pTag varchar2) return varchar2;

/*********************************************************************
Таблица кодов ошибок интерфейса обработки запроса
----------------------------------------------------------------------
  Код  |  Описание ошибки
----------------------------------------------------------------------
null   | Передача отклика не предусмотрена настройками
0      | Успешная обработка
1      | Непредусмотренная ошибка интерфейса
2      | *Ошибка разбора запроса
3      | Неподдерживаемый action запроса
4      | Ошибка при поиске клиента
5      | Карта для update не найдена
6      | Не удалось создать папку платежей для переноса средств на новый счёт
7      | Не найдена карта oldCardNumber для переноса на CardNumber
*********************************************************************/

pragma include(::[RUNTIME].[MACRO_LIB]);
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma include(::[INTERFACE].[COMPILE_LIB]);

public pragma macro (prx_cit, '::[CLIENT_INTERFACE].[PRX_CIT]');

public function interface(pMsgStruct in out [CIT_BO].[TLIB].data2pack_type, pReqRes in out clob) return integer is
	ret_val			integer;
	error_message	[STRING_2000];
begin
	&debug('.interface Begin:', 0)
	&debug('.interface: pReqRes = ' || pReqRes, 0)
	&sp(start_int)

	ret_val := processAndGetResponse(pReqRes, pMsgStruct);

	if ret_val != 0 then
		&rb(start_int)
	end if;
	&debug('.interface End: ret_val = ' || ret_val, 0)
	return ret_val;
exception when others then
	--Причина перехвата others: при возникновении любой ошибки необходимо корректно завершить обработку (записать ответ, вернуть результат обработки в точку вызова)
	&rb(start_int)
	&debug('.interface: exception = ' || utils.error_stack, 0)
	error_message := substr('Ошибка "' || &METHOD$NAME || '": ' || utils.error_stack, 1, error_message%size);

	pReqRes := getResponse4Exception(pReqRes, cv_result_reject, error_message);

	&debug('.interface End: with exception, retVal = 1', 0)
	return 1;
end;

function processAndGetResponse(pReqRes in out nocopy clob, pMsgStruct [CIT_BO].[TLIB].data2pack_type) return integer is
	reqCitXml	xmltype;
	context		PROCESSING_CONTEXT_REC_TYPE;

	v_retval	integer;
begin
	&debug('.processAndGetResponse Begin:', 0)

	reqCitXml := xmltype(pReqRes);
	&debug('.processAndGetResponse: pReqRes parsed to XML successfully', 0)

	context.citInRequest	:= pMsgStruct.in_req_ref;
	context.citAbonent		:= &prx_cit.current_ab;
	context.requestData		:= getRequestData(reqCitXml);
	&debug('.processAndGetResponse: reqCitXml parsed to data successfully', 0)

	&debug('.processAndGetResponse: ::[PSH_ETO_CARD].[LL].lockRequestAwaiting(' || context.requestData.cardNumber || ')', 0)
	if ::[PSH_ETO_CARD].[LL].lockRequestAwaiting(context.requestData.cardNumber, 'PSH_ETO_CARD_INT.processAndGetResponse') is null then
		context.isCardLocked := true;
		&debug('.processAndGetResponse: lock aquired', 0)
	end if;

	context.card := getCardFromRequestData(context.requestData);

	case context.requestData.action of
		:cv_action_create:
			v_retval := processActionCreate(context);
		:cv_action_update:
			v_retval := processActionUpdate(context);
		:cv_action_switch:
			v_retval := processActionSwitch(context);
		else
			v_retval := 3;
	end;

	pReqRes :=
		case
		when v_retval = 0 then getResponse(context.card, cv_result_accept, 'Для карты использован номер счёта ' || context.card.[CARD_ACCOUNT].[MAIN_V_ID])
		when v_retval = 3 then getResponse(context.card, cv_result_reject, 'action = "' || context.requestData.action || '" не обрабатывается, принимаются: "' || cv_action_create || '", "' || cv_action_update || '", "' || cv_action_switch || '"')
		when v_retval = 4 then getResponse(context.card, cv_result_reject, 'Клиент CUSTOMER_ID = ' || context.card.[CUSTOMER_ID] || ' ещё не был передан в IBSO_DISTR')
		when v_retval = 5 then getResponse(context.card, cv_result_reject, 'Карта CARD_NUMBER = ' || context.card.[CARD_NUMBER] || ' не найдена для выполнения ' || cv_action_update || ' action')
		when v_retval = 6 then getResponse(context.card, cv_result_reject, 'Не удалось создать папку платежей для переноса средств на новый счёт ' || context.card.[ACCOUNT_NUMBER])
		when v_retval = 7 then getResponse(context.card, cv_result_reject, 'Не найдена карта oldCardNumber = ' || context.card.[OLD_CARD_NUMBER] || ' для переноса на cardNumber = ' || context.card.[CARD_NUMBER])
		end;
/*
	if v_retval = 6 then
		-- генерим exception для rollback
		[MESSAGE].app_error(&METHOD$CLASS || '.' || &METHOD$SNAME || '.processAndGetResponse', 'Не удалось создать папку платежей для переноса средств на новый счёт ' || v_eto_card.[ACCOUNT_NUMBER]);
	end if;
 */

--	if v_eto_card%id is not null then
--		--Формирование записи в истории запросов и соответствии объектов
--		vCitObj := &call_int(CIT_INT, INT_OBJ, 1).SetExtID([PSH_ETO_CARD]%class, v_eto_card%id, &call_int(CIT_INT, INT_TLIB, 2).get_current_ab, v_eto_card.[ID_EXT], null);
--		&call_int(CIT_INT, INT_OBJ, 1).addHistoryRecord([PSH_ETO_CARD]%class, v_eto_card%id, pMsgStruct.in_req_ref, null, vCitObj);
--	end if;

	if context.isCustomerLocked then
		::[PSH_ETO_CARD].[LL].lockRelease(context.card.[CUSTOMER_ID]);
		&debug('.processAndGetResponse: ::[PSH_ETO_CARD].[LL].lockRelease(' || context.card.[CUSTOMER_ID] || ')', 0)
	end if;
	if context.isCardLocked then
		::[PSH_ETO_CARD].[LL].lockRelease(context.requestData.cardNumber);
		&debug('.processAndGetResponse: ::[PSH_ETO_CARD].[LL].lockRelease(' || context.card.[CUSTOMER_ID] || ')', 0)
	end if;

	&debug('.processAndGetResponse End: v_retval = ' || v_retval, 0)
	return v_retval;
exception
	when others then
		if context.isCustomerLocked then
			::[PSH_ETO_CARD].[LL].lockRelease(context.card.[CUSTOMER_ID]);
		end if;
		if context.isCardLocked then
			::[PSH_ETO_CARD].[LL].lockRelease(context.requestData.cardNumber);
		end if;
		raise;
end;

function processActionCreate(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
	v_retval	integer;
begin
	&debug('.processActionCreate Begin:', 0)
	v_retval := tryCreateCard(pCtx);
	if v_retval = 0 then
		v_retval := tryCreateClientIfNeed(pCtx);
	end if;
	if v_retval = 0 then
		v_retval := tryOpenAccount(pCtx);
	end if;
	if v_retval = 0 then
		v_retval := writeCard(pCtx.card);
	end if;
	&debug('.processActionCreate End: v_retval = ' || v_retval, 0)
	return v_retval;
end;

function tryCreateCard(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
begin
	&debug('.tryCreateCard Begin:', 0)
	pCtx.card%id := ::[PSH_ETO_CARD]%insert(pCtx.card);
	if pCtx.requestData.action != cv_action_switch then
		::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].writeCardOperation(pCtx.card.[OPERATIONS], pCtx.citInRequest);
	end if;
	&debug('.tryCreateCard End: pCtx.card%id = ' || pCtx.card%id, 0)
	return 0;
end;

function tryCreateClientIfNeed(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
begin
	&debug('.tryCreateClientIfNeed Begin:', 0)
	if pCtx.card.[ACCOUNT_NUMBER] like '40903%' then
		&debug('.tryCreateClientIfNeed: [ACCOUNT_NUMBER] starts with 40903, client non identified and will not be created', 0)
		return 0;
	elsif pCtx.card.[ACCOUNT_NUMBER] like '40914%' then
		&debug('.tryCreateClientIfNeed: ::[PSH_ETO_CARD].[LL].lockRequestAwaiting(' || pCtx.card.[CUSTOMER_ID] || ')', 0)
		if ::[PSH_ETO_CARD].[LL].lockRequestAwaiting(pCtx.card.[CUSTOMER_ID], 'PSH_ETO_CARD_INT.tryCreateClientIfNeed') is null then
			pCtx.isCustomerLocked := true;
			&debug('.tryCreateClientIfNeed: lock aquired', 0)
		end if;

		pCtx.card.[CLIENT] := ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getClientFromMapping(pCtx.card.[CUSTOMER_ID]);
		if pCtx.card.[CLIENT] is not null then
			&debug('.tryCreateClientIfNeed: found client id = ' || pCtx.card.[CLIENT] || ' in mapping [CIT_OBJ]', 0)
			return 0;
		else
			declare
				vClient	[CL_PRIV];
				vCitObj	ref [CIT_OBJ];
			begin
				vClient%init;
				vClient.[NAME] := pCtx.card.[CUSTOMER_ID];
				--vClient.[DEPART] := '';	-- ???
				pCtx.card.[CLIENT] := ::[CL_PRIV]%insert(vClient);
				vCitObj := ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].writeClientToMapping(pCtx.card.[CLIENT], pCtx.citAbonent, pCtx.card.[CUSTOMER_ID]);
				&prx_cit.addHistoryRecord([CL_PRIV]%class, pCtx.card.[CLIENT], pCtx.citInRequest, null, vCitObj);
				&debug('.tryCreateClientIfNeed: created the new client ' || pCtx.card.[CUSTOMER_ID] || ' with id = ' || pCtx.card.[CLIENT], 0)
				return 0;
			end;
		end if;
	end if;
	&debug('.tryCreateClientIfNeed End: account [ACCOUNT_NUMBER] = ' || pCtx.card.[ACCOUNT_NUMBER] || ' is not subject to processing', 0)
	return 7;
end;

function tryOpenAccount(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
	v_ft_money	ref [FT_MONEY];
	v_pl_usv	ref [PL_USV];
--	v_plan		[PL_ACC];
--	v_plan_arr	[ARRAY_PL_ACC];
	cv_acc_bal_num		const varchar2(5) := substr(pCtx.card.[ACCOUNT_NUMBER], 1, 5);
	cv_acc_name			const varchar2(73) := 'Средства для осуществления переводов ЭДС физ лиц по предоплаченным картам';
	cv_branch			const ref [BRANCH] :=::[BRANCH]([CODE] = '001'); 
	cv_acc_open_timer	const varchar2(11) := 'AC_FIN_OPEN';
	v_retval	integer;
begin
	&debug('.tryOpenAccount Begin:', 0)

	for (select x(x :c_id)
		 in ::[FT_MONEY]
		 where x.[CODE_ACC] = pCtx.card.[CURRENCY]
		 or x.[CODE_ISO] = pCtx.card.[CURRENCY]
		)
	loop
		v_ft_money := x.c_id;
	end loop;
	
	&debug('.tryOpenAccount: v_ft_money = ' || v_ft_money, 0)

	for (select x(x :c_id)
		 in ::[PL_USV]
		 where x.[NUM] = cv_acc_bal_num
		 and x.[FINTOOL] = v_ft_money
		 and x.[FILIAL] = cv_branch
		 and x.[DATE_CLOSE] is null
		)
	loop
		v_pl_usv := x.c_id;
	end loop;
	
	&debug('.tryOpenAccount: v_pl_usv = ' || v_pl_usv, 0)

--	v_plan_arr%init;
--	v_plan.[ACC_USV] := v_pl_usv;
--	v_plan.[NUM] := pEtoCard.[ACCOUNT_NUMBER];
--	v_plan_arr%insert(v_plan);

	start_timer(cv_acc_open_timer);
	&debug('.tryOpenAccount: acc_fin_new_acc begin: = ' || sysdate, 0)
	pCtx.card.[CARD_ACCOUNT] := &call_int(FIN_ACCOUNT_INT, INT_ACC_FIN, 2).acc_fin_new_acc(v_pl_usv					--P_MAIN_USV
																						  ,null--v_plan_arr			--P_PLAN
																						  ,pCtx.card.[ACCOUNT_NUMBER]	--P_MAIN_V_ID
																						  ,cv_acc_name					--P_NAME
																						  ,null--pEtoCard.[CLIENT]	--P_CLIENT_V
																						  ,null--pEtoCard.[CLIENT]	--P_CLIENT_R
																						  );
----	update x(x.[CLIENT_V] = pEtoCard.[CLIENT])
----	in ::[ACCOUNT]
----	where x = pEtoCard.[CARD_ACCOUNT];
	if pCtx.card.[CLIENT] is not null then
		update x(x.[CLIENT_R] = pCtx.card.[CLIENT])
		in ::[AC_FIN]
		where x = pCtx.card.[CARD_ACCOUNT];
	end if;
	&debug('.tryOpenAccount: acc_fin_new_acc   end: = ' || sysdate, 0)
	finish_timer(cv_acc_open_timer);

	v_retval := writeCardAccounts(pCtx.card);
	&debug('.tryOpenAccount End: pCtx.card.[CARD_ACCOUNT] = ' || pCtx.card.[CARD_ACCOUNT], 0)
	return v_retval;
end;

function processActionUpdate(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
	v_retval		integer;
begin
	&debug('.processActionUpdate Begin:', 0)
	v_retval := tryUpdateCard(pCtx);
	if v_retval = -2 then	-- номер счёта поменялся
		v_retval := tryOpenAccount4Update(pCtx);
		if v_retval = 0 then
			v_retval := tryExecuteBoMovement(pCtx);
		end if;
		if v_retval = 0 then
			v_retval := tryCloseAccount(pCtx);
		end if;
	end if;
	if v_retval = 0 then
		v_retval := writeCard(pCtx.card);
	end if;
	&debug('.processActionUpdate End: v_retval = ' || v_retval, 0)
	return v_retval;
end;

function tryUpdateCard(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
	v_currentAccNumber	varchar2(20);
	v_retval integer;
begin
	&debug('.tryUpdateCard Begin:', 0)
	for (select x(x.[ACCOUNT_NUMBER]	:c_account_number
				 ,x.[CARD_ACCOUNT]		:c_card_account
				 ,x.[CARD_ACCOUNTS]		:c_card_accounts
				 ,x.[CLIENT]			:c_client
				 ,x.[OPERATIONS]		:c_operations
				 )
		 in ::[PSH_ETO_CARD]
		 where x.[ID_EXT] = pCtx.card.[ID_EXT] 
		)
	loop
		v_currentAccNumber			:= x.c_account_number;
		pCtx.card.[CARD_ACCOUNT]	:= x.c_card_account;
		pCtx.card.[CARD_ACCOUNTS]	:= x.c_card_accounts;
		pCtx.card.[CLIENT]			:= x.c_client;
		pCtx.card.[OPERATIONS]		:= x.c_operations;
	end loop;

	if pCtx.card.[CLIENT] is null then
		tryCreateClientIfNeed(pCtx);
	end if;

	update x(x.[ACCOUNT_NUMBER]		= pCtx.card.[ACCOUNT_NUMBER]
			,x.[PRODUCT_TYPE]		= pCtx.card.[PRODUCT_TYPE]
			,x.[HOT_CARD_STATUS]	= pCtx.card.[HOT_CARD_STATUS]
			,x.[CARD_CONTRACT_ID]	= pCtx.card.[CARD_CONTRACT_ID]
			,x.[CLIENT]				= pCtx.card.[CLIENT]
			)
	in ::[PSH_ETO_CARD]
	where x.[ID_EXT] = pCtx.card.[ID_EXT]
	return x%id 
	into pCtx.card%id;

	if pCtx.card%id is null then
		v_retval := 5;
	else
		if v_currentAccNumber != pCtx.card.[ACCOUNT_NUMBER] then
			v_retval := -2;	-- номер счёта поменялся
		else
			v_retval := 0;
		end if;
	end if;

	::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].writeCardOperation(pCtx.card.[OPERATIONS], pCitInRequest == pCtx.citInRequest);

	&debug('.tryUpdateCard End: pCtx.card%id = ' || pCtx.card%id
		|| ', v_currentAccNumber = ' || v_currentAccNumber || ', pCtx.card.[ACCOUNT_NUMBER] = ' || pCtx.card.[ACCOUNT_NUMBER]
		|| ', v_retval = ' || v_retval, 0)

	return v_retval;
end;

function tryOpenAccount4Update(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
	v_retval integer;
begin
	&debug('.tryOpenAccount4Update Begin:', 0)
	pCtx.previousCard.[CARD_ACCOUNT] := pCtx.card.[CARD_ACCOUNT];
	v_retval := tryOpenAccount(pCtx);
	&debug('.tryOpenAccount4Update End: v_retval = ' || v_retval, 0)
	return v_retval;
end;

function tryExecuteBoMovement(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
	cv_rko			const ref [RKO]			:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getRkoForBo();
	cv_bo			const ref [PATTERN_DOC]	:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getBoFromMapByValue('PREP_ESP_MOVEMENT');
	cv_calc_par_card_account		const varchar2(19) := ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].cv_calc_par_card_account;
	cv_calc_par_card_account_new	const varchar2(23) := ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].cv_calc_par_card_account_new;
	cv_calc_par_card_amount			const varchar2(18) := ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].cv_calc_par_card_amount;
	v_folder			ref [FOLDER_PAY];
	v_par4bo			[STRING_32767];
	cv_bo_exec_timer	const varchar2(11) := 'BO_EXEC';
	v_amount	number;
	v_retval	integer;
begin
	&debug('.tryExecuteBoMovement Begin:', 0)

	[STR].set_par(v_par4bo, cv_calc_par_card_account,		pCtx.previousCard.[CARD_ACCOUNT]);
	[STR].set_par(v_par4bo, cv_calc_par_card_account_new,	pCtx.card.[CARD_ACCOUNT]);
	v_amount := [F].a('И' || pCtx.previousCard.[CARD_ACCOUNT] || 'С', null);
	[STR].set_par(v_par4bo, cv_calc_par_card_amount,		v_amount);

	&debug('.tryExecuteBoMovement: pCtx.previousCard.[CARD_ACCOUNT] = ' || pCtx.previousCard.[CARD_ACCOUNT] || ', pCtx.card.[CARD_ACCOUNT] = ' || pCtx.card.[CARD_ACCOUNT] || ', v_amount ' || case when v_amount = 0 then '= 0' else '!= 0' end, 0)

	if v_amount = 0 then
		v_retval := 0;
	else
		&debug('.tryExecuteBoMovement: exec BO beg sysdate = ' || sysdate || ', cv_bo = ' || cv_bo, 0)
		start_timer(cv_bo_exec_timer);
		cv_bo.[BUSINESS_OP](null, cv_rko, null, null, null, v_folder, P#ADDS == v_par4bo);
		::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].writeCardOperation(pCtx.previousCard.[OPERATIONS], pCtx.citInRequest, v_folder);
		::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].writeCardOperation(pCtx.card.[OPERATIONS], pCtx.citInRequest, v_folder);
		finish_timer(cv_bo_exec_timer);
		&debug('.tryExecuteBoMovement: exec BO end sysdate = ' || sysdate || ', v_folder = ' || v_folder, 0)
	
		if v_folder is not null then
			::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].postForProcess(v_folder);
			--TODO: сделать новый код, для исключения отправки респонса, т.к. респонс должен будет быть отправлен после обработки папки
			v_retval := 0;
		else
			v_retval := 6;
		end if;
	end if;

	&debug('.tryExecuteBoMovement End: pCtx.card%id = ' || pCtx.card%id 
		|| ', pCtx.previousCard.[CARD_ACCOUNT] = ' || pCtx.previousCard.[CARD_ACCOUNT] || ', pCtx.card.[ACCOUNT_NUMBER] = ' || pCtx.card.[ACCOUNT_NUMBER]
		|| ', v_retval = ' || v_retval, 0)
	return v_retval;
end;

function tryCloseAccount(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
	v_retval integer;
begin
	&debug('.tryCloseAccount Begin:', 0)

	&call_int(FIN_ACCOUNT_INT, INT_ACC_FIN, 2).ac_fin_to_close(pCtx.previousCard.[CARD_ACCOUNT], true, 'Закрыто с переносом на ' || pCtx.card.[ACCOUNT_NUMBER]);

	v_retval := 0;
	&debug('.tryCloseAccount End: pCtx.card%id = ' || pCtx.card%id 
		|| ', pCtx.previousCard.[CARD_ACCOUNT] = ' || pCtx.previousCard.[CARD_ACCOUNT]
		|| ', v_retval = ' || v_retval, 0)
	return v_retval;
end;

function writeCard(pEtoCard [PSH_ETO_CARD]) return integer is
begin
	&debug('.writeCard Begin:', 0)
		update x(x.[CLIENT]			= nvl(pEtoCard.[CLIENT], x.[CLIENT])
				,x.[CARD_ACCOUNT]	= nvl(pEtoCard.[CARD_ACCOUNT], x.[CARD_ACCOUNT])
				)
		in ::[PSH_ETO_CARD]
		where x = pEtoCard%id;
	&debug('.writeCard End: pEtoCard%id = ' || pEtoCard%id, 0)
	return 0;
end;

function writeCardAccounts(pEtoCard [PSH_ETO_CARD]) return integer is
	cv_currentTime const date := sysdate;
begin
	&debug('.writeCardAccounts Begin:', 0)
	update x(x.[DATE_END] = cv_currentTime)
	in pEtoCard.[CARD_ACCOUNTS]
	where x.[DATE_END] is null;

	insert into pEtoCard.[CARD_ACCOUNTS]
	x(x.[DATE_BEG] = cv_currentTime
	 ,x.[ACCOUNT] = pEtoCard.[CARD_ACCOUNT]
	);
	&debug('.writeCardAccounts End: pEtoCard%id = ' || pEtoCard%id, 0)
	return 0;
end;

function getAndUpdatePreviousCard(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
begin
	for (select x(x					:c_card_ref
				 ,x.[CARD_ACCOUNT]	:c_card_account
				 ,x.[OPERATIONS]	:c_operations
				 )
		 in ::[PSH_ETO_CARD]
		 where x.[CARD_NUMBER] = pCtx.card.[OLD_CARD_NUMBER]
		 and x.[CARD_ID] = pCtx.card.[OLD_CARD_ID]
		)
	loop
		pCtx.previousCard.[CARD_ACCOUNT]	:= x.c_card_account;
		pCtx.previousCard.[OPERATIONS]		:= x.c_operations;
		update u(u.[HOT_CARD_STATUS] = pCtx.requestData.oldCardStatus
				)
		in ::[PSH_ETO_CARD]
		where u = x.c_card_ref;
		return 0;
	end loop;
	return 7;
end;

function processActionSwitch(pCtx in out nocopy PROCESSING_CONTEXT_REC_TYPE) return integer is
	v_retval	integer;
--	v_previous_eto_card	[PSH_ETO_CARD];
begin
	&debug('.processActionSwitch Begin:', 0)

	v_retval := getAndUpdatePreviousCard(pCtx);

	if v_retval = 0 then
		v_retval := tryCreateCard(pCtx);
	
		if v_retval = 0 then
			v_retval := tryCreateClientIfNeed(pCtx);
		end if;
		if v_retval = 0 then
			v_retval := tryOpenAccount(pCtx);
		end if;
	
		if v_retval = 0 then
			v_retval := tryExecuteBoMovement(pCtx);
		end if;
		if v_retval = 0 then
			v_retval := tryCloseAccount(pCtx);
		end if;

		if v_retval = 0 then
			v_retval := writeCard(pCtx.card);
		end if;
	end if;

	&debug('.processActionSwitch End: v_retval = ' || v_retval, 0)
	return v_retval;
end;

function getRequestData(pReqXml xmltype) return REQUEST_DATA_REC_TYPE is
	vReqData	REQUEST_DATA_REC_TYPE;
begin
	&debug('.getRequestData Begin:', 0)
	vReqData.action				:= [XT].get_xstring(pReqXml, cv_tag_action);
	vReqData.ID_INT				:= [XT].get_xstring(pReqXml, cv_tag_ID_INT);
	vReqData.ID_EXT				:= [XT].get_xstring(pReqXml, cv_tag_ID_EXT);
	vReqData.cardNumber			:= [XT].get_xstring(pReqXml, cv_tag_cardNumber);
	vReqData.customerId			:= [XT].get_xstring(pReqXml, cv_tag_customerId);
	vReqData.expDate			:= to_date([XT].get_xstring(pReqXml, cv_tag_expDate), cv_tag_expDate_format);
	vReqData.productType		:= [XT].get_xstring(pReqXml, cv_tag_productType);
	vReqData.accountNumber		:= [XT].get_xstring(pReqXml, cv_tag_accountNumber);
	vReqData.cardId				:= [XT].get_xstring(pReqXml, cv_tag_cardId);
	vReqData.hotCardStatus		:= [XT].get_xstring(pReqXml, cv_tag_hotCardStatus);
	vReqData.cardTypeName		:= [XT].get_xstring(pReqXml, cv_tag_cardTypeName);
	vReqData.personId			:= [XT].get_xstring(pReqXml, cv_tag_personId);
	vReqData.cardContractId		:= [XT].get_xstring(pReqXml, cv_tag_cardContractId);
	vReqData.cardCreationDate	:= [XT].get_xdate(pReqXml, cv_tag_cardCreationDate);
	vReqData.currency			:= [XT].get_xstring(pReqXml, cv_tag_currency);
	vReqData.currencyAlphaCode	:= [XT].get_xstring(pReqXml, cv_tag_currencyAlphaCode);
	vReqData.oldCardId			:= [XT].get_xstring(pReqXml, cv_tag_oldCardId);
	vReqData.oldCardNumber		:= [XT].get_xstring(pReqXml, cv_tag_oldCardNumber);
	vReqData.oldCardStatus		:= [XT].get_xstring(pReqXml, cv_tag_oldCardStatus);

	&debug('.getRequestData End: pCitReq parsed successfully', 0)
	return vReqData;
end;

function getCardFromRequestData(pReqData REQUEST_DATA_REC_TYPE) return [PSH_ETO_CARD] is
	v_eto_card	[PSH_ETO_CARD];
begin
	&debug('.getCardFromRequest Begin:', 0)
	v_eto_card%init;
	v_eto_card.[ID_EXT]				:= pReqData.ID_INT;
	v_eto_card.[CARD_NUMBER]		:= pReqData.cardNumber;
	v_eto_card.[CUSTOMER_ID]		:= pReqData.customerId;
	v_eto_card.[EXP_DATE]			:= pReqData.expDate;
	v_eto_card.[PRODUCT_TYPE]		:= pReqData.productType;
	v_eto_card.[ACCOUNT_NUMBER]		:= pReqData.accountNumber;
	v_eto_card.[CARD_ID]			:= pReqData.cardId;
	v_eto_card.[HOT_CARD_STATUS]	:= pReqData.hotCardStatus;
	v_eto_card.[CARD_TYPE_NAME]		:= pReqData.cardTypeName;
	v_eto_card.[PERSON_ID]			:= pReqData.personId;
	v_eto_card.[CARD_CONTRACT_ID]	:= pReqData.cardContractId;
	v_eto_card.[CARD_CREATION_DT]	:= pReqData.cardCreationDate;
	v_eto_card.[CURRENCY]			:= pReqData.currency;
	v_eto_card.[CURRENCY_AL_CODE]	:= pReqData.currencyAlphaCode;
	v_eto_card.[OLD_CARD_ID]		:= pReqData.oldCardId;
	v_eto_card.[OLD_CARD_NUMBER]	:= pReqData.oldCardNumber;

	&debug('.getCardFromRequest End: pCitReq parsed successfully', 0)
	return v_eto_card;
end;

function getResponse(pEtoCard [PSH_ETO_CARD], pResult varchar2, pMessage varchar2 := null) return clob is
	resp	clob := empty_clob();
begin
	&debug('.getResponse Begin: pEtoCard.[ID_EXT] = ' || pEtoCard.[ID_EXT] || ', pResult = ' || pResult || ', pMessage = "' || pMessage || '"', 0)
	resp := to_clob(
'
<' || cv_tag_response || '>
  <ID_INT Value="'		|| pEtoCard%id || '"/>
  <ID_EXT Value="'		|| pEtoCard.[ID_EXT] || '"/>
  <cardNumber Value="'	|| pEtoCard.[CARD_NUMBER] || '"/>
  <RESULT Value="'		|| pResult || '"/>
  <MESSAGE Value="'		|| [XT].escape_string(pMessage) || '"/>
</' || cv_tag_response || '>
');
	&debug('.getResponse End: resp = ' || resp, 0)
	return resp;
end;

function getResponse4Exception(pReq clob, pResult varchar2, pMessage varchar2 := null) return clob is
	resp	clob := empty_clob();
begin
	&debug('.getResponse4Exception Begin: pReq = ' || pReq, 0)
	resp := to_clob(
'
<' || cv_tag_response || '>
  <ID_INT Value=""/>
  <ID_EXT Value="'		|| getTagValue(pReq, 'ID_INT') || '"/>
  <cardNumber Value="'	|| getTagValue(pReq, 'cardNumber') || '"/>
  <RESULT Value="'		|| pResult || '"/>
  <MESSAGE Value="'		|| [XT].escape_string(pMessage) || '"/>
</' || cv_tag_response || '>
');
	&debug('.getResponse4Exception End: resp = ' || resp, 0)
	return resp;
end;

function getTagValue(pXmlClob in out nocopy clob, pTag varchar2) return varchar2 is
begin
	return regexp_substr(pXmlClob, '<' || pTag || ' Value="(.*?)"/>', 1, 1, 'c', 1);
end;

public procedure start_timer(p_timer_code varchar2(64)) is 
begin
	&call_int(CIT_INT, INT_TLIB, 2).start_timer(p_timer_code);
end;

public procedure finish_timer(p_timer_code varchar2(64)) is 
begin
	&call_int(CIT_INT, INT_TLIB, 2).finish_timer(p_timer_code);
end;


end;
