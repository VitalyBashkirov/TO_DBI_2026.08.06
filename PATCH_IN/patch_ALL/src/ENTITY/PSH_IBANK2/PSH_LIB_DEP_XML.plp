class PSH_IBANK2;

@import_plsql(true)
@this(plsql_lock:=false,create_on_start:=true)
@name('[ПСБ] Библиотека депозит XML')
@tag('COPIED')
library PSH_LIB_DEP_XML is
public pragma macro ('xml','[XML_DB]');
	pragma include(::[RUNTIME].[MACRO_LIB]);
	pragma include(::[EXECUTORY_PROCES].[LIB_MACRO]);
	pragma macro(tab, '''    ''', substitute); 
		
public type value_tb is table of varchar2(2048) index by varchar2(50);	

public procedure ins_result_row(QUERY_ID number, ROW_NUMBER number,f_name string(50), f_value string(2000),row_level number default 0) is 
vstr varchar2(2000);
begin
	vstr:= 'begin INSERT INTO QUERY_RESULTS(QUERY_ID,LINE_NUMBER,ROW_NUMBER, FIELD_NAME,FIELD_VALUE) VALUES('||QUERY_ID||', '
	||row_level||', '||ROW_NUMBER||', '''||f_name||''', '''||f_value||'''); commit; end;';
	
	execute immediate vstr;

end;

procedure addExceptionStatement(acc varchar, sum number, vDate varchar2, dep ref [DEPOSIT_ORG]) is
vRec ref [RECORDS];
vAcc  ref [AC_FIN];
vEx   ref [PSH_DEP_SETTINGS];
begin
			
	select x(x%id) in ::[AC_FIN] all where x.[MAIN_V_ID]=acc into vAcc;
	if vAcc is not null then
	    select x(x%id) in vAcc.[ARC_MOVE] where to_date(vDate, 'dd.mm.yyyy') = trunc(x.[DATE]) into vRec;
	end if;    
	if vRec is not null then    
	    vEx:=::[PSH_DEP_SETTINGS].[PSH_NEW_AUTO](
	'Не входит в выписку'		--Свойство
	,sysdate		--Дата создания
	,dep		--Депозит
	,null		--Значение
	,stdlib.UserId		--Пользователь
	,vRec		--Значение нум
	);
	    
	end if;		
end;

----добавляем запись в [ПСБ] Депозит. Настройка обслуживания с внешним DOC_ID
procedure addDoc_Id_Extend(dep ref [DEPOSIT_ORG], doc_id number, v_status varchar) is
vEx   ref [PSH_DEP_SETTINGS];
begin
  vEx:=::[PSH_DEP_SETTINGS].[PSH_NEW_AUTO](
	'DOC_ID'		--Свойство
	,sysdate		--Дата создания
	,dep		--Депозит
	,v_status		--Значение
	,stdlib.UserId		--Пользователь
	,doc_id		--Значение нум
	);		
end;

----проверим, есть ли финансовые операции
function check_fin_oper(d ref [DEPOSIT_ORG]) return boolean
is
flag    number;
begin
	select x(nvl(max(1), 0)) in ::[FACT_OPER] all where x%collection=d.[LIST_PAY] into flag;
	if flag = 1 then
		return false;
	else
	    return true;
	end if;	
end;

function check_need_update(v_doc_id number) return number is
rdep ref [DEPOSIT_ORG];
tmp_stat varchar2;
tmp_dep number;
tmp_set ref [PSH_DEP_SETTINGS];
begin
	select x(x.[VALUE], x.[DEP_REF], x%id) in ::[PSH_DEP_SETTINGS] all where x.[VALUE_NUM]=v_doc_id into tmp_stat, tmp_dep, tmp_set;
--	if tmp_stat = '2' then
		   select x(x%id) in [DEPOSIT_ORG] all where x%id= tmp_dep into rdep;
           if ((rdep.[COM_STATUS]=(::[COM_STATUS_PRD]([CODE] = 'WORK')) or rdep.[COM_STATUS]=(::[COM_STATUS_PRD]([CODE] = 'TO_CLOSE')))
           	and tmp_stat != 5 and not check_fin_oper(rdep)
           ) then
           	    tmp_set.[VALUE] := 5; 
           		return 5;
           elsif 	((rdep.[COM_STATUS]=(::[COM_STATUS_PRD]([CODE] = 'CLOSE')) or rdep.[COM_STATUS]=(::[COM_STATUS_PRD]([CODE] = 'TO_CLOSE')))
           	and tmp_stat != 6 and check_fin_oper(rdep)
           ) then
            	tmp_set.[VALUE] := 6; 
           	    return 6;           
           end if;
           
	--end if;
	return 0;	
exception when others then return 0;
end;



procedure addExceptionDelAcc(acc varchar, dep ref [DEPOSIT_ORG]) is
vtmp varchar2(30);
vEx   ref [PSH_DEP_SETTINGS];
begin
   if (acc is not null and dep is not null) then
	 vEx:=::[PSH_DEP_SETTINGS].[PSH_NEW_AUTO](
	'DELETED'		--Свойство
	,sysdate		--Дата создания
	,dep		--Депозит
	,acc		--Значение
	,stdlib.UserId		--Пользователь
	,null		--Значение нум
	);		
   end if;
end;	


-------получение суммы начисления процентов
public function get_interest_amount(lpp number) return number is
vsum number;
begin
	select x(sum(x.[SUMMA])) in ::[PLAN_OPER] all where x%collection=lpp 
	and x.[OPER] = ::[VID_OPER_DOG]([CODE]='ВЫПЛАТА_ПРОЦ_ДЕП')    into vsum;
	return vsum;
end;
------------------------------------------

public function checkStatement(vR ref [RECORDS]) return boolean is
res number;
begin
	select x(nvl(max(1), 0)) in ::[PSH_DEP_SETTINGS] all where x.[VALUE_NUM]=vR into res;
	if res=1 then
		return false;
	else
	    return true;
	end if;    	
end;
	  
-- формирование заголовока файла
public function makeXmlHeader return clob
is
xml clob;
begin
	xml := '<?xml version="1.0" encoding="windows-1251"?>' || NL$ 
			||'<abs-response xmlns="http://abs-response.beans.rainbow.bifit.com">'|| NL$ ;
    return xml;			
end;

public function addField(field_name varchar2, str_value varchar2) return clob
is
xml clob;
begin
	xml :='<field name="'||field_name||'">'||str_value||'</field>'|| NL$ ;	
    return xml;			
end;



function get_acc(v_acc varchar2(30)) return ref [AC_FIN] is
r_v_acc ref [AC_FIN];
begin
	select x(x%id) in ::[AC_FIN] where x.[MAIN_V_ID]=v_acc into r_v_acc;
	return r_v_acc;
	exception when others then return null;
end;


-----Проставляем значение свойства, чтобы отфильтровать уже отправленные в iBank депозиты
-----Проставляем значение свойства отправленных счетов, чтобы отфильтровать уже отправленные счета в iBank

procedure set_prop_takeatloaded ( p_Depn ref [DEPN], p_date_begin date, p_value boolean, prop_type varchar2)
is
	temp_bool_val		varchar(1);
	temp_property_ref	ref [PROPERTY];
	work_at_take_ref        ref [PROPERTY_TYPE] ;

begin
	if prop_type = 'acc' then 
	   work_at_take_ref:=::[PROPERTY_TYPE]([CODE] = 'ACC_LOADED_TO_DBO');
	elsif prop_type = 'dbo' then
		work_at_take_ref:=::[PROPERTY_TYPE]([CODE] = 'LOADED_TO_DBO');
	elsif prop_type = 'del_acc' then
		work_at_take_ref:=::[PROPERTY_TYPE]([CODE] = 'DEL_ACC_LOADED_TO_DBO');	
	end if;  
	   
	if 	p_value is not null  then
		begin		
			temp_bool_val := p_value; 			
			select x(x) in p_Depn.[PROPERTY_ARR]
			where x.[PROPERTY_TYPE]	= work_at_take_ref
			into temp_property_ref;
			
			temp_property_ref.[STR_VALUE] := temp_bool_val;

			
		exception
			when NO_DATA_FOUND then				
				::[PROPERTY].[LIB].set_property(	
		 				P_PROPERTY_TYPE		==	work_at_take_ref
						,P_DATE_BEGIN		==	p_date_begin
						,P_DATE_END			==	null
						,P_USER				==	stdlib.user_id
						,P_REF_VALUE		==	null
						,P_NUM_VALUE		==	null
						,P_STR_VALUE		==	temp_bool_val
						,P_COLLECTION		==	p_Depn.[PROPERTY_ARR]
						,p_delete_later		== 	null
						,sys_date			==	sysdate
						);
				
				
		end;			
	end if;	
end;


-------отправляем данные по счета с которого пополняем 40702... Уже не нужно, но оставим пока
procedure send_acc_rest(dep ref [DEPOSIT_ORG], query_id number, line_number number) is
  md       ref [MAIN_DOCUM];
  fact_op  ref [FACT_OPER];
  xml	clob;
  xml_blob	blob;
  bik varchar2(30);
  bank ref [CL_BANK_N];
  vtypeAcc  varchar2(5):='0'; -- Расчетный;
  vAccount varchar2(30);
  vCurrency  varchar2(20);
  vCreateDate varchar2(50);
  vClosingDate varchar2(50);
  vReminder    number;
  vInn         varchar2(20);

begin
 	select x(x%id) in ::[FACT_OPER] all where x%collection=dep.[LIST_PAY] 
	and x.[DOC].[IN_FOLDER].[BUSINESS_OP]=::[PATTERN_DOC](PATTERN_CODE='DEP_ADD') into fact_op;
	---------------пишем exception	
	select x(x.[ACC_DT].[MAIN_V_ID], x.[ACC_DT].[FINTOOL].[CUR_SHORT], to_char(x.[ACC_DT].[DATE_OP], 'dd.mm.yyyy'), 
	to_char(x.[ACC_DT].[DATE_CLOSE], 'dd.mm.yyyy'),  x.[ACC_DT].[SALDO], x.[ACC_DT].[CLIENT_V].[INN] )
	 in ::[MAIN_DOCUM] all where x%id=fact_op.[DOC] into vAccount, vCurrency, vCreateDate, vClosingDate, vReminder, vInn;
	
    bank := ::[SYSTEM].[VARIABLES].OurBank;
    bik := ltrim( rtrim( bank.[BIC]));

end;	





