					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];
				end if;
				for
					(select cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name,
							         cl_link.[PARTNER]	: partner
							)
						in ::[LINKS_CL] all
						where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
							and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)
				loop
					begin
						var sTempStr	varchar2(1024);
						var rTempCl		ref [CL_PRIV];
						sTempStr := cl_link.partner_name;
						if cl_link.[PARTNER] is not null and cl_link.[PARTNER]%class='CL_PRIV' then
							rTempCl := cl_link.[PARTNER];
							sTempStr := sTempStr; 
						end if;
						if p_data is null then
							P_DATA := sTempStr;
						else
							P_DATA := P_DATA || ', '|| sTempStr;
						end if;
					end;
				end loop;
				P_DATA := nvl(ltrim(P_DATA), 'НЕТ');
			elsif p_info = 'НАЛИЧ_БЕН_2023'	then
				P_DATA := 'НЕТ';
				if client_corp%id is not null then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];
				end if;
				for
					(select cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name,
							         cl_link.[PARTNER]	: partner
							)
						in ::[LINKS_CL] all
						where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
							and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)
				loop
					P_DATA := 'ДА';
					exit;
				end loop;
				
			elsif p_info = 'БЕНЕФ_КЛИЕНТА'	then
				P_DATA := null;
				if client_corp%id is not null then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];
				end if;
				for
					(select cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name,
							         cl_link.[PARTNER]->(true)[INN] : partner_inn,
							         cl_link.[PARTNER]	: partner
							)
						in ::[LINKS_CL] all
						--where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
						where cl_link.[VID_LINK].[CODE] = 'ПОД_КОНТ_БЕНЕФИЦИАРА'
							and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)
				loop
					begin
						var sTempStr	varchar2(1024);
						--var rTempCl		ref [CL_PRIV];
						sTempStr := cl_link.partner_name||' ИНН '|| cl_link.partner_inn;
						--if cl_link.[PARTNER] is not null and cl_link.[PARTNER]%class='CL_PRIV' then
						--	rTempCl := cl_link.[PARTNER];
						--	sTempStr := sTempStr; 
						--end if;
