class PERSONAL_ADDRESS;

@this(create_on_start:=true)
@name('[ПСБ] Добавить (SWIFT)')
@tag('COPIED')
constructor PSH_EXP_NEW_AUTO uses EDIT#AUTO is

@name('В формате КЛАДР')                           public V_KLADR_MODE     [NUMBER];
@name('Адрес')                                     public V_ADDR           [PERSONAL_ADDRESS];
@name('Почтовый индекс проставлять автоматически') public V_AUTO_ZIP       [BOOLEAN];
@name('V_VB')                                      public V_VB             [STRING_32000];
@name('Список домов')                              public V_HOUSE_ARR      [LIST_DOMA_ARR];
@name('Выбор № дома')                              public V_HOUSE_REF      [LIST_DOMA_REF];
@name('Страна')                                    public V_COUNTRY        [COUNTRY_REF];
@name('Станции метро')                             public V_METRO_STATIONS [METRO_STATIO_ARR];
@name('Текущий нас. пункт с формы ввода')          public V_CURRENT_CITY   [NAME_CITY_REF];
@name('Адресный объект строкой')                   public V_STR            [MEMO];
@name('Дом (ссылка) строкой')                      public V_STR_HOUSE      [MEMO];
@name('Тип адресного деления')                     public V_STRUCT         [ONE_FROM_THREE];
@name('ОКТМО (ссылка)')                            public V_OKTMO_REF      [OKTMO_REF];
@name('Работающая операция')                       public V_OPER           [STRING_16];

pragma Include([RUNTIME]::[MACRO_LIB]);
PSH_EXP_NEW_AUTO (
	@name('Тип адреса')                                    P_TYPE           in [ADDRESS_TYPE_REF],
	@name('Почтовый индекс')                               P_ZIP            in [STRING_6],
	@name('Населенный пункт')                              P_CITY           in [NAME_CITY_REF],
	@name('Улица населенного пункта')                      P_STREET_REF     in [STREET_REF],
	@name('Адрес строкой')                                 P_IMP_STR        in [STRING_250],
	@name('Дом')                                           P_HOUSE          in [STRING_40],
	@name('Корпус')                                        P_KORPUS         in [STRING_100],
	@name('Квартира / комната')                            P_FLAT           in [STRING_50],
	@name('Район населенного пункта')                      P_DISTRICT       in [REGION_REF],
	@name('Дом')                                           P_HOUSE_REF      in [HOUSES_REF]       default null,
	@name('Улица')                                         P_STREET_STR     in [STRING_250]       default null,
	@name('Фиксировать')                                   P_FIX_PRINT      in [BOOLEAN]          default null,
	@name('Дата регистрации')                              P_REG_DATE       in [DATE]             default null,
	@name('Дата окончания регистрации')                    P_REG_END_DATE   in [DATE]             default null,
	@name('Адресный объект')                               P_ADDR_OBJ       in [ADDRESS_OBJ_REF]  default null,
	@name('Тип адресного деления')                         P_STRUCT         in [SHORT2]           default null,
	@name('Наименование регистрирующего органа')           P_REG_PLACE_NAME in [STRING_250]       default null,
	@name('Код подразделения, осуществившего регистрацию') P_REG_PLACE_CODE in [STRING_20]        default null
) return ref [PERSONAL_ADDRESS] is

validate is
	v_this ref [PERSONAL_ADDRESS];
begin
	if this is not null then
		v_this := this;
		&BASE$SETVARS;
		&BASE$VALIDATE(v_this);
		&BASE$GETVARS;
	end if;
end;

execute is
	v_this	ref [PERSONAL_ADDRESS];
	v_cl	ref [CLIENT];
	vVB		string(32000);
	vADDS	string(32000);
begin
	if this is not null then
		
		if LIB.Is_Parent('CLIENT', THIS%parentclass) then
			v_CL := THIS%parent;
		end if;
		--------------------------------------------------------------------------
		/** /
		::[HOOK].[CL_CHECK_REQS]
		(
			P_METH		== &METHOD$CLASS || '.' || &METHOD$SNAME	--Операция
			,P_CALL		== 'DEFAULT'			--Тип вызова
			,P_OP_INFO	== null					--Вид изменения
			,P_CLIENT	== v_CL					--Клиент, ссылка
			,P_CL_PRIV	== null					--Физическое лицо
			,P_CL_ORG	== null					--Юридическое лицо
			,P_ADDS		== vADDS				--Дополнительные параметры
			,P_ADDRESS	== null					--Адреса
			,P_DOC		== null					--Удостоверение
			,P_DOCS		== null					--Доп. удостоврения
			,P_REGISTER	== null					--Регистрация
			,P_LINKS_OTHER	== null				--Связи с другими клиентами
			,P_ALL_BOSS		== null				--Должностные лица
			,P_VB			== vVB				--Клиент-скрипт
		);
		/**/
		pragma if_def(DBI, false);
		pragma if_def(JAVA);
		-- RP0663197. в режиме 2МСА нужно сбросить кэш в БД, чтобы создался пустой экземпляр
		-- так как после каждого исполненного DML очищается контекст сессии Oracle
		-- что приводит к некорректной работе триггера БД 
		::[RUNTIME].[SP_CACHE_MGR].cache_flush;  
		pragma end_if;
		pragma end_if; 
		v_this := this;

		&BASE$SETVARS;
		&BASE$EXECUTE(v_this);
		
		/** /
		::[HOOK].[CL_CHECK_REQS]
		(
			P_METH		== &METHOD$CLASS || '.' || &METHOD$SNAME	--Операция
			,P_CALL		== 'EXECUTE'			--Тип вызова
			,P_OP_INFO	== null					--Вид изменения
			,P_CLIENT	== v_CL					--Клиент, ссылка
			,P_CL_PRIV	== null					--Физическое лицо
			,P_CL_ORG	== null					--Юридическое лицо
			,P_ADDS		== vADDS				--Дополнительные параметры
			,P_ADDRESS	== null					--Адреса
			,P_DOC		== null					--Удостоверение
			,P_DOCS		== null					--Доп. удостоврения
			,P_REGISTER	== null					--Регистрация
			,P_LINKS_OTHER	== null				--Связи с другими клиентами
			,P_ALL_BOSS		== null				--Должностные лица
			,P_VB			== vVB				--Клиент-скрипт
		);	
		/**/
	end if;
end;
end;
end;
