class PL_US;

@import_plsql(true)
@name('[ПСБ] Добавить признак счета')
method PSH_PS_ADD is
PSH_PS_ADD (
	@name('Признак счета') P_PS in [PS$]
) is

execute is
	v_ps	ref [PS];
begin
	locate v_ps in this.[B_PS]
	where v_ps = P_PS;
	
	-- все нормально - значит признак уже есть
exception
	when NO_DATA_FOUND then
		-- еще нет - добавим
		this.[B_PS].[NEW#AUTO](P_PS);
	
end;
end;
end;
