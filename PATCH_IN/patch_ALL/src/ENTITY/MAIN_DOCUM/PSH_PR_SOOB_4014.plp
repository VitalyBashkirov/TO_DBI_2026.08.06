class MAIN_DOCUM;

@name('[ПСБ] Противодействие легализации. Печать сообщения об операции_4014')
@tag('COPIED')
method PSH_PR_SOOB_4014 is

@name('V_DATA')                    public V_DATA         [STRING_32000];
@name('Представитель плательщика') public V_PRED_PLAT    [CL_PRIV_REF];
@name('Представитель получателя')  public V_PRED_POL     [CL_PRIV_REF];
@name('Инфа по предст. получ.')    public INFO_POL_TXT   [MEMO_250];
@name('Инфа по предст. плат.')     public INFO_PLAT_TXT  [MEMO_250];
@name('Клиент Плат')               public KLI_PLAT       [CLIENT_REF];
@name('Клиент Пол')                public KLI_POL        [CLIENT_REF];
@name('Представитель плательщика') public V_PRED_PLAT2   [CL_PRIV_REF];
@name('Представитель получателя')  public V_PRED_POL2    [CL_PRIV_REF];
@name('Контролирующий от Банка')   public V_USER_CONTROL [USER_REF];
pragma macro('word', '::[RUNTIME].[WORD]', substitute);

LC_TEMPLATE_CODE	string(128);
LV_TEMPLATE			ref [SHABLON_DOC];

LC_DT_KASSA	const integer	:= 0; -- кассовый документ
LC_DT_SWIFT	const integer	:= 1; -- SWIFT-документ
LC_DT_NCASH	const integer	:= 2; -- безнал

LC_SF_103	const ::[TYPE_DOC_RC].[SFORM]%type	:= '103'; -- 103 тип SWIFT-сообщения
LC_SF_202	const ::[TYPE_DOC_RC].[SFORM]%type	:= '202'; -- 202 тип SWIFT-сообщения

LC_CB_EMPTY		const string(11)	:= 'ChrW(9744)';
LC_CB_CHECKED	const string(11)	:= 'ChrW(9745)';

LC_DT_YL_INPUT	const ref [NAME_PAYDOC] := ::[NAME_PAYDOC]([CODE] = 'КАСС_ОБЪЯВ_ВЗНОС');	-- Объявление на взнос наличными
LC_DT_YL_OUTPUT	const ref [NAME_PAYDOC] := ::[NAME_PAYDOC]([CODE] = 'КАСС_ЧЕК_ВЫДАЧА');		-- Чек на выдачу наличных

PAYER_BIC [STRING_2000];
PAYER_B_NAME [STRING_2000];
PAYEE_BIC [STRING_2000];
PAYEE_B_NAME [STRING_2000];

-- Шаблон адреса
V_ADR_MASK		varchar2(100):= 'POST_CODE,REGION_NCT,DISTRICT,CITY,STREET,HOUSE,KORPUS,FLAT';
-- Реквизиты клиента
V_CITY_C		ref [NAMES_CITY];--"Населенный пункт"
V_OKATO_C		[STRING_2000];--"ОКАТО_клиент"
V_ADRESS_C		[STRING_2000];--"Адрес (клиент)"
V_ADRESS_C_POST	[STRING_2000];--"Почтовый адрес (клиент)"

Procedure GetClientReq(IdClient ref [CLIENT]) is
Begin
	-- Адреса клиента
	::[DEPN_INTERFACE].[PRX_CLIENT].GetAddressClient(IdClient
												,V_ADR_MASK
												,V_CITY_C												
												,V_ADRESS_C
												,V_ADRESS_C_POST
												,V_OKATO_C);
end;											
												
function priz_6001(doc ref [DOCUMENT]) return string is
	res	string;
begin
	select	re(re: CODE)
	in		(
		select	r(substr(max(sys_connect_by_path(r.[CODE], ',')), 2): CODE)
		in		(
			select		hc(hc.[UNUS_CODE].[CODE]: CODE, rownum: RN, rownum - 1: PREV)
			in			::[HISTORY_CHECK]
			where		hc.[DOCUMENT]	= doc
						and hc.[VID_OP]	= ::[VID_OPER_PRED]([CODE] = '6001')
						and hc.[STATE]	= ::[COM_STATUS_PRD]([CODE] = 'CONFIRM')
						and hc.[DATE]	= (
							select		hc2(max(hc2.[DATE]))
							in			::[HISTORY_CHECK]
							where		hc2.[DOCUMENT]		= doc
										and hc2.[VID_OP]	= ::[VID_OPER_PRED]([CODE] = '6001')
										and (hc2.[UNUS_CODE]	= hc.[UNUS_CODE])
						)
		)
		connect by r.[PREV] = prior r.[RN]
		start r.[RN] = 1
	)
	into	res;
	return res;
exception
	when NO_DATA_FOUND then return null;
end;


procedure Get_Adr_Client(--Адреса клиента
	cli		ref [CLIENT]
	,mask	[STRING_100]
	,city	out ref [NAMES_CITY]
	,ADRESS_C		out [STRING_250]
	,ADRESS_C_POST	out [STRING_250]
	,ADRESS_C_FACT	out [STRING_250]
	,OKATO_C		out [STRING_20]
)is
client_class	[STRING_16];
Address_Type_REGISTRATION	const ref [ADDRESS_TYPE]	:= ::[ADDRESS_TYPE]([KOD] = 'REGISTRATION');--Адрес регистрации
Address_Type_CORP			const ref [ADDRESS_TYPE]	:= ::[ADDRESS_TYPE]([KOD] = 'CORP');--Юридический адрес
Address_Type_POST			const ref [ADDRESS_TYPE]	:= ::[ADDRESS_TYPE]([KOD] = 'POST');--Почтовый адрес
Address_Type_FACT			const ref [ADDRESS_TYPE]	:= ::[ADDRESS_TYPE]([KOD] = 'FACT');--Фактический (для юр. лиц.)
Address_Type_REAL_LIVE		const ref [ADDRESS_TYPE]	:= ::[ADDRESS_TYPE]([KOD] = 'REAL_LIVE');--Место пребывания(фактического нахождения)(физ. л.)
begin

	--&debug('MASK = '||mask,0)
	
	if cli is null then return; end if;
	client_class := cli%class;
	if client_class = 'CL_ORG' or client_class = 'CL_BANK_N' then
		ADRESS_C := [VIEWFUN].GetAddress(cli, mask, 'CORP');--Юридический адрес
		city	:= cli.[GET_ADDRESS](Address_Type_CORP).[CITY];
	elsif	client_class = 'CL_PRIV' then
		ADRESS_C := [VIEWFUN].GetAddress(cli, mask, 'REGISTRATION');--Адрес регистрации
		city	:= cli.[GET_ADDRESS](Address_Type_REGISTRATION).[CITY];
	end if;
	
	--debug_pipe('ADRESS_C ='||ADRESS_C,0);
	
	if city is null then
	city	:= cli.[GET_ADDRESS](Address_Type_POST).[CITY];	
	end if;

	--debug_pipe('ADRESS_C_POST ='||ADRESS_C_POST,0);
		
	if client_class = 'CL_ORG' or client_class = 'CL_BANK_N' then
		ADRESS_C_FACT := [VIEWFUN].GetAddress(cli, mask, 'FACT');
		--city	:= cli.[GET_ADDRESS](Address_Type_FACT).[CITY];
	elsif	client_class = 'CL_PRIV' then
		ADRESS_C_FACT := [VIEWFUN].GetAddress(cli, mask, 'REAL_LIVE');
		--city	:= cli.[GET_ADDRESS](Address_Type_REAL_LIVE).[CITY];
	end if;
	
	--debug_pipe('ADRESS_C_FACT ='||ADRESS_C_FACT,0);

	OKATO_C	:= NULL;
	for(select ct(ct.[OKATO].[CODE] : code) in ::[NAMES_CITY] all where ct=city)
	loop
		OKATO_C	:= ct.code;
		exit;
	end loop;
end;

function PrintClData (PAYEX string, pMD [MAIN_DOCUM], pMD_KL_XT [REQ_CLIENT], pTakeREQ_MAN boolean, pArch_op_val ref [KASSA_V], drc [DOCUM_RC], is_in boolean) return boolean
is
ADR_MASK varchar2(100):= 'POST_CODE,REGION_NCT,DISTRICT,CITY,STREET,HOUSE,KORPUS,FLAT';
vCITY_C		ref [NAMES_CITY];--"Населенный пункт"
vOKATO_C		[STRING_2000];--"ОКАТО_клиент"
vADRESS_C		[STRING_2000];--"Адрес (клиент)"
vADRESS_C_POST	[STRING_2000];--"Почтовый адрес (клиент)"
vADRESS_C_FACT	[STRING_2000];-- Фактический адрес

vClientRef ref [CLIENT];

begin
	
	if pTakeREQ_MAN then
		vClientRef := pMD.[REQ_MAN].[CLIENTREF];
	else
		vClientRef := pMD_KL_XT.[1].[1];
	end if;	

		
	if pTakeREQ_MAN then
		&word.put_into_prepared_lines(PAYEX||'_NAME', pMD.[REQ_MAN].[NAME]	||	Chr(11));
		&word.put_into_prepared_lines(PAYEX||'_INN', '');
		if pMD.[REQ_MAN].[PASSPORT] is not null then
			if pMD.[REQ_MAN].[PASSPORT]= 'Паспорт гражданина РФ' then
			&word.put_into_prepared_lines(PAYEX||'_DOC', pMD.[REQ_MAN].[PASSPORT]||': '|| pMD.[REQ_MAN].[SERIA]||' '||pMD.[REQ_MAN].[NUMBER]||' выдан '||pMD.[REQ_MAN].[WHO_V]||' '||to_char(pMD.[REQ_MAN].[DATE_V], 'DD.MM.YYYY')||' к.п. '||pMD.[REQ_MAN].[DEPART_CODE]||	Chr(11));
			else
			&word.put_into_prepared_lines(PAYEX||'_DOC', pMD.[REQ_MAN].[PASSPORT]||': '|| pMD.[REQ_MAN].[SERIA]||' '||pMD.[REQ_MAN].[NUMBER]||' '||pMD.[REQ_MAN].[WHO_V]||' '||to_char(pMD.[REQ_MAN].[DATE_V], 'DD.MM.YYYY')||' '||pMD.[REQ_MAN].[DEPART_CODE]||	Chr(11));
			end if;
		else
			&word.put_into_prepared_lines(PAYEX||'_DOC', '');
		end if;
		&word.put_into_prepared_lines(PAYEX||'_BIRTH','Дата и место рождения: '||to_char(pMD.[REQ_MAN].[BIRTHDAY], 'DD.MM.YYYY')||' '||pMD.[REQ_MAN].[BIRTH_PLACE] ||	Chr(11));
		&word.put_into_prepared_lines(PAYEX||'_COUNTRY','Гражданство: '||pMD.[REQ_MAN].[COUNTRY].[NAME] ||	Chr(11));
	
	elsif vClientRef is not null then
		&word.put_into_prepared_lines(PAYEX||'_NAME', vClientRef.[NAME]	||	Chr(11));
		&word.put_into_prepared_lines(PAYEX||'_INN', 'ИНН: '||vClientRef.[INN] ||	Chr(11));
		
		&word.put_into_prepared_lines(PAYEX||'_DOC', '');
		&word.put_into_prepared_lines(PAYEX||'_BIRTH', '');
		&word.put_into_prepared_lines(PAYEX||'_COUNTRY', '');
	
	else
		&word.put_into_prepared_lines(PAYEX||'_NAME', pMD_KL_XT.[2].[2]	||	Chr(11));
		&word.put_into_prepared_lines(PAYEX||'_INN', 'ИНН: '||pMD_KL_XT.[2].[INN] ||	Chr(11));
		-- KAS КПП
		&word.put_into_prepared_lines(PAYEX||'_KPP', 'КПП: '||pMD_KL_XT.[2].[KPP]	||	Chr(11));		
		
		&word.put_into_prepared_lines(PAYEX||'_DOC', '');
		&word.put_into_prepared_lines(PAYEX||'_BIRTH', '');
		&word.put_into_prepared_lines(PAYEX||'_COUNTRY', '');
		
	end if;	
	
	if vClientRef%class = 'CL_ORG' then
		&word.put_into_prepared_lines(PAYEX||'_OKPO', 'ОКПО: '||vClientRef->(CL_ORG)[KOD_OKPO]	||	Chr(11));
		&word.put_into_prepared_lines(PAYEX||'_OGRN', 'ОГРН: '||vClientRef->(CL_ORG)[REGISTER].[GOS_REG_NUM_REC]	||	Chr(11));
		&word.put_into_prepared_lines(PAYEX||'_DATE_GOS_REG', 'Дата гос.регистрации: '||to_char(vClientRef->(CL_ORG)[REGISTER].[DATE_REG], 'DD.MM.YYYY')	||	Chr(11));
		-- KAS КПП
		&word.put_into_prepared_lines(PAYEX||'_KPP',  'КПП: '||vClientRef->(CL_ORG)[KPP]	||	Chr(11));	
	else
		&word.put_into_prepared_lines(PAYEX||'_OKPO', '');
		&word.put_into_prepared_lines(PAYEX||'_OGRN', '');
		&word.put_into_prepared_lines(PAYEX||'_DATE_GOS_REG', '');
	end if;

	if vClientRef is not null then
		-- Адреса клиента
		Get_Adr_Client(vClientRef/*pMD.[REQ_MAN].[CLIENTREF]*/,ADR_MASK, vCITY_C ,vADRESS_C ,vADRESS_C_POST, vADRESS_C_FACT ,vOKATO_C);												
		&word.put_into_prepared_lines(PAYEX||'_ADR_R',vADRESS_C||	Chr(11) );
	    &word.put_into_prepared_lines(PAYEX||'_ADR_P',nvl(vADRESS_C_FACT,vADRESS_C_POST)||	Chr(11) );
	elsif pTakeREQ_MAN then
		&word.put_into_prepared_lines(PAYEX||'_ADR_R',pMD.[REQ_MAN].[ADDR] ||	Chr(11));
	    &word.put_into_prepared_lines(PAYEX||'_ADR_P','' );
	else
		&word.put_into_prepared_lines(PAYEX||'_ADR_R','' );
	    &word.put_into_prepared_lines(PAYEX||'_ADR_P','' );
	end if;
	
	&word.put_into_prepared_lines(PAYEX||'_REQ_ACC', '№ счета: '||nvl(pMD_KL_XT.[2].[1], pMD_KL_XT.[1].[2].[MAIN_V_ID]));
					
	-- Банк клиента
	if drc%id is not null /*and drc.[MT103] is not null*/ and is_in then -- KAS 15/11/2021
		&word.put_into_prepared_lines(PAYEX||'_BANK_NAME',drc.[PAYER].[BANK]);
    	&word.put_into_prepared_lines(PAYEX||'_BANK_BIC', 'БИК: '||drc.[PAYER].[BCODE]);
	elsif drc%id is not null /*and drc.[MT103] is not null*/ and not is_in then -- KAS 15/11/2021
		&word.put_into_prepared_lines(PAYEX||'_BANK_NAME',drc.[RECEIVER].[BANK]);
    	&word.put_into_prepared_lines(PAYEX||'_BANK_BIC', 'БИК: '||drc.[RECEIVER].[BCODE]);
		&word.put_into_prepared_lines(PAYEX||'_BANK_COUNTRY', 'Код страны: '||nvl(pMD_KL_XT.[2].[3].[COUNTRY].[CODE], pMD_KL_XT.[1].[2].[FILIAL].[BANK].[COUNTRY].[CODE]));    	
    	&word.put_into_prepared_lines(PAYEX||'_BANK_COR_ACC', 'к\с '||nvl(pMD_KL_XT.[2].[3].[KS], pMD_KL_XT.[1].[2].[FILIAL].[BANK].[KS]));			
	else
		&word.put_into_prepared_lines(PAYEX||'_BANK_NAME',nvl(pMD_KL_XT.[2].[3].[NAME], pMD_KL_XT.[1].[2].[FILIAL].[BANK].[NAME]));
    	&word.put_into_prepared_lines(PAYEX||'_BANK_BIC', 'БИК: '||nvl(pMD_KL_XT.[2].[3].[BIC], pMD_KL_XT.[1].[2].[FILIAL].[BANK].[BIC]));
		&word.put_into_prepared_lines(PAYEX||'_BANK_COUNTRY', 'Код страны: '||nvl(pMD_KL_XT.[2].[3].[COUNTRY].[CODE], pMD_KL_XT.[1].[2].[FILIAL].[BANK].[COUNTRY].[CODE]));
		&word.put_into_prepared_lines(PAYEX||'_BANK_COR_ACC', 'к\с '||nvl(pMD_KL_XT.[2].[3].[KS], pMD_KL_XT.[1].[2].[FILIAL].[BANK].[KS]));
	end if;
	
	return true;
		
end;

function predstavit(doc ref [MAIN_DOCUM], tip varchar2(4) ) return ref [CL_PRIV] is
kli ref [CL_PRIV];
kol number :=0;
begin
	if
		upper(tip)='POL'
		and doc.[ACC_KT].[MAIN_V_ID] like ('4%')
		and doc.[ACC_KT].[CLIENT_V]%class='CL_ORG'
		then
			for pred in doc.[ACC_KT].[CLIENT_V]->(CL_ORG)[ALL_BOSS]all
				where
					pred.[CHIEF]
					and pred.[WORK_BEGIN]<=doc.[DATE_DOC]
					and (pred.[WORK_END] is null or pred.[WORK_END]>doc.[DATE_DOC])
			loop
				kli:=pred.[FASE];
				kol:=kol+1;
				info_pol_TXT:= 'Найдено действующих должностных лиц с признаком "РУКОВОДИТЕЛЬ" - '||kol||' штуки';
			end loop;
			
			if kol=1 then
				return kli;
			else
				return null;
			end if;
			
	elsif
		upper(tip)='PLAT'
		and doc.[ACC_DT].[MAIN_V_ID] like ('4%')
		and doc.[ACC_DT].[CLIENT_V]%class='CL_ORG' then
				for pred in doc.[ACC_DT].[CLIENT_V]->(CL_ORG)[ALL_BOSS]all
					where
						pred.[CHIEF]
						and pred.[WORK_BEGIN]<=doc.[DATE_DOC]
						and (pred.[WORK_END] is null or pred.[WORK_END]>doc.[DATE_DOC])
				loop
					kli:=pred.[FASE];
					kol:=kol+1;
					info_plat_TXT:= 'Найдено действующих должностных лиц с признаком "РУКОВОДИТЕЛЬ" - '||kol||' штуки';
				end loop;
				
				if kol=1 then
					return kli;
				else
					return null;
				end if;
				
	else
		return null;
	end if;
	
end;


procedure Put_into
	( p_vField_Code		varchar2
	, p_vField_Value	varchar2
	)
is
	v_value string(32000);
	ds string(32000);
	mod_out	varchar2(100)	:= 'Word'; -- 'XML'; --'Writer';
/* Константы, определяющие параметры передаваемые в метод Find.Execute */
	wdFindContinue	const	integer := 1;
	wdReplaceAll	const	integer := 2;
	vNL		const	varchar2(1 char)	:= LF$;	--	unistr('\000A');

begin
	v_value	:= p_vField_Value;
	v_Value	:= replace(v_Value,'"','""');
	v_Value	:= replace(v_Value,chr(10),'" & Chr(10) & "');
	v_Value	:= replace(v_Value,chr(13),'" & Chr(13) & "');

	debug_pipe('.Put_into_Prepared_Lines -- v_Value='||v_Value,0);
	debug_pipe('.Put_into_Prepared_Lines -- mod_out='||mod_out,0);

	if		mod_out = 'Word' then
		ds	:='b = wrd.Selection.Find.Execute("['||p_vField_Code||']", False, False, False, False, False, True, '||wdFindContinue||', False, "'||v_Value||'", '||wdReplaceAll||', False, False, False, False)';
	elsif	mod_out = 'Writer' then
		ds	:=ds||vNL||'Set oRepl = WordDoc.createReplaceDescriptor()'
				||vNL||'With oRepl'
				||vNL||'	.SearchString = "['||p_vField_Code||']"'
				||vNL||'	.ReplaceString = "'||v_Value||'"'
				||vNL||'End With'
				||vNL||'WordDoc.ReplaceAll(oRepl)'
				||vNL||'Set oRepl = Nothing';
	end if;
	debug_pipe('.Put_into_Prepared_Lines -- ds='||ds,0);
end;
PSH_PR_SOOB_4014 (
	@name('Вид сделки')   P_DEAL_TYPE in [CASE_BETWEEN_TWO],
	@name('Пользователь') P_USER      in [USER_REF],
	@name('Должность')    P_POST      in [CASTA_REF]
) is

validate is
md		[MAIN_DOCUM];
drc		[DOCUM_RC];
dt		integer;						-- Тип документа: Кассовый, SWIFT, Безнал
sf		[TYPE_DOC_RC].[SFORM]%type;		-- Тип SWIFT-сообщения: 103, 202
LV_7001	::[HISTORY_CHECK].[STATE].[CODE]%type;
is_in	boolean;						-- Входящий SWIF-документ
s STRING;
TakeREQ_MAN boolean;

Revers boolean;
Legal_op ref [LEGAL_161P];

vArch_op_val ref [KASSA_V];

MIGR_CARD ref [MIGRATION_CARD];
OTHER_DOC ref [CERTIFICATE];

-- Vorobey 20200123
-- Закладки для ворда. Данные из таблицы "Удостоверение" (В карточке клиента "Доп. удостоверения")
-- Выводятся в ворд все удостоверения которые есть в таблице
PLAT_ODOCS String := 'PRED_PLAT_ODOCS';		-- Ctrl + G + 335
POL_ODOCS String := 'PRED_POL_ODOCS';		-- Ctrl + G + 487
PLAT_ODOCS2 String := 'PRED_PLAT2_ODOCS';	-- Ctrl + G + 409
POL_ODOCS2 String := 'PRED_POL2_ODOCS';		-- Ctrl + G + 561
dateFormat01 String := 'dd.mm.yyyy';
otherDocString varchar(3000);


zamena number;

-- Шаблон адреса
-- PRED_ADR_MASK		varchar2(100):= 'POST_CODE,REGION_NCT,DISTRICT,CITY,STREET,HOUSE,KORPUS,FLAT';
PRED_ADR_MASK		varchar2(100):= 'ALL';
-- Реквизиты клиента
PRED_CITY_C		ref [NAMES_CITY];--"Населенный пункт"
PRED_OKATO_C		[STRING_2000];--"ОКАТО_клиент"
PRED_ADRESS_C		[STRING_2000];--"Адрес (клиент)"
PRED_ADRESS_C_POST	[STRING_2000];--"Почтовый адрес (клиент)"
PRED_ADRESS_C_FACT	[STRING_2000];--"фАКТИЧЕСКИЙ адрес (клиент)"

begin
	if P_MESSAGE = 'DEFAULT' then
		/*
		if THIS.[ACC_DT].[MAIN_V_ID] like ('20202%')and THIS.[ACC_KT].[MAIN_V_ID] like ('20202%') and trunc(::[NOTRADE].[SRV].get_oper_code(this)) in ('01') --and 1=2
			then LC_TEMPLATE_CODE:= 'PSH_OPER_v3_EXCHANGE_BUY';
		elsif THIS.[ACC_DT].[MAIN_V_ID] like ('20202%')and THIS.[ACC_KT].[MAIN_V_ID] like ('20202%') and trunc(::[NOTRADE].[SRV].get_oper_code(this)) not in ('01')
			then LC_TEMPLATE_CODE:= 'PSH_OPER_v3_EXCHANGE_SEL';
		else LC_TEMPLATE_CODE:= 'PSH_OPER_v3';
		end if;
		*/
		V_USER_CONTROL:=::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, 'PSH_PR_SOOB_DOC3', 'V_USER_CONTROL'); --Башкиров В.Г. 27.11.2023

		[WORD].Init_Wrd;
		P_USER	:= stdlib.userid;
		P_POST	:= stdlib.userid.[CASTA];
		V_PRED_PLAT:=predstavit(this,'PLAT');
		if THIS.[ACC_DT].[MAIN_V_ID] like ('202%') and this.[REQ_MAN].[CLIENTREF]%class='CL_PRIV'
			then V_PRED_PLAT:=this.[REQ_MAN].[CLIENTREF]%id; INFO_PLAT_TXT:='КАССОВЫЙ!'||CHR(13)||'Вноситель средств '||V_PRED_PLAT.[NAME];
		end if;
		if THIS.[ACC_KT].[MAIN_V_ID] like ('202%') and this.[REQ_MAN].[CLIENTREF]%class='CL_PRIV'
			then V_PRED_POL:=this.[REQ_MAN].[CLIENTREF]%id; INFO_PLAT_TXT:='КАССОВЫЙ!'||CHR(13)||' Получатель средств '||V_PRED_POL.[NAME];
		end if;
		V_PRED_POL:=predstavit(this,'POL');
		KLI_PLAT:=this.[ACC_DT].[CLIENT_V];
		KLI_POL:=this.[ACC_KT].[CLIENT_V];
	elsif P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'OK' then
			if &word.f_click then
				&word.f_click := false;
				V_DATA := null;
				-- Текущий платежный документ
				md := this;
				-- Документ РЦ, связанный с текущим платежным документом (может отсутствовать)
				drc := ::[LEGAL_INTERFACE].[PRX_DOCUMENT].DOCUM_RC_GETDOCRC(this);
				-- Определение типа документа (для дальнейшего использования в case-выражениях)
				dt := case
					when md.[VID_DOC].[TYPE_DOC].[CODE] = 'KASSA_DOCUM'
					then
						LC_DT_KASSA
					when drc%id is not null and drc.[MT103] is not null
					then
						LC_DT_SWIFT
			else
				LC_DT_NCASH
				end;
				-- Определение типа SWIFT-сообщения (для дальнейшего использования в case-выражениях)
				if dt = LC_DT_SWIFT then
					begin
						select	x(x.[SFORM])
						in		::[TYPE_DOC_RC]
						where	x.[NUM_CODE] = drc.[TYPE_DOC] and  nvl(x.[UT], '*') = nvl(drc.[SUB_TYPE], '*') and nvl(x.[FOR_VAL], '*') = '1'
						into	sf;
					exception
						when NO_DATA_FOUND then sf	:= null;
						when TOO_MANY_ROWS then sf	:= null;
					end;
				end if;
				is_in	:= dt = LC_DT_SWIFT and ::[LEGAL_INTERFACE].[PRX_DOCUMENT].DOCUM_RC_IS_IN(drc%id);
				
				/*
				begin
					locate	LV_TEMPLATE
					in		::[SHABLON_DOC]
					where	LV_TEMPLATE.[CODE]		= LC_TEMPLATE_CODE
						and	LV_TEMPLATE.[GRP_CODE]	= 'LEGAL';
				exception
					when NO_DATA_FOUND then
						pragma error('В справочнике "Справочник шаблонов документов" отсутствует шаблон с кодом ' || LC_TEMPLATE_CODE);
					when TOO_MANY_ROWS then
						pragma error(
							'В справочнике "Справочник шаблонов документов" в группе LEGAL обнаружено несколько шаблонов с кодом '
							|| LC_TEMPLATE_CODE
						);
				end;
				*/
				--&word.open_file(::[SYSTEM_PARAMS].[GET]('PATH_PRINT_DOC') || LV_TEMPLATE.[FILE_NAME]);
				&word.open_file(::[SYSTEM_PARAMS].[GET]('PATH_PRINT_DOC') || 'PSH_MAIN_DOCUM_MSG_4014.dot');
				--&word.prepare_doc_to_put;
				
				&word.cmd(
					'b = wrd.Selection.Find.Execute("[CB_REQ_CNTRL]", False, False, False, False, False, True, 1, False, '
					|| case when P_DEAL_TYPE.[0] = 1 then LC_CB_CHECKED else LC_CB_EMPTY end
					|| ' & " Операция (сделка), подлежащая обязательному контролю", 2, False, False, False, False)'
				);
				&word.cmd(
					'b = wrd.Selection.Find.Execute("[CB_DOUBT]", False, False, False, False, False, True, 1, False, '
					|| case when P_DEAL_TYPE.[0] = 2 then LC_CB_CHECKED else LC_CB_EMPTY end
					|| ' & " Необычная операция (сделка)", 2, False, False, False, False)'
				);
				begin
					select h(h.[ST].[CODE]) in
						(select distinct x(
							x.[VID_OP]											: VID_OP,
							x.[VID_OP].[CODE]									: CODE,
							analytic(
								first_value(x.[STATE]),
								'over (partition by [1] order by [2] desc)',
								x.[VID_OP].[CODE],
								x.[DATE]
							)													: ST,
							nvl(x.[VID_OP].[PRIORITET],3)						: PRIORITET
						)
						in ::[HISTORY_CHECK] all
						where x.[DOCUMENT] = md%id
							and x.[VID_OP].[VID_TYPE] != 3
						)
					where
						h.[VID_OP].[CODE] = '7001'
						and rownum < 2
					into LV_7001;
				exception
					when NO_DATA_FOUND then
						LV_7001	:= null;
				end;
				&word.cmd(
					'b = wrd.Selection.Find.Execute("[CB_LEGAL]", False, False, False, False, False, True, 1, False, '
					|| case when LV_7001 = 'CONFIRM' then LC_CB_CHECKED else LC_CB_EMPTY end
					|| ' & " Одной из сторон операции (сделки) является лицо, в отношении которого имеются сведения об участии в террористической деятельности", 2, False, False, False, False)'
				);
				
				&word.put_into_prepared_lines('NAZN', md.[NAZN]);
				&word.put_into_prepared_lines('DATE_DOC', to_char(md.[DATE_DOC], 'dd.mm.yyyy'));
				&word.put_into_prepared_lines('DATE_VAL', to_char(md.[DATE_VAL], 'dd.mm.yyyy'));
				
				--debug_pipe('sum '||md.[SUM]||'sum_nt '||md.[SUM_NT]||'sum_po '||md.[SUM_PO]||'валюта кред '||md.[VALUTA_PO] ,0);
				
				if  md.[VALUTA].[CUR_SHORT] !='RUB' and  md.[VALUTA_PO].[CUR_SHORT] !='RUB'
				then &word.put_into_prepared_lines('AMOUNT', trim(to_char(md.[SUM_PO],'999G999G999G999G999G999G990D99')));
					 &word.put_into_prepared_lines('AMOUNT_CRED', '('||trim(to_char(md.[SUM_PO]*::[DOCUMENT].[LIB_CUR].get_rate(md.[VALUTA_PO],md.[DATE_PROV]),'999G999G999G999G999G999G990D99'))||' '||::[SYSTEM].[VARIABLES].NatCur.[CUR_SHORT]||')');
					 &word.put_into_prepared_lines('CURR_LTRS', md.[VALUTA_PO].[CUR_SHORT]);
				else &word.put_into_prepared_lines('AMOUNT', trim(to_char(md.[SUM],'999G999G999G999G999G999G990D99')));
						if md.[VALUTA]<>::[SYSTEM].[VARIABLES].NatCur then --but для валютных печатаем 2 суммы
							&word.put_into_prepared_lines('AMOUNT_CRED', '('||trim(to_char(md.[SUM_NT],'999G999G999G999G999G999G990D99'))||' '||::[SYSTEM].[VARIABLES].NatCur.[CUR_SHORT]||')');
						else  &word.put_into_prepared_lines('AMOUNT_CRED','');
						end if;
						&word.put_into_prepared_lines('CURR_LTRS', md.[VALUTA].[CUR_SHORT]);
				end if;
				
				--AMOUNT_CB
				declare
					md_cur	ref [FT_MONEY];
					ft_rub	const ref [FT_MONEY] := ::[SYSTEM].[VARIABLES].NatCur;
				begin
					md_cur := md.[VALUTA];
					if md_cur <> ft_rub then
						&word.put_into_prepared_lines('AMOUNT_CB', ::[DOCUMENT].[LIB_CUR].Cur2Cur(md.[SUM], md_cur, ft_rub, md.[DATE_DOC]));
					else
						&word.put_into_prepared_lines('AMOUNT_CB', md.[SUM]);
					end if;
				end;
				
				&word.put_into_prepared_lines('CURR_NUMB', md.[VALUTA].[CODE_ISO]);
				&word.put_into_prepared_lines('CURR_NAME', md.[VALUTA].[NAME]);
				
				for legal in [LEGAL_161P] where legal.[DOC] = this loop
					Legal_op := legal;
					exit;
				end loop;
				if Legal_op is null then
					for arch_op_val in [KASSA_V] all where arch_op_val.[MAIN_DOC] = this loop-- or arch_op_val.[PLAT_DOCUMENT]
						for legal in [LEGAL_161P] where legal.[DOC] = arch_op_val loop
							Legal_op := legal;
							exit;
						end loop;
						vArch_op_val := arch_op_val;
						exit;
					end loop;
				end if;
				--debug_pipe('::[NOTRADE].[SRV].get_oper_code(this)='||::[NOTRADE].[SRV].get_oper_code(this),0);
				if (md.[VID_DOC].[CODE] in ('КАСС_ОБЪЯВ_ВЗНОС', 'КАСС_РАСХОД_ОРД') and Legal_op.[VO].[CODE] not in ('6001'))  or trunc(::[NOTRADE].[SRV].get_oper_code(this)) in ('01')--'02', '03')
				or Legal_op.[VO].[CODE] in ('8001', '5003', '5005') then
					Revers := true;
				else
					Revers := false;
				end if;
				--debug_pipe('Revers='||Revers,0);
				If md.[VID_DOC].[TYPE_DOC].[CODE] = 'KASSA_DOCUM' then
					TakeREQ_MAN := true;
				end if;
				if not Revers then
					PrintClData('PAYER', md, md.[KL_DT], TakeREQ_MAN, vArch_op_val, drc, is_in);
					PrintClData('PAYEE', md, md.[KL_KT], false, vArch_op_val, drc, is_in);
				else
					PrintClData('PAYER', md, md.[KL_KT], false, vArch_op_val, drc, is_in);
					PrintClData('PAYEE', md, md.[KL_DT], TakeREQ_MAN, vArch_op_val, drc, is_in);
				end if;
				
				&word.put_into_prepared_lines('USER_NAME', P_USER.[NAME]);
				&word.put_into_prepared_lines('USER_POSITION', P_POST.[VALUE]);
				&word.put_into_prepared_lines('KONTR_DOL', V_USER_CONTROL.[CASTA].[VALUE]);	--Башкиров В.Г. 27.11.2023
				&word.put_into_prepared_lines('KONTR_NAME', V_USER_CONTROL.[NAME]);			--Башкиров В.Г. 27.11.2023
				&word.put_into_prepared_lines('DATE', to_char(sysdate, 'dd.mm.yyyy'));
				&word.put_into_prepared_lines('TIME', to_char(sysdate, 'hh24:mi:ss'));
				&word.put_into_prepared_lines('VO', ::[LEGAL_161P].[NEW#AUTO_NEW].P207_VID_OPER(md%id).[CODE]);
				&word.put_into_prepared_lines('VO_NAME', ::[LEGAL_161P].[NEW#AUTO_NEW].P207_VID_OPER(md%id).[NAME]);
				--&word.put_into_prepared_lines('VO_PRIZ', priz_6001(md%id));
				&word.put_into_prepared_lines('VO_PRIZ', '');
				&word.put_into_prepared_lines('VO_DOP', ::[LEGAL_161P].[NEW#AUTO_NEW].P207_VID_OPER_DOP(md%id));
				&word.put_into_prepared_lines('VO_STR'
					,case
						when	md.[ACC_DT].[MAIN_V_ID] like '20202%'
							and md.[ACC_KT].[MAIN_V_ID] like '20202%'
							and md.[VALUTA]<>md.VALUTA_PO
							and (md.[VALUTA].[CUR_SHORT]='RUB' or md.[VALUTA_PO].[CUR_SHORT]='RUB')
						then
							case when md.[ACC_DT].[MAIN_V_ID] like '20202810%' then
								--'Продажа ('||md.[SUM]||' '||md.[VALUTA].[CUR_SHORT]||', '||md.[SUM_PO]||' '||md.[VALUTA_PO].[CUR_SHORT]||' )'
								-- Коды по сторонам сделкм Утверждены 'Елемешина Елена Анатольевна' 28.07.2015
								--'1004: Продажа иностранной валюты физ.лицом' --but поменяла 05.11.2015
								'1003: Покупка иностранной валюты физ.лицом'
							else
								--'Покупка ('||md.[SUM]||' '||md.[VALUTA].[CUR_SHORT]||', '||md.[SUM_PO]||' '||md.[VALUTA_PO].[CUR_SHORT]||' )'
								'1004: Продажа иностранной валюты физ.лицом'
								--'1003: Покупка иностранной валюты физ.лицом'
							end
						when md.[ACC_DT].[MAIN_V_ID] like '20202%'
							and md.[ACC_KT].[MAIN_V_ID] like '20202%'
							and md.[VALUTA]<>md.VALUTA_PO
							and md.[VALUTA].[CUR_SHORT]!='RUB'
							and md.[VALUTA_PO].[CUR_SHORT]!='RUB'
						then
							'1003: Покупка иностранной валюты физ.лицом'
						else
							''
					end
				);
				
				--&word.update_fields;
				
				if Legal_op.[VO].[CODE] = '6001' then
					&word.put_into_prepared_lines('6001_PRIZ', Legal_op.[PRIZ6001]);
					begin
						&word.put_into_prepared_lines('6001_PRIZ_NAME', ' '||substr(::[P161_UNUSFUL_OPE]([CODE] = Legal_op.[PRIZ6001]).[VALUE],1,250) );
						&word.put_into_prepared_lines('6001_PRIZ_NAME2', substr(::[P161_UNUSFUL_OPE]([CODE] = Legal_op.[PRIZ6001]).[VALUE],251,250) );
					exception
						when NO_DATA_FOUND then
							&word.put_into_prepared_lines('6001_PRIZ_NAME', '');
							&word.put_into_prepared_lines('6001_PRIZ_NAME2', '');
					end;
				else
					&word.put_into_prepared_lines('6001_PRIZ', '');
					&word.put_into_prepared_lines('6001_PRIZ_NAME', '');
					&word.put_into_prepared_lines('6001_PRIZ_NAME2', '');
				end if;
				
				&word.put_into_prepared_lines('NUMBER_DATE', '');
				&word.put_into_prepared_lines('FACES', '');
				&word.put_into_prepared_lines('DESCR', '');
				&word.put_into_prepared_lines('DATE_GET', to_char(Legal_op.[DATE_P], 'DD.MM.YYYY'));	--Башкиров В.Г. 27.11.2023
				&word.put_into_prepared_lines('DECISION_SOTR', 'Подлежит сообщению по коду 4014'||chr(11)||to_char(Legal_op.[DATE_P], 'DD.MM.YYYY'));	--Башкиров В.Г. 27.11.2023
				&word.put_into_prepared_lines('DECISION_PP', '');
				
-- v3
				if not Revers then
					null;
				else
					zamena:=V_PRED_PLAT;
					V_PRED_PLAT:=V_PRED_POL;
					V_PRED_POL:=zamena;
					zamena:=V_PRED_PLAT2;
					V_PRED_PLAT2:=V_PRED_POL2;
					V_PRED_POL2:=zamena;
				end if;
				
				if V_PRED_PLAT is not null then
					&word.put_into_prepared_lines('PRED_PLAT_FIO',		'ФИО: '||V_PRED_PLAT.[NAME]);
					&word.put_into_prepared_lines('PRED_PLAT_DR',		'Дата рождения: '||to_char(V_PRED_PLAT.[DATE_PERS],'DD.MM.YYYY'));
					&word.put_into_prepared_lines('PRED_PLAT_MR',		'Место рождения: '||V_PRED_PLAT.[DOC].[BIRTH_PLACE]);
					&word.put_into_prepared_lines('PRED_PLAT_GRAZD',	'Гражданство: '||V_PRED_PLAT.[COUNTRY].[NAME]); --||CHR(13)
					&word.put_into_prepared_lines('PRED_PLAT_DOC_SER',	'Документ, удостоверяющий личность: '||V_PRED_PLAT.[DOC].[TYPE].[NAME]||' Серия: '||V_PRED_PLAT.[DOC].[SER]);
					&word.put_into_prepared_lines('PRED_PLAT_DOC_NOM',	'Номер: '||V_PRED_PLAT.[DOC].[NUM]);
					&word.put_into_prepared_lines('PRED_PLAT_DOC_WHO',	'Кем и когда выдан: '||V_PRED_PLAT.[DOC].[WHO]||','||to_char(V_PRED_PLAT.[DOC].[DATE],'DD.MM.YYYY'));
					&word.put_into_prepared_lines('PRED_PLAT_DOC_KOD',	'Код подразделения: '||V_PRED_PLAT.[DOC].[DEPART_CODE]);
					
					MIGR_CARD:=null;
					
					for MC in V_PRED_PLAT.[MIGR_CARD]
						where
							     MC.[DATE_BEG]<=md.[DATE_DOC]
							and (MC.[DATE_END] is null or MC.[DATE_END]>md.[DATE_DOC])
					loop
						MIGR_CARD:=MC;
					end loop;
					
					if MIGR_CARD is not null then
						&word.put_into_prepared_lines('PRED_PLAT_MIGR_SER','Миграционная карта:'||CHR(13)||'Серия: '||MIGR_CARD.[CARD_SERIA]);
						&word.put_into_prepared_lines('PRED_PLAT_MIGR_NOM','Номер: '||MIGR_CARD.[CARD_NUM]);
						&word.put_into_prepared_lines('PRED_PLAT_MIGR_BEG','Действует с '||MIGR_CARD.[DATE_BEG]);
						&word.put_into_prepared_lines('PRED_PLAT_MIGR_END',' по '||MIGR_CARD.[DATE_END]);
					else
						&word.put_into_prepared_lines('PRED_PLAT_MIGR_SER','');
						&word.put_into_prepared_lines('PRED_PLAT_MIGR_NOM','');
						&word.put_into_prepared_lines('PRED_PLAT_MIGR_BEG','');
						&word.put_into_prepared_lines('PRED_PLAT_MIGR_END','');
					end if;
					
					-- VOROBEY 20200123
					OTHER_DOC :=null;
					
					if OTHER_DOC is null then
						for da in V_PRED_PLAT.[DOC_ARR]
						loop
							OTHER_DOC:=da;
							otherDocString := '';
							-- max length 255 chars (for word.put_into_prepared_lines otherDocString)
							otherDocString :=
								   CHR(11) || 'Тип удостоверения: ' || OTHER_DOC.[TYPE].[NAME]
								|| CHR(11) || 'Выдан: '||OTHER_DOC.[WHO]
								|| CHR(11) || 'Серия: '||OTHER_DOC.[SER]
								|| CHR(11) || 'Номер: '||OTHER_DOC.[NUM]
								|| CHR(11) || 'Дата выдачи: '||to_char(OTHER_DOC.[DATE],dateFormat01)
								|| CHR(11) || 'Действует по: '||to_char(OTHER_DOC.[DATE_END],dateFormat01)
								|| '[' || PLAT_ODOCS || ']'
							;
--							debug_pipe('=== LENGTH === '|| PLAT_ODOCS ||' === ' || LENGTH(otherDocString),0);
--							debug_pipe(PLAT_ODOCS ||' : ' || otherDocString,0);
							&word.put_into_prepared_lines(PLAT_ODOCS,otherDocString);
						end loop;
					end if;
					
					-- Адреса клиента
					Get_Adr_Client(V_PRED_PLAT,PRED_ADR_MASK, PRED_CITY_C ,PRED_ADRESS_C ,PRED_ADRESS_C_POST, PRED_ADRESS_C_FACT ,PRED_OKATO_C);
					&word.put_into_prepared_lines('PRED_PLAT_POST','Место пребывания: '||PRED_ADRESS_C_FACT);
					&word.put_into_prepared_lines('PRED_PLAT_FACT','Адрес места жительства (регистрации): '||PRED_ADRESS_C);
				else
					&word.put_into_prepared_lines('PRED_PLAT_FIO', '');
					&word.put_into_prepared_lines('PRED_PLAT_DR', '');
					&word.put_into_prepared_lines('PRED_PLAT_MR', '');
					&word.put_into_prepared_lines('PRED_PLAT_GRAZD', '');
					&word.put_into_prepared_lines('PRED_PLAT_DOC_SER', '');
					&word.put_into_prepared_lines('PRED_PLAT_DOC_NOM', '');
					&word.put_into_prepared_lines('PRED_PLAT_DOC_WHO', '');
					&word.put_into_prepared_lines('PRED_PLAT_DOC_KOD', '');
					&word.put_into_prepared_lines('PRED_PLAT_MIGR_SER','');
					&word.put_into_prepared_lines('PRED_PLAT_MIGR_NOM','');
					&word.put_into_prepared_lines('PRED_PLAT_MIGR_BEG','');
					&word.put_into_prepared_lines('PRED_PLAT_MIGR_END','');
					&word.put_into_prepared_lines('PRED_PLAT_POST','');
					&word.put_into_prepared_lines('PRED_PLAT_FACT','');
				end if;
				&word.put_into_prepared_lines(PLAT_ODOCS,'');
				
				if V_PRED_PLAT2 is not null then
					&word.put_into_prepared_lines('PRED_PLAT2_FIO',		'ФИО: '||V_PRED_PLAT2.[NAME]);
					&word.put_into_prepared_lines('PRED_PLAT2_DR',		'Дата рождения: '||to_char(V_PRED_PLAT2.[DATE_PERS],'DD.MM.YYYY'));
					&word.put_into_prepared_lines('PRED_PLAT2_MR',		'Место рождения: '||V_PRED_PLAT2.[DOC].[BIRTH_PLACE]);
					&word.put_into_prepared_lines('PRED_PLAT2_GRAZD',	'Гражданство: '||V_PRED_PLAT2.[COUNTRY].[NAME]); --||CHR(13)
					&word.put_into_prepared_lines('PRED_PLAT2_DOC_SER',	'Документ, удостоверяющий личность: '||V_PRED_PLAT2.[DOC].[TYPE].[NAME]||' Серия: '||V_PRED_PLAT2.[DOC].[SER]);
					&word.put_into_prepared_lines('PRED_PLAT2_DOC_NOM',	'Номер: '||V_PRED_PLAT2.[DOC].[NUM]);
					&word.put_into_prepared_lines('PRED_PLAT2_DOC_WHO',	'Кем и когда выдан: '||V_PRED_PLAT2.[DOC].[WHO]||','||to_char(V_PRED_PLAT2.[DOC].[DATE],'DD.MM.YYYY'));
					&word.put_into_prepared_lines('PRED_PLAT2_DOC_KOD',	'Код подразделения: '||V_PRED_PLAT2.[DOC].[DEPART_CODE]);
					
					MIGR_CARD:=null;
					
					for MC in V_PRED_PLAT2.[MIGR_CARD] where  MC.[DATE_BEG]<=md.[DATE_DOC] and (MC.[DATE_END] is null or MC.[DATE_END]>md.[DATE_DOC])
					loop
						MIGR_CARD:=MC;
					end loop;
					
					if MIGR_CARD is not null then
						&word.put_into_prepared_lines('PRED_PLAT2_MIGR_SER','Миграционная карта:'||CHR(13)||'Серия: '||MIGR_CARD.[CARD_SERIA]);
						&word.put_into_prepared_lines('PRED_PLAT2_MIGR_NOM','Номер: '||MIGR_CARD.[CARD_NUM]);
						&word.put_into_prepared_lines('PRED_PLAT2_MIGR_BEG','Действует с '||MIGR_CARD.[DATE_BEG]);
						&word.put_into_prepared_lines('PRED_PLAT2_MIGR_END',' по '||MIGR_CARD.[DATE_END]);
					else
						&word.put_into_prepared_lines('PRED_PLAT2_MIGR_SER','');
						&word.put_into_prepared_lines('PRED_PLAT2_MIGR_NOM','');
						&word.put_into_prepared_lines('PRED_PLAT2_MIGR_BEG','');
						&word.put_into_prepared_lines('PRED_PLAT2_MIGR_END','');
					end if;
					
					-- VOROBEY 20200123
					OTHER_DOC :=null;
					
					if OTHER_DOC is null then
						for da in V_PRED_PLAT2.[DOC_ARR]
						loop
							OTHER_DOC:=da;
							otherDocString := '';
							-- max length 255 chars (for word.put_into_prepared_lines otherDocString)
							otherDocString :=
								              'Тип удостоверения: ' || OTHER_DOC.[TYPE].[NAME]
								|| CHR(13) || 'Серия: '||OTHER_DOC.[SER]
								|| CHR(13) || 'Номер: '||OTHER_DOC.[NUM]
								|| CHR(13) || 'Дата выдачи: '||to_char(OTHER_DOC.[DATE],dateFormat01)
								|| CHR(13) || 'Действует по: '||to_char(OTHER_DOC.[DATE_END],dateFormat01)
								|| CHR(13) || '[' || PLAT_ODOCS2 || ']'
							;
--							debug_pipe('=== LENGTH === '|| PLAT_ODOCS2 ||' === ' || LENGTH(otherDocString),0);
--							debug_pipe(PLAT_ODOCS2 ||' : ' || otherDocString,0);
							&word.put_into_prepared_lines(PLAT_ODOCS2,otherDocString);
						end loop;
					end if;
					
					-- Адреса клиента
					Get_Adr_Client(V_PRED_PLAT2,PRED_ADR_MASK, PRED_CITY_C ,PRED_ADRESS_C ,PRED_ADRESS_C_POST, PRED_ADRESS_C_FACT ,PRED_OKATO_C);
					&word.put_into_prepared_lines('PRED_PLAT2_POST','Место пребывания: '||PRED_ADRESS_C_FACT);
					&word.put_into_prepared_lines('PRED_PLAT2_FACT','Адрес места жительства (регистрации): '||PRED_ADRESS_C);
				else
					&word.put_into_prepared_lines('PRED_PLAT2_FIO', '');
					&word.put_into_prepared_lines('PRED_PLAT2_DR', '');
					&word.put_into_prepared_lines('PRED_PLAT2_MR', '');
					&word.put_into_prepared_lines('PRED_PLAT2_GRAZD', '');
					&word.put_into_prepared_lines('PRED_PLAT2_DOC_SER', '');
					&word.put_into_prepared_lines('PRED_PLAT2_DOC_NOM', '');
					&word.put_into_prepared_lines('PRED_PLAT2_DOC_WHO', '');
					&word.put_into_prepared_lines('PRED_PLAT2_DOC_KOD', '');
					&word.put_into_prepared_lines('PRED_PLAT2_MIGR_SER','');
					&word.put_into_prepared_lines('PRED_PLAT2_MIGR_NOM','');
					&word.put_into_prepared_lines('PRED_PLAT2_MIGR_BEG','');
					&word.put_into_prepared_lines('PRED_PLAT2_MIGR_END','');
					&word.put_into_prepared_lines('PRED_PLAT2_POST','');
					&word.put_into_prepared_lines('PRED_PLAT2_FACT','');
				end if;
				&word.put_into_prepared_lines(PLAT_ODOCS2,'');
				
				if V_PRED_POL is not null then
					&word.put_into_prepared_lines('PRED_POL_FIO',		'ФИО: '||V_PRED_POL.[NAME]);
					&word.put_into_prepared_lines('PRED_POL_DR',		'Дата рождения: '||to_char(V_PRED_POL.[DATE_PERS],'DD.MM.YYYY'));
					&word.put_into_prepared_lines('PRED_POL_MR',		'Место рождения: '||V_PRED_POL.[DOC].[BIRTH_PLACE]);
					&word.put_into_prepared_lines('PRED_POL_GRAZD',		'Гражданство: '||V_PRED_POL.[COUNTRY].[NAME]); --||CHR(13)
					&word.put_into_prepared_lines('PRED_POL_DOC_SER',	'Документ, удостоверяющий личность: '||V_PRED_POL.[DOC].[TYPE].[NAME]||' Серия: '||V_PRED_POL.[DOC].[SER]);
					&word.put_into_prepared_lines('PRED_POL_DOC_NOM',	'Номер: '||V_PRED_POL.[DOC].[NUM]);
					&word.put_into_prepared_lines('PRED_POL_DOC_WHO',	'Кем и когда выдан: '||V_PRED_POL.[DOC].[WHO]||','||to_char(V_PRED_POL.[DOC].[DATE],'DD.MM.YYYY'));
					&word.put_into_prepared_lines('PRED_POL_DOC_KOD',	'Код подразделения: '||V_PRED_POL.[DOC].[DEPART_CODE]);
					
					MIGR_CARD:=null;
					
					for MC in V_PRED_POL.[MIGR_CARD]
						where
							     MC.[DATE_BEG]<=md.[DATE_DOC]
							and (MC.[DATE_END] is null or MC.[DATE_END]>md.[DATE_DOC])
					loop
						MIGR_CARD:=MC;
					end loop;
					
					if MIGR_CARD is not null then
						&word.put_into_prepared_lines('PRED_POL_MIGR_SER','Миграционная карта:'||CHR(13)||'Серия: '||MIGR_CARD.[CARD_SERIA]);
						&word.put_into_prepared_lines('PRED_POL_MIGR_NOM','Номер: '||MIGR_CARD.[CARD_NUM]);
						&word.put_into_prepared_lines('PRED_POL_MIGR_BEG','Действует с '||MIGR_CARD.[DATE_BEG]);
						&word.put_into_prepared_lines('PRED_POL_MIGR_END',' по '||MIGR_CARD.[DATE_END]);
					else
						&word.put_into_prepared_lines('PRED_POL_MIGR_SER','');
						&word.put_into_prepared_lines('PRED_POL_MIGR_NOM','');
						&word.put_into_prepared_lines('PRED_POL_MIGR_BEG','');
						&word.put_into_prepared_lines('PRED_POL_MIGR_END','');
					end if;
					
					
					-- VOROBEY 20200123
					OTHER_DOC :=null;
					
						if OTHER_DOC is null then
							for da in V_PRED_POL.[DOC_ARR]
						loop
							OTHER_DOC:=da;
							otherDocString := '';
							-- max length 255 chars (for word.put_into_prepared_lines otherDocString)
							otherDocString :=
								              'Тип удостоверения: ' || OTHER_DOC.[TYPE].[NAME]
								|| CHR(13) || 'Серия: '||OTHER_DOC.[SER]
								|| CHR(13) || 'Номер: '||OTHER_DOC.[NUM]
								|| CHR(13) || 'Дата выдачи: '||to_char(OTHER_DOC.[DATE],dateFormat01)
								|| CHR(13) || 'Действует по: '||to_char(OTHER_DOC.[DATE_END],dateFormat01)
								|| CHR(13) || '[' || POL_ODOCS || ']'
							;
--							debug_pipe('=== LENGTH === '|| POL_ODOCS ||' === ' || LENGTH(otherDocString),0);
--							debug_pipe(POL_ODOCS ||' : ' || otherDocString,0);
							&word.put_into_prepared_lines(POL_ODOCS,otherDocString);
						end loop;
					end if;
					
					-- Адреса клиента
					Get_Adr_Client(V_PRED_POL,PRED_ADR_MASK, PRED_CITY_C ,PRED_ADRESS_C ,PRED_ADRESS_C_POST, PRED_ADRESS_C_FACT ,PRED_OKATO_C);
					&word.put_into_prepared_lines('PRED_POL_POST','Место пребывания: '||PRED_ADRESS_C_FACT);
					&word.put_into_prepared_lines('PRED_POL_FACT','Адрес места жительства (регистрации): '||PRED_ADRESS_C);
				else
					&word.put_into_prepared_lines('PRED_POL_FIO', '');
					&word.put_into_prepared_lines('PRED_POL_DR', '');
					&word.put_into_prepared_lines('PRED_POL_MR', '');
					&word.put_into_prepared_lines('PRED_POL_GRAZD', '');
					&word.put_into_prepared_lines('PRED_POL_DOC_SER', '');
					&word.put_into_prepared_lines('PRED_POL_DOC_NOM', '');
					&word.put_into_prepared_lines('PRED_POL_DOC_WHO', '');
					&word.put_into_prepared_lines('PRED_POL_DOC_KOD', '');
					&word.put_into_prepared_lines('PRED_POL_MIGR_SER','');
					&word.put_into_prepared_lines('PRED_POL_MIGR_NOM','');
					&word.put_into_prepared_lines('PRED_POL_MIGR_BEG','');
					&word.put_into_prepared_lines('PRED_POL_MIGR_END','');
					&word.put_into_prepared_lines('PRED_POL_POST','');
					&word.put_into_prepared_lines('PRED_POL_FACT','');
				end if;
				&word.put_into_prepared_lines(POL_ODOCS,'');
				
				if V_PRED_POL2 is not null then
					&word.put_into_prepared_lines('PRED_POL2_FIO',		'ФИО: '||V_PRED_POL2.[NAME]);
					&word.put_into_prepared_lines('PRED_POL2_DR',		'Дата рождения: '||to_char(V_PRED_POL2.[DATE_PERS],'DD.MM.YYYY'));
					&word.put_into_prepared_lines('PRED_POL2_MR',		'Место рождения: '||V_PRED_POL2.[DOC].[BIRTH_PLACE]);
					&word.put_into_prepared_lines('PRED_POL2_GRAZD',	'Гражданство: '||V_PRED_POL2.[COUNTRY].[NAME]); --||CHR(13)
					&word.put_into_prepared_lines('PRED_POL2_DOC_SER',	'Документ, удостоверяющий личность: '||V_PRED_POL2.[DOC].[TYPE].[NAME]||' Серия: '||V_PRED_POL2.[DOC].[SER]);
					&word.put_into_prepared_lines('PRED_POL2_DOC_NOM',	'Номер: '||V_PRED_POL2.[DOC].[NUM]);
					&word.put_into_prepared_lines('PRED_POL2_DOC_WHO',	'Кем и когда выдан: '||V_PRED_POL2.[DOC].[WHO]||','||to_char(V_PRED_POL2.[DOC].[DATE],'DD.MM.YYYY'));
					&word.put_into_prepared_lines('PRED_POL2_DOC_KOD',	'Код подразделения: '||V_PRED_POL2.[DOC].[DEPART_CODE]);
					
					MIGR_CARD:=null;
					
					for MC in V_PRED_POL2.[MIGR_CARD] where  MC.[DATE_BEG]<=md.[DATE_DOC] and (MC.[DATE_END] is null or MC.[DATE_END]>md.[DATE_DOC])
					loop
						MIGR_CARD:=MC;
					end loop;
					
					if MIGR_CARD is not null then
						&word.put_into_prepared_lines('PRED_POL2_MIGR_SER','Миграционная карта:'||CHR(13)||'Серия: '||MIGR_CARD.[CARD_SERIA]);
						&word.put_into_prepared_lines('PRED_POL2_MIGR_NOM','Номер: '||MIGR_CARD.[CARD_NUM]);
						&word.put_into_prepared_lines('PRED_POL2_MIGR_BEG','Действует с '||MIGR_CARD.[DATE_BEG]);
						&word.put_into_prepared_lines('PRED_POL2_MIGR_END',' по '||MIGR_CARD.[DATE_END]);
					else
						&word.put_into_prepared_lines('PRED_POL2_MIGR_SER','');
						&word.put_into_prepared_lines('PRED_POL2_MIGR_NOM','');
						&word.put_into_prepared_lines('PRED_POL2_MIGR_BEG','');
						&word.put_into_prepared_lines('PRED_POL2_MIGR_END','');
					end if;
					
					-- VOROBEY 20200123
					OTHER_DOC :=null;
					
					if OTHER_DOC is null then
						for da in V_PRED_POL2.[DOC_ARR]
						loop
							OTHER_DOC:=da;
							otherDocString := '';
							-- max length 255 chars (for word.put_into_prepared_lines otherDocString)
							otherDocString :=
								              'Тип удостоверения: ' || OTHER_DOC.[TYPE].[NAME]
								|| CHR(13) || 'Серия: '||OTHER_DOC.[SER]
								|| CHR(13) || 'Номер: '||OTHER_DOC.[NUM]
								|| CHR(13) || 'Дата выдачи: '||to_char(OTHER_DOC.[DATE],dateFormat01)
								|| CHR(13) || 'Действует по: '||to_char(OTHER_DOC.[DATE_END],dateFormat01)
								|| CHR(13) || '[' || POL_ODOCS2 || ']'
							;
--							debug_pipe('=== LENGTH === '|| POL_ODOCS2 ||' === ' || LENGTH(otherDocString),0);
--							debug_pipe(POL_ODOCS2 ||' : ' || otherDocString,0);
							&word.put_into_prepared_lines(POL_ODOCS2,otherDocString);
						end loop;
					end if;
					
					-- Адреса клиента
					Get_Adr_Client(V_PRED_POL2,PRED_ADR_MASK, PRED_CITY_C ,PRED_ADRESS_C ,PRED_ADRESS_C_POST, PRED_ADRESS_C_FACT ,PRED_OKATO_C);
					&word.put_into_prepared_lines('PRED_POL2_POST','Место пребывания: '||PRED_ADRESS_C_FACT);
					&word.put_into_prepared_lines('PRED_POL2_FACT','Адрес места жительства (регистрации): '||PRED_ADRESS_C);
				else
					&word.put_into_prepared_lines('PRED_POL2_FIO', '');
					&word.put_into_prepared_lines('PRED_POL2_DR', '');
					&word.put_into_prepared_lines('PRED_POL2_MR', '');
					&word.put_into_prepared_lines('PRED_POL2_GRAZD', '');
					&word.put_into_prepared_lines('PRED_POL2_DOC_SER', '');
					&word.put_into_prepared_lines('PRED_POL2_DOC_NOM', '');
					&word.put_into_prepared_lines('PRED_POL2_DOC_WHO', '');
					&word.put_into_prepared_lines('PRED_POL2_DOC_KOD', '');
					&word.put_into_prepared_lines('PRED_POL2_MIGR_SER','');
					&word.put_into_prepared_lines('PRED_POL2_MIGR_NOM','');
					&word.put_into_prepared_lines('PRED_POL2_MIGR_BEG','');
					&word.put_into_prepared_lines('PRED_POL2_MIGR_END','');
					&word.put_into_prepared_lines('PRED_POL2_POST','');
					&word.put_into_prepared_lines('PRED_POL2_FACT','');
				end if;
				&word.put_into_prepared_lines(POL_ODOCS2,'');
				
				&word.visible;
				&word.exec_script(V_DATA);
				&word.release;
				
			else
				&word.exec_script(V_DATA);
			end if; -- &word.f_click
		elsif P_INFO = 'P_USER' then
			P_POST	:= P_USER.[CASTA];
		end if; -- P_INFO
	end if; -- P_MESSAGE
end;


