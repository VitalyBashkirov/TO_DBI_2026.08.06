class REPS_TUNING;

@check_type_compatibility(false)
@import_plsql(true)
@query(unique_result:=false)
@this(plsql_lock:=false)
@name('[ПСБ] Изменить 1')
@tag('COPIED')
method PSH_AUTO_EDIT_1 is

@name('ID текущего экземпляра')        public V_THIS_ID           [NUMBER];
@name('Профиль поддерживает новый УИ') public V_NEW_UI_COMPATIBLE [STRING_1];
rProf ref [REPS_PROF_TUN];
PSH_AUTO_EDIT_1 return [STRING] is

validate is
begin
	if P_MESSAGE = 'DEFAULT' then
		V_THIS_ID := this%id;

	elsif P_MESSAGE = 'VALIDATE' then
		-- Проверка профиля на совместимость с новым УИ
		if P_INFO = 'CHECK_NEW_UI_COMP' then
			-- Профиль однозначно определим с экземпляра
			rProf := this.prof;

			-- По умолчанию не совместим с новым интерфейсом
			V_NEW_UI_COMPATIBLE := '0';

			-- то читаем признак совместимости
			V_NEW_UI_COMPATIBLE := nvl([STR].Get_Str_Par(rProf.[INFO], 'NEW_UI_COMPATIBLE'), '0');
		end if;
	end if;
end;
end;
end;
