class REPS_PROF_TUN;

@name('[ПСБ] Изменить "Отчет" (служебная)')
method PSH_EDIT_REP is
PSH_EDIT_REP (
	@name('Отчет') P_REP in [REPS_REF]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_REP := this.[REP];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	this.[REP]:=P_REP;
end;
end;
end;
