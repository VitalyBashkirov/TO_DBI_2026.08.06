-- ============================================================================
-- Правило: v5.STYLE.WRONG_CLASS_SYNTAX.п.4.12
-- Описание: Обращение к классу должно быть в формате ::[CLASS_NAME]
-- Категория: STYLE
-- Приоритет: high
-- Теги: class, syntax, namespace
-- 3.RUBRICATOR_FIXES.md: Обращение к классу должно быть в формате ::[CLASS_NAME]
-- 4.RUBRICATOR_PROMPTS.json:
--   documentation_text: Все обращения к классам должны использовать синтаксис ::[CLASS_NAME].
--   plplus_materials_note: Это стандартный синтаксис PL+ для работы с классами.
--   search_prompt: Найти обращения к классам без ::[].
--   code_example_bad: REF [SOME_CLASS];
--   code_example_bad2: [SOME_CLASS]%class;
--   fix_instruction: Добавить :: перед именем класса.
-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_WRONG_CLASS_p_4_12 IS
    v_ref REF [CLIENT];
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.WRONG_CLASS_SYNTAX.п.4.12 Обращение к классу должно быть в формате ::[CLASS_NAME] =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- v_ref := REF [CLIENT];
        -- IF v_ref%class = [CLIENT]%class THEN ...
        
        -- [+] ПРАВИЛЬНО
        v_ref := REF ::[CLIENT];
        IF v_ref%class = ::[CLIENT]%class THEN ...
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;

-- ============================================================================
-- Правило: v5.STYLE.WRONG_ATTR_SYNTAX.п.4.13
-- Описание: Обращение к реквизиту должно быть в формате [ATTRIBUTE_NAME]
-- Категория: STYLE
-- Приоритет: high
