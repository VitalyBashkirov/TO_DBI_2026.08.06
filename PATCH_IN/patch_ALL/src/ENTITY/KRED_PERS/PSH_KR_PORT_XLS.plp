					[EXCEL].Write(i,10,to_char(cr.FROMDATE,'DD.MM.YYYY'));
					[EXCEL].Write(i,11,to_char(cr.TODATE,'DD.MM.YYYY'));
					[EXCEL].Write(i,12,cr.SROK);
					[EXCEL].Set_Number_Format(i,13,i,13,2);
					[EXCEL].Write(i,13,cr.PRC_START,false,false,10,'Times New Roman','RT');
					[EXCEL].Set_Number_Format(i,14,i,14,2);
					[EXCEL].Write(i,14,cr.PRC_NOW,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,15,cr.VAL_CODE);
					[EXCEL].Set_Number_Format(i,16,i,16,2);
					[EXCEL].Write(i,16,cr.DEA_SDOK,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,17,cr.PROL);
					[EXCEL].Write(i,18,cr.DEA_RISK);
					[EXCEL].Write(i,19,cr.HD_RISK);
