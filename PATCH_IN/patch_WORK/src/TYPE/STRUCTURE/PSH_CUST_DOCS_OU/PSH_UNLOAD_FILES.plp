class PSH_CUST_DOCS_OU;

@import_plsql(true)
@name('[ПСБ] 6.Выгрузить файлы')
@tag('COPIED')
static method PSH_UNLOAD_FILES is
pragma include(::[RUNTIME].[MACRO_LIB]);
pragma include(::[PSH_CUST_DOCS].[PSH_LIB_TC]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25

pragma macro(lib, '::[PSH_CUST_DOCS].[PSH_LIB]', substitute); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25

type Q_Docs is
	select	x(x)
	in 		::[PSH_CUST_DOCS] all -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
	where	x%class = ::[PSH_CUST_DOCS_OU]%class -- updated CHANGE_QUALIFIER PSB_CUST_DOCS_OU->PSH_CUST_DOCS_OU 08/10/25
			and x.[DOC_STATE] = &libtc.stNEW;

type ref_QDocs is ref cursor return Q_Docs;
type TDocs is table of ref [PSH_CUST_DOCS_OU]; -- updated CHANGE_QUALIFIER PSB_CUST_DOCS_OU->PSH_CUST_DOCS_OU 08/10/25
PSH_UNLOAD_FILES is

execute is

v_cur 		ref_QDocs;
v_tab_docs	TDocs;
v_lockId	pls_integer;
begin
	v_lockId := &lib.setLock(&METHOD$ID);

	v_cur.open(Q_Docs);
	loop
		v_cur.fetch_limit(100, v_tab_docs);			
		
		exit when v_tab_docs.count = 0;
		
		v_tab_docs.[PSH_UNLOAD_FILE]();
		
		v_tab_docs.delete;
		
		exit when v_cur.notfound;
	end loop;
	v_cur.close;

	&lib.delLock(v_lockId);
exception
	when others then
		&lib.delLock(v_lockId);	
		raise;
end;
end;
end;
