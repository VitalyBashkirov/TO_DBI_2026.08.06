class DECLARE;

@import_plsql(true)
@name('[ПСБ] Заявление на перечисление (БОС)')
@tag('COPIED')
method PSH_ZAYA_PER_BOS is

@name('V_DEST') public V_DEST [STRING_32000];

PSH_ZAYA_PER_BOS (
	@name('Клиент')         P_KLI      in [CL_PRIV_REF],
	@name('Работник банка') P_RAB_BANK in [USER_REF]
) is

validate is
i 			number;
vColCount 	number; -- колво колонок в отчете
vFileName 	varchar2(250); -- имя Excel-шаблона
--users ref [USER];
-- Шаблон адреса
V_ADR_MASK		varchar2(100):='ALL';
City			ref [NAMES_CITY];
Addres			[STRING_250];
AddresPost		[STRING_250];
Okato			[STRING_20];
komiss number;

begin

  if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
		[EXCEL].Init_Xls;
		P_KLI:=this.[SENDER_REQ].[CLIENTREF];
		P_RAB_BANK := ::[RUNTIME].[STDLIB].UserId;
							
  elsif P_MESSAGE = 'VALIDATE' then -- переход между полями

		if p_info = 'OK' then
			
			vFileName := 'PSH_Заявление на перечисление(БОС).xlsx';
  			  			  	
			if [EXCEL].F_Click then
				[EXCEL].F_Click := False;

				vColCount := 7; -- всего колонок в отчете
				i := 9; -- первая строка в Excel
				
				-- обнуляем переменные

				-- запуск Excel
				[EXCEL].open_file(::[REPS].[SLIB].GetPath('PATH_PRINT_EXCEL', vFileName),false);
				
				-- цикл по договорам
				
[DEPN_INTERFACE]::[PRX_DEPN_TO_CRED].Get_Adr_Client
						(P_KLI
						,V_ADR_MASK
						,City
						,Addres
						,AddresPost
						,Okato);				

				[EXCEL].Write(4, 2,  ::[RUNTIME].[TMC_REPORTS].formatDate(this.[DOCUMENT_DATE]));
				
				if nvl(P_KLI,0)>0 then
				[EXCEL].Write(8, 1,  Addres);
				[EXCEL].Write(11, 1,  P_KLI.[DOC].[TYPE].[FULL_NAME]||','|| P_KLI.[DOC].[SER]||','||P_KLI.[DOC].[NUM]||', выдан '||to_char(P_KLI.[DOC].[DATE],'DD.MM.YYYY')||','||P_KLI.[DOC].[WHO]||', код подр. '||P_KLI.[DOC].[DEPART_CODE]);
				[EXCEL].Write(13, 2,  P_KLI.[NAME]);
				else
				[EXCEL].Write(8, 1,  this.[SENDER_REQ].[ADDR]);
				[EXCEL].Write(11, 1,  this.[SENDER_REQ].[PASSPORT]||','|| this.[SENDER_REQ].[SERIA]||','||this.[SENDER_REQ].[NUMBER]||', выдан '||to_char(this.[SENDER_REQ].[DATE_V],'DD.MM.YYYY')||','||this.[SENDER_REQ].[WHO_V]||', код подр. '||this.[SENDER_REQ].[DEPART_CODE]);
				[EXCEL].Write(13, 2,  this.[SENDER_REQ].[NAME]);
				end if;
				--[EXCEL].Write(15, 7,  this.[ACC_DT].[MAIN_V_ID]);
				[EXCEL].Write(17, 3,  to_char(this.[AMOUNT],'999G999G999D99'));
				[EXCEL].Write(18, 3,  ::[RUNTIME].[STDLIB].N2Str(this.[AMOUNT],'!'||this.[CURRENCY]));
				if this.[RECEIVER_CLS].[0]=2
				then
				[EXCEL].Write(21, 4,  this.[RECEIVER_OUT_REQ].[2]);
				[EXCEL].Write(22, 4,  this.[RECEIVER_OUT_REQ].[INN]);
				[EXCEL].Write(23, 4,  this.[RECEIVER_OUT_REQ].[1]);
				[EXCEL].Write(24, 4,  this.[RECEIVER_OUT_REQ].[3].[NAME]);
				[EXCEL].Write(25, 4,  this.[RECEIVER_OUT_REQ].[3].[KS]);
				[EXCEL].Write(26, 4,  this.[RECEIVER_OUT_REQ].[3].[BIC]);
				
				 komiss:=trunc((this.[AMOUNT]*::[DOCUMENT].[LIB_CUR].Get_rate(this.[CURRENCY],this.[DOCUMENT_DATE])*0.01),2);
					if komiss<60 then komiss:=60;
					elsif komiss>1500 then komiss:=1500;
					end if;
					[EXCEL].Write(34, 4,  to_char(komiss,'999G999G999D99'));
					[EXCEL].Write(36, 1,  ::[RUNTIME].[STDLIB].N2Str(komiss,'RUB'));
				else
					[EXCEL].Write(21, 4,  this.[RECEIVER_INP_REQ].[1].[NAME]);
					[EXCEL].Write(22, 4,  this.[RECEIVER_INP_REQ].[1].[INN]);
					[EXCEL].Write(23, 4,  this.[RECEIVER_INP_REQ].[2].[MAIN_V_ID]);
					[EXCEL].Write(24, 4,  this.[RECEIVER_INP_REQ].[2].[FILIAL].[BANK].[NAME]);
					[EXCEL].Write(25, 4,  this.[RECEIVER_INP_REQ].[2].[FILIAL].[BANK].[KS]);
					[EXCEL].Write(26, 4,  this.[RECEIVER_INP_REQ].[2].[FILIAL].[BANK].[BIC]);
					komiss:=30;
					[EXCEL].Write(34, 4,  to_char(komiss,'999G999G999D99'));
					[EXCEL].Write(36, 1,  ::[RUNTIME].[STDLIB].N2Str(komiss,'RUB'));
				end if;
				[EXCEL].Write(28, 1,  this.[COMMENT]);
				
				[EXCEL].Write(44, 2,  to_char(this.[DOCUMENT_DATE],'DD.MM.YYYY'));
				[EXCEL].Write(45, 4,  ::[RUNTIME].[STDLIB].FIO(P_RAB_BANK.[NAME]));
								
				[EXCEL].Visible;
				[EXCEL].Release;
			end if;
			
			[EXCEL].Exec_Script(V_DEST);	
		end if;	
  end if;
end;
end;
end;
