-- приход с Prc
public function UR_AccSUMPri_NDSPrc(p_acc ref [AC_FIN], p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is 
sm number(18,2);
begin
		sm := nvl(::[RUNTIME].[F_5].A('И'||p_acc||'КВ', p_d_beg, p_d_end),0);	
		if sm > 0 then
		
			return UR_AccSUMPri_NDS(p_acc, p_d_beg, p_d_end)/sm*100;
		else
			return 0;
		end if;
end;


-- списание без НДС (за минусом налогов и ЗП)
public function UR_AccSUMRas_NDSPRC(p_acc ref [AC_FIN], p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is 
sm number(18,2);
smdbt number(18,2);
begin
	smdbt := nvl(::[RUNTIME].[F_5].A('И'||p_acc||'КВ', p_d_beg, p_d_end),0);	
	if smdbt >0 then	
		sm := 0;	
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_DT] = p_acc
									and not (
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,5) =	'40101' ))
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) 	 =	'40101' ))
									)
		loop
			if	checkNaznPlat_NDS(md.[NAZN] ) then
				sm := sm + md.[SUM_NT];
			end if;
		end loop;
		return sm/smdbt*100;
		
	else
		return 0;
	end if;
end;

-- списание без НДС (за минусом налогов и ЗП)
public function UR_AccSUMRas_noNDSPRC(p_acc ref [AC_FIN], p_INN string,  p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is 
sm number(18,2);
smdbt number(18,2);
begin
	smdbt := nvl(::[RUNTIME].[F_5].A('И'||p_acc||'КВ', p_d_beg, p_d_end),0);	
	if smdbt >0 then	
		sm := 0;	
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_DT] = p_acc
									and not (
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,5) =	'40101' ))
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) 	 =	'40101' ))
									)
					--,	decode(md.[KL_KT].[0],1,md.[KL_KT].[1].[1].[INN],2,md.[KL_KT].[2].[INN]) : C_INN
									and (
											(md.[KL_KT].[0] = 1 and (md.[KL_KT].[1].[1].[INN] =	p_inn ))
											or
											(md.[KL_KT].[0] = 2 and (md.[KL_KT].[2].[INN] 	 =	p_inn ))
									)
									and ((	md.[KL_KT].[0] = 1
										AND ( 	SUBSTR(md.[KL_KT].[1].[2].[MAIN_V_ID],1,5) IN ('40701', '40702', '40703', '40802', '40804', '40805', '40806', '40807', '30232')
											OR	SUBSTR(md.[KL_KT].[1].[2].[MAIN_V_ID],1,3) IN ('423', '426') 				
											)
										)
										OR
										( md.[KL_KT].[0] = 2
										AND ( 	SUBSTR(md.[KL_KT].[2].[1],1,5) IN ('40701', '40702', '40703', '40802', '40804', '40805', '40806', '40807', '30232')
											OR	SUBSTR(md.[KL_KT].[2].[1],1,3) IN ('423', '426') 				
				)			
			)
		)
									
		loop
			if	checkNaznPlat_NONDS(md.[NAZN] ) then
			--if	checkNaznPlat_NDS(md.[NAZN] ) then
				sm := sm + md.[SUM_NT];
			end if;
		end loop;
		--return sm/smdbt*100;
		return sm;
		
	else
		return 0;
	end if;
end;



-- проверка кода УФМС
--function isCheckCodeUFMS(p_client ref [CLIENT]) return boolean
-- проверка кода УФМС
--function isCheckCodeUFMS(p_client ref [CLIENT]) return boolean;
public function isCheckCodeUFMS(p_client ref [CLIENT]) return string(4000) is 
prv ref [CL_PRIV];
skd string;
b boolean;
--kl string(4000);
kl string(4000);
begin
	if p_client%class = 'CL_PRIV' then
		prv := p_client;--->()	
		--debug_pipe(prv.[DOC].[DEPART_CODE],0);
		if length(trim(prv.[DOC].[DEPART_CODE])) = 7 then
			skd := trim(prv.[DOC].[DEPART_CODE]);
			b := false;
			kl := '';
			for kd in [PSH_PS_UFMS] WHERE kd.[CODE] = skd
			loop		
				B := TRUE;	
				kl := kl ||'-->'||trim(kd.[WHO])||LF$;
				if upper(trim(kd.[WHO])) = upper(trim(prv.[DOC].[WHO])) then
					return 'OK';
				end if;
			end loop;
			if b then
				return 'ERROR-Название не совпало. Возможны варианты:'||LF$||kl;
			else
				return 'ERROR-не найден код подразделения ';
			end if;
		else
			debug_pipe('Err->'||prv.[DOC].[DEPART_CODE],0);
			return 'ERROR-длина не равна 7';
		end if;
	else
		return 'ERROR-ORG';
	end if;
end;


