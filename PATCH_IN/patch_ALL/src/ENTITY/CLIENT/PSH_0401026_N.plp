-- проверка на отсутствие дубликатов ФИО в таблице подписывающих лиц
function CheckForUniqueName (p_name string (250), p_sign_tbl  V_SIGN_FIRST%type)
return boolean
is
tbl_idx number;
begin
	tbl_idx := p_sign_tbl.first;
	while tbl_idx is not null
	loop
		if p_sign_tbl(tbl_idx).[FIELD_1] = p_name then
			return false;
		end if;
		tbl_idx := p_sign_tbl.next(tbl_idx);			
	end loop;
	
	return true;
end;

-- проверка подписывающих лиц, указанных на ЭФ
procedure ValidateSignTables is
	SignFirstTbl_tmp    V_SIGN_FIRST%type;
	idx number;
	tmp_idx number;
begin
	-- удалим пустые записи
	idx := V_SIGN_FIRST.first;
	while idx is not null
	loop
		if V_SIGN_FIRST(idx).[FIELD_1] is not null then
			tmp_idx := SignFirstTbl_tmp.count + 1;
			SignFirstTbl_tmp(tmp_idx).[FIELD_1] := V_SIGN_FIRST(idx).[FIELD_1];
			SignFirstTbl_tmp(tmp_idx).[FIELD_2] := to_char(V_SIGN_FIRST(idx).[DATE_1], 'dd.mm.yyyy');  	
		end if;
		idx := V_SIGN_FIRST.next(idx);
	end loop;

	V_SIGN_FIRST := SignFirstTbl_tmp;
	SignFirstTbl_tmp.delete;

end;

-- автозаполнение списка подписывающих лиц при запуске операции
procedure FillSigns(pOrg ref [CL_CORP]) is
idx number;
begin
	V_SIGN_FIRST.delete;
	
	-- руководители и главный бухгалтер с признаком "Подписывает сегодня"
	for x in pOrg.[ALL_BOSS]
		where 	x.[SIGN_TODAY]
			and (x.[CHIEF] or x.[GENERAL_ACC])
			and (nvl(x.[WORK_END], OpDate) >= OpDate)
	loop
		idx := V_SIGN_FIRST.count + 1;
		V_SIGN_FIRST(idx).[FIELD_1] := x.[FASE].[NAME];
	end loop;
	
end;

--подготовка к печати (определение значений параметров/переменных). Использовать при вызове без поднятия формы
public procedure prepare(P_THIS ref [CLIENT], P_ON_DATE in out date) is
	clp	ref [CL_PRIV];
	idx integer;
	v_chp_type	integer;
	v_address	ref [PERSONAL_ADDRESS];
	clpDatePers	::[CL_PRIV].[DATE_PERS];
	clpName		[CL_PRIV].[DOC].[TYPE].[NAME];
	clpSer		[CL_PRIV].[DOC].[SER];
	clpNum		[CL_PRIV].[DOC].[NUM];
	clpWho		[CL_PRIV].[DOC].[WHO];
	clpDate		[CL_PRIV].[DOC].[DATE];
	clpDepart	[CL_PRIV].[DOC].[DEPART_CODE];
	optSelectType		number;
begin
	if P_THIS%class not in ('CL_ORG', 'CL_PRIV') then
		pragma error('Печать карточки возможна только для Организаций или Физлица');
	end if;

	OpDate 			:= ::[SYSTEM].[VARIABLES].OpDate;
	P_ON_DATE		:= nvl(P_ON_DATE, OpDate);
	
	if P_THIS%class = 'CL_ORG' then
		V_COL :=  P_THIS->([CL_ORG])[ALL_BOSS];
		FillSigns(P_THIS);
		V_CLIENT := coalesce(P_THIS.[NAME], P_THIS->([CL_ORG])[LONG_NAME]);
		V_CLIENT_FULL := coalesce(P_THIS->([CL_ORG])[LONG_NAME],V_CLIENT);		
		V_DECLCLIENTNAME := substr(V_CLIENT_FULL, 1, 250);		

		for
			(select a(a:id)
				in P_THIS.[ADDRESSES]
				where a.[TYPE].[KOD] in ('CORP','FACT')
				order by decode(a.[TYPE].[KOD],'CORP',1,'FACT',2)
			)
		loop
			v_address := a.id;
			exit;
		end loop;

		v_chp_type := ::[CLIENT].[LIB].getCHPType(P_THIS);
		if v_chp_type in (1,2,3,4) then -- переопределяем для ИП наименование и полное наименование
			-- Ищем физ.лицо индивидуального предпринимателя
			clp := ::[CLIENT].[LIB].getCHPclPriv(P_THIS);
			if clp is not null then
				V_CLIENT := clp.[NAME];
				V_CLIENT_FULL := V_CLIENT || to_char(clp.[DATE_PERS],'", "dd.mm.yyyy') ||', '|| case when v_chp_type = 1 then 'нотариус' when v_chp_type = 2 then 'адвокат' when v_chp_type in (3,4) then 'индивидуальный предприниматель' end;
				V_CLIENT := V_CLIENT || ', ' || case when v_chp_type = 1 then 'нотариус' when v_chp_type = 2 then 'адвокат' when v_chp_type in (3,4) then 'индивидуальный предприниматель' end;
			end if;
		end if;
	else
		V_CLIENT 	:= P_THIS.[NAME];
		clp			:= P_THIS;
		begin
			select a(a.[DATE_PERS], a.[DOC].[TYPE].[NAME], a.[DOC].[SER], a.[DOC].[NUM], a.[DOC].[WHO], a.[DOC].[DATE], a.[DOC].[DEPART_CODE])
			in ::[CL_PRIV] all WHERE a = clp
			into clpDatePers, clpName, clpSer, clpNum, clpWho, clpDate, clpDepart;
		exception
			when NO_DATA_FOUND then null;
		end;

		V_CLIENT_FULL :=	V_CLIENT || to_char(clpDatePers,'", "dd.mm.yyyy');
		optSelectType	:= ::[FP_TUNE].[LIB].get_num_value('SELECT_CLIENT_PATTERN_TYPE', ::[FP_TUNE].[LIB].set_canons('BRANCH', stdlib.userId.[FILIAL]%id));
		
		if optSelectType = 1 then
			V_CLIENT_FULL :=	V_CLIENT_FULL || ', ' || clpName ||', Серия '||clpSer||', № '||clpNum || ', ' || 'выдан ' || clpWho || ' ' || to_char(clpDate,' dd.mm.yyyy, ') || 'к-п ' || clpDepart;
		end if;
		V_DECLCLIENTNAME :=	::[RUNTIME].[VIEWFUN].ClientDecl(P_THIS, 'Р');
	end if;
	
	if clp is not null then
		for
			(select a(a:id)
				in clp.[ADDRESSES]
				where a.[TYPE].[KOD] in ('REAL_LIVE','REGISTRATION')
				order by decode(a.[TYPE].[KOD],'REAL_LIVE',1,'REGISTRATION',2)
			)
		loop
			v_address := a.id;
			exit;
		end loop;
	end if;

	V_BANK	:= ::[SYSTEM].[VARIABLES].OurBank;
	--найдем адрес
	V_CLIENT_ADDR	:= ::[RUNTIME].[VIEWFUN].GetAddressByRef(v_address,'ALL');
	V_TEL := GetPhone(P_this);

	for	(select x(x : AC_REF, x.[MAIN_V_ID] : num)
			in ::[AC_FIN] all
			where (x.[CLIENT_V] = P_this or x.[CLIENT_R] = P_this)
				and x.[DATE_CLOSE] is null
				and decode
						( x.[COM_STATUS]
						, ::[COM_STATUS_PRD]([CODE]='FREEZED'),		0
						, ::[COM_STATUS_PRD]([CODE]='FREEZED_CT'),	0
						, ::[COM_STATUS_PRD]([CODE]='FREEZED_DT'),	0
						, 1
						) = 1
			order by x.[MAIN_V_ID]
		)
	loop
		idx := V_ACC.count + 1;
		V_ACC(idx).[BOOL] 	:= nvl(x.AC_REF = V_SEL_ACC, false);
		V_ACC(idx).[IDENT]	:= x.AC_REF%id;
		V_ACC(idx).[STR] 	:= x.NUM;
	end loop;
	V_SEL_ACC := null;
end;

public procedure PLPCALL_SIGN_CARD (p_client ref [CLIENT], p_account ref [AC_FIN] default null) is
begin
	V_SEL_ACC := p_account;
	
	stdio.put_line_buf('<% CALL CLIENT PSH_0401026_N '||p_client||' %>');
	--stdio.put_line_buf('<% CALL CLIENT REPORT_0401026_N '||p_client||' %>');
end;

-- Дополнительные коды
type T_PARAMS_TAB is table of [ADD_PARAM];
V_ADD_CODES T_PARAMS_TAB;

public procedure clear_codes
/* Очистка списка дополнительных кодов */
 is
begin
	V_ADD_CODES.delete;
end;

/* Формирование списка дополнительных кодов для отчета.
Добавление дополнительного значения с дистрибутивным кодом переопределяет дистрибутивное значение.
Если есть несколько значений одного кода, то будет использовано значение добавленное последним. */
public procedure add_code
/* Добавляет дополнительный код в список */
(
	code string(32)
	/* Код. Этот код указывается в шаблоне отчета */
	, value string(4000)
	/* Значение для подстановки */
) is
	c [ADD_PARAM];
begin
	c.[CODE] := substr(code, 1, c.[CODE]%size);
	c.[VALUE] := substr(value, 1, c.[VALUE]%size);
	if c.[CODE] is not NULL then
		V_ADD_CODES(nvl(V_ADD_CODES.last, 0) + 1) := c;
	end if;
end;
PSH_0401026_N (
	@name('Дата печати')           P_ON_DATE in [DATE],
	@name('Список счетов строкой') P_ACC_NUM in [STRING_2000],
	@name('Показать отчет')        P_SHOW    in [BOOLEAN]         default null,
	@name('Шаблон документа')      P_SHABLON in [SHABLON_DOC_REF] default null,
	@name('Пакетная печать')       P_BATCH   in [BOOLEAN]
) return [STRING] is

validate is
begin
-- Start initialization of parameters and variables

if p_message = 'DEFAULT' then
	P_ON_DATE := [SYSTEM]::[OP_DATE];	
end if;

-- End initialization of parameters and variables
declare
-- добавление лица для первой подписи
procedure AddPersonFirst is
	idx integer;
begin
	if not CheckForUniqueName(V_RERSON_FIRST.[FASE].[NAME], V_SIGN_FIRST) then
		V_RERSON_FIRST := null;
		return;
	end if;
	
	if V_RERSON_FIRST is not null then
		idx := nvl(V_SIGN_FIRST.last, 0) + 1;
		V_SIGN_FIRST(idx).[FIELD_1] := V_RERSON_FIRST.[FASE].[NAME];
		V_SIGN_FIRST(idx).[DATE_1] 	:= null;
		V_RERSON_FIRST := null;
	end if;   	
end;

begin
	if P_MESSAGE = 'DEFAULT' and P_INFO is NULL
		or P_MESSAGE = 'VALIDATE' and P_INFO = '%PLPCALL%'
	then
		P_SHOW := true;
		prepare(this, P_ON_DATE);
	elsif P_MESSAGE = 'VALIDATE' then
		-- Добавление подписывающих лиц в грид из массива должностных лиц организации
		if P_INFO like '%VAR%.V_RERSON_FIRST' then
			AddPersonFirst;	
		end if;
	end if;
	if P_BATCH then
    	[CSMD].command(V_DEST,'Form1.ScriptPostEvent OK, "CLICK"');
	 end if;
end;
end;

execute is
	pragma macro(wd, '::[OOXML].[API_DOC_SAX]');
	idx integer;
	v_shablon_code const varchar2(50) := 'FRM_0401026_OLD';

	v_rep_tmpl blob;
	v_str_tab constant.MEMO_TABLE_S;
	ClientAccounts		string(2000);
	UserName			[NAME];
	UserCasta			[CASTA]::[VALUE];
	UserDepart			[DEPART]::[NAME];
	tbl					StrTable;
	vRepId string;
	add_code [ADD_PARAM];
	
	podpisi varchar2(512);
	text varchar2(512);
	P_USER ref [USER]:=STDLIB.USERID;

	--C_NVL_CHAR const string(1) := '-';
	C_NVL_CHAR const string(40) := '----------------------------------------';
	C_NVL_CHAR2 const string(2) := '  ';
begin
	if P_BATCH then
		v_shablon_code  := 'FRM_0401026_N_PACK';
	end if;
	begin
		select a(a.[NAME], a.[CASTA].[VALUE], a.[DEPART].[NAME])
		in ::[USER] all WHERE a = stdlib.userid
		into UserName, UserCasta, UserDepart;
	exception
		when NO_DATA_FOUND then null;
	end;

	tbl := SplitNames(V_CLIENT_FULL, V_CLIENT_ADDR, V_BANK.[LONG_NAME]);
	
	-- Формирование списка счетов
	ClientAccounts	:= rtrim(trim(P_ACC_NUM),', ');
	
	idx := V_ACC.first;
	debug_pipe('V_ACC = '||V_ACC.first, 0);
	while idx is not null
	loop
	    if P_BATCH then
	      if substr(V_ACC(idx).[STR], 1,3)!='474' then
	    	  ClientAccounts := ClientAccounts || case when ClientAccounts is not null then ', ' end || V_ACC(idx).[STR];
	      end if;	  
	    else
		if V_ACC(idx).[BOOL] and nvl(length(ClientAccounts),0) + length(V_ACC(idx).[STR]) + 2 <= ClientAccounts%size then
			ClientAccounts := ClientAccounts || case when ClientAccounts is not null then ', ' end || V_ACC(idx).[STR];
		end if;
	    end if;
		idx := V_ACC.next(idx);
	end loop;

	ValidateSignTables;
	
	::[SHABLON_DOC].[LIB_OOXML].load_blob
	(
		p_shablon_code == nvl(P_SHABLON.[CODE], v_shablon_code)
		,p_shablon_blob == v_rep_tmpl
		,p_shablon_tbp == null
		,p_shablon_grp == null
		,p_shablon_ref == null
		,p_filial == null
	);
		
	if v_rep_tmpl is null then
		pragma error ('Для выбранного шаблона не задан файл');
	end if;
	
	if &wd.open_file(v_rep_tmpl) then
 		v_str_tab('OWN_NAME1') := tbl('CN1').val;
 		v_str_tab('OWN_NAME2') := tbl('CN2').val;
		v_str_tab('OWN_NAME3') := tbl('CN3').val;
 		v_str_tab('OWN_NAME4') := tbl('CN4').val;
		v_str_tab('OWN_ADDR1') := tbl('AD1').val;
		v_str_tab('OWN_ADDR2') := tbl('AD2').val;
		v_str_tab('OWN_ADDR3') := tbl('AD3').val;
 		v_str_tab('OWN_ADDR4') := tbl('AD4').val;
		v_str_tab('OWN_ADDR5') := tbl('AD5').val;
		v_str_tab('OWN_ADDR6') := tbl('AD6').val;
		v_str_tab('OWN_TEL') := V_TEL;
		v_str_tab('BANK_NAME1') := tbl('BN1').val;
		v_str_tab('BANK_NAME2') := tbl('BN2').val;
		v_str_tab('BANK_NAME3') := tbl('BN3').val;
		v_str_tab('BANK_NAME4') := tbl('BN4').val;
		v_str_tab('BANK_NAME5') := tbl('BN5').val;
		v_str_tab('BANK_NAME6') := tbl('BN6').val;
		v_str_tab('BANK_NAME7') := tbl('BN7').val;
		v_str_tab('BANK_NAME8') := tbl('BN8').val;
		v_str_tab('OWN_SHORT') := V_CLIENT;
		v_str_tab('ACC_NUM') := ClientAccounts;
		v_str_tab('SIGN_DATE') := to_char(P_ON_DATE,'dd.mm.yyyy');

-- Башкиров В.Г. 09.09.2022
-- В карточке образцов подписей не склоняется
-- ФИО физического лица (надо чтобы было ?.подписи Шитиковой Татьяны Ивановны, т.е родительный падеж)
if this%class='CL_PRIV' then
	V_DECLCLIENTNAME :=	::[RUNTIME].[VIEWFUN].ClientDecl(this, 'Р');
	podpisi:=', '||nvl(V_DECLCLIENTNAME,V_CLIENT);
end if;

for i in 1..8 loop
	podpisi := podpisi||', '||case when V_SIGN_FIRST.exists(i) then V_SIGN_FIRST(i).[FIELD_1] end;
end loop;
podpisi := substr(podpisi,3);
podpisi := substr(podpisi,1,instr(podpisi,', ,')-1);
text:='Я, '||P_USER.[CASTA].[VALUE]||' '||P_USER.[FILIAL].[BANK].[NAME]||', '||::[RUNTIME].[STDLIB].FIO(P_USER.[NAME])||', свидетельствую подлинность подписи '||podpisi
			||', которая сделана в моем присутствии '||to_char(sysdate,'DD.MM.YYYY')||' г. ' ||CHR(10)||'Личность установлена.';

::[CLIENT].[PSH_0401026_N].add_code('PSH_SVIDETEL', text);
::[CLIENT].[PSH_0401026_N].add_code('PSH_PROCHIE1', 'Выдача выписок');
::[CLIENT].[PSH_0401026_N].add_code('PSH_PROCHIE2', 'по требованию.');
::[CLIENT].[PSH_0401026_N].add_code('PSH_PROCHIE3', '');		
--::[CLIENT].[REPORT_0401026_N].add_code('PSH_SVIDETEL', text);
--::[CLIENT].[REPORT_0401026_N].add_code('PSH_PROCHIE1', 'Выдача выписок');
--::[CLIENT].[REPORT_0401026_N].add_code('PSH_PROCHIE2', 'по требованию.');
--::[CLIENT].[REPORT_0401026_N].add_code('PSH_PROCHIE3', '');		
		for i in 1..8 loop
			if V_SIGN_FIRST.exists(i) then
	 			v_str_tab('FIRST_SIGN_'||i) := V_SIGN_FIRST(i).[FIELD_1];
	 			v_str_tab('FIRST_SIGN_FIO_'||i) := [STDLIB].FIO(V_SIGN_FIRST(i).[FIELD_1], 'Ф И. О.');
	 			v_str_tab('FIRST_SIGN_SIGN_'||i) := NULL;
	 			v_str_tab('CRED_DATE_FIRST_'||i) := V_SIGN_FIRST(i).[FIELD_2];
	 		else
	 			v_str_tab('FIRST_SIGN_'||i) := C_NVL_CHAR;
	 			v_str_tab('FIRST_SIGN_FIO_'||i) := C_NVL_CHAR;
	 			v_str_tab('FIRST_SIGN_SIGN_'||i) := C_NVL_CHAR;
	 			v_str_tab('CRED_DATE_FIRST_'||i) := C_NVL_CHAR2;
	 		end if;
		end loop;
 		
 		v_str_tab('DATE_STRING') := DateToString(P_ON_DATE);
 		v_str_tab('USER_CASTA') := UserCasta;
 		v_str_tab('USER_DEPART') := UserDepart;
 		v_str_tab('USER_NAME') := [STDLIB].FIO(UserName, 'Ф И. О.');
 		v_str_tab('DECL_NAME') := V_DECLCLIENTNAME;

		-- Доп. коды
		for i in 1..V_ADD_CODES.count loop
			add_code := V_ADD_CODES(i);
			v_str_tab(add_code.[CODE]) := add_code.[VALUE];
		end loop;
		clear_codes;

		&wd.PutTextFields(v_str_tab);
		
		declare
 			v_doc blob;
 		begin
 			dbms_lob.createtemporary(v_doc,false,dbms_lob.call);
 			&wd.Finish(v_doc);
 			if P_SHOW then
 				-- Отправка файла отчёта пользователю на клиентскую машину
				vRepId := [OOXML]::[API_ORSA].putReport2Run(v_doc,'docx','['||&METHOD$CLASS||'] "'||&METHOD$NAME||'"');
 			else
 				vRepId := ::[OOXML].[API_ORSA].putReport(v_doc, 'docx','['||&METHOD$CLASS||'] "'||&METHOD$NAME||'"');
 			end if;
  		end;				
	else
		pragma error ('Не удалось открыть файл, связанный с шаблоном ' || nvl(P_SHABLON.[CODE], v_shablon_code));
	end if;
	return vRepId;
end;
end;
end;
