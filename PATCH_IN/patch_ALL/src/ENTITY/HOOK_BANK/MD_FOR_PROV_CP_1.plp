  then 
	
	p_text:=Substr(
							'Документ № '||DOCUMENT.[DOCUMENT_NUM]||' от '||to_char(DOCUMENT.[DATE_DOC], 'DD.MM.YYYY')||' на сумму '||trim(to_char(DOCUMENT.[SUM], '999999999999999990d00'))||' '||DOCUMENT.[VALUTA].[CUR_SHORT]
		||chr(10)||chr(13)||'Плательщик: '||DOCUMENT.[KL_DT].[2].[2]--||', ИНН: "'||DOCUMENT.[KL_DT].[2].[INN]||'"'
		||chr(10)||chr(13)||'Получатель: '||DOCUMENT.[KL_KT].[2].[2]--||', ИНН: "'||DOCUMENT.[KL_KT].[2].[INN]||'"'
		||chr(10)||chr(13)||'Назн.плат.: '||DOCUMENT.[NAZN]		
		||chr(10)||chr(13)||'Остаток на счете 30102: '||F.A('И'||to_char(ACCOUNT_DT), trunc(::[SYSTEM].[OP_DATE] + 1))
		||chr(10)||chr(13)||DOCUMENT%state
		||chr(10)||chr(13)||P_MESS
		||chr(10)||chr(13)||P_ADDS
		--||chr(10)||chr(13)||to_char(IT_DT)
		--||chr(10)||chr(13)||to_char(ANALYSE_OK)
		
	,1,1024);
	::[FP_INTERFACE].[PRX_PCORE].Send_Mail(  --Башкиров В.Г. 17.12.2023
		 'sobolev@pshb.ru;'	   
		, 'Поступление на коррсчет 222'				
		, p_text
		, 'IT@pshb.ru'					    
		, false							    
		,null
		);

end if; */


	-- KAS 23/08/2020 Контроль лимитов клиента по денежным переводам
	if DOCUMENT.[VID_DOC].[TYPE_DOC].[CODE] = 'KASSA_DOCUM' then
		if ::[DECLARE].[PSH_LIB].isDecl(DOCUMENT) then
			declare
			decl ref [DECLARE];
			begin
				--for decl_ in ::[DECLARE] where decl_.[IN_FOLDER] = DOCUMENT.[IN_FOLDER] loop
				for decl_ in ::[DECLARE] where decl_%id = DOCUMENT.[IN_FOLDER].[PROD_FOLD] loop
					decl:=decl_;
					exit;
				end loop;
				--debug_pipe ('decl='||decl,0);
				if decl is not null then
					if ::[DECLARE].[PSH_LIB].CheckLim(null, decl.[SENDER_REQ],decl) = false then
		  				pragma error (::[DECLARE].[PSH_LIB].CalcErrorMsg_short(decl.[SENDER_REQ],decl));
		  			end if;
				end if;
			end;
		end if;	
	end if;

	--Башкиров В.Г. Исполняем все ФР, если проведены все платежные документы папки
	if P_MESS='END' 
	and DOCUMENT%state='PROV'
	then
		oDOCUMENT:=DOCUMENT;
		fp:=oDOCUMENT.[IN_FOLDER];
		&debug(TB$||TB$||'Папка:'||fp%class||'.'||fp%id||'.'||fp%state
			||'  oDOCUMENT.[PRODUCT_DT].[ACC_PROD]%class='||oDOCUMENT.[PRODUCT_DT].[ACC_PROD]%class
			||'  oDOCUMENT.[PRODUCT_CT].[ACC_PROD]%class='||oDOCUMENT.[PRODUCT_CT].[ACC_PROD]%class
			,dp)
		if fp is not null
		and fp%state<>'PROV'
		and (	(oDOCUMENT.[PRODUCT_DT].[ACC_PROD] is not null
			 and oDOCUMENT.[PRODUCT_DT].[ACC_PROD]%class in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT'))
			or
				(oDOCUMENT.[PRODUCT_CT].[ACC_PROD] is not null
			 and oDOCUMENT.[PRODUCT_CT].[ACC_PROD]%class in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT'))
		 	)
		then
			FlOk:=true;
			for (select inf(inf.[DOCUMENT] : DOCUMENT) in fp.[DOCS_IN_FOLD]
			where inf.[DOCUMENT]%class='MAIN_DOCUM')
			loop
				md:=inf.DOCUMENT;
				if  md%state <> 'PROV' then
					FlOk:=false;
					&debug(TB$||TB$||'В папке есть непроведенный документ:'||md%class||'.'||md%id||'.'||md%state,dp)
					exit;
				end if;
			end loop;
			if FlOk then
				begin
					&debug(TB$||TB$||'Проводим папку:'||fp%class||'.'||fp%id||'.'||fp%state,dp)
					fp.DOC_TO_PROV;
					if fp%state in ('PROV') then null;		&debug(TB$||'Проведена папка    '||fp%class||'.'||fp%id||'.'||fp%state,dp)
					else					FlOk:=false;	&debug(TB$||'НЕ проведена папка '||fp%class||'.'||fp%id||'.'||fp%state,dp)
					end if;
				exception when others then
					&debug(TB$||'Не удалост провести папку!'||LF$||sqlerrm,dp)
				end;
			end if;
		end if;
	end if;
	&debug('Стоп :'||to_char(sysdate,'hh24:mm:ss')||' ('||GetTimeInterval(utils.get_time,timeStart)||'сотыхСек.)',dp)
end;
end;
end;
