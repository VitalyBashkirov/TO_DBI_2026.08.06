public function cl_bank(cl_id varchar2) return string is  -- возвращает сотрудник/не сотрудник банка
begin

	for u in ::[USER] all where u.[CL_PRIV_REF]=cl_id
	loop
		for t in ::[WORK_BOOK] all where t%collection=u.[CL_PRIV_REF].[WORK_ACTIVITY] AND t.[END_DATE] is null
		loop
			if ((upper(t.[CORP]) like '%ЭКСПЕРТ БАНК%') OR (upper(t.[CORP]) like '%СИБКУПБАНК%')) then
				return 'Сотрудник';
			else
				return 'Не сотрудник';				
			end if;
		end loop;
	end loop;

   return 'Не сотрудник';
	
end;

public function cod_prod(cl_id varchar2, dog_num varchar2, dog_id varchar2, class_id string) return string is  -- код подразделения (из продукта)
rez_vid string;	
begin
	--debug_pipe(cl_id||' '||nvl(dog_num,0)||' '||nvl(dog_id,0)||' '||class_id,0);
	if class_id = 'KRED_PERS' then
		 for dp in ::[PR_CRED] all where dp.[CLIENT]=cl_id AND dp.[NUM_DOG]=dog_num AND dp%Id=dog_id
			loop	
				rez_vid:= dp.[FILIAL].[CODE];
			end loop;
	elsif class_id = 'DEPOSIT_PRIV' then
		 for dp in ::[DEPN] all where dp.[CLIENT]=cl_id AND dp%id=dog_id
			loop	
			  rez_vid:=dp.[FILIAL].[CODE];
			end loop;
	elsif class_id = 'IND_SAFE_LEASE' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[IND_SAFE_LEASE] all where dp.[WHO_PAY]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=dp.[FILIAL].[CODE]||'(Аренда индивидуальных сейфовых ячеек)';
					end loop;		
			end loop;
	elsif class_id = 'ZALOG' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[ZALOG] all where dp.[USER_ZALOG]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=dp.[FILIAL].[CODE]||'(Обеспечение)';
					end loop;		
			end loop;		
	end if;
	return rez_vid;	
end;
end;
