type acc_rec is record (NUM_DOG varchar2(20),NUM_ACC varchar2(20));
type acc_table is table of acc_rec;
v_acc acc_table;
idx number;

function end_str(sex [SEX]) return string_3 is
str string_3;
begin
	if sex.[CODE] = 'Ж' then
		str := 'ей';
	else
		str := 'его';
	end if;

	return str;
end;

public procedure get_contacts(P_CLIENT ref [CLIENT], P_CONTACTS out string(400)) is 
	v_contact string(200);
begin
	-- Телефон и факс банка
	v_contact := ::[RKO_INTERFACE].[PRX_CLIENT].Get_contact(P_CLIENT,[COMUNICATION]([CODE] = 'PHONE'));
	if v_contact is not null then
		P_CONTACTS := v_contact;
	end if;
	v_contact := ::[RKO_INTERFACE].[PRX_CLIENT].Get_contact(P_CLIENT,[COMUNICATION]([CODE] = 'FAX'));
	if v_contact is not null then
		P_CONTACTS := bool_char(P_CONTACTS, '', P_CONTACTS || ', ')||v_contact;
	end if;
end;

function GetContacts(cont_arr [CONTACTS_ARR], contact_type string) return varchar2 is
str [MEMO_32767];
begin
	str := '';
	if contact_type is not null  then
	-- optimaze
		for
		(
			select res
			(
				res.[PRIVATE].[VALUE]: 	c_priv,
				res.[TYPE].[VALUE]:		c_val,
				res.[NUMB]:				c_numb
			)
			in cont_arr
			where	res.[ACTIV]=true and
					res.[NUMB] is not null and
					res.[TYPE].[CODE] = contact_type and
					(res.[PRIVATE].[CODE] in ('1', '2', '3') or res.[PRIVATE] is null)
			order by res.[PRIVATE].[CODE]
		)	
		loop
		  str := str||LTRIM(res.c_priv||' '||res.c_val||' '||res.c_numb||CHR(13));
		end loop;
	else
		return '';
	end if;
	return str;
end;

public procedure get_bank_reqs(p_rko ref [RKO],
	p_bank				ref [CL_BANK_N],
	P_BANK_CHIEF_RANGE out [NAME],
	P_BANK_CHIEF_RANGE_R out [NAME],
	P_BANK_CHIEF_NAME  out [NAME],
	P_BANK_CHIEF_NAME_R  out [NAME],
	P_BANK_CHIEF_NAME_D  out [NAME],
	P_BANK_END  out string(3),
	P_BANK_FOUND  out string(400),
	P_BANK_BUH_RANGE  out [NAME],
	P_BANK_BUH_NAME out  [NAME]) is 
	v_pers	ref [PERSONS_POS];
	v_user	ref	[USER];
begin
	-- Должность и ФИО руководителя банка
	    --debug_pipe('p_bank ' || p_bank,0);
	begin
		locate v_pers in p_bank.[ALL_BOSS] where v_pers.[CHIEF] and v_pers.[SIGN_TODAY];
	exception when NO_DATA_FOUND then
		begin
		locate v_pers in p_bank.[ALL_BOSS] where v_pers.[CHIEF];
		exception when NO_DATA_FOUND then null;
		end;
	end;
	

	if v_pers is not null then
		P_BANK_CHIEF_RANGE := v_pers.[RANGE].[VALUE];
		P_BANK_CHIEF_RANGE_R :=  ::[CASE_GRAM].[LIB].get_case (v_pers.[RANGE].[DECL_CAST], ::[CASE_GRAM]([CODE]='Р'));
		P_BANK_CHIEF_NAME  := v_pers.[FASE].[NAME];
		P_BANK_CHIEF_NAME_R := nvl([CASE_GRAM].[LIB].get_case(v_pers.[FASE].[DECL_FIO]), v_pers.[FASE].[NAME]);
		P_BANK_CHIEF_NAME_D := nvl([CASE_GRAM].[LIB].get_case(v_pers.[FASE].[DECL_FIO],::[CASE_GRAM]([CODE]='Д')), v_pers.[FASE].[NAME]);
		P_BANK_END := end_str(v_pers.[FASE].[SEX]);
		
		for b in v_pers.[BY_RIGHT]
		where nvl(b.[DATE_END],op_d) >= op_d
		and (b.[CLASS_DOG] is null or b.[CLASS_DOG] = p_rko%class)
		order by b.[CLASS_DOG]
		loop
			P_BANK_FOUND := [CASE_GRAM].[LIB].get_case(b.[DECLENSIONS]);
			exit;
		end loop;
		
		if P_BANK_FOUND is null then
			for usr in ::[USER]
			where usr.[CL_PRIV_REF] = v_pers.[FASE]
			loop
				for b in usr.[BY_RIGHT]
				where nvl(b.[DATE_END],op_d) >= op_d
				and (b.[CLASS_DOG] is null or b.[CLASS_DOG] = p_rko%class)
				order by b.[CLASS_DOG]
				loop
					P_BANK_FOUND := [CASE_GRAM].[LIB].get_case(b.[DECLENSIONS]);
					exit;
				end loop;
			end loop;
		end if;

		begin
			locate v_user in ::[USER] where v_user.[CL_PRIV_REF] = v_pers.[fase] and rownum=1;
			--if v_user.[DEPART].[CODE]<> '001-00-01' then
			if substr(v_user.[DEPART].[CODE],1,3)<> '001' then
				V_DEPART_USER 		:= ::[DEPART].[LIB].get_declension(v_user.[DEPART]);
                V_DEPART_USER_      :=  v_user.[DEPART].[NAME];
--                V_ADR_DEP_USER      := [VIEWFUN].GetAddress(v_user.[DEPART],'ALL','CORP');
--                V_ADR_DEP_USER      := v_user.[DEPART].[ADDRESSES];
			else
				v_depart_user := null;
                V_ADR_DEP_USER:=null;
			    V_DEPART_USER_:=null;
			end if;

		exception when no_data_found then
			v_depart_user := '';
		end;
	end if;

	-- Должность и ФИО главного бухгалтера банка
	begin
		locate v_pers in p_bank.[ALL_BOSS] where v_pers.[GENERAL_ACC] and v_pers.[SIGN_TODAY];
	exception when NO_DATA_FOUND then
		begin
		locate v_pers in p_bank.[ALL_BOSS] where v_pers.[GENERAL_ACC];
		exception when NO_DATA_FOUND then null;
		end;
	end;
	if v_pers is not null then
		P_BANK_BUH_RANGE   := v_pers.[RANGE].[VALUE];
		P_BANK_BUH_NAME    := v_pers.[FASE].[NAME];
	end if;
end;

public procedure get_cl_reqs(	p_rko ref [RKO],
						p_org	ref [CL_ORG],
						P_CL_CHIEF_RANGE out [NAME],
						P_CL_CHIEF_RANGE_R out [MEMO],
						P_CL_CHIEF_NAME out [NAME],
						P_CLIENT_CHIEF_NAME_R out [MEMO],
						P_CLIENT_END out string(3),
						P_CL_BUH_NAME out [NAME],
						P_CLIENT_FOUND out string(400)) is 
begin
	for pers in p_org.[ALL_BOSS] loop
		if pers.[CHIEF] then
			P_CL_CHIEF_RANGE := pers.[RANGE].[VALUE];

			P_CL_CHIEF_RANGE_R := nvl([CASE_GRAM].[LIB].get_case(pers.[RANGE].[DECL_CAST]) , pers.[RANGE].[VALUE]);

			P_CL_CHIEF_NAME  := pers.[FASE].[NAME];
			P_CLIENT_CHIEF_NAME_R := nvl([CASE_GRAM].[LIB].get_case(pers.[FASE].[DECL_FIO]), pers.[FASE].[NAME]);

-->>>>>>>>>>>> Курганов А.В.
cli_fio_ruk_dat:= ::[RUNTIME].[STDLIB].FIO([CASE_GRAM].[LIB].get_case(pers.[FASE].[DECL_FIO],::[CASE_GRAM]([CODE]='Д')));
cli_dol_ruk_dat := [CASE_GRAM].[LIB].get_case(pers.[RANGE].[DECL_CAST],::[CASE_GRAM]([CODE]='Д'));
--<<<<<<<<<<<<<	
			P_CLIENT_END := end_str(pers.[FASE].[SEX]);
	
		elsif pers.[GENERAL_ACC] then
			P_CL_BUH_NAME    := pers.[FASE].[NAME];
		end if;
		for b in pers.[BY_RIGHT]
		where nvl(b.[DATE_END],op_d) >= op_d
		and (b.[CLASS_DOG] is null or b.[CLASS_DOG] = p_rko%class)
		order by b.[CLASS_DOG]
		loop
			P_CLIENT_FOUND := [CASE_GRAM].[LIB].get_case(b.[DECLENSIONS]);
			exit;
		end loop;
	end loop;
end;

public procedure check_pers(sign [SIGN_BY_RIGH_ARR], name varchar2(100), prod ref [PRODUCT]) is  -- auto update 21/05/06
n_val number;
day_cnt number;
b ref [SIGN_BY_RIGHT];
begin
	n_val := nvl(::[FP_TUNE].[LIB].get_num_value('CHECK_RIGHT_PERS',[FP_TUNE].[LIB].set_canons('BRANCH', [SYSTEM]::[VARIABLES].OurBranch%id, 'METACLASS', prod%class),'0'),-1);
	if n_val >= 0 then
		begin
			locate b in sign 
			where (b.[CLASS_DOG] is null or b.[CLASS_DOG] = prod%class)
			and b.[DATE_BEGIN] <= op_d
			order by b.[CLASS_DOG],b.[DATE_END] desc;
				day_cnt := b.[DATE_END] - op_d;
				if n_val > 0 then
					if day_cnt < n_val and day_cnt >= 0 then
				stdio.put_line_buf('Срок полномочий должностного лица"'||name||'" истекает через '||day_cnt||' дней');
					elsif day_cnt < 0 then
				pragma error('Срок полномочий должностного лица"'||name||'" истек');
					end if;
				elsif n_val = 0 then
					if day_cnt < 0 then
				pragma error('Срок полномочий должностного лица"'||name||'" истек');
					end if;
				end if;
		exception when NO_DATA_FOUND then
			pragma error('Не заполнено основание подписи у должностного лица"'||name||'" для данного продукта');
		end;
	end if;		
end;

public procedure chk_pers(P_SIGN_CHIEF ref [USER], P_SIGN_BUH ref [USER], p_rko ref [RKO], p_bank ref [CL_BANK_N], P_SIGN_CHIEF_D ref [PERSONS_POS] default null, P_SIGN_BUH_D ref [PERSONS_POS] default null) is 
	v_pers				ref [PERSONS_POS];
begin
	--debug_pipe('chk_pers ',0);
	if P_SIGN_CHIEF is null then
		if P_SIGN_CHIEF_D is null then
			begin
				locate v_pers in p_bank.[ALL_BOSS] where v_pers.[CHIEF] and v_pers.[SIGN_TODAY];
			exception when NO_DATA_FOUND then
				begin
					locate v_pers in p_bank.[ALL_BOSS] where v_pers.[CHIEF];
				exception when NO_DATA_FOUND then null;
				end;
			end;
		else
			v_pers := P_SIGN_CHIEF_D;
		end if;	
		check_pers(v_pers.[BY_RIGHT], V_BANK_CHIEF_NAME, p_rko);
	else
		check_pers(P_SIGN_CHIEF.[BY_RIGHT], V_BANK_CHIEF_NAME, p_rko);
	end if;
	if P_SIGN_BUH is null then
		if P_SIGN_BUH_D is null then	
			begin
				locate v_pers in p_bank.[ALL_BOSS] where v_pers.[GENERAL_ACC] and v_pers.[SIGN_TODAY];
			exception when NO_DATA_FOUND then
				begin
					locate v_pers in p_bank.[ALL_BOSS] where v_pers.[GENERAL_ACC];
				exception when NO_DATA_FOUND then null;
				end;
			end;
		else
			v_pers := P_SIGN_BUH_D;
		end if;				
		check_pers(v_pers.[BY_RIGHT], V_BANK_BUH_NAME, p_rko);
	else
		check_pers(P_SIGN_BUH.[BY_RIGHT], V_BANK_BUH_NAME, p_rko);
	end if;
end;		
	
function get_by_right (	  p_user		ref [USER] default null
						, p_prod		ref [RKO]
						, p_official	ref [PERSONS_POS] default null
					  )
return string(400)
is
	v_by_right [SIGN_BY_RIGH_ARR];
	v_pers ref [PERSONS_POS];
begin
	if p_official is null then
		begin
			locate v_pers in bank.[ALL_BOSS] all where v_pers.[FASE] = p_user.[CL_PRIV_REF];
		exception when NO_DATA_FOUND then
			null;
		end;
	else
		v_pers := p_official;	
	end if;	
	
	v_by_right := nvl(v_pers.[BY_RIGHT], p_user.[BY_RIGHT]);
	-- сначала ищем в основании подписи должностного лица. если не нашли, тогда попробуем поискать у пользователя
	for(	select x(x.[DECLENSIONS] : declensions)
			in ::[SIGN_BY_RIGHT] collections
			where 	nvl(x.[DATE_END], op_d) >= op_d
				and (x.[CLASS_DOG] is null or x.[CLASS_DOG] = p_prod%class)
				and x%collection = v_by_right
			order by x.[CLASS_DOG]
		)
	loop
		return ::[CASE_GRAM].[LIB].get_case(x.declensions);
	end loop;
	
	return null;
end;

	--<asankulov
	function getLinkCln( p_ClCur ref [CLIENT], p_CodeLink varchar2) return ref [CLIENT] 
	is
		rClLink ref [CLIENT];
	
	begin
		for (
			select l(l.[PARTNER]: l_cl)
			in p_ClCur.[LINKS_OTHER] all
			where l.[VID_LINK].[CODE] = p_CodeLink
		)
		loop
			
			rClLink := l.l_cl;
			exit;
		end loop;
		return rClLink;
	
	end;
	-->

/*Процедура выполняет первоначальное заполнение переменных*/
procedure init_data(p_this ref [RKO]) is
	p_org	Ref [CL_ORG];
	p_priv	Ref [CL_PRIV];
	req_charges_acc	[REQ_CLIENT];
begin
	--28.05.2012 BS00182059
	--V_CHARGES_ACC := p_this.[CHARGES_ACC].[MAIN_V_ID]; -- Номер счета для оплаты услуг за РКО
	--V_DEPART_CHARGES_ACC := p_this.[CHARGES_ACC].[DEPART].[NAME];	-- Наименование подразделения счета для оплаты услуг за РКО
	-- nikitin from new oper -- PRINT_WORD_XML
	req_charges_acc := ::[RKO].[LIB_RKO].GET_CHARGES_ACC(p_this);
	V_CHARGES_ACC := nvl(req_charges_acc.[1].[2].[MAIN_V_ID], req_charges_acc.[2].[1]); -- Номер счета для оплаты услуг за РКО
	V_DEPART_CHARGES_ACC := req_charges_acc.[1].[2].[DEPART].[NAME];	-- Наименование подразделения счета для оплаты услуг за РКО
	-- nikitin end
	
	V_DATE_BEGIN	:= p_this.[DATE_BEGIN];    -- Дата заключения договора
	V_DATE_BEGINING	:= p_this.[DATE_BEGINING];    -- Дата начала действия договора
	
	V_CONTRACT_CUR	:= p_this.[CONTRACT_CUR].[NAME];  -- Валюта договора
	V_CONTRACT_CUR_SHORT	:= p_this.[CONTRACT_CUR].[CUR_SHORT];  
	V_CONTRACT_CUR_P:= case when  p_this.[CONTRACT_CUR].[CUR_SHORT]='USD' then 'долларах США' --but
                            when  p_this.[CONTRACT_CUR].[CUR_SHORT]='EUR' then 'евро'
                            else  ''
                       end;
     V_ACCOUNT	:= p_this.[ACCOUNT].[MAIN_V_ID];                 -- Расчетный (текущий) счет	
	V_NUM_DOG	:= p_this.[NUM_DOG];       -- Номер договора
	
	--< asankulov
	V_LINK_CL := getLinkCln( p_this.[CLIENT], 'ПРЕДСТАВИТЕЛЬ');
	
	if V_LINK_CL%CLASS = 'CL_PRIV' then
		V_LINK_CL_PRIV			:= V_LINK_CL;
		V_LINK_CL_PRED_NAME		:= nvl([CASE_GRAM].[LIB].get_case(V_LINK_CL_PRIV.[DECL_FIO],::[CASE_GRAM]([CODE]='Р')), V_LINK_CL_PRIV.[NAME]);
		V_LINK_CL_PRED_DATE_PERS:= to_char(V_LINK_CL_PRIV.[DATE_PERS], 'dd.mm.yyyy')||' года рождения, ';
	  ----Башкиров В.Г. 05.11.2024
	  --V_LINK_CL_PRED_BORN		:= 'место рождения: '|| V_LINK_CL_PRIV.[BORN].[FULL_NAME];
		V_LINK_CL_PRED_BORN		:= 'место рождения: '|| nvl(V_LINK_CL_PRIV.[BORN].[FULL_NAME],V_LINK_CL_PRIV.[DOC].[BIRTH_PLACE]);
		V_LINK_CL_PRED_SEX		:= 'пол: '||V_LINK_CL_PRIV.[SEX].[VALUE];
		V_LINK_CL_PRED_COUNTRY	:= 'гражданство: '||V_LINK_CL_PRIV.[COUNTRY].[NAME];
	  --Башкиров В.Г. 05.11.2024
	  --V_LINK_CL_PRED_DOC		:= ' паспорт: '|| V_LINK_CL_PRIV.[DOC].[NUM]||' выдан '|| V_LINK_CL_PRIV.[DOC].[WHO]||' '||V_LINK_CL_PRIV.[DOC].[PLACE]||' '||to_char(V_LINK_CL_PRIV.[DOC].[DATE],'dd.mm.yyyy')||' г., '||' код подразделения '||V_LINK_CL_PRIV.[DOC].[DEPART_CODE];
		V_LINK_CL_PRED_DOC		:= trim(
			iif(V_LINK_CL_PRIV.[DOC].[TYPE].[NAME]    is null,'',V_LINK_CL_PRIV.[DOC].[TYPE].[NAME]||':')
			|| iif(V_LINK_CL_PRIV.[DOC].[SER]         is null,'',' серия '|| V_LINK_CL_PRIV.[DOC].[SER])
			|| iif(V_LINK_CL_PRIV.[DOC].[NUM]         is null,'',' № '||V_LINK_CL_PRIV.[DOC].[NUM])
			|| iif(V_LINK_CL_PRIV.[DOC].[WHO]         is null,'',' выдан '|| V_LINK_CL_PRIV.[DOC].[WHO])
			|| iif(V_LINK_CL_PRIV.[DOC].[PLACE]       is null,'',' '||V_LINK_CL_PRIV.[DOC].[PLACE])
			|| iif(V_LINK_CL_PRIV.[DOC].[DATE]        is null,'',' '||to_char(V_LINK_CL_PRIV.[DOC].[DATE],'dd.mm.yyyy')||' г.,')
			|| iif(V_LINK_CL_PRIV.[DOC].[DEPART_CODE] is null,'',' код подразделения '||V_LINK_CL_PRIV.[DOC].[DEPART_CODE])
										);
		V_LINK_CL_PRED_ADR		:= 'зарегистрированная по месту жительства по адерсу: '||[VIEWFUN].GetAddress(V_LINK_CL, 'ALL');
		-- доверенность
		for(
			 		 select x(x.[ini_client].[name]		: cl_name,
			 		 		  --x.[TRUST_CLIENT].[NAME]	: dov_name,
			 		 		  x.[document_uno]			: document_num,
			 		 		  x.[begin_date]			: beg_date,
			 		 		  x.[END_DATE]				: end_date
			 		 		)
						in ::[TRUST_FOR_PROD] all
						where V_LINK_CL_PRIV =x.[TRUST_CLIENT]	
				)loop
					-- Башкиров В.Г. 05.11.2024
					--V_LINK_CL_PRED_DOV := ' на основании доверенности № ' || ' от '||to_char(x.[beg_date], 'dd.mm.yyyy') ||'г.'; --|| trim(x.[document_num])|| ' действует до '||to_char(x.end_date, 'dd.mm.yyyy')
					V_LINK_CL_PRED_DOV := ' на основании доверенности № ' || x.document_num|| ' от '||to_char(x.[beg_date], 'dd.mm.yyyy') ||'г.'; --|| trim(x.[document_num])|| ' действует до '||to_char(x.end_date, 'dd.mm.yyyy')
				end loop;
	
	elsif V_LINK_CL%CLASS = 'CL_ORG' then
		V_LINK_CL_ORG:= V_LINK_CL;
	end if;
	--> asankulov
	
	for	(select x(x : AC_REF, x.[MAIN_V_ID] : num,r.[NUM_DOG] : num_dog)
			in ::[AC_FIN] 
			join ([RKO]  r) on r.[ACCOUNT]=x
			all
			where (x.[CLIENT_V] = p_this.[CLIENT] or x.[CLIENT_R] = p_this.[CLIENT])
				and x.[DATE_CLOSE] is null
				and decode
						( x.[COM_STATUS]
						, ::[COM_STATUS_PRD]([CODE]='FREEZED'),		0
						, ::[COM_STATUS_PRD]([CODE]='FREEZED_CT'),	0
						, ::[COM_STATUS_PRD]([CODE]='FREEZED_DT'),	0
						, 1
						) = 1
			order by x.[MAIN_V_ID]
		)
	loop
		idx := V_ACC.count + 1;		
		V_ACC(idx).[NUM_ACC] 	:= x.num;
		V_ACC(idx).[NUM_DOG]	:= x.num_dog;
	    
	    s_NUM_DOG:=s_NUM_DOG||x.num_dog||chr(10);
	    s_ACCOUNT:=s_ACCOUNT||x.num||chr(10);
	end loop; --*/
     
	
	V_ACCOUNT_REST	:= p_this.[ACCOUNT].[SALDO_NT];              -- Текущий остаток в нац. валюте
	V_OPEN_ACCOUNT	:= p_this.[ACCOUNT].[DATE_OP];               -- Дата открытия счета
	V_TYPE_ACCOUNT	:= lower(p_this.[ACCOUNT].[TARGET].[AIM]);   -- Тип счета (расчетный, текущий, бюджетный)
	--if instr('счет', V_TYPE_ACCOUNT)=0 then V_TYPE_ACCOUNT := V_TYPE_ACCOUNT||' счет'; end if;
	V_TYPE_ACCOUNT	:= replace(V_TYPE_ACCOUNT, ' счет');
	V_ACCOUNT_OTV	:= p_this.[ACCOUNT].[OTV].[NAME];             -- Ответственный по счету
	V_DEPART	:= nvl(p_this.[DEPART].[NAME], nvl(p_this.[ACCOUNT].[DEPART].[NAME], p_this.[ACCOUNT].[OTV].[DEPART].[NAME]));
	V_DEPART_CODE:=p_this.[DEPART].[CODE];
	V_REG_NUM:=p_this.[CLIENT].[REGISTR_NUM];

	V_PART		:= nvl(p_this.[DEPART].[PART].[NAME], nvl(p_this.[ACCOUNT].[DEPART].[PART].[NAME], p_this.[ACCOUNT].[OTV].[DEPART].[PART].[NAME]));
	V_FILIAL	:= p_this.[FILIAL].[SHORTLABEL];
	
	V_CLOSE_ACCOUNT := p_this.[ACCOUNT].[DATE_CLOSE];
	if p_this%class = 'RKO_CUR' then
		rko_cur := p_this;
		V_ACC_TRANS    := rko_cur.[ACC_TRANS].[MAIN_V_ID];     -- Транзитный счет
		V_SPECIAL_ACC  := rko_cur.[SPECIAL_ACC].[MAIN_V_ID];   -- Специальный транзитный счет
	end if;
	
	bank := ::[SYSTEM].[VARIABLES].OurBranch.[BANK];
	V_BANK_NAME  := bank.[NAME]; 			-- Наименование банка
	V_BANK_NAME_R := nvl([CASE_GRAM].[LIB].get_case(bank.[DECL_FIO]),bank.[NAME]);
	V_BANK_NAME_D := nvl([CASE_GRAM].[LIB].get_case(bank.[DECL_FIO],::[CASE_GRAM]([CODE]='Д')),bank.[NAME]);
	V_BANK_INN  := bank.[INN];    		    -- ИНН банка
	V_BANK_BIC  := bank.[BIC];                      -- БИК банка
	V_BANK_KOD_OKPO := bank.[KOD_OKPO];             -- Код ОКПО банка
	V_BANK_KS := bank.[KS];                         -- Коррсчет банка
	V_BANK_ADDRESS := [VIEWFUN].GetAddress( bank, 'ALL', 'CORP',2 );   -- Адрес банка
	V_BANK_ADDRESS := '127006, г.Москва, вн.тер.г. муниципальный округ Тверской, ул.Малая Дмитровка, д.14, стр.4.'; 
	V_BANK_KPP := bank.[KPP];
	V_BANK_OGRN := bank.[REGISTER].[GOS_REG_NUM_REC];
	begin
		V_BANK_RKC := ::[CL_BANK_N]%locate(b where b.[BIC]=bank.[BIC_MASTER]).[NAME]; --||' '||[VIEWFUN].GetAddress( bank, 'CITY', 'CORP' );    -- Обслуживающий РКЦ
	exception when NO_DATA_FOUND then null;
	end;

	-- Телефон и факс банка
	get_contacts(bank, V_BANK_CONTACTS);
	
	-- Телефон и факс клиента
	get_contacts(p_this.[CLIENT], V_CLIENT_CONTACTS);

	if p_this.[CLIENT]%Class = 'CL_ORG' then
		p_org := p_this.[CLIENT];
		V_CLIENT_NAME := p_org.[LONG_NAME];     -- Наименование клиента
		V_CLIENT_N := p_org.[NAME];     -- Наименование клиента
		V_CLIENT_NAME_R := nvl([CASE_GRAM].[LIB].get_case(p_org.[DECL_FIO]),p_org.[LONG_NAME]);
		V_CLIENT_NAME_D := nvl([CASE_GRAM].[LIB].get_case(p_org.[DECL_FIO],::[CASE_GRAM]([CODE]='Д')),p_org.[LONG_NAME]);
		
		V_CLIENT_KOD_OKPO := p_org.[KOD_OKPO];  	-- Код ОКПО клиента
		V_CLIENT_INN := p_this.[CLIENT].[INN];            -- ИНН клиента
		V_CLIENT_KPP := p_this.[CLIENT].[KPP];            -- КПП клиента
		V_CLIENT_ADDRESS := [VIEWFUN].GetAddress( p_this.[CLIENT], 'ALL', 'CORP' );   -- Адрес клиента
		V_CLIENT_BUSINESS := substr(p_org.[BUSINESS],1,250);   -- Основной вид деятельности клиента
		V_OWNERSHIP := lower(p_org.[OWNERSHIP].[PS].[PS_NAME]); -- Форма собственности клиента
		V_OWN_NAME := lower(p_org.[OWNERSHIP].[NAME]);
		
		V_CITY := [VIEWFUN].GetAddress( bank, 'CITY', 'CORP' );   -- Город
		
		V_CLIENT_OGRN := p_org.[REGISTER].[GOS_REG_NUM_REC];
		
		-- Должность и ФИО руководителя и главного бухгалтера клиента
		get_cl_reqs(	p_this,
						p_org,
						V_CL_CHIEF_RANGE,
						V_CL_CHIEF_RANGE_R,
						V_CL_CHIEF_NAME,
						V_CLIENT_CHIEF_NAME_R,
						V_CLIENT_END,
						V_CL_BUH_NAME,
						V_CLIENT_FOUND);
	elsif p_this.[CLIENT]%Class = 'CL_PRIV' then
		p_priv := p_this.[CLIENT];
		V_CLIENT_NAME := p_priv.[NAME];     -- Наименование клиента
		V_CLIENT_NAME_R := nvl([CASE_GRAM].[LIB].get_case(p_priv.[DECL_FIO]), p_priv.[NAME]);
		V_CLIENT_NAME_D := nvl([CASE_GRAM].[LIB].get_case(p_priv.[DECL_FIO],::[CASE_GRAM]([CODE]='Д')), p_priv.[NAME]);
		V_CLIENT_INN := p_priv.[INN];            -- ИНН клиента
		V_CLIENT_KPP := p_priv.[KPP];            -- КПП клиента
		V_CLIENT_ADDRESS := [VIEWFUN].GetAddress( p_priv, 'ALL' );   -- Адрес клиента
		V_CITY := [VIEWFUN].GetAddress( bank, 'CITY' );   -- Город
		var cl_cert  [CERTIFICATE];
		cl_cert := p_priv.[DOC];
        cert_type:= cl_cert.[TYPE].[NAME]; --but
		
		V_CERT_NUM := cl_cert.[NUM];
		V_CERT_SER := cl_cert.[SER];
		V_CERT_WHO := cl_cert.[WHO];
		V_CERT_DATE := cl_cert.[DATE];
		V_CERT_DEP_CODE := cl_cert.[DEPART_CODE];
		
	end if;
	V_CLIENT_INTER_NAME := p_this.[CLIENT].[I_NAME];

	-- Должность и ФИО руководителя, гл. бухгалтера банка
	get_bank_reqs(	p_this,
					bank,
						V_BANK_CHIEF_RANGE,
						V_BANK_CHIEF_RANGE_R,
						V_BANK_CHIEF_NAME,
						V_BANK_CHIEF_NAME_R,
						V_BANK_CHIEF_NAME_D,
						V_BANK_END,
						V_BANK_FOUND,
						V_BANK_BUH_RANGE,
						V_BANK_BUH_NAME);

	-- Определение серии и номеров неиспользованных чеков
	for (select ch(ch.[] : id_ch) in p_this.[CHECK_BOOKS] where ch.[DATE_CLOSE] is null group by ch.[]) loop
		SNum := -1;
		TNum := -1;
		Num1 := 0;
		V_NN_CHECKS := V_NN_CHECKS || ' ' || ch.id_ch.[SERIES] || ' №№ ';
		for nm in ch.id_ch.[NUMS] where not nm.[USED] or nm.[USED] is null order by to_number(nm.[NUM]) loop
		Num1 := nm.[NUM];
		if (Num1 - Num0) = 1 then
			TNum := Num1;
		else
			if Num0 = TNum then
			V_NN_CHECKS := V_NN_CHECKS || '-' || Num0 || ', ' || Num1;	-- Интервал номеров
			else
			if SNum = -1 then
				V_NN_CHECKS := V_NN_CHECKS || Num1; -- Номер в первый раз
				SNum := 0;
			else
				V_NN_CHECKS := V_NN_CHECKS || ', ' || Num1; -- Одиночный номер
			end if;
			end if;
		end if;

		Num0:= Num1;
		end loop;
		if Num0 = TNum then
		V_NN_CHECKS := V_NN_CHECKS || '-' || Num0 || ';';	-- Закрытие интервала номеров
		end if;
	end loop;

	if V_NN_CHECKS is not null then V_NN_CHECKS := 'серии '||V_NN_CHECKS; end if;
	
-->>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> Курганов А.В.
	if p_this.[FILIAL].[CODE]='001' then temp := 'Россия, 119048, г.Москва ул.Усачёва, д.62'||CHR(10)||'Тел./Факс: (499) 245-15-62;'||CHR(10)||'(499) 245-24-16';
	elsif p_this.[FILIAL].[CODE]='101' then temp := 'Россия, 413100, г.Энгельс ул.Маяковского, д.48-а'||CHR(10)||'Тел./Факс: (8453) 55-66-14;'||CHR(10)||'(8453) 55-64-61';
	end if;

	kod_val:=p_this.[CONTRACT_CUR].[CUR_SHORT];

	cli_short := p_this.[CLIENT].[NAME];

V_DESTINATION_0:=V_DESTINATION.[0];

end;


-- Разбивает строку ФИО на 3 строки Фамилия Имя Отчество
-- по 2-м встреченным пробелам
function Get_Short_FIO (full_n varchar2) return varchar2(100)
is
	pos1 integer;
	pos2 integer;
	family varchar2(32);
	name varchar2(32);
	sname varchar2(32);	
begin
	full_n :=trim(full_n);
	pos1 := instr(full_n, ' ');		
	pos2 := instr(full_n, ' ', 1, 2);
	if pos2 = 0 then -- нет отчества
		family := substr(full_n, 1, pos1-1);
		name := substr(full_n,pos1+1);
		sname := '';
	else			-- полное имя (Ф И О)
		family := substr(full_n, 1, pos1-1);
		name := substr(full_n,pos1+1,pos2-pos1-1);
		sname := substr(full_n,pos2+1);
	end if;
	
	if SName is null or SName = '' then
		return Family||' '||substr(Name,1,1)||'.' ;
	else
		return Family||' '||substr(Name,1,1)||'.'||substr(SName,1,1)||'.' ;
	end if;
end;


/* Процедура генерирует строку (P_DATA), которая будет записываться в поле с наименованием P_INFO*/
procedure generate_data (P_INFO in out string (32000), P_DATA in out string (32000)) is
begin
	/*ДЛИНА КОДА НЕ МОЖЕТ БЫТЬ БОЛЬШЕ 20 СИМВОЛОВ - ЭТО ОГРАНИЧЕНИЕ WORD'а!!!*/
	if p_info in ('Город','Город1','Город2') then
		P_DATA:=V_CITY;
	elsif p_info in ('НомерДоговора','НомерДоговора1','НомерДоговора2') then
		P_DATA:=V_NUM_DOG;
	elsif p_info in ('ДатаДоговора','ДатаДоговора1','ДатаДоговора2') then
		P_DATA := to_char(V_DATE_BEGIN, 'DD.MM.YYYY');
	elsif p_info in ('ДатаНачДейстДоговор','ДатаНачДейстДоговор1','ДатаНачДейстДоговор2') then
		P_DATA := to_char(V_DATE_BEGINING, 'DD.MM.YYYY');
	elsif p_info='Б_ФИОРуководителяР' then
		P_DATA:=V_BANK_CHIEF_NAME_R;
	elsif p_info='Б_ФИОРуководителяД' then
		P_DATA:=V_BANK_CHIEF_NAME_D;
	elsif p_info='К_ФИОРуководителяР' then
		P_DATA:=V_CLIENT_CHIEF_NAME_R;
	elsif p_info like 'ВалютаДоговора%' then 
		P_DATA:=V_CONTRACT_CUR;
	elsif p_info like 'В_ВалютеДоговора%' then 
		P_DATA:= V_CONTRACT_CUR_P;
	elsif p_info like 'ВалДоговор%' then 
		P_DATA:=replace(V_CONTRACT_CUR_SHORT,'RUB','руб');
		
	elsif p_info='РегНомер' then 
		P_DATA:=V_REG_NUM;
	elsif p_info in ('РасчетныйСчет', 'РасчетныйСчет1', 'РасчетныйСчет2') then
		P_DATA:=V_ACCOUNT;
    elsif p_info in ('РасчетныеСчета') then		
		P_DATA:=s_ACCOUNT;
	elsif p_info in ('НомераДоговоров') then
		P_DATA:=s_NUM_DOG;
	elsif p_info in ('БалансовыйСчет', 'БалансовыйСчет1', 'БалансовыйСчет2') then
		P_DATA:=substr(V_ACCOUNT,1,5);
	elsif p_info='ТранзитныйСчет' then
		P_DATA:=V_ACC_TRANS;
	elsif p_info='СпецтранзитныйСчет' then
		P_DATA:=V_SPECIAL_ACC;
	elsif p_info in ('Б_Наименование','Б_Наименование1') then
		P_DATA:=V_BANK_NAME;
	elsif p_info in ('Б_Адрес','Б_Адрес1') then
		P_DATA:=V_BANK_ADDRESS;
	elsif p_info='Б_Коррсчет' then
		P_DATA:=V_BANK_KS;
	elsif p_info='Б_ИНН' then
		P_DATA:=V_BANK_INN;
	elsif p_info='Б_БИК' then
		P_DATA:=V_BANK_BIC;
	elsif p_info='Б_ОКПО' then
		P_DATA:=V_BANK_KOD_OKPO;
	elsif p_info = 'Б_КПП' then
		P_DATA := V_BANK_KPP;
	elsif p_info = 'Б_ОГРН' then
		P_DATA := V_BANK_OGRN;
	elsif p_info in ('К_Наименование','К_Наименование1','К_Наименование2','К_Наименование3') then
		P_DATA:=V_CLIENT_NAME;
	elsif p_info in ('К_НаимКрат','К_НаимКрат1','К_НаимКрат2','К_НаимКрат3') then
		if V_LINK_CL_PRIV is not null then					--Башкиров В.Г. 05.11.2024
			P_DATA:=Get_Short_FIO(V_LINK_CL_PRIV.[NAME]);	--Башкиров В.Г. 05.11.2024
		else
			if v_client_class='CL_PRIV' then
				P_DATA:=Get_Short_FIO(V_CLIENT_NAME);
			else
				P_DATA:=V_CLIENT_N;
			end if;
		end if;
	elsif p_info in ('К_ИнтерНаим','К_ИнтерНаим1','К_ИнтерНаим2') then
		P_DATA:=V_CLIENT_INTER_NAME;
	elsif p_info in ('К_Адрес', 'К_Адрес1') then
		P_DATA:=V_CLIENT_ADDRESS;
	elsif p_info='К_ОКПО' then
		P_DATA:= V_CLIENT_KOD_OKPO;
	elsif p_info='К_ИНН' then
		P_DATA:= V_CLIENT_INN;
	elsif p_info='К_КПП' then
		P_DATA:= V_CLIENT_KPP;
	elsif p_info='К_ОГРН' then
		P_DATA:= V_CLIENT_OGRN;
	elsif p_info='К_ВидДеятельности' then	
		P_DATA:= V_CLIENT_BUSINESS;
	elsif p_info in ('Б_ОснованиеДействия', 'Б_ОснованиеДействия1', 'Б_ОснованиеДействия2') then
		P_DATA:= V_BANK_FOUND;
	elsif p_info in ('К_ОснованиеДействия','К_ОснованиеДействия1','К_ОснованиеДействия2') then		
		P_DATA:= nvl(V_CLIENT_FOUND,'Устава'); 
	elsif p_info in ('Б_ДолжностьРуководит','Б_ДолжностьРуковод_1','Б_ДолжностьРуковод_2')  then
		P_DATA:= V_BANK_CHIEF_RANGE;
	elsif p_info in ('Б_ДолжностьРуководР', 'Б_ДолжностьРуководР1', 'Б_ДолжностьРуководР2') then
		P_DATA:= V_BANK_CHIEF_RANGE_R;
	elsif p_info in ('Б_ФИОРуководителя', 'Б_ФИОРуководителя1', 'Б_ФИОРуководителя2') then
		P_DATA:= V_BANK_CHIEF_NAME;
	elsif p_info in ('Б_ФИОРуководКрат', 'Б_ФИОРуководКрат1', 'Б_ФИОРуководКрат2') then
		P_DATA:= Get_Short_FIO(V_BANK_CHIEF_NAME);
	elsif p_info in ('Б_ПодрРуковод', 'Б_ПодрРуковод_1', 'Б_ПодрРуковод_2') then
		P_DATA:= V_DEPART_USER;
	elsif p_info in ('Б_ПодрРуковод_', 'Б_ПодрРуковод_1_', 'Б_ПодрРуковод_2_') then 
		P_DATA:= V_DEPART_USER_;
    elsif p_info in ('Б_АдрПодрРуковод') then 
		P_DATA:= V_ADR_DEP_USER;
	elsif p_info='Б_ДолжностьБухгалтер' then
		P_DATA:= V_BANK_BUH_RANGE;
	elsif p_info='Б_ФИОБухгалтера' then
		P_DATA:= V_BANK_BUH_NAME;
	elsif p_info in ('К_ДолжностьРуководит', 'К_ДолжностьРуковод_1', 'К_ДолжностьРуковод_2') then
		P_DATA:= V_CL_CHIEF_RANGE;
	elsif p_info in ('К_ДолжностьРуководР', 'К_ДолжностьРуководР1', 'К_ДолжностьРуководР2') then
		P_DATA:= V_CL_CHIEF_RANGE_R;
	elsif p_info in ('К_ФИОРуководителя', 'К_ФИОРуководителя1', 'К_ФИОРуководителя2') then
		P_DATA:= V_CL_CHIEF_NAME;
		
	elsif p_info in ('К_ФИОРуководКрат', 'К_ФИОРуководКрат1', 'К_ФИОРуководКрат2') then
		P_DATA:= Get_Short_FIO(V_CL_CHIEF_NAME);
		
	elsif p_info='К_ФИОБухгалтера' then
		P_DATA:= V_CL_BUH_NAME;
	elsif p_info in ('Б_ВыборОкончания','Б_ВыборОкончания1','Б_ВыборОкончания2') then
		P_DATA:= V_BANK_END;
	elsif p_info in ('К_ВыборОкончания', 'К_ВыборОкончания1', 'К_ВыборОкончания2') then
		P_DATA:= V_CLIENT_END;
	elsif p_info='Остаток' then
		P_DATA:= V_ACCOUNT_REST;
	elsif  p_info='Остаток_проп' then
		P_DATA:= stdlib.n2str(V_ACCOUNT_REST,V_CONTRACT_CUR_SHORT);		
	elsif p_info='НомераЧеков' then
		P_DATA:= V_NN_CHECKS;
	elsif p_info='ТипРасчетногоСчета' then
		P_DATA:= V_TYPE_ACCOUNT;
	elsif p_info in ('ДатаОткрытияСчета', 'ДатаОткрытияСчета1', 'ДатаОткрытияСчета2') then
		P_DATA:= to_char(V_OPEN_ACCOUNT, 'DD.MM.YYYY');
	elsif p_info in ('ДатаЗакрытияСчета', 'ДатаЗакрытияСчета1', 'ДатаЗакрытияСчета2') then
		P_DATA:= to_char(V_CLOSE_ACCOUNT, 'DD.MM.YYYY');
	elsif p_info='Б_РКЦ' then
	    if(V_FILIAL='Головной Офис') then P_DATA:= replace(V_BANK_RKC,'БАНКА РОССИИ ПО', 'Банка России по');
	    else
		P_DATA:= INITCAP(replace(upper(V_BANK_RKC),'ОТДЕЛЕНИЕ','отделении')); --V_BANK_RKC; для совместимости
	    end if;
	elsif p_info='Б_Контакты' then
		P_DATA:= V_BANK_CONTACTS;
	elsif p_info='К_Контакты' then
		P_DATA:= replace(replace(V_CLIENT_CONTACTS,'Телефон:'),'');
	elsif p_info='К_ФормаСобственности' then
		P_DATA:= V_OWNERSHIP;
	elsif p_info='К_ФормСобст_Наимен' then
		P_DATA:= V_OWN_NAME;
	elsif p_info like 'К_НаименованиеР%' then
		P_DATA:= V_CLIENT_NAME_R;
	elsif p_info='К_НаименованиеД' then
		P_DATA:= V_CLIENT_NAME_D;
	elsif p_info='Б_НаименованиеР' then
		P_DATA:= V_BANK_NAME_R;
	elsif p_info='Б_НаименованиеД' then
		P_DATA:= V_CLIENT_NAME_D;
	elsif p_info like 'Ответственный%' then
		P_DATA:= V_ACCOUNT_OTV;
	--<asankulov
	elsif p_info in ('К_Представитель', 'К_Представитель1', 'К_Представитель2') then
		P_DATA:= V_LINK_CL_PRED_NAME;
	elsif p_info in ('К_Пред_ГР', 'К_Пред_ГР1', 'К_Пред_ГР2') then
		P_DATA:= V_LINK_CL_PRED_DATE_PERS;
	elsif p_info in ('К_Пред_МР', 'К_Пред_МР1', 'К_Пред_МР2') then
		P_DATA:= V_LINK_CL_PRED_BORN;
	elsif p_info in ('К_Пред_Пол', 'К_Пред_Пол1', 'К_Пред_Пол2') then
		P_DATA:= V_LINK_CL_PRED_SEX;
	elsif p_info in ('К_Пред_Гражд', 'К_Пред_Гражд1', 'К_Пред_Гражд2') then
		P_DATA:= V_LINK_CL_PRED_COUNTRY;
	elsif p_info in ('К_Пред_Пасп', 'К_Пред_Пасп1', 'К_Пред_Пасп2') then
		P_DATA:= V_LINK_CL_PRED_DOC;
	elsif p_info in ('К_Пред_Адр', 'К_Пред_Адр1', 'К_Пред_Адр2') then
		P_DATA:= V_LINK_CL_PRED_ADR;
	elsif p_info in ('К_Пред_Довер', 'К_Пред_Довер1', 'К_Пред_Довер2') then
		P_DATA:= V_LINK_CL_PRED_DOV;
	--->
	elsif p_info='Подразделение' then
        if V_DEPART_CODE like '001-00%'then 
          P_DATA:='';
	    else 
	      P_DATA:= V_DEPART;
	    end if;
	elsif p_info='УчастникРасчетов' then
		P_DATA:= V_PART;
	elsif p_info='Филиал' then
	    if(V_FILIAL='001') then P_DATA:='';
			P_DATA:= V_FILIAL;
	    end if;
	elsif p_info = 'СчетУдРКО' then
		P_DATA:= V_CHARGES_ACC;
		V_CHARGES_ACC := null;
	elsif p_info = 'ПодраздУдРКО' then
		P_DATA:= V_DEPART_CHARGES_ACC;		
		V_DEPART_CHARGES_ACC := null;
	elsif p_info = 'К_СерияУ'
	      or p_info like 'К_СерияУ%' then
		p_data := V_CERT_SER;
	elsif p_info like 'К_НомерУ%' then
		p_data := V_CERT_NUM;
    elsif  p_info like 'К_ТипУ%' then
		p_data := cert_type;
	elsif  p_info like 'К_КемВыдан%' then
		p_data := V_CERT_WHO;
	elsif  p_info like 'К_ДатаВыдачи%' then
		p_data := to_char (V_CERT_DATE, 'DD.MM.YYYY');
	elsif p_info like 'К_КодПодразделения%' then
		p_data := V_CERT_DEP_CODE;
-->>>>>>>>>>>>>>> Курганов А.В.		
	elsif p_info = 'Б_АДР_ТЕЛ' then
		p_data := temp;
	elsif p_info = 'Б_РЕКВ_СВИФТ' then
		var rek_swift memo;		
/*------ реквизиты устарели	but	
		if kod_val='EUR'
			then rek_swift := 	'Реквизиты для перечислений в евро (Standard instructions for remittance of EURO)'||chr(10)||
								chr(10)||
								'Intermediary Bank           : VTB BANK (DEUTSCHLAND) AG'||chr(10)||
								'(банк - корреспондент)   FRANKFURT AM MAIN, GERMANY'||chr(10)||
 								'SWIFT code                       : OWHBDEFF'||chr(10)||
								chr(10)||
								'Beneficiary`s Bank           : PROMSELHOZBANK Ltd. (INDUSTRIAL AGRICULTURAL BANK LIMITED)'||chr(10)||
								'(банк получателя)            MOSCOW, RUSSIA'||chr(10)||
								'Account No. (№ счета)  : 0105426399'||chr(10)||
                                'SWIFT code                      : PSHBRUMM';
		elsif kod_val='USD'
			then rek_swift := 	'Реквизиты для перечислений в Долларах США (Standard instructions for remittance of USD)'||chr(10)||
								chr(10)||
								'Intermediary Bank           : FOREIGN ECONOMIC INDUSTRIAL'||chr(10)||
								'(банк - корреспондент)   BANK MOSCOW, RUSSIA'||chr(10)||
 								'SWIFT code                       : FECIRUMM'||chr(10)||
								chr(10)||
								'Beneficiary`s Bank           : PROMSELHOZBANK Ltd. (INDUSTRIAL AGRICULTURAL BANK LIMITED)'||chr(10)||
								'(банк получателя)            MOSCOW, RUSSIA'||chr(10)||
								'Account No. (№ счета)  : 30109840000000005808'||chr(10)||
                                'SWIFT code                      : PSHBRUMM';
---------*/

		if kod_val='EUR'
			then rek_swift := 	'Реквизиты для перечислений в ЕВРО (Standard instructions for remittance of EURO)'||chr(10)||
								'Intermediary Bank           : SVIAZ-BANK OAO'||chr(10)||
								'(банк - корреспондент)   MOSCOW, RUSSIA'||chr(10)||
 								'SWIFT code                       : SVIZRUMM'||chr(10)||
								'Beneficiary`s Bank           : PROMSELHOZBANK Ltd. (INDUSTRIAL AGRICULTURAL BANK LIMITED)'||chr(10)||
								'(банк получателя)            MOSCOW, RUSSIA'||chr(10)||
								'Account No. (№ счета)  : 30109978500000000538'||chr(10)||
                                'SWIFT code                      : PSHBRUMM';
		elsif kod_val='USD'
			then rek_swift := 	'Реквизиты для перечислений в Долларах США (Standard instructions for remittance of USD)'||chr(10)||
								chr(10)||
								'Intermediary Bank           : SVIAZ-BANK OAO'||chr(10)||
								'(банк - корреспондент)   BANK MOSCOW, RUSSIA'||chr(10)||
 								'SWIFT code                       : SVIZRUMM'||chr(10)||
								chr(10)||
								'Beneficiary`s Bank           : PROMSELHOZBANK Ltd. (INDUSTRIAL AGRICULTURAL BANK LIMITED)'||chr(10)||
								'(банк получателя)            MOSCOW, RUSSIA'||chr(10)||
								'Account No. (№ счета)  : 30109840900000000538'||chr(10)||
                                'SWIFT code                      : PSHBRUMM';


		elsif kod_val='GBP'
			then rek_swift := 	'Реквизиты для перечислений в британских фунтах стерлингов (Standard instructions for remittance of GBP)'||chr(10)||
								chr(10)||
								'Intermediary Bank           : VTB BANK (DEUTSCHLAND) AG'||chr(10)||
								'(банк - корреспондент)   FRANKFURT AM MAIN, GERMANY'||chr(10)||
 								'SWIFT code                       : OWHBDEFF'||chr(10)||
								chr(10)||
								'Beneficiary`s Bank           : PROMSELHOZBANK Ltd. (INDUSTRIAL AGRICULTURAL BANK LIMITED)'||chr(10)||
								'(банк получателя)            MOSCOW, RUSSIA'||chr(10)||
								'Account No. (№ счета)  : 0105426431'||chr(10)||
                                'SWIFT code                      : PSHBRUMM';
		elsif kod_val='CHF'
			then rek_swift := 	'Реквизиты для перечислений в швейцарских франках (Standard instructions for remittance of CHF)'||chr(10)||
								chr(10)||
								'Intermediary Bank           : VTB BANK (DEUTSCHLAND) AG'||chr(10)||
								'(банк - корреспондент)   FRANKFURT AM MAIN, GERMANY'||chr(10)||
 								'SWIFT code                       : OWHBDEFF'||chr(10)||
								chr(10)||
								'Beneficiary`s Bank           : PROMSELHOZBANK Ltd. (INDUSTRIAL AGRICULTURAL BANK LIMITED)'||chr(10)||
								'(банк получателя)            MOSCOW, RUSSIA'||chr(10)||
								'Account No. (№ счета)  : 0105426423'||chr(10)||
                                'SWIFT code                      : PSHBRUMM';
		else rek_swift := null;
		end if;
		p_data := rek_swift;

	elsif p_info = 'К_ФИО_РУК_Д' then
		p_data :=cli_fio_ruk_dat;	
	elsif p_info = 'К_ДОЛ_РУК_Д' then
		p_data :=cli_dol_ruk_dat;
	elsif p_info = 'К_НЭЙМ' then
		p_data :=cli_short;
	elsif p_info='ТранзСчетОнли' then
		if V_ACC_TRANS is not null then P_DATA:='транзитный счет № '||V_ACC_TRANS;end if;
--<<<<<<<<<<<<<<		
	end if;
	--debug_pipe(substr('<--'||rpad(P_INFO,26)||'="'||p_data||'"',1,2000),dp2);
end;
PSH_PRINT_WORD (
	@name('Имя файла')                      P_FILE_NAME    in [STRING_100],
	@name('Первая подпись (руководитель)')  P_SIGN_CHIEF   in [USER_REF],
	@name('Вторая подпись (гл. бухгалтер)') P_SIGN_BUH     in [USER_REF],
	@name('Шаблон документа')               P_SHABLON      in [SHABLON_DOC_REF] default null,
	@name('Первая подпись (руководитель)')  P_SIGN_CHIEF_D in [PERSONS_POS_REF] default null,
	@name('Вторая подпись (гл. бухгалтер)') P_SIGN_BUH_D   in [PERSONS_POS_REF] default null
) is

validate is
begin
	if p_message = 'DEFAULT' then
		V_DEPART_USER := null;
		v_client_class := this.[CLIENT]%class;
		path := [SYSTEM_PARAMS]::[GET]('PATH_PRINT_DOC',null);
		P_FILE_NAME := def_file_name;
		
		init_data(this);

	    P_SHABLON:=	::[DEFVALS].[SLIB].RestoreRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SHABLON');
	
		V_DESTINATION_0 = V_DESTINATION.[0] :=nvl(::[DEFVALS].[SLIB].RestoreNum(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'V_DESTINATION'),false);
		P_SIGN_CHIEF      :=::[DEFVALS].[SLIB].RestoreRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SIGN_CHIEF');
		P_SIGN_BUH        :=::[DEFVALS].[SLIB].RestoreRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SIGN_BUH');
		
			V_BANK_CHIEF_RANGE  := P_SIGN_CHIEF.[CASTA].[VALUE];
			V_BANK_CHIEF_RANGE_R := ::[CASE_GRAM].[LIB].get_case (P_SIGN_CHIEF.[CASTA].[DECL_CAST], ::[CASE_GRAM]([CODE]='Р'));
			V_BANK_CHIEF_NAME   := nvl(P_SIGN_CHIEF.[CL_PRIV_REF].[NAME], P_SIGN_CHIEF.[NAME]);
			V_BANK_CHIEF_NAME_R := nvl([CASE_GRAM].[LIB].get_case(P_SIGN_CHIEF.[CL_PRIV_REF].[DECL_FIO]), P_SIGN_CHIEF.[NAME]);
			V_BANK_CHIEF_NAME_D := nvl([CASE_GRAM].[LIB].get_case(P_SIGN_CHIEF.[CL_PRIV_REF].[DECL_FIO],::[CASE_GRAM]([CODE]='Д')), P_SIGN_CHIEF.[NAME]);
			V_BANK_END          := end_str(P_SIGN_CHIEF.[CL_PRIV_REF].[SEX]);

		
		P_SIGN_CHIEF_D    :=::[DEFVALS].[SLIB].RestoreRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SIGN_CHIEF_D');
		P_SIGN_BUH_D      :=::[DEFVALS].[SLIB].RestoreRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SIGN_BUH_D');		
		
		if V_DESTINATION.[0]=2 then
		   
			V_DEPART_USER       :=null;--Б_ПодрРуковод
			V_DEPART_USER_		:=null;
			V_ADR_DEP_USER		:=null;

			V_BANK_CHIEF_RANGE  :=P_SIGN_CHIEF_D.[RANGE].[VALUE]; --Врио Председателя Правления
			V_BANK_CHIEF_NAME   :=P_SIGN_CHIEF_D.[FASE].[NAME];   --Гулова Мария Михайловна
			V_BANK_CHIEF_RANGE_R:=::[CASE_GRAM].[LIB].get_case (P_SIGN_CHIEF_D.[RANGE].[DECL_CAST], ::[CASE_GRAM]([CODE]='Р'));
			V_BANK_CHIEF_NAME_R :=nvl([CASE_GRAM].[LIB].get_case(P_SIGN_CHIEF_D.[FASE].[DECL_FIO]), P_SIGN_CHIEF_D.[FASE].[NAME]);                          
			V_BANK_CHIEF_NAME_D :=nvl([CASE_GRAM].[LIB].get_case(P_SIGN_CHIEF_D.[FASE].[DECL_FIO],::[CASE_GRAM]([CODE]='Д')), P_SIGN_CHIEF_D.[FASE].[NAME]);
			V_BANK_END 			:= end_str(P_SIGN_CHIEF_D.[FASE].[SEX]);--Б_ВыборОкончания
			--Б_ОснованиеДействия
			for b in P_SIGN_CHIEF_D.[BY_RIGHT]
			where nvl(b.[DATE_END],op_d) >= op_d
			and (b.[CLASS_DOG] is null or b.[CLASS_DOG] = this%class)
			order by b.[CLASS_DOG]
			loop
				V_BANK_FOUND := [CASE_GRAM].[LIB].get_case(b.[DECLENSIONS]);
				exit;
			end loop;
			
			if V_BANK_FOUND is null then
				for usr in ::[USER]
				where usr.[CL_PRIV_REF] = P_SIGN_CHIEF_D.[FASE]
				loop
					for b in usr.[BY_RIGHT]
					where nvl(b.[DATE_END],op_d) >= op_d
					and (b.[CLASS_DOG] is null or b.[CLASS_DOG] = this%class)
					order by b.[CLASS_DOG]
					loop
						V_BANK_FOUND := [CASE_GRAM].[LIB].get_case(b.[DECLENSIONS]);
						exit;
					end loop;
				end loop;
			end if;
		end if;

		p_info := 'P_SHABLON, P_SIGN_CHIEF, P_SIGN_CHIEF_D, P_SIGN_BUH, P_SIGN_BUH_D, OK';
		
	elsif p_message = 'VALIDATE' then
		V_DATA := ' ';
		if p_info = 'P_SHABLON' then
			P_FILE_NAME := path||P_SHABLON.[FILE_NAME];
		elsif p_info = 'REPORTFILE' then
			V_DATA := P_SHABLON.[FILE_NAME];
		elsif p_info = 'REPORTPATH' then
			V_DATA := path;		
		elsif p_info = 'P_SIGN_CHIEF' then
			V_BANK_CHIEF_RANGE  := P_SIGN_CHIEF.[CASTA].[VALUE];
			V_BANK_CHIEF_RANGE_R := ::[CASE_GRAM].[LIB].get_case (P_SIGN_CHIEF.[CASTA].[DECL_CAST], ::[CASE_GRAM]([CODE]='Р'));
			V_BANK_CHIEF_NAME   := nvl(P_SIGN_CHIEF.[CL_PRIV_REF].[NAME], P_SIGN_CHIEF.[NAME]);
			V_BANK_CHIEF_NAME_R := nvl([CASE_GRAM].[LIB].get_case(P_SIGN_CHIEF.[CL_PRIV_REF].[DECL_FIO]), P_SIGN_CHIEF.[NAME]);
			V_BANK_CHIEF_NAME_D := nvl([CASE_GRAM].[LIB].get_case(P_SIGN_CHIEF.[CL_PRIV_REF].[DECL_FIO],::[CASE_GRAM]([CODE]='Д')), P_SIGN_CHIEF.[NAME]);
			V_BANK_END          := end_str(P_SIGN_CHIEF.[CL_PRIV_REF].[SEX]);
		--	if p_sign_chief.[DEPART].[CODE]<> '001-00-01' then
			if substr(p_sign_chief.[DEPART].[CODE],1,3)<> '001' then
				V_DEPART_USER 		:= ::[DEPART].[LIB].get_declension(P_SIGN_CHIEF.[DEPART]);
				V_DEPART_USER_ 		:= P_SIGN_CHIEF.[DEPART].[Name];
			
			
			 VAR PSH_PODR ref [PSH_SPRAV_PODR];
			begin
				select x (x) in ::[PSH_SPRAV_PODR]
				--where (x.[PSH_PODR_DEPART].[CODE]  = substr(P_DEPN.[DEPART].[CODE],1,instr(P_DEPN.[DEPART].[CODE],'-',1,2)-1)
				where x.[PSH_PODR_DEPART].[CODE]  = p_sign_chief.[DEPART].[CODE] into PSH_PODR;

            V_ADR_DEP_USER:= PSH_PODR.[PSH_PODR_ADRES];
            --V_CONT_DEP_USER:=GetContacts(PSH_PODR.[PSH_PODR_CONTAKT]);

                   exception when no_data_found then
			                 V_ADR_DEP_USER:=null;
                             --V_CONT_DEP_USER:=null;
			end;

--            V_ADR_DEP_USER:= PSH_PODR.[PSH_PODR_ADRES];
			
			
			else
				v_depart_user := null;
			end if;
			-- найти пользователя в должностных лицах и на "Действует на основании" взять оттуда
			-- если не заполнено, или нет в должностных лицах, тогда из пользователя.
			v_bank_found := get_by_right(P_SIGN_CHIEF, THIS);
		elsif p_info = 'P_SIGN_CHIEF_D' then
			V_BANK_CHIEF_RANGE  := P_SIGN_CHIEF_D.[RANGE].[VALUE];
			V_BANK_CHIEF_RANGE_R := ::[CASE_GRAM].[LIB].get_case (P_SIGN_CHIEF_D.[RANGE].[DECL_CAST], ::[CASE_GRAM]([CODE]='Р'));
			V_BANK_CHIEF_NAME   := P_SIGN_CHIEF_D.[FASE].[NAME];
			V_BANK_CHIEF_NAME_R :=[CASE_GRAM].[LIB].get_case(P_SIGN_CHIEF_D.[FASE].[DECL_FIO]);
			V_BANK_CHIEF_NAME_D :=[CASE_GRAM].[LIB].get_case(P_SIGN_CHIEF_D.[FASE].[DECL_FIO],::[CASE_GRAM]([CODE]='Д'));
			V_BANK_END          := end_str(P_SIGN_CHIEF_D.[FASE].[SEX]);
			-- найти пользователя в должностных лицах и на "Действует на основании" взять оттуда
			-- если не заполнено, или нет в должностных лицах, тогда из пользователя.
			v_bank_found := get_by_right(null, THIS, P_SIGN_CHIEF_D);			
		elsif p_info = 'P_SIGN_BUH' then
			V_BANK_BUH_NAME    := nvl(P_SIGN_BUH.[CL_PRIV_REF].[NAME], P_SIGN_BUH.[NAME]);
			V_BANK_BUH_RANGE   := P_SIGN_BUH.[CASTA].[VALUE];
		elsif p_info = 'P_SIGN_BUH_D' then
		    --debug_pipe('P_SIGN_BUH_D ' || to_char(sysdate,'hh:mi:ss'),0);
			V_BANK_BUH_NAME    := P_SIGN_BUH_D.[FASE].[NAME];
			V_BANK_BUH_RANGE   := P_SIGN_BUH_D.[RANGE].[VALUE];	
		elsif p_info = 'OK' then
		    --debug_pipe('OK ' || to_char(sysdate,'hh:mi:ss'),0);
			chk_pers(P_SIGN_CHIEF, P_SIGN_BUH, this, bank);
		end if;
		generate_data(P_INFO, V_DATA);
		--debug_pipe(substr('<<<'||rpad(P_INFO,26)||'="'||V_DATA||'"',1,2000),dp1);
 	end if;
	
end;

execute is
begin
	def_file_name := null;
	::[DEFVALS].[SLIB].saveNum(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'V_DESTINATION', V_DESTINATION.[0]);
	
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SHABLON', P_SHABLON, 'SHABLON_DOC');
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SIGN_CHIEF', P_SIGN_CHIEF, 'USER');
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SIGN_BUH', P_SIGN_BUH, 'USER');
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SIGN_CHIEF_D', P_SIGN_CHIEF_D, 'PERSONS_POS');
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SIGN_BUH_D', P_SIGN_BUH_D, 'PERSONS_POS');

end;
end;
end;
