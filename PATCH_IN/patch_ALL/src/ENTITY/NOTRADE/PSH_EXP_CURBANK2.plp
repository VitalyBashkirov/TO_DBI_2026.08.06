class NOTRADE;

@import_plsql(true)
@query(reversed_table_list:=false)
@this(plsql_lock:=false)
@name('[ПСБ] Экспорт текущих курсов (+ курсы ЦБ)')
@tag('COPIED')
method PSH_EXP_CURBANK2 is

@name('Клиент-скрипт') public V_VB [STRING_32000];
public codepage const varchar2(16) := 'utf-8';-- 'WINDOWS-1251';
pragma macro ('xml','[XML_DB]');
pragma include(::[RUNTIME].[DEBUG_MACRO]);

-- Башкиров В.Г. 21.07.2025 Настройки. PSB_ACTIV_NOTRADE-[ПСБ] Действующие кассы. '00100','00113'
sPsbActivNotrade string(1024):=::[FP_TUNE].[LIB].get_str_value('PSB_ACTIV_NOTRADE', null, '0');

--tmpLocalPath [FILE$PATH]:='L:\CFT\BANKI_RU\TMP'; --Башкиров В.Г. 18.07.2025 CFT-2099 (для отладки)
tmpLocalPath [FILE$PATH]:='L:\CFT\BANKI_RU';	-- +см. в Теле file_path

dp number:=10;	--управление debug_pipe
NineCnt string(16):='99999999999.9999';

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

--Башкиров В.Г. 18.06.2019 71 -> 71.0000
function normal(n [SUPER_SUMMA]) return string(16) is
begin
	return trim(to_char(n,NineCnt));
end;

--Башкиров В.Г. 27.06.2019 Добавлена выгрузка кросс курсов
function GetCursesCROSS(p_kassa ref [NOTRADE], p_date date) return varchar2(250)
is
vremya date;
temp varchar2(250);
delim varchar2(10):=';'; -- Разделитель	
zapis number:=0;
RateStr string(16);
begin

		for jour_rate in p_kassa.[JOUR_RATE_OPER] where jour_rate.[JOUR_DATE_INPUT] <= p_date --and jour_rate.[JOUR_OPER].[KOD_OPER] = 'CON_OP'
					order by jour_rate.[JOUR_DATE_INPUT] desc
		loop
			vremya:=jour_rate.[JOUR_DATE_INPUT];
			exit;
		end loop;
		temp:='EUR/USD'||delim; --1.1180;1.1340;1;нет
		for jour_rate in p_kassa.[JOUR_RATE_OPER] where jour_rate.[JOUR_DATE_INPUT] = vremya and jour_rate.[JOUR_OPER].[KOD_OPER] = 'CON_OP'
						and jour_rate.[JOUR_CUR].[CUR_SHORT] in ('EUR','USD')
						and jour_rate.[JOUR_CUR_BASE].[CUR_SHORT] in ('USD','EUR')
					order by jour_rate.[JOUR_CUR].[CUR_SHORT]
		loop
			--if jour_rate.[JOUR_CUR].[CUR_SHORT]='EUR' and jour_rate.[JOUR_CUR_BASE].[CUR_SHORT]='USD'
			RateStr:=trim(to_char(jour_rate.[JOUR_RATE],NineCnt));
			if Substr(RateStr,1,1)='.' then RateStr:='0'||RateStr; end if;
			temp:=temp||RateStr||delim;
			zapis:=zapis+1;
		end loop;		
	  --temp:=temp||kolvo||delim||'нет';
if zapis=2 then return(temp);
else return temp||'0;0;0;нет'; --(''); --что то пошло не так
end if;		
end;		



procedure add_text_node(node &xml.DOMNode, xml_doc &xml.DOMDocument, new_node_name varchar2, text varchar2(4000) )is
begin
	if not new_node_name is null and not text is null then
	&xml.appendChild(	&xml.appendChild(node,&xml.makeNode(&xml.createElement(xml_doc, new_node_name))),
							&xml.makeNode(&xml.createTextNode(xml_doc, text)));
	end if;
end;

procedure setAttribute(p_node &xml.DOMElement, p_name varchar2, p_val varchar2(2000)) is
begin
	if not p_name is null and not p_val is null then
		&xml.setAttribute(p_node, p_name, p_val);
	end if;
end;

procedure clob2file(p_file_path varchar2(2000),p_file_name varchar2(2048),cl clob) is
	file		integer;
	buffer		varchar2(32000);
	idx 		integer:=0;
begin
	file := stdio.open(p_file_path, p_file_name,'w');

	buffer:=substr(cl,idx,idx+32000);
    while length(buffer) != 0
    loop
    	stdio.fput(file,buffer,true);
    	idx:=idx+32000;
    	buffer:=substr(cl,idx,idx+32000);
    end loop;
    stdio.close(file);
end;

procedure WriteCurses(p_cur varchar2(4), p_kassa ref [NOTRADE], p_date date, p_xml_doc &xml.DOMDocument, p_node &xml.DOMNode, P_DATETIME [DATE_TIME] default null)
is
currency_elem 	&xml.DOMElement;
currency_node 	&xml.DOMNode;
exchanges_elem 	&xml.DOMElement;
exchanges_node 	&xml.DOMNode;
exchange_elem 	&xml.DOMElement;
exchange_node 	&xml.DOMNode;

tmpInfo string(100);
tmpRateEur string(100);
tmpRateUsd string(100);
begin
	currency_elem := &xml.createElement(p_xml_doc, 'currency');
	currency_node := &xml.makeNode(currency_elem);
	&xml.appendChild(p_node, currency_node);
	setAttribute(currency_elem, 'id', p_cur);
	
	  exchanges_elem := &xml.createElement(p_xml_doc, 'exchanges');
	  exchanges_node := &xml.makeNode(exchanges_elem);
	  &xml.appendChild(currency_node, exchanges_node);	
	
	    exchange_elem := &xml.createElement(p_xml_doc, 'exchange');
	    exchange_node := &xml.makeNode(exchange_elem);
	    &xml.appendChild(exchanges_node, exchange_node);	

		add_text_node(exchange_node, p_xml_doc, 'amount', '1');		
		
		if p_kassa is not null then --Степаненко В.В. 10.06.2019 Добавлена выгрузка курсов ЦБ
			for jour_rate in p_kassa.[JOUR_RATE_OPER] where jour_rate.[JOUR_DATE_INPUT] <= p_date and jour_rate.[JOUR_CUR].[CODE_ISO] = p_cur and
						jour_rate.[JOUR_OPER].[KOD_OPER] = 'BUY_OP' and jour_rate.[JOUR_CUR_BASE].[CUR_SHORT] = 'RUB'
						order by jour_rate.[JOUR_DATE_INPUT] desc
			loop
				add_text_node(exchange_node, p_xml_doc, 'buy', normal(jour_rate.[JOUR_RATE]));
				exit;
			end loop;
		
			for jour_rate in p_kassa.[JOUR_RATE_OPER] where jour_rate.[JOUR_DATE_INPUT] <= p_date and jour_rate.[JOUR_CUR].[CODE_ISO] = p_cur and
						jour_rate.[JOUR_OPER].[KOD_OPER] = 'SEL_OP' and jour_rate.[JOUR_CUR_BASE].[CUR_SHORT] = 'RUB'
						order by jour_rate.[JOUR_DATE_INPUT] desc
			loop
				add_text_node(exchange_node, p_xml_doc, 'sale', normal(jour_rate.[JOUR_RATE]));
				exit;
			end loop;
		
		--Степаненко В.В. 10.06.2019 Добавлена выгрузка курсов ЦБ
		--Башкиров В.Г. 27.06.2019 Добавлена выгрузка кросс курсов
		else
			if P_DATETIME is not null then
				--EUR/USD;0.9990;1.1679;
				tmpInfo:=GetCursesCROSS(::[NOTRADE]([NUM_PK]='00100'), P_DATETIME);
				tmpRateEur:=::[CL_PRIV].[PSH_DATE_DEATH].wbn(tmpInfo,';',2);
				tmpRateUsd:=::[CL_PRIV].[PSH_DATE_DEATH].wbn(tmpInfo,';',3);
				if p_cur='978' then
					add_text_node(exchange_node, p_xml_doc, 'buy',  tmpRateEur);
					add_text_node(exchange_node, p_xml_doc, 'sale', tmpRateUsd);
				else
					add_text_node(exchange_node, p_xml_doc, 'buy',  tmpRateUsd);
					add_text_node(exchange_node, p_xml_doc, 'sale', tmpRateEur);
				end if;
			else
				--Башкиров В.Г. 14.06.2019 курсы ЦБ выдаем до четырех знаков после запятой
				add_text_node(exchange_node, p_xml_doc, 'buy',  normal(round(::[document].lib_cur.get_rate([ft_money]([CODE_ISO]=p_cur),p_date),4)));
				add_text_node(exchange_node, p_xml_doc, 'sale', normal(round(::[document].lib_cur.get_rate([ft_money]([CODE_ISO]=p_cur),p_date),4)));
			end if;
		end if;
end;

function rbc_WriteCurses(p_cur varchar2(4), p_kassa ref [NOTRADE], p_date date, kolvo number default 1) return varchar2(250)
is
temp varchar2(250);
delim varchar2(10):=';'; -- Разделитель	
begin

		for jour_rate in p_kassa.[JOUR_RATE_OPER] where jour_rate.[JOUR_DATE_INPUT] <= p_date and jour_rate.[JOUR_CUR].[CODE_ISO] = p_cur and
					jour_rate.[JOUR_OPER].[KOD_OPER] = 'BUY_OP' and jour_rate.[JOUR_CUR_BASE].[CUR_SHORT] = 'RUB'
					order by jour_rate.[JOUR_DATE_INPUT] desc
		loop
			temp:=temp||jour_rate.[JOUR_CUR].[CUR_SHORT]||'/RUB'||delim||jour_rate.[JOUR_RATE]||delim;
			--file_name :='rbc_cur_'||to_char(jour_rate.[JOUR_DATE_INPUT],'YYYYMMDD_HH24_MI')||'_pshb.csv'; --Имя файла
			exit;
		end loop;
		
		for jour_rate in p_kassa.[JOUR_RATE_OPER] where jour_rate.[JOUR_DATE_INPUT] <= p_date and jour_rate.[JOUR_CUR].[CODE_ISO] = p_cur and
					jour_rate.[JOUR_OPER].[KOD_OPER] = 'SEL_OP' and jour_rate.[JOUR_CUR_BASE].[CUR_SHORT] = 'RUB'
					order by jour_rate.[JOUR_DATE_INPUT] desc
		loop
			temp:=temp||jour_rate.[JOUR_RATE]||delim||kolvo||delim||'нет';
			exit;
		end loop;
return(temp);		
end;

function rbc_WriteCurses_CROSS(p_kassa ref [NOTRADE], p_date date, kolvo number default 1) return varchar2(250)
is
vremya date;
temp varchar2(250);
delim varchar2(10):=';'; -- Разделитель	
zapis number:=0;
begin

		for jour_rate in p_kassa.[JOUR_RATE_OPER] where jour_rate.[JOUR_DATE_INPUT] <= p_date and jour_rate.[JOUR_OPER].[KOD_OPER] = 'CON_OP'
					order by jour_rate.[JOUR_DATE_INPUT] desc
		loop
			vremya:=jour_rate.[JOUR_DATE_INPUT];
			exit;
		end loop;
		temp:='EUR/USD'||delim; --1.1180;1.1340;1;нет
		for jour_rate in p_kassa.[JOUR_RATE_OPER] where jour_rate.[JOUR_DATE_INPUT] = vremya and jour_rate.[JOUR_OPER].[KOD_OPER] = 'CON_OP'
						and jour_rate.[JOUR_CUR].[CUR_SHORT] in ('EUR','USD')
						and jour_rate.[JOUR_CUR_BASE].[CUR_SHORT] in ('USD','EUR')
					order by jour_rate.[JOUR_CUR].[CUR_SHORT]
		loop
			--if jour_rate.[JOUR_CUR].[CUR_SHORT]='EUR' and jour_rate.[JOUR_CUR_BASE].[CUR_SHORT]='USD'
			temp:=temp||jour_rate.[JOUR_RATE]||delim;
			zapis:=zapis+1;
		end loop;		
		temp:=temp||kolvo||delim||'нет';
if zapis=2 then return(temp);
else return(''); --что то пошло не так
end if;		
end;
PSH_EXP_CURBANK2 (
	@name('Файл')        P_FILE     in [FILE$LOAD],
	@name('Время')       P_DATETIME in [DATE_TIME],
	@name('На РБК')      P_RBC      in [BOOLEAN],
	@name('На sarbc.ru') P_SARBC    in [BOOLEAN],
	@name('На banki.ru') P_BANKIRU  in [BOOLEAN]
) is

validate is
Begin
	If p_message = 'DEFAULT' then
		P_BANKIRU:=true;
		
		--P_DATETIME := nvl(::[NOTRADE].[PSH_PRNT_ORD_XML].time_kurs,sysdate)+ (60*15)/86400;--sysdate;
		if ::[NOTRADE].[PSH_PRNT_ORD_XML].time_kurs is not null then
			P_DATETIME := ::[NOTRADE].[PSH_PRNT_ORD_XML].time_kurs;
		else
			for (select j(j.[JOUR_DATE_INPUT]	: JOUR_DATE_INPUT
						 ,j.[NUM_ORDER]			: NUM_ORDER
						 ,j.[USER_ACCEPT]		: USER_ACCEPT
						 )
					in [JOUR_RATE_OPER]
					where j.[DATE_ACCEPT] is not null
					order by j.[JOUR_DATE_INPUT] desc, j.[NUM_ORDER] desc)
			loop
				P_DATETIME := j.[JOUR_DATE_INPUT];
				exit;
			end loop;			
		end if;
		P_DATETIME := nvl(P_DATETIME,sysdate)+ (60*15)/86400;
		
	  --if this.[DEPART].[CODE] not like '001-6%' then
			P_RBC 		:= false;
			P_SARBC 	:= false;
			P_BANKIRU 	:= true;
			csmd.command(V_VB, 'Frame1.Visible = true');
			
			P_FILE.[SRC_TYPE] := true;	--Источник сервер
			P_FILE.[DST_TYPE] := false;	--Приемник клиент
			P_FILE.[DST_PATH] := tmpLocalPath; --'L:\CFT\BANKI_RU'; --'\\ibsorep\reports\BANKI_RU';	--'C:\1'; --'I:\KAV'; --Башкиров В.Г. 13.06.2018 Перенаправил c C:\BANKI_RU на I:\BANKI_RU; --Марчевская А.Н. 26.11.20 поменяла диск I:\ на шару \\ibsorep\reports\
			P_FILE.[DST_MASK] := '*.xml';
			P_FILE.[SRC_PATH] := [SYSTEM_PARAMS]::[GET]('PATH',null);
			--P_FILE.[DST_NAME] := 'cur_'||to_char(sysdate,'YYYYMMDD_HH24MISS')||'.xml';
			P_FILE.[DST_NAME] := 'cur_pshb.xml';
			P_FILE.[SRC_DELETE]:= true;
	  --end if;
		
	  --if this.[FILIAL].[CODE] = '101' then
	  --if this.[DEPART].[CODE] like '001-6%' then
	    if this.[DEPART].[CODE] like '00113' then --Башкиров В.Г. 18.07.2025 CFT-2099
		  --P_RBC 		:= false;	--На РБК
			P_SARBC 	:= true;	--На sarbc.ru
		  --P_BANKIRU 	:= false;	--На banki.ru
		  	if not P_BANKIRU then
		    	csmd.command(V_VB, 'Frame1.Visible = false');
		  	end if;
		end if;

	elsif p_message = 'VALIDATE' then
		if P_INFO = 'P_F.DST_NAME' then
			P_FILE.[SRC_NAME] := P_FILE.[DST_NAME];
		end if;
		
		if P_INFO = 'P_BANKIRU' then
			if P_BANKIRU then
				csmd.command(V_VB, 'Frame1.Visible = true');
				
				P_FILE.[SRC_TYPE] := true;	--Источник сервер
				P_FILE.[DST_TYPE] := false; --Приемник клиент
				P_FILE.[DST_PATH] := tmpLocalPath;	--'L:\CFT\BANKI_RU'; --'\\ibsorep\reports\BANKI_RU';	--'C:\1'; --'I:\KAV'; --Башкиров В.Г. 13.06.2018 Перенаправил c C:\BANKI_RU на I:\BANKI_RU; --Марчевская А.Н. 26.11.20 поменяла диск I:\ на шару \\ibsorep\reports\
				P_FILE.[DST_MASK] := '*.xml';
				P_FILE.[SRC_PATH] := [SYSTEM_PARAMS]::[GET]('PATH',null);
			  --P_FILE.[DST_NAME] := 'cur_'||to_char(sysdate,'YYYYMMDD_HH24MISS')||'.xml';
				P_FILE.[DST_NAME] := 'cur_pshb.xml';
				P_FILE.[SRC_NAME] := P_FILE.[DST_NAME];
				P_FILE.[SRC_DELETE]:= true;
			else
				csmd.command(V_VB, 'Frame1.Visible = false');
			end if;
		end if;
		
	--elsif p_info = 'OK' then
	--	end if;
			
	End if;
End;

execute is
	xml_doc 	&xml.DOMDocument;
	parser 	&xml.Parser;
	main_node	&xml.DOMNode;
	
	group_node 	&xml.DOMNode;
	group_elem  &xml.DOMElement;
	
	office_node 	&xml.DOMNode;
	office_elem &xml.DOMElement;
	
	currencies_node &xml.DOMNode;
	currencies_elem &xml.DOMElement;
	
	f_clob 		CLOB;
	
file_path	[FILE$PATH] :='./PSH/exchange/RBC'; --+см. в Проверке tmpLocalPath
--file_path	[FILE$PATH] :='./PSH/exchange/RBC/TMP'; --Башкиров В.Г. 18.07.2025 CFT-2099 (для отладки)
file_name	[FILE$PATH] :='rbc_cur_pshb.csv'; --Имя файла
file		integer;
v_res integer;
rezult memo;
kassa_imp ref [NOTRADE];

	
begin
	
	if P_BANKIRU then
		debug_pipe('Начало выгрузки курсов на Банки.ру ...',0);
		-- подготовим XML
	    parser := &xml.newParser;
		&xml.parseBuffer(parser, '<?xml version="1.0" encoding="utf-8"?><elm/>');
	    xml_doc := &xml.getDocument(parser);
		main_node := &xml.makeNode(xml_doc);
		
		group_elem:= &xml.createElement(xml_doc, 'group');
		setAttribute(group_elem, 'version', '1.0');
	    group_node := &xml.makeNode(group_elem);
	
		for kassa in ::[NOTRADE] where kassa.[FILIAL].[CODE]='001'
			--and kassa.[DEPART].[CODE] not like '001-6%'
			--and kassa.[NUM_PK] in ('00100', '10102')
			and instr(sPsbActivNotrade,''''||kassa.[NUM_PK]||'''')>0 --Башкиров В.Г. 18.07.2025 CFT-2099
			order by kassa.[KASS_DEP] desc, --Башкиров В.Г. 18.07.2025 CFT-2099 Основная касса идет первой
					 kassa.[NUM_PK]
		loop
			debug_pipe('Касса:'||kassa.[NUM_PK],0);
		--if kassa.[NUM_PK] in ('00102') then kassa_imp:=kassa;end if;
		
			office_elem := &xml.createElement(xml_doc, 'office');
			office_node  := &xml.MakeNode(office_elem);
			setAttribute(office_elem, 'code', iif(kassa.[NUM_PK]='10102','00105',kassa.[NUM_PK]));
			setAttribute(office_elem, 'show_rates', '1');
			
			  currencies_elem := &xml.createElement(xml_doc, 'currencies');
			  currencies_node := &xml.MakeNode(currencies_elem);
			  &xml.appendChild(office_node, currencies_node);
			
			  WriteCurses('840', kassa, P_DATETIME, xml_doc,currencies_node);
			  WriteCurses('978', kassa, P_DATETIME, xml_doc,currencies_node);
			  -->> CFT-2592 subbotin 13.10.2025
			  WriteCurses('784', kassa, P_DATETIME, xml_doc,currencies_node);
			  WriteCurses('156', kassa, P_DATETIME, xml_doc,currencies_node);
			  --<< CFT-2592 subbotin 13.10.2025
			
			&xml.appendChild(group_node, office_node);
		end loop;
			--Степаненко В.В. 10.06.2019 Добавлена выгрузка курсов ЦБ
			office_elem := &xml.createElement(xml_doc, 'office');
			office_node  := &xml.MakeNode(office_elem);
			setAttribute(office_elem, 'code', '99999');
			setAttribute(office_elem, 'show_rates', '0');
			
			  currencies_elem := &xml.createElement(xml_doc, 'currencies');
			  currencies_node := &xml.MakeNode(currencies_elem);
			  &xml.appendChild(office_node, currencies_node);
			
			  WriteCurses('840', null, P_DATETIME, xml_doc,currencies_node);
			  WriteCurses('978', null, P_DATETIME, xml_doc,currencies_node);
			  -->> CFT-2592 subbotin 13.10.2025
			  WriteCurses('784', null, P_DATETIME, xml_doc,currencies_node);
			  WriteCurses('156', null, P_DATETIME, xml_doc,currencies_node);
			  --<< CFT-2592 subbotin 13.10.2025
			
			&xml.appendChild(group_node, office_node);
			
			--Башкиров В.Г. 27.06.2019 Добавлена выгрузка кросс курсов
			if nvl(::[FP_TUNE].[LIB].get_bool_value('PSB_ADD_CROSS'), false) then --PSB_ADD_CROSS-[ПСБ] Добавлять кросс-курс в cur_pshb.xml
				debug_pipe('Добавляем кросс-курсы '||iif(P_FILE.[SRC_TYPE],'На сервер','На клиента')
					||' Путь:'||P_FILE.[SRC_PATH]
					||' Файл:'||P_FILE.[SRC_NAME],0); --'в cur_pshb.xml',0);

				office_elem := &xml.createElement(xml_doc, 'office');
				office_node  := &xml.MakeNode(office_elem);
				setAttribute(office_elem, 'code', '978840');
				setAttribute(office_elem, 'show_rates', '0');
				
				  currencies_elem := &xml.createElement(xml_doc, 'currencies');
				  currencies_node := &xml.MakeNode(currencies_elem);
				  &xml.appendChild(office_node, currencies_node);
				
				--WriteCurses('840', null, P_DATETIME, xml_doc,currencies_node, P_DATETIME);
				  WriteCurses('978', null, P_DATETIME, xml_doc,currencies_node, P_DATETIME);
				
				&xml.appendChild(group_node, office_node);
			end if;
			
		&xml.replaceChild(main_node, group_node, &xml.makeNode(&xml.getDocumentElement(xml_doc)));
	
		dbms_lob.createtemporary(f_clob, false);	
		&xml.writeToClob(xml_doc, f_clob);-- выгрузка в CLOB
		clob2file(P_FILE.[SRC_PATH],P_FILE.[SRC_NAME],f_clob);
		debug_pipe('Курсы успешно выгружены. '||iif(P_FILE.[SRC_TYPE],'На сервер','На клиента')||' Путь:'||P_FILE.[SRC_PATH]||' Файл:'||P_FILE.[SRC_NAME],0);
	
		&xml.freeParser(parser);
		&xml.freeDocument(xml_doc);
		
		--Башкиров В.Г. 15.10.2019 Добавлено сообщение пользователю об отправке		
		stdio.put_line_buf('Для banki.ru подготовлен файл. '||iif(P_FILE.[SRC_TYPE],'На сервере','На клиенте')||' Путь:'||P_FILE.[SRC_PATH]||' Файл:'||P_FILE.[SRC_NAME]);
	else
		debug_pipe('Выгрузка курсов на Банки.ру отключена!',0);
	end if;
	
	kassa_imp := this;
	if P_RBC then
		debug_pipe('Начало выгрузки курсов на РБК по кассе '||kassa_imp.[NUM_PK],0);
		rezult :=rbc_WriteCurses('840', kassa_imp, P_DATETIME)||CHR(13);
		rezult :=rezult||rbc_WriteCurses('840', kassa_imp, P_DATETIME,10000)||CHR(13);
		rezult :=rezult||rbc_WriteCurses('840', kassa_imp, P_DATETIME,30000)||CHR(13);
		rezult :=rezult||rbc_WriteCurses('978', kassa_imp, P_DATETIME)||CHR(13);
		rezult :=rezult||rbc_WriteCurses('978', kassa_imp, P_DATETIME,10000)||CHR(13);
		rezult :=rezult||rbc_WriteCurses('978', kassa_imp, P_DATETIME,30000)||CHR(13);
		rezult :=rezult||rbc_WriteCurses_CROSS( kassa_imp, P_DATETIME)||CHR(13);
		rezult :=rezult||rbc_WriteCurses_CROSS( kassa_imp, P_DATETIME,10000)||CHR(13);
		rezult :=rezult||rbc_WriteCurses_CROSS( kassa_imp, P_DATETIME,30000)||CHR(13);
		
		debug_pipe('rezult('||length(rezult)||')'||rezult,dp);
		debug_pipe('GetCursesCROSS( kassa_imp, P_DATETIME)='||GetCursesCROSS( kassa_imp, P_DATETIME),dp);
		
		file := stdio.open(file_path,file_name, 'w');
		v_res := stdio.write_str(file, rezult, null, stdio.WINTEXT, false);
		if v_res < 0 then
			pragma error ('Ошибка при записи в файл =' || file_path || file_name);
		end if;
		stdio.close(file);
		debug_pipe('Курсы для РБК успешно выгружены. Путь:'||file_path||' Файл:'||file_name,0);
		
		--Башкиров В.Г. 15.10.2019 Добавлено сообщение пользователю об отправке
		stdio.put_line_buf('Для    РБК    подготовлен файл. Путь:'||file_path||' Файл:'||file_name);
	else
		debug_pipe('Выгрузка курсов на РБК отключена!',0);
	end if;
	
	if P_SARBC then
		debug_pipe('Начало отправки курсов на Sarbc.ru по кассе '||this.[NUM_PK],0);
		Stdio.PUT_LINE_BUF('<% CALL NOTRADE PSH_SEND_SARBC ' || this%id || ' %>');
		debug_pipe('Курсы успешно отправлены',0);
	else
		debug_pipe('Отправка курсов на Sarbc.ru отключена!',0);
	end if;
	
	::[NOTRADE].[PSH_PRNT_ORD_XML].time_kurs:=null;	
end;
end;
end;
