class CIT_INTERFACE;

@name('[ПСБ] CRS. Интерфейс создания досье физического лица')
@tag('COPIED')
library PSH_CL_PRIV_INT4 is

pragma include(::[RUNTIME].[MACRO_LIB]);
pragma include(::[CLIENT_INTERFACE].[PRX_CIT]);
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
--public pragma include([CL_PRIV]::[DB_LINK_CLIENT]);
public pragma include([CL_PRIV]::[PSH_DBLINKCLIENT]);
public pragma macro (prx_cit, '::[CLIENT_INTERFACE].[PRX_CIT]');

--Внутреннее представление с текущим запросом (для использования в хуках)
public msg_struct	&prx_cit.data2pack_type;
--Признак выполнения интерфейса
-- at: Переиспользуем переменную из оригинальной операции ::[CIT_INTERFACE].[CL_PRIV_INT].is_starting - !!!
-- at: Используется, как минимум, в ::[CL_PRIV].[DB_LINK_CLIENT] для запуска таймеров выполнения
--public is_starting	boolean;

/*********************************************************************
Таблица кодов ошибок интерфейса обработки запроса
----------------------------------------------------------------------
  Код  |  Описание ошибки
----------------------------------------------------------------------
null   | Передача отклика не предусмотрена настройками
0      | Успешная обработка
1      | Непредусмотренная ошибка интерфейса
2      | Ошибка разбора запроса
3      | Непредусмотренная Ошибка при создании/обновление клиента
4      | Ошибка при поиске клиента
5      | Ошибка при обновлении клиента
6      | Ошибка при создании клиента
*********************************************************************/

/*********************************************************************
Описание структур откликов на создание досье физического лица.
*********************************************************************/
--Отклик на создание досье физического лица
public type AnsClPrivType is record(
							 ID_EXT			Varchar(128)	--ID в принимающей Системе (в ИБСО)
							,ID_INT			Varchar(128)	--ID в передающей Системе (в РБО)
							,RESULT			Varchar(128)	--Результат обработки: accept - клиент создан/обновлен, reject - запрос не обработан
							,MESSAGE_		Varchar(2000)	--Причина отказа  (при RESULT = reject)
							);



/*********************************************************************
Таймеры
*********************************************************************/
type timerCodeTableType is table of varchar2(64) index by integer;
timerCodeTable timerCodeTableType;
type timersTableType is table of number index by varchar2(64);
timersTable timersTableType;
-- локальные
cv_legalChecksTimerCode		const varchar2(12) := 'LEGAL_CHECKS';
cv_overallTimerCode			const varchar2( 7) := 'OVERALL';
cv_sendTimerCode			const varchar2(14) := 'PASS_TO_RETAIL';
-- из DB_LINK_CLIENT
cv_findClientTimerCode		const varchar2(11) := 'FIND_CLIENT';
cv_updateClientTimerCode	const varchar2(13) := 'UPDATE_CLIENT';
cv_regClientTimerCode		const varchar2(10) := 'REG_CLIENT';
cv_callHookTimerCode		const varchar2( 9) := 'CALL_HOOK';
-- стандартные интегратора
cv_deqTimerCode		const varchar2(12) := 'DEQUEUE_TIME'; -- Извлечение сообщения из очереди
cv_enqTimerCode		const varchar2(12) := 'ENQUEUE_TIME'; -- Помещение сообщения в очередь
cv_recTimerCode		const varchar2(12) := 'RECIEVE_TIME'; -- Выполнение процедуры обработки
cv_xinTimerCode		const varchar2(12) := 'XSLT_IN_TIME'; -- Входящая XSLT
cv_getTimerCode		const varchar2(15) := 'GET_STRUCT_TIME'; -- Разбор сообщения
cv_intTimerCode		const varchar2(14) := 'INTERFACE_TIME'; -- Выполнение интерфейса обработки
cv_pckTimerCode		const varchar2( 9) := 'PACK_TIME'; -- Упаковка сообщения
cv_xouTimerCode		const varchar2(13) := 'XSLT_OUT_TIME'; -- Исходящая XSLT
/** Запись с данными таймера.
 * @param stime		Статовая точка отсчёта таймера
 * @param ttime		Время работы таймера
 * @param tcount	Счётчик выполнений таймера (см. параметр p_agg процедуры finish_timer).
 */
type t_timer_rec is record
	( stime number
	, ttime number
	, tcount integer
	);
/** Массив с таймерами. Индекс массива - имя таймера. */
type t_timer_arr is table of t_timer_rec index by varchar2(64);

v_req_vals_err varchar2(2000); -- Информация об ошибке при выполнении функции get_req_vals
v_timers t_timer_arr; -- Массив с таймерами. Индекс массива - имя таймера

--Обработка возвращаемого значения
function check_return(p_error_message varchar2(2000), p_ret_value integer, p_msg_struct &prx_cit.data2pack_type)
return integer
is
begin
	if nvl(::[FP_TUNE].[LIB].get_bool_value('CIT_GEN_ANSWER',::[FP_TUNE].[LIB].set_canons('CIT_BO', p_msg_struct.in_req_ref.[BO]), '0'), true) then
		&out_put_err(p_error_message)
		[CIT_INTERFACE].[CL_PRIV_INT].is_starting := false;
		return p_ret_value;
	else
		if p_error_message is not null then
			p_msg_struct.in_req_ref.[ST] := to_char(p_ret_value);
			&set_memo_r(p_msg_struct.in_req_ref%class,p_msg_struct.in_req_ref,'REQ_DOP_INF',p_error_message)
		else
			p_msg_struct.in_req_ref.[ST] := '0';
		end if;
		[CIT_INTERFACE].[CL_PRIV_INT].is_starting := false;
		return null;
	end if;
end;

--Интерфейс обработки запроса
public function interface(p_msg_struct in out &prx_cit.data2pack_type) return integer is 
ReqClPriv			&lib_cl.ReqClPrivType;
AnsClPriv			AnsClPrivType;
error_message		Varchar2(2000);
ret_value			integer;
cl_priv_ref			ref [CL_PRIV];
vCitObj				ref [CIT_OBJ];
v_time_stats		[CIT_TIME_STATS];
vIsIdentified		boolean := false;
vIsCustomerLocked	boolean := false;
begin
	--start_timer(cv_overallTimerCode);
	&sp(start_int)
	msg_struct := p_msg_struct;
	[CIT_INTERFACE].[CL_PRIV_INT].is_starting:= true;

	--Разбор запроса
	ReqClPriv := getReqClPriv(p_msg_struct, error_message);
	if error_message is not null then
		error_message := 'Ошибка разбора запроса на создания досье физического лица: '||error_message;
		return check_return(error_message,2,p_msg_struct);
	end if;

	--Получение Id клиента в своей системе, если он не был передан
	if ReqClPriv.ID_INT is null and ReqClPriv.ID_EXT is not null then
		&debug('.interface: ::[PSH_ETO_CARD].[LL].lockRequestAwaiting(' || ReqClPriv.ID_EXT || ')', 0)
		if ::[PSH_ETO_CARD].[LL].lockRequestAwaiting(ReqClPriv.ID_EXT, 'interface CRS') is null then
			vIsCustomerLocked := true;
			&debug('.interface: lock aquired', 0)
		end if;

		ReqClPriv.ID_INT := ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getClientFromMapping(ReqClPriv.ID_EXT);
	end if;

	if ReqClPriv.ID_INT is null then
		declare
			vClient		[CL_PRIV];
			vCitObj		ref [CIT_OBJ];
		begin
			vClient%init;
			vClient.[NAME] := ReqClPriv.ID_EXT;
			--vClient.[DEPART] := '';	-- ???
			ReqClPriv.ID_INT := ::[CL_PRIV]%insert(vClient);
			&debug('.interface: created the new client ' || ReqClPriv.ID_EXT || ' with id = ' || ReqClPriv.ID_INT, 0)
		end;
	end if;

	if ReqClPriv.ID_INT is not null then
		--Обработка запроса
		ret_value := &lib_cl.RegClient(ReqClPriv, cl_priv_ref, error_message);
		
		if cl_priv_ref is not null then
			--Формирование записи в истории запросов и соответствии объектов
			--vCitObj := &prx_cit.SetExtID([CL_PRIV]%class, cl_priv_ref, &prx_cit.current_ab, ReqClPriv.ID_EXT, null);
			vCitObj := ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].writeClientToMapping(cl_priv_ref, &prx_cit.current_ab, ReqClPriv.ID_EXT);
			&prx_cit.addHistoryRecord([CL_PRIV]%class, cl_priv_ref%id, p_msg_struct.in_req_ref, null, vCitObj);
	
			--Обновление записи в справочнике синхронизации аналитических систем
			--&prx_cit.DeleteRecord(cl_priv_ref, 'INTERNAL');
			--&prx_cit.AddRecord(cl_priv_ref, ReqClPriv.ID_EXT, Null, &prx_cit.c_client_obj_type, Null, Null, Null, nvl(error_message,'Обновление ОК'));
		end if;
	else
		ret_value := 4;
		error_message := 'Не найден клиент с id во внешней системе ID_EXT = ' || ReqClPriv.ID_EXT || ' в справочнике "Интегратор. Соответствие объектов" [CIT_OBJ].';
	end if;

	--Заполнение структуры отклика
	AnsClPriv.ID_INT := ReqClPriv.ID_EXT;		--ID в RBO
	AnsClPriv.ID_EXT := to_char(cl_priv_ref);	--ID в IBSO
	--Результат обработки: accept - клиент создан/обновлен, reject - запрос не обработан
	if ret_value = 0 then
		AnsClPriv.RESULT	:= 'accept';
		-- Проверки
		if vIsIdentified then
			doLegalChecksClient(cl_priv_ref);
		end if;
	else
		AnsClPriv.RESULT	:= 'reject';
		AnsClPriv.MESSAGE_	:= error_message;
	end if;

	--Формирование отклика
	putAnsClPriv(AnsClPriv);
 
	--finish_timer(cv_overallTimerCode);
	--::[CIT_BO].[TLIB].set_timer(cv_overallTimerCode, get_timer(cv_overallTimerCode));

	if vIsCustomerLocked then
		::[PSH_ETO_CARD].[LL].lockRelease(ReqClPriv.ID_EXT);
		&debug('.interface: ::[PSH_ETO_CARD].[LL].lockRelease(' || ReqClPriv.ID_EXT || ')', 0)
	end if;

	if error_message is not null then
		return check_return(error_message,ret_value,p_msg_struct);
	else
		return check_return(error_message,0,p_msg_struct);
	end if;
exception when others then
	--Причина перехвата others: при возникновении любой ошибки необходимо корректно завершить обработку (записать ответ, вернуть результат обработки в точку вызова)
	&rb(start_int)
	&debug('interface. Стек ошибки: ' || utils.error_stack, 0)
	error_message := substr('Ошибка интерфейса создания досье физического лица: ' || utils.error_stack, 1, 2000);

	--Заполнение структуры отклика
	AnsClPriv.ID_INT := ReqClPriv.ID_EXT;		--ID в RBO
	AnsClPriv.ID_EXT := to_char(cl_priv_ref);	--ID в IBSO
	--Результат обработки: accept - клиент создан/обновлен, reject - запрос не обработан
	if ret_value = 0 then
		AnsClPriv.RESULT	:= 'accept';
	else
		AnsClPriv.RESULT	:= 'reject';
		AnsClPriv.MESSAGE_	:= error_message;
	end if;
	--Формирование отклика
	putAnsClPriv(AnsClPriv);
 
	--finish_timer(cv_overallTimerCode);
	--::[CIT_BO].[TLIB].set_timer(cv_overallTimerCode, get_timer(cv_overallTimerCode));

	if vIsCustomerLocked then
		::[PSH_ETO_CARD].[LL].lockRelease(ReqClPriv.ID_EXT);
	end if;

	return check_return(error_message,1,p_msg_struct);
end;

/*********************************************************************
Функции разбора запросов из формата Интегратора в структуры.
Основные функции.
*********************************************************************/
function latToRusByMid(pStr varchar2) return varchar2 is
begin
	return ::[PSH_ETO_CARD].[PSH_TL].MID_4271_2016(pStr, true);
end;
procedure lat2rus(pStr in out nocopy varchar2) is
begin
	if pStr is not null then
		pStr := latToRusByMid(pStr);
	end if;
end;
--Получение структуры запроса на создание досье физического лица
public function getReqClPriv(p_msg_struct in out &prx_cit.data2pack_type, p_error_msg out varchar2(2000)) return &lib_cl.ReqClPrivType is 
ReqClPriv	&lib_cl.ReqClPrivType;
cl_cnt		integer;
cnt			integer;
value		varchar2(2000);
begin
	&i_get_str('REQ_CL_PRIV',1, cl_cnt, value)
	if cl_cnt < 1 then
		p_error_msg := 'запрос не содержит ни одного физического лица.';
		return null;
	elsif cl_cnt > 1 then
		&i_get_end_coll
		p_error_msg := 'запрос содержит более одного физического лица.';
		return null;
	end if;
	&i_get_bool('CONFORM_EXT_CODE',1, cnt, ReqClPriv.CONFORM_EXT_CODE)
	&i_get_str('ID_EXT',1, cnt, ReqClPriv.ID_INT)
	&i_get_str('ID_INT',1, cnt, ReqClPriv.ID_EXT)
	&debug('ReqClPriv.NAME = ' || ReqClPriv.NAME, 0)
	&debug('ReqClPriv.ID_INT = ' || ReqClPriv.ID_INT, 0)
	&debug('ReqClPriv.ID_EXT = ' || ReqClPriv.ID_EXT, 0)
--	if ReqClPriv.NAME is not null then
		&i_get_str('NAME',1, cnt, ReqClPriv.NAME)
--	else
--		&i_get_str('NAME',1, cnt, ReqClPriv.ID_EXT)
--	end if;
	&i_get_str('LAST_NAME',1, cnt, ReqClPriv.LAST_NAME)
	&i_get_str('FIRST_NAME',1, cnt, ReqClPriv.FIRST_NAME)
	&i_get_str('SUR_NAME',1, cnt, ReqClPriv.SUR_NAME)

	lat2rus(ReqClPriv.NAME);
	lat2rus(ReqClPriv.LAST_NAME);
	lat2rus(ReqClPriv.FIRST_NAME);
	lat2rus(ReqClPriv.SUR_NAME);

	ReqClPriv.ACCS_BANK		:= getAccsBank(p_msg_struct);
	ReqClPriv.ADDRESSES		:= getAddresses(p_msg_struct);
	ReqClPriv.BORN			:= getBorn(p_msg_struct);
	ReqClPriv.CL_OPER		:= getClOper(p_msg_struct);
	&i_get_str('OKONH',1, cnt, ReqClPriv.OKONH)
	&i_get_str('COM_STATUS',1, cnt, ReqClPriv.COM_STATUS)
	ReqClPriv.CONTACTS		:= getContacts(p_msg_struct);
	&i_get_str('COUNTRY',1, cnt, ReqClPriv.COUNTRY)
	&i_get_date('DATE_OP',1, cnt, ReqClPriv.DATE_OP)
	&i_get_date('MODIFY_DATE',1, cnt, ReqClPriv.MODIFY_DATE)
	&i_get_date('DATE_PERS',1, cnt, ReqClPriv.DATE_PERS)
	ReqClPriv.DECL_FIO		:= getDeclFio(p_msg_struct);
	&i_get_str('DEPART',1, cnt, ReqClPriv.DEPART)
	ReqClPriv.DISPOSITS		:= getDisposits(p_msg_struct);
	ReqClPriv.CERTIFICATES	:= getCertificates(p_msg_struct);
	&i_get_str('FAIL_LEVEL',1, cnt, ReqClPriv.FAIL_LEVEL)
	&i_get_str('FAIL_MARK',1, cnt, ReqClPriv.FAIL_MARK)
	&i_get_str('FILIAL',1, cnt, ReqClPriv.FILIAL)
	&i_get_str('GROUP_LINK',1, cnt, ReqClPriv.GROUP_LINK)
	&i_get_str('I_NAME',1, cnt, ReqClPriv.I_NAME)
	&i_get_str('INN',1, cnt, ReqClPriv.INN)
	&i_get_str('SNILS',1, cnt, ReqClPriv.SNILS)
	ReqClPriv.INSPECT		:= getInspects(p_msg_struct);
	&i_get_str('INTERNAL_CODE',1, cnt, ReqClPriv.INTERNAL_CODE)
	&i_get_str('LOW',1, cnt, ReqClPriv.LOW)
	&i_get_str('MARIGE_STATUS',1, cnt, ReqClPriv.MARIGE_STATUS)
	ReqClPriv.NAMES			:= getNames(p_msg_struct);
	&i_get_str('NOTES',1, cnt, ReqClPriv.NOTES)
	&i_get_str('OPER_CHARACTER',1, cnt, ReqClPriv.OPER_CHARACTER)
	&i_get_str('REG_STATUS',1, cnt, ReqClPriv.REG_STATUS)
	&i_get_str('REGISTR_NUM',1, cnt, ReqClPriv.REGISTR_NUM)
	&i_get_bool('RESIDENT',1, cnt, ReqClPriv.RESIDENT)
	&i_get_bool('RESIDENT_VAL',1, cnt, ReqClPriv.RESIDENT_VAL)
	&i_get_str('IPDL_TYPE',1, cnt, ReqClPriv.IPDL_TYPE)
	&i_get_str('SEX',1, cnt, ReqClPriv.SEX)
	&i_get_str('VID_CL',1, cnt, ReqClPriv.VID_CL)
	&i_get_str('CODEWORD',1, cnt, ReqClPriv.CODEWORD)
	ReqClPriv.MIGR_CARD		:= getMigrCards(p_msg_struct);
	ReqClPriv.WORK_ACTIVITY	:= getWorkActivity(p_msg_struct);

	&i_get_str('CRS_INVEST_NATIONALITY'			, 1, cnt, ReqClPriv.CRS_INVEST_NATIONALITY)
	&i_get_str('CRS_TIN'						, 1, cnt, ReqClPriv.CRS_TIN)
	&i_get_str('CRS_TIN_ABSCENCE'				, 1, cnt, ReqClPriv.CRS_TIN_ABSCENCE)
	&i_get_str('CRS_REASON_FOR_TIN_ABSCENCE'	, 1, cnt, ReqClPriv.CRS_REASON_FOR_TIN_ABSCENCE)
	&i_get_str('CRS_SUBREASON_FOR_TIN_ABSCENCE'	, 1, cnt, ReqClPriv.CRS_SUBREASON_FOR_TIN_ABSCENCE)
	&i_get_str('NEED_CHECK'						, 1, cnt, ReqClPriv.NEED_CHECK)

	&i_get_str('PP_FOREIGN_PUBLIC_OFFICIAL'			, 1, cnt, ReqClPriv.PP_FOREIGN_PUBLIC_OFFICIAL)
	&i_get_str('PP_INTERNATIONAL_PUBLIC_OFFICIAL'	, 1, cnt, ReqClPriv.PP_INTERNATIONAL_PUBLIC_OFFICIAL)
	&i_get_str('PP_RUSSIAN_PUBLIC_OFFICIAL'			, 1, cnt, ReqClPriv.PP_RUSSIAN_PUBLIC_OFFICIAL)
	&i_get_str('PP_PURPOSE_OF_RELATIONSHIP'			, 1, cnt, ReqClPriv.PP_PURPOSE_OF_RELATIONSHIP)
	&i_get_str('PP_PURPOSE_OF_ACTIVITY'				, 1, cnt, ReqClPriv.PP_PURPOSE_OF_ACTIVITY)
	&i_get_str('PP_FINANCIAL_STATUS'				, 1, cnt, ReqClPriv.PP_FINANCIAL_STATUS)
	&i_get_str('PP_BUSINESS_REPUTATION'				, 1, cnt, ReqClPriv.PP_BUSINESS_REPUTATION)
	&i_get_str('PP_SOURCE_OF_FUNDS'					, 1, cnt, ReqClPriv.PP_SOURCE_OF_FUNDS)
	&i_get_str('PP_NEED_CHECK'						, 1, cnt, ReqClPriv.PP_NEED_CHECK)


	&i_get_end_coll
	return ReqClPriv;
exception when others then
	--Причина перехвата others: при любой ошибке разбора необходимо вернуть текст ошибки для корректной обработки выше по стеку
	--sp и rb не нужны, так как не производится изменений в БД
	p_error_msg := substr(sqlerrm,1,1900);
	return null;
end;

/*********************************************************************
Функции разбора запросов из формата Интегратора в структуры.
Вспомогательные функции.
*********************************************************************/
--Получение списка счетов в банках
public function getAccsBank(p_msg_struct in out &prx_cit.data2pack_type) return &lib_cl.AccsBankTable is 
AccsBank	&lib_cl.AccsBankTable;
arr_cnt		integer;
cnt			integer;
value		varchar2(2000);
begin
	&i_get_str('ACCS_BANK',1, arr_cnt, value)
	if arr_cnt > 0 then
		for i in 1..arr_cnt
		loop
			&i_get_str('BANK',i, cnt, AccsBank(i).BANK)
			&i_get_date('DATE_BEGIN',i, cnt, AccsBank(i).DATE_BEGIN)
			&i_get_date('DATE_END',i, cnt, AccsBank(i).DATE_END)
			&i_get_str('INN',i, cnt, AccsBank(i).INN)
			&i_get_str('MAIN_V_ID',i, cnt, AccsBank(i).MAIN_V_ID)
			&i_get_str('NAME_ORG',i, cnt, AccsBank(i).NAME_ORG)
			&i_get_str('NOTES',i, cnt, AccsBank(i).NOTES)
			&i_get_bool('PR_FORM',i, cnt, AccsBank(i).PR_FORM)
			&i_get_str('TYPE',i, cnt, AccsBank(i).TYPE_)
			&i_get_str('USH',i, cnt, AccsBank(i).USH)
		end loop;
		&i_get_end_coll
	end if;
	return AccsBank;
end;

--Получение списка адресов
public function getAddresses(p_msg_struct in out &prx_cit.data2pack_type) return &lib_cl.AddressTable is 
Addresses	&lib_cl.AddressTable;
arr_cnt		integer;
cnt			integer;
value		varchar2(2000);
begin
	&i_get_str('ADDRESSES',1, arr_cnt, value)
	if arr_cnt > 0 then
		for i in 1..arr_cnt
		loop
			&i_get_str('ADDR_TYPE',i, cnt, Addresses(i).ADDR_TYPE)
			&i_get_str('COUNTRY',i, cnt, Addresses(i).COUNTRY)
			&i_get_str('KLADR_CODE',i, cnt, Addresses(i).KLADR_CODE)
			&i_get_str('POST_CODE',i, cnt, Addresses(i).POST_CODE)
			&i_get_str('REGION',i, cnt, Addresses(i).REGION)
			&i_get_str('DISTRICT',i, cnt, Addresses(i).DISTRICT)
			&i_get_str('CITY_TYPE',i, cnt, Addresses(i).CITY_TYPE)
			&i_get_str('CITY',i, cnt, Addresses(i).CITY)
			&i_get_str('STREET',i, cnt, Addresses(i).STREET)
			&i_get_str('HOUSE',i, cnt, Addresses(i).HOUSE)
			&i_get_str('KORPUS',i, cnt, Addresses(i).KORPUS)
			&i_get_str('FLAT',i, cnt, Addresses(i).FLAT)
			&i_get_str('IMP_STR',i, cnt, Addresses(i).IMP_STR)
			&i_get_str('REG_PLACE_NAME',i, cnt, Addresses(i).REG_PLACE_NAME)
			&i_get_str('REG_PLACE_CODE',i, cnt, Addresses(i).REG_PLACE_CODE)
		end loop;
		&i_get_end_coll
	end if;
	return Addresses;
end;

--Получение места рождения
public function getBorn(p_msg_struct in out &prx_cit.data2pack_type) return &lib_cl.BornType is 
Born		&lib_cl.BornType;
arr_cnt		integer;
cnt			integer;
value		varchar2(2000);
begin
	&i_get_str('BORN',1, arr_cnt, value)
	if arr_cnt > 0 then
		&i_get_str('COUNTRY',1, cnt, Born.COUNTRY)
		&i_get_str('REGION',1, cnt, Born.REGION)
		&i_get_str('CITY_TYPE',1, cnt, Born.CITY_TYPE)
		&i_get_str('CITY',1, cnt, Born.CITY)
		&i_get_str('KLADR_CODE',1, cnt, Born.KLADR_CODE)
		&i_get_end_coll
	end if;
	return Born;
end;

