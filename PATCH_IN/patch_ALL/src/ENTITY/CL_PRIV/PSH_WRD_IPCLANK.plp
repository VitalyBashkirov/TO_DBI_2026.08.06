@name('Анкета актуальна')                       public V_UPD_ANKETA        [BOOLEAN];
@name('Сообщение')                              public V_MESSAGE           [STRING];
@name('Дата обновления анкеты на дату печати')  public V_DATE_UPD_TO_PRINT [DATE];
@name('Печать на текущую дату?')                public V_LAST_VERSION      [BOOLEAN];
@name('Бенефициар')                             public V_BEN_REF           [CL_PRIV_REF];
@name('Строка с идентификаторами бенефициаров') public V_BEN_STR           [STRING_32000];
@name('Наименование клиента')                   public V_NAME              [SBRF_NAME];
@name('Сохранить на диск')                      public V_SAVE              [BOOLEAN];
public client_org_ref 		ref [CL_ORG] default null;
public cl_org_dolg_fase 	ref [PERSONS_POS] default null; -- ссылка на должностное лицо (в случае индив предпринимателя)

--Башкиров В.Г. 18.04.2019 Добавлен поиск произвольного доп.свойства
