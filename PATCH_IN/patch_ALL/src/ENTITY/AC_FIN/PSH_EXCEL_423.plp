class AC_FIN;

@import_plsql(true)
@this(plsql_lock:=false,assert_null:=false)
@name('[ПСБ] Среднемесячные остатки 423 экспорт в EXCEL')
@tag('COPIED')
batch method PSH_EXCEL_423 is

@name('V_DEST')             public V_DEST       [STRING_32000];
@name('Файл шаблона excel') public P_FILE_EXECL [STRING_512];
@name('Файл для СМС')       public P_FILE_SMS   [STRING_512];

/** /
function GetPhoneSMS(cl ref [CLIENT], AddPlus number default 0) return varchar2;
function get_hour_zone(reg_name varchar2) return string(3);
/**/
--pragma include ('APPAUX_CALLPOINT.COMPILE_LIB');
pragma include(::[RUNTIME].[DEBUG_MACRO]);
dp integer:=0;	--управление debug_pipe
dp2 integer:=null;	--управление debug_pipe

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767))
return  varchar2(32767) is
begin
	if v1 then
	return v2;
	else return v3;
	end if;
end;

function monthNameByNumber(monthNumber number)
return varchar2(200) is
begin
	var str varchar2(200);
	
	if monthNumber = 1 then str := 'январь';
	elsif monthNumber = 2 then str := 'февраль';
	elsif monthNumber = 3 then str := 'март';
	elsif monthNumber = 4 then str := 'апрель';
	elsif monthNumber = 5 then str := 'май';
	elsif monthNumber = 6 then str := 'июнь';
	elsif monthNumber = 7 then str := 'июль';
	elsif monthNumber = 8 then str := 'август';
	elsif monthNumber = 9 then str := 'сентябрь';
	elsif monthNumber = 10 then str := 'октябрь';
	elsif monthNumber = 11 then str := 'ноябрь';
	elsif monthNumber = 12 then str := 'декабрь';
	end if;
	
--	debug_pipe('(Local) monthNameByNumber      monthNumber = '||monthNumber||'   return str = '||str, 0);
	
	return str;
end;

function getAvgBalOnAllClientAcc(idQ number, dateStart date, dateEnd date)
return number is
	type myRecord is record(
		indx		number,
		acFin	[AC_FIN_REF],
		ClientName [NAME]
	);
	type arrAcFin is table of myRecord;
	arrAF1 arrAcFin;
	idx	integer;
	res [SUMMA];
	nn number;
begin
	--debug_pipe('___getMonthBalOnAllClientAcc____', 0);
	res := 0;
	nn:=0;
	for af in ::[AC_FIN] where af.[CLIENT_V]%id = idQ and SubStr(af.[MAIN_V_ID],1,3) in ('423')
	loop
		nn:=nn+1;
		--debug_pipe(nn||' af%id='||af%id||' af.[MAIN_V_ID] = '||af.[MAIN_V_ID], 0);
		arrAF1(nn).indx 	:= nn;
		arrAF1(nn).acFin 	:= af%id;
		arrAF1(nn).ClientName:= af.[CLIENT_V].[NAME];
		--debug_pipe('ARRAY arrAF1 - '||arrAF1(nn).indx||' arrAF1('||nn||').acFin='||arrAF1(nn).acFin||' [MAIN_V_ID]='||arrAF1(nn).acFin.[MAIN_V_ID]||' Клиент:'||arrAF1(nn).ClientName, 0);
	end loop;
	--debug_pipe('ARRAY arrAF1.count='||arrAF1.count, 0);
	
	idx := arrAF1.first;
	while not idx is null loop
		--debug_pipe('ARRAY arrAF1 - idx='||idx, 0);
		--debug_pipe('ARRAY arrAF1 - arrAF1(idx).acFin='||arrAF1(idx).acFin.[MAIN_V_ID], 0);
		res := res + [AC_FIN].[PSH_AVG_MONTH_01].get_avg_saldo_r(arrAF1(idx).acFin,dateStart,dateEnd); -- updated CHANGE_SHORT_NAME PSB_AVG_MONTH_01->PSH_AVG_MONTH_01 24/10/25
		idx := arrAF1.next(idx);
	end loop;
	
	--debug_pipe('___getMonthBalOnAllClientAcc____END     res = '||res, 0);
	return res;
end;





















function getNextMonth(tDate date)
return date is
begin
	var nextMonthDate date;
	var tmpYear number := to_char(tDate,'yyyy');
	var tmpMonth number := to_char(tDate,'mm');
	var tmpDay number := 01;
	
	tmpMonth := tmpMonth + 1;
	if tmpMonth > 12 then
		tmpMonth := 1;
		tmpYear := tmpYear + 1;
	end if;
	
--	debug_pipe('(Local) getNextMonth      nextMonthDate = '||nextMonthDate, 0);
	nextMonthDate := to_date(tmpDay||'.'||tmpMonth||'.'||tmpYear,'dd.mm.yyyy');
--	debug_pipe('(Local) getNextMonth      nextMonthDate = '||nextMonthDate, 0);
	
	return nextMonthDate;
end;

fmt				string(10):='dd/mm/yyyy';
fmtHMS			string(22):='dd/mm/yyyy HH24:MI:SS';
fmt24			string(22):='dd/mm/yyyy HH24:MI:SS';
fmtYYYYMMDD		string(8):='yyyymmdd';
fmtYYYYMMDD_HMS	string(22):='yyyymmdd HH24:MI:SS';

msgErr string(1000);

vPathLocal			string(200);
vPathLocalSms		string(200);
NameFile_OutXlsx	string(200):='Новый_EXCEL_файл_'||to_char(sysdate,fmtYYYYMMDD)||'.xlsx';
NameFile_OutSms		string(200):='Новый_TXT_файл_'||to_char(sysdate,fmtYYYYMMDD)||'.txt';

separate	string(1):=':'; --Разделитель Телефон;Текст СМС
sprtr		string(1):='#'; --Разделитель выч.параметров в тексте сообщений

f_handle integer;
procedure put_f_line(line varchar2(32000)) is
begin
	stdio.put_line(f_handle, line, false, null, stdio.WINTEXT);
end;

PSH_EXCEL_423 (
	@name('C')  P_BEG in [DATE],
	@name('По') P_END in [DATE]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_BEG := [SYSTEM]::[OP_DATE];
	P_END := [SYSTEM]::[OP_DATE];

end if;
-- End initialization of parameters and variables
declare
/*

Пояснения для меня

excel.Merge(2,1,2,countColumns);
excel.Merge( -- Объединение ячеек
	2, -- Начать со 2 строки
	1, -- Начать с 1 колонки
	2, -- До 2 строки
	6  -- До 6 колонки
);

*/

type arrAcFin is table of ref [AC_FIN];
arrAF arrAcFin;

countStrHead	integer := 4; -- сколько строк занято шапкой
counterHead		integer := 1; -- счетчик по строкам для шапки
counterStr		integer := 1; -- счетчик по строкам
countColumns	integer := 4; -- количество постоянных колонок в отчете (В дальнейшем добавится столько колонок сколько задейсвованно месяцов)
totalCountColumns integer;

tmpMonth number; -- Имена сталбцов по месяцам
tmpYear  number; -- Имена сталбцов по месяцам
tmpDate1 date; -- Заполняем среднемесячные остатки (ячейки по столбцам)
DateTimeEnd date; -- В конце для вывода в excel в строку "Сформировано ..."

mainTitle varchar2(30) := 'Среднемесячные остатки';

-- Имена колонок
column01 varchar2(30) := '№';
column02 varchar2(30) := 'Владелец счета';
column03 varchar2(30) := 'ИНН';
column04 varchar2(30) := 'Дата открытия';

tmpStr string(4000);
BoldTrue	boolean:=true;	/* Признак выделения жирным шрифтом */
BoldFalse	boolean:=false;	/* Признак выделения жирным шрифтом */
ItalicTrue	boolean:=true;  /* Признак выделения шрифта курсивом */
ItalicFalse	boolean:=false; /* Признак выделения шрифта курсивом */
p_size_14	number:=14;		/* Размер шрифта */
p_size_12	number:=12;		/* Размер шрифта */
p_size_10	number:=10;		/* Размер шрифта */
p_size_8	number:=8;		/* Размер шрифта */
FontNameNull varchar2(50):=null;	/* Имя фонта */

Allighment_CM	varchar2(10):='CM'; -- Строка симолов-обозначений выравнивания
Allighment_RT	varchar2(10):='RT'; -- Строка симолов-обозначений выравнивания
Allighment_C	varchar2(10):='C';  -- по горизонтали:R-вправо L-влево C-по центру
Allighment_M	varchar2(10):='M';  -- по вертикали:  B-вниз T-вверх M-по центру

iOrientation1 integer:=1;	/* Ориентации страницы. Значения: 1 - Альбомная, 2 - Книжная. */
iOrientation2 integer:=2;	/* Ориентации страницы. Значения: 1 - Альбомная, 2 - Книжная. */

msg string(1000);

lastDayMonth date;
tmpDate date;

begin


	--tel_cc:= replace(trim(::[FP_TUNE].[LIB].get_str_value('PSB_TEL_CALLCENTER')),' ','');
	if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
		
		P_END := [SYSTEM].[OP_DATE];
		P_BEG := [DATEFUN].bom(P_END); -- Взять первый день месяца от даты P_END
		
		excel.Init_Xls;
		stdio.close_all;
		stdio.disable_buf;
		msgErr:=null;
		
		vPathLocal := trim([SYSTEM_PARAMS]::[GET]('PATH_LOCAL', false), '\') || '\';
		
		P_FILE_EXECL := vPathLocal||NameFile_OutXlsx;
		debug_pipe('Будем создавать:'||P_FILE_EXECL, 0);
		
		p_info := 'OK';
		
	elsif P_MESSAGE = 'VALIDATE' then
		if p_info = 'OK' then
			if this.count=0 then
				pragma error('Выберете договор(а)');
			end if;
			
			var beginMonth number := to_char(P_BEG,'mm');
			var endMonth   number := to_char(P_END,'mm');
			
			var beginYear number := to_char(P_BEG,'yyyy');
			var endYear   number := to_char(P_END,'yyyy');
			
			var totalBeginMonth number := beginYear * 12 + beginMonth;
			var totalEndMonth   number := endYear * 12 + endMonth;
			var countMonth      number := totalEndMonth - totalBeginMonth;
			countMonth := countMonth + 1;
			
			debug_pipe('totalBeginMonth = '||totalBeginMonth||'   totalEndMonth = '||totalEndMonth, 0);
			debug_pipe('countMonth = '||countMonth, 0);
			
			if excel.F_Click then
				totalCountColumns := countColumns + countMonth;
				
				excel.F_Click := False;
				-- запуск Excel
				excel.open_file(P_FILE_EXECL, false, true);
				
				-- Первая строка
				debug_pipe(mainTitle, 0);
				excel.write(1,1,mainTitle,BoldTrue,ItalicFalse,p_size_14,FontNameNull,Allighment_CM);
				excel.Merge(1,1,1,countColumns);
				
				-- Вторая строка
				excel.write(2,1,to_char(P_BEG,'dd.mm.yyyy')||' - '||to_char(P_END,'dd.mm.yyyy'),BoldTrue,ItalicFalse,p_size_14,FontNameNull,Allighment_CM);
				excel.Merge(2,1,2,countColumns);
				
				-- Форматирование первыых 4 столбцов
				counterHead:=3;
				excel.write(countStrHead,1,column01,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_CM);
				excel.Set_Column_Width(1,               1,             3);
				
				excel.write(countStrHead,2,column02,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_CM);
				excel.Set_Column_Width(2,               2,             40);
				
				excel.write(countStrHead,3,column03,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_CM);
				excel.Set_Column_Width(3,               3,             14);
				
				excel.write(countStrHead,4,column04,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_CM);
				excel.Set_Column_Width(4,               4,             15);
				--      параметры ->   Номер колонки    не понятный    ширина колонки
				-- ^ Форматирование первыых 4 столбцов
				
				-- Имена сталбцов по месяцам
				tmpDate := P_BEG;
				tmpMonth := to_char(tmpDate,'mm');
				tmpYear := to_char(tmpDate,'yyyy');
				for col in countColumns + 1 .. totalCountColumns
				loop
					excel.write(countStrHead,col,monthNameByNumber(tmpMonth),BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_CM);
					excel.Set_Column_Width(col, col, 15);
					tmpMonth := tmpMonth + 1;
					if tmpMonth > 12 then
						tmpMonth := 1;
					end if;
				end loop;
				-- ^ Имена сталбцов по месяцам
				
				debug_pipe('Сбор данных ______________________ Выбрано '||this.count||' записей', 0);
				--------------------------------------------------------------------------------------------------------------------
				-- ДАЛЕЕ НАПОЛНЯЕМ ТАБЛИЦУ ДАННЫМИ -------------------------------------------------------------------------
				--------------------------------------------------------------------------------------------------------------------
				/* Тут был альтернативный способ обратиться к данным (он в конце - найти по тегу #763546352) */
				
				var Cl ref [CLIENT];
				var kurator01 string := [AC_FIN].[Z1494265900].actual_accountant_name(this(1),to_date(P_END,'dd/mm/yyyy'));
				
				excel.Merge(countStrHead+counterStr,1,countStrHead+counterStr,totalCountColumns);
				excel.write(countStrHead+counterStr,1,kurator01,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_CM);		-- Kurator
				counterStr := counterStr + 1;
				var subCounterStr integer := 1;
				
				var xlsFormula string;
				
				var isMatchID boolean;
				
				for i in this.first..this.last
				loop
					isMatchID := false;
				  --debug_pipe('isMatchID - '||isMatchID, 0);
					if arrAF.count = 0 then
						arrAF(i) := this(i);
					else
						for i1 in arrAF.first..arrAF.last
						loop
							if this(i).[CLIENT_V]%id = arrAF(i1).[CLIENT_V]%id then
								isMatchID := true;
								exit;
							end if;
						end loop;
						
						if isMatchID = false then
							arrAF(arrAF.last + 1) := this(i);
						end if;
					end if;
				end loop;
				
				for i in arrAF.first..arrAF.last
				loop
					debug_pipe(Rpad(i,8)||arrAF(i).[NAME]||' ИНН:'||arrAF(i).[CLIENT_V].[INN], 0);
				end loop;
				
				for i in arrAF.first..arrAF.last
				loop
					Cl:=nvl(arrAF(i).[CLIENT_R],arrAF(i).[CLIENT_V]); -- THIS это AC_FIN
					
					if kurator01 <> [AC_FIN].[Z1494265900].actual_accountant_name(arrAF(i),to_date(P_END,'dd/mm/yyyy'))
					then
						kurator01 := [AC_FIN].[Z1494265900].actual_accountant_name(arrAF(i),to_date(P_END,'dd/mm/yyyy'));
						
						-- Add SUM
						-- excel.Formula(Номер строки           , Номер колонки, формула                            , Сколько ячеек вправо сдублировать формулу, смещение по строке, смещение по столбцу, Сколько ячеек вниз сдублировать формулу, вставлять данные + формат);
						excel.Merge(countStrHead+counterStr,1,countStrHead+counterStr,4);
						excel.write(countStrHead+counterStr,1, 'Итого' ,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_RT);
						xlsFormula := '=SUM(R[-'||(subCounterStr - 1)||']C:R[-1]C)';
						
						for col in countColumns + 1 .. totalCountColumns
						loop
							excel.write(countStrHead+counterStr,col,xlsFormula,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_RT); --excel.Formula
							excel.Set_number_Format(countStrHead+counterStr,col,countStrHead+counterStr,col,2,true);
						end loop;
						counterStr := counterStr + 1;
						excel.Merge(countStrHead+counterStr,1,countStrHead+counterStr,totalCountColumns);
						
						counterStr := counterStr + 1;
						excel.Merge(countStrHead+counterStr,1,countStrHead+counterStr,totalCountColumns);
						-- Kurator
						excel.write(countStrHead+counterStr,1,  kurator01  ,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_CM);
						counterStr := counterStr + 1;
						subCounterStr := 1;
					end if;
					
					-- Колонка 01 № (Номер)
					excel.write(countStrHead+counterStr,1,subCounterStr);
					-- Колонка 02 Владелец счета
					excel.write(countStrHead+counterStr,2,Cl.[NAME]);
					-- Колонка 03 ИНН
					excel.write(countStrHead+counterStr,3,''''||Cl.[INN],BoldFalse,ItalicFalse,p_size_12,FontNameNull,Allighment_RT);
					-- Колонка 04 Дата открытия
					-- Vorobey 20191025 Поменял формат даты по просьбе Абрамовой Юлии
					--excel.write(countStrHead+counterStr,4,''''||to_char(this(i).[DATE_OP],'dd/mm/yyyy'),BoldFalse,ItalicFalse,p_size_12,FontNameNull,Allighment_RT);
					excel.write(countStrHead+counterStr,4,to_char(arrAF(i).[DATE_OP],'dd.mm.yy'),BoldFalse,ItalicFalse,p_size_12,FontNameNull,Allighment_RT);
					
					-- Колонка 05 и далее по месяцам
					-- Заполняем среднемесячные остатки (ячейки по столбцам)
					tmpDate1 := P_BEG;
					var vRow number;
					var nTmp number;
					for col in countColumns + 1 .. totalCountColumns
					loop
						vRow:=countStrHead+counterStr;
						--debug_pipe(Lpad(vRow,6)||' '||Lpad(col,6)||' arrAF('||i||').[CLIENT_V]='||arrAF(i).[CLIENT_V]%id||' '||arrAF(i).[CLIENT_V].[NAME]||
						--	' [DATEFUN].bom(tmpDate1)='||[DATEFUN].bom(tmpDate1)||
						--	' [DATEFUN].eom(tmpDate1)='||[DATEFUN].eom(tmpDate1),0);
						--Ломается на ООО "ТК9.ру"
						nTmp:=getAvgBalOnAllClientAcc(arrAF(i).[CLIENT_V]%id,
							[DATEFUN].bom(tmpDate1),
							[DATEFUN].eom(tmpDate1));
						--debug_pipe('getAvgBalOnAllClientAcc='||nTmp,0);

						excel.write(vRow,col,nTmp);
						
						excel.Set_number_Format(countStrHead+counterStr,col,countStrHead+counterStr,col,2,true);
						tmpDate1 := getNextMonth(tmpDate1);
						if to_char(tmpDate1,'mm.yyyy') = to_char(P_END,'mm.yyyy') then
							tmpDate1 := P_END;
						end if;
					end loop;
					-- ^ Заполняем среднемесячные остатки (ячейки по столбцам)
					
					counterStr := counterStr + 1;
					subCounterStr := subCounterStr + 1;
				end loop;
				
				-- Вставляем последние суммы в конце таблицы
				excel.Merge(countStrHead+counterStr,1,countStrHead+counterStr,4);
				excel.write(countStrHead+counterStr,1, 'Итого' ,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_RT);
				xlsFormula := '=SUM(R[-'||(subCounterStr - 1)||']C:R[-1]C)';
				for col in countColumns + 1 .. totalCountColumns
				loop
					excel.write(countStrHead+counterStr,col,xlsFormula,BoldTrue,ItalicFalse,p_size_12,FontNameNull,Allighment_RT); --excel.Formula
					excel.Set_number_Format(countStrHead+counterStr,col,countStrHead+counterStr,col,2,true);
				end loop;
				-- ^ Вставляем последние суммы в конце таблицы
				
				counterStr:=counterStr+1;
				excel.BORDERS(countStrHead,1,countStrHead+counterStr-1,totalCountColumns,'RLBTVH');  -- рамки
				
				DateTimeEnd:=sysdate;
				tmpStr:='Сформировано '||to_char(DateTimeEnd,fmtHMS)||' ______________________/'||stdlib.UserId.[NAME]||'/';
				debug_pipe(tmpStr, 0);
				excel.Merge(countStrHead+counterStr+1,1,countStrHead+counterStr+1,totalCountColumns);
				excel.write(countStrHead+counterStr+1,1,tmpStr,Boldfalse,ItalicFalse,p_size_10);
				excel.set_orientation(iOrientation2);	--Ориентации страницы. Значения: 1 - Альбомная, 2 - Книжная
				excel.fit_in_page_width();				--Вписать данные в страницу по ширине
				excel.Save_as(NameFile_OutXlsx);		--P_FILE_EXECL
				excel.Visible;							--Перевод Excel в режим отображения данных
				excel.Release;							--Закрытие COM интерфейса Excel сервера
			end if;
			if Length(V_DEST)>0 then
				debug_pipe('(Размер VB-скрипта:'||Length(V_DEST)||')',0);
			end if;
			excel.Exec_Script(V_DEST);
		end if;
	end if;
end;




/*
				-- #763546352
				for acc in ::[AC_FIN] where
					Substr(acc.[MAIN_V_ID],1,3) in ('407','408')
					and
					::[AC_FIN].[PSH_AVG_MONTH_01].actual_accountant_name( acc%id,to_date(P_END,'dd/mm/yyyy')) is not null -- updated CHANGE_SHORT_NAME PSB_AVG_MONTH_01->PSH_AVG_MONTH_01 24/10/25
					--  Z$AC_FIN_PSB_AVG_MONTH_01.actual_accountant_name(A1_1.id,to_date(P_END,'dd/mm/yyyy')) is not null
				loop
					debug_pipe('>>> acc='||acc.[MAIN_V_ID]||' Куратор='||::[AC_FIN].[PSH_AVG_MONTH_01].actual_accountant_name(acc,null),0); -- updated CHANGE_SHORT_NAME PSB_AVG_MONTH_01->PSH_AVG_MONTH_01 24/10/25
				
				end loop;
*/




end;

execute is
begin
	null;
/** /
	::[DEFVALS].[SLIB].SaveBool(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_FL',P_FL);
	::[DEFVALS].[SLIB].SaveBool(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_YL',P_YL);
	::[DEFVALS].[SLIB].SaveBool(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_ERR_ADR',P_ERR_ADR);
	::[DEFVALS].[SLIB].SaveBool(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_ERR_PHONE',P_ERR_PHONE);
    ::[DEFVALS].[SLIB].SaveRef (stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_VID',P_VID,'KIND_CREDITS');
	::[DEFVALS].[SLIB].SaveStr (stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_MESS',P_MESS);
	
	if length(msgErr)>0 then
		stdio.put_line_buf(msgErr);
	end if;

	if P_SMS then
		stdio.enable_buf;
		stdio.close_all;

		P_FILE_SMS:=vPathLocalSms||NameFile_OutSms;
		debug_pipe('Выгрузка закончена. Копируем '||trim(::[SYSTEM_PARAMS].GET('PATH'),'/')||'/'||NameFile_OutSms||' -> '||P_FILE_SMS, 0);
		[DOCUMENT]::[COPYFILES].tbl_F$L(1).[SRC_NAME]	:= NameFile_OutSms;
	    [DOCUMENT]::[COPYFILES].tbl_F$L(1).[SRC_PATH]	:= ::[SYSTEM_PARAMS].GET('PATH');
	    [DOCUMENT]::[COPYFILES].tbl_F$L(1).[SRC_TYPE]	:= true;
		[DOCUMENT]::[COPYFILES].tbl_F$L(1).[SRC_DELETE]	:= true;
	    [DOCUMENT]::[COPYFILES].tbl_F$L(1).[DST_NAME]	:= NameFile_OutSms;
	    [DOCUMENT]::[COPYFILES].tbl_F$L(1).[DST_PATH]	:= vPathLocalSms;
		[DOCUMENT]::[COPYFILES].tbl_F$L(1).[DST_TYPE]	:= false;
	    [DOCUMENT]::[COPYFILES].tbl_F$L(1).[DST_DELETE]	:= false;
	    [DOCUMENT]::[COPYFILES].idx := 0;
	    stdio.enable_buf;
		stdio.put_line_buf('<% CALL DOCUMENT COPYFILES '||nvl(::[SYSTEM]%id, 0)||' %>');
	  --stdio.put_line_buf('СМС в '||P_FILE_SMS);
	end if;
/**/
end;
end;
end;
