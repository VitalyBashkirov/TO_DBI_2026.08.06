class CL_HIST;

@name('[ПСБ] Библиотека')
library PSH_LIB is
dp	integer:=null;	--управление debug_pipe
fmt string:='dd/mm/yyyy';

public function GetLastEdit(Cl [CLIENT_REF], EditDateAnk_FormUpd boolean default false, min_date out [DATE], max_date out [DATE]) return [DATE] is 
begin
     -- Идея в том что бы использовать данные из таблицы "История 	измений реквизитов" CL_HIST
     for cl_h in ::[CL_HIST] where nvl(cl_h.[CLIENT_REF],cl_h.[CLIENT_ID])=Cl order by cl_h.[DATE_EDIT] desc
     loop max_date:=cl_h.[DATE_EDIT];
     	  debug_pipe('KUP_LIB.GetLastEdit -- cl_h.[DATE_EDIT]='||cl_h.[DATE_EDIT],dp);
     	  exit;
     end loop;
     for cl_h in ::[CL_HIST] where nvl(cl_h.[CLIENT_REF],cl_h.[CLIENT_ID])=Cl order by cl_h.[DATE_EDIT]
     loop min_date:=cl_h.[DATE_EDIT];
     	  debug_pipe('KUP_LIB.GetLastEdit -- cl_h.[DATE_EDIT]='||cl_h.[DATE_EDIT],dp);
     	  exit;
     end loop;

     if EditDateAnk_FormUpd then
	     if Cl.[DATE_ANK] is null then
	        Cl.[DATE_ANK]:=min_date;
	     end if;
	     if Cl.[DATE_FORM_UPD] is null then
	        Cl.[DATE_FORM_UPD]:=max_date;
	     else
	     	Cl.[DATE_FORM_UPD]:=Greatest(max_date,Cl.[DATE_FORM_UPD]);
	     end if;
     end if;

	 debug_pipe('KUP_LIB.GetLastEdit -- '||Cl.[NAME]||' min_date='||min_date||' min_date='||' Cl.[DATE_ANK]='||to_char(Cl.[DATE_ANK],fmt)||' DATE_FORM_UPD='||to_char(Cl.[DATE_FORM_UPD],fmt)||' EditDateAnk_FormUpd='||EditDateAnk_FormUpd,dp);
	 return max_date;
end;
public function GetLastEditAll(Cl [CLIENT_REF], EditDateAnk_FormUpd boolean default false, min_date out [DATE], max_date out [DATE]) return [MEMO] is 
all_date [MEMO];
begin
     -- Идея в том что бы использовать данные из таблицы "История 	измений реквизитов" CL_HIST
     for cl_h in ::[CL_HIST] where nvl(cl_h.[CLIENT_REF],cl_h.[CLIENT_ID])=Cl order by cl_h.[DATE_EDIT] desc
     loop max_date:=cl_h.[DATE_EDIT];
     	  debug_pipe('KUP_LIB.GetLastEditAll -- cl_h.[DATE_EDIT]='||cl_h.[DATE_EDIT],dp);
     	  exit;
     end loop;
     for cl_h in ::[CL_HIST] where nvl(cl_h.[CLIENT_REF],cl_h.[CLIENT_ID])=Cl order by cl_h.[DATE_EDIT]
     loop min_date:=cl_h.[DATE_EDIT];
     	  debug_pipe('KUP_LIB.GetLastEditAll -- cl_h.[DATE_EDIT]='||cl_h.[DATE_EDIT],dp);
     	  exit;
     end loop;

     if EditDateAnk_FormUpd then
	     if Cl.[DATE_ANK] is null then
	        Cl.[DATE_ANK]:=min_date;
	     end if;
	     if Cl.[DATE_FORM_UPD] is null then
	        Cl.[DATE_FORM_UPD]:=max_date;
	     else
	     	Cl.[DATE_FORM_UPD]:=Greatest(max_date,Cl.[DATE_FORM_UPD]);
	     end if;
     end if;

     for cl_h in ::[CL_HIST] where
     nvl(cl_h.[CLIENT_REF],cl_h.[CLIENT_ID])=Cl and
     trunc(min_date)<=trunc(cl_h.[DATE_EDIT]) and trunc(cl_h.[DATE_EDIT])<=trunc(max_date)
     order by cl_h.[DATE_EDIT] desc
     loop
     	if InStr(all_date,to_char(cl_h.[DATE_EDIT],fmt))>0 then null;
     	else
     		all_date:=all_date||to_char(cl_h.[DATE_EDIT],fmt)||'; ';
     	 	debug_pipe('KUP_LIB.GetLastEditAll -- all_date='||all_date,dp);
     	end if;
     end loop;

	 debug_pipe('KUP_LIB.GetLastEditAll -- '||Cl.[NAME]||' min_date='||min_date||' min_date='||' Cl.[DATE_ANK]='||to_char(Cl.[DATE_ANK],fmt)||' DATE_FORM_UPD='||to_char(Cl.[DATE_FORM_UPD],fmt)||' EditDateAnk_FormUpd='||EditDateAnk_FormUpd,dp);
	 return trim(trim(all_date),';');
end;
end;
