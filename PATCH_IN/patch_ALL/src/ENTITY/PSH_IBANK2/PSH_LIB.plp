class PSH_IBANK2;

@import_plsql(true)
@this(plsql_lock:=false,create_on_start:=true)
@name('[ПСБ] Библиотека функций')
@tag('COPIED')
library PSH_LIB is
public pragma macro(IBANK2LIB, '::[PSH_IBANK2].[PSH_LIB]'); -- updated CHANGE_SHORT_NAME LIB->PSH_LIB 15/10/25

public pragma macro(get_query,
'function get_query(CODE string(50)) return string(2000) is
begin
	CODE := upper(CODE);	
	if query.exists(CODE) then
		return query(CODE);
	else	
		return null;
	end if;
end;');
pragma include([BANK_CLIENT]::[LIB_MACRO]);
pragma macro(sp1,'begin [0]:= ''savepoint sp''||[2]||''[1]'' ; end;',process,substitute);
pragma macro(rb1,'begin [0]:= ''rollback to sp''||[2]||''[1]'' ; end;',process,substitute);
pragma macro(sp,'&sp1([1],&method$id);',substitute);
pragma macro(rb,'&rb1([1],&method$id);',substitute);

public function del_ora (str varchar2(32000)) return varchar2(32000) is 
begin
	str := replace(str,chr(13),'');
	str := replace(str,chr(10),'');
	if instr(str,'ORA-') > 0 then
		return trim(substr(str, instr(str,':',1,2)+1));
	else
		return str;
	end if;
end;

--проверка что это наш филиал
public function our_bank (BANK_CODE varchar2) return ref [BRANCH] is 
fil ref [BRANCH];
begin
	begin
	locate fil in [BRANCH] where fil.[BANK].[SWIFT_C]=BANK_CODE or fil.[BANK].[BIC]=BANK_CODE;
		return fil;
	exception when others then
		return null;	
	end;
end;

--поиск ссылки на внешний документ
public function get_docref (doc ref [MAIN_DOCUM]) return varchar2 is 
docref varchar2;
begin
docref := null;
	begin
		select x(x.[SYS_ID]) in ::[BC_MAP_DOC] all where
			x.[OBJ_REF]=doc and
			x.[OBJ_CLASS] = doc%class
		into docref;	
	exception when others then null;
	end;
	return docref;	
end;
pragma restrict_references(get_docref,wnds,trust);




-- Получить ссылку на договор ДБО по внешнему коду клиента
public function get_dog(EXT_CLIENT_ID string(40)) return ref [BANK_CLIENT] is 
v_dog	Ref [BANK_CLIENT];
begin
	begin
		locate exact v_dog in ::[PSH_IBANK2] all where v_dog.[COM_STATUS] = ::[COM_STATUS_PRD]([CODE] = 'WORK') and v_dog.[REG_NUMBER] = EXT_CLIENT_ID;
	exception
		when NO_DATA_FOUND then
			v_dog := null;
		when TOO_MANY_ROWS then
			v_dog := null;
	end;
	return v_dog;
end;
-- Получить ссылку на договор ДБО по счету и бику клиента
-- Получить ссылку на договор ДБО по счету клиента
public function get_dog(acc ACCNUM, bic string(9)) return ref [BANK_CLIENT] is 
accs	ref[BC_ACC_PROPS];
begin
	begin
		locate exact accs in ::[BC_ACC_PROPS] all where accs.[ACCOUNT].[MAIN_V_ID] = acc and accs.[ACCOUNT].[FILIAL].[BANK].[BIC] = bic;
	exception
		when NO_DATA_FOUND then
			accs := null;
		when TOO_MANY_ROWS then
			accs := null;
	end;
	if accs%parent%class = 'PSH_IBANK2' then
		return accs%parent;
	else
		return null;
	end if;
end;



-- номер счета (любой) IBank2
public function ibank2_acc( bc ref[BANK_CLIENT]) return string(25) is 
acc ref[BC_ACC_PROPS];
begin
     begin
           locate acc in bc.[ACC_TRACE];
              return acc.[ACCOUNT].[MAIN_V_ID];
           exception when NO_DATA_FOUND then
              return '';

      end;
end;

-- Получить ссылку на счет
public function get_acc(acc ACCNUM, bic string(9)) return ref [AC_FIN] is 
account ref[AC_FIN];
begin
	begin
		locate account in ::[AC_FIN] all where account.[MAIN_V_ID] = acc and account.[FILIAL].[BANK].[BIC] = bic and (account.[DATE_CLOSE] is null or trunc(account.[DATE_CLOSE])=trunc(sysdate));
	exception when NO_DATA_FOUND then
		null;
	end;
	return account;
end;

