class RKO;

@import_plsql(true)
@this(plsql_lock:=false,create_on_start:=true)
@name('ПСХ. Печать выписок с приложениями.')
@tag('COPIED')
static method PSH_PRINT_VYP is

@name('Буфер для клиент-скрипта') public V_DEST [STRING_32000];
pragma include ([DEFVALS].[SLIB]);
PRAGMA INCLUDE ([DEBUG_TRIGGER]::[MACRO_LIB]);

type RowBuf_type is table of string(1024);

type doc_tbl_type is table of ref [MAIN_DOCUM];
type doc_tbl_vid_type is table of ref [NAME_PAYDOC];
type doc_tbl_rowtable is record
				(doc doc_tbl_type,
					vid_doc doc_tbl_vid_type);

c_AlignLeft 		const number := 0;
c_AlignCenter		const number := 1;
c_AlignRight 		const number := 2;


Function GenerateFileName(pi_date in date, pi_sTemplate in string) return String(255)
as
begin
	return replace(pi_sTemplate, '[ДАТА]', to_char(pi_date, 'yyyy-mm-dd'));
end;

Procedure WriteDownScript(pi_sFile in string)
as
v_iFile number;
begin
	if nvl([WORD].tbl_rep.count, 0) = 0 then
		return;
	end if;
	
	&debug('Вывод скрипта генерации документа в файл "' || pi_sFile || '". ' || [WORD].tbl_rep.count || ' записей в tbl_rep', 0)
	
	begin
		v_iFile := [STDIO].F_OPEN(pi_sFile, 'w+' );
		if v_iFile < 0 then
			pragma error('Невозможно создать файл ' || stdio.error_message(v_iFile));
		end if;
	end;
	
	for i in [WORD].tbl_rep.first..[WORD].tbl_rep.last loop
		[STDIO].WRITE_STR(v_iFile, [WORD].tbl_rep(i),null,[STDIO].WINTEXT);
	end loop;
	
	if [STDIO].is_open(v_iFile)
		then[STDIO].fclose(v_iFile);
	end if;
	
end;

function StrAlign(p_strIn string, p_iFieldLength number, p_iAlign number(1) default c_AlignLeft)
return string
is
v_iLPad number;
v_iRPad number;
v_iStrLen number;
v_strRet string(1024);
begin
	v_iStrLen := NVL(Length(p_strIn), 0);			
	
	if v_iStrLen > p_iFieldLength then
		return substr(p_strIn, 1, p_iFieldLength);				
	end if;
	v_strRet := p_strIn;
	
	if p_iAlign = c_AlignLeft then
		v_iRPad := p_iFieldLength - v_iStrLen;
		v_iLPad	:= 0;
	elsif p_iAlign = c_AlignRight then
		v_iRPad := 0;
		v_iLPad	:= p_iFieldLength - v_iStrLen;
	elsif p_iAlign = c_AlignCenter then
		v_iRPad := round((p_iFieldLength - v_iStrLen) / 2.0);
		v_iLPad	:= round((p_iFieldLength - v_iStrLen) / 2.0);
		if mod((p_iFieldLength - v_iStrLen) / 2.0 , 1) > 0 then
			v_iLPad := v_iLPad - 1;	
		end if;
	end if;
	if v_iLPad > 0 then
		v_strRet := lpad(' ', v_iLPad, ' ') || v_strRet;		
	end if;
	if v_iRPad > 0 then
		v_strRet := v_strRet || rpad(' ', v_iRPad, ' ');		
	end if;
	
	return v_strRet;
end;

procedure AddField(pi_tRowBuf in out RowBuf_type, pi_sData in string, pi_iFrom in number, pi_iLength in number, pi_sEmptyRow in string, pi_iAlign in number default(c_AlignLeft) , pi_bBreakToNewLine in boolean default(false))
as
v_sPart string(1024);
v_iLine number;
v_sBuf string(1024);
begin
	v_sBuf := substr(nvl(pi_sData, ' '), 1, 1024);
	v_sBuf := replace(v_sBuf, chr(13) || chr(10), '  ');
	v_iLine := 1;
	while v_sBuf is not null loop
		if not pi_tRowBuf.exists(v_iLine) then
			pi_tRowBuf(v_iLine) := pi_sEmptyRow;
		end if;
		v_sPart := substr(v_sBuf, 1, pi_iLength);-- часть данных для текущей строки
		v_sBuf := substr(v_sBuf, pi_iLength + 1);-- что останется вывести

		-- заменим в строчке v_iLine буфера записи строку с pi_iFrom до pi_iFrom + pi_iLength - 1 на наши данные
		pi_tRowBuf(v_iLine) := substr(pi_tRowBuf(v_iLine), 1, pi_iFrom - 1) || StrAlign(v_sPart, pi_iLength, pi_iAlign) || substr(pi_tRowBuf(v_iLine), pi_iFrom + pi_iLength);
		
		v_iLine := v_iLine + 1;		
		if v_iLine > 1 and not pi_bBreakToNewLine then
			exit;
		end if;
	end loop;	
end;

procedure PutLine(pi_sData in string)
as
v_sBuffer string(32000);
begin
	v_sBuffer := replace(pi_sData, '"', '""');
	v_sBuffer := replace(v_sBuffer, chr(13) || chr(10), '  ');
	
	WORD.cmd('PutLine "' || v_sBuffer || '"');
end;

Procedure FetchBuffer
as
begin
	WORD.cmd('wrd.Selection.TypeText(sBuffer)
	sBuffer = ""');
end;

procedure PutMemo(pi_sData in string)
as
v_sBuffer string(32000);
begin
	v_sBuffer := replace(pi_sData, '"', '""');
	-- избавимся от лидирующих и последующих пустых строк
	v_sBuffer := regexp_replace(v_sBuffer, '(' || chr(13) || chr(10) || '|'|| chr(13) || '|'|| chr(10) || ').$' , '');
	--лидирующие переводы строки нужно заменять на пробел, иначе съедается один пробел в новой строке....
	v_sBuffer := regexp_replace(v_sBuffer, '^(' || chr(13) || chr(10) || '|'|| chr(13) || '|'|| chr(10) || ').' , ' ');
	v_sBuffer := regexp_replace(v_sBuffer, '(' || chr(13) || chr(10) || '|'|| chr(13) || '|'|| chr(10) || ')' , '" & chr(13) & chr(10) & _ ' || chr(13) || chr(10) || '"');
	
	WORD.cmd('wrd.Selection.TypeText "' || v_sBuffer || '"');
end;


procedure WriteRecord(pi_tRowBuf in RowBuf_type)
as
begin
	for i in 1..pi_tRowBuf.count loop
		PutLine(pi_tRowBuf(i));	
	end loop;
end;

procedure SectionLines
as
begin
	WORD.cmd('wrd.Selection.InsertBreak wdSectionBreakNextPage
		wrd.Selection.PageSetup.Orientation = wdOrientLandscape
	    wrd.Selection.Font.Size = 7');	
end;

procedure SectionApps
as
begin
	WORD.cmd('wrd.Selection.InsertBreak wdSectionBreakNextPage
		wrd.Selection.PageSetup.Orientation = wdOrientPortrait
	    wrd.Selection.Font.Size = 8');		
end;

procedure PutAppsList(pi_doc_tbl doc_tbl_rowtable)
is
begin
	if pi_doc_tbl.doc.count > 0 then
		&debug('Вывод ' || pi_doc_tbl.doc.count || ' документов', 0)
		::[PRN_TUNE].[PREPARATION](pi_doc_tbl.doc);
	else
		return;
	end if;	
	
	for i in ::[PRN_TUNE].[F].t.first..::[PRN_TUNE].[F].t.last loop
		--вставим разрывы перед не первым, и после каждого нечетного банковского ордера
		if (pi_doc_tbl.vid_doc(i) <> ::[NAME_PAYDOC]([CODE] = 'БЕЗН_БАНК_ОРД') and i != 1) or
			(pi_doc_tbl.vid_doc(i) = ::[NAME_PAYDOC]([CODE] = 'БЕЗН_БАНК_ОРД') and mod(i, 2) = 1 and i != 1) then
			WORD.CMD('wrd.Selection.InsertBreak wdPageBreak');
		end if;
		--&debug(::[PRN_TUNE].[F].t(i).ss, 0)
		PutMemo(::[PRN_TUNE].[F].t(i).ss);
	end loop;
end;		

Procedure GenerateReport(P_DEPART ref [DEPART],P_DATE in date, P_PRINT in boolean, P_SAVE in boolean
							, P_FILE [FILE$LOAD], P_EXCLUDE ONE_FROM_THREE, P_CL_ACC in ref [AC_FIN], P_PL_US ref [PL_US])
as
v_sEmptyRow				string(1024);
v_tRowBuf RowBuf_type;
v_decInSaldo number;
v_sInSaldo string(50);
v_decOutSaldo number;
v_sOutSaldo String(50);

v_decKtChange number;
v_decDtChange number;
v_decKtChangeNat number;
v_decDtChangeNat number;

v_sKtChange string(50);
v_sDtChange string(50);
v_sKtChangeNat string(50);
v_sDtChangeNat string(50);



v_sBank				[CL_BANK_N].[NAME]%TYPE;--
v_sBIC				[CL_BANK_N].[BIC]%TYPE;--
v_sKS				[CL_BANK_N].[KS]%TYPE;--
v_sDepart			[DEPART].[NAME]%TYPE;--
v_sPhone			[CONTACTS].[NUMB]%TYPE;--
v_sDate				string(20);
v_bFirstAcc			boolean;

doc_tbl doc_tbl_rowtable;
doc_tbl_BankOrd doc_tbl_rowtable;
kk number := 0;
--v_bDoNotAddApp boolean := false;
Begin

	--v_iSections := 0;
	
	select rec(rec.[NAME]
			, (select ph(ph.[NUMB])
				in ::[CONTACTS] ALL
				where rownum < 2 and ph%collection = rec.[PART].[CONTACTS] and ph.[TYPE] = ::[COMUNICATION]([CODE] = 'PHONE') )
			, rec.[PART].[BANK].[NAME]
			, rec.[PART].[BANK].[BIC]
			, rec.[PART].[BANK].[KS])
		in ::[DEPART]
		where rec = P_DEPART and rownum < 2
		into v_sDepart
			, v_sPhone
			, v_sBank
			, v_sBIC
			, v_sKS;
	
	v_bFirstAcc := true;
	
	v_sDate := to_char(P_DATE, 'dd/mm/yyyy');
	v_sEmptyRow := '|         |                    |                    |                    |              |                                                           |                              |';
--pragma error(p_CL_ACC);
	for (
		select res(	res: acc_ref
					, res.[MAIN_V_ID]: ac_num
					, res.[OTV].[NAME]: manager_name
					, res.[FINTOOL].[CUR_SHORT] || '/' || nvl(res.[FINTOOL].[CODE_ACC], res.[FINTOOL].CODE_ISO) || ' ' || res.[FINTOOL].[NAME]: currency
					, res.[CLIENT_V].[NAME]: cl_name
					, res.[CLIENT_V].[REGISTR_NUM]: cl_reg_num
					, res.[NAME]: ac_name
					, (
						select lo(max(lo.[DATE]))
							in res.[ARC_MOVE]
							where lo.[DATE] < P_DATE
					): last_op_date
					, case when res.[FINTOOL] = ::[SYSTEM].[VARIABLES].NatCur then 1 else 0 end: is_nat_cur
					, res.[ARC_MOVE] : arc_move
					)	
			in ::[AC_FIN]

	
					where
						(P_CL_ACC is null or P_CL_ACC = res)
						and (P_DEPART is null or P_DEPART = res.[DEPART])
						and (P_PL_US is null or res.[MAIN_USV].[USV_US] = P_PL_US)
	--					and (P_PL_US is null or substr(res.[MAIN_V_ID],1,5) = P_PL_US)
		--				and substr(res.[MAIN_V_ID],1,5) in ('40702')
		--				and res.[DEPART] = P_DEPART
						
	--					and af in (rec.[ACCOUNT], rec.[CHARGES_ACC])
	
						and exists(
							select x(1)
								in res.[ARC_MOVE]
								where (x.[DATE] >= P_DATE and x.[DATE] < P_DATE + 1)
									--исключим счета переоценки курсовой разницы, нас не интересуют счета у которых только переоценка
									and not substr(x.[ACC_CORR].[MAIN_V_ID], 1, 5) in ('70603', '70608')
						)
	
	/*		 ,(
				--счета из договоров РКО
				select rec(af : af_ref)
					in ::[RKO], ([AC_FIN] ALL : af)
					where
						(P_CL_ACC is null or P_CL_ACC = af)
						and rec.[DEPART] = P_DEPART
						and af in (rec.[ACCOUNT], rec.[CHARGES_ACC])
						and exists(
							select x(1)
								in af.[ARC_MOVE]
								where (x.[DATE] >= P_DATE and x.[DATE] < P_DATE + 1)
									--исключим счета переоценки курсовой разницы, нас не интересуют счета у которых только переоценка
									and not substr(x.[ACC_CORR].[MAIN_V_ID], 1, 5) in ('70603', '70608')
						)
			--/*
						and not exists
						(
							select x(1)
								in ::[OTP_IB_CLIENT]
									where x.[SEND_VIP] = 0 and x.[ARRAY_ACCOUNT].[ACCOUNT] = af
						)
			
				union
				--счета из массива "счета клиента" договоров iBank
				select rec(rec.[ARRAY_ACCOUNT].[ACCOUNT] : af_ref)
					in ::[OTP_IB_CLIENT]
					where
						(P_CL_ACC is null or P_CL_ACC = rec.[ARRAY_ACCOUNT].[ACCOUNT])
						and rec.[DEPART] = P_DEPART
						and (rec.[SEND_VIP] = 1 or rec.[SEND_VIP] is null)
						and exists(
							select x(1)
								in rec.[ARRAY_ACCOUNT].[ACCOUNT].[ARC_MOVE]
								where (x.[DATE] >= P_DATE and x.[DATE] < P_DATE + 1)
									--исключим счета переоценки курсовой разницы, нас не интересуют счета у которых только переоценка
									and not substr(x.[ACC_CORR].[MAIN_V_ID], 1, 5) in ('70603', '70608')
						)
				union
				-- счет для оплаты комиссий договоров iBank
				select rec(rec.[ACC_KOMIS] : af_ref)
					in ::[OTP_IB_CLIENT]
					where
						(P_CL_ACC is null or P_CL_ACC = rec.[ACC_KOMIS])
						and rec.[DEPART] = P_DEPART
						and (rec.[SEND_VIP] = 1 or rec.[SEND_VIP] is null)
						and exists(
							select x(1)
								in rec.[ACC_KOMIS].[ARC_MOVE]
								where (x.[DATE] >= P_DATE and x.[DATE] < P_DATE + 1)
									--исключим счета переоценки курсовой разницы, нас не интересуют счета у которых только переоценка
									and not substr(x.[ACC_CORR].[MAIN_V_ID], 1, 5) in ('70603', '70608')
						)
				*/	
		--	)
		--	where rec.af_ref = res
			
			order by res.[OTV].[NAME], substr(res.[MAIN_V_ID], 1, 5), res.[CLIENT_V].[REGISTR_NUM]--res.[CLIENT_V].[REGISTR_NUM], res.[MAIN_V_ID]
	) loop
		if v_bFirstAcc then
			v_bFirstAcc := false;
		else
			SectionLines;
		end if;
		
		debug_pipe  ('111111');
		PutLine('                                                               КЛИЕНТСКАЯ ВЫПИСКА                                                       ' || to_char(sysdate, 'dd/mm/yyyy hh24:mi:ss'));
		PutLine('Наименование           Кредитной Организации: ' || StrAlign(v_sBank, 73) || 										   ' Подразделение : ' || StrAlign(v_sDepart, 45));
		PutLine('БИК                    Кредитной Организации: ' || StrAlign(v_sBIC, 73) || 										   ' Менеджер счета: ' || StrAlign(res.manager_name, 45));
		PutLine('Корреспондентский счет Кредитной Организации: ' || StrAlign(v_sKS, 73) || 						  				       ' Телефон       : ' || StrAlign(v_sPhone, 45));
		
		v_decInSaldo 	:= f.a('И' || res.acc_ref || 'В', trunc(P_DATE));
		v_sInSaldo 		:= to_char(v_decInSaldo, '999,999,999,999,990.99');


		PutLine('+----------------------+------------------------------+---------+-------------------------------------------------------+----------------------------------------------------------+');
		PutLine('|     Номер счета      |           Валюта счета       |Рег.№ кл.|                Наименование клиента                   |                   Наименование счета                     |');
		PutLine('+-----------------------------------------------------+---------+-------------------------------------------------------+----------------------------------------------------------+');
		PutLine('| ' || StrAlign(res.ac_num, 20) || ' | ' || StrAlign(res.currency, 28) || ' |' || StrAlign(res.cl_reg_num, 9, c_AlignCenter) || '|' || StrAlign(res.cl_name, 55, c_AlignCenter) || '|' || StrAlign(res.ac_name, 58, c_AlignCenter) || '|');
		PutLine('+----------------------+------------------------------+---------+-------------------------------------------------------+----------------------------------------------------------+');
		PutLine('Дата последней операции      : ' || to_char(res.last_op_date, 'dd/mm/yyyy'));
		PutLine('Входящий остаток на начало дня ' || v_sDate || ' : ' || v_sInSaldo);
		PutLine('+---------+--------------------+--------------------+--------------------+--------------+-----------------------------------------------------------+------------------------------+');
		PutLine('|  Номер  | Корреспондирующий  |        Дебет       |        Кредит      |   Покрытие   |                         Назначение                        |          Контрагент          |');
		PutLine('|документа|        счет        |                    |                    |              |                                                           |                              |');
		PutLine('+---------+--------------------+--------------------+--------------------+--------------+-----------------------------------------------------------+------------------------------+');
		
		v_decKtChange := 0;
		v_decDtChange := 0;
		v_decKtChangeNat := 0;
		v_decDtChangeNat := 0;
		doc_tbl.doc.delete;
		doc_tbl.vid_doc.delete;
		doc_tbl_BankOrd.doc.delete;
		doc_tbl_BankOrd.vid_doc.delete;
		var rr number :=0;
		for
		(
			select vyp(
					vyp.[DOC].[DOCUMENT_NUM]: doc_num
					,  case when vyp.DT = '0' then trim(vyp.[DOC].[ACC_DT].[MAIN_V_ID]) else
												 trim(vyp.[DOC].[ACC_KT].[MAIN_V_ID]) end : korr_ac
					,  case when vyp.DT = '0' then NVL(vyp.[DOC].[KL_DT].[2].[2], vyp.[DOC].[KL_DT].[1].[1].[NAME]) else
												 NVL(vyp.[DOC].[KL_KT].[2].[2], vyp.[DOC].[KL_KT].[1].[1].[NAME]) end : contr_ag
					, case when vyp.DT = '1' then vyp.[SUMMA] else 0 end: sum_dt
					, case when vyp.DT = '1' then 0 else vyp.[SUMMA] end: sum_kt
					, vyp.[SUMMA_NAT]: summa_nat
					, vyp.[DOC].[NAZN]: nazn
					, vyp.DT: DT
					, vyp.[DOC]: doc
					, rownum : rn
					, vyp.[DOC].[VID_DOC] : vid_doc
					, vyp.[DOC].[VID_DOC].TYPE_DOC : typ_doc
					, vyp.[DOC].[ACC_DT] : acc_dt
					, vyp.[DOC].[DOCUMENT_UNO] : uno
					--, vyp.[DOC].[ACC_KT] : acc_kt
					)
				in res.arc_move
				where (vyp.[DATE] >= P_DATE and vyp.[DATE] < P_DATE + 1)
				order by vyp.[DATE]
		) loop	
			--Выбор документов для печати
			if not substr(vyp.korr_ac, 1, 5) in ('70603', '70608') --не переоценка валютных курсов
				and not vyp.typ_doc = ::[TYPE_PAYDOC]([CODE] = 'KASSA_DOCUM')-- не кассовый
				--исключать сканированные(ручные документы). Сканированные - см. параметр OTP_BIPRINT в [HOOK_BANK].[RKO_CALC_PAR]
				and not (P_EXCLUDE.[0] = 2 and res.acc_ref = vyp.acc_dt and (vyp.uno is null or regexp_like(vyp.uno, '^(BZ|SCN|BP)'))
								and vyp.vid_doc in (::[NAME_PAYDOC]([CODE] = 'БЕЗН_ПЛ_ПОРУЧ')
												   ,::[NAME_PAYDOC]([CODE] = 'БЕЗН_ПЛ_ТРЕБ')
												   ,::[NAME_PAYDOC]([CODE] = 'БЕЗН_ИНКАСС_ПОР')))
				--Исключать платежные поручения, поступившие по системе Банк-Клиент
				and not (P_EXCLUDE.[0] = 3 and res.acc_ref = vyp.acc_dt and substr(vyp.uno, 1, 2) = 'IB'
								and vyp.vid_doc = ::[NAME_PAYDOC]([CODE] = 'БЕЗН_ПЛ_ПОРУЧ'))
				
				then				
				
--				if vyp.vid_doc in (::[NAME_PAYDOC]([CODE] = 'БЕЗН_ПЛ_ПОРУЧ')) and not v_bDoNotAddApp then
--					v_bDoNotAddApp := true;
				if vyp.vid_doc = ::[NAME_PAYDOC]([CODE] = 'БЕЗН_БАНК_ОРД') then
					doc_tbl_BankOrd.doc(nvl(doc_tbl_BankOrd.doc.last, 0) + 1) := vyp.doc;
					doc_tbl_BankOrd.vid_doc(nvl(doc_tbl_BankOrd.vid_doc.last, 0) + 1) := vyp.vid_doc;
				else
					doc_tbl.doc(nvl(doc_tbl.doc.last, 0) + 1) := vyp.doc;
					doc_tbl.vid_doc(nvl(doc_tbl.vid_doc.last, 0) + 1) := vyp.vid_doc;
				end if;
--				end if;
				
			end if;
					
			v_decDtChange := v_decDtChange + vyp.sum_dt;
			v_decKtChange := v_decKtChange + vyp.sum_kt;
			v_decDtChangeNat := v_decDtChangeNat + case when vyp.DT = 1 then vyp.[SUMMA_NAT] else 0 end;
			v_decKtChangeNat := v_decKtChangeNat + case when vyp.DT = 0 then 0 else vyp.[SUMMA_NAT] end;
			
			v_tRowBuf.delete;
			
			AddField(v_tRowBuf, vyp.doc_num, 2, 9, v_sEmptyRow, c_AlignRight, false);
			AddField(v_tRowBuf, vyp.korr_ac, 12, 20, v_sEmptyRow, c_AlignLeft, false);
			AddField(v_tRowBuf, case when vyp.sum_dt <> 0 then trim(to_char(vyp.sum_dt, '999,999,999,990.99')) else '' end, 34, 18, v_sEmptyRow, c_AlignRight, false);
			AddField(v_tRowBuf, case when vyp.sum_kt <> 0 then trim(to_char(vyp.sum_kt, '999,999,999,990.99')) else '' end, 55, 18, v_sEmptyRow, c_AlignRight, false);
			AddField(v_tRowBuf, case when res.is_nat_cur = '0' then trim(to_char(vyp.summa_nat, '999,999,990.99')) else '' end, 75, 14, v_sEmptyRow, c_AlignRight, false);
			AddField(v_tRowBuf, vyp.nazn, 90, 59, v_sEmptyRow, c_AlignLeft, true);
			AddField(v_tRowBuf, vyp.contr_ag, 150, 30, v_sEmptyRow, c_AlignLeft, true);
			
			WriteRecord(v_tRowBuf);
			
		end loop;

		if v_decDtChange = 0 then
			v_sDtChange := StrAlign('', 18, c_AlignRight);	
		else
			v_sDtChange := StrAlign(trim(to_char(v_decDtChange, '999,999,999,990.99')), 18, c_AlignRight);	
		end if;
		
		if v_decKtChange = 0 then
			v_sKtChange := StrAlign('', 18, c_AlignRight);
		else
			v_sKtChange := StrAlign(trim(to_char(v_decKtChange, '999,999,999,990.99')), 18, c_AlignRight);
		end if;
		
		if res.is_nat_cur = '1' or v_decDtChangeNat = 0 then
			v_sDtChangeNat := StrAlign('', 18, c_AlignRight);
		else
			v_sDtChangeNat := StrAlign(trim(to_char(v_decDtChangeNat, '999,999,999,990.99')), 18, c_AlignRight);
		end if;

		if res.is_nat_cur = '1' or v_decKtChangeNat = 0 then
			v_sKtChangeNat := StrAlign('', 18, c_AlignRight);
		else
			v_sKtChangeNat := StrAlign(trim(to_char(v_decKtChangeNat, '999,999,999,990.99')), 18, c_AlignRight);
		end if;
		
		
		PutLine('+---------+--------------------+--------------------+--------------------+--------------+-----------------------------------------------------------+------------------------------+');
		PutLine('| ИТОГО:  | Обороты в Валюте   | ' || v_sDtChange || ' | ' || v_sKtChange || ' |                                                                                                         |');
		PutLine('|         | Обороты в Покрытии | ' || v_sDtChangeNat || ' | ' || v_sKtChangeNat || ' |                                                                                                         |');
		PutLine('+---------+--------------------+--------------------+--------------------+--------------+-----------------------------------------------------------+------------------------------+');
		
		v_decOutSaldo := v_decInSaldo - v_decDtChange + v_decKtChange;
		v_sOutSaldo := to_char(v_decOutSaldo, '999,999,999,999,990.99');		

		PutLine('Исходящий остаток на конец дня ' || v_sDate || ' : ' || v_sOutSaldo);
		FetchBuffer;
		
		if doc_tbl.doc.count + doc_tbl_BankOrd.doc.count > 0 then
		
			SectionApps;
			
			PutAppsList(doc_tbl);
			if doc_tbl.doc.count > 0 and doc_tbl_BankOrd.doc.count > 0 then
			-- Если были и из doc_tbl.doc и будут из doc_tbl.doc, то нужен разрыв страницы
				WORD.CMD('wrd.Selection.InsertBreak wdPageBreak');
			end if;
			PutAppsList(doc_tbl_BankOrd);
		end if;
		
/*		if doc_tbl.doc.count > 0 then
			::[PRN_TUNE].[PREPARATION](doc_tbl.doc);
		end if;	
		
		for i in ::[PRN_TUNE].[F].t.first..::[PRN_TUNE].[F].t.last loop
			if i != 1 then
				WORD.CMD('wrd.Selection.InsertBreak wdPageBreak');
			end if;
			PutMemo(::[PRN_TUNE].[F].t(i).ss);
		end loop;
*/
		

		
	end loop;
	
	IF P_SAVE then
		WORD.CMD('''On Error Resume Next
			''Err.Clear
			WordDoc.Saved = True
			WordDoc.SaveAs "' || P_FILE.[DST_PATH] || '\' || P_FILE.[DST_NAME] || '", 0');
	end if;
	
	if P_PRINT then		
		WORD.Visible;
		WORD.Release;	
	else
		WORD.Close_App;
		WORD.Release;	
	end if;
	
	
end;
PSH_PRINT_VYP (
	@name('Подразделение')      P_DEPART             in ref [DEPART],
	@name('Дата')               P_DATE               in     [DATE],
	@name('Выводить на печать') P_PRINT              in     [BOOLEAN],
	@name('Сохранить в файл')   P_SAVE               in     [BOOLEAN],
	@name('Файл')               P_FILE               in     [FILE$LOAD],
	@name('Шаблон имени файла') P_FILE_NAME_TEMPLATE in     [STRING_256],
	@name('P_SCRIPT')           P_SCRIPT             in     [FILE$LOAD],
	@name('Выводить документы') P_EXCLUDE            in     [ONE_FROM_THREE],
	@name('Счет клиента')       P_CL_ACC             in ref [AC_FIN],
	@name('Балансовый счет')    P_PL_US              in     [PL_US_REF]
) is

validate is
BEGIN
	If p_message = 'DEFAULT' then
		P_DATE 					:= ::[SYSTEM].[OP_DATE];
		P_PRINT		 			:= True;--Сохранять умолчательные
		P_SAVE					:= false;--Сохранять умолчательные
		P_EXCLUDE.[0]			:= 1;
		P_DEPART				:= ::[SYSTEM].[VARIABLES].OurDepart;
		P_FILE_NAME_TEMPLATE	:= nvl(&mRestoreStr4User('P_FILE_NAME_TEMPLATE'), 'Выписка c приложениями за [ДАТА].doc');
		
		P_FILE.[DST_TYPE] 		:= False;
		P_FILE.[DST_DELETE]		:= False;
		P_FILE.[DST_NAME]		:= GenerateFileName(P_DATE, P_FILE_NAME_TEMPLATE);
		P_FILE.[DST_PATH]		:= nvl(&mRestoreStr4User('DST_PATH'), 'c:\');
		P_FILE.[DST_MASK]		:= 'Word|*.doc';				
		
		&IF_DEBUG2
			P_SCRIPT.[SRC_TYPE] 	:= true;
			P_SCRIPT.[SRC_DELETE]	:= true;
			P_SCRIPT.[SRC_NAME]		:= inst_info.owner||lpad(next_value('FILE_SEQUENCE'),10,'0')||'.tmp';
			P_SCRIPT.[SRC_PATH]		:= nvl(stdio.get_resource('DEFAULT','FIO_TEMP_DIR'),'/var/tmp');

			P_SCRIPT.[DST_TYPE] 	:= False;
			P_SCRIPT.[DST_DELETE]	:= False;
			P_SCRIPT.[DST_NAME]		:= 'script.vbs';
			P_SCRIPT.[DST_PATH]		:= 'E:\CFT_ROSTOV\krivoshlykov';
		&END_IF_DEBUG2
		--#ENDIF
		
		WORD.Init_WRD;
		
	ElsIf p_message = 'VALIDATE' then
		If p_info = 'OK' then
			If WORD.F_CLICK Then
			
			if not P_SAVE  and not P_PRINT then
				pragma error('Необходимо выбрать одну из галочек "Выводить на печать" или "Сохранить в файл"');
			end if;
			
			if P_SAVE and (P_FILE.[DST_NAME] is null or P_FILE.[DST_PATH] is null) then
				pragma error('Задайте путь и имя файла для сохранения');				
			end if;
			
			if P_DEPART is null and P_CL_ACC is null then
				pragma error('Необходимо выбрать хотя бы один из параметров: подразделение или счет клиента');				
			end if;
			
			if P_DEPART is null then
				P_DEPART := P_CL_ACC.[DEPART];
			end if;

			if P_CL_ACC is not null and P_DEPART <> P_CL_ACC.[DEPART] then
				pragma error('Выбранное подразделение не равно подразделению указанного счета. Уберите его (SHIFT+DEL) или укажите правильное.');				
			end if;			
					
--		Место для проверок!!!!
								
				WORD.F_CLICK := False;	
				WORD.CMD('
					Const wdPrinterDefaultBin = 0
					Const wdSectionNewPage = 2
					Const wdAlignVerticalTop = 0
					Const wdGutterPosLeft = 0
					Const wdLineSpaceSingle = 0
					Const wdPageBreak = 7
					Const wdSectionBreakNextPage =  2
					Const wdColumnBreak = 1
					Const wdOrientPortrait = 0
					Const wdOrientLandscape = 1
				sub PutLine (pi_sBuffer)
					if len(sBuffer) + len(pi_sBuffer) > 32000 then
						wrd.Selection.TypeText(sBuffer)
						sBuffer = ""				
					end if
					sBuffer = sBuffer & pi_sBuffer & chr(13) & chr(10)
				end sub');
				
				WORD.Open_File('', false, true);
				
				WORD.CMD(' sBuffer = ""
				    		 wrd.Selection.Font.Size = 7
		 					With WordDoc.Application.ActiveDocument.PageSetup
                 				.LineNumbering.Active = False
         				        .Orientation = wdOrientLandscape
         				        .TopMargin = wrd.CentimetersToPoints(1.25)
         				        .BottomMargin = wrd.CentimetersToPoints(1.25)
         				        .LeftMargin = wrd.CentimetersToPoints(1.25)
         				        .RightMargin = wrd.CentimetersToPoints(1.25)
         				        .Gutter = wrd.CentimetersToPoints(0)
         				        .HeaderDistance = wrd.CentimetersToPoints(1.25)
         				        .FooterDistance = wrd.CentimetersToPoints(1.25)
         				        .PageWidth = wrd.CentimetersToPoints(29.7)
         				        .PageHeight = wrd.CentimetersToPoints(21)
         				        .FirstPageTray = wdPrinterDefaultBin
         				        .OtherPagesTray = wdPrinterDefaultBin
         				        .SectionStart = wdSectionNewPage
         				        .OddAndEvenPagesHeaderFooter = False
         				        .DifferentFirstPageHeaderFooter = False
         				        .VerticalAlignment = wdAlignVerticalTop
         				        .SuppressEndnotes = False
         				        .MirrorMargins = False
         				        .TwoPagesOnOne = False
         				        .BookFoldPrinting = False
         				        .BookFoldRevPrinting = False
         				        .BookFoldPrintingSheets = 1
         				        .GutterPos = wdGutterPosLeft
         					End With
							
							 wrd.Selection.ParagraphFormat.LineSpacingRule = wdLineSpaceSingle
							 wrd.Selection.ParagraphFormat.SpaceBefore = 0
							 wrd.Selection.ParagraphFormat.SpaceAfter = 0
					
							
					         WordDoc.Application.Selection.Font.Name = "Courier New"');
					
				GenerateReport(P_DEPART ,P_DATE, P_PRINT, P_SAVE, P_FILE, P_EXCLUDE, P_CL_ACC, P_PL_US);
				
		
				
				&mSaveStr4User('DST_PATH', P_FILE.[DST_PATH]);
				&mSaveStr4User('P_FILE_NAME_TEMPLATE', P_FILE_NAME_TEMPLATE);
					
				&IF_DEBUG2
					WriteDownScript(P_SCRIPT.[SRC_PATH] || '/' || P_SCRIPT.[SRC_NAME]);	
					&debug('Получение скрипта в ' || P_SCRIPT.[DST_PATH] || '\' || P_SCRIPT.[DST_NAME], 0)
				&END_IF_DEBUG2
				--#ENDIF				
				
			End If;		
				
			WORD.EXEC_SCRIPT(V_DEST);			
		Elsif p_info in ('P_DATE', 'P_FILE_NAME_TEMPLATE') then
			P_FILE.[DST_NAME] := GenerateFileName(P_DATE, P_FILE_NAME_TEMPLATE);
			null;
		Elsif p_info = 'P_FILE.DST_NAME' then
			if not regexp_like(P_FILE.[DST_NAME], '.+\.doc') then
				P_FILE.[DST_NAME] := P_FILE.[DST_NAME] || '.doc'; 	
			end if;
		End If;
	End If;
END;
					

execute is
/*********************************************************************
Назначение:

krivoshlikov, последнее изменение 4 Июль 2013 г.
*********************************************************************/
begin
	null;
end;
end;
end;
