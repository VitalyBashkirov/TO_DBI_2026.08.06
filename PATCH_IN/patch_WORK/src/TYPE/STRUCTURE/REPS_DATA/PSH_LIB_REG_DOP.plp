	/** /
	 :'1B620941':
		vMessage := null;

		-- Если не зарегистрировано другое приложение, использующее эту РТ - проверяем наличие данных
		if not CheckRegPril('1B618040') then
			for ( select	y(1)	in	::[NORM_CB_DATA] fetch 1)
			loop
				vMessage := 'NORM_CB_DATA';
				exit;
			end loop;
		end if;

		-- Если не зарегистрировано другое приложение, использующее эту РТ - проверяем наличие данных
		if not CheckRegPril('1B618045') then
			for ( select	y(1)	in	::[NORM_REPO_DATA] fetch 1)
			loop
				vMessage := vMessage || ', NORM_REPO_DATA';
				vMessage := ltrim(vMessage, ', ');
				exit;
			end loop;
		end if;

		for	(	select	x(1)
				in		::[F_120_DETAIL]
				where x.[PRODUCT_CLASS] in ('NORM_CB_DATA', 'NORM_REPO_DATA')
				fetch 1
			)
		loop
			vMessage := vMessage || ', F_120_DETAIL';
			vMessage := ltrim(vMessage, ', ');
			exit;
		end loop;

		if vMessage is not null then
			return 'Перед отключением приложения необходимо удалить информацию по ценным бумагам из '||vMessage;
		end if;
	/**/
	 :'1B620946':
		for (select	x(1)	in ::[F_120_DATA_LIM] all)
		loop
			return 'Перед отключением приложения необходимо выполнить очистку справочника "ОП Ф-120 Данные" по лимитам';
		end loop;

	:'1B620076':
		for (
				select	x(1)
				in		::[NORM_KRL_DATA]
				where	coalesce(x.[LEVEL], 1) > 2
				fetch 1
			)
		loop
			return 'Перед отключением приложения необходимо удалить из справочника "ОП Нормативы. КРЛ. Связанные с банком лица. Данные" все записи со значением уровня больше двух.';
		end loop;

	:'1B975010':
		-- если отмена регистрации, то проверить наличие записей
		for	(	select	x(1)
				in	(	select	x(1)
						in		::[EFIR_WORK_CB]
						fetch 1
					)
			union all
				select	x(1)
				in	(	select	x(1)
						in	::[EFIR_WORK_REPO]
						fetch 1
					)
			)
		loop
			return 'Перед отключением приложения необходимо очистить справочники "ОП Взаимодействие с "ЭФИР Add-In" по ЭЦБ", "ОП Взаимодействие с "ЭФИР Add-In" по РЕПО".';
		end loop;

	:'1B975015':
		for (	select	x(1)	in	::[EFIR_WORK_PFI]	fetch 1	)
		loop
			return 'Перед отключением приложения необходимо очистить справочник "ОП Взаимодействие с "ЭФИР Add-In" по ПФИ".';
		end loop;

	:'1B618131':
		for	(	select	x(1)	in	::[EFIR_PORTFEL]	fetch 1	)
		loop
			return 'Перед отключением приложения необходимо очистить справочник "ОП Взаимодействие с "ЭФИР Add-In". Состав портфеля".';
		end loop;

	-- Данные по кредитам для отчетности с учетом МСФО.
	:'1B621060':
		for	(	select	x(1)	in	::[REPS_CR_INFO_RT]	fetch 1	)
		loop
			return 'Перед отключением приложения необходимо очистить справочник "ОП МСФО. Разработочная таблица по кредитам. Общие реквизиты".';
		end loop;

	-- Данные по ЦБ для отчетности с учетом МСФО.
	:'1B621090':
		for	(
				select	x(1)
				in	(	select	x(1)
						in	::[REPS_ECB_INFO_RT]
						fetch 1
					)
			union all
				select	x(1)
				in	(	select	x(1)
						in	::[REPS_ECB_PER_RT]
						fetch 1
					)
			)
		loop
			return 'Перед отключением приложения необходимо очистить справочники "ОП МСФО. Разработочная таблица по ЭЦБ. Общие реквизиты" и "ОП МСФО. Разработочная таблица по ЭЦБ. Данные за период".';
		end loop;

	-- Данные по гарантиям для отчетности с учетом МСФО.
	:'1B621030':
		for (	select	x(1)
				in		::[REPS_GAR_INFO_RT]
				fetch 1
			)
		loop
			return 'Перед отключением приложения необходимо очистить справочник "ОП МСФО. Разработочная таблица по гарантиям. Общие реквизиты".';
		end loop;

	-- Данные по депозитам для отчетности с учетом МСФО.
	:'1B621040':
		for	(	select	x(1)	in	::[REPS_DEP_INFO_RT]	fetch 1	)
		loop
			return 'Перед отключением приложения необходимо очистить справочник "ОП МСФО. Разработочная таблица по депозитам. Общие реквизиты".';
		end loop;
	:'1B620231':
		-- проверка наличия данных в справочнике F_345_DATA по настройкам страхового возмещения
		for	(
				select	fd
					(	fd.[TUNING].[CODE]		: C_CODE
					,	fd.[TUNING].[CODE]		: C_PROF
					)
				in		::[F_345_DATA]
				where	fd.[TUNING].[CODE] like '4.%' or fd.[TUNING].[CODE] like '5.%'
			)
		loop
			if		( fd.C_CODE like '4.%' and &rd.GetCoreVerProf(fd.C_PROF) = 5 )
				or	( fd.C_CODE like '5.%')
			then
				return 'Перед отключением приложения необходимо в справочнике "' || ::[F_345_DATA]%classname || '" удалить данные по настройкам страхового возмещения.';
			end if;
		end loop;
	:'1B618006':
		-- проверка наличия данных в справочнике NORM_PDN_DATA при отмене регистрации
		select	y(count(1))
		in		::[SYSTEM]
		where exists (
						select	x(null)
						in		::[NORM_PDN_DATA]
					)
		into iCount;

		if iCount = 1 then
			return 'Перед отключением приложения необходимо очистить справочник "ОП Нормативы. ПДН. Данные".';
		end if;

	--- :'1B621100':
	--- 	-- Если отмена регистрации, то проверяется наличие записей в справочниках
	--- 	-- "ОП Ф-910. Данные" и "ОП Ф-909. Данные"
	--- 	for	(
	--- 			select	x	( 1 )
	--- 			in	(
	--- 					select	x	( 1 )
	--- 					in		::[F_910_DATA] all
	--- 					fetch	1
	--- 				)
	--- 		union all
	--- 			select	x	( 1 )
	--- 			in	(
	--- 					select	x ( 1 )
	--- 					in		::[F_909_V2_DT] all
	--- 					fetch	1
	--- 				)
	--- 		)
	--- 	loop
	--- 		return		'Перед отключением приложения необходимо очистить справочники '
	--- 				||	'"'	|| ::[F_910_DATA]%classname		|| '" и '
	--- 				||	'"'	|| ::[F_909_V2_DT]%classname	|| '"';
	--- 	end loop;
	--- :'1B618004':
	--- 	select	kd	(count(1))
	--- 	in		::[KRV_DATA]
	--- 	into	iCount;
    --- 
	--- 	if iCount > 0 then
	--- 		return 'Перед отключением приложения необходимо очистить справочник "' || ::[KRV_DATA]%classname || '".';
	--- 	end if;

	-- если отмена регистрации приложения,
	-- то проверяется наличие записей в справочнике ОП Разработочная таблица по предметам залога
	-- и реализация принадлежит Разработочной таблице по предметам залога
	/** /
	:'1B621200':
		select	x(count(1)	:	C_CNT)
		in	(	select	x(x)
				in		::[RP_ZALOG_BODY_RT]
					,	(::[REPS_PARAMS] : p)
				where	x.[PN] = p%id
					and	p.[REPORT].[CODE] = 'RT_ZB'
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник "' || ::[RP_ZALOG_BODY_RT]%classname || '" по реализации разработочной таблицы по предметам залога.';
		end if;

	-- если отмена регистрации приложения,
	-- то проверяется наличие записей в справочнике ОП Разработочная таблица по предметам залога
	-- и реализация принадлежит Ф-310
	:'1B621201':
		select	x(count(1)	:	C_CNT)
		in	(	select	x(x)
				in		::[RP_ZALOG_BODY_RT]
					,	(::[REPS_PARAMS] : p)
				where	x.[PN] = p%id
					and	p.[REPORT].[CODE] = 'F_310'
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник "' || ::[RP_ZALOG_BODY_RT]%classname || '" по реализации формы отчета 0409310.';
		end if;
	-- если отмена регистрации приложения,
	-- то проверяется наличие записей в справочнике данных отчета с кодом NORM_KRS
	:'1B618003':
		select	rd(count(1))
		in		::[NORM_KRS_DATA]
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник "' || ::[NORM_KRS_DATA]%classname || '".';
		end if;
	:'1B620469':
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1)	: C_CNT)
		in	(	select	x(x)
				in		::[FOR_753_DATA]
				fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник "' || ::[FOR_753_DATA]%classname || '".';
		end if;
	-- если отмена регистрации приложения,
	-- то проверяется наличие записей в справочнике данных отчета с кодом NORM_MPL
	:'1B618007':
		select	rd	(
						count(1)
					)
		in		::[NORM_MPL_DT] all
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник "' || ::[NORM_MPL_DT]%classname || '".';
		end if;
	/**/
	end;

	return null;
end;

-- Добавляет или отключает настройку в справочнике "ОП Настройки" (FP_TUNE)
procedure RegTun
		(	pCodePril		varchar2(32767)
		,	pReg			boolean
		)
is
	recTune			[FP_TUNE];
begin
	recTune.[CODE] := null;

	case pCodePril of

	:'1B620530':
	-- Ведение рейтингов международных и российских рейтинговых агентств
		recTune.[CODE]		:=	'RATING';
		recTune.[GROUP_ID]	:=	'REPS';
		recTune.[NAME]		:=	'Разрешить обработку рейтингов';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить обработку рейтингов.'||LF$||
								'Вариант "ДА"  - Разрешает обрабатывать рейтинги (категория "RATING"). '||LF$||
								'Вариант "НЕТ" - Обработка рейтингов (категория "RATING") не происходит.';

	:'1B620263':	-- 406.работа с платежными документами
		recTune.[CODE]		:=	'F_406_DOC_FUNC_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Разрешить обработку платежных документов в Ф-406.';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить обработку платежных документов в Ф-406.'||LF$||
								'Возможные значения:'||LF$||
								'true - используется;'||LF$||
								'false - не используется.';

	:'1B620427': --901.расшифровка
		recTune.[CODE]		:=	'F_901_CALC_DECODE_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Разрешить расчет Ф-901 с расшифровкой по лицевым счетам.';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить расчет Ф-901 с расшифровкой по лицевым счетам.'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B620900': -- Настройка обязательной отчетности ЦБ РФ в режиме единого окна.
		recTune.[CODE]		:=	'1B620900';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Настройка обязательной отчетности ЦБ РФ в режиме единого окна';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Настройка обязательной отчетности ЦБ РФ в режиме единого окна'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B620015': --101.расчет по головному филиалу как разность между сводом и реализациями филиалов
		recTune.[CODE]		:=	'F_101_CALC_HIGH_FILIAL';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Разрешить расчет Ф-101 по головному филиал';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить расчет Ф-101 по головному филиалу как разность сводной реализации и реализаций филиалов'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';
	:'1B620123':	-- Работа с ломбардным списком
		recTune.[CODE]		:=	'LOMBARD_CBRF_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Разрешить работу с ломбардным списком ЦБ РФ.';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить работу с ломбардным списком ЦБ РФ.'||LF$||
								'Возможные значения:'||LF$||
								'true - используется;'||LF$||
								'false - не используется.';

	:'1B620405':	-- 808 справочно
		recTune.[CODE]		:=	'F_808_SPR_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Разрешить работу с ОП Ф-808 Справочно.';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить работу с разделом Справочно ОП Ф-808.'||LF$||
								'Возможные значения:'||LF$||
								'true - используется;'||LF$||
								'false - не используется.';

	:'1B620255': -- Ф-402 Импорт пороговых значений
		recTune.[CODE]		:=	'F402_IMP_LIM_DBF_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Разрешить импорт пороговых значений Ф-402 из DBF.';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить импорт пороговых значений Ф-402 из DBF.'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';
	:'1B618040': -- Расчет обязательных нормативов. Портфель эмиссионных ценных бумаг
		recTune.[CODE]		:=	'1B618040';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет обязательных нормативов. Портфель эмиссионных ценных бумаг';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет обязательных нормативов. Портфель эмиссионных ценных бумаг'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B618050': -- Расчет обязательных нормативов. Портфель векселей
		recTune.[CODE]		:=	'1B618050';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет обязательных нормативов. Портфель векселей';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет обязательных нормативов. Портфель векселей'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B618020': -- Расчет обязательных нормативов. Межбанковские кредиты и депозиты, корреспондентские счета
		recTune.[CODE]		:=	'1B618020';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет обязательных нормативов. Межбанковские кредиты и депозиты, корреспондентские счета';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет обязательных нормативов. Межбанковские кредиты и депозиты, корреспондентские счета'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B618060': -- Расчет обязательных нормативов. Договоры аренды сейфовых ячеек
		recTune.[CODE]		:=	'1B618060';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет обязательных нормативов. Договоры аренды сейфовых ячеек';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет обязательных нормативов. Договоры аренды сейфовых ячеек'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B618030': -- Расчет обязательных нормативов. Депозиты физических и юридических лиц
		recTune.[CODE]		:=	'1B618030';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет обязательных нормативов. Депозиты физических и юридических лиц';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет обязательных нормативов. Депозиты физических и юридических лиц'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B618010': -- Расчет обязательных нормативов. Кредиты физических и юридических лиц
		recTune.[CODE]		:=	'1B618010';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет обязательных нормативов. Кредиты физических и юридических лиц';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет обязательных нормативов. Кредиты физических и юридических лиц'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B620550': -- Договоры факторингового обслуживания. Разработочная таблица
		recTune.[CODE]		:=	'REPS_FACTORING_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет разработочной таблицы. Договоры факторингового обслуживания';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет разработочной таблицы. Договоры факторингового обслуживания'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B618065': -- Расчет обязательных нормативов. Договоры факторингового обслуживания
		recTune.[CODE]		:=	'1B618065';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет обязательных нормативов. Договоры факторингового обслуживания';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет обязательных нормативов. Договоры факторингового обслуживания'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1R995050': -- Расчет обязательных нормативов. Договоры продуктов Р2
		recTune.[CODE]		:=	'1R995050';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет обязательных нормативов по данным, учитываемым в многопотоковых Приложениях';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет обязательных нормативов. Договоры продуктов "Розница"'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';

	:'1B618045': -- Расчет обязательных нормативов. Обработка сделок РЕПО
		recTune.[CODE]		:=	'1B618045';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет обязательных нормативов. Обработка сделок РЕПО';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет обязательных нормативов. Обработка сделок РЕПО'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';
	:'1B620650': -- Объекты ВХО. Разработочная таблица
		recTune.[CODE]		:=	'REPS_VHO_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет разработочных таблиц. Объекты ВХО';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет разработочных таблиц. Объекты ВХО'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';
	:'1B620071': -- Разработочная таблица по КРЛ
		recTune.[CODE]		:=	'REPS_KRL_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Расчет разработочных таблиц. КРЛ';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Расчет разработочных таблиц. КРЛ'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';
	:'1B620029': -- Форма 0409102. Округление с учетом данных формы 0409101
		recTune.[CODE]		:=	'REPS_F_102_CONTROL_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Форма 0409102. Округление с учетом данных формы 0409101';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Форма 0409102. Округление с учетом данных формы 0409101'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';
	:'1B620019': -- Форма 0409101. Дополнительные правила округления
		recTune.[CODE]		:=	'REPS_F_101_EQUAL_USE';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Форма 0409101. Дополнительные правила округления';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Форма 0409101. Дополнительные правила округления'||LF$||
								'Возможные значения:'	||LF$||
								'true - используется;'	||LF$||
								'false - не используется.';
	:'1B975010': -- "Экспорт данных по ценным бумагам в формате системы "ЭФИР Add-In"
		recTune.[CODE]		:=	'1B975010';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Разрешить взаимодействие с системой "ЭФИР Add-In" по ценным бумагам';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить взаимодействие с системой "ЭФИР Add-In" по ценным бумагам.'||LF$||
								'Возможные значения:'||LF$||
								'true - используется;'||LF$||
								'false - не используется.';
	:'1B975015': -- "Экспорт данных по ПФИ в формате системы "ЭФИР Add-In""
		recTune.[CODE]		:=	'1B975015';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Разрешить взаимодействие с системой "ЭФИР Add-In" по ПФИ';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить взаимодействие с системой "ЭФИР Add-In" по ПФИ.'||LF$||
								'Возможные значения:'||LF$||
								'true - используется;'||LF$||
								'false - не используется.';
	:'1B618131': -- "Рыночный риск. Портфель сделок"
		recTune.[CODE]		:=	'1B618131';
		recTune.[GROUP_ID]	:=	'Обязательная отчетность';
		recTune.[NAME]		:=	'Разрешить импорт данных портфеля из системы "ЭФИР Add-In"';
		recTune.[VAL_TYPE]	:=	'BOOLEAN';
		recTune.[NOTE]		:=	'Разрешить импорт данных портфеля из системы "ЭФИР Add-In"'||LF$||
								'Возможные значения:'||LF$||
								'true - используется;'||LF$||
								'false - не используется.';
	end;

	-- Если заполнена структура настройки
	if recTune.[CODE] is not null then
		if pReg then
			SetRegTune(recTune);
		else
			UnRegTune(recTune);
		end if;
	end if;
end;

-- Дополнительные проверки приложений
procedure DopChecks
		(	pCodePril		varchar2(32767)
		,	pReg			boolean
		)
is
	bUse			boolean;
	rPP			ref	[PATTERN_PRODUCT];
begin
	-- проверка на наличие зарегистрированных приложений для нормативов
	-- если хоть одно приложение зарегистрированно, то отчет "NORM" становится основным, а "F_135" вспомогательным, иначе наоборот.
	if pCodePril in ('1B618065'		-- CLC_FACTOR_%
					,'1B618060'		-- CLC_LEASE_%
					,'1B618010'		-- CLC_CRED_%
					,'1B618020'		-- CLC_COMP_%
					,'1B618030'		-- CLC_DEPN_%
					,'1B618050'		-- CLC_VEX_%
					,'1B618040'		-- CLC_CB_%
					,'1B618045'		-- CLC_REPO_%

					,'1R995050')	-- CLC_%R2_%
	then
		bUse := false;
		if not pReg
		then
			for	(	select	x(x.[CODE] :C_CODE)
					in		::[FP_TUNE]
						,	(	select	z(z.[CODE] :C_CODE)
								in		::[REPS_APPL]
								where	z.[REP] = 'NORM'
									and	substr(z.[OPER],1,3) not in ('PRN','EXP')
								group by z.[CODE]
							)
					where	x.[CODE] = z.C_CODE
				)
			loop
				if ::[FP_TUNE].[LIB].get_bool_value(x.C_CODE) then
					bUse := true;
					exit;
				end if;
			end loop;
		else
			bUse := true;
		end if;

		update	p(p.[CB] = bUse)
		in		::[REPS]
		where	p.[CODE] = 'NORM';

		bUse := not bUse;
		update	p(p.[CB] = bUse)
		in		::[REPS]
		where	p.[CODE] = 'F_135';

		commit;

	-- Если изменено приложение по новой Ф-250
	elsif pCodePril = '1B620920' then
		bUse := false;

		-- Если пытаются зарегистрировать
		if pReg then
			bUse := true;

		-- Отмена регистрации
		else
			-- Проверка иналичия в конфигурации библиотек связанных с приложением
			for	(
					select	p(1)
					in		::[REPS_PROF_TUN]
					where	p.[REP] = ::[REPS]([CODE] = 'F_250')
						and	p.[DEFINE].[SRC_APP] = 'F_250_DT'
						and	exists (	select	x(1)
										in		p.[DEFINE].[LIST_APP]
										where	x.[CODE] in
													(	select	r(r.[OPER])
														in		::[REPS_APPL]
														where	r.[REP] = 'F_250'
															and	r.[CODE] = pCodePril
													)
									)
					fetch 1
				)
			loop
				bUse := true;
				exit;
			end loop;
		end if;

		update	p(p.[CB] = bUse)	in	::[REPS] where p.[CODE] = 'F_250';
		bUse := not bUse;
		update	p(p.[CB] = bUse)	in	::[REPS] where p.[CODE] = 'F_250_OLD';

		commit;

	-- проверка на наличие зарегистрированных приложений для отчёта "F_401_APP"
	-- если хоть одно приложение зарегистрированно, то отчет "F_401_APP" становится основным, а "F_401" вспомогательным, иначе наоборот.
	elsif pCodePril in ('1B620243','1B620245','1B620244','1B620242','1B620241','1B620249','1B620253')
	then
		bUse := true;
		if not pReg
		then
			for	(	select	p(null)
					in		::[REPS_PROF_TUN]
					where	p.[REP] = ::[REPS]([CODE] = 'F_401_APP')
						and	&is_not_empty(p.[DEFINE].[LIST_APP].[CODE])
					fetch 1
				)
			loop
				bUse := false;
				exit;
			end loop;

		elsif pReg
		then
			-- если регистрация, то основным делаем отчёт F_401_APP a F_401 вспомогательным
			bUse := false;
		end if;

		::[REPS]([CODE] = 'F_401').[CB]		:= bUse;
		::[REPS]([CODE] = 'F_401_APP').[CB]	:= not(bUse);

		commit;

	-- В случае отмены регистрации приложения "Форма 0409102. Округление с учетом данных формы 0409101"
	-- необходимо удалить признак его использования из REPS_PARAMS
	elsif pCodePril = '1B620029' and not pReg then
		update	p(p.[INFO] = replace(p.[INFO], '^~P_CONTROL~1~^', ''))
		in		::[REPS_PARAMS]
		where	p.[REPORT] = ::[REPS]([CODE] = 'F_102')
			and	instr(p.[INFO], '^~P_CONTROL~1~^') > 0;

		commit;

	-- В случае отмены регистрации приложения "Форма 0409101. Дополнительные правила округления"
	-- необходимо удалить признак его использования из REPS_PARAMS
	elsif pCodePril = '1B620019' and not pReg then
		for (
				select	x
					(	x				: ID
					,	x.[INFO]		: C_INFO
					,	x.[STROKE]		: C_STROKE
					)
				in		::[REPS_PARAMS]
				where	x.[REPORT] = ::[REPS]([CODE] = 'F_101')
			)
		loop
			bUse := false;
			if instr(x.C_INFO, 'P_CALC_LAST_DAY') > 0 then
				::[RUNTIME].[STR].set_par(x.C_INFO, 'P_CALC_LAST_DAY', '');
				::[RUNTIME].[STR].set_par(x.C_INFO, 'P_OUT_PARAMS', '');
				bUse := true;
			end if;
			if instr(x.C_STROKE, 'Единовременный расчет') > 0 then
				x.C_STROKE := replace(x.C_STROKE, 'Единовременный расчет', '');
				bUse := true;
			end if;
			if bUse then
				update	p
					(	p.[INFO]		= x.C_INFO
					,	p.[STROKE]	= x.C_STROKE
					)
				in		::[REPS_PARAMS]
				where	p = x.ID;
			end if;
		end loop;
		commit;

	-- для приложения "Включение счетов, по которым не осуществляется резервирование, в форму 0409115"
	elsif pCodePril = '1B620980' then
		rPP := ::[PATTERN_PRODUCT].[SLIB].get_PP('ACC_MISS_IN_RES_BASE');
		-- В случае отмены регистрации необходимо удалить связь категории "Отражать счета, отсутствующие в продукте "Резервирование" с Ф-115
		if not pReg then
			for (
				select	u(u.[ADD]		: C_ADD	)
				in		::[PATTERN_PROD_USE]
					,	(::[PATTERN_PRODUCT] : p) all
				Where	u%collection = p.[USE_IN_REPS]
					and	u.[REP] = ::[REPS]([CODE] = 'F_115')
					and	p.[CODE] = 'AC_FIN'
				)
			loop
				delete x in u.C_ADD where x = rPP;
			end loop;
		-- В случае регистрации необходимо добавить связь категории "Отражать счета, отсутствующие в продукте "Резервирование" с Ф-115
		else
			for	(
				select	u
					(	u.[ADD]													: C_ADD
					,	(	select	x(count(x))	in u.[ADD]	where x = rPP )		: C_ACC_MISS_CNT
					)
				in		::[PATTERN_PROD_USE]
					,	(::[PATTERN_PRODUCT] : p) all
				Where	u%collection = p.[USE_IN_REPS]
					and u.[REP] = ::[REPS]([CODE] = 'F_115')
					and p.[CODE] = 'AC_FIN'
				)
			loop
				-- если еще нет связи с категорией, добавляем
				if u.C_ACC_MISS_CNT = 0 then
					u.C_ADD%insert(rPP);
				end if;
			end loop;
		end if;

		commit;

	end if;
end;

-- Проверка на разрешение использования приложения в лицензии
public procedure CheckOptionEnabled
		(	P_REP_CODE		varchar2(32767)
		,	P_OPER_CODE		varchar2(32767)
		)
is
	bCheckApp	boolean;
	vPrilCode	varchar2(1000);
	vPrilName	varchar2(1000);
begin
	for (
			select	x
				(	x.[CODE]	: C_PRIL_CODE
				,	s.[NAME]	: C_PRIL_NAME
				)
			in		::[REPS_APPL]
				left join	(::[SYS_LIST_APP] :s)
					on	x.[CODE] = s.[CODE]
			where		upper(x.[REP]) = upper(P_REP_CODE)
					and	upper(x.[OPER]) = upper(P_OPER_CODE)
			fetch 1
		)
	loop
		vPrilCode := x.C_PRIL_CODE;
		vPrilName := x.C_PRIL_NAME;
		exit;
	end loop;
	--для Формы Ф-250 нужна отдельная проверка
	if nvl(vPrilCode, '#') <> '1B620920'
	then
		return;	-- Не требуется проверка
	end if;

	bCheckApp := opt_mgr.option_enabled(vPrilCode);
	if bCheckApp is null then
		pragma error('Приложение "'||vPrilName||'" ('||vPrilCode||') отсутствует в описании приложений (cft_bank_'||::[SYSTEM].[VERSION].Get_Version||'_'||::[SYSTEM].[VERSION].Get_BUILD_NO||'.xsap)!'||chr(10)||
					 'Необходимо обновить описание приложений!');

	elsif not bCheckApp then
		pragma error('Использование Приложения "'||vPrilName||'" ('||vPrilCode||') запрещено лицензией!'||chr(10)||
					 'Пожалуйста, обратитесь к вашему Региональному директору для получения необходимой лицензии на Приложение!');
	end if;
end;


-- регистрация / отмена регистрации приложения
public procedure SetRegCode
		(	p_pril_code		varchar2(32767)
		,	p_reg			boolean default true
		)
is
	vRez			varchar2(1000);
begin
	-- если необходимо выполнить отмену регистрации приложения p_reg = false
	if not p_reg then

		-- проверяем на возможность отмены регистрации
		vRez := CheckPril(p_pril_code);

		-- если вернулся текст то отмена регистрации не возможна
		if vRez is not null
		then
			-- выводим текст сообщения
			pragma error(vRez);
		end if;
	end if;

	-- Описание приложений регистрируемых через справочник "Настройка." (НЕ через конфигурацию)
	RegTun(p_pril_code, p_reg);

	-- Описание приложений регистрируемых через конфигурацию
	for (
			select	a
				(
					a				: C_REF
				,	a.[REP]			: C_REP
				,	a.[OPER]		: C_OPER
				)
			in		::[REPS_APPL]
			where	a.[CODE] = p_pril_code
			order by	a.[REP]
					,	a.[OPER] desc
		)
	loop
		&debug('Приложение ['||p_pril_code||'] '||bool_char(p_reg, 'зарегистрировано', 'разрегистрировано')||'. Библиотека ['||a.C_OPER||'] для отчета ['||a.C_REP||'] будет '||bool_char(p_reg, 'добавлена в конфигурации всех открытых профилей', 'удалена из конфигураций всех профилей'),dp10)

		--	Обновление признака "Зарегистрировано"
		a.C_REF.[IS_REG]	:= p_reg;

		if p_reg then
			SetReg(a.C_REP, a.C_OPER);
		else
			UnReg(a.C_REP, a.C_OPER);
		end if;
	end loop;

	DopChecks(p_pril_code, p_reg);
end;


/**
 * Проверка регистрации приложения
 * 
 * @param	P_APP:	Код приложения
 * 
 * @return:	Признак регистрации приложения
 */
function CheckRegApp
		(
			P_APP	varchar2(128)
		)
	return	boolean
is
	bIsReg	boolean	:=	false;
begin
	for	(
			select	x	(1)
			in		::[SYS_LIST_APP] all
			where	x.[CODE] = P_APP
				and	exists	(
								select	z	(1)
								in		x.[STEP_TUNE]
								where	z.[EXEC_STEP]
							)
				and	not exists
							(	select	z	(1)
								in		x.[STEP_TUNE]
								where	not z.[EXEC_STEP]
									or	z.[EXEC_STEP] is null
							)
			fetch	1
		)
	loop
		bIsReg := true;
	end loop;

	return bIsReg;
end;


/**
 * Добавление приложения в список соответствий ОП. Приложения.
 * 
 * @param	P_APP:	Код приложения
 * @param	P_REP:	Код отчета
 * @param	P_OPER:	Код операции
 */
public procedure AddApplication
		(
			P_APP	varchar2(32767)
		,	P_REP	varchar2(32767)
		,	P_OPER	varchar2(32767)
		)
is
	recRepsAppl	[REPS_APPL];
begin
	for	(
			select	x	(1)
			in		::[REPS_APPL] all
			where	x.[CODE] = P_APP
				and	x.[REP] = P_REP
				and	x.[OPER] = P_OPER
		)
	loop
		return;
	end loop;

	recRepsAppl.[CODE]		:=	P_APP;
	recRepsAppl.[REP]		:=	P_REP;
	recRepsAppl.[OPER]		:=	P_OPER;
	recRepsAppl.[IS_REG]	:=	CheckRegApp(P_APP);

	::[REPS_APPL]%insert(recRepsAppl);
end;
end;
