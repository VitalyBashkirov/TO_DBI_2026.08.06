	DetailPrintOperList.delete;
	DetailPrintFormList.delete;
	t_DopTags.delete;
	t_Tags.delete;
end;

public function GetOkatoCode
/* Функция для получения ОКАТО с клиента */
(
	p_CLIENT_REF	ref [CLIENT]
	/* Ссылка на клиента */
)
/* Возвращаемое значение - ОКАТО */
return varchar2(11) is 
	v_okato	varchar2(11);
begin
	-- значение ОКАТО берем из реквизита "Код ОКАТО" на клиенте
	for (	select x(x.[OKATO_CODE]	:	OKATO_CODE)
			in ::[CLIENT] all
			where x = p_CLIENT_REF
			fetch 1)
	loop
		v_okato := x.OKATO_CODE;
		exit;
	end loop;
	return v_okato;
end;
PSH_PRNT_WRD_XML (
	@name('Дата печати')                     P_ON_DATE       in [DATE],
	@name('Операция печати')                 P_PRN_OPER      in [VID_OP_KRED_REF],
	@name('Консольный вызов')                P_CONSOLE       in [BOOLEAN]         default null,
	@name('Полное имя файла для сохранения') P_FILE_NAME_OUT in [FILE$PATH]       default null,
	@name('Доп. Параметры')                  P_ADD_PAR       in [STRING_32000]    default null,
	@name('Шаблон')                          P_SHABLON       in [SHABLON_DOC_REF] default null,
	@name('Показать печать')                 P_SHOW_PRINT    in [BOOLEAN]         default null
) return [STRING] is

validate is
procedure ValidPrintPackage
(
	p_ShablonDoc		ref [SHABLON_DOC]
)
is
begin
	FillPrintForms(p_ShablonDoc, V_FOLDER_PAY);
	if IsPackageShablon(p_ShablonDoc) then
		::[RUNTIME].[CSMD].Enable(V_DEST_STR, 'V_PRINT_FORMS', 'V');
	else
		::[RUNTIME].[CSMD].Disable(V_DEST_STR, 'V_PRINT_FORMS', 'V');
	end if;
end;

begin
	if &Default_Mes and p_info is null or (&Validate_Mes and p_info = '%PLPCALL%') then
		
		P_CONSOLE	:=	true;
		::[RUNTIME].[CSMD].Init_Form(V_DEST_STR, &METHOD$CLASS, &METHOD$SNAME); -- Инициализация формы
		
		-- получим операцию печати по умолчанию из настройки
		P_PRN_OPER	:=	nvl(GetPrintWordOperDefault, P_PRN_OPER);
		
		Initialization(this, P_ON_DATE, P_PRN_OPER, P_SHABLON, P_ADD_PAR);
		
		ValidPrintPackage(V_FILE_NAME);

		-- при заданной настройке операции печати в случае пакетного шаблона
		-- блокируем все элементы смены шаблона
		if P_PRN_OPER is not null and IsPackageShablon(V_FILE_NAME) then
			::[RUNTIME].[CSMD].Disable(V_DEST_STR, 'P_PRN_OPER');
			::[RUNTIME].[CSMD].Disable(V_DEST_STR, 'V_FILE_NAME', 'V');
			::[RUNTIME].[CSMD].Disable(V_DEST_STR, 'V_FOLDER_PAY', 'V');
		end if;
	
		::[DEPN].[GET].SetFolder(p_Folder == V_FOLDER_PAY);
		
	elsif &Validate_Mes then

		::[RUNTIME].[CSMD].Init_Form(V_DEST_STR, null, null);
	
		if p_info = 'CANCEL' then		
			::[DEPN].[GET].SetFolder(p_Folder == null);
			ClearVariable;	-- чистим переменные операции
		elsif p_info = 'P_PRN_OPER' then
			ValidatePrnOper(this, P_PRN_OPER, P_ON_DATE);
			ValidPrintPackage(V_FILE_NAME);
		elsif p_info = '%VAR%.V_FOLDER_PAY' then
			if V_FOLDER_PAY is not null then
				begin
					&sp(PRN)
					P_PRN_OPER := &GET_NUM(PRN_FOR, this, 'PRN_FOR_'||V_FOLDER_PAY%id,null);
				exception when others then 
				-- Причина перехвата others: В случае если не найдена операция печати
					&rb(PRN)
					P_PRN_OPER := null;
				end;					
				ValidatePrnOper(this, P_PRN_OPER, P_ON_DATE);
				ValidPrintPackage(V_FILE_NAME);
			end if;
			::[DEPN].[GET].SetFolder(p_Folder == V_FOLDER_PAY);
		elsif p_info = '%VAR%.V_OUR_BANK' then
			if V_OUR_BANK is null then
				pragma error('Укажите банк для печати.');
			end if;
			GetBankReq(V_OUR_BANK, P_ON_DATE);
		elsif p_info = 'P_ON_DATE' then
			if P_ON_DATE is null then
				pragma error('Укажите дату...');
			end if;
		elsif p_info = '%VAR%.V_FILE_NAME' then
			ValidPrintPackage(V_FILE_NAME);
		elsif p_info = '%VAR%.V_CASTA_1C' then
			::[DEPN_INTERFACE].[PRX_CLIENT].GetCastClient
			(
				V_CLIENT
				,V_CASTA_1C
				,V_DEF_1C
				,V_CASTA_C1_RP
				,V_FIO_C1_RP
				,V_F_IO_1C
				,P_ON_DATE
				,V_CLASS
			);
		elsif p_info = '%VAR%.V_CASTA_2C' then
			::[DEPN_INTERFACE].[PRX_CLIENT].GetCastClient
			(
				V_CLIENT
				,V_CASTA_2C
				,V_DEF_2C
				,V_CASTA_C2_RP
				,V_FIO_C2_RP
				,V_F_IO_2C
				,P_ON_DATE
				,V_CLASS
			);
		elsif p_info = '%VAR%.V_CASTA_1B' then
			::[DEPN_INTERFACE].[PRX_CLIENT].GetCastClient
			(
				V_OUR_BANK
				,V_CASTA_1B
				,V_DEF_1B
				,V_CASTA_B1_RP
				,V_FIO_B1_RP
				,V_F_IO_1B
				,P_ON_DATE
				,V_CLASS
			);
			::[DEPN_INTERFACE].[PRX_CLIENT].GetPhoneClient
			(
				V_CASTA_1B.[FASE]
				,V_PHONE_11B
				,V_PHONE_12B
			);
		elsif p_info = '%VAR%.V_CASTA_2B' then
			::[DEPN_INTERFACE].[PRX_CLIENT].GetCastClient
			(
				V_OUR_BANK
				,V_CASTA_2B
				,V_DEF_2B
				,V_CASTA_B2_RP
				,V_FIO_B2_RP
				,V_F_IO_2B
				,P_ON_DATE
				,V_CLASS
			);
			::[DEPN_INTERFACE].[PRX_CLIENT].GetPhoneClient
			(
				V_CASTA_2B.[FASE]
				,V_PHONE_21B
				,V_PHONE_22B
			);
		end if;
	end if;
	
	--Расширение
	if p_message = 'DEFAULT' then
		if this.[DEPART].[CODE] like '001-6%' then
			V_CASTA_1B=V_CASTA_2B:=null;
			for ab in this.[FILIAL].[BANK].[ALL_BOSS]
			where ab.[SIGN_TODAY] and ab.[WORK_END] is null
			loop
				for mr in ab.[MARK_PERS] where mr.[MARK].[CODE]='PSB_DEPN_SIGN_1' loop
					V_CASTA_1B:=ab;
					exit;
				end loop;
				for mr in ab.[MARK_PERS] where mr.[MARK].[CODE]='PSB_DEPN_SIGN_2' loop
					V_CASTA_2B:=ab;
					exit;
				end loop;
				if V_CASTA_1B is not null and V_CASTA_2B is not null then
					exit;
				end if;
			end loop;
		end if;

		V_FILE_NAME:=null;
		if (this.[DATE_ENDING]<=::[SYSTEM].[OP_DATE] or this.[DATE_ENDING] is null)
		and this.[DATE_BEGIN] <>::[SYSTEM].[OP_DATE]
		and this.[COM_STATUS]=::[COM_STATUS_PRD]([CODE]='WORK')
		then
			P_PRN_OPER:=::[VID_OPER_DOG]([SYS_NAME]='Печать "Закрытие, расторжение"');
			V_FILE_NAME:=::[SHABLON_DOC]([CODE]='PSH_Заявление на закрытие вклада');
		elsif this.[DATE_BEGIN]=::[SYSTEM].[OP_DATE]
		or    this.[COM_STATUS]=::[COM_STATUS_PRD]([CODE]='WAIT_CONF')
		then
			P_PRN_OPER:=::[VID_OPER_DOG]([SYS_NAME]='Печать депозитного договора в WORD');
		end if;
		if P_PRN_OPER is not null then
			null;
		end if;

	elsif p_info='P_PRN_OPER' then
		V_FILE_NAME:=null;
		if P_PRN_OPER=::[VID_OPER_DOG]([SYS_NAME]='Печать депозитного договора в WORD') then
			if lower(this.[VID_DOG].[NAME]) like '%до востребования%' then
				if this.[DEPART].[CODE] like '001-6%' then
					 V_FILE_NAME:=::[SHABLON_DOC]([CODE]='До востребования Энгельс');
				else V_FILE_NAME:=::[SHABLON_DOC]([CODE]='до востребования (Москва)');
				end if;
			end if;
		elsif P_PRN_OPER=::[VID_OPER_DOG]([SYS_NAME]='Печать "Закрытие, расторжение"') then
			V_FILE_NAME:=::[SHABLON_DOC]([CODE]='PSH_Заявление на закрытие вклада');
		end if;
	end if;
	------------
end;

execute is
/*
 *	Дата		Автор			BFS			Описание
 *	----------	--------------	----------	---------------------------------------------------
 *	29.04.2015	khasenov		RP0082357	Новая операция, реализующая печать в OOXML.
 *  22.09.2015	nechaev			RP0374806   В функции GetPrdInfo  получение БИК и корсчета реализовано через вызов ::[CL_BANK_N].[LIB].GetBankReqOnDate (из истории реквизитов на дату).
 *	28.04.2016	akhmadiev		RP0489949	При выборе шаблона печати добавлен анализ реквизита "Шаблоны печати" на виде депозитного договора.
 *	02.06.2016	akhmadiev		RP0530021	Внеcены изменения в алгоритм определния ОКАТО.
 *	05.09.2016	akhmadiev		RP0507846	Рефакторинг GET'ов
 *	20.10.2016	burganov		RP0540508	В секции "Проверка" при валидации '%VAR%.V_FOLDER_PAY' и в процедуре Initialization добавлен обработчик ошибки, в случае если не найдена операция печати
 *	14.02.2016	akhmadiev		RP0487313	Добавлена обработка кодиков OGRN и OKPO.
 *	20.04.2017	akhmadiev		RP0555942	Добавлена обработка тега PRC_RATE. Обработка добавлена специально, т.к. без дополнительной обработки %% ставка меньше единицы отображается некорректно.
 *											Например ставка 0.5 в документе отображается как .5
 *	15.04.2019	akhmadiev		RP0605061	Добавлено форматирование выч. параметра GMIR
*/

	rep_id		string;
begin
	
	if not nvl(P_CONSOLE, false) then

		if P_PRN_OPER is null and P_SHABLON is null then
			pragma error('Не задан вид операции или шаблон для печати');
		end if;
		
		Initialization(this, P_ON_DATE, P_PRN_OPER, P_SHABLON, P_ADD_PAR);
		
		if V_FILE_NAME is null then
			pragma error('Для операции печати "'||P_PRN_OPER.[SYS_NAME]||'" не настроен шаблон');
		end if;

		FillPrintForms(V_FILE_NAME, V_FOLDER_PAY);
		
		::[DEPN].[GET].SetFolder(p_Folder == V_FOLDER_PAY);		
	end if;
	
	-- инициализация тэгов
	InitializTag;
	
	if V_FILE_NAME is null then
		pragma error('Не задан шаблон для печати');
	end if;
	
	
	-- Печатаем
	if IsPackageShablon(V_FILE_NAME) then
		
		for i in 1 .. V_PRINT_FORMS.count
		where V_PRINT_FORMS(i).print_sign
		loop
			rep_id	:=	PrintWordXML
			(
				DetailPrintFormList(i).Deposit,
				P_ON_DATE,
				V_PRINT_FORMS(i).[TEMPLATE],
				&Method$ID,
				DetailPrintFormList(i).AddParams
			);

			stdio.put_line_buf('<%PLPCALL [OOXML].[SHOW](%VAR%.V_REPID =>'''||rep_id||''')%>');

		end loop;
		rep_id	:=	'';
	else
		rep_id	:=	PrintWordXML
		(
			this,
			P_ON_DATE,
			V_FILE_NAME,
			&Method$ID,
			P_ADD_PAR
		);

			if P_FILE_NAME_OUT is not null then
				-- если файл для сохранения задан, то просто сохраняем печатный документ в заданный файл
				stdio.put_line_buf('<%PLPCALL [OOXML].[SAVE_AS](%VAR%.V_REPID =>'''||rep_id||''',%VAR%.V_FILE_NAME =>''' || P_FILE_NAME_OUT || ''')%>');
			elsif nvl(P_SHOW_PRINT, true) then
				-- если файл для сохранения не задан, то по умолчанию показываем печатный документ
				stdio.put_line_buf('<%PLPCALL [OOXML].[SHOW](%VAR%.V_REPID =>'''||rep_id||''')%>');
			end if;

	end if;
	
	::[DEPN].[GET].SetFolder(p_Folder == null);
	
	ClearVariable;	-- чистим переменные операции
	
	return rep_id;
end;
end;
end;
