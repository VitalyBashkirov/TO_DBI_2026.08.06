class HOOK_BANK;

@import_plsql(true)
@this(create_on_start:=true)
@name('Документ РЦ. Транспортная библиотека')
@tag('COPIED')
static method DOC_RC_SWIFT_RUR is
pragma include ('APPAUX_CALLPOINT.COMPILE_LIB');

-- VRI 14/02/2025 удаление целиком поля с заданным кодом из текста SWIFT 
public function del_field_from_swift(v_text MEMO_4000, num_field string(10)) return MEMO_4000 is
	p_pos1			integer;
	p_pos2			integer;
	str				string(1000);	
begin
	p_pos1 := instr(v_text, num_field);
	if p_pos1 > 0 then
		p_pos2 := instr(v_text,  NL$, p_pos1+1) + 2;
		for i in 1..6
		loop
			if substr(v_text, p_pos2, 1) <> ':' then
				p_pos2 := instr(v_text,  NL$, p_pos2+1) + 2;
				--debug_pipe('1 p_pos2= '||p_pos2||  '         p_pos2.text = '||  substr(v_text, p_pos2, 1),10);
			else 
				exit;
			end if;
		end loop;
		
		if p_pos2 > 0 then
			str := substr(v_text, p_pos1, p_pos2-p_pos1);
			v_text := replace(v_text, str);
		end if;
	end if;
	return v_text;
end;

DOC_RC_SWIFT_RUR (
	@name('Документ РЦ')         P_DOC    in     [DOCUM_RC_REF],
	@name('Договор РЦ')          P_AGR    in     [TRC_REF],
	@name('Версия')              VER      in     [DIG_16],
	@name('Без заголовка')       NO_TITLE in     [BOOLEAN],
	@name('Сообщение SWIFT-RUR') TEXT_DOC in out [STRING_32000],
	@name('Код запуска')         P_CODE   in     [STRING_10]
) is

execute is
	str				string(1000);	
	str_1			string(1000);
	pole			string(10);
begin
	-- Добавление поля 53В счета получателя, если оно отстутсвует
	if TEXT_DOC not like '%:53B:%' then
		pole := ':53B:';
		if P_AGR.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'N') then
			str := P_AGR.[ACC_N_OUT];
			if str is null then
				debug_pipe('По договору РЦ ностро - не заполнен внешний счет для договора с участником'||P_AGR.[CLIENT].[CODE], 0);
			end if;
		else
			str := P_AGR.[ACCOUNT].[MAIN_V_ID];
		end if;

		if str is not null then
			if ::[TRC].[GET_FLAG]('SWIFT_RUR_53B_C_D') then
				str := bool_char(P_AGR.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'N'), 'D', 'C')||'/'||str;
			end if;
			str := pole || '/' || str || NL$;
			
			str_1 := case when instr(TEXT_DOC, NL$ || ':56: ') > 0  then ':56:'
						  when instr(TEXT_DOC, NL$ || ':56A:') > 0  then ':56A:'
						  when instr(TEXT_DOC, NL$ || ':56B:') > 0  then ':56B:'
						  when instr(TEXT_DOC, NL$ || ':56C:') > 0  then ':56C:'
						  when instr(TEXT_DOC, NL$ || ':56D:') > 0  then ':56D:'
						  when instr(TEXT_DOC, NL$ || ':57:' ) > 0  then ':57:'
						  when instr(TEXT_DOC, NL$ || ':57A:') > 0  then ':57A:'
						  when instr(TEXT_DOC, NL$ || ':57B:') > 0  then ':57B:'
						  when instr(TEXT_DOC, NL$ || ':57C:') > 0  then ':57C:'
						  when instr(TEXT_DOC, NL$ || ':57D:') > 0  then ':57D:'
						  when instr(TEXT_DOC, NL$ || ':58:' ) > 0  then ':58:'
						  when instr(TEXT_DOC, NL$ || ':58A:') > 0  then ':58A:'
						  when instr(TEXT_DOC, NL$ || ':58B:') > 0  then ':58B:'
						  when instr(TEXT_DOC, NL$ || ':58C:') > 0  then ':58C:'
						  when instr(TEXT_DOC, NL$ || ':58D:') > 0  then ':58D:'
						  when instr(TEXT_DOC, NL$ || ':59:' ) > 0  then ':59:'
						  when instr(TEXT_DOC, NL$ || ':59A:') > 0  then ':59A:'
						  when instr(TEXT_DOC, NL$ || ':59B:') > 0  then ':59B:'
						  when instr(TEXT_DOC, NL$ || ':59C:') > 0  then ':59C:'
						  when instr(TEXT_DOC, NL$ || ':59D:') > 0  then ':59D:'
					end; 
			
			if str_1 is not null then
				TEXT_DOC := replace(TEXT_DOC, str_1, str || str_1);
			end if;
		end if;
	end if;
	
	-- Удаление поля 57D если в нём прописан наш банк ПСХБ
	if TEXT_DOC like '%:57D:%044525771%' or TEXT_DOC like '%:57D:%30101810445250000771%' then
		TEXT_DOC := del_field_from_swift(TEXT_DOC, ':57D:');
	end if;
	
	--debug_pipe('TEXT_DOC = '||TEXT_DOC,10);
	--pragma error('str = '||str);
	
end;
end;
end;
