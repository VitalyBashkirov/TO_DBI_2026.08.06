---получаем менеджера клиента
function get_cl_info_user(p_rko ref [RKO]) return varchar2(100)
is
p_name varchar2(1000);
p_casta   varchar2(1000);
v_str   varchar2(100);
cl_info ref [CL_INFO_REQ];
v_ref ref [CL_INFO_USER];
begin
cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(p_rko.[CLIENT]); 	  
v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_MANAGER', 	cl_info, p_name, p_casta);
			p_name := v_ref.[NAME]; 
			return p_name;
 
end;

--Проверка организации, имеющие действующий расчетный счет в ООО "Промсельхозбанк"
function checkAccPayment(inn varchar2 )return boolean
	is
	tmp	number;
begin
	select x(nvl(max(1), 0)) in ::[CLIENT] where x.[INN] = inn  and rownum = 1
	and exists (select y(1) in ::[AC_FIN] where y.[CLIENT_V]=x%id and y.[DATE_CLOSE] is null)
	 into tmp;
	
	if tmp=1 then
		return true;
	else
		return false;
	end if;		
end;


---проверка платежей самому себе
function checkYourselfPayment(acc ref [AC_FIN], acc1 ref [AC_FIN]) return boolean
is
begin
    if acc.[CLIENT_V]=acc1.[CLIENT_V] then
    	return true;
    else
    	return false;
    end if;	
end;


---проверка наличия операции с другими клиентами банка
function checkAnother(v_inn varchar2,v_inn1 varchar2, coming boolean, d_begin date, d_end date) return boolean
	is
	tmp	number;
begin
  
    if coming then
	select x(nvl(max(1), 0)) in ::[MAIN_DOCUM] where x.[KL_DT].[2].[INN]=v_inn and x.[KL_KT].[2].[INN] != v_inn1 
	and x.[DATE_DOC] >= d_begin and x.[DATE_DOC] <= d_end
	and rownum = 1 into tmp;
    else
    select x(nvl(max(1), 0)) in ::[MAIN_DOCUM] where x.[KL_KT].[2].[INN]=v_inn and x.[KL_DT].[2].[INN] != v_inn1 
    and x.[DATE_DOC] >= d_begin and x.[DATE_DOC] <= d_end 
	and rownum = 1 into tmp;
    end if;
   -- debug_pipe('v_inn = '||v_inn||'; v_inn1 = '||v_inn1||'; tmp = '||tmp||'; coming = '||coming, 0);
	if tmp=1 then
		return true;
	else
		return false;
	end if;
end;

---Шифры типологии сомнительных операций  
function get_code_operation(v_inn varchar) return varchar
is
 vres varchar2(1000);
begin	
	select x(analytic(listagg(t.[CODE]||'; '), 'within group(order by [1])', t.[CODE])) in ::[KYC_LIST_RISKS], (::[KYC_REASON] all r), (::[KYC_RISK_TYPOLOG] all t)
	where r%collection=x.[REASONS] and t%id=r.[TYPOLOGY] and x.[INN]=v_inn  and x.[DATE_EXCLUDE] is null into vres;
	return vres;
end;


procedure Draw(	
				p_dDateBeg 	date, 
				p_dDateEnd 	date,
				p_rko ref [RKO]
				)
is
v_head varchar2(2000);
nCnt number default 1;
nCntR number default 1;
summa_all_in number;
summa_all_out number;
rows integer;
code_p	varchar2(2000);
risk_level varchar2(1000);
maxCnt	number;   
iBorder integer;
iFont	integer;
writeBold	boolean;
i	integer;
j	integer;
v_account	varchar2(30);
v_organization varchar2(1000);
summ_70601	number;

begin
iBorder	:= &xl.get_border(&xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
iFont:=&xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == false, p_rgb == null);
	&xl.cell(  p_row	==	1,
	       p_col	==	2,
       	   p_value  == p_rko.[CLIENT].[NAME]|| ' ИНН ' || p_rko.[CLIENT].[INN]|| ' р/c ' || p_rko.[ACCOUNT].[MAIN_V_ID],
           p_fontId == &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null),
           p_horizontal == &align_horizontal_center
	);
	&xl.cell(  p_row	==	2,
	       p_col	==	2,
       	   p_value  == 'период с '||to_char(p_dDateBeg, 'dd.mm.yyyy')|| ' по '||to_char(p_dDateEnd, 'dd.mm.yyyy'),
           p_fontId == &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null),
           p_horizontal == &align_horizontal_center
	);
	
	&xl.cell(  p_row	==	4,
	       p_col	==	2,
       	   p_value  == 'Канал привлечения: '||get_cl_info_user(p_rko),
           p_fontId == &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null),
           p_horizontal == &align_horizontal_center
	);
	&xl.cell(  p_row	==	5,
	       p_col	==	2,
       	   p_value  == 'Счёт открыт '||to_char(p_rko.[ACCOUNT].[DATE_OP], 'dd.mm.yyyy')||'   Счет закрыт '||nvl(to_char(p_rko.[ACCOUNT].[DATE_CLOSE], 'dd.mm.yyyy'), '---')
       	   ||'   Дата последней операции '||nvl(to_char(p_rko.[ACCOUNT].[DATE_LAST], 'dd.mm.yyyy'), '---'),
           p_fontId == &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null),
           p_horizontal == &align_horizontal_center, p_borderId == iBorder
	);
	&xl.cell(  p_row	==	6,
	       p_col	==	2,
       	   p_value  == 'Поступления на счет (Кт)',
           p_fontId == &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == 'FFFF0000'),
           p_horizontal == &align_horizontal_center, p_borderId == iBorder
	);
	&xl.cell(  p_row	==	6,
	       p_col	==	8,
       	   p_value  == 'Списание со счета (Дт)',
           p_fontId == &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == 'FFFF0000'),
           p_horizontal == &align_horizontal_center, p_borderId == iBorder
	);
---Приход	
	tColumnInfo.delete;
	summa_all_in:=0;	
	v_organization:=p_rko.[CLIENT].[NAME];
	for (select x(nvl(x.[KL_DT].[2].[2], c.[NAME]) a, x.[KL_DT].[2].[INN] b, x.[KL_KT].[2].[INN] b1, 
	decode( substr(NVL(x.[KL_DT].[2].[1],x.[NUM_DT]), 1, 5), '70601', '1', '45812', '1', '47422', '1', x.[ACC_DT]) acc,
	 x.[ACC_KT] acc1,
	-- decode(substr(NVL(x.[KL_DT].[2].[1],x.[NUM_DT]), 1, 5), '70601', '1', NVL(x.[KL_DT].[2].[1],x.[NUM_DT])) v_acc ,
	 decode(substr(decode(substr(NVL(x.[KL_DT].[2].[1],x.[NUM_DT]), 1, 5), '70601', '1', NVL(x.[KL_DT].[2].[1],x.[NUM_DT])), 1, 4), '0310', '1', '0321', '1', '0') v_acc ,
	  sum(x.[SUM]) s) in ::[MAIN_DOCUM], (::[CLIENT] all :c) all
	 where c%id =x.[KL_KT].[1].[1] and x.[ACC_KT]=p_rko.[ACCOUNT] and x.[DATE_DOC] >= p_dDateBeg and x.[DATE_DOC] <= p_dDateEnd 
	 and x.[VID_DOC].[CODE] in ('БЕЗН_ПЛ_ПОРУЧ', 'БЕЗН_БАНК_ОРД') 
	 and x%state='PROV'
	 group by nvl(x.[KL_DT].[2].[2], c.[NAME]), x.[KL_DT].[2].[INN], 
	 decode( substr(NVL(x.[KL_DT].[2].[1],x.[NUM_DT]), 1, 5), '70601', '1', '45812', '1', '47422', '1', x.[ACC_DT]),
	  x.[ACC_KT],
	   decode(substr(decode(substr(NVL(x.[KL_DT].[2].[1],x.[NUM_DT]), 1, 5), '70601', '1', NVL(x.[KL_DT].[2].[1],x.[NUM_DT])), 1, 4), '0310', '1', '0321', '1', '0'),
	    x.[KL_KT].[2].[INN] order by sum(x.[SUM]) desc ) loop
 
	tColumnInfo(nCnt).num:=nCnt;
	tColumnInfo(nCnt).organization:=x.a;
	tColumnInfo(nCnt).inn:=x.b;
	tColumnInfo(nCnt).summa:=x.s;
	tColumnInfo(nCnt).v_acc:=x.v_acc;
	tColumnInfo(nCnt).flag:=true;
	tColumnInfo(nCnt).innK:=x.b1;
	tColumnInfo(nCnt).acc:=x.acc;
	tColumnInfo(nCnt).acc1:=x.acc1;
	nCnt := nCnt + 1;
	summa_all_in:=summa_all_in + x.s;	
	end loop;
	
	
	
	rows:=nCnt;
	nCnt:=1;
	while rows > nCnt  loop
	writeBold:=checkAccPayment(tColumnInfo(nCnt).inn);
	--debug_pipe('organization = '||tColumnInfo(nCnt).organization||'; writeBold = '||writeBold, 0);
	
		 &xl.cell(nCnt + 8,1,tColumnInfo(nCnt).num, p_wrapText == true, p_horizontal == &align_horizontal_center,
		  p_vertical == &xl.xl_av_top, p_fontId==iFont, p_borderId == iBorder);
		
		 if writeBold then 
		 	 &xl.cell(nCnt + 8,2,tColumnInfo(nCnt).organization, p_wrapText == true, p_horizontal == &align_horizontal_center,
		 	 p_vertical == &xl.xl_av_top, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		 else
		    &xl.cell(nCnt + 8,2,tColumnInfo(nCnt).organization, p_wrapText == true, p_horizontal == &align_horizontal_center,
		 	 p_vertical == &xl.xl_av_top, p_fontId==iFont, p_borderId == iBorder);		 	
		 end if;	
		 if writeBold then 
			 &xl.cell(nCnt + 8,3,tColumnInfo(nCnt).inn, p_wrapText == true, p_horizontal == &align_horizontal_center,
			  p_vertical == &xl.xl_av_top, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		 else
		 	 &xl.cell(nCnt + 8,3,tColumnInfo(nCnt).inn, p_wrapText == true, p_horizontal == &align_horizontal_center,
			  p_vertical == &xl.xl_av_top, p_fontId==iFont, p_borderId == iBorder);
		 end if;	  
		 if writeBold then  		  
			 &xl.cell(nCnt + 8,4, replace(to_char(tColumnInfo(nCnt).summa, '999,999,999,999,999.99'), ',', ' '), p_wrapText == true, p_horizontal == &align_horizontal_center,
			 p_vertical == &xl.xl_av_top, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		 else
		 	&xl.cell(nCnt + 8,4,replace(to_char(tColumnInfo(nCnt).summa, '999,999,999,999,999.99'), ',', ' '), p_wrapText == false, p_horizontal == &align_horizontal_center,
			 p_vertical == &xl.xl_av_top, p_fontId==iFont, p_borderId == iBorder);	
		 end if; 
		  
		 if writeBold then    
			 &xl.cell(nCnt + 8,5,round(100 * (tColumnInfo(nCnt).summa/summa_all_in), 1), p_wrapText == true, p_horizontal == &align_horizontal_center,
		 	 p_vertical == &xl.xl_av_top, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		 else
		 	&xl.cell(nCnt + 8,5,round(100 * (tColumnInfo(nCnt).summa/summa_all_in), 1), p_wrapText == true, p_horizontal == &align_horizontal_center,
		 	 p_vertical == &xl.xl_av_top, p_fontId==iFont, p_borderId == iBorder);
		 end if; 
		  
		--Код(550-П) 
		 select x(analytic(listagg(x.[DENY_CODE]||' от '||to_char(x.[DENY_DATE], 'dd.mm.yyyy')
		 || ' ', ', '), 'within group (order by [1], [2])', x.[DENY_CODE], x.[DENY_DATE]))
		  in ::[DENY_LIST] where x.[MEMBER].[INN]=tColumnInfo(nCnt).inn into code_p;
		 tColumnInfo(nCnt).code_p:=code_p;
		  
		if writeBold then  
	   		 &xl.cell(nCnt + 8, 6, code_p, p_wrapText == true, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		else
			&xl.cell(nCnt + 8, 6, code_p, p_wrapText == true, p_fontId==iFont, p_borderId == iBorder);
		end if;
		----уровни риска
		begin 
		/*risk_level:=null;
		select x(decode(x.[RISK_LEVEL].[0], 1, 'СРЕДНИЙ', 2, 'ВЫСОКИЙ')) in ::[KYC_LIST_RISKS]
		where x.[DATE_EXCLUDE] is null and x.[INN]=tColumnInfo(nCnt).inn and rownum = 1 into risk_level;
		exception when NO_DATA_FOUND then
		null;	
		end;
		begin */
		risk_level:=null;
		select x(decode(x.[RISK_LEVEL].[0], 1, 'СРЕДНИЙ', 2, 'ВЫСОКИЙ')) in ::[KYC_LIST_RISKS]
		where x.[DATE_EXCLUDE] is null and x.[INN]=tColumnInfo(nCnt).inn fetch 1 into risk_level;
		tColumnInfo(nCnt).risk_level:=risk_level;
		exception when NO_DATA_FOUND then
		null;	
		end;
        if risk_level is not null then
        	risk_level:= risk_level||' '||get_code_operation(tColumnInfo(nCnt).inn);        	
        end if;
		
		if writeBold then 
			&xl.cell(nCnt + 8, 7, risk_level, p_wrapText == true, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder); 
		else
			&xl.cell(nCnt + 8, 7, risk_level, p_wrapText == true, p_fontId==iFont, p_borderId == iBorder);
		end if;
		--налоговые платежи
		--if (substr(tColumnInfo(nCnt).v_acc, 1, 4)='0310' or substr(tColumnInfo(nCnt).v_acc, 1, 4)='0321') then
		if (tColumnInfo(nCnt).v_acc = '1') then
			  &xl.Set_Format_Range(nCnt + 8, 1, nCnt + 8, 7,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( '38f0e4' ), p_borderId == iBorder);
			  tColumnInfo(nCnt).flag:=false;	
		end if;
		---самому себе
		--if (upper(tColumnInfo(nCnt).organization)=upper(v_organization)) then
		if (tColumnInfo(nCnt).inn = p_rko.[CLIENT].[INN]) then
			&xl.Set_Format_Range(nCnt + 8, 1, nCnt + 8, 7,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( '0c9227' ), p_borderId == iBorder);
			 tColumnInfo(nCnt).flag:=false;
		end if;
		--другим клиентам банка
			if checkAnother(tColumnInfo(nCnt).inn, tColumnInfo(nCnt).innK, true, p_dDateBeg, p_dDateEnd) then
				&xl.Set_Format_Range(nCnt + 8, 2, nCnt + 8, 2,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'd75ae7' ), p_borderId == iBorder);
				tColumnInfo(nCnt).flag:=false;
			end if;	 	 
		--------------
		 nCnt := nCnt + 1;
	end loop;
	maxCnt := nCnt;
	
---Расход
tColumnInfoR.delete;
	summa_all_out:=0;
	for (select x(nvl(x.[KL_KT].[2].[2], c.[NAME]) a, x.[KL_KT].[2].[INN] b, x.[KL_DT].[2].[INN] b1,
	decode(substr(NVL(x.[KL_KT].[2].[1],x.[NUM_KT]), 1, 5), '70601', '1', '45812', '1', '47422', '1', x.[ACC_KT])  acc, 
	 x.[ACC_DT] acc1,
	--decode(substr(NVL(x.[KL_KT].[2].[1],x.[NUM_KT]), 1, 5), '70601', '1', NVL(x.[KL_KT].[2].[1],x.[NUM_KT])) v_acc, 
	decode(substr(decode(substr(NVL(x.[KL_KT].[2].[1],x.[NUM_KT]), 1, 5), '70601', '1', NVL(x.[KL_KT].[2].[1],x.[NUM_KT])), 1, 4), '0310', '1', '0321', '1', '0') v_acc,
	  sum(x.[SUM]) s) in ::[MAIN_DOCUM], (::[CLIENT] all :c) all
	 where c%id =x.[KL_KT].[1].[1] and x.[ACC_DT]=p_rko.[ACCOUNT] and x.[DATE_DOC] >= p_dDateBeg and x.[DATE_DOC] <= p_dDateEnd  
	 and x.[VID_DOC].[CODE] in ('БЕЗН_ПЛ_ПОРУЧ', 'БЕЗН_БАНК_ОРД')
	 and x%state='PROV'
	-- and nvl(x.[KL_KT].[2].[2], c.[NAME])='ООО "МВМ"'
	 group by nvl(x.[KL_KT].[2].[2], c.[NAME]), x.[KL_KT].[2].[INN], 
	 decode(substr(NVL(x.[KL_KT].[2].[1],x.[NUM_KT]), 1, 5), '70601', '1', '45812', '1', '47422', '1', x.[ACC_KT]), 
	 x.[ACC_DT],
	  decode(substr(decode(substr(NVL(x.[KL_KT].[2].[1],x.[NUM_KT]), 1, 5), '70601', '1', NVL(x.[KL_KT].[2].[1],x.[NUM_KT])), 1, 4), '0310', '1', '0321', '1', '0'),
	   x.[KL_DT].[2].[INN] order by sum(x.[SUM]) desc) loop

	tColumnInfoR(nCntR).num:=nCntR;
	tColumnInfoR(nCntR).organization:=x.a;
	tColumnInfoR(nCntR).inn:=x.b;
	tColumnInfoR(nCntR).summa:=x.s;
	tColumnInfoR(nCntR).acc:=x.acc;
	tColumnInfoR(nCntR).v_acc:=x.v_acc;
	tColumnInfoR(nCntR).flag:=true;
	tColumnInfoR(nCntR).innK:=x.b1;
	tColumnInfoR(nCntR).acc:=x.acc;
	tColumnInfoR(nCntR).acc1:=x.acc1;
	nCntR := nCntR + 1;
	summa_all_out:=summa_all_out + x.s;
	end loop;
	rows:=nCntR;
	nCntR:=1;
	while rows > nCntR  loop
	writeBold:=checkAccPayment(tColumnInfoR(nCntR).inn);
	--debug_pipe('organization = '||tColumnInfoR(nCntR).organization||'; writeBold = '||writeBold, 0);
		-- &xl.cell(nCnt + 8,1,tColumnInfo(nCntR).num, p_wrapText == true);
		 if writeBold then
		 	&xl.cell(nCntR + 8,8,tColumnInfoR(nCntR).organization, p_wrapText == true, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		 else
			 &xl.cell(nCntR + 8,8,tColumnInfoR(nCntR).organization, p_wrapText == true, p_fontId==iFont, p_borderId == iBorder);
		 end if;
		 if writeBold then
			 &xl.cell(nCntR + 8,9,tColumnInfoR(nCntR).inn, p_wrapText == true, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		 else
		 	&xl.cell(nCntR + 8,9,tColumnInfoR(nCntR).inn, p_wrapText == true, p_fontId==iFont, p_borderId == iBorder);
		 end if;
		 if writeBold then
			 &xl.cell(nCntR + 8,10, replace(to_char(tColumnInfoR(nCntR).summa, '999,999,999,999,999.99'), ',', ' '), p_wrapText == true, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		 else
			 &xl.cell(nCntR + 8,10, replace(to_char(tColumnInfoR(nCntR).summa, '999,999,999,999,999.99'), ',', ' '), p_wrapText == false, p_fontId==iFont, p_borderId == iBorder);
		 end if;
		 if writeBold then
			 &xl.cell(nCntR + 8,11,round(100 * (tColumnInfoR(nCntR).summa/summa_all_out), 1), p_wrapText == true, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		 else
			 &xl.cell(nCntR + 8,11,round(100 * (tColumnInfoR(nCntR).summa/summa_all_out), 1), p_wrapText == true, p_fontId==iFont, p_borderId == iBorder);
		 end if;
		--Код(550-П) 
		 select x(analytic(listagg(x.[DENY_CODE]||' от '||to_char(x.[DENY_DATE], 'dd.mm.yyyy')
		 || ' ', ', '), 'within group (order by [1], [2])', x.[DENY_CODE], x.[DENY_DATE]))
		  in ::[DENY_LIST] where x.[MEMBER].[INN]=tColumnInfoR(nCntR).inn into code_p;
		  	tColumnInfoR(nCntR).code_p:=code_p;
		if writeBold then 
		    &xl.cell(nCntR + 8, 12, code_p, p_wrapText == true, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder);
		else
			&xl.cell(nCntR + 8, 12, code_p, p_wrapText == true, p_fontId==iFont, p_borderId == iBorder);
		end if;
		---уровни риска
		begin 
		risk_level:=null;
		select x(decode(x.[RISK_LEVEL].[0], 1, 'СРЕДНИЙ', 2, 'ВЫСОКИЙ')) in ::[KYC_LIST_RISKS]
		where x.[DATE_EXCLUDE] is null and x.[INN]=tColumnInfoR(nCntR).inn fetch 1 into risk_level;
		tColumnInfoR(nCntR).risk_level:=risk_level;
		exception when NO_DATA_FOUND then
		null;
		end;
		if risk_level is not null then
        	risk_level:= risk_level||' '||get_code_operation(tColumnInfoR(nCntR).inn);
        end if;
			
		if writeBold then 
			&xl.cell(nCntR + 8, 13, risk_level, p_wrapText == true, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_borderId == iBorder); 
		else
			&xl.cell(nCntR + 8, 13, risk_level, p_wrapText == true, p_fontId==iFont, p_borderId == iBorder); 
		end if;
		--налоговые платежи
		--if ((substr(tColumnInfoR(nCntR).v_acc, 1, 4) = '0321') or (substr(tColumnInfoR(nCntR).v_acc, 1, 4) = '0310')) then
		if (tColumnInfoR(nCntR).v_acc = '1') then
			  &xl.Set_Format_Range(nCntR + 8, 8, nCntR + 8, 13,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( '38f0e4' ), p_borderId == iBorder);
			  tColumnInfoR(nCntR).flag:=false;	
		end if;
		---самому себе
		--if (upper(tColumnInfoR(nCntR).organization)= upper(v_organization)) then
		if (tColumnInfoR(nCntR).inn = p_rko.[CLIENT].[INN]) then
			 &xl.Set_Format_Range(nCntR + 8, 8, nCntR + 8, 13,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( '0c9227' ), p_borderId == iBorder);
			 tColumnInfoR(nCntR).flag:=false;
		end if;
		--другим клиентам банка
			if checkAnother(tColumnInfoR(nCntR).inn, tColumnInfoR(nCntR).innK, false, p_dDateBeg, p_dDateEnd) then
				&xl.Set_Format_Range(nCntR + 8, 8, nCntR + 8, 8,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'd75ae7' ), p_borderId == iBorder);
				tColumnInfoR(nCntR).flag:=false;
			end if;		 
		-------------
		 nCntR := nCntR + 1;
	end loop;
	if nCntR < nCnt then
	   maxCnt:=nCnt;
	else
	   maxCnt:=nCntR;	
	end if;
	&xl.cell(maxCnt + 8,2,'Итого:', p_wrapText == true, p_fontId==iFont);
	i:=1;
	j:=1;
	---организации встречающиеся в обоих разделах
	for i in 1..nCnt-1 loop
		for j in 1..nCntR-1 loop
			if tColumnInfo(i).organization=tColumnInfoR(j).organization and tColumnInfo(i).flag and tColumnInfoR(j).flag then
				&xl.Set_Format_Range(i + 8, 3, i + 8, 7,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'e3f207' ));	
				&xl.Set_Format_Range(j + 8, 9, j + 8, 13,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'e3f207' ));
				exit;
			end if;
			if tColumnInfo(i).organization=tColumnInfoR(j).organization  then
				&xl.Set_Format_Range(i + 8, 3, i + 8, 7,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'e3f207' ));	
				&xl.Set_Format_Range(j + 8, 9, j + 8, 13,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'e3f207' ));
				exit;
			end if;					
		end loop;
	end loop;
	
---Покрасим 550-П-----
	i:=1;
	for i in 1..nCnt-1 loop
			if tColumnInfo(i).code_p is not null then
				&xl.Set_Format_Range(i + 8, 6, i + 8, 6,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'ffb83d' ));
			end if;				
	end loop;
	i:=1;
		for i in 1..nCntR-1 loop
			if tColumnInfoR(i).code_p is not null then
				&xl.Set_Format_Range(i + 8, 12, i + 8, 12,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'ffb83d' ));
			end if;				
	end loop;
	
---Добавим покраску УР ---------------	
i:=1;
	for i in 1..nCnt-1 loop
			if tColumnInfo(i).risk_level is not null then
			    if tColumnInfo(i).risk_level='ВЫСОКИЙ' then
					&xl.Set_Format_Range(i + 8, 7, i + 8, 7,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'ff0000' ));
			    else
			   		&xl.Set_Format_Range(i + 8, 7, i + 8, 7,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'e3f207' ));
			    end if;
			end if;				
	end loop;
	i:=1;
		for i in 1..nCntR-1 loop
			if tColumnInfoR(i).risk_level is not null then
			    if tColumnInfoR(i).risk_level='ВЫСОКИЙ' then
					&xl.Set_Format_Range(i + 8, 13, i + 8, 13,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'ff0000' ));
			    else
			    	&xl.Set_Format_Range(i + 8, 13, i + 8, 13,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'e3f207' ));
			    end if;	
			end if;				
	end loop;
-----------------------------------------	
	
	&xl.cell(maxCnt + 8,4, 'Итого: '||replace(to_char(summa_all_in, '999,999,999,999,999.99'), ',', ' '), p_wrapText == false, p_fontId==iFont, p_horizontal == &align_horizontal_center);
	&xl.cell(maxCnt + 8,8,'Итого:', p_wrapText == true, p_fontId==iFont);
	&xl.cell(maxCnt + 8,10, replace(to_char(summa_all_out, '999,999,999,999,999.99'), ',', ' '), p_wrapText == false, p_fontId==iFont, p_horizontal == &align_horizontal_center);
	&xl.cell(maxCnt + 8,2,'Остаток на текущую дату:', p_wrapText == true,
	p_fontId == &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null));
	&xl.cell(maxCnt + 8,3, replace(to_char(p_rko.[ACCOUNT].[SALDO], '999,999,999,999,999.99'), ',', ' '), p_wrapText == true, 
	p_fontId == &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null));
	&xl.Set_Format_Range(maxCnt + 8, 1, maxCnt + 8, 13,  p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'D3D3D3' ), p_borderId == iBorder);
	
	&xl.cell(maxCnt + 9,2, 'Организации, встречающиеся в обоих разделах', p_wrapText == true, p_fontId==iFont, p_horizontal == &align_horizontal_center, p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'e3f207'));
	&xl.cell(maxCnt + 10,2, 'Налоговые платежи', p_wrapText == true, p_fontId==iFont, p_horizontal == &align_horizontal_center, p_fillId == ::[OOXML].[API_XL].get_fill_back_color( '38f0e4'));
	&xl.cell(maxCnt + 11,2, 'Платежи со счетами, принадлежащими клиенту', p_wrapText == true, p_fontId==iFont, p_horizontal == &align_horizontal_center, p_fillId == ::[OOXML].[API_XL].get_fill_back_color( '0c9227'));
	&xl.cell(maxCnt + 12,2, 'Организации, осуществляющих операции с другими клиентами банка', p_wrapText == true, p_fontId==iFont, p_horizontal == &align_horizontal_center, p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'd75ae7'));
	&xl.cell(maxCnt + 13,2, 'Организации, находящихся в реестре отказов 550-П', p_wrapText == true, p_fontId==iFont, p_horizontal == &align_horizontal_center, p_fillId == ::[OOXML].[API_XL].get_fill_back_color( 'ffb83d'));
	&xl.cell(maxCnt + 14,2, 'Полужирным шрифтом выделены организации, имеющие действующий расчетный счет в ООО "Промсельхозбанк"', p_wrapText == true, p_fontId==&xl.get_font(p_name == 'Arial', p_family == 2, 
		 	 p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null), p_horizontal == &align_horizontal_center);
	
	

end;
PSH_CLIENT_CONTR (
	@name('Начало периода')    P_DATE_BEGIN in [DATE],
	@name('Окончание периода') P_DATE_END   in [DATE]
) is

validate is

v_out	blob;

begin
	if P_MESSAGE = 'DEFAULT' then		   		
	    P_DATE_BEGIN		:= [SYSTEM]::[OP_DATE];
	    P_DATE_END		:= [SYSTEM]::[OP_DATE];
	end if;
	
	if p_message = 'VALIDATE' then
	
		if P_INFO = 'OK' then
			if P_DATE_BEGIN is null then
				pragma error('Не указана дата начала периода !');
			elsif P_DATE_END is null then
				pragma error('Не указана дата окончания периода !');
			end if;
			
			--Действия с хl		  
			 &xl.init_xls;
			--Берём шаблон			
			::[SHABLON_DOC].[LIB_OOXML].load_blob('PSB_RKO_CLIENT_CONTR', v_out);			
			
			if not ::[OOXML].[API_XL].open_file(v_out) then				
				pragma error('Ошибка преобразования шаблона !');			
			end if;																							
				
			&xl.open_sheet(1);									
			Draw(P_DATE_BEGIN, P_DATE_END, this);
			--Формируем результат
			&xl.finish(v_out);			
			var vRepId	string;
			-- Отправка файла отчёта пользователю на клиентскую машину
			vRepId	:= ::[OOXML].[API_ORSA].putReport2Run(v_out,'xlsx','Ведомость начисленных процентов (OOXML)');
		end if;
	end if;
end;

execute is
begin
	null;
end;
end;
end;
