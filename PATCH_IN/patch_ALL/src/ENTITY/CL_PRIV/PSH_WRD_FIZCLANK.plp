					P_DATA := nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'REAL_LIVE'), '');
				end if;
			elsif p_info = 'ФАКТ_АДРЕС_2023'	then -- KAS 02/12/2023
				if client_priv%id is not null then
					tmp_str := nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'REGISTRATION'), '');
					P_DATA := nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'REAL_LIVE'), '');
					
