public function cl_job(job_id number, cl_id number) return memo is  -- возвращает должность
sp_job memo;
job memo;
n integer:=0;
dat string;
begin
	--Берем с клиента
	for dp in ::[WORK_BOOK] all where dp%collection = job_id
								order by dp.[START_DATE] desc
	loop
		n:=n+1;
				
		job:='['||to_char(dp.[START_DATE], 'dd.mm.yyyy')||' - '||nvl(to_char(dp.[END_DATE],'dd.mm.yyyy'), 'по н.в.')||'] Организация: '||dp.[CORP]||'. Должность: '||dp.[RANGE];
		
		if n = 1 then
			sp_job:=job;
		else sp_job:=sp_job||chr(10)||job;
		end if;
		
	end loop;
	
	--Берем с заявки
	/** /
	--Башкиров В.Г. 08.07.2019 Отключил API DECL_ON_GET_CRED
	for dp in ::[DECL_ON_GET_CRED] all where dp.[CLIENT] = cl_id
	loop
		n:=n+1;
				
	  --job:='Организация: '||dp.[PSB_WORK_CORP]||'. Должность: '||dp.[PSB_T_D].[NAME]||'. Стаж: '||dp.[PSB_WORK_TIME]||'мес.' ;
	  	job:='Организация: '||null||'. Должность: '||null||'. Стаж: '||null||'мес.' ;
		
		if n = 1 then
			sp_job:=job;
		else sp_job:=sp_job||chr(10)||job;
		end if;
		
	end loop;
	/**/
	
	return sp_job;
end;

public function cl_job_path(job_id number, cl_id number, pr number) return string is  --возвращает дату/организацию/должность
sp_job memo;
job memo;
dat string;
begin
	--Берем с клиента
	for dp in ::[WORK_BOOK] all where dp%collection = job_id
								order by dp.[START_DATE] desc
	loop
						
		--job:='['||to_char(dp.[START_DATE], 'dd.mm.yyyy')||' - '||nvl(to_char(dp.[END_DATE],'dd.mm.yyyy'), 'по н.в.')||'] Организация: '||dp.[CORP]||'. Должность: '||dp.[RANGE];
		
		case pr of
		:1: sp_job:=to_char(dp.[START_DATE], 'dd.mm.yyyy');
		:2: sp_job:=nvl(to_char(dp.[END_DATE],'dd.mm.yyyy'), 'по н.в.');
		:3: sp_job:=dp.[CORP];
		:4: sp_job:=dp.[RANGE];
		end;
		
		exit;
	end loop;
	
	return sp_job;
end;

