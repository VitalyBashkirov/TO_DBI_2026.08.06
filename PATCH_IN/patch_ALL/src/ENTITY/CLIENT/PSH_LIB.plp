-- переводы от Юриков Физикам - если больше 100000 Проц от общих приходов
public function isCheckURtoFIZPrc(p_client ref [CLIENT], p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is 
sm number(18,2);
sm1 number(18,2);
begin

	sm := 0;	
	for acc in [AC_FIN] where 	acc.[CLIENT_V] = p_client
								and  (acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] >= p_d_beg)
								and acc.[DATE_OP]<=p_d_end -- or acc.[DATE_CLOSE]
	loop
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_DT] = acc
									and (
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,5) in ('40817','40820','30232','40802') ))
											or
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,3) in ('423', '426')) )
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) in ('40817','40820','30232','40802')) )
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,3) in ('423', '426') ))
										)
		loop
			if not checkNaznPlat_ZRP(md.[NAZN]) then
				sm := sm + md.[SUM_NT];
			end if;
		end loop;
	end loop;

	sm1 := 0;	
	for acc in [AC_FIN] where 	acc.[CLIENT_V] = p_client
								and  (acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] >= p_d_beg)
								and acc.[DATE_OP]<=p_d_end -- or acc.[DATE_CLOSE]
	loop
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_KT] = acc
									/*and (
											(md.[KL_DT].[0] = 1 and (substr(md.[ACC_DT].[MAIN_V_ID],1,5) 	in ('40701','40702','40703','40804','40805','40806','40807','40802') ))
											or
											(md.[KL_DT].[0] = 2 and (substr(md.[KL_DT].[2].[1],1,5) 		in ('40701','40702','40703','40804','40805','40806','40807','40802') ))
										)*/
		loop
			--if not checkNaznPlat_ZRP(md.[NAZN]) then
				sm1 := sm1 + md.[SUM_NT];
			--end if;
		end loop;
	end loop;
	if sm1 = 0 then
		return -1;
	else
		return sm/sm1*100;
	end if;
end;





