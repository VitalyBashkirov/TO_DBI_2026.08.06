pragma macro (RCHK, '::[DOCUM_RC].[RCHK_NEW]');
pragma macro (LV, 	'::[DOCUM_RC].[LIB_VAL]');
pragma macro (SDL,	'::[DOCUM_RC].[SWIFT_DOC_LIB]');


ORI_DOC_RC		[DOCUM_RC];
ORI_MT103		[MT103];
ORI_ISO 		ref [FT_MONEY];
ORI_SUMMA 		number;
ORI_MAIN_DOC 	ref [MAIN_DOCUM];
ORI_DOG_IN		ref [TRC];
ORI_DOG_OUT		ref [TRC];

last_error 		string(1000);

first_time 		boolean;

in_dog			ref [TRC];
out_dog			ref [TRC];
in_iso 			ref [FT_MONEY];
out_iso 		ref [FT_MONEY];

new_summa_doc	number;

vTextFirstDoc	string(32000);

mx_blob blob;

procedure clear_blob is
begin
	if mx_blob is not null then
		if dbms_lob.istemporary(mx_blob)=1 then
			dbms_lob.freetemporary(mx_blob);
		else
			mx_blob := null;
		end if;
	end if;
end;

procedure init_blob(p_blob blob := null) is
begin
	clear_blob;
	if p_blob is not null then
		mx_blob := p_blob;
	else
		dbms_lob.createtemporary(mx_blob,false,dbms_lob.session);
	end if;
end;

-->> PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline
Use_Clearing_Bank 	boolean;
v_RCCL_OLD			ref [CL_PART];

v_dest_prev		memo;
v_valdate_pr	date;
v_pol_name_pr	[PAYER_NAME];
v_pol_acc_pr	[STRING_35];
v_pol_bcode_pr	[STRING_35];
v_pol_bname_pr	[SBRF_NAME];	
v_pol_bank_pr	ref [CL_BANK_F];
v_pol_bacc_pr	[STRING_35];
v_pol_bank_opt	varchar2(1);
v_dopinfo_pr	memo;
v_doc_text_pr	memo;
v_out_trc		ref [CL_PART];
v_pay_name		memo;
v_name_bank_53	memo;
v_acc_bank_53	varchar2(35);
v_bank_53		ref [CL_BANK_F];
