class AC_FIN;

@import_plsql(true)
@this(plsql_lock:=false,assert_null:=false)
@name('[ПСБ] Приложение 4 к Положению Банка России 579-П в Excel')
@tag('COPIED')
static method PSH_EXCEL_4_579P is

@name('V_DEST')             public V_DEST           [STRING_32000];
@name('Файл шаблона excel') public P_FILE_EXECL     [STRING_512];
@name('Файл для вывода')    public P_FILE_PORT_DATE [STRING_512];
pragma include(::[RUNTIME].[DEBUG_MACRO]);
dp integer:=0;	--управление debug_pipe
dp2 integer:=null;	--управление debug_pipe

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

fmt	   string(10):='dd/mm/yyyy';
fmtP   string(10):='dd.mm.yyyy';
fmtHMS string(22):='dd/mm/yyyy HH24:MI:SS';
fmt24 string(22):='dd/mm/yyyy HH24:MI:SS';
dfmt string:='9999999999.99'; --'9999,999,999.99';
--------
/** /
-- Объединение ячеек
excel.Merge(2,1,2,countColumns);
	2, -- Начать со 2 строки
	1, -- Начать с 1 колонки
	2, -- До 2 строки
	6  -- До 6 колонки
-- Запись указанного значения в ячейку по указанному адресу
Excle.Write(  h 	     -1- номер колонки адреса ячейки
			, w 	     -2- номер строки адреса ячейки
			, value      -3- Значение для записи в ячейку
			, Bold	     -4- Признак выделения жирным шрифтом
			, Italic     -5- Признак выделения шрифта курсивом
			, p_size     -6- Размер шрифта
			, FontName   -7- Имя фонта
			, Allighment -8- Строка симолов-обозначений выравнивания
			-	по горизонтали:
				'R'	- вправо
				'L'	- влево
				'C'	- по центру
			-	по вертикали:
				'B'	- вниз
				'T'	- вверх
				'M'	- по центру
/**/
BoldTrue	boolean:=true;	/* Признак выделения жирным шрифтом */
BoldFalse	boolean:=false;	/* Признак выделения жирным шрифтом */
ItalicTrue	boolean:=true;  /* Признак выделения шрифта курсивом */
ItalicFalse	boolean:=false; /* Признак выделения шрифта курсивом */
p_size_14	number:=14;		/* Размер шрифта */
p_size_12	number:=12;		/* Размер шрифта */
p_size_10	number:=10;		/* Размер шрифта */
p_size_8	number:=8;		/* Размер шрифта */
FontNameNull varchar2(50):=null;	/* Имя фонта */

Allighment_CM	varchar2(10):='CM'; -- Строка симолов-обозначений выравнивания
Allighment_RT	varchar2(10):='RT'; -- Строка симолов-обозначений выравнивания
Allighment_C	varchar2(10):='C';  -- по горизонтали:R-вправо L-влево C-по центру
Allighment_LM	varchar2(10):='LM'; -- по горизонтали:R-вправо L-влево C-по центру
Allighment_RM	varchar2(10):='RM'; -- по горизонтали:R-вправо L-влево C-по центру
Allighment_M	varchar2(10):='M';  -- по вертикали:  B-вниз T-вверх M-по центру

iOrientation1 integer:=1;	/* Ориентации страницы. Значения: 1 - Альбомная, 2 - Книжная. */
iOrientation2 integer:=2;	/* Ориентации страницы. Значения: 1 - Альбомная, 2 - Книжная. */
PSH_EXCEL_4_579P (
	@name('На  дату')                      P_BEG       in [DATE],
	@name('Шаблон номера')                 P_MAIN_V_ID in [STRING_25],
	@name('Не выводить счета без остатка') P_NOT_0     in [BOOLEAN]
) is

validate is
countStrHead	  integer := 3; -- сколько строк занято шапкой
countColumns	  integer :=13; -- количество постоянных колонок в отчете
cntrStr			  integer := 0; -- счетчик по строкам

tAP		string(20);	--Актив-Пассив
tAP_NT	[SUMMA];	--Актив-Пассив RUB
tAP_V	[SUMMA];	--Актив-Пассив

t_LS_NT	[SUMMA];	--ИТОГО RUB по лицевым счетам клиента
t_LS	[SUMMA];	--ИТОГО по лицевым счетам клиента

tBS2_NAME [STRING_250];	--БС2
tBS2_NUM string(5);	--БС2
tBS2_NT	[SUMMA];	--ИТОГО RUB по итого счету второго порядка
tBS2	[SUMMA];	--ИТОГО по итого счету второго порядка

tBS1_NAME [STRING_250];	--БС1
tBS1_NUM string(3);	--БС1
tBS1_NT	[SUMMA];	--ИТОГО RUB по счету первого порядка
tBS1	[SUMMA];	--ИТОГО по счету первого порядка

LastAcc [ACCNUM];

mainTitle varchar2(50) := 'Приложение 4 к Положению Банка России 579-П';

column01 varchar2( 40) := '№ сч. 1-го порядка';
column02 varchar2( 40) := '№ сч. 2-го порядка';
column03 varchar2( 40) := 'Номер лицевого счета';
column04 varchar2( 40) := 'Наименование счетов и разделов баланса';
column05 varchar2( 40) := 'Дата предыдущей операции по счету';
column06 varchar2( 40) := 'Код валют (драгоценных металлов)';
column07 varchar2( 84) := 'Остатки в рублях, иностранной валюте и драгоценных металлах в рублевом эквиваленте';
column08 varchar2(110) := 'Остатки в иностранной валюте в сумме соответствующей валюты и в драгоценных металлах в натуральных показателях';
column09 varchar2( 40) := 'Клиент';
column10 varchar2( 40) := 'Клиент ФЛ/ИП. Дата рождения';
column11 varchar2( 40) := 'Клиент ФЛ/ИП. Паспортные данные';
column12 varchar2( 40) := 'Клиент. ИНН';
column13 varchar2( 40) := 'Клиент. ОГРН';

nn integer:=0;				
z_ref ref [ZALOG];
flStepMinus boolean;
tmpStr string(4000);
DateTimeEnd date;
PrimaryOkved [STRING_9];
ClTmp ref [CLIENT];

FlOutBS2 boolean;
FlOutBS1 boolean;
begin
	if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
		P_BEG 		:= [SYSTEM].[OP_DATE];	--to_date('31.07.2021');
		P_MAIN_V_ID	:= null; 				--'407%';
		P_NOT_0		:= true;
		
		excel.Init_Xls;
		stdio.close_all;
		stdio.disable_buf;
		p_info := 'OK';
	elsif P_MESSAGE = 'VALIDATE' then
		debug_pipe('p_info='||p_info||' length(V_DEST)='||length(V_DEST), dp2);
				
		if p_info = 'OK' then
			if P_BEG is null then pragma error('Укажите отчетную дату!'); end if;
			P_MAIN_V_ID:=trim(P_MAIN_V_ID,'%')||'%';
			
			if excel.F_Click then
				excel.F_Click := False;
				
				P_FILE_EXECL := trim([SYSTEM_PARAMS]::[GET]('PATH_LOCAL', false),'\')||'\'||to_char(P_BEG,'yyyymmdd')||' '||mainTitle||'.xlsx';
				debug_pipe('Будем создавать:'||P_FILE_EXECL||' на '||to_char(P_BEG,fmt)||' Счета:'||P_MAIN_V_ID||' '||iif(P_NOT_0,'Не выводить счета без остатка',''), dp);
				excel.open_file(P_FILE_EXECL, false, true); -- запуск Excel
				
				-- Первая строка
				debug_pipe(mainTitle, dp2);
				excel.write(1,1,mainTitle,BoldTrue,ItalicFalse,p_size_14,FontNameNull,Allighment_CM);
				excel.Merge(1,1,1,countColumns);

				-- Вторая строка
				excel.write(2,1,'по состоянию на '||to_char(P_BEG,fmt),BoldTrue,ItalicFalse,p_size_14,FontNameNull,Allighment_CM);
				excel.Merge(2,1,2,countColumns);
				
				-- Форматирование первых столбцов
				excel.write(countStrHead,01, column01,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(01,01,  3); --№ сч. 1-го порядка
				excel.write(countStrHead,02, column02,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(02,02,  5); --№ сч. 2-го порядка
				excel.write(countStrHead,03, column03,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(03,03, 20); --Номер лицевого счета
				excel.write(countStrHead,04, column04,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(04,04, 42); --Наименование счетов и разделов баланса
				excel.write(countStrHead,05, column05,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(05,05, 10); --Дата предыдущей операции по счету
				excel.write(countStrHead,06, column06,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(06,06,  4); --Код валют (драгоценных металлов)
				excel.write(countStrHead,07, column07,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(07,07, 15); --Остатки в рублях, иностранной валюте и драгоценных металлах в рублевом эквиваленте
				excel.write(countStrHead,08, column08,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(08,08, 15); --Остатки в иностранной валюте в сумме соответствующей валюты и в драгоценных металлах в натуральных показателях
				excel.write(countStrHead,09, column09,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(09,09, 24); --Клиент
				excel.write(countStrHead,10, column10,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(10,10, 10); --Клиент ФЛ/ИП. Дата рождения
				excel.write(countStrHead,11, column11,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(11,11, 44); --Клиент ФЛ/ИП. Паспортные данные
				excel.write(countStrHead,12, column12,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(12,12, 12); --Клиент. ИНН
				excel.write(countStrHead,13, column13,BoldTrue,ItalicFalse,p_size_10,FontNameNull,Allighment_CM); excel.Set_Column_Width(13,13, 15); --Клиент. ОГРН

				excel.Wrap_Text (countStrHead,01,countStrHead,countColumns,true); --Устанавка признака переноса текста в диапазоне
				excel.AutoFitRow(countStrHead,01);	  --Установка свойства автоподбора высоты строк (с какой строки, кол-во строк)

				cntrStr:=countStrHead;

				--Башкиров В.Г. 27.09.2020 --Цветкова Лариса. Если задать портфель на следующую дату, т.е. за дату, когда закрылось обеспечение, то закрытое обеспечение еще показывается, чего быть не должно.
				for (select a
						( a%id																: C_ID
						, Upper(a.[MAIN_USV].[VID_S].[VALUE])								: C_VID_S		--а/п
						, a.[MAIN_USV].[USV_US].[NEW_BS1].[NUM]								: C_BS1			--Номер счета 1-го порядка
						, a.[MAIN_USV].[USV_US].[NEW_BS1].[NAME]							: C_BS1_NAME	--Наименование счета 1-го порядка
						, a.[MAIN_USV].[NUM]												: C_BS2			--Номер счета 2-го порядка
						, a.[MAIN_USV].[USV_US].[NAME]										: C_BS2_NAME	--Наименование счета 2-го порядка
						, a.[MAIN_V_ID]														: C_MAIN_V_ID	--Номер лицевого счета
						, a.[NAME]															: C_ACC_NAME	--Наименование лицевого счета
						, nvl(a.[CLIENT_R],a.[CLIENT_V])									: C_CLIENT		--Клиент. Ссылка
						, nvl(a.[CLIENT_R].[NAME],a.[CLIENT_V].[NAME])						: C_NAME		--Клиент
						, ::[AC_FIN].[PSH_LIB_2021].GetData(a%id,P_BEG,'ДР')				: C_DR			--Дата рождения
						, ::[AC_FIN].[PSH_LIB_2021].GetData(a%id,P_BEG,'ПД')				: C_PASSPORT	--Паспортные данные
						, ::[AC_FIN].[PSH_LIB_2021].GetData(a%id,P_BEG,'ИНН')				: C_INN			--ИНН
						, ::[AC_FIN].[PSH_LIB_2021].GetData(a%id,P_BEG,'ОГРН')				: C_OGRN		--ОГРН
						, ::[AC_FIN].[PSH_LIB_2021].GetData(a%id,P_BEG,'ДПО')				: C_DPD			--Дата предыдущей операции по счету
						, a.[FINTOOL].[CUR_SHORT]											: C_CUR_SHORT	--Код валют (драгоценных металлов)
						, [AC_FIN]::[ACC_TURN_LS].turn(a.[ARC_MOVE], 'ВН', P_BEG, P_BEG+1)	: C_SALDO_IN_NT	--Остатки (в рублях)             
						, [AC_FIN]::[ACC_TURN_LS].turn(a.[ARC_MOVE], 'ВВ', P_BEG, P_BEG+1)	: C_SALDO_IN	--Остатки (в иностранной валюте)
						--, a.[FILIAL].[CODE]												: C_FILIAL
						--, a.[DEPART].[CODE]												: C_DEPART
						--, a.[ARC_MOVE]													: C_ARC_MOVE
						, a.[DATE_OP]														: C_DATE_OP
						, a.[DATE_CLOSE]													: C_DATE_CLOSE
						)
					in	(::[AC_FIN] : a)
					Where
						a.[MAIN_V_ID] like P_MAIN_V_ID and
						a.[DATE_OP] < P_BEG	and	nvl( a.[DATE_CLOSE], P_BEG) >= P_BEG
				
					order by 
					 a.[MAIN_USV].[VID_S].[VALUE]			--Актив-Пассив
					,a.[MAIN_USV].[USV_US].[NEW_BS1].[NUM]	--по счету первого порядка
					,a.[MAIN_USV].[NUM]						--по итого счету второго порядка
					,nvl(a.[CLIENT_R],a.[CLIENT_V]).[NAME]	--по лицевым счетам клиента
					,substr(a.[MAIN_V_ID], 1, 8) ||	substr(a.[MAIN_V_ID], 10) --по номеру лицевого счета
				)
				loop
					if P_NOT_0 and nvl(a.C_SALDO_IN_NT,0)=0 and nvl(a.C_SALDO_IN,0)=0 then goto nnn; end if;
					
					nn:=nn+1;
					debug_pipe((1),dp2); cntrStr := cntrStr + 1;
					debug_pipe(Rpad(nn,7)||'['||Rpad(cntrStr,7)||']'||a.C_VID_S||'|'||a.C_BS1||'|'||a.C_BS2||' '||a.C_MAIN_V_ID||' '||a.C_SALDO_IN_NT||' '||a.C_SALDO_IN,dp2);
					
					if tAP is null or tAP<>a.C_VID_S then
						if tAP is null then --АКТИВ-ПАССИВ
							/*АКТИВ-ПАССИВ*/                  excel.write(cntrStr,04,a.C_VID_S,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
										debug_pipe((2),dp2); cntrStr := cntrStr + 1;
							/*№ сч. 1-го порядка           */ excel.write(cntrStr,01,''''||a.C_BS1,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
							/*Наименование разделов баланса*/ excel.write(cntrStr,04,a.C_BS1_NAME,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
										debug_pipe((3),dp2); cntrStr := cntrStr + 1;
							/*№ сч. 2-го порядка           */ excel.write(cntrStr,02,''''||a.C_BS2,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
							/*Наименование разделов баланса*/ excel.write(cntrStr,04,a.C_BS2_NAME,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
										debug_pipe((4),dp2); cntrStr := cntrStr + 1;
							/*№ сч. 1-го порядка                    */ --excel.write(cntrStr,01,''''||a.C_BS1,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
							/*№ сч. 2-го порядка                    */ --excel.write(cntrStr,02,''''||a.C_BS2);
							/*Номер лицевого счета                  */ excel.write(cntrStr,03,''''||a.C_MAIN_V_ID,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
							/*Наименование счетов и разделов баланса*/ excel.write(cntrStr,04,a.C_ACC_NAME);
							/*Дата предыдущей операции по счету     */ excel.write(cntrStr,05,a.C_DPD);
							/*Код валют (драгоценных металлов)      */ excel.write(cntrStr,06,a.C_CUR_SHORT);
							/*Остатки в рублях, иностранной валюте и*/ excel.write(cntrStr,07,a.C_SALDO_IN_NT);
							/*Остатки в иностранной валюте в сумме с*/ excel.write(cntrStr,08,a.C_SALDO_IN);
							/*Клиент                                */ excel.write(cntrStr,09,a.C_NAME		,BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
							/*Клиент ФЛ/ИП. Дата рождения           */ excel.write(cntrStr,10,a.C_DR		,BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
							/*Клиент ФЛ/ИП. Паспортные данные       */ excel.write(cntrStr,11,a.C_PASSPORT	,BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
							/*Клиент. ИНН                           */ excel.write(cntrStr,12,''''||a.C_INN);
							/*Клиент. ОГРН                          */ excel.write(cntrStr,13,''''||a.C_OGRN);
							LastAcc := a.C_MAIN_V_ID;
						  --debug_pipe((5),dp2); cntrStr := cntrStr + 1;
							
							tAP		:=a.C_VID_S;								--Актив-Пассив
							tAP_NT	:=nvl(tAP_NT	,0)+nvl(a.C_SALDO_IN_NT,0);	--Актив-Пассив RUB
							tAP_V	:=nvl(tAP_V		,0)+nvl(a.C_SALDO_IN,0);	--Актив-Пассив Валюта
							
							tBS2_NAME:=a.C_BS2_NAME;							--БС2
							tBS2_NUM:=a.C_BS2;
							tBS2_NT	:=nvl(tBS2_NT	,0)+nvl(a.C_SALDO_IN_NT,0);	--ИТОГО RUB по итого счету второго порядка
							--tBS2	:=nvl(tBS2		,0)+nvl(a.C_SALDO_IN,0);	--ИТОГО по итого счету второго порядка
							
							tBS1_NAME:=a.C_BS1_NAME;							--БС1
							tBS1_NUM:=a.C_BS1;
							tBS1_NT	:=nvl(tBS1_NT	,0)+nvl(a.C_SALDO_IN_NT,0);	--ИТОГО RUB по счету первого порядка
							--tBS1	:=nvl(tBS1		,0)+nvl(a.C_SALDO_IN,0);	--ИТОГО по счету первого порядка
						else
							/*Итого по счету второго порядка*/ excel.write(cntrStr,01,'Итого по счету второго порядка '||tBS2_NUM,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
							/*Остатки в рублях*/               excel.write(cntrStr,07,tBS2_NT);
							/*Остатки в ин.валюте*/            excel.write(cntrStr,08,'x'); --iif(tBS2=0,'x',tBS2));
										debug_pipe((7),dp2); cntrStr := cntrStr + 1;
							/*Итого по счету первого порядка*/ excel.write(cntrStr,01,'Итого по счету первого порядка '||tBS1_NUM,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
							/*Остатки в рублях*/               excel.write(cntrStr,07,tBS1_NT);
							/*Остатки в ин.валюте*/            excel.write(cntrStr,08,'x'); --iif(tBS2=0,'x',tBS1));
										debug_pipe((8),dp2); cntrStr := cntrStr + 1;
							/*Итого по АКТИВ-ПАССИВ*/          excel.write(cntrStr,01,'Итого по '||tAP,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
							/*Остатки в рублях*/               excel.write(cntrStr,07,tAP_NT);
							/*Остатки в ин.валюте*/            excel.write(cntrStr,08,'x'); --iif(tBS1=0,'x',tBS1));
										debug_pipe((9),dp2); cntrStr := cntrStr + 1;
										debug_pipe((9.1),dp2); cntrStr := cntrStr + 1;
										
							
							tAP		:= a.C_VID_S;--Актив-Пассив
							tAP_NT	:=0;	--Актив-Пассив RUB
							tAP_V	:=0;	--Актив-Пассив Валюта
	
							t_LS_NT	:=0;	--ИТОГО RUB по лицевым счетам клиента
							t_LS	:=0;	--ИТОГО по лицевым счетам клиента
							
							tBS2_NAME:=a.C_BS2_NAME;	--БС2
							tBS2_NUM:=a.C_BS2;
							tBS2_NT	:=0;	--ИТОГО RUB по итого счету второго порядка
							tBS2	:=0;	--ИТОГО по итого счету второго порядка
							
							tBS1_NAME:=a.C_BS1_NAME;	--БС1
							tBS1_NUM:=a.C_BS1;
							tBS1_NT	:=0;	--ИТОГО RUB по счету первого порядка
							tBS1	:=0;	--ИТОГО по счету первого порядка
							
							/*АКТИВ-ПАССИВ*/                  excel.write(cntrStr,04,a.C_VID_S,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
										debug_pipe((9.2),dp2); cntrStr := cntrStr + 1;
							/*№ сч. 1-го порядка           */ excel.write(cntrStr,01,''''||a.C_BS1,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
							/*Наименование разделов баланса*/ excel.write(cntrStr,04,a.C_BS1_NAME,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
										debug_pipe((9.3),dp2); cntrStr := cntrStr + 1;
							/*№ сч. 2-го порядка           */ excel.write(cntrStr,02,''''||a.C_BS2,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
							/*Наименование разделов баланса*/ excel.write(cntrStr,04,a.C_BS2_NAME,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
										debug_pipe((9.4),dp2); cntrStr := cntrStr + 1;
						end if;
					end if;

					if tBS2_NAME<>a.C_BS2_NAME then FlOutBS2:=true; 
					else							FlOutBS2:=false;
					end if;
					if tBS1_NAME<>a.C_BS1_NAME then FlOutBS1:=true; 
					else							FlOutBS1:=false;
					end if;
					if tBS2_NAME<>a.C_BS2_NAME or tBS1_NAME<>a.C_BS1_NAME or LastAcc <> a.C_MAIN_V_ID then	--Итого по счету второго порядка
						if FlOutBS2 then
							/*№ сч. 2-го порядка                    */ excel.write(cntrStr,01,'Итого по счету второго порядка '||tBS2_NUM,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
							/*Остатки в рублях, иностранной валюте и*/ excel.write(cntrStr,07,tBS2_NT);
							/*Остатки в иностранной валюте в сумме с*/ excel.write(cntrStr,08,'х'); --tBS2);
										debug_pipe((10.1),dp2); cntrStr := cntrStr + 1;
	
							tBS2_NAME:=a.C_BS2_NAME;	--БС2
							tBS2_NUM:=a.C_BS2;
							tBS2_NT	:=0;	--ИТОГО RUB по итого счету второго порядка
							tBS2	:=0;	--ИТОГО по итого счету второго порядка
							if FlOutBS1 then
								/*Итого по счету первого порядка*/ excel.write(cntrStr,01,'Итого по счету первого порядка '||tBS1_NUM,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
								/*Остатки в рублях*/               excel.write(cntrStr,07,tBS1_NT);
								/*Остатки в ин.валюте*/            excel.write(cntrStr,08,'x'); --iif(tBS2=0,'x',tBS1));
										debug_pipe((8),dp2); cntrStr := cntrStr + 1;
								/*№ сч. 1-го порядка           */ excel.write(cntrStr,01,''''||a.C_BS1,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
								/*Наименование разделов баланса*/ excel.write(cntrStr,04,a.C_BS1_NAME,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
											debug_pipe((10.2),dp2); cntrStr := cntrStr + 1;
								/*№ сч. 2-го порядка           */ excel.write(cntrStr,02,''''||a.C_BS2,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
								/*Наименование разделов баланса*/ excel.write(cntrStr,04,a.C_BS2_NAME,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
											debug_pipe((10.3),dp2); cntrStr := cntrStr + 1;
								
								tBS1_NAME:=a.C_BS1_NAME;	--БС1
								tBS1_NUM:=a.C_BS1;
								tBS1_NT	:=0;	--ИТОГО RUB по итого счету 1-го порядка
								tBS1	:=0;	--ИТОГО по итого счету 1-го порядка
							else
								/*№ сч. 2-го порядка           */ excel.write(cntrStr,02,''''||a.C_BS2,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
								/*Наименование разделов баланса*/ excel.write(cntrStr,04,a.C_BS2_NAME,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
											debug_pipe((10.4),dp2); cntrStr := cntrStr + 1;
							end if;
						end if;

					   --tAP		:=a.C_VID_S;							--Актив-Пассив
						tAP_NT	:=nvl(tAP_NT	,0)+nvl(a.C_SALDO_IN_NT,0);	--Актив-Пассив RUB
						tAP_V	:=nvl(tAP_V		,0)+nvl(a.C_SALDO_IN,0);	--Актив-Пассив Валюта
						
						tBS2_NAME:=a.C_BS2_NAME;							--БС2
						tBS2_NT	:=nvl(tBS2_NT	,0)+nvl(a.C_SALDO_IN_NT,0);	--ИТОГО RUB по итого счету второго порядка
						--tBS2	:=nvl(tBS2		,0)+nvl(a.C_SALDO_IN,0);	--ИТОГО по итого счету второго порядка
						
						tBS1_NAME:=a.C_BS1_NAME;							--БС1
						tBS1_NUM:=a.C_BS1;
						tBS1_NT	:=nvl(tBS1_NT	,0)+nvl(a.C_SALDO_IN_NT,0);	--ИТОГО RUB по итого счету 1-го порядка
						--tBS1	:=nvl(tBS1		,0)+nvl(a.C_SALDO_IN,0);	--ИТОГО по итого счету 1-го порядка
						
						/*№ сч. 1-го порядка                    */ --excel.write(cntrStr,01,''''||a.C_BS1,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
						/*№ сч. 2-го порядка                    */ --excel.write(cntrStr,02,''''||a.C_BS2);
						/*Номер лицевого счета                  */ excel.write(cntrStr,03,''''||a.C_MAIN_V_ID,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_CM);
						/*Наименование счетов и разделов баланса*/ excel.write(cntrStr,04,a.C_ACC_NAME);
						/*Дата предыдущей операции по счету     */ excel.write(cntrStr,05,a.C_DPD);
						/*Код валют (драгоценных металлов)      */ excel.write(cntrStr,06,a.C_CUR_SHORT);
						/*Остатки в рублях, иностранной валюте и*/ excel.write(cntrStr,07,a.C_SALDO_IN_NT);
						/*Остатки в иностранной валюте в сумме с*/ excel.write(cntrStr,08,a.C_SALDO_IN);
						/*Клиент                                */ excel.write(cntrStr,09,a.C_NAME		,BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
						/*Клиент ФЛ/ИП. Дата рождения           */ excel.write(cntrStr,10,a.C_DR		,BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
						/*Клиент ФЛ/ИП. Паспортные данные       */ excel.write(cntrStr,11,a.C_PASSPORT	,BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
						/*Клиент. ИНН                           */ excel.write(cntrStr,12,''''||a.C_INN);
						/*Клиент. ОГРН                          */ excel.write(cntrStr,13,''''||a.C_OGRN);
									LastAcc := a.C_MAIN_V_ID;
								  --debug_pipe((11),dp2); cntrStr := cntrStr + 1;
					end if;
					<<nnn>>
				end loop;
				debug_pipe((13.1),dp2); cntrStr := cntrStr + 1;

				/*Итого по счету второго порядка*/ excel.write(cntrStr,01,'Итого по счету второго порядка '||tBS2_NUM,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
				/*Остатки в рублях*/               excel.write(cntrStr,07,tBS2_NT);
				/*Остатки в ин.валюте*/            excel.write(cntrStr,08,'x'); --iif(tBS2=0,'x',tBS2));
							debug_pipe((14),dp2); cntrStr := cntrStr + 1;
				/*Итого по счету первого порядка*/ excel.write(cntrStr,01,'Итого по счету первого порядка '||tBS1_NUM,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
				/*Остатки в рублях*/               excel.write(cntrStr,07,tBS1_NT);
				/*Остатки в ин.валюте*/            excel.write(cntrStr,08,'x'); --iif(tBS2=0,'x',tBS1));
							debug_pipe((15),dp2); cntrStr := cntrStr + 1;
				/*Итого по АКТИВ-ПАССИВ*/          excel.write(cntrStr,01,'Итого по '||tAP,	BoldFalse,ItalicFalse,null,FontNameNull,Allighment_LM);
				/*Остатки в рублях*/               excel.write(cntrStr,07,tAP_NT);
				/*Остатки в ин.валюте*/            excel.write(cntrStr,08,'x'); --iif(tBS1=0,'x',tBS1));
							debug_pipe((16),dp2); cntrStr := cntrStr + 1;
				
				/** /
				--Cуммы
				excel.write(cntrStr,02  ,'ИТОГО',BoldTrue,null,p_size_10,null,Allighment_LM);
				excel.write(cntrStr,06+1,'=SUM(R[-'||(cntrStr-countStrHead)||']C:R[-1]C)',BoldTrue,null,p_size_10,null,Allighment_LM);--Сумма гарантии
				excel.write(cntrStr,11+1,'=SUM(R[-'||(cntrStr-countStrHead)||']C:R[-1]C)',BoldTrue,null,p_size_10,null,Allighment_LM);--Сумма расчетного резерва
				excel.write(cntrStr,13+1,'=SUM(R[-'||(cntrStr-countStrHead)||']C:R[-1]C)',BoldTrue,null,p_size_10,null,Allighment_LM);--Сумма обеспечения
				excel.write(cntrStr,18+1,'=SUM(R[-'||(cntrStr-countStrHead)||']C:R[-1]C)',BoldTrue,null,p_size_10,null,Allighment_LM);--Сумма выплаченной комиссии
				excel.write(cntrStr,20+1,'=SUM(R[-'||(cntrStr-countStrHead)||']C:R[-1]C)',BoldTrue,null,p_size_10,null,Allighment_LM);--фактически сформированный резерв
				/**/
				
				--Задание числового формата
				excel.Set_number_Format(countStrHead+1,07  ,cntrStr,08,2, true); --Остатки в рублях и валюте
			  --excel.Set_number_Format(countStrHead+1,08+1,cntrStr,08,2, false); --% ставка
			  --excel.Set_number_Format(countStrHead+1,11+1,cntrStr,11,2, true); --Сумма расчетного резерва
			  --excel.Set_number_Format(countStrHead+1,13+1,cntrStr,13,2, true); --Сумма обеспечения
			  --excel.Set_number_Format(countStrHead+1,18+1,cntrStr,18,2, true); --Сумма выплаченной комиссии
			  --excel.Set_number_Format(countStrHead+1,20+1,cntrStr,20,2, true); --фактически сформированный резерв
				
				-- Рамки
				cntrStr:=cntrStr-1; --ИТОГО без рамки
				debug_pipe('<<Рамки>> '||countStrHead||','||1||','||cntrStr||','||countColumns,dp2);
				excel.BORDERS(countStrHead,1,cntrStr,countColumns,'RLBTVH');
				
				-- DateTimeEnd:=sysdate;         --Вариант 1 
				var tmp string(100);
				tmp := 'DateTimeEnd:=sysdate';   --Вариант 2 
				tmp := 'DateTimeEnd:=sysdate     --Вариант 3
				абракадабра';

				/** / DateTimeEnd:=sysdate; /**/ --Вариант 4
				/* DateTimeEnd:=sysdate; */      --Вариант 5
				/*			         --Вариант 6
				DateTimeEnd:=sysdate;
				*/
				/** /			         --Вариант 7
				DateTimeEnd:=sysdate;
				/**/

				DateTimeEnd:=sysdate;            --Вариант 8

				tmpStr:='Сформировано '||to_char(DateTimeEnd,fmtHMS)||' __________________________________/'||stdlib.UserId.[NAME]||'/';
				debug_pipe(tmpStr, dp2);
				
				cntrStr:=cntrStr+1;
				excel.write(cntrStr+1,1,tmpStr,Boldfalse,ItalicFalse,p_size_10);
				excel.Merge(cntrStr+1,1,cntrStr+1,countColumns);

				excel.set_orientation(iOrientation2);	--Ориентации страницы. Значения: 1 - Альбомная, 2 - Книжная
				excel.fit_in_page_width();				--Вписать данные в страницу по ширине
				
				/**/
				excel.Save_as(P_FILE_EXECL);			--NameFile_OutXlsx);

				excel.Visible;							--Перевод Excel в режим отображения данных
				excel.Release;							--Закрытие COM интерфейса Excel сервера
			end if;
			
			--if Length(V_DEST)>0 then
			--	debug_pipe('(Размер VB-скрипта:'||Length(V_DEST)||')',dp2);
			--end if;
			excel.Exec_Script(V_DEST);
		end if;
	end if;
end;
end;
end;
