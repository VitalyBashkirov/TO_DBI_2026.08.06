-- функция get_part_val работает по более надежным условиям и поэтому
-- подходит для автоматической переадресации
public function get_part_val( doc_rc ref [DOCUM_RC], p_manual boolean default false) return ref [CL_PART] is
begin
	return ::[DOCUM_RC].[LIB_VAL].get_part_val(doc_rc, p_manual);
end;

-- из служебных полей вытаскиваем информацию про ORIGINATOR и DESTINATION
-- из служебных полей вытаскиваем информацию про ORIGINATOR и DESTINATION (для совместимости с др операциями)
public function get_orig_dest( doc ref [DOCUM_RC]) return string(32000) is
	STR				string(32000);
	orig_str		string;
	dest_str		string;
begin
	str := doc.[DOC_TEXT]||doc.[DOPINFO];

	str :=
		nvl( orig_str, 'ORIGINATOR :' || TB$ || ' SENT:' || '" & chr(13) & chr(10) & "') ||
		nvl( dest_str, 'DESTINATION:' || TB$ || ' RCPT:' );

	return str;
end;

function Get_F33B(val ref [FT_MONEY], summa number) return varchar2
is
begin
	if val is not null and nvl(summa, 0) > 0 then
		return replace(val.[CUR_SHORT], 'RUR', 'RUB') || rtrim( to_char( summa, '9999999999999990D99','NLS_NUMERIC_CHARACTERS = '', ''' ), '0');
	else
		return null;
	end if;
end;

procedure set_71( val in ref [FT_MONEY],
				  charge in out ref [CHARGES],
				  mt103	 in out [MT103],
				  p_dog in ref [TRC],
				  P_SUMMA in out [SUMMA],
				  p_orig_summa in [SUMMA],
				  p_doc ref [DOCUM_RC],
				  P_GET_PAYER ref [AC_FIN]
				  )
is
	F_71F_stru	[STRING_REC];
	v_sum_comiss number;
	v_cur_comiss ref [FT_MONEY];

begin

	if charge is null then
		charge := ::[CHARGES]([CODE] = 'OUR' );
	end if;
	if &LV.is_COM_BEN(charge, doc_rc == p_doc) then
		if nvl(P_SUMMA, 0) <> 0 then
			v_sum_comiss := ::[DOCUM_RC].[LIB_VAL].get_doc_comiss(p_doc, P_SUMMA, p_dog, /*P_RC_PART,*/ true, v_cur_comiss, P_GET_PAYER);
			v_sum_comiss := round(::[DOCUMENT].[LIB_CUR].Cur2Cur(v_sum_comiss, v_cur_comiss, val), 2);--nvl(val.[DIGIT], 2));
			if v_sum_comiss is not null then
				V_33B_VAL := nvl(V_33B_VAL, val);
				if p_orig_summa = 0 then
					V_33B_SUM := P_SUMMA;
					V_71F.delete;
				else
					V_33B_SUM := nvl(V_33B_SUM, P_SUMMA);
				end if;
				P_SUMMA := P_SUMMA - v_sum_comiss; -- уменьшаем сумму на сумму комиссии
				F_71F_stru.[STRING] := val.[CUR_SHORT] || rtrim( to_char( v_sum_comiss, '9999999999999990D99','NLS_NUMERIC_CHARACTERS = '', ''' ), '0');
				V_71F(V_71F.count + 1) := F_71F_stru;
			end if;
			mt103.[F_71G] := null;
		else -- P_SUMMA = 0 -- для комиссии BEN все равно заполняем поля 33B и 71F
			P_SUMMA := 0; -- т.к. могли просто скинуть сумму, а не проставить 0
			mt103.[F_71G] := null;
			V_71F.delete;
			F_71F_stru.[STRING] := val.[CUR_SHORT] || '0,';
			V_71F(nvl(V_71F.last, 1)) := F_71F_stru;
			V_33B_VAL := val;
			V_33B_SUM := P_SUMMA;
		end if;
	else
		mt103.[F_71G] := null;
		V_71F.delete;
	end if;
end;

--(kozlova) возвращает текст документа p_rDocRc в формате SWIFT
public function get_dopinfo(
	p_rDocRc	ref [DOCUM_RC]
) return varchar2(4000) is
	v_sform				string(10);
	v_swift_receiver	varchar2;
	v_block3			string;
	v_idMT103			string;	
	v_ret				varchar2(4000);
	ed503_				boolean;
begin
	&sp(sp1)
	ed503_ := nvl(p_rDocRc.[DOG_RC].[AB].[ED503] and ::[TRC].[GET_FLAG]('UFEBS_COS_ED503'), false); -- признак ED503 на абоненте и для ED503, и для ED514
	::[DOCUM_RC].[SWIFT_LIB].INIT_EXP_FORMAT;
    v_sform := ::[DOCUM_RC].[LIB_VIEW].get_type_doc_sform(p_rDocRc);
    if v_sform in ('608', '940', '941', '950', '942') then
		v_ret := ::[DOCUM_RC].[SWIFT_LIB_EXP].get_950(p_rDocRc, ed503_);		
    	if v_ret is null then	-- для экспортированного телекса get_950 вернет null  - просто покажем текст из DOPINFO
  			v_ret := p_rDocRc.[DOPINFO];   	
    	end if;
    else
	    if v_sform = '202' then
			v_idMT103 := ::[RUNTIME].[STR].get_str_par(p_rDocRc.[BLOCK_DATA], 'MT103COV');
	    	if v_idMT103 is not null then
	    		v_block3 := '119:COV';
	    	end if;
	    elsif v_sform = '103+' then
	    	v_block3 := '119:STP';
	    	v_sform := '103';
	    end if;
	
	    if p_rDocRc.[DOG_RC].[CLIENT] = ::[TRC].[INI].SWIFT_PART or v_sform like '_9_'  then
		    begin
	    		select x(x.[MT103].[RECEIVER_BANK].[SWIFT_C]) in ::[DOCUM_RC] where x = p_rDocRc into v_swift_receiver;
	    	exception when NO_DATA_FOUND or TOO_MANY_ROWS then null;
	    	end;
	    end if;
		if p_rDocRc.[SETTYPE] = '7' then -- внешняя конверсия
			v_swift_receiver := nvl(trim(::[TRC].[LIB_NEW].attr_val(p_rDocRc.[DOG_RC], ::[ATTR]([CODE]='SWIFT_ALTERNATE'))), null);
		end if;
	
		if v_sform in ('300', '320') then	
	  		v_ret := ::[DOCUM_RC].[SWIFT_LIB].get_title(p_rDocRc.[DOG_RC], v_sform, v_swift_receiver, v_block3, doc_rc == p_rDocRc, ed503==ed503_)
	  			|| ::[DOCUM_RC].[SWIFT_EXP_3XX].EXP_DOC(p_rDocRc, v_sform);
		else
			v_ret := ::[DOCUM_RC].[SWIFT_LIB].get_title(p_rDocRc.[DOG_RC], v_sform, v_swift_receiver, v_block3, doc_rc == p_rDocRc, ed503==ed503_)
				|| ::[DOCUM_RC].[SWIFT_LIB_EXP].get_block_4(p_rDocRc, v_sform, ::[TRC].[INI].TODAY, false, null, false, v_idMT103);
		end if;
				
		if v_sform in ('200', '202') and [STR].get_bool_par(p_rDocRc.[BLOCK_DATA], 'MT210') then
			v_ret := v_ret||NL$||'MT210: '||NL$||
				::[DOCUM_RC].[SWIFT_LIB].get_title(null, '210', p_rDocRc.[RECEIVER].[BCODE], doc_rc == p_rDocRc, ed503==ed503_) || ::[DOCUM_RC].[SWIFT_LIB_EXP].get_block_4_for_mt210(p_rDocRc);
		end if;
    end if;

	::[DOCUM_RC].[T_LIB].RESET_ERRS;
	return v_ret;
exception when others then
	&rb(sp1)
end;


