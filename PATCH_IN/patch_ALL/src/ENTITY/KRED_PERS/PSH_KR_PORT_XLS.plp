							f133.PZ_SUM2 :PZ_SUM2,--6-30
							f133.PZ_SUM_31_90 :PZ_SUM_31_90,--31-90
							f133.PZ_SUM_91_180 :PZ_SUM_91_180,--90-180
							f133.PZ_SUM4 :PZ_SUM4,--180+
							--Проср.%%
							f133.PZ_PRC1 :PZ_PRC1,--0-5
							f133.PZ_PRC2 :PZ_PRC2,--6-30
							f133.PZ_PRC3 :PZ_PRC3,--31-90
							f133.PZ_PRC31 :PZ_PRC31,--91-180
							f133.PZ_PRC4 :PZ_PRC4)--180+
							in ::[F_133_DATA] all
							where
							f133.[PARAM].[REPORT].CODE='F_133'
							and f133.[PARAM].DATE1=&GD+1
							and f133.[PARAM].DATE2=&GD+1
							and f133.[PARAM].[BRANCH] is null)
							all
							where
							cr.DATE_GIVE <= &GD
							and ((ptf.ptf_id is null and (cr.DATE_CLOSE is null or cr.DATE_CLOSE>&GD)) or
							(ptf.ptf_id is not null and (cr.DATE_CLOSE is null or cr.DATE_CLOSE>&RD)))
							and (cr.HIGH_LEVEL_CR is null or cr.HIGH_LEVEL_CR%class!='OVERDRAFTS')
							and expc_r.ACC(true)=cr.[ACC_DEBTS_PRC]
							and tech.collection_id(true)=cr.[ARRAY_DOG_ACC]
							and com.collection_id(true)=cr.[ARRAY_DOG_ACC]
							and pen.collection_id(true)=cr.[ARRAY_DOG_ACC]
							and ptf.cred(true)=cr
							and f133.dea_id(true)=cr
							--and cr%id=50974381

					) loop
					[EXCEL].Write(i,1,cr.IDENT);
					[EXCEL].Write(i,2,cr.ERR);
					[EXCEL].Write(i,3,cr.DEP_CODE);
					[EXCEL].Write(i,4,cr.DEPBAL);
					[EXCEL].Write(i,5,cr.CLI_CODE);
					[EXCEL].Write(i,6,cr.CLI_NAME);
