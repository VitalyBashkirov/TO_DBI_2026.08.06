class REPS_DATA;

@import_plsql(true)
@generate_ansi_joins(true)
@name('[ПСБ] Регистрация вызываемых приложений')
@tag('COPIED')
library PSH_LIB_REG_DOP is
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
dp integer:=0;	--управление &debug
dp10 integer:=0;	--управление &debug
fmt	   string(10):='dd/mm/yyyy';
/*
** Операция вызывается при проверке приложения 1 раз для всех шагов (в отчётности во всех приложениях 1 шаг)
*/
pragma macro(rd,	'::[REPS_DATA].[LIB_DEFINE]');
pragma include(::[REPS_DATA].[LIB_VIEW]);
-- добавление операции в конфигурацию профилей
procedure SetReg
		(
			P_REP			varchar2(32767)
		,	P_METH_NAME		::[METHOD].[SHORT_NAME]%type
		)
is
	vErr	varchar2(4000);

begin
	if		P_REP is null
		or	P_METH_NAME is null
	then
		return;
	end if;

	for	(
			select	x
				(	x			:	id
				,	x.[CODE]	:	C_CODE
				,	x.[NAME]	:	C_NAME
				)
			in		::[REPS_PROF_TUN]
			where	x.[REP].[CODE] = P_REP
				and	x.[DATE_END] is null
		)
	loop
		-- Если добавление операции в конфигурацию профиля прошло успешно
		if	&rd.SetDefineOper(x.ID, P_METH_NAME, vErr, false)	then
			&debug('В конфигурацию профиля "' || x.C_NAME || '" (' || x.C_CODE || ') добавлена библиотека [' || P_METH_NAME || ']',dp10)
		end if;
	end loop;
end;

-- Удаление операции из конфигурации профилей
procedure UnReg
		(	P_REP			varchar2(32767)
		,	P_METH_NAME		::[METHOD].[SHORT_NAME]%type
		)
is
begin
	if P_REP is null or P_METH_NAME is null then
		return;
	end if;

	for (
		select	x
			(	x			: id
			,	x.[CODE]	: C_CODE
			,	x.[NAME]	: C_NAME
			)
		in		::[REPS_PROF_TUN]
		where	x.[REP].[CODE] = P_REP
			and	x.[DEFINE].[LIST_APP].[CODE] like P_METH_NAME||'%'
		)
	loop
		::[REPS_DATA].[LIB_DEFINE].DelDefineOper(x.id,'#'||P_METH_NAME||'#');
		&debug('Из конфигурации профиля "'||x.C_NAME||'" ('||x.C_CODE||') исключена библиотека ['||P_METH_NAME||']',dp10)
	end loop;
end;

-- Добавляет настройку в справочник "ОП Настройки" (FP_TUNE)
procedure SetRegTune(P_TUN		[FP_TUNE])
is
	rTunVal		ref [FP_TUNE_VAL];
begin
	P_TUN%id	:=	::[FP_TUNE].[LIB].get_tune(P_TUN.[CODE], '0')%id;
	if P_TUN%id is null then
		P_TUN%id	:=	::[FP_TUNE].[LIB].create_or_update_tune
			(	code			==	P_TUN.[CODE]
			,	name			==	P_TUN.[NAME]
			,	group_id		==	P_TUN.[GROUP_ID]			-- Идентификатор группы
			,	val_type		==	P_TUN.[VAL_TYPE]			-- Тип значения
			,	note			==	P_TUN.[NOTE]
			,	use_canons		==	true							-- Использовать критерии поиска
			,	throw_error		==	'0'							-- Генерировать исключение
			,	cached			==	true							-- Кэшировать получение значений
			)%id;
		&debug('В справочник "Настройки." добавлена настройка с кодом "'||P_TUN.[CODE]||'"',dp10)
	end if;

	rTunVal	:=	::[FP_TUNE].[LIB].set_value(P_TUN.[CODE], '1');
	&debug('Использование ['||P_TUN.[CODE]||'] в приложениях включено.',dp10)
end;

-- Отключает настройку в справочнике "ОП Настройки" (FP_TUNE)
procedure UnRegTune	(P_TUN		[FP_TUNE])
is
	refVal	ref [FP_TUNE_VAL];
begin
	refVal := ::[FP_TUNE].[LIB].set_value(P_TUN.[CODE], bool_char(false));
	&debug('Использование ['||P_TUN.[CODE]||'] в приложениях отменено.',dp10)
end;

-- Проверка приложения на регистрацию в справочнике "Список приложений. Настройка"
public function CheckRegPril(P_PRIL varchar2(32767))
	return boolean
is
	bRet	boolean	default	false;
	retId	number;
begin
	for	(
			select	x(1, x%id : C_ID)
			in		::[SYS_LIST_APP]
			where	x.[CODE]	=	P_PRIL
				and	exists	(	select	z(1)
								in		x.[STEP_TUNE]
								where	z.[EXEC_STEP]
							)
				and	not exists
							(	select	z(1)
								in	x.[STEP_TUNE]
								where	&bool_not(z.[EXEC_STEP])
							)
			fetch 1
		)

	loop
		bRet	:=	true;
		retId	:= x.C_ID;
		exit;
	end loop;
	bRet:=nvl(bRet, false);
	&debug('.CheckRegPril -- Проверка по "Список приложений. Настройка" < '||bRet||' P_PRIL='||P_PRIL||' retId= '||retId,dp10)
	return bRet;
end;

-- Проверка операции-приложения расширения на регистрацию в SYS_LIST_APP
public function IsMethReg
		(	p_meth			varchar2(32767)
		,	p_rep			varchar2(32767)
		,	p_pril		out varchar2(32767)
		)
	return boolean
is
	v_rep		varchar2(32767);
	v_pril		varchar2(32767);
	v_ret		boolean;
begin
	v_rep	:=	p_rep;
	if v_rep like 'M_%' then
		v_rep	:=	'M_';
	end if;
	&debug('.IsMethReg -- v_rep='||v_rep||' p_meth='||p_meth||' p_rep='||p_rep||' p_pril='||p_pril,dp)

	for (
			select	a(	a.[CODE]	:C_CODE)
			in		::[REPS_APPL]
			where	&is_not_empty(a.[CODE])
				and	a.[REP]		= v_rep
				and	a.[OPER]	= p_meth
		)
	loop
		v_pril	:=	a.C_CODE;
	end loop;

	&debug('.IsMethReg -- Метод ['||p_meth||'] отчет ['||p_rep||']: код приложения ['||v_pril||']',dp10)

	if v_pril is null then
		return false;
	end if;
	p_pril	:=	v_pril;
	v_ret	:=	CheckRegPril(v_pril);

	&debug('.IsMethReg -- < '||v_ret||' p_pril='||p_pril,dp10)
	return v_ret;
end;

-- функция проверки на использование приложений при отмене регистрации.
function CheckPril	(pCodePril	varchar2(32767))
	return varchar2(1000)
is
	iCount			integer;
	vPril			varchar2(32767);
	vMessage		varchar2(4000);
	vProfList		varchar2(32767) default null;
begin
	case pCodePril of
	:'1B620530':
		-- если отмена регистрации, то проверить наличие записей
		select	y(count(1))
		in	(	select	y(y)
				in		::[RATING_EMITENTS]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник RATING_EMITENTS';
		end if;

	:'1B620550':
		-- если отмена регистрации, то проверить наличие записей
		select	y(count(1))
		in	(	select	y(y)
				in		::[FACTORING_DATA]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник FACTORING_DATA';
		end if;

	--- :'1B620365':	-- 701. расчёт по процентно-валютным свопам
	--- 	-- если отмена регистрации, то проверить наличие записей
	--- 	select	y(count(1))
	--- 	in	(	select	y(y)
	--- 			in		::[F_701_DATA]
	--- 			where	y.[DATA_SOURCE] = 'CCS_SWAP'
	--- 			fetch 1
	--- 		)
	--- 	into	iCount;
    --- 
	--- 	if iCount > 0 then
	--- 		return 'Перед отключением приложения необходимо в F_701_DATA удалить данные по процентно-валютным свопам ';
	--- 	end if;

	:'1B620196':
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(
				select	x(x)
				in		::[F_257_DATA]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник F_257_DATA';
		end if;
	:'1B620274':
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(
				select	x(x)
				in		::[F_410_DATA]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник F_410_DATA';
		end if;
	:'1B620124':
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(
				select	x(x)
				in		::[NORM_LIQ_AGR]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить все данные из справочника NORM_LIQ_AGR';
		end if;


	-- для любого приложения которое относятся к F_401_APP

	:'1B620253':
		select	u(count(1))
		in	(
				select	u(u)
				in		::[REPS_PART_INVEST]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо ' || NL$ || 'очистить справочник "ОП Справочник долей участия нерезидента".';
		end if;

	:'1B620243':
		select	y(count(1))
		in	(	select	y(y)
				in		::[F_401_DATA_REP]
				where	coalesce(instr(y.[DATA], 'DM_SDELKA'),0) = 0
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо в справочнике F_401_DATA_REP удалить информацию по договорам';
		end if;

	:'1B620244':
		select	y(count(1))
		in	(	select	y(y)
				in		::[F_401_DATA_REP]
				where	instr(y.[DATA], 'OPTION') > 0
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо в справочнике F_401_DATA_REP удалить информацию по опционам';
		end if;

	:'1B620242':
		select	y(count(1))
		in	(	select	y(y)
				in		::[F_401_DATA_REP]
				where	instr(y.[DATA], 'FORWARD') > 0
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо в справочнике F_401_DATA_REP удалить информацию по форвардам';
		end if;

	:'1B620241':
		select	y(count(1))
		in	(	select	y(y)
				in		::[F_401_DATA_REP]
				where	instr(y.[DATA], 'FUTURES') > 0
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо в справочнике F_401_DATA_REP удалить информацию по фьючерсам';
		end if;

	:'1B620249':
		select	y(count(1))
		in	(	select	y(y)
				in		::[F_401_DATA_REP]
				where	instr(y.[DATA], 'SWAP') > 0
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо в справочнике F_401_DATA_REP удалить информацию по свопам';
		end if;

	:'1B620123':
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(	select	x(x)
				in		::[LOMBARD_CBRF]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник LOMBARD_CBRF';
		end if;

	:'1B620405':
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(	select	x(x)
				in		::[F_808_DATA_SPR]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник F_808_DATA_SPR.';
		end if;

	:'1B620406':	-- Проверка наличия данных по приложению "Обработка продукта Гарантии при расчете раздела "Справочно" формы 0409808"
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(	select	x(x)
				in		::[F_808_DATA_SPR]
				where	x.[DATA] like '%GUAR_REF%'
				fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо в справочнике F_808_DATA_SPR удалить записи по продукту "Гарантии".';
		end if;

	:'1B620073':
		-- при отмене регистрации нужно проверить, что нет данных по соответствующим продуктам
		select	x(count(1))
		in	(	select	x(x)
				in		::[F_123_DATA]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник F_123_DATA.';
		end if;

	:'1B620186':
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(	select	x(x)
				in		::[F_258_DATA]
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник F_258_DATA';
		end if;

	--- :'1B620188':
	--- 	-- если отмена регистрации, то проверить наличие записей
	--- 	select	x(sum(x.C_CNT))
	--- 	in	(	select	x(count(1)		: C_CNT)
	--- 			in	(	select	x(x)
	--- 					in		::[F_260_DATA]
	--- 					fetch 1
	--- 				)
	--- 		union all
	--- 			select	x(count(1)		: C_CNT)
	--- 			in	(	select	x(x)
	--- 					in		::[F_260_DATA_4927]
	--- 					fetch 1
	--- 				)
	--- 		)
	--- 	into	iCount;
    --- 
	--- 	if iCount > 0 then
	--- 		return 'Перед отключением приложения необходимо очистить справочники "' || ::[F_260_DATA]%classname || '" и "' || ::[F_260_DATA_4927]%classname || '"';
	--- 	end if;

	:'1B620305': --Разработочная таблица по обеспечению
		select	x(count(1))
		in	(
				select	x(x%id)
				in		::[ZALOG_DATA]
				where	x.[REPORT].[CODE] = 'F_634'
				fetch 1
			)
		into	iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить данные по форме 0409634 из справочника ZALOG_DATA';
		end if;

	:'1B618040': --Расчет обязательных нормативов. Портфель эмиссионных ценных бумаг
		vMessage := null;
		-- Если не зарегистрировано другое приложение, использующее эту РТ - проверяем наличие данных
		if not CheckRegPril('1B620941') then
			for (
					select	y(1)
					in		::[NORM_CB_DATA]
					fetch 1
				)
			loop
				vMessage	:=	'NORM_CB_DATA';
				exit;
			end loop;
		end if;

		for(
				select	y(1)
				in		::[NORM_TEHN_DATA]
				where	y.[DOG_CLASS] = 'PAPER'
				fetch 1
			)
		loop
			vMessage	:=	vMessage || ', NORM_TEHN_DATA';
			vMessage	:=	ltrim(vMessage, ', ');
			exit;
		end loop;

		if vMessage is not null then
			return 'Перед отключением приложения необходимо удалить информацию по ЦБ из '||vMessage;
		end if;

	:'1B618050': --Расчет обязательных нормативов. Портфель векселей
		select	x(count(1))
		in	(
				select	y(y%id)
				in		::[NORM_VEX_DATA]
				fetch 1
			)
		into	iCount;

		if iCount = 0 then
			select	x(count(1))
			in	(
					select	y(y%id)
					in		::[NORM_TEHN_DATA]
					where	y.[DOG_CLASS] = 'VEKSEL_GUIDE'
					fetch 1
				)
			into	iCount;
		end if;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить информацию из NORM_VEX_DATA и NORM_TEHN_DATA по векселям';
		end if;

	:'1B618020': --Расчет обязательных нормативов. Межбанковские кредиты и депозиты, корреспондентские счета
		select	x(count(1))
		in	(
				select	y(y%id)
				in		::[NORM_MBK_DATA]
				fetch 1
			)
		into	iCount;

		if iCount = 0 then
			select	y(count(1))
			in	(
					select	y(y%id)
					in		::[NORM_TEHN_DATA]
					where	y.[DOG_CLASS] in ('BANKS_LOANS','TRC')
					fetch 1
				)
			into	iCount;
		end if;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить информацию из NORM_MBK_DATA и NORM_TEHN_DATA по МБК и МБД';
		end if;

	:'1B618060': --Расчет обязательных нормативов. Договоры аренды сейфовых ячеек
		select	y(count(1))
		in	(	select	y(y%id)
				in		::[NORM_DEPN_DATA]
				where	y.[CLASS_DOG] = 'IND_SAFE_LEASE'
				fetch 1
			)
		into	iCount;

		if iCount = 0 then
			select	y(count(1))
			in	(	select	y(y%id)
					in		::[NORM_TEHN_DATA]
					where	y.[DOG_CLASS] ='IND_SAFE_LEASE'
					fetch 1
				)
			into	iCount;
		end if;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить информацию из NORM_DEPN_DATA и NORM_TEHN_DATA по сейф. ячейкам';
		end if;

	:'1B618030': --Расчет обязательных нормативов. Депозиты физических и юридических лиц
		select	y(count(1))
		in	(	select	y(y%id)
				in		::[NORM_DEPN_DATA]
				where	y.[CLASS_DOG] in ('DEPOSIT_ORG','DEPOSIT_PRIV')
				fetch 1
			)
		into	iCount;

		if iCount = 0 then
			select	y(count(1))
			in	(	select	y(y%id)
					in		::[NORM_TEHN_DATA]
					where	y.[DOG_CLASS] in ('DEPOSIT_ORG','DEPOSIT_PRIV')
					fetch 1
				)
			into iCount;
		end if;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить информацию из NORM_DEPN_DATA и NORM_TEHN_DATA по депозитам';
		end if;

	:'1B618010': --Расчет обязательных нормативов. Кредиты физических и юридических лиц
		select	y(count(1))
		in	(	select	y(y%id)
				in		::[NORM_CRED_DATA]
				where	y.[CLASS_DOG] not in ('R2_LOAN')
				fetch 1
			)
		into iCount;

		if iCount = 0 then
			select	y(count(1))
			in	(	select	y(y%id)
					in		::[NORM_TEHN_DATA]
					where	y.[DOG_CLASS] = 'PR_CRED'
					fetch 1
				)
			into iCount;
		end if;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить информацию из NORM_CRED_DATA и NORM_TEHN_DATA по кредитам';
		end if;

	:'1B618065': --Расчет обязательных нормативов. Договоры факторингового обсуживания
		select	y(count(1))
		in	(	select	y(y%id)
				in		::[NORM_FACTOR_DATA]
				fetch 1
			)
		into iCount;

		if iCount = 0 then
			select	y(count(1))
			in	(	select	y(y%id)
					in		::[NORM_TEHN_DATA]
					where	y.[DOG_CLASS] = 'FACTORING'
					fetch 1
				)
			into iCount;
		end if;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить инф-ю из NORM_FACTOR_DATA и NORM_TEHN_DATA по догов. факторинга';
		end if;

	:'1R995050': --Расчет обязательных нормативов. Договоры системы "Розница", кредиты и дерозиты
		select	y(count(1))
		in	(	select	y(y%id)
				in		::[NORM_CRED_DATA]
				where	y.[CLASS_DOG] = 'R2_LOAN'
				fetch 1
			)
		into iCount;

		if iCount = 0 then
			select	y(count(1))
			in	(	select	y(y%id)
					in		::[NORM_TEHN_DATA]
					where	y.[DOG_CLASS] = 'R2_LOAN'
					fetch 1
				)
			into iCount;
		end if;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить информацию из NORM_CRED_DATA и NORM_DATA по кредитным договорам продукта "Розница"';
		end if;

		iCount	:=	0;
		select	y(count(1))
		in		(	select y(y%id)
					in		::[NORM_DEPN_DATA]
					where	y.[CLASS_DOG] = 'R2_DEPOSIT'
					fetch 1
				)
		into iCount;

		if iCount = 0 then
			select	y(count(1))
			in	(	select	y(y%id)
					in		::[NORM_TEHN_DATA]
					where	y.[DOG_CLASS] = 'R2_DEPOSIT'
					fetch 1
				)
			into iCount;
		end if;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить информацию из NORM_DEPN_DATA и NORM_DATA по депозитным договорам продукта "Розница"';
		end if;

	:'1B618045':--Расчет обязательных нормативов. Обработка сделок РЕПО
		vMessage := null;
		-- Если не зарегистрировано другое приложение, использующее эту РТ - проверяем наличие данных
		if not CheckRegPril('1B620941') then
			for (
					select	y(1)
					in		::[NORM_REPO_DATA]
					fetch 1
				)
			loop
				vMessage := 'NORM_REPO_DATA';
				exit;
			end loop;
		end if;

		for (
				select	y(1)
				in		::[NORM_TEHN_DATA]
				where	y.[DOG_CLASS] in ('REPO_CB','REPO_CASH')
				fetch 1
			)
		loop
			vMessage := vMessage || ', NORM_TEHN_DATA';
			vMessage := ltrim(vMessage, ', ');
			exit;
		end loop;

		if vMessage is not null then
			return 'Перед отключением приложения необходимо удалить информацию по сделкам РЕПО из '||vMessage;
		end if;

	:'1B620196':
		-- если отмена регистрации, то проверить наличие записей
		select	y(count(1))
		in	(	select	x(x)
				in		::[F_257_DATA]
				fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник F_257_DATA';
		end if;

	:'1B620263':	-- 406.работа с платежными документами
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(x))
		in		::[F_406_DOC_DATA]
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник F_406_DOC_DATA';
		end if;
	
	--Башкиров В.Г. 18.03.2024 патч 24.1.02
	/** /
	:'1B615030':	-- проверки данных по продукту "Депозиты"
		-- если отмена регистрации, то проверить наличие записей с кодом начинающимся на DEPN%
		select	p(count(1)		:cnt)
		in	(	select	p(p)
				in		::[DATA_CHECK_JOUR] all
				where	p.[APP] like 'DEPN%'
				fetch 1
			)
		into iCount;
		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить протоколы выполненных проверок по депозитам в справочнике DATA_CHECK_JOUR';
		end if;
	
	:'1B615020':	-- проверки данных по продукту "Кредиты"
		-- если отмена регистрации, то проверить наличие записей с кодом начинающимся на CRED%
		select	p(count(1)		:cnt)
		in	(	select	p(p)
				in		::[DATA_CHECK_JOUR] all
				where	p.[APP] like 'CRED%'
				fetch 1
			)
		into iCount;
		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить протоколы выполненных проверок по кредитам в справочнике DATA_CHECK_JOUR';
		end if;
	/**/

	:'1B615010':	-- проверки качества данных
		-- проверка возможности отмены регистрации дочернего приложения по продукту "Кредиты"
		if IsMethReg('CRED','DATA_CHECK', vPril) then
			return 'Перед отключением приложения необходимо отключить приложение "Контроль качества данных по кредитным договорам" ('||vPril||')';
		end if;

		-- проверка возможности отмены регистрации дочернего приложения по продукту "Депозиты"
		if IsMethReg('DEPN','DATA_CHECK', vPril) then
			return 'Перед отключением приложения необходимо отключить приложение "Контроль качества данных по депозитным договорам" ('||vPril||')';
		end if;

		-- если отмена регистрации, то проверить наличие записей в справочнике DATA_CHECK_JOUR
		select	p(count(1) :cnt)
		in	(	select	x(x)
				in		::[DATA_CHECK_JOUR] all
				fetch 1
			)
			into iCount;
		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить протоколы выполненных проверок в справочнике DATA_CHECK_JOUR';
		end if;

	:'1B620247':	-- расчет данных по брокерским сделкам с фьючерсными контрактами с учетом конвейерной обработки
		-- если отмена регистрации, то проверить наличие записей
		select	y(count(1))
		in	(	select	y(y%id)
				in		::[F_401_DATA_REP]
				where	instr(y.[DATA], 'DM_DEAL') > 0
				fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо в справочнике F_401_DATA_REP удалить информацию по справочнику "СР Брокерские биржевые сделки с ПФИ"(DM_DEAL)';
		end if;

	:'1B620261':	-- расчет данных по брокерским биржевым сделкам купли/продажи ценных бумаг с учетом конвейерной обработки
		-- если отмена регистрации, то проверить наличие записей
		select	y(count(1))
		in	(	select	y(y)
				in		::[F_405_DATA]
				where instr(y.[DATA], 'FP_DEAL') > 0
				fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо в справочнике F_405_DATA удалить информацию сформированную по справочнику по "ФПЭ Брокерские биржевые сделки"(FP_DEAL)';
		end if;
	:'1B620650':	-- проверки данных по продукту "разработочные таблицы по ВХО"
		-- если отмена регистрации, то проверить наличие записей
		select	x(sum(x.C_CNT))
		in	(
				select	x(count(1)	: C_CNT)
				in	(	select	x(x)
						in		::[VHO_DATA]
						fetch 1
					)
			union all
				select	x(count(1)	: C_CNT)
				in	(	select	x(x)
						in		::[TMC_DATA]
						fetch 1
					)
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочники VHO_DATA и TMC_DATA';
		end if;
	:'1B618100':	-- проверка данных по продукту 'Расчет данных по клиентам о наличии установленных взаимоотношений с банком'
		-- если отмена регистрации, то проверить наличие записей
