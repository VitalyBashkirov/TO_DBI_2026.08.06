class FREEZE_LIST;

@name('[ПСБ] Проверить клиентов по записям')
@tag('COPIED')
static method PSH_CHECK_CLIENT is
PSH_CHECK_CLIENT (
	@name('Проверять нац. банки и участников SWIFT')         P_CHECK_BANK  in [BOOLEAN] default null,
	@name('Только действующие нац. банки и участники SWIFT') P_BANK_ACTIVE in [BOOLEAN] default null
) is

validate is
begin
	if p_message = 'DEFAULT' then
		--::[FREEZE_LIST].[LIB_C].check_app_hard;
		null;
	end if;
end;

execute is

PRAGMA INCLUDE (::[CL_CHECK_RESULT].[LIB]);

mark_fr_clear	ref [P207_TERROR_FLAG] 	:= ::[FREEZE_LIST].[LIB].FREEZE_CLEAR;
mark_fr_need	ref [P207_TERROR_FLAG] 	:= ::[FREEZE_LIST].[LIB].FREEZE_NEED;
fr_Check		ref [CLIENT_CHECKS] 	:= ::[FREEZE_LIST].[LIB].FREEZE_CHECKS;

type ClTblType is table of ref [CLIENT];

clTbl			ClTblType;
frTbl			::[FREEZE_LIST].[LIB_C].TableFrRef;

choice			[CASE_BETWEEN_TWO];
idx				number;
v_info 			debug_rec;
begin
	P_CHECK_BANK := nvl(P_CHECK_BANK, false);
	P_BANK_ACTIVE := nvl(P_BANK_ACTIVE, false);
	frTbl.delete;
	
	-- заполнение таблицы ссылок на подозрительные лица для передачи в операцию IS_CL_FREEZE
	/** /
	idx := THIS.first;
	while idx is not null
	loop
		frTbl(frTbl.count+1) := THIS(idx);
		idx  	:= THIS.next(idx);
	end loop;
	/**/
	for fl in ::[FREEZE_LIST] where fl.[VALIDTODATE] is null loop
		frTbl(frTbl.count+1) := fl%id;
	end loop;
	debug_pipe('Подозрительных лиц для проверки: '||frTbl.count, 0);
	
	select c(c.id : id)
		in (
			select cl(cl : id)
				in ::[CLIENT]
			 where cl%class in ('CL_PRIV', 'CL_ORG')
				or P_CHECK_BANK and cl%class in ('CL_BANK_N') and (not P_BANK_ACTIVE or P_BANK_ACTIVE and cl->(true, ::[CL_BANK_N])[ACTIVE])
				or P_CHECK_BANK and cl%class in ('CL_BANK_F') and (not P_BANK_ACTIVE or P_BANK_ACTIVE and cl->(true, ::[CL_BANK_F])[DATE_CL] is null)
		)
	where nvl(&GET_SUSPECT_CUR(c.id, fr_Check), mark_fr_need) in (mark_fr_clear, mark_fr_need)
	into ClTbl;
	
	debug_pipe('Клиентов для проверки: '||ClTbl.count, 0);
	choice.[0] := 1;
	
	get_debug_all(v_info);
  --::[CLIENT].[IS_CL_FREEZE].V_SES_ID := v_info.debug_pipe_name; --Башкиров В.Г. 18.03.2024 патч 24.1.02
	
	ClTbl.[IS_CL_FREEZE](	P_CHOICE == choice
						  , P_FILIAL == null
						  , P_LIST_DATE == null
						  , P_NEED_CHECK == false
						  , P_TERR_TAB == frTbl
						  , P_OLD_CHECK == false
						  , P_MA_CHECK == false
						  , P_STREAM_COUNT == 1
						  , P_STREAM_NUM == 1
						  , P_WAIT == null
						  , P_DIS_INT == null
						  , P_USE_SINGLE_NODE == null
						  , P_USE_PIPE_ON_ALL_NODES == null
						  , P_CHECK_BANK == P_CHECK_BANK
						  , P_BANK_ACTIVE == P_BANK_ACTIVE
						  );
	debug_pipe('Проверка завершена ', 0);
	
end;
end;
end;
