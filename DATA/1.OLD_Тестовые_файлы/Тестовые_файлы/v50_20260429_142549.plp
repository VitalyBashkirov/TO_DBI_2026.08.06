--[19] v50.п.3.3
-- dynamic sql,execute,escape
-- Экранирование имён таблиц в `execute immediate`

begin --<добавлено при генерации теста>
  В `execute immediate` имена таблиц экранировать двойными кавычками: `"Z#MY_TABLE"`. Не использовать Oracle-специфичный синтаксис.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[20] v50.п.3.5
-- exception,rollback,raise
-- Добавление `ROLLBACK` или `RAISE` в `WHEN OTHERS`

begin --<добавлено при генерации теста>
  В PostgreSQL после ошибки транзакция прерывается. В `WHEN OTHERS` обязательно делать `ROLLBACK` (до savepoint) или `RAISE`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

