class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Отправить ностро-документ с транзитного счета')
@tag('COPIED')
method PSH_DO_TO_NOSTRO is
pragma include ([DEBUG_TRIGGER]::[MACRO_LIB]);

public function get_trc_on_acc(acc ref [AC_FIN]) return ref [TRC] is
trc ref [TRC];
begin
	if acc.[TO_PRODUCT] = ::[ACC_PRODUCT]([CODE] = 'TRC') then
		begin
			locate trc in ::[TRC] where acc in (trc.[ACCOUNT], trc.[ACC_OVERD], trc.[ACC_OWN], trc.[ACC_OVER_OWN], trc.[ACC_CBP], trc.[ACC_TRANSIT])
										and trc.[STATUS] = [STATUS_MB](CODE='WORK');
		exception when NO_DATA_FOUND then
			null;
		end;
	end if;
	return trc;
end;
PSH_DO_TO_NOSTRO (
	@name('Дата проводки') P_DATE in [DATE]
) is

validate is
begin
	if p_message = 'DEFAULT' then
		P_DATE := [SYSTEM]::[OP_DATE];

		if this.[QUIT_DOC] is not null and this.[QUIT_DOC]%state = 'PROV' and trunc(this.[QUIT_DOC]->(MAIN_DOCUM)[DATE_PROV]) = ::[SYSTEM].[OP_DATE] then
			pragma error('За текущий опер.день уже квитующий документ № ' || this.[QUIT_DOC].[DOCUMENT_NUM] || ' от ' || to_char(this.[QUIT_DOC]->(MAIN_DOCUM)[DATE_DOC], 'DD.MM.YYYY'));
		elsif this.[QUIT_DOC] is not null and this.[QUIT_DOC]%state = 'PROV' then
			stdio.put_line_buf('ВНИМАНИЕ! У документа уже есть квитующий документ № ' || this.[QUIT_DOC].[DOCUMENT_NUM] || ' от ' || to_char(this.[QUIT_DOC]->(MAIN_DOCUM)[DATE_DOC], 'DD.MM.YYYY'));
		else
			for (select doc(doc.[DOCUMENT] obj) 
				in this.[IN_FOLDER]->[DOCS_IN_FOLD] 
			where doc.[DOCUMENT]%class = 'MAIN_DOCUM'
				and doc.[DOCUMENT]%state = 'PROV'
				and doc.[DOCUMENT]->([MAIN_DOCUM])[NUM_DT] like '30220%'
				and doc.[DOCUMENT]->([MAIN_DOCUM])[NUM_KT] like '301%'
				order by doc.[DOCUMENT]->(MAIN_DOCUM)[DATE_PROV] desc
				fetch 1
			)
			loop
				stdio.put_line_buf('ВНИМАНИЕ! У документа уже есть квитующий документ № ' || doc.obj.[DOCUMENT_NUM] || ' от ' || to_char(doc.obj->(MAIN_DOCUM)[DATE_DOC], 'DD.MM.YYYY'));
			end loop;
		end if;		
	end if;
end;

execute is
ref_dr		ref [DOCUM_RC];

dr				[DOCUM_RC];
md				[MAIN_DOCUM] := this;

trcProdByAccKt	ref [TRC];
quit_doc 		ref [MAIN_DOCUM];
p_oIso_fin		[ISO_FIN];
--------------
procedure processDocRc is
v_20	varchar2(1000);
begin
	quit_doc := ::[DOCUM_RC].[LIB_NEW].make_quit(ref_dr, ref_dr.[SUMMA], md.[ACC_KT], trcProdByAccKt.[ACCOUNT], P_DATE, true, NULL, NULL, true );
	--debug_pipe('quit_doc ='||quit_doc,10);

	if quit_doc is not NULL then
		this.[QUIT_DOC] := quit_doc;
		
		v_20 := ref_dr.[AUDIT].[UNICUM_CODE];	
		if instr(quit_doc.[NAZN], 'референс') > 0 and v_20 is not null then
			quit_doc.[NAZN] := replace(quit_doc.[NAZN], 'референс', 'референс ' || v_20 || ' /RPP/');
		end if;
		
		if md.[IN_FOLDER] is not null then
			::[FOLDER_PAY].[LIB].[ADD_DOC_TO_FOLD](md.[IN_FOLDER], quit_doc);
		else
			::[FOLDER_PAY].[LIB].[ADD_DOC_TO_FOLD](md%id, quit_doc);
		end if;
	end if;	
end;
-----------
procedure processISO is
v_20	varchar2(1000);
begin
	quit_doc := ::[DOCUM_RC].[LIB_NEW].make_quit( ref_dr, 
												  p_oIso_fin.[INTR_BK_STTL_AMT].[SUMMA], 
												  md.[ACC_KT], 
												  p_oIso_fin.[DOG_RC].[ACCOUNT], 
												  P_DATE, 
												  true, 
												  NULL, 
												  NULL, 
												  true, 
												  null, 
												  p_oIso_fin == p_oIso_fin);
	--debug_pipe('ISO quit_doc ='||quit_doc,10);

	if quit_doc is not NULL then
		this.[QUIT_DOC] := quit_doc;
		--ref_dr.[QUIT_DOC] := quit_doc;

		if md.[IN_FOLDER] is not null then
			::[FOLDER_PAY].[LIB].[ADD_DOC_TO_FOLD](md.[IN_FOLDER], quit_doc);
		else
			::[FOLDER_PAY].[LIB].[ADD_DOC_TO_FOLD](md%id, quit_doc);
		end if;
		
		--v_20 := p_oIso_fin.[PMT_ID].[INSTR_ID];
		--if instr(quit_doc.[NAZN], 'референс') > 0 and v_20 is not null then
			--quit_doc.[NAZN] := replace(quit_doc.[NAZN], 'референс', 'референс ' || v_20 || ' /RPP/');
		--end if;
	end if;	
end;
-----------
procedure processMainDocum is
	md_new_ref	ref [MAIN_DOCUM];
	nostroAcc	ref [AC_FIN];
begin
	nostroAcc := trcProdByAccKt.[ACCOUNT];
	if nostroAcc is null then
		pragma error('В договоре получателя id = ' || trcProdByAccKt || ' не настроен счет незавершенных расчетов!');
	end if;


	md_new_ref := ::[MAIN_DOCUM].[NEW#AUTO].new(
			P_DOCUMENT_NUM	==	md.[DOCUMENT_NUM]	-- string, Номер
			,P_DATE_DOC		==	P_DATE				-- date, 							-- Дата документа
			,P_VID_DOC		==	::[NAME_PAYDOC]([CODE]='БЕЗН_МЕМО_ОРД') 
													--^ref [NAME_PAYDOC],				-- Вид документа
			,P_ACC_DT		==	md.[ACC_KT]			-- ref [AC_FIN],					-- Счет Дт
			,P_SUM_DT		==	md.[SUM]			-- number,							-- Сумма Дт.
			,P_ACC_KT		==	nostroAcc			-- ref [AC_FIN],					-- Счет Кт
			,P_SUM_KT		==	md.[SUM_PO]			-- number default null,				-- Сумма Кт.
			,P_SUM_NT		==	null				-- number default null,				-- Сумма Нац.
			,P_DATE_VAL		==	P_DATE				-- date default null,				-- Дата валютирования
			,P_NUM2			==	null				-- number default null,				-- Резервный параметр
			,P_MULTICURR	==	null				-- ref [TRANSVAL_DOC] default null,	-- Свойство валютности
			,P_NAZN			==	regexp_replace(md.[NAZN], '^\s*\{VO\d{5}\}', NULL, 1, 1, 'i')
													--^[MEMO] default null,			 	-- Назначение платежа
			,P_KOD_NAZN		==	null				-- ref [KOD_N_PAY] default null, 	-- Код назначения
			,P_PRODUCT_DT	==	null				-- ref [PRODUCT] default null,		-- Продукт Дт
			,P_PRODUCT_KT	==	null				-- ref [PRODUCT] default null,		-- Продукт Кт
			,P_RECALC_NT	==	null				-- boolean default false,			-- Пересчитывать нац. покрытие
			,P_FILIAL		==	null				-- ref [BRANCH] default null,		-- Филиал документа
			,P_DEPART		==	null				-- ref [DEPART] default null,		-- Подразделение документа
			,P_NAZN_CODE	==	null				-- varchar2(35) default null		-- Назначение платежа кодовое
);

	-->> Без валютного контроля Грачева Е.(с)
	-- md_new_ref.[NAZN] :=regexp_replace(md.[NAZN], '^\s*\{VO\d{5}\}', NULL, 1, 1, 'i');
	--<< Без валютного контроля Грачева Е.(с)

	this.[QUIT_DOC] := md_new_ref;
	-- На проводку
	-- md_new_ref.[DOC_TO_PROV];							
end;
-----------

begin
	if P_DATE > ::[TRC].[INI].TODAY then
		pragma error('Нельзя возобновить обработку документов датой  позже текущего опердня');
	end if;
	
	if this.[QUIT_DOC] is not null and this.[QUIT_DOC]%state = 'PROV' and trunc(this.[QUIT_DOC]->(MAIN_DOCUM)[DATE_PROV]) = P_DATE then
		pragma error('За дату '|| to_char(P_DATE, 'DD.MM.YYYY') || ' уже есть квитующий документ № ' || this.[QUIT_DOC].[DOCUMENT_NUM] || ' от ' || to_char(this.[QUIT_DOC]->(MAIN_DOCUM)[DATE_DOC], 'DD.MM.YYYY'));		
	else
		for (select doc(doc.[DOCUMENT] obj) 
			in this.[IN_FOLDER]->[DOCS_IN_FOLD] 
		where doc.[DOCUMENT]%class = 'MAIN_DOCUM'
			and doc.[DOCUMENT]%state = 'PROV'
			and doc.[DOCUMENT]->([MAIN_DOCUM])[NUM_DT] like '30220%'
			and doc.[DOCUMENT]->([MAIN_DOCUM])[NUM_KT] like '301%'
			order by doc.[DOCUMENT]->(MAIN_DOCUM)[DATE_PROV] desc
			fetch 1
		)
		loop
			if trunc(doc.obj->(MAIN_DOCUM)[DATE_PROV]) = P_DATE then
				pragma error('ВНИМАНИЕ! У документа уже есть квитующий документ № ' || doc.obj.[DOCUMENT_NUM] || ' от ' || to_char(doc.obj->(MAIN_DOCUM)[DATE_DOC], 'DD.MM.YYYY'));
			end if;
		end loop;
	end if;

	begin
		locate exact ref_dr in ::[DOCUM_RC] where ref_dr.[MAIN_DOC] = this;
		dr := ref_dr;
		trcProdByAccKt := dr.[DOG_RC];		
	exception when others then
		pragma error('Не найден документ расчетного центра!');
	--	trcProdByAccKt := get_trc_on_acc(md.[ACC_KT]);
	end;

	if trcProdByAccKt.[TYPE_DOG] <> ::[CONTRACT_TYPE]([IDENT] = 'N') then
		pragma error('Договор получателя не является договором НОСТРО!');
	end if;

	if trcProdByAccKt.[ACC_TRANSIT] <> md.[ACC_KT] then
		pragma error('Счет проводки по Кт - не является транзитным счетом договора РЦ!');
	end if;
	
	for (select iso(iso obj)
		in ::[ISO_FIN]
		where this = coalesce(iso.[MDOC], iso.[DOCUM_RC].[MAIN_DOC])
			fetch 1
		)
	loop
		p_oIso_fin := iso.obj; 
	end loop;

	if this.[QUIT_DOC] is not null or ref_dr.[QUIT_DOC] is not null then
		this.[QUIT_DOC] = ref_dr.[QUIT_DOC] := null;
	end if; 
	
	if p_oIso_fin%id is not null then
		processISO();
	elsif ref_dr is not null then
		processDocRc();
	else
		processMainDocum();
	end if;
end;
end;
end;
