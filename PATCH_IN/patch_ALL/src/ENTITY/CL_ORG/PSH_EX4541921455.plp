class CL_ORG;

@generate_ansi_joins(true)
@name('[ПСБ] Добавить/обновить "Адрес SWIFT строкой" у клиентов (списком)')
@tag('EXP_SWIFT')
batch method PSH_EX4541921455 is
PSH_EX4541921455 (
	@name('Адрес SWIFT. Импортировано/Адрес строкой')   P_V2  in [CASE_BETWEEN_TWO],
	@name('Предварительно удалять Адрес SWIFT клиента') P_DEL in [BOOLEAN]
) is

validate is
begin
	if p_message = 'DEFAULT' then
		P_V2.[0] := 1;
		P_DEL := true;
	end if;
end;

execute is
cnst_rTypeAddSwift	constant ref [ADDRESS_TYPE] := ::[ADDRESS_TYPE]([KOD]='SWIFT_ADDRESS');
cnst_rTypeAdd1		constant ref [ADDRESS_TYPE] := ::[ADDRESS_TYPE]([KOD]='CORP');
cnst_rTypeAdd2		constant ref [ADDRESS_TYPE] := ::[ADDRESS_TYPE]([KOD]='FACT');
cnst_rTypeAddTmp	ref [ADDRESS_TYPE];

rAdr_tmp		reference;
rAdr_swift		ref [PERSONAL_ADDRESS];	-- Адрес SWIFT_ADDRESS
rAdr1			ref [PERSONAL_ADDRESS];	-- Адрес CORP
rAdr2			ref [PERSONAL_ADDRESS];	-- Адрес FACT

nDp number:=0;
nDp2 number:=null;

nAl			number;
nAlDelClOrg	number;
nAlAddClOrg	number;
nAlEditClOrg	number;

vAdr_list varchar2(2000);
cColl_addresses collection;
nCntAddress number;
begin
	P_V2.[0] := nvl(P_V2.[0],1);
	P_DEL := nvl(P_DEL,true);

	nAl			:=0;
	nAlDelClOrg	:=0;
	nAlAddClOrg	:=0;
	nAlEditClOrg	:=0;

	-- работаем со списком
	for i in this.first..this.last loop
		nAl:=nAl+1;
		cColl_addresses := this(i).[ADDRESSES]%collection;
		
		select adr(analytic(listagg(adr%id,'^'), 'WITHIN GROUP (order by [1])',1))
			in ::[PERSONAL_ADDRESS] all
			where adr%collection=cColl_addresses
			and adr.[TYPE] in (cnst_rTypeAddSwift,cnst_rTypeAdd1,cnst_rTypeAdd2)
			into vAdr_list;
		nCntAddress:=nvl(length(vAdr_list)-length(replace(vAdr_list,'^')),0)+1;
		debug_pipe(this(i)%class||'.'||this(i)%id||' ('||nCntAddress||')vAdr_list='||vAdr_list,nDp2);
		
		rAdr_swift = rAdr1 = rAdr2 := null;
		for i in 1..nCntAddress where vAdr_list is not null loop
			rAdr_tmp := ::[RUNTIME].[STR].extractWord(vAdr_list);
			cnst_rTypeAddTmp := rAdr_tmp->(::[PERSONAL_ADDRESS])[TYPE];
			if cnst_rTypeAddTmp=cnst_rTypeAddSwift then
				rAdr_swift := rAdr_tmp;	-- Адрес SWIFT_ADDRESS
				if P_DEL then
					rAdr_swift.[DELETE#AUTO];
					rAdr_swift := null;
					debug_pipe('Предварительно удаляем Адрес SWIFT',nDp2);
					nAlDelClOrg := nAlDelClOrg+1;
				end if;

			elsif cnst_rTypeAddTmp=cnst_rTypeAdd1 then
				rAdr1 := rAdr_tmp;		-- Адрес CORP

			elsif cnst_rTypeAddTmp=cnst_rTypeAdd2 then
				rAdr2 := rAdr_tmp;		-- Адрес FACT

			end if;
		end loop;
		debug_pipe('rAdr_swift='||rAdr_swift||' rAdr1='||rAdr1||' rAdr2='||rAdr2,nDp2);

		if rAdr_swift is null then
			if rAdr1 is not null then
				rAdr_swift := rAdr1.[PSH_EXP_COPY_SWF](cnst_rTypeAddSwift); -- updated CHANGE_SHORT_NAME EXP_COPY_TO_NEWS->PSH_EXP_COPY_SWF 14/10/25
				nAlAddClOrg:=nAlAddClOrg+1;
			end if;
			
			if rAdr_swift is null and rAdr2 is not null then
				rAdr_swift := rAdr2.[PSH_EXP_COPY_SWF](cnst_rTypeAddSwift); -- updated CHANGE_SHORT_NAME EXP_COPY_TO_NEWS->PSH_EXP_COPY_SWF 14/10/25
				nAlAddClOrg:=nAlAddClOrg+1;
			end if;
		end if;

		if P_V2.[0]=1 and rAdr_swift is not null then --Обновлять, если есть. Добавлять, если нет
			rAdr_swift.[IMP_STR] := ::[HOOK_BANK].[GET_PRINT_ADDR_1](rAdr_swift);
			nAlEditClOrg := nAlEditClOrg+1;
		end if;

		if mod(nAl,500)=0 then
			commit;
			debug_pipe('Обработано:'||nAl,nDp);
		end if;
	end loop;

	debug_pipe('ИТОГО: Обработано клиентов:'||nAl,nDp);
	debug_pipe(' Предварительно удалено Адресов SWIFT ЮЛ:'||nAlDelClOrg,nDp);
	debug_pipe(' Добавлено Адресов SWIFT ЮЛ:'||nAlAddClOrg,nDp);
	debug_pipe(' Обновлено Адресов SWIFT ЮЛ:'||nAlEditClOrg,nDp);
end;
end;
end;
