ph memo;
rez_ph memo;
n integer:=0;
fn varchar2;

begin
	
	for dp in ::[CONTACTS] all where dp%collection = cl_con AND dp.[PRIVATE].[CODE] = 'SMS'
	loop
		n:=n+1;
		ph:=dp.[NUMB];
		
		
	ph:=trim(replace(replace(ph,' ',''),chr(9),''));
	ph:=replace(ph,'(','');
	ph:=replace(ph,')','');
	ph:=replace(ph,'-','');
	ph:=replace(ph,'+','');
	
	
	fn:=length(ph);
	if fn = 11 then ph:=substr(ph, 2); end if;
	
	if n = 1 then
			rez_ph:=ph;
	else rez_ph:=rez_ph||chr(10)||ph;
	end if;
	
	end loop;
		
	return	rez_ph;	
end;

public function cl_phone_private(cl_con number) return memo is 
ph memo;
rez_ph memo;
n integer:=0;
fn varchar2;

begin
	
	for dp in ::[CONTACTS] all where dp%collection = cl_con AND (dp.[TYPE].[CODE]='MOBILEPHONE' OR dp.[TYPE].[CODE]='PHONE')
	loop
		n:=n+1;
		ph:=dp.[PRIVATE].[VALUE];
	
