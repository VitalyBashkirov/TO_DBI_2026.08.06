::[TMC_DOCUM].[WORK_DOCUM].V_SIGN_PAY             :=V_SIGN_PAY             ;
::[TMC_DOCUM].[WORK_DOCUM].V_SUM_DOCUM_WITH_NDS   :=V_SUM_DOCUM_WITH_NDS   ;
::[TMC_DOCUM].[WORK_DOCUM].V#OST_HOZ_60807        :=V#OST_HOZ_60807        ;
end;
PSH_WORK_DOCUM (
	@name('Дата обработки документа')         P_DATE            in     [DATE],
	@name('Порождать финансовые проводки')    P_PROVE           in     [BOOLEAN],
	@name('Курс валюты договора')             P_COURSE          in     [SUMMA_16_6],
	@name('Признак гашения доверенности')     P_TRUST_DOC_CLOSE in     [BOOLEAN]     default null,
	@name('Порождать счета-фактуры')          P_FACTURA_SIGN    in     [BOOLEAN]     default null,
	@name('ЭСФ')                              P_ESF             in ref [FACTURA_DOC] default null,
	@name('Устанавливать дату валютирования') P_SET_DATE_VAL    in     [BOOLEAN]     default null
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE := [SYSTEM]::[OP_DATE];

end if;
-- End initialization of parameters and variables
declare
vNatCur ref [FT_MONEY] := sys_context (user_context, 'NatCur'); -- системная валюта
vSysDate DATE := to_date (sys_context (user_context, 'SYS_DATE')); -- дата опер. дня
Begin
	If P_MESSAGE='DEFAULT' Then
		
		select a(count(a)) in [LIST_TMC] where rownum = 1 into num;
		
		If StdLib.UserId.[DEPART].[FILIAL]!=[DOCUMENT_USER].[FILIAL] and nvl (::[FP_TUNE].[LIB].get_bool_value('VHO_USE_CENTRAL_WORK'), false) = false Then
			Pragma Error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||', созданный в другом филиале (отделении) обрабатывать нельзя!');
		ElsIf This%State In ('END','CONFIRM','PROVE') Then
			Pragma Error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||' в состоянии "'||Lib.State_name(This%State,This%Class)||'" обрабатывать нельзя!');
		ElsIf (num=0)
		 And ([DOC_NAME_REF].[OPER].[ACC_SUP] Or [DOC_NAME_REF].[OPER].[ACC_REC])
		 and [DOC_NAME_REF].[OPER].[CODE] not like 'АМОРТИЗАЦИЯ%' Then
			Pragma Error( 'Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||' с незаполненным списком ТМЦ обрабатывать нельзя!' );
		ElsIf [CONTR_LIST] Then
			Pragma Error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||' с не полностью заполненными реквизитами списка ТМЦ обрабатывать нельзя!');
		ElsIf Nvl([DOC_NAME_REF].[CODE_COMIS],False) And [CODE_COMIS] Is Null Then
			Pragma Error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. Код комиссии неопределен!');
		End If;
		P_PROVE:=True;
		V#CODE_OPER:=[DOC_NAME_REF].[OPER].[CODE];
		V#SIGN_COURSE := this.[HOZ_DOG_REF].[VALUTA]!=vNatCur And
						V#CODE_OPER in ('ПРИХОД', 'ДОНАЦЕНКА', 'РЕАЛИЗАЦИЯ', 'РЕМОНТ');
		-- Первоначальный курс договора
		if this.[HOZ_DOG_REF].[VALUTA]!=vNatCur then
			if this.[HOZ_DOG_REF].[COURSE] > 0 then
				P_COURSE := this.[HOZ_DOG_REF].[Course];
			elsif P_DATE <= vSysDate then
				P_COURSE := nvl (::[DOCUMENT].[LIB_CUR].GET_RATE(this.[HOZ_DOG_REF].[VALUTA], P_DATE), this.[HOZ_DOG_REF].[VALUTA].[VAL_COURCE]);
			else
				P_COURSE := this.[HOZ_DOG_REF].[VALUTA].[VAL_COURCE];
			end if;
		else
			P_COURSE := 1;
		end if;

		If This.[TRUST_DOCUM_REF] Is Not Null then
			IS_TRUST_DOCUM_REF := true;-- Для клиент-скрипта
			if nvl (This.[DOC_NAME_REF].[TRUST_DOC_CLOSE], false) Then
				P_TRUST_DOC_CLOSE := true;
			Else
				P_TRUST_DOC_CLOSE := false;
			End If;
		else
			IS_TRUST_DOCUM_REF := false; -- Для клиент-скрипта
			P_TRUST_DOC_CLOSE := false;
		end if;

		--------------------------------------------------------------------
		-----------зададим начальные данные для счетов-фактур---------------
		V_SIGN_SF_INITION := nvl(This.[DOC_NAME_REF].[SIGN_SF_INITION], false);
		V_SIGN_SF_INVOICE := nvl(This.[DOC_NAME_REF].[SIGN_SF_INVOICE], false);
		P_FACTURA_SIGN := V_SIGN_SF_INITION or V_SIGN_SF_INVOICE;
		if nvl(P_FACTURA_SIGN, false) then
			--определим сразу тип счета-фактуры
			V_TYPE.[0] := ::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Form_Type(This%class, This%Id, 'DEBUG');--вызов через интерфейс
			V_NUM_FACT := ::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Num_Fact(This%class, This%Id);--вызов через интерфейс
			V_DATE_PAY := nvl(::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Pay(This%class, This%Id), P_DATE);--вызов через интерфейс
			V_DATE_USAGE := nvl(::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Usage(This%class, This%Id), P_DATE);--вызов через интерфейс
			V_DATE_FACTURA := ::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Docum(This%class, This%Id);--вызов через интерфейс
			
		end if;	
		
		P_INFO:='P_DATE,P_COURSE, P_FACTURA_SIGN, %PARAM%.P_DATE';
	ElsIf P_MESSAGE='VALIDATE' And P_INFO='P_DATE' Then
		If P_DATE Is Null Then
			Pragma Error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. Дата обработки документа не определена!');
		ElsIf P_DATE>vSysDate Then
			Pragma Error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. Дата обработки документа больше операционной даты');
		Elsif [END_DATE] is not null and [END_DATE]>last_day(P_DATE) then
			pragma error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. Дата окончания периода обработки больше конца текущего месяца');
		End If;
		If P_FACTURA_SIGN Then
			V_DATE_PAY := nvl(::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Pay(This%class, This%Id), P_DATE);--вызов через интерфейс
			V_DATE_USAGE := nvl(::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Usage(This%class, This%Id), P_DATE);--вызов через интерфейс
		End If;
		if this.[HOZ_DOG_REF].[VALUTA]!=vNatCur and nvl(this.[HOZ_DOG_REF].[COURSE], 0) = 0 then
			P_COURSE := nvl (::[DOCUMENT].[LIB_CUR].GET_RATE(this.[HOZ_DOG_REF].[VALUTA], P_DATE), this.[HOZ_DOG_REF].[VALUTA].[VAL_COURCE]);
		end if;
	ElsIf P_MESSAGE='VALIDATE' Then
		If P_INFO='P_COURSE' Then
			If P_COURSE<=0 Then
				Pragma Error('Курс валюты= ' || P_COURSE);
			End If;
		ElsIf P_INFO='P_FACTURA_SIGN' Then
			if not (V_SIGN_SF_INITION or V_SIGN_SF_INVOICE) and P_FACTURA_SIGN Then
				stdio.put_line_buf ('На документе ''' || This.[DOC_NAME_REF].[NAME] || ''' счета-фактуры не формируются! '|| NL$ || ' Если необходимо сформировать счета-фактуры, то настройте документ!');
				P_FACTURA_SIGN := false;
			Elsif P_FACTURA_SIGN Then
				V_DATE_PAY := nvl(::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Pay(This%class, This%Id), P_DATE);--вызов через интерфейс
				V_DATE_USAGE := nvl(::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Usage(This%class, This%Id), P_DATE);--вызов через интерфейс
			Else
				V_DATE_PAY := null;
				V_DATE_USAGE := null;
			End If;
		End If;
	End If;
End;
end;

execute is
/*********************************************************************
Назначение: Формирование проводок по материальным и финансовым счетам
**********************************************************************/
/*
 *     Дата        Автор       BFS         Описание
 * ----------   -----------	----------- ---------------------------------------------------
 * 14.09.2012	akuzmin		BS00211803	Добавлены глобальные переменные "Ставка НДС по счету" поставщика и получателя, "Признак расчета курса на дату",
 										"Дата расчета курса" и их обработка. Добавлено заполнение массива кап. вложений.
 * 10.10.2012   apopov      BS00462375  Удаление/добавление экземпляра объекта кап.вложения через интерфейс
   23.10.2012	eroshenko	BS00266835	Удален вызов операции [WORK_DEVICE], тк в список тмц экземпляры разделения не добавляются
   03.12.2012	eroshenko				Добавлена процедура расчета налоговой премии calc_prem
   05.06.2013   eroshenko	BS00480832	В процедуру calc_prem добавлен случай, когда имеем дело с документом АМОРТИЗАЦИЯ_Н с пустым списком ТМЦ
   17.10.2013   terekhov	отсутствует В теле операции, перед проведением папки документов, добавлено прицепление дополнительных реквизитов платежных документов
   21.10.2013	akuzmin		BS00562529  Добавлена ветка в случае обработки амортизации перед движением "Передача"
 							BS00562496  -------------
   25.02.2014	akuzmin		BS00806655  В случае создания СФ на продажу у мат документа очищаем номер СФ. Удален закомментированный код
   26.02.2014	akuzmin		BS00788625	Изменена процедура по обработке объектов кап. вложений WorkObMatAcc. Теперь можно обрабатывать списание и приход 							 								
   13.03.2014	akuzmin		BS00808951	Определение реквизитов СЧФ выполняется только в случае когда есть признак создания СЧФ. Удален закомментированный код
   08.04.2014	akuzmin		BS00825793	В случае добавления объекта кап. вложений в функции WorkObMatAcc проверяется на непусту ссылка мат.счета
   04.09.2014	akuzmin		RP0090861	Вызов процедуры make_close_for_hoz_dog вынесен в отдельный цикл с использованием таблицы make_close_for_hoz_dog_tab
  22.01.2014	akuzmin		RP0173349	Если настройка VHO_SEND_DOC_DEPART_IN_BO включена, то в БО передается подразделение из документа.
  										Если включена настройка централизации VHO_USE_CENTRAL_WORK, то можно обрабатывать документы другого филиала
  24.07.2019	nikaev		RP0611825	Для матдокумента вида РАСХОД хоздоговор может быть определен из матдокумента вида ПРИХОД, значение передается в вызов операции CLOSE_DOGOV.
  05.09.2019    nikaev    	RP0611036   Ддобавлена передача новых параметров при вызове операции [WORK_REALIZE], добавлено сохранение в строке доппараметров V_ADDS значения доппараметра DATE_OP.
*/

	V_OPER  [TMC_OP_NAME_REF];		-- Материальнвя операция
	V_OPER_CODE V_OPER.[CODE]%type;	-- Код мат. операции
	V_DOC_DEPR this.[SUM_DEPR]%type;-- Сумма амортизации по документу
	V_FOLD [FOLDER_PAY_REF];		-- Папка платежей
	V_DOC_NUM Number;				-- Номер документа в папке
	V_ADDS [STRING_32000] := null;	-- Дополнительные параметры вызова BUSINESS_OP
	V_ADD_COST_ARR	::[TMC_ADD_COST].[LIB].addCostArr%type; -- массив доп расходов
	V_ADD_COST_SUM	SUMMA := 0;								-- сумма всех доп расходов по списку ТМЦ с НДС
	vDatePayDoc	date := null;	-- дата платежного документа, заполняется при обработке мат/документа задним числом
	tune_need_fill_user boolean;
	i integer;
	type make_close_for_hoz_dog_rec Is Record  (Arr	::[TMC_ADD_COST].[LIB].addCostArr%type,
												pFold	ref [FOLDER_PAY]
												);
	type make_close_for_hoz_dog_type Is Table Of make_close_for_hoz_dog_rec Index By binary_integer;
	make_close_for_hoz_dog_tab make_close_for_hoz_dog_type;
	mt_idx Integer;
	tune_depart_in_bo boolean := nvl (::[FP_TUNE].[LIB].get_bool_value('VHO_SEND_DOC_DEPART_IN_BO'), false);
	sf_inition ref [FACTURA_DOC];
	sf_invoice ref [FACTURA_DOC];
	serv_invoice [SERVICE_ARR];	
	vHOZ_DOG_REF ref [AUR_DOCUM] := this.[HOZ_DOG_REF];
	vIndSS integer := 0;
	vSummaOper [SUMMA] := 0;
Begin
	&debug(' (3)',0)
	
	if This%State In ('END','PROVE') Then
		Pragma Error('Документ в состоянии "'||Lib.State_name(This%State,This%Class)||'" обрабатывать нельзя!');
	elsif P_DATE != this.[DATE_DOC] and this.[DOC_NAME_REF].[OPER].[CODE] in ('ПЕРЕДАЧА_ИС') then
		pragma error('Документ должен быть обработан датой создания = '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||' т.к. в списке ТМЦ производился предварительный расчет амортизации на эту дату и суммы после обработки будут некорректными!');	
	end if;

	V#DATE := P_DATE;
	[DATE_EXEC] := P_DATE;        -- Дата обработки
	-- Вызов расширения для проведения дополнительных проверок/инициализаций документа --
	::[HOOK].[VARS].ref_hook.[VHO_BFR_WORK_1](this, p_date, p_prove, p_course, p_trust_doc_close, p_factura_sign, null);
	-- Параметр отключающий в BUSINESS_OP за не формирование документов при повторном обращении к одному и тому же шаблону
	::[RUNTIME].[STR].set_par(V_ADDS, 'CNDIF', false);

	-- Инициализируем рабочие переменные
	this.WORK_DOCUM_INIT;
	
	-- создадим первичный счет фактуру до прибавления дополнительных расходов
	-- в СЧФ будут суммы из списка ТМЦ + запись с доп. расходами (если они есть)	
	if P_FACTURA_SIGN Then
		&debug(' создадим первичный счет фактуру до прибавления дополнительных расходов',0)	
		if P_ESF is not null then
			sf_inition := P_ESF;
			::[VHO_INTERFACE].[PRX_TMC].new_conn(this%class, this%id, sf_inition.[CONN]);
			
		else
			V_SIGN_SF_INITION := nvl(V_SIGN_SF_INITION, This.[DOC_NAME_REF].[SIGN_SF_INITION]);
			
			--формируем первичный счет-фактуру
			&debug(' формируем первичный счет-фактуру',0)
		   	If V_SIGN_SF_INITION Then
				sf_inition := ::[VHO_INTERFACE].[PRX_TMC].Create_Lib_Create_Inition(This%class, This%Id, null/*p_kind*/, v_num_fact, v_date_factura);--вызов через интерфейс
				if sf_inition.[KIND].[0] = 2 then
					this.[ACC_NUM] := null;
				end if;
			End If;
		
			V_SIGN_SF_INVOICE := nvl(V_SIGN_SF_INVOICE, This.[DOC_NAME_REF].[SIGN_SF_INVOICE]);
			if sf_inition is not null then
				V#DOC.[ACC_NUM] 	:= sf_inition.[NUM_FACT];
				V#DOC.[ACC_DATE]	:= sf_inition.[DOCUMENT_DATE];
				--Проставим на СФ номер и дату госконтракта если это он
				if nvl(vHOZ_DOG_REF.[STATE_CONTRACT], false) then
					sf_inition.[NUM_CONTRACT] := vHOZ_DOG_REF.[NUM_DOG];
					sf_inition.[DATE_CONTRACT] := vHOZ_DOG_REF.[DATE_BEGIN];
				end if;
			end if;
			
			if V_SIGN_SF_INVOICE and sf_inition is not null then
				serv_invoice := NEXT_VALUE('SEQ_ID');
				
				declare
					serv [SERVICE];
				begin	
					--перенесем товары и услуги
					&debug(' перенесем товары и услуги',0)
					for item in sf_inition.[SERV_LIST]
					loop
						serv := item;
						serv%init(false,true);
						serv_invoice%insert(serv);
					end loop;
				end;	
				
				sf_invoice := ::[VHO_INTERFACE].[PRX_TMC].factura_doc_pay(	  null
																			, sf_inition		--Первичный счет-фактура
																			, v_date_pay		--Дата оплаты
																			, v_date_usage		--Дата принятия на учет
																			, serv_invoice		--Товары и услуги
																			, this		--Документ
																			, null
																		);
			end if;
		end if;		
	end if;	

	--если используются накладные расходы и они не были распределены до обработки документа, то необходимо их добавить
	if not nvl(this.[ADD_COSTS], false) then
		&debug(' используются накладные расходы и они не были распределены до обработки документа, то необходимо их добавить',0)
		::[TMC_DOCUM].[LIB].add_add_rash(this);
	end if;
	
	V_DOC_DEPR	:=	0;
	V_DOC_NUM	:=	0;
	V_OPER		:=	this.[DOC_NAME_REF].[OPER];
	V_OPER_CODE	:=	V_OPER.[CODE];
	
	tune_use_zav_num_arr := ::[TMC_IMPORT].[TUNE_PRODUCT].get_use_zav_num_arr;
	tune_need_fill_user := ::[FP_TUNE].[LIB].get_bool_value (code == 'NEED_FILL_USER');
	
	-- Создадим папку заранее для того, чтобы она корректно проставилась при добавлении записи календаря расчетов в [CLOSE_DOGOV]
	If P_PROVE And this.[DOC_NAME_REF].[BUSS] Is Not Null Then
		&debug(' Создадим папку заранее для того, чтобы она корректно проставилась при добавлении записи календаря расчетов в [CLOSE_DOGOV]',0)
		declare
			dep ref [DEPART];
			pat [PATTERN_DOC];
		begin
			if tune_depart_in_bo then
				dep := this.[DEPART];
			else
				dep := ::[SYSTEM].[VARIABLES].OurDepart;
			end if;		
			pat := this.[DOC_NAME_REF].[BUSS];
			
			V_FOLD := ::[VHO_INTERFACE].[PRX_TMC].FOLDER_PAY_NEW_AUTO(
																 P_DOCUMENT_DATE 	== ::[BRANCH].[SLIB].opdate_filial(dep.[FILIAL])
																,P_DOCUMENT_USER 	== stdlib.userid
																,P_BUSINESS_OP 		== pat%id
																,P_PROD_FOLD 		== this%id
																,P_DO_PROV_ALL 		== pat.[PROV_ALL]
																,P_PROV_ONE 		== pat.[PROV_ONE]
																,P_CAN_OUT_DT_KT 	== pat.[CAN_OUT_DT_KT]
																,P_DEPART 			== dep
																,P_CHECK_NEW_DOC 	== pat.[CHECK_NEW_DOC]
															);
			V_FOLD.[NOT_PROV_MEDIUM] := pat.[NOT_PROV_MEDIUM];															
			this.[IN_FOLDER] := V_FOLD;
		end;													
	end if;
	
----------	
	-- Параметр, определяющий стоит ли возвращать GET_SUMMA значение для типов сумм: 'SUM_NDS_PD', 'SUM_WITHOUNT_NDS_PD'.
	--(Этот механизм позволит не создавать повторно проводки с этими типами сумм далее )
	::[RUNTIME].[STR].set_par(V_ADDS, 'CR_PROV_PD', true);
	::[RUNTIME].[STR].set_par(V_ADDS, 'DATE_OP', P_DATE);
	for l in [LIST_TMC]
	loop
		V_SUM_DOCUM_WITH_NDS:=nvl(V_SUM_DOCUM_WITH_NDS,0)+ nvl(l.[CLI_SUMMA],0)+nvl(l.[NDS_SUMMA] ,0);
	end loop;
	&debug(' V_SUM_DOCUM_WITH_NDS='||V_SUM_DOCUM_WITH_NDS,0)

	if vHOZ_DOG_REF is null and this.[DOC_NAME_REF].[OPER] = ::[TMC_OP_NAME]([CODE] = 'РАСХОД') then
		-- для матдокумента вида РАСХОД хоздоговор определяется из матдокумента вида ПРИХОД
		for (select x(x.[LIST_TMC].[ACC_MAT_SUP].[TAB_MOVE].[TMC_DOCUM_REF].[HOZ_DOG_REF] : HOZ_DOG_REF)
				 in ::[TMC_DOCUM] all
			  where x = this
				and x.[LIST_TMC].[ACC_MAT_SUP].[TAB_MOVE].[TMC_DOCUM_REF].[DOC_NAME_REF].[OPER] = ::[TMC_OP_NAME]([CODE] = 'ПРИХОД'))
		loop
			vHOZ_DOG_REF := x.HOZ_DOG_REF;
			exit;
		end loop;
		&debug(' vHOZ_DOG_REF='||vHOZ_DOG_REF,0)
	end if;

	if this.[DOC_NAME_REF].[SIGN_CAL_CLOSE] and vHOZ_DOG_REF is not null Then
		&debug(' this.[CLOSE_DOGOV]',0)
		this.[CLOSE_DOGOV](this.[DATE_EXEC], v_oper_code, P_PROVE, P_COURSE, V_DATE_COURSE_CALC, vHOZ_DOG_REF);
	End If;
	
	declare
		v_close ref [CALENDAR_CALC];
	begin
		locate v_close in vHOZ_DOG_REF.[CALEND_CLOSE]
		where v_close.[TMC_DOCUM_REF] = this
			and (	this.[DOC_NAME_REF].[OPER].[CODE]='РЕАЛИЗАЦИЯ' and v_close.[HOZ_OPER].[CODE]='ЗАК_РЕАЛИЗАЦИЯ'
				or 	this.[DOC_NAME_REF].[OPER].[CODE]<>'РЕАЛИЗАЦИЯ'); --тк при реализации мб создано два закрытия

		--Свяжем оплаты и закрытие по договору при приходе(при приходе заполняется список оплат):
		--API 16.01.2020
		/** /
		for pay in this.[LIST_PAY]
		order by pay.[PRIORITY]
		loop
				&debug(' Свяжем оплаты и закрытие по договору при приходе(при приходе заполняется список оплат): pay='||pay,0);
				if 		v_close is not null
					and (nvl(v_close.[SUM_OPER_VAL_DOG],0) - Nvl(v_CLOSE.[SUMMA_CONN],0))>0
					and (nvl(pay.[CALENDAR].[SUM_OPER_VAL_DOG],0) - Nvl(pay.[CALENDAR].[SUMMA_CONN],0))>0
				then
					::[VHO_INTERFACE].[PRX_TMC].conn_calc(pay.[CALENDAR],v_close);
					pay.[SIGN_CONN]:=true; --проставили признак связи
				elsif v_close is not null  then
					stdio.put_line_buf('Оплата с id= '||pay.[CALENDAR] ||'не будет связана');
				end if;			
		end loop;
		/**/
		
		--Заполним глобальные переменные:
		&debug(' V_OPER_CODE='||V_OPER_CODE,0)
		if V_OPER_CODE in('ПРИХОД','РЕАЛИЗАЦИЯ','ДОНАЦЕНКА' ) and v_close is not null then
			&debug(' Заполним глобальные переменные:',0)
			
			V_SUM_WITHOUT_NDS_PD:=0;
			V_SUM_NDS_PD:=0;
			V_SIGN_FULL_PAY =V_SIGN_PAY:=false;
			for t_conn in v_close.[TAB_CONN]
			where t_conn.[CALEND_PAY]%state in ('PROV','FACT')
			loop
				V_SUM_WITHOUT_NDS_PD:=nvl(V_SUM_WITHOUT_NDS_PD, 0)+t_conn.[SUMMA_CONN_ACC];
				V_SIGN_PAY:=true;
				V_SUM_NDS_PD:= nvl(V_SUM_NDS_PD, 0)+ t_conn.[SUMMA_CONN_NDS];
			end loop;

			V_SIGN_FULL_PAY:= ((v_close.SUMMA_OPER-v_close.SUMMA_CONN)=0);
		end if;
	exception when no_data_found then
		if this.[DOC_NAME_REF].[SIGN_CAL_CLOSE] then
			stdio.put_line_buf('Закрытие по хоз.договору не найдено');
		end if;
	end;
	
	-- Используется Список ТМЦ
	&debug(' Используется Список ТМЦ. V_OPER_CODE='||V_OPER_CODE,0)
	If V_OPER_CODE not like 'АМОРТИЗАЦИЯ%' Then
		make_close_for_hoz_dog_tab := null;
		mt_idx := nvl(make_close_for_hoz_dog_tab.first, 1);
		
		&debug(' Обрабатываем Список ТМЦ',0)
		-- Обрабатываем Список ТМЦ
		For SS In [LIST_TMC]
		 Where (SS.[ACC_MAT_SUP] Is Not Null
		    Or SS.[ACC_MAT_REC] Is Not Null) one by one
		Loop
			&debug(' SS='||SS,0)
			vIndSS := vIndSS + 1;
			-- Вызов расширения для проведения дополнительных проверок/инициализаций экз. списка ТМЦ --
			::[HOOK].[VARS].ref_hook.[VHO_BFR_WORK_1](this, p_date, p_prove, p_course, p_trust_doc_close, p_factura_sign, ss);

			V#LIST = V#LIST  := SS;               -- Обрабатываемый экземпляр
			V#SUP  = V#SUP   := SS.[ACC_MAT_SUP]; -- Счет-поставщик
			V#REC  = V#REC   := SS.[ACC_MAT_REC]; -- Счет-получатель
			V#PLACE= V#PLACE := V#SUP.[LAST_MOVE].[PLACE]; -- Местонахождение поставщика
			
			-------------- Доп расходы-----------------------
			declare
				param	ref [TMC_PARAM]; --доп. параметр из списка ТМЦ
				v_id_array	number;		 -- значение из доп параматра, задает массив доп расходов	
			begin
				V_ADD_COST_ARR.delete;
				-- определим массив доп расходов
				locate param in V#LIST.[TAB_PARAM]
					where param.[ATTRIBUTE].[CODE] = 'ADD_COST_ARR';
				v_id_array := param.[VALUE];
				V_ADD_COST_ARR := ::[TMC_ADD_COST].[LIB].Get_Tab(v_id_array);
				
				if V_ADD_COST_ARR.count > 0 then
					-- посчитаем суммы по доп расходам
					V_ADD_COST_SUM := 0;
					V_SUM_AC := 0;
					V_SUM_NDS_AC := 0;
					for idx in V_ADD_COST_ARR.first..V_ADD_COST_ARR.last
					loop
						V_ADD_COST_SUM := V_ADD_COST_SUM + nvl(V_ADD_COST_ARR(idx).cost, 0) + (1 - nvl(V_ADD_COST_ARR(idx).nds_in_sum, false)) * nvl(V_ADD_COST_ARR(idx).nds, 0); -- для подсчета фин рез-та, всегда с НДС (банк заказчик так захотел)
						V_SUM_AC := V_SUM_AC + nvl(V_ADD_COST_ARR(idx).cost, 0);
						V_SUM_NDS_AC := V_SUM_NDS_AC + nvl(V_ADD_COST_ARR(idx).nds, 0);
					end loop;
				end if;
			exception when NO_DATA_FOUND then null;		
			end;	
			
			&debug(' (4)',0)
			WritePublicVar;
			
			/*Проверка записей в массиве КСЭ (Конструктивно-сочлененные эелементы).
			 * Документ выбытия/продажи не должен быть обработан,
			 * если в массиве КСЭ есть хотя бы одна запись с признаком "Исключен" = нет.
			 *
			 */ 			
			if V_OPER_CODE in ('РАСХОД', 'РЕАЛИЗАЦИЯ', 'СПИСАНИЕ') then
				for comp
				in V#SUP.[COMPOUND]
				where nvl(comp.[EXCLUDE], false) = false
				loop
					pragma error('У материального счета ' || V#SUP.[ACC_MAT] || ' в массиве КСЭ есть не исключенные элементы!');
				end loop;
			end if;

			--Если данный мат. счет находится в массиве КСЭ другого мат. счета, то проставить на текущем признак "Исключен"= да.
			CheckCOMPOUND (	 p_oper 		==	V_OPER_CODE	--Код операции
	 						,p_currMatAcc	==	V#SUP		--обрабатываемый мат счет
	 						,p_doc			==	THIS		--обрабатываемый документ
	 						,p_DateExclude	==	P_DATE		--дата исключения
	 						);
			-------------------------------------------------
			
						
			-- Сравним заданную дату с датой последнего движения на счетах поставщика и получателя
			If V#SUP Is Not Null
			 And V#SUP.[LAST_MOVE] Is Not Null
			 And V#SUP.[LAST_MOVE].[BEG_DATE] > P_DATE
			 and V_OPER_CODE != 'НОРМА' Then
				Pragma Error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. По материальному счету: ' || V#SUP.[ACC_MAT] || ' - ' || V#SUP.[NAME] ||
							' уже есть движения после ' || To_Char(P_DATE,'DD/MM/YYYY') || ' года');
			End If;
			If V#REC Is Not Null And V#REC.[LAST_MOVE] Is Not Null And V#REC.[LAST_MOVE].[BEG_DATE] > P_DATE Then
				Pragma Error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. По материальному счету: ' || V#REC.[ACC_MAT] || '  ' || V#REC.[NAME] ||
							' уже есть движения после ' || To_Char(P_DATE,'DD/MM/YYYY') || ' года');
			End If;

			if V_OPER_CODE = 'ПРИХОД' and ss.[GRUPPA_REC] is null then
				pragma error ('Для наименования "' || ss.[NAME] || '" не задана группа ТМЦ!');
			end if;
			
			-- проверка, что у матсчета нет невозвращенных аренд и консерваций на дату обработки
			if  not (not nvl(vHOZ_DOG_REF.[IFRS_16],false) and nvl(vHOZ_DOG_REF.[VID_DOG].[SIGN_DOHOD_DOG],false)) -- не договор операционной аренды
			and ::[TMC_LIST].[PROCESS_UTILS].is_give_rent(nvl(V#SUP, V#REC), null, P_DATE) = true and V_OPER_CODE not in ('ВОЗВРАТ', 'ВЫДАЧА', 'ПЕРЕДАЧА', 'ИЗМЕНЕНИЕ_ЛС') then
				Pragma Error('В материальном документе №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. По материальному счету: ' || V#SUP.[ACC_MAT] || ' - ' || V#SUP.[NAME] ||
							' на дату обработки документа '||To_Char(P_DATE,'DD/MM/YYYY')||' имеются невозвращенные (возможно частично) выдачи в аренду, либо не наступила дата окончания консервации! Необходимо выполнить все возвраты!');
			end if;

			-- Заполним глобальные переменные для работы бизнес-операции
			V#SUM_OPER:=SS.[ALL_SUMMA]; -- Сумма операции

			if V#SUM_OPER = 0 and not nvl(ss.[UN_SYSTEM], false)
			and v_oper_code not in ('ОТРАЖЕНИЕ_НДС', 'УЦЕНКА', 'ПЕРЕДАЧА_ИС', 'ИЗМЕНЕНИЕ_СТ', 'ИЗМЕНЕНИЕ_ЛС', 'ОЦЕНКА_ДАПП_СНН', 'ИЗМЕНЕНИЕ_ЗД'/*на случай когда подтверждаем либо планируем с новым СПИ*/) then
				pragma error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. Не задана сумма операции для наименования "'||SS.[NAME]||'"!');
			end if;

			if V_OPER_CODE in ('ПРИХОД', 'ДОНАЦЕНКА', 'РЕАЛИЗАЦИЯ', 'РЕМОНТ')
			 and [HOZ_DOG_REF].[VALUTA] != [SYSTEM].[VARIABLES].NatCur
			 and P_COURSE = 1 then
				pragma error ('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. Не задан курс');
			elsif P_COURSE = 0 then
					-- установка суммы в валюте, если не была определена.
					set_val_sum (SS, [HOZ_DOG_REF].[VALUTA], P_DATE);
			end if;
			if V_OPER_CODE in ('ПРИХОД', 'ПЕРЕДАЧА') and tune_need_fill_user and SS.[USER] is null
			then
				pragma error('В списке ТМЦ для мат. счета №" '|| SS.[ACC_MAT_REC].[ACC_MAT]
							|| '" в документе №' || this.[DOCUMENT_NUM] || ' от ' || to_char (this.[DOCUMENT_DATE], 'DD/MM/YYYY')
							|| 'не задан "Пользователь"!');
			end if;
			V#COURSE_OPER := 1;
			V#SUM_NDS :=SS.[NDS_SUMMA]; -- Сумма НДС
			If SS.[NDS_KIND] Then
				V#SUM_UN_NDS := SS.[ALL_SUMMA]-SS.[NDS_SUMMA];
			Else
				V#SUM_UN_NDS := SS.[ALL_SUMMA];
			End If;
			
			--получаем сумму без НДС счета -поставщика для 2553(сумма берется до добавления движений прихода и расчета)
			V_SUM_SUP_UN_NDS :=V#SUP.[LAST_MOVE].[CLI_SUMMA];
			V_SUM_SUP_NDS 	 :=V#SUP.[LAST_MOVE].[NDS_SUMMA];
			V#SUM_MOVE:=SS.[BAL_SUMMA]; -- Сумма движения (балансовая)
			V_BAL_ST := V#LIST.[BAL_ST];

			If SS.[NDS_KIND] And Not SS.[NDS_IN_SUM] Then
				V#SUM_PROV := SS.[BAL_SUMMA]-Nvl(SS.[NDS_SUMMA],0);
			ElsIf Not SS.[NDS_KIND] And SS.[NDS_IN_SUM] And V_OPER_CODE!='МОНТАЖ' Then
				V#SUM_PROV := SS.[BAL_SUMMA]+Nvl(SS.[NDS_SUMMA],0);
			Else
				V#SUM_PROV := SS.[BAL_SUMMA];
			End If;

			V#SUM_RASH:=SS.[SUM_RASH];  -- Сумма накладных расходов
			V#SUM_NSP :=SS.[NSP_SUMMA]; -- Сумма налога с продаж
			-- Сумма операции в валюте
			V#SUM_OPER_VAL:=SS.[VAL_SUMMA];
			V#SUM_ALL_DEPR  := Nvl(V#SUP.[LAST_MOVE].[ALL_DEPR],0);		-- Сумма всей амортизации
			V#SUM_EST_PRICE := Nvl(V#SUP.[LAST_MOVE].[EST_PRICE],0);	-- Сумма переоценки цены
			V#SUM_EST_DEPR  := Nvl(V#SUP.[LAST_MOVE].[EST_DEPR],0);		-- Сумма переценки амортизации
			V#DATE_OP       := nvl(V#REC.[DATE_OP], V#SUP.[DATE_OP]);	-- Дата открытия
			-- Если берется не все
			If SS.[QUANT] < V#SUP.[LAST_MOVE].[QUANT] Then
				V#SUM_ALL_DEPR  := V#SUM_ALL_DEPR*SS.[QUANT]/V#SUP.[LAST_MOVE].[QUANT];      -- Сумма всей амортизации
				V#SUM_EST_PRICE := V#SUM_EST_PRICE*SS.[QUANT]/V#SUP.[LAST_MOVE].[QUANT];     -- Сумма переоценки цены
				V#SUM_EST_DEPR  := V#SUM_EST_DEPR*SS.[QUANT]/V#SUP.[LAST_MOVE].[QUANT];      -- Сумма переценки амортизации
			End If;

			V#SUM_ALL_PRICE := V#SUM_EST_PRICE-V#SUM_EST_DEPR;           -- Сумма фонда переоценки
			V#SUM_OSTAT     := V#SUM_MOVE-V#SUM_ALL_DEPR-V#SUM_ALL_PRICE;-- Сумма остаточной стоимости

			V#SUM_DEPR		:= 0;
			V#SUM_NAL_DEPR	:= 0;
			
			declare
				hoz60807	ref [AC_FIN];
			begin
				V#OST_HOZ_60807 := 0;
				if this.[HOZ_DOG_REF] is not null then
					hoz60807 := ::[TMC_DPT_ACC].[LIB].get_fin_acc(this.[HOZ_DOG_REF].[TAB_DOG_ACC], ::[TIP_ACC]([COD]='HOZ_60807'), this.[HOZ_DOG_REF].[DEPART], this.[HOZ_DOG_REF].[FILIAL]);
					V#OST_HOZ_60807 :=  nvl(abs(hoz60807.[SALDO]),0);
				end if;
			end;	
			
			-- Начислим амортизацию выбывающего ОС или НМА
			&debug(' (5)',0)
			WritePublicVar;
			
			If Nvl([DOC_NAME_REF].[DEPR],False) Then
				declare
					V_ARR ::[AC_MAT].[CALC_AMO_LIB].V_AMO_ARR%type;
					v_beg_date date;
					v_end_date date;
					V_TMC [TMC_ACC_MAT_REF] := nvl(V#SUP,V#REC);
					calc_to_date date;
					V_DATE_MOVE date; --дата обработки
				begin
					V_DATE_MOVE := P_DATE;
					get_amo_dates(P_DATE, v_beg_date, v_end_date);
					
					[BEG_DATE] := v_beg_date;
					[END_DATE] := v_end_date;
					
					-- Инициализация настроек расчета амортизации
					&debug(' Инициализация настроек расчета амортизации',0)
					::[AC_MAT].[CALC_AMO_LIB].init_calc_tunes;
	
					if ::[FP_TUNE].[LIB].get_bool_value('VHO_448_P') = true
						and (nvl(v_tmc.[LAST_MOVE].[GRUPPA].[SIGN_MONTH], false) = false and  nvl(v_tmc.[LAST_MOVE].[GRUPPA].[SIGN_SPIS], false) = false) then -- эти группы с признаками обрабатываем "по старому"
						
						-- определим дату до которой нужно начилсять амортизацию
						&debug(' определим дату до которой нужно начилсять амортизацию',0)
						if this.[DATE_PRICE] is not null then
							calc_to_date := this.[DATE_PRICE] - 1;							
						elsif this.[DATE_CHANGE] is not null then
							calc_to_date := this.[DATE_CHANGE] - 1;								
						elsif ::[AC_MAT].[LIB_ACC_MAT].is_move_next_amo_day(null, SS) = false then
							calc_to_date := P_DATE - 1;						
						else	
							calc_to_date := P_DATE;
						end if;	
						
						/* для документа обесценения, непосредственно дата обесценения устанавливается как дата создания документа (а обработать его могут и позже) */
						if this.[DOC_NAME_REF].[OPER].[CODE] = 'ОБЕСЦЕНЕНИЕ' then
							calc_to_date := this.[DATE_DOC] - 1;
							V_DATE_MOVE := calc_to_date;
						end if;
												
						-- делаем расчет амортизации до движения							
						V#SUM_DEPR := ::[TMC_AMO_CALC_TAB].[LIB].calc_buh_amo_to_date(V_TMC, calc_to_date, this, SS, V_DATE_MOVE);
					else	
						if not nvl(v_tmc.[SIGN_ALL_DEPR], false) then
							-- Расчет бухгалтерской амортизации
							V#SUM_DEPR := ::[AC_MAT].[CALC_AMO_LIB].get_all_amo_sum(V_TMC, v_beg_date, v_end_date, v_arr);
							-- вставка движений
							::[AC_MAT].[CALC_AMO_LIB].insert_buh_amo_moves(V_ARR, this, calc_to_date, SS);
							v_arr.delete;
						end if;
					end if;	
						
					
					-- Расчет налоговой амортизации
					if V_TMC.[NAL_METHOD].[0] != 3 then
						-- Расчет налоговой амортизации
						V#SUM_NAL_DEPR := ::[AC_MAT].[CALC_AMO_LIB].get_all_nal_amo_sum(V_TMC, v_beg_date, v_end_date, v_arr);
						-- вставка движений
						
						::[AC_MAT].[CALC_AMO_LIB].insert_nal_amo_moves(V_ARR, this, P_DATE, SS);
						v_arr.delete;
					end if;
	
					V#SUM_ALL_DEPR := V#SUM_ALL_DEPR + V#SUM_DEPR;
					V_DOC_DEPR := V_DOC_DEPR + V#SUM_DEPR;
				end;
			End If;


			-- Расчет сумм дохода и расхода
			&debug(' Расчет сумм дохода и расхода',0)
			declare
				-- uralov. Приводим учет суммы НДС в сумме операции в соответствии с учетом суммы НДС в мат/счете поставщике.
				v_sum_calc_dohod	[SUMMA]	:= V#SUM_UN_NDS;
				type dism_arr is table of [TMC_DISM_RES];
				V_ARR_DISM_RES 		dism_arr;
			begin
				If V#SUP.[GRUPPA].[TYPE].[CODE] in ('ОС', 'НМА') Then
					V#SUM_DOHOD := v_sum_calc_dohod - V#SUM_MOVE + Nvl(V#SUM_ALL_DEPR, 0) - V_ADD_COST_SUM;
				--maxx Возможное место расширения для расчета суммы дохода V#SUM_DOHOD
				ElsIf nvl(V#SUP.[GRUPPA].[UN_SYSTEM], false) = true Then
					V#SUM_DOHOD := v_sum_calc_dohod - V_ADD_COST_SUM;
				Else
					V#SUM_DOHOD := v_sum_calc_dohod - V#SUM_MOVE - V_ADD_COST_SUM;
				End If;
	
				If V_OPER_CODE='СПИСАНИЕ' Or V_OPER_CODE='ДАРЕНИЕ' Then
					V#SUM_DOHOD := V#SUM_DOHOD - v_sum_calc_dohod;
				End If;
				
												
				If V_OPER_CODE='СПИСАНИЕ' Then --прибавим сумму всех деталей полученную при разборе	
						V_ARR_DISM_RES := [TMC_DISM_RES].[LIB].get_tab ([TMC_PARAM].[LIB].Get_ ( SS.[TAB_PARAM],[TMC_ATTRIBUTES].[VARS].DISM_RES_ARR));
						i:=V_ARR_DISM_RES.first;
						while i is not null
						loop
							V#SUM_DOHOD := V#SUM_DOHOD + V_ARR_DISM_RES(i).[SUMMA];
							i:=V_ARR_DISM_RES.next(i);
						end loop;	
				End If;
				
				If V#SUM_DOHOD>0 Then
					V#SUM_RASHOD := 0;
					V#SUM_DOHOD := V#SUM_DOHOD - ::[AC_MAT].[LIB_DISMANTLING].get_sum_discount_prov(V#SUP);
				Else
					V#SUM_RASHOD := -V#SUM_DOHOD;
					V#SUM_RASHOD := V#SUM_RASHOD - ::[AC_MAT].[LIB_DISMANTLING].get_sum_discount_prov(V#SUP);
					V#SUM_DOHOD:=0;
				End If;
			end;
			-- Если используется один счет
			if V_OPER_CODE = 'ПЕРЕДАЧА' then
				[WORK_ALL_MOVE](P_DATE,SS,V#SUP,V#REC);
			ElsIf V_OPER_CODE = 'ПЕРЕДАЧА_ИС' then
				[WORK_MOVE_CHS](P_DATE,SS,V#SUP,V#REC);
			ElsIf V_OPER_CODE = 'ИЗМЕНЕНИЕ_СТ' Then
				[WORK_CHS](P_DATE,SS,V#SUP,V#REC);
			ElsIf V_OPER_CODE = 'РАСХОД' Then
				[WORK_RASHOD](P_DATE,SS,V#SUP);
			ElsIf V_OPER_CODE = 'РЕАЛИЗАЦИЯ' Then
				&debug('вызов [WORK_REALIZE]',0)
				&debug('	V#SUM_MOVE='||V#SUM_MOVE||' / V#SUM_ALL_DEPR='||V#SUM_ALL_DEPR,0)
				vSummaOper := vSummaOper + (V#SUM_MOVE - V#SUM_ALL_DEPR);
				&debug('	vSummaOper='||vSummaOper,0)
				[WORK_REALIZE](P_DATE,SS,V#SUP,(vIndSS = [LIST_TMC]%size(0)),vSummaOper);
			ElsIf V_OPER_CODE = 'ДОНАЦЕНКА' Then
				[WORK_IN_PRICE](P_DATE,SS,V#REC);
			ElsIf V_OPER_CODE = 'УЦЕНКА' Then
				[WORK_OUT_PRICE](P_DATE,SS,V#SUP);
			ElsIf V_OPER_CODE = 'РЕМОНТ' Then
				[WORK_REMONT](P_DATE,SS,V#SUP,V#REC);
			ElsIf V_OPER_CODE = 'ПЕРЕОЦЕНКА' Then
				[WORK_PRICE](P_DATE,SS,V#SUP);
			ElsIf V_OPER_CODE = 'НОРМА' Then
				[WORK_NORMA](P_DATE,SS);
			ElsIf V_OPER_CODE = 'ПРИХОД' then				
				-- если задан комплект
				if V#LIST.[ACC_MAT] is not null then				
					-- если единичное хранение, то приход в комплект --
					if nvl(V#LIST.[GRUPPA_REC].[UNIT_SAVE], false) then				
						[WORK_PRIH_COMPL](P_DATE, SS, V#REC);
					-- иначе приход на мат. счет --
					Else				
						[WORK_PRIH_AC_MAT](P_DATE, SS, V#SUP, V#REC);
					end if;					
				Else 				
					[WORK_PRIHOD](P_DATE, SS, V#REC);
				end if;
			ElsIf V_OPER_CODE = 'МОНТАЖ' Then
				[WORK_MONTAG](P_DATE,SS,V#SUP,V#REC);
			ElsIf V_OPER_CODE = 'ДЕМОНТАЖ' Then
				[WORK_DEMONTAG](P_DATE,SS,V#SUP,V#REC);
			elsif V_OPER_CODE = 'СПИСАНИЕ' then
				this.[WORK_SPIS](P_DATE,SS,V#SUP);
			elsif V_OPER_CODE = 'ВЫДАЧА' then
				this.[WORK_GIVE](P_DATE,SS);
			elsif V_OPER_CODE = 'ВОЗВРАТ' then
				this.[WORK_RETURN](P_DATE,SS);
			elsif V_OPER_CODE = 'ОТРАЖЕНИЕ_НДС' then
				this.[WORK_NDS](P_DATE, SS);
			elsif V_OPER_CODE = 'ОБЕСЦЕНЕНИЕ' then				
				this.[WORK_DEVAL](P_DATE, SS, V#SUP);		
			elsif V_OPER_CODE = 'ВОССТ_ОБЕСЦ' then				
				this.[WORK_REP_DEVAL](P_DATE, SS);			
			elsif V_OPER_CODE = 'ИЗМЕНЕНИЕ_ЛС' then
				this.[WORK_LIQUID](P_DATE, SS);
			elsif V_OPER_CODE = 'ИЗМЕНЕНИЕ_ЗД' then
				this.[WORK_DISMANTLING](P_DATE, SS);
			elsif V_OPER_CODE = 'ОЦЕНКА_ДАПП_СНН' then
				this.[WORK_REPRICE_DAP](P_DATE, SS);
			Else -- Если используется Счет-поставщик
				pragma error('Документ №'||this.[DOCUMENT_NUM]||' от '||to_char(this.[DATE_DOC], 'DD/MM/YYYY')||'. Невозможно произвести обработку операции "'||V_OPER_CODE||'" !');
			End If;
	

			-- Обновление последних данных на мат.счете
			if V#REC is not null
			 and not (V#SUP is not null and V#REC = V#SUP) then
				V#REC.[UPDATE_DATA];
			end if;

			if V#SUP is not null then
				V#SUP.[UPDATE_DATA];
			end if;
			--(nmatveeva) 09/04/2012-  BS00211803
			if V#REC is not null then
				V_SUM_NDS_RATE_ACC_REC:= V#REC.[NDS_RATE];
				V_SUM_NDS_ACC_REC:= V#REC.[LAST_MOVE].[NDS_SUMMA];
			end if;
			if V#SUP is not null then
				V_SUM_NDS_RATE_ACC_SUP:= V#SUP.[NDS_RATE];
				V_SUM_NDS_ACC_SUP:= V#SUP.[LAST_MOVE].[NDS_SUMMA];
			end if;
			-------------------------
			-- Пересчет ставок НДС
			recalc_nds_rates(V#SUP, V#REC);
			
			
			
			--если у поставщика были лиц. счета и матсчет не поменялся, то проинициализируем их в получателе с новой группой
			init_user_accs_from_sup(SS);			
			
			If P_PROVE And [DOC_NAME_REF].[BUSS] Is Not Null Then
				if P_DATE < [SYSTEM].[OP_DATE] then
					vDatePayDoc := trunc (P_DATE) + 1 - 1/24/60/60; --дата платежного документа, и его дата валютирования
				else
					vDatePayDoc := P_DATE;
				end if;
				----- запуск бизнеса для доп расходов -----
				begin
					if V_ADD_COST_ARR.count > 0 then
						for idx in V_ADD_COST_ARR.first..V_ADD_COST_ARR.last
						loop
							-- бизнес для доп расхода запускается, если срабатывает условие СУММА_ДР_Н > 0
							V_ADD_COST := V_ADD_COST_ARR(idx);
							if tune_depart_in_bo then
								::[VHO_INTERFACE].[PRX_TMC].Pattern_Doc_Business_Op([DOC_NAME_REF].[BUSS], Null, This%id, 1, Null, False, V_FOLD, vDatePayDoc, this.[DEPART], V_ADDS, null, null, null, null, null, vDatePayDoc);
							else
								::[VHO_INTERFACE].[PRX_TMC].Pattern_Doc_Business_Op([DOC_NAME_REF].[BUSS], Null, This%id, 1, Null, False, V_FOLD, vDatePayDoc, null, V_ADDS, null, null, null, null, null, vDatePayDoc);
							end if;																				
						end loop;
					end if;
					V_ADD_COST := null;
				exception when NO_DATA_FOUND then null;		
				end;
						
				If V_FOLD Is Not Null Then
					V_FOLD.[BUSINESS_OP] := Null;
				End If;
				if tune_depart_in_bo then
					::[VHO_INTERFACE].[PRX_TMC].Pattern_Doc_Business_Op([DOC_NAME_REF].[BUSS],Null,This%id,1,Null,False,V_FOLD, vDatePayDoc, this.[DEPART], V_ADDS, null, null, null, null, null, vDatePayDoc); -- Папка платежей(ссылка)--вызов через интерфейс
				else
					::[VHO_INTERFACE].[PRX_TMC].Pattern_Doc_Business_Op([DOC_NAME_REF].[BUSS],Null,This%id,1,Null,False,V_FOLD, vDatePayDoc, null, V_ADDS, null, null, null, null, null, vDatePayDoc); -- Папка платежей(ссылка)--вызов через интерфейс	
				end if;	
						
				If substr(V_OPER_CODE,1,11) != 'АМОРТИЗАЦИЯ' Then
				--Установка назначений для документов в папке
					set_nazn_in_folder(V_FOLD,V_DOC_NUM,this,SS);
				End If;
			End If;
			if tune_use_zav_num_arr
			 and ((V_OPER_CODE = 'ПЕРЕДАЧА' and V#SUP != V#REC) or V_OPER_CODE in ('СПИСАНИЕ', 'РАСХОД', 'РЕАЛИЗАЦИЯ', 'МОНТАЖ')) then
				::[TMC_NUM].[LIB].delete_by_list(V#SUP.[TAB_NUM], SS);
			end if;

			SS.[UNDO_DECL](true);
			
			if V_OPER_CODE in ('ПРИХОД','ПЕРЕДАЧА','ДЕМОНТАЖ','ВЫДАЧА','МОНТАЖ','ПЕРЕДАЧА_ИС') then -- МОНТАЖ только для того чтобы не проскочить случай монтажа на болванку			
				V#REC.[INIT_USER_ACC];
			end if;
			
			--если на документе проставлен признак заполнять/удалять массив кап. вложений, то обрабатываем
			if this.[DOC_NAME_REF].[SIGN_OB_MAT_ARR] then
				WorkObMatAcc(this);
			end if;
				
			--Создадим закрытия по хоз договру по доп расходам	
			-- т.к. Добавление экземпляра в календарь расчётов - это Простой конструктор, то, чтобы избежать Commit на каждом витке цикла,
			-- вместо вызова make_close_for_hoz_dog сохраняем параметры, а затем используем эти параметры, делая вызовы в отдельном цикле
			make_close_for_hoz_dog_tab(mt_idx).Arr 		:= V_ADD_COST_ARR;
			make_close_for_hoz_dog_tab(mt_idx).pFold 	:= V_FOLD;
						
			mt_idx := mt_idx + 1;
				
			if V_OPER_CODE = 'ПЕРЕОЦЕНКА' then
				-- запомним сумму переоценки, отнесенную на расходы
				save_sum_estim_rashod (SS);
				-- запомним сумму переоценки, отнесенную на доходы
				save_sum_estim_dohod (SS);
			end if;	
			
			if V_OPER_CODE in ('ПРИХОД', 'ПЕРЕДАЧА', 'ИЗМЕНЕНИЕ_ЗД', 'МОНТАЖ', 'ДЕМОНТАЖ', 'ПЕРЕДАЧА_ИС') then
				-- затраты на демонтаж могут меняться как у получателя так и поставщика
				::[AC_MAT].[LIB_DISMANTLING].distrib_dismantling_disc (SS.[ACC_MAT_SUP], SS.[ACC_MAT_SUP].[LAST_MOVE]);
				::[AC_MAT].[LIB_DISMANTLING].distrib_dismantling_disc (SS.[ACC_MAT_REC], SS.[ACC_MAT_REC].[LAST_MOVE]);
			else
				declare
					tmc ref [AC_MAT];
					new_move ref [TMC_MOVE];
					prev_move ref [TMC_MOVE];
				begin	
					tmc := nvl(SS.[ACC_MAT_REC], SS.[ACC_MAT_SUP]);
					new_move := tmc.[LAST_MOVE];
					prev_move := new_move.[PREV_MOVE];
					
					if new_move.[DISMANTLING_COST] > 0
					and prev_move is not null
					and new_move.[PER_EXPL] != prev_move.[PER_EXPL] then
						if ::[AC_MAT].[LIB_DISMANTLING].get_discount_koeff(P_DATE, new_move.[DEPART], new_move.[PER_EXPL], tmc) != ::[AC_MAT].[LIB_DISMANTLING].get_discount_koeff(P_DATE, prev_move.[DEPART], prev_move.[PER_EXPL], tmc) then
							stdio.put_line_buf('С изменением СПИ у материального счета "'||tmc.[NAME]||'" инв №'||tmc.[INV_NUMB]||' произошло изменение коэффициента дисконтирования для затрат на демонтаж. Необходимо произвести изменение или подтверждение затрат на демонтаж!');
						end if;	
					end if;
				end;		
			end if;	
			
			
								
		End Loop;
		
		
		-- закроем счета реализации (448-П)
		if P_PROVE And [DOC_NAME_REF].[BUSS] Is Not Null --использовалась БО
		  and nvl(this.[DOC_NAME_REF].[CLOSE_ACC_REAL],false) then --проставлен признак закрытия счетов выбытия(реализации)
			CloseAccRealize(this, [DOC_NAME_REF].[BUSS]);
		end if;	
				
		
		--Создадим закрытия по хоз договру по доп расходам
		mt_idx := nvl(make_close_for_hoz_dog_tab.First, 1);
		While mt_idx Is Not Null
		Loop
			make_close_for_hoz_dog(make_close_for_hoz_dog_tab(mt_idx).Arr,
		 							P_DATE,
			 						make_close_for_hoz_dog_tab(mt_idx).pFold,
			 						P_PROVE,
			 						this,
			 						P_COURSE);
			
			mt_idx:=make_close_for_hoz_dog_tab.Next(mt_idx);
		End Loop;
		
		make_close_for_hoz_dog_tab := null;
		
	ElsIf V_OPER_CODE = 'АМОРТИЗАЦИЯ' Then
		&debug(' Вызов [PSH_WORK_DEPR]',0) -- updated CHANGE_SHORT_NAME PSB_WORK_DEPR->PSH_WORK_DEPR 15/10/25
		[PSH_WORK_DEPR](P_DATE,Null,Null,This,P_PROVE); -- updated CHANGE_SHORT_NAME PSB_WORK_DEPR->PSH_WORK_DEPR 15/10/25
		
	ElsIf V_OPER_CODE = 'АМОРТИЗАЦИЯ_Н' Then
		[WORK_DEPR_N](P_DATE,Null,Null,This,P_PROVE);
	end if;
	-- Рассчитаем суммы в документе
	&debug(' Рассчитаем суммы в документе [COUNT#AUTO]',0)
	[COUNT#AUTO];
	
	--Пересчитаем налоговые премии:
	&debug(' Пересчитаем налоговые премии',0)
	WritePublicVar;
	
	calc_prem(this);

	&debug(' (6) '|| substr(V_OPER_CODE,1,11),0)
	WritePublicVar;
	
	If substr(V_OPER_CODE,1,11)!='АМОРТИЗАЦИЯ' Then
		[SUM_DEPR]:= V_DOC_DEPR; -- Сумма амортизации по документу
		&debug(' Сумма амортизации по документу. V_DOC_DEPR='||V_DOC_DEPR,0)
		If P_PROVE And [DOC_NAME_REF].[BUSS] Is Not Null Then -- Если использовалась бизнес-операция			
			V_FOLD.[BUSINESS_OP] := [DOC_NAME_REF].[BUSS]; -- Запомним бизнес-операцию в папке
			If V_FOLD Is Not Null Then -- Обработаем папку с документами
				[WORK_FOLDER](V_FOLD,P_DATE);
				if nvl(::[FP_TUNE].[LIB].get_bool_value('UU_TMC_INTEGR', null, false), false)
					and nvl( this.[DOC_NAME_REF].[SIGN_ALLOW_CL], false) then
					declare
								i integer;
								vPay boolean;
								vHardCtrl boolean;
								vEABSD boolean;
								vIsStorno boolean;
							  --API 16.01.2020	
							  --vDistr [VHO_INTERFACE].[PRX_TMC].SumDistrCLType;
								plat_doc ref [MAIN_DOCUM];
					begin
						for docum in V_FOLD.[DOCS_IN_FOLD] loop
							if docum.[DOCUMENT]%class = MAIN_DOCUM%class then --выгребем только платежки
								plat_doc := docum.[DOCUMENT];
								if (::[VHO_INTERFACE].[PRX_TMC].IsOnCtrl(plat_doc.[NUM_DT], plat_doc.[NUM_KT], coalesce(plat_doc.[DATE_PROV], ::[SYSTEM].[OP_DATE]), this.[DEPART], vPay, vHardCtrl, vEABSD, vIsStorno)) then
									for tmc_ref in this.[LIST_TMC] loop
										if tmc_ref.[TMC_DISTR]%size(1) = 0 then
											pragma error('Для ТМЦ "'||tmc_ref.[NAME]||'" не задано распределение в массиве "УУ. Распределение ТМЦ"!');
										end if;
									end loop;
									i := 0;
									/** / --API 14.01.2019
									for (select distinct d(	   SUM(d.summ)	: summ
													  ,d.target				: target
													  ,d.cfr				: cfr
													  ,nvl(d.anls, '-1')				: anl_str
													  ,max(d.anls_arr)		: anls
												)	
												 in  (
												
												 	select  list_tmc(
												 		coalesce (list_tmc.[TMC_DISTR].[SUMM], 0) 	: summ
												 		,list_tmc.[TMC_DISTR].[TARGET] 		: target
													 	,list_tmc.[TMC_DISTR].[CFR] 			: cfr
													 	,( select anl( ANALYTIC( listagg('|'||anl.[CATEGORY]||':'||anl.[OBJ_REF]||'|', ';')	, 'within group (order by [1])',anl.[CATEGORY] ))
															  in ::[ANL_VALUES] all where anl%collection = list_tmc.[TMC_DISTR].[ANLS] )
														 : anls
												 		, list_tmc.[TMC_DISTR].[ANLS] 			: anls_arr
												 	)  in this.[LIST_TMC]
												
											)
											group by d.target, d.cfr, nvl(d.anls, '-1')
											   	
								)
										loop
											i := i + 1;
											vDistr(i).[CONTROL_LIST] 	:= null;
											vDistr(i).[SUMM] 			:= d.summ;
											vDistr(i).[SUMM_VAT] 		:= 0;
											vDistr(i).[BUDGET] 			:= null;
											vDistr(i).[TARGET] 			:= d.target;
											vDistr(i).[CFR] 			:= d.cfr;
											vDistr(i).[ANLS] 			:= d.anls;
										end loop;
									/**/
									
									--API 16.01.2020
									/** /
									::[VHO_INTERFACE].[PRX_TMC].distrib_sum(vDistr, plat_doc.[SUM]);	
								
									i := vDistr.first;
									while (i is not null) loop
										if vDistr(i).[SUMM] > 0 then
											if vDistr(i).[CONTROL_LIST] is not null then
													::[VHO_INTERFACE].[PRX_TMC].UU_ADD_REQS_set_(plat_doc, vDistr(i).[CONTROL_LIST], 0, null, vDistr(i).[SUMM], plat_doc.[VALUTA], true);
											else
												--Надо положить в прокси
												::[VHO_INTERFACE].[PRX_TMC].UU_ADD_REQS_set_for_cost
														(
															plat_doc
														,	null
														,	vDistr(i).[TARGET]
														,	vDistr(i).[CFR]
														,	vDistr(i).[ANLS]
														,   plat_doc.[VALUTA]
														,	vDistr(i).[SUMM]
														);
											end if;
										end if;
										i := vDistr.next(i);
									end loop;
									/**/
								end if;
							end if;
						end loop;
					end;
				end if;				
			End If;
		End If;
	End If;

	&debug(' (7)',0)
	WritePublicVar;
	
	If [TRUST_DOCUM_REF] Is Not Null Then -- Если использовалась доверенность


		if P_TRUST_DOC_CLOSE is null Then
			P_TRUST_DOC_CLOSE := nvl(this.[DOC_NAME_REF].[TRUST_DOC_CLOSE],false);
		End If;

		Insert This Into [TRUST_DOCUM_REF].[ACCOMPANY_DOC]; -- Отметим в сопроводительном документе оприходованный материальный документ
		--погасить доверенность
		if nvl(P_TRUST_DOC_CLOSE, false) Then
			::[VHO_INTERFACE].[PRX_TMC].close_dov(This.[TRUST_DOCUM_REF], null);
		End If;
	End If;
	
	If this.[DOC_NAME_REF].[CARS] Then
		-- Создаем операцию прихода в продукте Учет ГСМ
		If V_OPER_CODE = 'РАСХОД' Then
			[GSM_PRIH_OPER](P_DATE,P_PROVE);
		End If;
	End If;

	----------------------------------------------------------------------
	This%State := 'END';          -- Изменим состояние
	[USER_EXEC] := STDLIB.UserId; -- Обработано пользователем
	----------------------------------------------------------------------

	-- создадим вторичку	
	if P_FACTURA_SIGN and P_ESF is null Then	
		/*если вторичка не создалась вместе с первичкой*/
		If V_SIGN_SF_INVOICE and sf_invoice is null Then
			::[VHO_INTERFACE].[PRX_TMC].Create_Lib_Create_Invoice(This%class, This%Id, This%Id, v_date_pay, v_date_usage);
		End If;
		
		::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Close_Prev_Inition(This%class, This%Id, v_date_pay, v_date_usage);
	End If;
	
	V_SIGN_SF_INITION := null;
	V_SIGN_SF_INVOICE := null;	
	
	&debug(' (8)',0)
	WritePublicVar;
	
	-- Расширение для определения специфичных реквизитов после обработки документа --
	-- По умолчанию операция заполняет полный номер мат. счета
	::[HOOK].[VHO_AFTER_WORK_1](this, P_PROVE, P_COURSE,V_DATE_COURSE_CALC);
	
	-- после того, как сформировали закрытие обработаем отсрочку платежа
	if V_OPER_CODE = 'ПРИХОД' then
		this.[WORK_DELAY_PAY];
	end if;		
	
	declare
		lv_canon_val		varchar2(2000);
		doc_name		ref [TMC_DOC_NAME];
	begin
		for l in [LIST_TMC] loop
			lv_canon_val := ::[FP_TUNE].[LIB].set_canons('TMC_GRUP', l.[ACC_MAT_REC].[GRUPPA], '<BP_TMC_PROC>', 'USE_AFPP_SKL');
			doc_name := ::[FP_TUNE].[LIB].get_ref_value (code == 'TMC_DOC_DEF', canon_vals == lv_canon_val);	
			if doc_name is not null and doc_name = this.[DOC_NAME_REF] then
				CreateAffpReval(this,P_DATE);
				exit;
			end if;
		end loop;
	end;
	
	&debug(' (9)',0)
	WritePublicVar;
	
	declare cn integer;
	begin
		cn := 0;
		for docum in V_FOLD.[DOCS_IN_FOLD] loop
			cn := cn+1;
		end loop;
		
		if cn = 0 then
			::[VHO_INTERFACE].[PRX_PL].folder_pay_delete_auto(V_FOLD);
		end if;
	end;
	
	&debug(' (10)',0)
End;
end;
end;
