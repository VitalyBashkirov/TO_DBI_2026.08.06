	NumTbl('9').fval := 'девятое';		NumTbl('9').sval := 'девятого';

	/*-----------------------------Десятки-----------------------------*/
	TenTbl('1').fval := '';				TenTbl('1').sval := 'десятого';
	TenTbl('2').fval := 'двадцать';		TenTbl('2').sval := 'двадцатого';
	TenTbl('3').fval := 'тридцать';		TenTbl('3').sval := 'тридцатого';
	TenTbl('4').fval := 'сорок';		TenTbl('4').sval := 'сорокового';
	TenTbl('5').fval := 'пятьдесят';	TenTbl('5').sval := 'пятидесятого';
	TenTbl('6').fval := 'шестьдесят';	TenTbl('6').sval := 'шестидесятого';
