			--NGA P_DATA:=::[RUNTIME].[FDP].pdat(DATE_TMP_1);
			P_DATA:=::[RUNTIME].[FDP].pdat(P_DATE_ANK);  --NGA
/*
		elsif p_info = 'ДАТА_ОБНОВЛ' then		--Дата обновления
