class LEGAL_161P;

@import_plsql(true)
@name('[ПСБ] Сообщения об операциях ОПОК (Excel)')
batch method PSH_MESS_OPOK_XL is

pragma macro (xl,'[OOXML]::[API_XL]');
pragma macro(lp, '::[SHABLON_DOC].[LIB_OOXML]');
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);

function get_cl
	( op 	ref [LEGAL_161P]
	, typ 	integer
	, w_inn boolean
	, w_sl 	boolean
	) return varchar2(32767) is
mess varchar2(32767);
begin
	for (select plat(plat obj)
		in op.[BLOCK_ARR]
			where plat.[BLOCK_NUM] = typ
				fetch 1
		) 
	loop
		if plat.obj.[TU].[0] = 5 then mess := coalesce(plat.obj.[NAMEU], plat.obj.[FULL_NAME]);
		elsif plat.obj.[TU].[0] = 1 then mess := plat.obj.[FULL_NAME];
		else
			if plat.obj.[NAME_F] is null and plat.obj.[NAME_I] is null and plat.obj.[NAME_O] is null then mess := plat.obj.[FULL_NAME];
			else mess := coalesce(plat.obj.[NAME_F], '') || ' ' || coalesce(plat.obj.[NAME_I], '') || ' ' || coalesce(plat.obj.[NAME_O], '');
			end if;
		end if;
		if w_inn then
			mess := mess || LF$ || ' ИНН ' || plat.obj.[ND];
		end if;
	end loop;
	if w_sl and mess is not null then
		mess := '/' || mess;
	end if;
	return mess;
end;
PSH_MESS_OPOK_XL (
	@name('Ответственный сотрудник')        P_OTV  in [USER_REF],
	@name('Сотрудник выполнивший операцию') P_USER in [USER_REF]
) is

validate is
	idx 		integer;
	i	 		integer;
	li_cur_row	integer;
	date_otpr	date;
	v_code		memo;	
begin
	if P_MESSAGE = 'DEFAULT' then
		P_OTV  := ::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_OTV');
		P_USER := ::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_USER');
	elsif  P_MESSAGE = 'VALIDATE'  then
		if P_INFO = 'OK' then
				if P_OTV is null or P_USER is null then
					pragma error('Необходимо заполнить всех сотрудников');
				end if;
				if not nvl(&xl.open_file(::[SHABLON_DOC]([CODE]= 'PSB_MESS_OPOK_XL').[RPT_TMPL]), False) then
					pragma error('Ошибка открытия шаблона с кодом '||'PSB_MESS_OPOK_XL');
		    	end if;
				&lp.xl_init('PSB_MESS_OPOK_XL');
		    	&xl.open_sheet(1);		    					
				li_cur_row := 2;
				
				-- Формирование отчёта
				idx := this.first;
				while idx is not null loop
					li_cur_row := li_cur_row + 1;
					i:= 1;
					v_code := null;
		
					&xl.put(li_cur_row, i, (li_cur_row - 2));  	i := i + 1;	-- Номер по порядку
					&xl.put(li_cur_row, i, case when this(idx).[VO].[CODE] = '6001' and this(idx).[PRIZ6001] = '1103' then '2'
												else '1'
											end);  				i := i + 1;	-- операция, в отношении которой возникают сомнения
					&xl.put(li_cur_row, i, case when this(idx).[VO].[CODE] = '6001' then '2'
										   end				);		i := i + 1;	-- операция, в отношении которой возникают подозрения
					
					if this(idx).[VO].[CODE] is not null then
						v_code := this(idx).[VO].[CODE] || '/' || this(idx).[VO].[COMMENT];	
					end if;
					
					if this(idx).[DOP_V] is not null then
						for (select op(op.[COMMENT] nam)
								in ::[VID_OPER_PRED]
								where op.[CODE] = this(idx).[DOP_V]
								fetch 1
							) 
						loop
							v_code := v_code || LF$ || 'Доп. код '	|| this(idx).[DOP_V] || '/' || op.nam;
						end loop;
					end if; 

					if this(idx).[PRIZ6001] is not null then
						for (select op(op.[VALUE] nam)
								in ::[P161_UNUSFUL_OPE]
								where op.[CODE] = this(idx).[PRIZ6001]
								fetch 1
							) 
						loop
							v_code := v_code || LF$ || 'Код необычной сделки ' || this(idx).[PRIZ6001] || '/' || op.nam;
						end loop;
					end if; 
					&xl.put(li_cur_row, i, v_code); i := i + 1;	-- код операции/описание кода (Приложение 9 к ПВК)

					&xl.put(li_cur_row, i, this(idx).[PRIM_2]);		i := i + 1;	-- содержание операции
					&xl.put(li_cur_row, i, to_char(this(idx).[DATA], 'DD.MM.YYYY') || '/' || ltrim(to_char(this(idx).[SUMV], '9,999,999,999,990.99')) || ' ' || ::[FT_MONEY]([CUR_ISO].[INT_CUR_CODE] = this(idx).[CURREN]).[CUR_ATTR].[ENTIER]);		i := i + 1;	-- дата, сумма и валюта операции (сделки)

					--&xl.put(li_cur_row, i, get_cl(this(idx), 1, true, false) || get_cl(this(idx), 3, false, true));		i := i + 1;	-- Плательщик
					&xl.put(li_cur_row, i, get_cl(this(idx), case when this(idx).[FORMAT_KIND].[0] = 6 or this(idx).[FORMAT_KIND].[0] = 5 and substr(this(idx).[VER_FORMAT],1,1)!='1' then 1 else 0 end, true, false) 
								        --|| get_cl(this(idx), case when this(idx).[FORMAT_KIND].[0] = 6 or this(idx).[FORMAT_KIND].[0] = 5 and substr(this(idx).[VER_FORMAT],1,1)!='1' then 1 else 0 end, false, true)
					);		i := i + 1;	-- Плательщик
					
					&xl.put(li_cur_row, i, coalesce(this(idx).[BANK_0].[NAME_B], 'ООО "ПРОМСЕЛЬХОЗБАНК"'));		    	i := i + 1;	-- Банк плательщика
					--&xl.put(li_cur_row, i, get_cl(this(idx), 1, true, false) || get_cl(this(idx), 4, false, true));		i := i + 1;	-- Получатель
					&xl.put(li_cur_row, i, get_cl(this(idx), case when this(idx).[FORMAT_KIND].[0] = 6 or this(idx).[FORMAT_KIND].[0] = 5 and substr(this(idx).[VER_FORMAT],1,1)!='1' then 2 when this(idx).[FORMAT_KIND].[0] = 5 then 1 else 3 end, true, false) 
 							 			--|| get_cl(this(idx), case when this(idx).[FORMAT_KIND].[0] = 6 or this(idx).[FORMAT_KIND].[0] = 5 and substr(this(idx).[VER_FORMAT],1,1)!='1' then 2 when this(idx).[FORMAT_KIND].[0] = 5 then 1 else 3 end, false, true)
					);		i := i + 1;	-- Получатель
					
					&xl.put(li_cur_row, i, coalesce(this(idx).[BANK_1].[NAME_B], 'ООО "ПРОМСЕЛЬХОЗБАНК"'));		    	i := i + 2;	-- Банк получателя
					--&xl.put(li_cur_row, i, this(idx).[ADD_USER].[NAME] || '/' || this(idx).[ADD_USER].[CASTA].[VALUE]);	i := i + 1;	-- сотрудник составивший сообщение
					&xl.put(li_cur_row, i, P_USER.[NAME] || '/' || P_USER.[CASTA].[VALUE]);	i := i + 1;	-- сотрудник составивший сообщение
					
					if this(idx).[DOC] is not null then
						for (select dt(dt.[DATE] obj)
								in ::[HISTORY_CHECK]
								where (this(idx).[DOC]%id = dt.[DOCUMENT]%id or this(idx).[DOC]%id = dt.[DOCUM_RC]%id)
									and dt.[VID_OP].[CODE] = this(idx).[VO].[CODE] 
								order by dt.[DATE] desc
							)
						loop
							date_otpr := dt.obj;
							exit;
						end loop;	
					end if;

					&xl.put(li_cur_row, i, to_char(date_otpr, 'DD.MM.YYYY hh24:mi:ss'));		i := i + 1;	-- дата отправки файла
					&xl.put(li_cur_row, i, to_char(coalesce(this(idx).[DATE_P], this(idx).[REG_DATE]), 'DD.MM.YYYY'));		i := i + 1;	-- дата получения Ответственным сотрудником сообщения
					
					&xl.put(li_cur_row, i, 'Операция подлежит обязательному контролю и направлению в Уполномоченный орган. ' || P_OTV.[CASTA].[VALUE] || ' '
										    || P_OTV.[NAME] /*|| ' ' || to_char(this(idx).[DATE_P], 'DD.MM.YYYY')*/);	i := i + 1;	-- запись о решении Ответственного сотрудника Банка
					idx := this.next(idx);
				end loop;

				&xl.Set_Format_Range(1, 1, li_cur_row, &xl.getSheetColCount ,p_borderId==&xl.get_border(p_top=='thin',p_bottom=='thin',p_left=='thin',p_right=='thin'));

				&lp.xl_finish;				
	    end if;
	end if;
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_OTV', P_OTV, 'USER');
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_USER', P_USER, 'USER');
end;

execute is
begin
	null;
end;
end;
end;
