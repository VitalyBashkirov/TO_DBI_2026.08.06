--Башкиров В.Г. 18.01.2019 ПСБ. Автоурегулирование парных счетов при проводке документов по кредитам. По требованию Гривцовой С.В.
vPSB_AUTO_PROCESS:=coalesce(::[FP_TUNE].[LIB].get_bool_value('PSB_AUTO_PROCESS', null, false), false);
&debug('vPSB_AUTO_PROCESS='||vPSB_AUTO_PROCESS||' DOCUMENT='||DOCUMENT%class||'.'||DOCUMENT%id||'.'||DOCUMENT%state||' P_MESS='||P_MESS,dp)
if vPSB_AUTO_PROCESS and DOCUMENT%state='PROV' and P_MESS='END' then
	::[PR_CRED].[PSH_CALC_PAR]('PSB_CR_IFRS_POSTM',DOCUMENT,null,P_ADDS);
end if;

--Башкиров В.Г. 16.02.2019 10166-Операционная касса вне кассового узла "Лидер"
