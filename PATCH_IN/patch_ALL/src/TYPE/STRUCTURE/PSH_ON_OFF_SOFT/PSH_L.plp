'EXP_TRANS_TAO,UFEBS_SBP_ED_AR1,UFEBS_SBP_TR_AR1,UFEBS_SBP_TI_AR1,UFEBS_SBP_LI_AR1,UFEBS_SBP_TR_IN1,UFEBS_SBP_IN_RE1,UFEBS_SBP_TR_RE1,UFEBS_SBP_TI_RE1,UFEBS_SBP_LI_RE1,KF_DATA_REF_ARR,PSH_BOS_KAS__ARR,LIQUIDITY_SBP1  ,TRANS_SBP1';

repl_ShortName string(32767):=
'EXP_TRA      , PSH_UFBS_ED_ARR, PSH_UFBS_TR_ARR, PSH_UFBS_TI_ARR, PSH_UFBS_LI_ARR,  PSH_UFBS_TR_IN, PSH_UFBS_IN_REF, PSH_UFBS_TR_REF, PSH_UFBS_TI_REF, PSH_UFBS_LI_REF,PSH_KF_DATA_ARR,PSH_BOS_KAS_ARR, PSH_LIQUIDITY_SB,PSH_TRANS_SBP';

