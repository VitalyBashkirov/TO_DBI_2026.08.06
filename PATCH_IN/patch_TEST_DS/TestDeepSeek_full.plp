-- Правило 24: v50.PROC.EXECUTE.п.3.3 - Экранирование имён таблиц в execute immediate
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Экранирование имён таблиц в execute immediate
--   Подробное описание: В execute immediate имена таблиц экранировать двойными кавычками: "Z#MY_TABLE".
--   Пример кода для корректировки: execute immediate 'truncate table Z#T'
--   Пример исправленного кода: execute immediate 'truncate table "Z#T"'
--   Теги: dynamic sql, execute, escape
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: В execute immediate имена таблиц экранировать двойными кавычками: "Z#MY_TABLE". Не использовать Oracle-специфичный синтаксис.
--   plplus_materials_note: PostgreSQL требует экранирования имён таблиц в динамическом SQL.
--   search_prompt: Найти вызовы EXECUTE IMMEDIATE. Проверить экранирование имён таблиц.
--   regex_patterns.for_search: \bEXECUTE\s+IMMEDIATE\b
--   code_example_bad: execute immediate 'truncate table Z#T'
--   fix_instruction: Добавить двойные кавычки вокруг имён таблиц: 'truncate table "Z#T"'
--   fix_prompt: Выполни экранирование имён таблиц в EXECUTE IMMEDIATE.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.EXECUTE.п.3.3' с EXECUTE IMMEDIATE.
--   examples.quote.bad: execute immediate 'truncate table Z#T'
--   examples.quote.good: execute immediate 'truncate table "Z#T"'
--   priority: high
--   category: PROC
--   subcategory: PROC.SQL
--   source_files: v50.docx
--   source_sections: п.3.3
-- ============================================================================
PROCEDURE v50_PROC_EXECUTE_p_3_3 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		execute immediate 'truncate table Z#TEMP';
		execute immediate 'select * from Z#CLIENT';
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		execute immediate 'truncate table "Z#TEMP"';
		execute immediate 'select * from "Z#CLIENT"';
	-- end pl/sql
END;

-- ============================================================================
-- Правило 25: v50.PROC.WHENOTHERS.п.3.5 - Добавление ROLLBACK или RAISE в WHEN OTHERS
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Добавление ROLLBACK или RAISE в WHEN OTHERS
--   Подробное описание: В PostgreSQL после ошибки транзакция прерывается. В WHEN OTHERS обязательно делать ROLLBACK (до savepoint) или RAISE.
--   Пример кода для корректировки: exception when others then null;
--   Пример исправленного кода: exception when others then rollback; raise;
--   Теги: exception, rollback, raise
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: В PostgreSQL после ошибки транзакция прерывается. В WHEN OTHERS обязательно делать ROLLBACK (до savepoint) или RAISE.
--   plplus_materials_note: WHEN OTHERS без обработки портит транзакцию в PostgreSQL.
--   search_prompt: Найти блоки WHEN OTHERS без ROLLBACK или RAISE.
--   regex_patterns.for_search: WHEN\s+OTHERS\s+THEN\s+(?!.*?(ROLLBACK|RAISE))
--   code_example_bad: exception when others then null;
--   fix_instruction: Добавить ROLLBACK или RAISE в блок WHEN OTHERS.
--   fix_prompt: Выполни добавление ROLLBACK или RAISE в WHEN OTHERS.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.WHENOTHERS.п.3.5' с WHEN OTHERS.
--   examples.rollback.bad: exception when others then null;
--   examples.rollback.good: exception when others then rollback; raise;
--   priority: high
--   category: PROC
--   subcategory: PROC.EXCEPTIONS
--   source_files: v50.docx
--   source_sections: п.3.5
-- ============================================================================
PROCEDURE v50_PROC_WHENOTHERS_p_3_5 IS
	v_val NUMBER;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		BEGIN
			select 1/0 into v_val from dual;
		EXCEPTION
			when others then
				null;
		END;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		BEGIN
			select 1/0 into v_val from dual;
		EXCEPTION
			when others then
				rollback;
				raise;
		END;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 26: v50.PROC.EXCEPTIONLOOP.п.1.25 - Запрет конструкции exceptionloop
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Запрет конструкции exceptionloop
--   Подробное описание: Конструкция exceptionloop запрещена, так как в PostgreSQL при возникновении исключения в SQL портится вся транзакция.
--   Пример кода для корректировки: exceptionloop
--   Пример исправленного кода: loop
--   Теги: exception, bulk, loop
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Конструкция exceptionloop запрещена, так как в PostgreSQL при возникновении исключения в SQL портится вся транзакция.
--   plplus_materials_note: Exceptionloop несовместим с PostgreSQL.
--   search_prompt: Найти ключевое слово EXCEPTIONLOOP.
--   regex_patterns.for_search: \bEXCEPTIONLOOP\b
--   code_example_bad: exceptionloop
--   fix_instruction: Удалить EXCEPTIONLOOP, переписать логику с использованием обычных циклов и обработки ошибок.
--   fix_prompt: Удали EXCEPTIONLOOP и перепиши логику.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.EXCEPTIONLOOP.п.1.25'.
--   examples.remove.bad: exceptionloop
--   examples.remove.good: loop
--   priority: high
--   category: PROC
--   subcategory: PROC.EXCEPTIONS
--   source_files: v50.docx
--   source_sections: п.1.25
-- ============================================================================
PROCEDURE v50_PROC_EXCEPTIONLOOP_p_1_25 IS
	TYPE t_numbers IS TABLE OF NUMBER INDEX BY BINARY_INTEGER;
	v_arr t_numbers;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		for i in 1..10 exceptionloop
			v_arr(i) := 100 / i;
		end loop;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		for i in 1..10 loop
			begin
				v_arr(i) := 100 / i;
			exception
				when others then
					v_arr(i) := 0;
			end;
		end loop;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 27: v50.PROC.BULK.п.1.28 - Включение batch для bulk операций
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Включение batch для bulk операций
--   Подробное описание: Для массовых операций включить batch через APPLICATION.DBI=1 или pragma hint('jdbc_batch(true)').
--   Пример кода для корректировки: forall i in 1..100
--   Пример исправленного кода: pragma hint('jdbc_batch(true)')
--   Теги: bulk, batch, performance
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Для массовых операций включить batch через APPLICATION.DBI=1 или pragma hint('jdbc_batch(true)').
--   plplus_materials_note: Bulk операции с batch значительно быстрее.
--   search_prompt: Найти конструкции FORALL и BULK COLLECT. Проверить наличие batch.
--   regex_patterns.for_search: \bFORALL\b; \bBULK\s+COLLECT\b
--   code_example_bad: forall i in 1..100
--   fix_instruction: Добавить pragma hint('jdbc_batch(true)') или убедиться, что APPLICATION.DBI=1.
--   fix_prompt: Добавь включение batch для bulk операций.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.BULK.п.1.28' с bulk операциями.
--   examples.hint.bad: forall i in 1..100
--   examples.hint.good: pragma hint('jdbc_batch(true)')
--   priority: medium
--   category: PROC
--   subcategory: PROC.PERFORMANCE
--   source_files: v50.docx
--   source_sections: п.1.28
-- ============================================================================
PROCEDURE v50_PROC_BULK_p_1_28 IS
	TYPE t_numbers IS TABLE OF NUMBER INDEX BY BINARY_INTEGER;
	v_arr t_numbers;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		forall i in 1..100
			insert into t values (v_arr(i));
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		pragma hint('jdbc_batch(true)');
		forall i in 1..100
			insert into t values (v_arr(i));
	-- end pl/sql
END;

