				end loop;

				if result is not null then	
                     date_test:= result.[LIST_DATE];
					 if date_test<=P_DATE_ANK then
					    date_test:= P_DATE_ANK;
					 end if;
				     P_DATA:= 'Проверка по списку подозрительных лиц и организаций '||result.[FILE_NAME]||' от '||to_char(result.[LIST_DATE],ShortFmt)||' г. Дата проверки '||to_char(date_test,ShortFmt)||' г. В списке не значится.';	
				else P_DATA:= ' ';
				end if;*/
				
			elsif p_info = 'ТЕРРОРИЗМ_РЕЗУЛЬТАТ' then temp_data:=null;
				
				/*for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' order by rez.[CHECK_DATE]
				loop
				temp_data:='Проверен '||to_char(rez.[CHECK_DATE],ShortFmt)||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||' результат: '||rez.[CHECK_VAL].[NAME]||';'||CHR(13);
				exit;
				end loop;*/
				
				for rec in [legal_list]
					where rec.[LIST_DATE] < nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK])
					order by rec.[LIST_DATE] --desc
				loop
					temp_data:=Substr('Проверен '||to_char(nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]),ShortFmt)||' по '||rec.[FILE_NAME]||' Нет совпадений со справочником террористов РФ;'||CHR(13)||temp_data,1,temp_data%size);
				exit;
				end loop;
				
				for rec in [legal_list]
					where rec.[LIST_DATE] >= nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]) and rec.[LIST_DATE]<=nvl(cl_info.[CLOSE_DATE],P_DATE_PRINT)
							and rec.[LIST_DATE]<to_date('01.09.2016',ShortFmt)
					order by rec.[LIST_DATE] --desc
				loop
					temp_data:=Substr('Проверен '||to_char(rec.[LIST_DATE],ShortFmt)||' по '||rec.[FILE_NAME]||' Нет совпадений со справочником террористов РФ;'||CHR(13)||temp_data,1,temp_data%size);
				end loop;
				
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016',ShortFmt)
					order by rez.[CHECK_DATE]
				loop
					temp_data:=Substr('Проверен '||to_char(rez.[CHECK_DATE],ShortFmt)||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||' результат: '||rez.[CHECK_VAL].[NAME]||';'||CHR(13)||temp_data,1,temp_data%size);
				end loop;
				
				P_DATA:=trim(temp_data,chr(13));

			elsif p_info = 'ТЕРРОРИЗМ_РЕЗУЛЬТАТ1' then temp_data:=null; -- KAS 07/07/21 Разделил вывод истории результатов проверок на 2 параметра
				
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.01.2019',ShortFmt)
					order by rez.[CHECK_DATE]
				loop
					temp_data:=SubStr('Проверен '||to_char(rez.[CHECK_DATE],ShortFmt)||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||'. '||rez.[CHECK_VAL].[NAME]||';'||CHR(13)||temp_data,1,temp_data%size);
				end loop;
				
				P_DATA:=trim(temp_data,chr(13));			
								
			elsif p_info = 'ТЕРРОРИЗМ_РЕЗУЛЬТАТ2' then temp_data:=null; -- KAS 07/07/21 Разделил вывод истории результатов проверок на 2 параметра
				
				for rec in [legal_list]
					where rec.[LIST_DATE] < nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK])
					order by rec.[LIST_DATE] --desc
				loop
					temp_data:=SubStr('Проверен '||to_char(nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]),ShortFmt)||' по '||rec.[FILE_NAME]||'. Нет совпадений со справочником террористов РФ;'||CHR(13)||temp_data,1,temp_data%size);
					exit;
				end loop;
				
				for rec in [legal_list]
					where rec.[LIST_DATE] >= nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]) and rec.[LIST_DATE]<=nvl(cl_info.[CLOSE_DATE],P_DATE_PRINT) and rec.[LIST_DATE]<to_date('01.09.2016',ShortFmt)
					order by rec.[LIST_DATE]
				loop
					temp_data:=SubStr('Проверен '||to_char(rec.[LIST_DATE],ShortFmt)||' по '||rec.[FILE_NAME]||'. Нет совпадений со справочником террористов РФ;'||CHR(13)||temp_data,1,temp_data%size);
				end loop;
				
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016',ShortFmt) and rez.[CHECK_DATE]<to_date('01.01.2019',ShortFmt)
					order by rez.[CHECK_DATE]
				loop
					temp_data:=SubStr('Проверен '||to_char(rez.[CHECK_DATE],ShortFmt)||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||'. '||rez.[CHECK_VAL].[NAME]||';'||CHR(13)||temp_data,1,temp_data%size);
				end loop;
				
				P_DATA:=trim(temp_data,chr(13));									

			elsif p_info = 'ПЕРЕВОД_НЕРЕЗ' then
	 		--Сведения о переводах клиента нерезидентам
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PLAN_NEREZ');
	 		elsif p_info = 'СЧЕТА_В_БАНКАХ' then
	 		-- Счета в других банках
				for z in client_corp.[ACC_BANK] loop
					temp_str := z.[TYPE].[NAME_ACC] || ' ' || z.[MAIN_V_ID] || ' в ' || z.[BANK].NAME;
					P_DATA := bool_char(P_DATA=' ', P_DATA||temp_str, P_DATA||NL$||temp_str);
				end loop;
  				P_DATA := ltrim(P_DATA, NL$);
  				
  			--Воробей В.А. 04.06.2019
  			--Печать анкеты на дату
  			elsif p_info = 'ДАТА_ПЕЧАТИ' then
			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_PRINT, op_dat)), '');
			
	 		elsif p_info = 'КОДЫ_ФОРМ' then
	 		--Коды форм федерального государственного статистического наблюдения (ОКПО, ОКВЭД, ОКАТО, ОКОГУ)
	 			P_DATA := bool_char(client_corp.[KOD_OKPO] is not null, 'ОКПО: '||client_corp.[KOD_OKPO]||NL$, 'ОКПО: нет сведений'||NL$)||				
	 				GetOKVED(client_corp%id, p_date_print) ||NL$ ||
	 				bool_char(client_corp.[OKATO_CODE] is not null, 'ОКАТО: '||client_corp.[OKATO_CODE]||NL$, 'ОКАТО: нет сведений'||NL$)||
	 				bool_char(client_corp.[OKOGU_CODE] is not null, 'ОКОГУ: '||client_corp.[OKOGU_CODE].[CODE]||NL$, 'ОКОГУ: нет сведений');
--/* Расширение анкеты IDA2506
			elsif p_info = 'ПОЛН_НАИМ_КЛИЕНТА' then   --НАИМ_КЛИЕНТА
			 	P_DATA := client_corp.[LONG_NAME];
			elsif p_info = 'ИН_НАИМ_КЛИЕНТА' then
				P_DATA := client_corp.[I_NAME];
			elsif p_info = 'DOMAIN_WEB' then
				for (select cont(
						cont.[PRIVATE].[VALUE]: 	c_priv,
						cont.[TYPE].[VALUE]:		c_val,
						cont.[NUMB]:				c_numb)
					in client_corp.[CONTACTS]
					where cont.[ACTIV] = true and
						cont.[NUMB] is not null and
						(cont.[TYPE].[CODE] = 'DOMAIN' or cont.[TYPE].[CODE] = 'WEB')
				)
				loop
					P_DATA := P_DATA || cont.c_numb || ', ';
				end loop;
				P_DATA := rtrim(P_DATA, ', ');
			elsif p_info like 'БЕНЕФИЦИАР_ИП%' then
	 			P_DATA := client_priv.[NAME];
			elsif p_info = 'ПРЕДСТАВИТЕЛЬ1' then
				for (select dolg(
						dolg.[RANGE].[VALUE]: 	d_range,
						dolg.[FASE].[NAME]	:	d_name,
					    dolg.[FASE]			:	cl_ref,
					    dolg.[NOTES] 		:	d_notes
					 )
				in client_corp.[ALL_BOSS]	
                where dolg.[FASE] is not null and dolg.[CHIEF]
           	  	)
            	loop
            		P_DATA := dolg.d_name;
            		exit;
				end loop;
			elsif p_info = 'ПРЕДСТАВИТЕЛЬ1_ДОК' then
				for (select dolg(
						dolg.[RANGE].[VALUE]: 	d_range,
						dolg.[FASE].[NAME]	:	d_name,
					    dolg.[FASE]			:	cl_ref,
					    dolg.[NOTES] 		:	d_notes
					 )
				in client_corp.[ALL_BOSS]	
                where dolg.[FASE] is not null and dolg.[CHIEF]
           	  	)
            	loop
            		P_DATA := dolg.d_notes;
            		exit;
				end loop;
			elsif p_info = 'CheckBox181' then --CL_EXT_ANK_ORG_N18
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = client_org_ref
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N18'
 				)
 				loop
 					if x.c_value like '%Расчетно-кассовое обслуживание%' then
 						P_DATA := P_DATA || '1'; end if;
 					if x.c_value like '%Зарплатные проекты%' then
 						P_DATA := P_DATA || '2'; end if;
 					if x.c_value like '%Кредитование%' then
 						P_DATA := P_DATA || '3'; end if;
 					if x.c_value like '%Овердрафт%' then
 						P_DATA := P_DATA || '4'; end if;
 					if x.c_value like '%Банковские гарантии%' then
 						P_DATA := P_DATA || '5'; end if;
 					if x.c_value like '%Депозиты%' then
 						P_DATA := P_DATA || '6'; end if;
 					if x.c_value like '%Внешнеэкономическая деятельность%' then
 						P_DATA := P_DATA || '7'; end if;
 					if x.c_value like '%Прием/выдача наличных денежных средств%' then
 						P_DATA := P_DATA || '8'; end if;
 					if x.c_value like '%Операции с ценными бумагами, с векселями%' then
 						P_DATA := P_DATA || '9'; end if;
				end loop;
			elsif p_info = 'ДРУГОЕ18' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = client_org_ref
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N18'
 				)
				loop
					if x.c_value not like '%Расчетно-кассовое обслуживание%' 
					and x.c_value not like '%Зарплатные проекты%'
					and x.c_value not like '%Кредитование%'
					and x.c_value not like '%Овердрафт%'
					and x.c_value not like '%Банковские гарантии%'
					and x.c_value not like '%Депозиты%'
					and x.c_value not like '%Внешнеэкономическая деятельность%'
					and x.c_value not like '%Прием/выдача наличных денежных средств%'
					and x.c_value not like '%Операции с ценными бумагами, с векселями%' 
					then
 						P_DATA := x.c_value;
