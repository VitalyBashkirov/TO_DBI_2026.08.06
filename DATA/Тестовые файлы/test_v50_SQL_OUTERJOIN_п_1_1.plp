--======================================================================
-- ТЕСТОВЫЙ ФАЙЛ ДЛЯ ПРАВИЛА: v50.SQL.OUTERJOIN.п.1.1
-- Описание: Замена (+) на LEFT/RIGHT JOIN
-- Категория: SQL
-- Подкатегория: SQL.DML.JOINS
-- Приоритет: high
-- Дата генерации: 2026-05-05 15:08:45
--======================================================================

------------------------------------------------------------------------
-- = НЕПРАВИЛЬНЫЙ КОД (ДО ИСПРАВЛЕНИЯ) =
------------------------------------------------------------------------
select * from t1, t2 where t1.id = t2.id(+)

-- Дополнительный пример:
where ac%id = gj.[ACCOUNT](true)

-- Дополнительный пример:
where cr.[LIST_PAY] = fo&collection(true)

------------------------------------------------------------------------
-- = ИНСТРУКЦИЯ ПО ИСПРАВЛЕНИЮ =
------------------------------------------------------------------------
Преобразовать устаревший синтаксис в ANSI SQL:
1. a=b(+) -> LEFT JOIN b ON a=b
2. a(+)=b -> RIGHT JOIN b ON a=b
3. &collection(true) -> LEFT JOIN (::[TABLE] all : alias) ON условие
4. [REF](true) -> удалить (true) и преобразовать в LEFT JOIN

------------------------------------------------------------------------
-- = ДОПОЛНИТЕЛЬНЫЕ ТЕСТЫ (из паттернов) =
------------------------------------------------------------------------

-- Паттерн: Левая часть без (+), правая с (+)
-- Описание: Левая часть без (+), правая с (+)
-- -- Паттерн: (\w+)\.(\w+)\s*=\s*(\w+)\.(\w+)\(\+\)
-- -- Требуется ручное преобразование

-- Паттерн: Левая часть с (+), правая без (+)
-- Описание: Левая часть с (+), правая без (+)
-- -- Паттерн: (\w+)\.(\w+)\(\+\)\s*=\s*(\w+)\.(\w+)
-- -- Требуется ручное преобразование

-- Паттерн: Параметризованное внешнее соединение с коллекцией
-- Описание: Параметризованное внешнее соединение с коллекцией
-- -- Паттерн: &collection\(true\)
-- -- Требуется ручное преобразование

-- Паттерн: Внешнее соединение через реквизит-ссылку с параметром true
-- Описание: Внешнее соединение через реквизит-ссылку с параметром true
-- -- Паттерн: (\w+)\.\[(\w+)\]\(true\)
-- -- Требуется ручное преобразование

-- Паттерн: Строгое соединение через реквизит-ссылку с параметром false
-- Описание: Строгое соединение через реквизит-ссылку с параметром false
-- -- Паттерн: (\w+)\.\[(\w+)\]\(false\)
-- -- Требуется ручное преобразование

-- Паттерн: Внешнее соединение через реквизит-ссылку (без квадратных скобок) с параметром true
-- Описание: Внешнее соединение через реквизит-ссылку (без квадратных скобок) с параметром true
-- -- Паттерн: (\w+)\.(\w+)\(true\)
-- -- Требуется ручное преобразование

