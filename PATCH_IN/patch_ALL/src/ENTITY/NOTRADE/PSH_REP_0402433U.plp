procedure ClearCells( /* очищает содержимое ячеек и сбрасывает рамки */
			  p_tl_row			integer
			/* Строка адреса верхней левой (top left) ячейки диапазона */
			, p_tl_col			integer
			/* Колонка адреса верхней левой (top left) ячейки диапазона */
			, p_br_row			integer
			/* Строка адреса нижней правой (bottom right) ячейки диапазона */
			, p_br_col			integer
			/* Колонка адреса нижней правой (bottom right) ячейки диапазона */
) is
	iBorder		integer;
begin
	iBorder := &xl.get_border
					( p_top		== &xl.xl_b_none
					, p_bottom	== &xl.xl_b_none
					, p_left	== &xl.xl_b_none
					, p_right	== &xl.xl_b_none
					);
	for iy in p_tl_row..p_br_row loop
		for ix in p_tl_col..p_br_col loop
			&xl.cell(iy,  ix, '', p_borderId == iBorder);
		end loop;
	end loop;
end;

function get_Tune_0402433_NUM(pPattId number, pFilial number, pDepart number, pKasse number default null) return string(1024) is
vParam string(1024);
ret_str string(1024);
begin
	&debug('.get_Tune_0402433_NUM -> pPattId='||pPattId||' pFilial='||pFilial||' pDepart='||pDepart||' pKasse='||pKasse, dp)
	vParam := ::[FP_TUNE].[LIB].set_canons(
					'KOP_PATT_0402433', pPattId,
					'BRANCH', 			pFilial,
					'DEPART', 			pDepart,
					'NOTRADE',			pKasse
					);
	ret_str:=::[FP_TUNE].[LIB]. get_str_value('0402433_NUM', vParam, '0');
	&debug('.get_Tune_0402433_NUM -< ret_str='||ret_str, dp)
	return ret_str;
end;

procedure EmptyTune is
idx string;
begin
	idx := ttbl.first;
	while idx is not null
	loop
		ttbl(idx).Tune := null;
		idx := ttbl.next(idx);
	end loop;
end;

procedure GetEmptyTune is
idx string;
begin
	if ttbl.count > 0 then
		EmptyTune;
		return;
	end if;
	
	for(
		select p(p%id : PID, p.[N_KIND] : NUM)
		in		::[KOP_PATT_0402433] all
		order by p.[N_KIND]
	)loop
		idx := p.Num;
		ttbl(idx).PartId := p.PID;
		ttbl(idx).Tune   := null;
	end loop;
end;

function CheckKasse(pKasse ref [NOTRADE]) return boolean is
	idx string;
	vTn	string;
	v_filial	ref [BRANCH] default pKasse.[FILIAL];
	v_depart	ref [DEPART] default pKasse.[DEPART];
begin
	idx := ttbl.first;
	while idx is not null
	loop
		vTn := get_Tune_0402433_NUM(ttbl(idx).PartId, v_filial, v_depart, pKasse);
		if ttbl(idx).Tune is null then
			ttbl(idx).Tune := vTn;
		else
			if ttbl(idx).Tune <> nvl(vTn,'*') then
				return false;
			end if;
		end if;		
		idx	:= ttbl.next(idx);
	end loop;
	
	return true;
end;

procedure AddKasse(pKasse ref [NOTRADE], pKasseList in out string(4000)) is
begin
	if pKasse is null then return; end if;
	if CheckKasse(pKasse) then
		if pKasseList is null then
			pKasseList := pKasse.[NUM_PK];
		else
			if ','||pKasseList||',' not like '%,'||pKasse.[NUM_PK]||',%' then
				if length(pKasseList || ',' || pKasse.[NUM_PK]) > pKasseList%size then
					pragma error('Список касс превышает '|| to_char(pKasseList%size) || ' символов!');
				end if;
				pKasseList := pKasseList || ',' || pKasse.[NUM_PK];
			end if;
		end if;
	else
		stdio.put_line_buf('Настройка [0402433_NUM] для кассы № '||pKasse.[NUM_PK]||' не совпадает с ранее выбранной кассой');
	end if;
end;

function GetCol(pType string, pDeal number) return number is
begin
	if not vFormat then
		if pType = 'DEALNO' then
		  case pDeal of
		    :1:  return 8;
		  	:2:  return 11;
		  	:3:  return 16;
		  	:4:  return 19;
		  	:5:  return 22;
		  	:6:  return 27;
		  	:7:  return 30;
		  	:8:  return 33;
		  	
			:9:	 return 38;
			:10: return 41;
			:11: return 44;
			:12: return 49;
			:13: return 52;
			:14: return 55;
		  end;
		
		elsif pType = 'TBL' then
		  case pDeal of
		    :0:  return 3;
		    :1:  return 6;
		  	:2:  return 9;
		  	:3:  return 14;
		  	:4:  return 17;
		  	:5:  return 20;
		  	:6:  return 25;
		  	:7:  return 28;
		  	:8:  return 31;
		  	
			:9:  return 36;
			:10:  return 39;
			:11:  return 42;
			:12:  return 47;
			:13:  return 50;
			:14:  return 53;
			:15:  return 58;
		  end;
		  	
		elsif pType = 'TMPL' then
			return pDeal;
		end if;
		
		pragma error('GetCol. Передано недопустимое значение pDeal '|| pDeal);
		
	else
		if pType = 'DEALNO' then
		  case pDeal of
		    :1:  return 8;
		  	:2:  return 11;
		  	:3:  return 14;
		  	:4:  return 19;
		  	:5:  return 22;
		  	:6:  return 25;
		  	:7:  return 28;
		  	:8:  return 33;
		  	:9:  return 36;
		  	:10:  return 39;
		  	:11:  return 42;
		  	:12:  return 47;

			:13:  return 50;
			:14:  return 53;
			:15:  return 56;
			:16:  return 61;
			:17:  return 64;
			:18:  return 67;
			:19:  return 70;
			:20:  return 75;
		  end;
		  	
		elsif pType = 'TBL' then
		  case pDeal of
		    :0:  return 3;
		    :1:  return 6;
		  	:2:  return 9;
		  	:3:  return 12;
		  	:4:  return 17;
		  	:5:  return 20;
		  	:6:  return 23;
		  	:7:  return 26;
		  	:8:  return 31;
		  	:9:  return 34;
		  	:10:  return 37;
		  	:11:  return 40;
		  	
			:12: return 45;
			:13: return 48;
			:14: return 51;
			:15: return 54;
			:16: return 59;
			:17: return 62;
			:18: return 65;
			:19: return 68;
		  end;

		elsif pType = 'TMPL' then
			case pDeal of
				:3:	return 4;
				:5:	return 6;
				:6:	return 8;
				:8:	return 11;
				:11:	return 14;
				:12:	return 16;
				:23:	return 29;
				
				:9:	return 12;
				:34:	return 43;
				:45:	return 57;
				
				:0:	return 0;
			end;
		end if;
		
		pragma error('GetCol. Передано недопустимое значение pDeal '|| pDeal);
	end if;

	return 0;
end;

--проверки параметров перед выполнением отчета
procedure CheckBeforeReport(pDATA date, pDEPART ref [DEPART], pSP_KASS string(4000), pN_KIND number, pN_KIND_K number) is
cnt integer;
begin
	if pDATA is null then
		pragma error('Не задана дата отчета');
	end if;

	select p(count(1)) in ::[KOP_PATT_0402433] all
	into cnt;
	
	if vFormat and cnt > 20 then
		pragma error('Общее количество дел ('||cnt||') превышает максимально допустимое значение для альбомной ориентации (20).');
	elsif not vFormat and cnt > 15 then
		pragma error('Общее количество дел ('||cnt||') превышает максимально допустимое значение для книжной ориентации (15).');
	end if;
	--Не найдена настройка для номера дела (сшива) подразделения [Номер подразделения]
	--Номера дел (сшивов) у выбранных касс не одинаковы. Измените список касс
end;

-- заполняет таблицу подразделений по заданному подразделению, либо по филиалу и списку касс
function GetDeparts(pFilial ref [BRANCH], pDepart ref [DEPART], pNumb string(4000)) return DepTbl
is
vTmpTbl	DepTbl;
begin
	vTmpTbl := null;
	if pDepart is not null then
		vTmpTbl%init(pDepart);
		return vTmpTbl;
	end if;

	select	k(distinct k.[DEPART])
	in		::[NOTRADE] all
	where	k.[FILIAL] = pFilial
		and (pNumb is null or  ',' || pNumb || ',' like '%,' || k.[NUM_PK] || ',%')
	into vTmpTbl;

	return vTmpTbl;
end;

--перевод номеров касс в список счетов касс
function ConvertKassaNumber2AccIds(pFilial ref [BRANCH], pDepart ref [DEPART], pNotradeTbl TForIdTable) return TForIdTable
is
vTmpTbl	TForIdTable;
begin
	vTmpTbl := null;
	select	k(k%id)
	in		::[KASSES] all
	where	k.[KASSA].[FILIAL] = pFilial
		and	k.[KASSA].[DEPART] = pDepart
		and exists (select p(1) in pNotradeTbl where k.[KASSA]%id = to_number(p.column_value))
	into vTmpTbl;

	return vTmpTbl;
end;


--перевод номеров касс в список идентификаторов касс
function ConvertKassaNumber2KasseIds(pFilial ref [BRANCH], pDepart ref [DEPART], pNumb string(4000)) return TForIdTable
is
vTmpTbl	TForIdTable;
begin
	vTmpTbl := null;
	select	k(k%id)
	in		::[NOTRADE] all
	where	k.[FILIAL] = pFilial
		and	k.[DEPART] = pDepart
		and ',' || pNumb || ',' like '%,' || k.[NUM_PK] || ',%'
	into vTmpTbl;

	return vTmpTbl;
end;

--перевод кодов видов документа в список идов
function ConvertDocTypeNames2Ids(pNames string(1000)) return string(1000) is
ids string(1000);
begin
	if trim(pNames) is null then
		return null;
	end if;
	
	for(
		select	t(t%id : id)
		in		::[NAME_PAYDOC] all
		where	',' || pNames || ',' like '%,' || t.[CODE] || ',%'
	)loop
		ids := ids || t.id || ';';
	end loop;
	
	return ';' || ids;
end;

function GetPartName(pName string, pHead boolean default true) return string(200) is
	v_result string(200);
begin
	if pHead then
		if pName = 'INC' then
			v_result := 'приходные';
		elsif pName = 'OUT' then
			v_result := 'расходные';
		elsif pName = 'INC_106' then
			v_result := 'по приходу';
		elsif pName = 'OUT_106' then
			v_result := 'по расходу';		
		elsif pName = 'MINC' then
			v_result := 'по дебету';
		elsif pName = 'MOUT' then
			v_result := 'по кредиту';
		elsif pName = 'MINC_108' then
			v_result := 'по дебету';
		elsif pName = 'MOUT_108' then
			v_result := 'по кредиту';
		end if;
	else
		if pName in ('INC', 'OUT') then
			v_result := 'Кассовые документы';
		elsif pName in ('INC_106', 'OUT_106') then
			v_result := 'Кассовые ордера 0401106';		
		elsif pName in ('MINC', 'MOUT') then
			v_result := 'Ордера по передаче ценностей 0402102';
		elsif pName in ('MINC_108', 'MOUT_108') then
			v_result := 'Мемор. ордера 0401108';
		end if;	
	end if;
	&debug(nvl(v_result, 'xxx'), 1)
	return nvl(v_result, 'xxx');
end;

--выборка документов
procedure SelectDocuments(pPartOfReport string, pDealNum number, pDate date, pFilial ref [BRANCH], pDepart ref [DEPART], pDocTypes string(1000), pPattDt string(1000), pPattKt string(1000), pSumAddCond [MEMO], pCntAddCond [MEMO], pNotradeTbl TForIdTable, pKassesTbl TForIdTable) is
vNextDate	date;
cnt			number;
cnt2		number;
sdx			string;

type cur_ref is ref cursor;
v_cur		cur_ref;

pragma macro(el, '(case when exists(select x(1) in VW_RPT_EA_DOCS_LIST_UNI%rowtype where x.id = m) or exists(select x(1) in VW_RPT_HIST_EA%rowtype where x.C_COLLECTION_ID = m.[HISTORY_STATE]) then true else false end)	', substitute);
pragma macro(is_smart_doc, '[1].[DOC_KIND] = ::[DOC_KINDS]([CODE] = ''MULTILINE_DOC'') and exists(select mdoc(mdoc) in ::[MAIN_DOCUM] all where mdoc.[MAIN_SMART] = [1])', substitute);
pragma macro(prov, '(m%state 	= ''PROV'' or m%state = ''WAIT_PROV'' or m%state = ''PAY'' and &is_smart_doc(m))', substitute);

--курсоры------------------------------------------------------------------
---------------------------------------------------------------------------
--по подразделению, сторона дебет
type Curs_Depart_DT is
	select m(
		  m%id										: DOC_ID,
		  m.[VALUTA].[CUR_SHORT]					: DT_VALUTA,
		  m.[VALUTA].[CUR_ISO].[INT_CUR_CODE]		: DT_VAL_ISO,
		  m.[SUM]									: DT_SUMMA,
		  m.[VALUTA_PO].[CUR_SHORT]					: KT_VALUTA,
		  m.[VALUTA_PO].[CUR_ISO].[INT_CUR_CODE]	: KT_VAL_ISO,
		  m.[SUM_PO]								: KT_SUMMA,
		  &el										: DOC_EL,
		  m.[NUM_DT]								: NUM_DT,
		  m.[NUM_KT]								: NUM_KT
		  )
	in		::[MAIN_DOCUM] all
	where	m.[DATE_PROV] 	>= pDate and m.[DATE_PROV] < vNextDate
			and &prov
    		and (m.[FILIAL] = pFilial)
    		and (m.[ACC_DT].[DEPART] = pDepart)
    		and m.[MAIN_SMART] is null
    		and (pDocTypes like '%;' || m.[VID_DOC] || ';%' or pDocTypes is null)
    ;
--по подразделению, сторона кредит
type Curs_Depart_KT is
	select m(
		  m%id										: DOC_ID,
		  m.[VALUTA].[CUR_SHORT]					: DT_VALUTA,
		  m.[VALUTA].[CUR_ISO].[INT_CUR_CODE]		: DT_VAL_ISO,
		  m.[SUM]									: DT_SUMMA,
		  m.[VALUTA_PO].[CUR_SHORT]					: KT_VALUTA,
		  m.[VALUTA_PO].[CUR_ISO].[INT_CUR_CODE]	: KT_VAL_ISO,
		  m.[SUM_PO]								: KT_SUMMA,
		  &el										: DOC_EL,
		  m.[NUM_DT]								: NUM_DT,
		  m.[NUM_KT]								: NUM_KT
		  )
	in		::[MAIN_DOCUM] all
	where	m.[DATE_PROV] 	>= pDate and m.[DATE_PROV] < vNextDate
			and &prov
    		and (m.[FILIAL] = pFilial)
    		and (m.[ACC_KT].[DEPART] = pDepart)
    		and m.[MAIN_SMART] is null
    		and (pDocTypes like '%;' || m.[VID_DOC] || ';%' or pDocTypes is null)
    ;

--по кассе (балансовые)
	--касса по ДТ
type Curs_Kasse_DT is
	select m(
		  m%id										: DOC_ID,
		  m.[VALUTA].[CUR_SHORT]					: DT_VALUTA,
		  m.[VALUTA].[CUR_ISO].[INT_CUR_CODE]		: DT_VAL_ISO,
		  m.[SUM]									: DT_SUMMA,
		  m.[VALUTA_PO].[CUR_SHORT]					: KT_VALUTA,
		  m.[VALUTA_PO].[CUR_ISO].[INT_CUR_CODE]	: KT_VAL_ISO,
		  m.[SUM_PO]								: KT_SUMMA,
		  &el										: DOC_EL,
		  m.[NUM_DT]								: NUM_DT,
		  m.[NUM_KT]								: NUM_KT
		  )
	in		::[MAIN_DOCUM] all
	where	m.[DATE_PROV] 	>= pDate and m.[DATE_PROV] < vNextDate
			and &prov
			and (m.[FILIAL] = pFilial)
			and m.[MAIN_SMART] is null
    		and (pDocTypes like '%;' || m.[VID_DOC] || ';%' or pDocTypes is null)
        	and exists (select p(1) in pKassesTbl where m.[NUM_KS]%id = to_number(p.column_value))-- Дебет
	;

	--касса по КТ
type Curs_Kasse_KT is
	select m(
		  m%id										: DOC_ID,
		  m.[VALUTA].[CUR_SHORT]					: DT_VALUTA,
		  m.[VALUTA].[CUR_ISO].[INT_CUR_CODE]		: DT_VAL_ISO,
		  m.[SUM]									: DT_SUMMA,
		  m.[VALUTA_PO].[CUR_SHORT]					: KT_VALUTA,
		  m.[VALUTA_PO].[CUR_ISO].[INT_CUR_CODE]	: KT_VAL_ISO,
		  m.[SUM_PO]								: KT_SUMMA,
		  &el										: DOC_EL,
		  m.[NUM_DT]								: NUM_DT,
		  m.[NUM_KT]								: NUM_KT
		  )
	in		::[MAIN_DOCUM] all
	where	m.[DATE_PROV] 	>= pDate and m.[DATE_PROV] < vNextDate
			and &prov
			and (m.[FILIAL] = pFilial)
			and m.[MAIN_SMART] is null
    		and (pDocTypes like '%;' || m.[VID_DOC] || ';%' or pDocTypes is null)
        	and exists (select p(1) in pKassesTbl where m.[NUM_KS1]%id = to_number(p.column_value))-- Кредит
	;

--по кассе (внебалансовые)
	--касса по ДТ
type Curs_KasseVneb_DT is
	select m(
		  m%id										: DOC_ID,
		  m.[VALUTA].[CUR_SHORT]					: DT_VALUTA,
		  m.[VALUTA].[CUR_ISO].[INT_CUR_CODE]		: DT_VAL_ISO,
		  m.[SUM]									: DT_SUMMA,
		  m.[VALUTA_PO].[CUR_SHORT]					: KT_VALUTA,
		  m.[VALUTA_PO].[CUR_ISO].[INT_CUR_CODE]	: KT_VAL_ISO,
		  m.[SUM_PO]								: KT_SUMMA,
		  &el										: DOC_EL,
		  m.[NUM_DT]								: NUM_DT,
		  m.[NUM_KT]								: NUM_KT
		  )
	in		::[MAIN_DOCUM] all
	where	m.[DATE_PROV] 	>= pDate and m.[DATE_PROV] < vNextDate
			and (m%state 	= 'PROV' or m%state = 'WAIT_PROV')
			and (m.[FILIAL] = pFilial)
    		and (pDocTypes like '%;' || m.[VID_DOC] || ';%' or pDocTypes is null)
        	and exists (select p(1) in pNotradeTbl where m.[PRODUCT_DT].[ACC_PROD]%id = to_number(p.column_value)) -- Дебет
	;

	--касса по KТ
type Curs_KasseVneb_KT is
	select m(
		  m%id										: DOC_ID,
		  m.[VALUTA].[CUR_SHORT]					: DT_VALUTA,
		  m.[VALUTA].[CUR_ISO].[INT_CUR_CODE]		: DT_VAL_ISO,
		  m.[SUM]									: DT_SUMMA,
		  m.[VALUTA_PO].[CUR_SHORT]					: KT_VALUTA,
		  m.[VALUTA_PO].[CUR_ISO].[INT_CUR_CODE]	: KT_VAL_ISO,
		  m.[SUM_PO]								: KT_SUMMA,
		  &el										: DOC_EL,
		  m.[NUM_DT]								: NUM_DT,
		  m.[NUM_KT]								: NUM_KT
		  )
	in		::[MAIN_DOCUM] all
	where	m.[DATE_PROV] 	>= pDate and m.[DATE_PROV] < vNextDate
			and (m%state 	= 'PROV' or m%state = 'WAIT_PROV')
			and (m.[FILIAL] = pFilial)
    		and (pDocTypes like '%;' || m.[VID_DOC] || ';%' or pDocTypes is null)
        	and exists (select p(1) in pNotradeTbl where m.[PRODUCT_CT].[ACC_PROD]%id = to_number(p.column_value))-- Кредит
	;
----------------------------------------------------------------------------------------

m			Curs_Depart_DT%rowtype;        		
begin
	vNextDate	:= pDate + 1;
	pDocTypes	:= ConvertDocTypeNames2Ids(pDocTypes);
	
	&debug('select.begin', 0)
--касса не задана - выборка по Подразделению+Филиал
	cnt := 0;

	if pNotradeTbl.count <= 0 and pKassesTbl.count <= 0 then
	--выборка по подразделению
		&debug('select.by_depart', 0)
		if pPartOfReport like '%INC%' then
			v_cur.open(Curs_Depart_DT);
		else
			v_cur.open(Curs_Depart_KT);
		end if;
	else
	--выборка по кассам
		if pPartOfReport in ('INC', 'OUT', 'INC_106', 'OUT_106') then
			&debug('select.by_kasse(balance)', 0)
			if pPartOfReport like '%INC%' then
				v_cur.open(Curs_Kasse_DT);
			else
				v_cur.open(Curs_Kasse_KT);
			end if;
		else
			&debug('select.by_kasse(out_balance)', 0)
			if pPartOfReport like '%INC%' then
				v_cur.open(Curs_KasseVneb_DT);
			else
				v_cur.open(Curs_KasseVneb_KT);
			end if;
		end if;	
	end if;
	
	loop
		v_cur.Fetch( m );
		exit when v_cur%notfound;
		if not (fd.Patt2Where(pPattDt, '~' || m.[NUM_DT]) = '1'
    			and
    			fd.Patt2Where(pPattKt, '~' || m.[NUM_KT]) = '1') then
    		continue;			
    	end if;
		
		&debug('doc.id=' || m.DOC_ID, 0)
		
		--для приходов - сумма по Дт
		if pPartOfReport in ('INC', 'INC_106', 'MINC', 'MINC_108') then
			--документы с 0-вой суммой не учитываем
			if nvl(m.DT_SUMMA, 0) = 0 then	
				&debug('dt continue', 0)
				continue;
			end if;
			sdx := nvl(m.DT_Val_ISO,'XXX');
			--рубли идут первыми
			if sdx = ::[FT_MONEY].[NAT_CUR].nat_iso then
				sdx := '000' || sdx;
			end if;
			--сортировка для вывода в отчет
			if pPartOfReport = 'INC' then
				sdx := '100' || '_' || sdx;	--первые в отчете
			elsif pPartOfReport = 'INC_106' then
				sdx := '300' || '_' || sdx;	--третьи в отчете
			elsif pPartOfReport = 'MINC' then
				sdx := '500' || '_' || sdx;	--пятые в отчете
			elsif pPartOfReport = 'MINC_108' then
				sdx := '700' || '_' || sdx;	--седьмые в отчете
			end if;
			dTbl(pDealNum).RepData(sdx).PartOfReport	:= pPartOfReport;
			dTbl(pDealNum).RepData(sdx).DocCurrency		:= m.DT_Valuta;
			
			if nvl(::[CALC_PARAMS].[EXEC_BOOL_EXP](pCntAddCond, m.DOC_ID, null, null), true) then
				if m.DOC_EL then
					dTbl(pDealNum).RepData(sdx).DocElCount	:= nvl(dTbl(pDealNum).RepData(sdx).DocElCount,0) + 1;
				else
					dTbl(pDealNum).RepData(sdx).DocCount	:= nvl(dTbl(pDealNum).RepData(sdx).DocCount,0) + 1;
				end if;
			end if;
			
			if nvl(::[CALC_PARAMS].[EXEC_BOOL_EXP](pSumAddCond, m.DOC_ID, null, null), true) then
				dTbl(pDealNum).RepData(sdx).DocSumm			:= nvl(dTbl(pDealNum).RepData(sdx).DocSumm,0)  + m.DT_SUMMA;
			end if;
			
			&inc(cnt)

		--для расходов - сумма по Кт
		else
			--документы с 0-вой суммой не учитываем
			if nvl(m.KT_SUMMA, 0) = 0 then	
				&debug('kt continue', 0)
				continue;
			end if;
			
			sdx := nvl(m.KT_Val_ISO, 'XXX');
			--рубли идут первыми			
			if sdx = ::[FT_MONEY].[NAT_CUR].nat_iso then
				sdx := '000' || sdx;
			end if;
			--сортировка для вывода в отчет
			if pPartOfReport = 'OUT' then
				sdx := '200' || '_' || sdx;	--вторые в отчете
			elsif pPartOfReport = 'OUT_106' then
				sdx := '400' || '_' || sdx;	--четвертые в отчете
			elsif pPartOfReport = 'MOUT' then
				sdx := '600' || '_' || sdx;	--шестые в отчете
			else
				sdx := '800' || '_' || sdx;	--восьмые (последние) в отчете
			end if;
			dTbl(pDealNum).RepData(sdx).PartOfReport	:= pPartOfReport;
			dTbl(pDealNum).RepData(sdx).DocCurrency		:= m.KT_Valuta;
			
			if nvl(::[CALC_PARAMS].[EXEC_BOOL_EXP](pCntAddCond, m.DOC_ID, null, null), true) then
				if m.DOC_EL then
					dTbl(pDealNum).RepData(sdx).DocElCount	:= nvl(dTbl(pDealNum).RepData(sdx).DocElCount,0) + 1;
				else
					dTbl(pDealNum).RepData(sdx).DocCount	:= nvl(dTbl(pDealNum).RepData(sdx).DocCount,0) + 1;
				end if;
			end if;
			
			if nvl(::[CALC_PARAMS].[EXEC_BOOL_EXP](pSumAddCond, m.DOC_ID, null, null), true) then
				dTbl(pDealNum).RepData(sdx).DocSumm			:= nvl(dTbl(pDealNum).RepData(sdx).DocSumm,0)  + m.KT_SUMMA;
			end if;
			
			&inc(cnt)
		end if;		
		
		if sdx is not null then
			if not idxtbl.exists(sdx) then
				idxtbl(sdx) := sdx;
			end if;
		end if;
	end loop;	

	--подсчет количества валют в группе (строк отчета)
	cnt2 := 0;
	sdx := dTbl(pDealNum).RepData.First;
	while sdx is not null
	loop
		if dTbl(pDealNum).RepData(sdx).PartOfReport = pPartOfReport then
			&inc(cnt2)
		end if;
		sdx := dTbl(pDealNum).RepData.Next(sdx);
	end loop;

	if pPartOfReport = 'INC' then
		dTbl(pDealNum).IncCount := cnt2;
	elsif pPartOfReport = 'INC_106' then
		dTbl(pDealNum).IncCount106 := cnt2;
	elsif pPartOfReport = 'MINC' then
		dTbl(pDealNum).MIncCount := cnt2;
	elsif pPartOfReport = 'MINC_108' then
		dTbl(pDealNum).MIncCount108 := cnt2;
	elsif pPartOfReport = 'OUT' then
		dTbl(pDealNum).OutCount := cnt2;
	elsif pPartOfReport = 'OUT_106' then
		dTbl(pDealNum).OutCount106 := cnt2;
	elsif pPartOfReport = 'MOUT' then
		dTbl(pDealNum).MOutCount := cnt2;
	elsif pPartOfReport = 'MOUT_108' then
		dTbl(pDealNum).MOutCount108 := cnt2;
	end if;
	v_cur.close;
	&debug('select.end = '||cnt,0)
exception when OTHERS then
	v_cur.close;
	raise;
end;

--выборка данных для отчета
procedure GetDataForReport(pDate date, pFilial ref [BRANCH], pDepart ref [DEPART], pKasses string(4000), pPartOfReport number) is

type TMask is record (DocTypes string(1000), PattDt string(1000), PattKt string(1000), SumAddCond [MEMO], CntAddCond [MEMO]);
type tbl_msk is table of TMask index by string;
type TPatt is record (
	Id number,
	Num number,
	Label string(100),
	Income ref [PATT_0402433],
	OutCome ref [PATT_0402433],
	Income106 ref [PATT_0402433],
	OutCome106 ref [PATT_0402433],
	MemIncome ref [PATT_0402433],
	MemOutCome ref [PATT_0402433],
	MemIncome108 ref [PATT_0402433],
	MemOutCome108 ref [PATT_0402433]
);
type tbl_patt is table of TPatt;

mTbl 		tbl_msk;
pTbl 		tbl_patt;
sdx  		string;
idx  		string;
didx  		string;
vSummary	boolean;
pdx			number;
begin
	&debug('*get data begin',0)
	if pKasses is null then
		ttbl.delete;
	end if;
	
	mTbl.delete;
	vSummary := false; --суммировать в сводный сшив из отдельных сшивов
	
	--находим параметры документов для выборки
	--шаблоны счетов
	for(
		select m(	m%id 			: Id,
					m.[CODE_PAYDOC]	: Types,
					m.[MASKA_DT]	: aDt,
					m.[MASKA_KT]	: aKt,
					m.[SUM_ADD_COND] : SumAddCond,
					m.[CNT_ADD_COND] : CntAddCond
				)
		in		::[PATT_0402433] all
	)loop
		sdx := m.Id;
		mtbl(sdx).DocTypes	:= m.Types;
		mtbl(sdx).PattDt	:= replace(m.aDt,' ');
		mtbl(sdx).PattKt	:= replace(m.aKt,' ');
		mtbl(sdx).SumAddCond := m.SumAddCond;
		mtbl(sdx).CntAddCond := m.CntAddCond;
	end loop;
	
	--порядок вывода и периоды
	select p(
		p%id,
		p.[N_KIND],
		p.[STORAGE],
		p.[K_IN],
		p.[K_OUT],
		p.[K_106_IN],
		p.[K_106_OUT],
		p.[M_102_D],
		p.[M_102_K],
		p.[M_IN],
		p.[M_OUT]
	)
	in		::[KOP_PATT_0402433] all
	order by p.[N_KIND]
	into	pTbl;
	
	if nvl(pPartOfReport, 0) = 0 then
		idx := pTbl.First;
		--на 0-м (сводном) сшиве не заданы маски счетов - то надо собрать суммы со всех отдельных сшивов
		if pTbl(idx).Num = 0 and pTbl(idx).Income is null and pTbl(idx).OutCome is null and pTbl(idx).Income106 is null and pTbl(idx).OutCome106 is null and pTbl(idx).MemIncome is null and pTbl(idx).MemOutCome is null and pTbl(idx).MemIncome108 is null and pTbl(idx).MemOutCome108 is null then
			vSummary := true;
			&debug('Для сводного собрать суммы со всех отдельных сшивов!',0)
		end if;
	end if;

	-- BS00163595
	if ::[FP_TUNE].[LIB].get_bool_value('0402433_COUNT') then
		-- включаем сводный сшив в общее кол-во
		AllParts := pTbl.count;
	else
		-- считаем кол-во без сводного
		AllParts := pTbl.count-1;
	end if;	

	&debug('Филиал '|| pFilial.[CODE]||'(id:'||pFilial%id||')', 0)
	vDepartTbl := GetDeparts(pFilial, pDepart, pKasses);
	
	dTbl.Delete;	--основная таблица с данными о документах
	idxtbl.delete;

	-- здесь нужно начать комментарий блока в случае использования SetData
	didx := vDepartTbl.first;
	while didx is not null
	loop
		&debug('Подразделение '|| vDepartTbl(didx).[CODE]||'(id:'||vDepartTbl(didx)%id||')', 0)
		
		--конвертируем Номера касс в Иды для выборки по внебалансовым документам
		vNotradeTbl := ConvertKassaNumber2KasseIds(pFilial, vDepartTbl(didx), pKasses);
			
		--конвертируем Номера касс в Иды счетов касс для выборки по документам
		vKassesTbl := ConvertKassaNumber2AccIds(pFilial, vDepartTbl(didx), vNotradeTbl);

		--поиск документов
		idx := pTbl.First;
		while idx is not null
		loop
			--если задан конкретный сшив - получаем только его
			if pPartOfReport is not null and pPartOfReport <> 0 and pPartOfReport != pTbl(idx).Num then
				idx := pTbl.Next(idx);
				continue;
			end if;
			
			dTbl(pTbl(idx).Num).DealNo 		:= pTbl(idx).Num;
			dTbl(pTbl(idx).Num).Period 		:= pTbl(idx).Label;
			--по подразделению
			if ttbl.Count = 0 then
				dTbl(pTbl(idx).Num).DealNumber := get_Tune_0402433_NUM(pTbl(idx).Id, pFilial, vDepartTbl(didx));
				&debug('Поиск документов по подразделению dTbl(pTbl('||idx||').Num).DealNumber='||dTbl(pTbl(idx).Num).DealNumber, dp)
			else --по кассам
				sdx := pTbl(idx).Num;
				dTbl(pTbl(idx).Num).DealNumber := ttbl(sdx).Tune;
				&debug('Поиск документов по кассам ttbl('||sdx||').Tune='||ttbl(sdx).Tune, dp)
			end if;
	
			&debug('дело № '|| pTbl(idx).Num || ' срок ' || pTbl(idx).Label || ' сшив ' || dTbl(pTbl(idx).Num).DealNumber, 0)
			
			dTbl(pTbl(idx).Num).IncCount    	:= nvl(dTbl(pTbl(idx).Num).IncCount    ,0);
			dTbl(pTbl(idx).Num).OutCount    	:= nvl(dTbl(pTbl(idx).Num).OutCount    ,0);
			dTbl(pTbl(idx).Num).IncCount106 	:= nvl(dTbl(pTbl(idx).Num).IncCount106 ,0);
			dTbl(pTbl(idx).Num).OutCount106 	:= nvl(dTbl(pTbl(idx).Num).OutCount106 ,0);
			dTbl(pTbl(idx).Num).MIncCount   	:= nvl(dTbl(pTbl(idx).Num).MIncCount   ,0);
			dTbl(pTbl(idx).Num).MOutCount   	:= nvl(dTbl(pTbl(idx).Num).MOutCount   ,0);
			dTbl(pTbl(idx).Num).MIncCount108   	:= nvl(dTbl(pTbl(idx).Num).MIncCount108,0);
			dTbl(pTbl(idx).Num).MOutCount108   	:= nvl(dTbl(pTbl(idx).Num).MOutCount108,0);

			--приходы
			if pTbl(idx).Income is not null then
				&debug('	*по приходу', 0)
				sdx := pTbl(idx).Income;
				&debug('	типы ' || mtbl(sdx).DocTypes, 0)
				&debug('	Дт   ' || mtbl(sdx).PattDt, 0)
				&debug('	Кт   ' || mtbl(sdx).PattKt, 0)
				SelectDocuments('INC', pTbl(idx).Num, pDate, pFilial, vDepartTbl(didx), mtbl(sdx).DocTypes, mtbl(sdx).PattDt, mtbl(sdx).PattKt, mtbl(sdx).SumAddCond, mtbl(sdx).CntAddCond, vNotradeTbl, vKassesTbl);
			end if;	
			--расходы	
			if pTbl(idx).Outcome is not null then
				&debug('	*по расходу', 0)
				sdx := pTbl(idx).Outcome;
				&debug('	типы ' || mtbl(sdx).DocTypes, 0)
				&debug('	Дт   ' || mtbl(sdx).PattDt, 0)
				&debug('	Кт   ' || mtbl(sdx).PattKt, 0)
				SelectDocuments('OUT', pTbl(idx).Num, pDate, pFilial, vDepartTbl(didx), mtbl(sdx).DocTypes, mtbl(sdx).PattDt, mtbl(sdx).PattKt, mtbl(sdx).SumAddCond, mtbl(sdx).CntAddCond, vNotradeTbl, vKassesTbl);
			end if;
			--приходы 106
			if pTbl(idx).Income106 is not null then
				&debug('	*по приходу 0401106', 0)
				sdx := pTbl(idx).Income106;
				&debug('	типы ' || mtbl(sdx).DocTypes, 0)
				&debug('	Дт   ' || mtbl(sdx).PattDt, 0)
				&debug('	Кт   ' || mtbl(sdx).PattKt, 0)
				SelectDocuments('INC_106', pTbl(idx).Num, pDate, pFilial, vDepartTbl(didx), mtbl(sdx).DocTypes, mtbl(sdx).PattDt, mtbl(sdx).PattKt, mtbl(sdx).SumAddCond, mtbl(sdx).CntAddCond, vNotradeTbl, vKassesTbl);
			end if;	
			--расходы 106
			if pTbl(idx).Outcome106 is not null then
				&debug('	*по расходу 0401106', 0)
				sdx := pTbl(idx).Outcome106;
				&debug('	типы ' || mtbl(sdx).DocTypes, 0)
				&debug('	Дт   ' || mtbl(sdx).PattDt, 0)
				&debug('	Кт   ' || mtbl(sdx).PattKt, 0)
				SelectDocuments('OUT_106', pTbl(idx).Num, pDate, pFilial, vDepartTbl(didx), mtbl(sdx).DocTypes, mtbl(sdx).PattDt, mtbl(sdx).PattKt, mtbl(sdx).SumAddCond, mtbl(sdx).CntAddCond, vNotradeTbl, vKassesTbl);
			end if;	
			--мемориальные ордера 0402102 по дебету
			if pTbl(idx).MemIncome is not null then
				&debug('	*мемориальные по приходу', 0)
				sdx := pTbl(idx).MemIncome;
				&debug('	типы ' || mtbl(sdx).DocTypes, 0)
				&debug('	Дт   ' || mtbl(sdx).PattDt, 0)
				&debug('	Кт   ' || mtbl(sdx).PattKt, 0)
				SelectDocuments('MINC', pTbl(idx).Num, pDate, pFilial, vDepartTbl(didx), mtbl(sdx).DocTypes, mtbl(sdx).PattDt, mtbl(sdx).PattKt, mtbl(sdx).SumAddCond, mtbl(sdx).CntAddCond, vNotradeTbl, vKassesTbl);
			end if;
			--мемориальные ордера 0402102 по кредиту
			if pTbl(idx).MemOutcome is not null then
				&debug('	*мемориальные по расходу', 0)
				sdx := pTbl(idx).MemOutcome;
				&debug('	типы ' || mtbl(sdx).DocTypes, 0)
				&debug('	Дт   ' || mtbl(sdx).PattDt, 0)
				&debug('	Кт   ' || mtbl(sdx).PattKt, 0)
				SelectDocuments('MOUT', pTbl(idx).Num, pDate, pFilial, vDepartTbl(didx), mtbl(sdx).DocTypes, mtbl(sdx).PattDt, mtbl(sdx).PattKt, mtbl(sdx).SumAddCond, mtbl(sdx).CntAddCond, vNotradeTbl, vKassesTbl);
			end if;
			--мемориальные ордера 0401108 по дебету
			if pTbl(idx).MemIncome108 is not null then
				&debug('	*мемориальные 108 по приходу', 0)
				sdx := pTbl(idx).MemIncome108;
				&debug('	типы ' || mtbl(sdx).DocTypes, 0)
				&debug('	Дт   ' || mtbl(sdx).PattDt, 0)
				&debug('	Кт   ' || mtbl(sdx).PattKt, 0)
				SelectDocuments('MINC_108', pTbl(idx).Num, pDate, pFilial, vDepartTbl(didx), mtbl(sdx).DocTypes, mtbl(sdx).PattDt, mtbl(sdx).PattKt, mtbl(sdx).SumAddCond, mtbl(sdx).CntAddCond, vNotradeTbl, vKassesTbl);
			end if;
			--мемориальные ордера 0401108 по кредиту
			if pTbl(idx).MemOutcome108 is not null then
				&debug('	*мемориальные 108 по расходу', 0)
				sdx := pTbl(idx).MemOutcome108;
				&debug('	типы ' || mtbl(sdx).DocTypes, 0)
				&debug('	Дт   ' || mtbl(sdx).PattDt, 0)
				&debug('	Кт   ' || mtbl(sdx).PattKt, 0)
				SelectDocuments('MOUT_108', pTbl(idx).Num, pDate, pFilial, vDepartTbl(didx), mtbl(sdx).DocTypes, mtbl(sdx).PattDt, mtbl(sdx).PattKt, mtbl(sdx).SumAddCond, mtbl(sdx).CntAddCond, vNotradeTbl, vKassesTbl);
			end if;
			idx := pTbl.Next(idx);

		end loop;
		didx := vDepartTbl.Next(didx);
	end loop;
	--PrintRep;		--при отладке отчёта рекомендуется раскомментировать
	-- здесь нужно закончить комментарий блока при использовании SetData
	--SetData;		--для быстрой отладки отчёта в эту процедуру нужно поместить результат PrintRep и закомментировать находящийся выше цикл
	
	--для сводного собрать суммы со всех отдельных сшивов
	if vSummary then
		idx := pTbl.First;
		while idx is not null
		loop
			pdx := pTbl(idx).Num;
			if pdx <> 0 then
				dTbl(0).IncCount		:= greatest(nvl(dTbl(0).IncCount,0),  dTbl(pdx).IncCount);
				dTbl(0).OutCount		:= greatest(nvl(dTbl(0).OutCount,0),  dTbl(pdx).OutCount);
				dTbl(0).IncCount106		:= greatest(nvl(dTbl(0).IncCount106,0),  dTbl(pdx).IncCount106);
				dTbl(0).OutCount106		:= greatest(nvl(dTbl(0).OutCount106,0),  dTbl(pdx).OutCount106);
				dTbl(0).MIncCount		:= greatest(nvl(dTbl(0).MIncCount,0), dTbl(pdx).MIncCount);
				dTbl(0).MOutCount		:= greatest(nvl(dTbl(0).MOutCount,0), dTbl(pdx).MOutCount);
				dTbl(0).MIncCount108	:= greatest(nvl(dTbl(0).MIncCount108,0), dTbl(pdx).MIncCount108);
				dTbl(0).MOutCount108	:= greatest(nvl(dTbl(0).MOutCount108,0), dTbl(pdx).MOutCount108);
				
				sdx := dTbl(pdx).RepData.First;
				while sdx is not null
				loop
					dTbl(0).RepData(sdx).PartOfReport	:= dTbl(pdx).RepData(sdx).PartOfReport;
					dTbl(0).RepData(sdx).DocCurrency 	:= dTbl(pdx).RepData(sdx).DocCurrency;
					dTbl(0).RepData(sdx).DocCount		:= nvl(dTbl(0).RepData(sdx).DocCount, 0) + nvl(dTbl(pdx).RepData(sdx).DocCount,0);
					dTbl(0).RepData(sdx).DocElCount		:= nvl(dTbl(0).RepData(sdx).DocElCount, 0) + nvl(dTbl(pdx).RepData(sdx).DocElCount,0);
					dTbl(0).RepData(sdx).DocSumm		:= nvl(dTbl(0).RepData(sdx).DocSumm, 0)  + nvl(dTbl(pdx).RepData(sdx).DocSumm,0);
			
					sdx := dTbl(pdx).RepData.Next(sdx);
				end loop;
			end if;
			idx := pTbl.Next(idx);
		end loop;
	end if;
	
	-- выравниваем сводный сшив, если он есть
	if dTbl.exists(0) then
		sdx := idxtbl.first;
		while sdx is not null loop
			if not dTbl(0).RepData.exists(sdx) then
				case substr(sdx, 1, 3) of
					:'100':
						dTbl(0).RepData(sdx).PartOfReport := 'INC';
						dTbl(0).IncCount := nvl(dTbl(0).IncCount, 0) + 1;
					:'200':
						dTbl(0).RepData(sdx).PartOfReport := 'OUT';
						dTbl(0).OutCount := nvl(dTbl(0).OutCount, 0) + 1;
					:'300':
						dTbl(0).RepData(sdx).PartOfReport := 'INC_106';
						dTbl(0).IncCount106 := nvl(dTbl(0).IncCount106, 0) + 1;
					:'400':
						dTbl(0).RepData(sdx).PartOfReport := 'OUT_106';
						dTbl(0).OutCount106 := nvl(dTbl(0).OutCount106, 0) + 1;
					:'500':
						dTbl(0).RepData(sdx).PartOfReport := 'MINC';
						dTbl(0).MIncCount := nvl(dTbl(0).MIncCount, 0) + 1;
					:'600':
						dTbl(0).RepData(sdx).PartOfReport := 'MOUT';
						dTbl(0).MOutCount := nvl(dTbl(0).MOutCount, 0) + 1;
					:'700':
						dTbl(0).RepData(sdx).PartOfReport := 'MINC_108';
						dTbl(0).MIncCount108 := nvl(dTbl(0).MIncCount108, 0) + 1;
					:'800':
						dTbl(0).RepData(sdx).PartOfReport := 'MOUT_108';
						dTbl(0).MOutCount108 := nvl(dTbl(0).MOutCount108, 0) + 1;
				end;
				
				case substr(sdx, 5) of
					:'000643': dTbl(0).RepData(sdx).DocCurrency := 'RUB';
				else
					dTbl(0).RepData(sdx).DocCurrency := ::[FT_MONEY].[LIB].get_money(trim(substr(sdx, 5))).[CUR_SHORT]; 
				end;
				
				dTbl(0).RepData(sdx).DocCount := -1;
			end if;
		
			sdx := idxtbl.next(sdx);
		end loop;
	end if;
	
	--PrintRep;		--при отладке отчёта рекомендуется раскомментировать
	-- здесь нужно закончить комментарий блока при использовании SetData
	--SetData;		--для быстрой отладки отчёта в эту процедуру нужно поместить результат PrintRep и закомментировать находящийся выше цикл	
	
-->>отладка
	&debug('*****************************************************',0)
	idx := dTbl.First;
	while idx is not null
	loop
		&debug('Deal No '||dTbl(idx).DealNo || '. Прих=' ||
		to_char(dTbl(idx).IncCount,'99')|| ', Расх=' ||
		to_char(dTbl(idx).OutCount,'99')|| ', Прих 106=' ||
		to_char(dTbl(idx).IncCount106,'99')|| ', Расх 106=' ||
		to_char(dTbl(idx).OutCount106,'99')|| ', МПрих=' ||
		to_char(dTbl(idx).MIncCount,'99')|| ', МРасх=' ||
		to_char(dTbl(idx).MOutCount,'99')|| ', МПрих 108=' ||
		to_char(dTbl(idx).MIncCount108,'99')|| ', МРасх 108=' ||
		to_char(dTbl(idx).MOutCount108,'99')
		,0)

		sdx := dTbl(idx).RepData.First;
		while sdx is not null
		loop
			&debug(lpad(dTbl(idx).RepData(sdx).PartOfReport,7,' ') || ' | '||to_char(dTbl(idx).RepData(sdx).DocCount,'999999')||'{'||to_char(dTbl(idx).RepData(sdx).DocElCount,'999999')||'}'||' | '||to_char(dTbl(idx).RepData(sdx).DocSumm,'9999999999999990D00')|| ' ' || dTbl(idx).RepData(sdx).DocCurrency,0)
			sdx := dTbl(idx).RepData.Next(sdx);
		end loop;
		
		idx := dTbl.Next(idx);
	end loop;
	&debug('*****************************************************',0)
--<<отладка		
	--pragma error('x');
	mTbl.delete;
	pTbl.delete;	
	&debug('*get data end',0)
	vNotradeTbl.delete;	
	vKassesTbl.delete;
end;

procedure SEW_PutFullHead(pRow number, pBreak boolean default false, pRowCount pls_integer default 4) is
begin
	if pBreak then
		&xl.Ins_Row(pRow, pRowCount);
	else
		&xl.Ins_Row(pRow + 1, pRowCount);
	end if;	

	ClearCells(pRow, 1, pRow, 7);
	&xl.PasteSpecial(16, 2, 16 + pRowCount-1, 7, pRow, 2, pRow + pRowCount-1, 7,null,null,true,true);
	if pBreak then
		&xl.PutPageBreak(pRow-1);
	end if;	
end;

procedure SUM_PutFullHead(pRow number, pDealCount number, pBreak boolean default false, pRowCount pls_integer default 4) is
i number;
c number;
begin
	if pBreak then
		&xl.Ins_Row(pRow, pRowCount + 1);
	else
		&xl.Ins_Row(pRow, pRowCount);
	end if;
	
	ClearCells(pRow, 1, pRow + pRowCount, GetCol('TBL', pDealCount-1)+2);	

	&xl.Merge(pRow, 1, pRow+2, 2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
	&xl.Merge(pRow+3, 1, pRow+3, 2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
	&xl.PasteSpecial(17, 1, 17 + pRowCount, 70, pRow, 1, pRow + pRowCount, 70,null,null,true,true);
	&xl.set_row_height(&xl.get_row_height(17), pRow);
	&xl.set_row_height(&xl.get_row_height(19), pRow+2);

	i := 1;
	loop
		c := GetCol('TBL', i);
		&xl.Allign(pRow + 1, c + 2, pRow + 1, c + 2, 'LM');
		
		&inc(i)
		exit when i >= pDealCount;
	end loop;

	if pBreak then
		&xl.PutPageBreak(pRow-1);
	end if;	
end;

--формирование строк и колонок перед печатью цифр
function SEW_ExpandRowsForOneGroup(pPart string, WRow number, pRowCount number) return number is
row		number;
begin
	row		:= 0;
	if pPart in ('INC_106', 'MINC', 'MINC_108') then
		&inc(wRow)
	end if;		
--в шаблоне(xlt) для каждого раздела(приход/расход) есть 2 строки под суммы(валюты)
	--если записей(валют) нет то рисуем прочерки в отчете
	if pRowCount = 0 then
		&xl.Delete_Row(wRow);	
		&xl.Merge(wRow, 4, wRow, 5, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
		&xl.Merge(wRow, 6, wRow, 7, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
		&xl.Put(wRow, 2, GetPartName(pPart));
		-- Кассовые ордера 0401106, расход: вместо "-" печатаем "X"
		if pPart = 'OUT_106' then
			&xl.Put(wRow, 4, 'X');
		else
			&xl.Put(wRow, 4, '-');
		end if;
		&xl.Put(wRow, 6, '-');
		&xl.Allign(wRow, 6, wRow, 7, 'CM');
		return wRow + 1;
	--одну строку (из 2х) удалить
	elsif pRowCount = 1 then
		&xl.Delete_Row(wRow);
		&xl.Merge(wRow, 4, wRow, 5, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
		&xl.Merge(wRow, 6, wRow, 7, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
		&xl.Put(wRow, 2, GetPartName(pPart));
	--добавить недостающие строки
	elsif pRowCount > 2 then	
		row := 2;
		loop
			&xl.Ins_Row(wRow + 1, 1, p_is_styles == true);
			&xl.Merge(wRow + 1, 4, wRow + 1, 5, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
			&xl.Merge(wRow + 1, 6, wRow + 1, 7, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
			&inc(row)
			exit when row >= pRowCount;
		end loop;
	end if;
	
	return wRow + pRowCount;
end;

function GetRecords(pPart string, pDeal number) return number is
begin
	if pPart = 'INC' then
		return dTbl(pDeal).IncCount;
	elsif pPart = 'OUT' then
		return dTbl(pDeal).OutCount;
	elsif pPart = 'INC_106' then
		return dTbl(pDeal).IncCount106;
	elsif pPart = 'OUT_106' then
		return dTbl(pDeal).OutCount106;				
	elsif pPart = 'MINC' then
		return dTbl(pDeal).MIncCount;
	elsif pPart = 'MOUT' then
		return dTbl(pDeal).MOutCount;		
	elsif pPart = 'MINC_108' then
		return dTbl(pDeal).MIncCount108;
	elsif pPart = 'MOUT_108' then
		return dTbl(pDeal).MOutCount108;
	end if;		
	return 0;
end;

--печать в Эксель одной части(например приходы) для отдельного сшива
function SEW_PrintOnePart(pPart string(10), pStartRow number, pDeal number, pSplitPage boolean default true) return number is
sdx		string;
delta	number;
SaveRow number;
nRows	number;
sSum	string;
sQty	string;
begin	
	SaveRow := pStartRow;
	delta	:= 0;
	if GetRecords(pPart, pDeal) = 0 then
		delta := 1;
	end if;
	
	&debug('print sew || ' || pPart,0)	
	
	sdx := dTbl(pDeal).RepData.First;
	while sdx is not null
	loop
		if dTbl(pDeal).RepData(sdx).PartOfReport != pPart then
			sdx := dTbl(pDeal).RepData.Next(sdx);
			continue;
		end if;
		
		sSum := trim(to_char(NVL(dTbl(pDeal).RepData(sdx).DocSumm, 0),  cnSumFormat, 'NLS_NUMERIC_CHARACTERS = ''- '' ')) || ' ' ||dTbl(pDeal).RepData(sdx).DocCurrency;
		
		--достигли конца страницы - копируем шапку
		if pSplitPage and ((pStartRow in (vPage1_sew, vPage2_sew, vPage3_sew, vPage4_sew, vPage5_sew, vPage6_sew))
							or
							-- если на начало новой страницы выпадает заголовок раздела
							(pStartRow in (vPage1_sew+1, vPage2_sew+1, vPage3_sew+1, vPage4_sew+1, vPage5_sew+1, vPage6_sew+1)))		
		then
			nRows := GetRecords(pPart, pDeal);

			if pStartRow > SaveRow then
				&xl.Merge(SaveRow, 2, pStartRow-1, 3, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
			end if;
	
			if (pStartRow in (vPage1_sew+1, vPage2_sew+1, vPage3_sew+1, vPage4_sew+1, vPage5_sew+1, vPage6_sew+1))then
			--разбиваем подпись к группе на 2 (текущий лист и следующий)
				SEW_PutFullHead(pStartRow-1, true, 3);--шапка на новой странице			
				
				pStartRow := pStartRow + 3;
			else	
			--разбиваем подпись к группе на 2 (текущий лист и следующий)
				SEW_PutFullHead(pStartRow, true);--шапка на новой странице
				
				pStartRow := pStartRow + 4;
		
				if pPart in ('INC_106', 'OUT_106') then
					&xl.Put(pStartRow-1, 2, 'Кассовые ордера 0401106');
				elsif pPart in ('MINC', 'MOUT') then
					&xl.Put(pStartRow-1, 2, 'Ордера по передаче ценностей 0402102');
				elsif pPart in ('MINC_108', 'MOUT_108') then
					&xl.Put(pStartRow-1, 2, 'Мемор. ордера 0401108');
				end if;
		
				-- посчитаем, сколько строк данного раздела осталось напечатать
				var tdx string;
				var i pls_integer;
				tdx := sdx;
				i := 0;
				while tdx is not null loop
					if dTbl(pDeal).RepData(tdx).PartOfReport = pPart then
						&inc(i)
					end if;
					
					tdx := dTbl(pDeal).RepData.next(tdx);
				end loop;
		
				&xl.Merge(pStartRow, 2, pStartRow + i - 1, 3, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);			
			
	
				&xl.Put(pStartRow, 2, GetPartName(pPart));
			end if;
			
			pSplitPage := false;
		end if;

		sQty := trim(to_char(nvl(dTbl(pDeal).RepData(sdx).DocCount, 0), cnQtyFormat)) || '(' || trim(to_char(nvl(dTbl(pDeal).RepData(sdx).DocElCount, 0), cnQtyFormat)) || ')';

		&debug('pDeal='||pDeal,0)
		&debug('pStartRow='||pStartRow,0)
		&debug('sQty='||sQty,0)

		if pPart = 'OUT_106' then
			&xl.Put(pStartRow, 4, 'X');
		else		
			&xl.Put(pStartRow, 4, sQty);
		end if;
		&xl.Put(pStartRow, 6, sSum);
		&inc(pStartRow)

		sdx := dTbl(pDeal).RepData.Next(sdx);
	end loop;
	
	return pStartRow + delta;
end;

--формирование строк и колонок перед печатью цифр
function SUM_ExpandRowsForOneGroup(pPart string, WRow number, pRowCount number) return number is
row		number;
begin
	row		:= 0;
	--в шаблоне(xlt) для каждого раздела(приход/расход) есть 2 строки под суммы(валюты)
	--если записей(валют) нет то рисуем прочерки в отчете
	
	if pPart in ('INC_106', 'MINC', 'MINC_108') then
		&inc(wRow)
	end if;	

	&debug('expand', 0)
	&debug('pPart='||pPart, 0)
	&debug('pRowCount='||pRowCount, 0)
	&debug('wRow='||wRow, 0)
	
	if pRowCount = 0 then
		&xl.Delete_Row(wRow);	
		&xl.Put(wRow, 1, GetPartName(pPart));
		--общий
		if pPart = 'OUT_106' then
			&xl.Put(wRow, 3, 'X');
		else
			&xl.Put(wRow, 3, '-');
		end if;			
		&xl.Merge(wRow, 4, wRow, 5, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
		&xl.Put(wRow, 4, '-');
		&xl.Allign(wRow, 4, wRow, 5, 'CM');
		--для сшива
		if pPart = 'OUT_106' then
			&xl.Put(wRow, 6, 'X');
		else
			&xl.Put(wRow, 6, '-');
		end if;			
		&xl.Merge(wRow, 7, wRow, 8, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
		&xl.Put(wRow, 7, '-');
		&xl.Allign(wRow, 7, wRow, 8, 'CM');
		return wRow + 1;			
	--одну строку (из 2х) удалить для разделов Приходные и Расходные, для мемориальных - объединяем
	elsif pRowCount = 1 then
		&xl.Delete_Row(wRow);
		&xl.Put(wRow, 1, GetPartName(pPart));
	--добавить недостающие строки
	elsif pRowCount > 2 then	

		row := 2;
		loop
			&xl.Ins_Row(wRow + 1, 1, p_is_styles == true);
			--общий
			&xl.Merge(wRow + 1, 4, wRow + 1, 5, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
			if pPart = 'OUT_106' then
				&xl.Put(wRow, 3, 'X');
			else
				&xl.Put(wRow, 3, '-');
			end if;			
			&xl.Put(wRow+1, 4, '-');
			&xl.Allign(wRow, 4, wRow, 4, 'CM');
			--для сшива
			&xl.Merge(wRow + 1, 7, wRow + 1, 8, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
			if pPart = 'OUT_106' then
				&xl.Put(wRow+1, 6, 'X');
			else
				&xl.Put(wRow+1, 6, '-');
			end if;						
			
			&xl.Put(wRow+1, 7, '-');
			&xl.Allign(wRow, 7, wRow, 7, 'CM');
			&inc(row)
			exit when row >= pRowCount;
		end loop;
	end if;

	return wRow + pRowCount;
end;

--печать в Эксель одной части(например приходы) для сводного сшива
function SUM_PrintOnePart(pPart string(10), pStartRow number, pDeal number, pAllParts number, pSplitPage boolean default true, pStartCol number default null) return number is

	-- тут ищем строчку с валютой в сшиве, который печатаем
	function get_line(tab in out TRepData, val varchar2) return varchar2
	is
	k string;
	begin
		k := tab(pDeal).RepData.first;
		while k is not null loop
			if tab(pDeal).RepData(k).DocCurrency = val and tab(pDeal).RepData(k).PartOfReport = pPart then
				return k;
			end if;
			
			k := tab(pDeal).RepData.next(k);
		end loop;
		
		return null;
	end;

sdx		string;
SaveRow number;
nRows	number;
sQty	string;
sSum	string;
nCol	number;
pQueue	integer;
NextRow	integer;
mdx     string;
begin	
	SaveRow := pStartRow;
		
	pQueue := 1;
	NextRow := pStartRow;
	-- всегда идем по строкам сводного сшива для сохранения порядка валют
	-- ищем строку с валютой в печатаемом сшиве
	-- если не нашли, пропускаем и инкрементируем кол-во строк, чтобы была пустая строка на месте отсутствующей валюты
		
	if pStartCol is null then
		nCol := GetCol('TBL',dTbl(pDeal).DealNo);
	else
		nCol := pStartCol;
	end if;

	&debug('print sum || ' || pPart,0)
	&debug('start || ' || pStartRow,0)
		
	sdx := dTbl(0).RepData.First;
	while sdx is not null
	loop
		if dTbl(0).RepData(sdx).PartOfReport != pPart then
			sdx := dTbl(0).RepData.Next(sdx);
			continue;
		end if;
		
		if pDeal = 0 then
			-- тут искать не надо, и так печатаем сводный сшив
			mdx := sdx;
		else
			mdx := get_line(dTbl, dTbl(0).RepData(sdx).DocCurrency);
			if mdx is null then
				&inc(pStartRow)
				sdx := dTbl(0).RepData.Next(sdx);
				continue;
			end if;
			pStartRow := nvl(dTbl(0).RepData(sdx).Row, pStartRow);
		end if;
		
		sQty	:= null;
		sSum 	:= null;
		if dTbl(pDeal).RepData(mdx).DocCount = -1 then
			dTbl(pDeal).RepData(mdx).DocCount := null;
		end if;		
		if dTbl(pDeal).RepData(mdx).DocCount is not null or dTbl(pDeal).RepData(mdx).DocElCount is not null then
			sQty := trim(to_char(nvl(dTbl(pDeal).RepData(mdx).DocCount, 0), cnQtyFormat)) || '(' || trim(to_char(nvl(dTbl(pDeal).RepData(mdx).DocElCount, 0), cnQtyFormat)) || ')';
		end if;
		if dTbl(pDeal).RepData(mdx).DocSumm is not null then
-- PSB -- Добавлено полное наименование валюты
		--	sSum := trim(to_char(dTbl(pDeal).RepData(mdx).DocSumm,  cnSumFormat, 'NLS_NUMERIC_CHARACTERS = ''- '' ')) || ' ' ||dTbl(pDeal).RepData(mdx).DocCurrency;
			sSum := trim(to_char(dTbl(pDeal).RepData(mdx).DocSumm,  cnSumFormat, 'NLS_NUMERIC_CHARACTERS = ''- '' ')) ||  NL$   ||::[FT_MONEY]([CUR_SHORT]= dTbl(pDeal).RepData(mdx).DocCurrency).[NAME];
			--debug_pipe('sSum='||sSum,0);
-- PSB	
		end if;

		--достигли конца страницы - копируем шапкy
		if pSplitPage and ((pStartRow = vPage1 or pStartRow = vPage2 or pStartRow = vPage3 or pStartRow = vPage4 or pStartRow = vPage5)
							or
							-- если на начало новой страницы выпадает заголовок раздела
							(pStartRow = vPage1+1 or pStartRow = vPage2+1 or pStartRow = vPage3+1 or pStartRow = vPage4+1 or pStartRow = vPage5+1)
							or
							--
								(
										(pStartRow = vPage1-1 or pStartRow = vPage2-1 or pStartRow = vPage3-1 or pStartRow = vPage4-1 or pStartRow = vPage5-1)
									and ((pPart = 'MINC' and dTbl(pDeal).MIncCount = 0) or  (pPart = 'MOUT' and dTbl(pDeal).MOutCount = 0))
								)
							)
		then
			if pDeal = 0 then--сводная
				nRows := GetRecords(pPart, pDeal);
				--разбиваем подпись к группе на 2 (текущий лист и следующий)

				if pStartRow > SaveRow then
					&xl.Merge(SaveRow, 1, pStartRow-1, 2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					
					if dTbl.count > GetCol('TMPL', 3) then
						&xl.Merge(SaveRow, GetCol('TBL', GetCol('TMPL', 3))-2, pStartRow-1, GetCol('TBL', GetCol('TMPL', 3))-1, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					end if;
					
					if dTbl.count > GetCol('TMPL', 6) then
						&xl.Merge(SaveRow, GetCol('TBL', GetCol('TMPL', 6))-2, pStartRow-1, GetCol('TBL', GetCol('TMPL', 6))-1, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					end if;					

					if dTbl.count > GetCol('TMPL', 9) then
						&xl.Merge(SaveRow, GetCol('TBL', GetCol('TMPL', 9))-2, pStartRow-1, GetCol('TBL', GetCol('TMPL', 9))-1, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					end if;					
				end if;
				if (pStartRow = vPage1+1 or pStartRow = vPage2+1 or pStartRow = vPage3+1 or pStartRow = vPage4+1 or pStartRow = vPage5+1) then
					SUM_PutFullHead(pStartRow-1, pAllParts, true, 3);--шапка на новой странице
					
					pStartRow := pStartRow + 4;
				elsif (	(pStartRow = vPage1-1 or pStartRow = vPage2-1 or pStartRow = vPage3-1 or pStartRow = vPage4-1 or pStartRow = vPage5-1)
						and
						((pPart = 'MINC' and dTbl(pDeal).MIncCount = 0) or  (pPart = 'MOUT' and dTbl(pDeal).MOutCount = 0))
					) then
					SUM_PutFullHead(pStartRow-1, pAllParts, true, 3);--шапка на новой странице
					
					pStartRow := pStartRow + 4;
				else				
					SUM_PutFullHead(pStartRow, pAllParts, true);--шапка на новой странице
					
					pStartRow := pStartRow + 5;
	
					-- посчитаем, сколько строк данного раздела осталось напечатать
					var tdx string;
					var i pls_integer;
					tdx := sdx;
					i := 0;
					while tdx is not null loop
						if dTbl(0).RepData(tdx).PartOfReport = pPart then
							&inc(i)
						end if;
						
						tdx := dTbl(0).RepData.next(tdx);
					end loop;
	
					&xl.Merge(pStartRow, 1, pStartRow + i - 1, 2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					&xl.Put(pStartRow, 1, GetPartName(pPart));

					if pPart in ('INC_106', 'OUT_106') then
						&xl.Put(pStartRow-1, 1, 'Кассовые ордера 0401106');
					elsif pPart in ('MINC', 'MOUT') then
						&xl.Put(pStartRow-1, 1, 'Ордера по передаче ценностей 0402102');
					elsif pPart in ('MINC_108', 'MOUT_108') then
						&xl.Put(pStartRow-1, 1, 'Мемор. ордера 0401108');
					end if;

					if dTbl.count > GetCol('TMPL', 3) then
						&xl.Merge(pStartRow, GetCol('TBL', GetCol('TMPL', 3))-2, pStartRow + i - 1, GetCol('TBL', GetCol('TMPL', 3))-1, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
						&xl.Put(pStartRow, GetCol('TBL', GetCol('TMPL', 3))-2, GetPartName(pPart));

						if pPart in ('INC_106', 'OUT_106') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 3))-2, 'Кассовые ордера 0401106');
						elsif pPart in ('MINC', 'MOUT') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 3))-2, 'Ордера по передаче ценностей 0402102');
						elsif pPart in ('MINC_108', 'MOUT_108') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 3))-2, 'Мемор. ордера 0401108');
						end if;						
					end if;
					
					if dTbl.count > GetCol('TMPL', 6) then
						&xl.Merge(pStartRow, GetCol('TBL', GetCol('TMPL', 6))-2, pStartRow + i - 1, GetCol('TBL', GetCol('TMPL', 6))-1, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
						&xl.Put(pStartRow, GetCol('TBL', GetCol('TMPL', 6))-2, GetPartName(pPart));
						
						if pPart in ('INC_106', 'OUT_106') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 6))-2, 'Кассовые ордера 0401106');
						elsif pPart in ('MINC', 'MOUT') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 6))-2, 'Ордера по передаче ценностей 0402102');
						elsif pPart in ('MINC_108', 'MOUT_108') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 6))-2, 'Мемор. ордера 0401108');
						end if;						
					end if;							

					if dTbl.count > GetCol('TMPL', 9) then
						&xl.Merge(pStartRow, GetCol('TBL', GetCol('TMPL', 9))-2, pStartRow + i - 1, GetCol('TBL', GetCol('TMPL', 9))-1, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
						&xl.Put(pStartRow, GetCol('TBL', GetCol('TMPL', 9))-2, GetPartName(pPart));
						
						if pPart in ('INC_106', 'OUT_106') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 9))-2, 'Кассовые ордера 0401106');
						elsif pPart in ('MINC', 'MOUT') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 9))-2, 'Ордера по передаче ценностей 0402102');
						elsif pPart in ('MINC_108', 'MOUT_108') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 9))-2, 'Мемор. ордера 0401108');
						end if;						
					end if;

					if dTbl.count > GetCol('TMPL', 12) then
						&xl.Merge(pStartRow, GetCol('TBL', GetCol('TMPL', 12))-2, pStartRow + i - 1, GetCol('TBL', GetCol('TMPL', 12))-1, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
						&xl.Put(pStartRow, GetCol('TBL', GetCol('TMPL', 12))-2, GetPartName(pPart));
						
						if pPart in ('INC_106', 'OUT_106') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 12))-2, 'Кассовые ордера 0401106');
						elsif pPart in ('MINC', 'MOUT') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 12))-2, 'Ордера по передаче ценностей 0402102');
						elsif pPart in ('MINC_108', 'MOUT_108') then
							&xl.Put(pStartRow-1, GetCol('TBL', GetCol('TMPL', 12))-2, 'Мемор. ордера 0401108');
						end if;						
					end if;

				end if;
				
			else
				if pStartRow = vPage1+1 or pStartRow = vPage2+1 or pStartRow = vPage3+1 or pStartRow = vPage4+1 or pStartRow = vPage5+1 then
					pStartRow := pStartRow + 4;
				else
					pStartRow := pStartRow + 5;
				end if;
			end if;
			
			pSplitPage := false;
		end if;

		&debug('pDeal='||pDeal,0)
		&debug('pStartRow='||pStartRow,0)
		&debug('nCol='||nCol,0)
		&debug('sQty='||sQty,0)

		if pPart = 'OUT_106' then
			&xl.Put(pStartRow, nCol, 'X');
		else						
			if sQty is null then
				&xl.Put(pStartRow, nCol,'-');
				&xl.Allign(pStartRow, nCol, pStartRow, nCol, 'CM');
			else
				&xl.Put(pStartRow, nCol, sQty);
			end if;
		end if;

		if sSum is null then
			&xl.Put(pStartRow, nCol+1,'-');
			&xl.Allign(pStartRow, nCol+1, pStartRow, nCol+1, 'CM');
		else
-- PSB Добавлено для переноса строки из-за полного наименования валюты
			--&xl.Put(pStartRow, nCol+1, sSum); -- CFT
			&xl.cell_v_data(pStartRow, nCol+1, sSum,p_wrapText=='true');
			&xl.Allign(pStartRow, nCol+1, pStartRow, nCol+1, 'RM'); -- CFT
			&xl.set_row_height(24,pStartRow);
-- PSB
		end if;

		if pDeal = 0 then
			dTbl(0).RepData(sdx).Row := pStartRow;
		end if;

		&inc(pStartRow)

		
		sdx := dTbl(0).RepData.Next(sdx);
	end loop;
	
	&debug('return || ' || pStartRow,0)	
	
	return pStartRow;
end;

--печать данных отчета в эксель
procedure PostData(pPartOfReport number, pDepart ref [DEPART], pDate date, pUser1 ref [USER], pUser2 ref [USER], p_kassa ref [NOTRADE]) is
BankName	string(1000);
RepName	string(1000);
idx			number;
sList		string;
nRow		number;
---
vInc		number;
vOut		number;
vInc106		number;
vOut106		number;
vMInc		number;
vMOut		number;
vMInc108	number;
vMOut108	number;
--
prev_Nrow	integer;
vEndRow number := 0;

		procedure SEW_PreparePageForPrint(pDeal number) is
		wRow	number;
		begin
			wRow := glStartRow_SEW;
			vInc  = wRow := SEW_ExpandRowsForOneGroup('INC',  wRow, dTbl(pDeal).IncCount);
			vOut  = wRow := SEW_ExpandRowsForOneGroup('OUT',  wRow, dTbl(pDeal).OutCount);
			vInc106  = wRow := SEW_ExpandRowsForOneGroup('INC_106',  wRow, dTbl(pDeal).IncCount106);
			vOut106  = wRow := SEW_ExpandRowsForOneGroup('OUT_106',  wRow, dTbl(pDeal).OutCount106);
			vMInc = wRow := SEW_ExpandRowsForOneGroup('MINC', wRow, dTbl(pDeal).MIncCount);
			vMOut = wRow := SEW_ExpandRowsForOneGroup('MOUT', wRow, dTbl(pDeal).MOutCount);
			vMInc108 = wRow := SEW_ExpandRowsForOneGroup('MINC_108', wRow, dTbl(pDeal).MIncCount108);
			vMOut108 = wRow := SEW_ExpandRowsForOneGroup('MOUT_108', wRow, dTbl(pDeal).MOutCount108);
			
			declare
				iBorder		integer;
			begin
				iBorder := &xl.get_border
							( p_top		== &xl.xl_b_thin
							, p_bottom	== &xl.xl_b_thin
							, p_left	== &xl.xl_b_thin
							, p_right	== &xl.xl_b_thin
							);
				&xl.Set_Format_Range(16, 2,vMOut108-1, 7, p_borderId == iBorder);
			end;			
			
			&debug('IRow='||vInc||
					', ORow='||vOut||
					', IRow106='||vInc106||
					', ORow106='||vOut106||
					', MIRow='||vMInc||
					', MORow='||vMOut||
					', MIRow108='||vMInc108||
					', MORow108='||vMOut108,0
			)
		end;

		procedure SUMM_PreparePageForPrint(pDeal number) is
		wRow	number;
		ci		number;
		bt		number;
		dlt		number:=-2;
		dlt2		number:=0;
		SplitPage boolean;
		vDealNum number;
		gc12temp number;
		begin
			-- Забиваем пустами значениями отсутствующие валюты в сшивах
			declare
				sdx	string;
				jdx	integer;
			begin	
				idx := dTbl.First;
				while idx is not null loop
					if dTbl(idx).DealNo != 0 then
						sdx := dTbl(idx).RepData.First;
						while sdx is not null loop
							jdx := dTbl.First;
							while jdx is not null loop
								if dTbl(jdx).DealNo != 0 and  jdx != idx then
									if not dTbl(jdx).RepData.exists(sdx) then
										dTbl(jdx).RepData(sdx).PartOfReport := dTbl(idx).RepData(sdx).PartOfReport;
										dTbl(jdx).RepData(sdx).DocCount := null;
										dTbl(jdx).RepData(sdx).DocElCount := null;
										dTbl(jdx).RepData(sdx).DocSumm := null;
										dTbl(jdx).RepData(sdx).DocCurrency := dTbl(idx).RepData(sdx).DocCurrency;
										if dTbl(jdx).RepData(sdx).PartOfReport = 'INC' then
											dTbl(jdx).IncCount := dTbl(jdx).IncCount + 1;
										elsif dTbl(jdx).RepData(sdx).PartOfReport = 'OUT' then
											dTbl(jdx).OutCount := dTbl(jdx).OutCount + 1;
										elsif dTbl(jdx).RepData(sdx).PartOfReport = 'INC_106' then
											dTbl(jdx).IncCount106 := dTbl(jdx).IncCount106 + 1;
										elsif dTbl(jdx).RepData(sdx).PartOfReport = 'OUT_106' then
											dTbl(jdx).OutCount106 := dTbl(jdx).OutCount106 + 1;
										elsif dTbl(jdx).RepData(sdx).PartOfReport = 'MINC' then
											dTbl(jdx).MIncCount := dTbl(jdx).MIncCount + 1;
										elsif dTbl(jdx).RepData(sdx).PartOfReport = 'MOUT' then
											dTbl(jdx).MOutCount := dTbl(jdx).MOutCount + 1;
										elsif dTbl(jdx).RepData(sdx).PartOfReport = 'MINC_108' then
											dTbl(jdx).MIncCount108 := dTbl(jdx).MIncCount108 + 1;
										elsif dTbl(jdx).RepData(sdx).PartOfReport = 'MOUT_108' then
											dTbl(jdx).MOutCount108 := dTbl(jdx).MOutCount108 + 1;
										end if;
									end if;
								end if;
								jdx := dTbl.Next(jdx);
							end loop;
							sdx := dTbl(idx).RepData.Next(sdx);
						end loop;
					end if;
					idx := dTbl.Next(idx);
				end loop;
			end;
		
			vInc		:= 0;
			vOut		:= 0;
			vInc106		:= 0;
			vOut106		:= 0;
			vMInc		:= 0;
			vMOut		:= 0;
			vMInc108	:= 0;
			vMOut108	:= 0;
			
			idx := dTbl.First;
			while idx is not null
			loop
				vInc		:= greatest(vInc,  dTbl(pDeal).IncCount);
				vOut		:= greatest(vOut,  dTbl(pDeal).OutCount);
				vInc106		:= greatest(vInc106, dTbl(pDeal).IncCount106);
				vOut106		:= greatest(vOut106, dTbl(pDeal).OutCount106);
				vMInc		:= greatest(vMInc, dTbl(pDeal).MIncCount);
				vMOut		:= greatest(vMOut, dTbl(pDeal).MOutCount);
				vMInc108	:= greatest(vMInc108, dTbl(pDeal).MIncCount108);
				vMOut108	:= greatest(vMOut108, dTbl(pDeal).MOutCount108);
				idx := dTbl.Next(idx);
			end loop;
			&debug('*** IRow='||vInc||', ORow='||vOut||', IRow106='||vInc106||', ORow106='||vOut106||', MIRow='||vMInc||', MORow='||vMOut||', MInc108='||vMInc108||', MOut108='||vMOut108,0)	
			
			wRow := glStartRow_SUMM;
			vInc  = wRow := SUM_ExpandRowsForOneGroup('INC',  wRow, vInc);
			vOut  = wRow := SUM_ExpandRowsForOneGroup('OUT',  wRow, vOut);
			vInc106 = wRow := SUM_ExpandRowsForOneGroup('INC_106',  wRow, vInc106);
			vOut106 = wRow := SUM_ExpandRowsForOneGroup('OUT_106',  wRow, vOut106);
			vMInc = wRow := SUM_ExpandRowsForOneGroup('MINC', wRow, vMInc);
			vMOut = wRow := SUM_ExpandRowsForOneGroup('MOUT', wRow, vMOut);
			vMInc108 = wRow := SUM_ExpandRowsForOneGroup('MINC_108', wRow, vMInc108);
			vMOut108 = wRow := SUM_ExpandRowsForOneGroup('MOUT_108', wRow, vMOut108);
			&debug('!!! IRow='||vInc||
					', ORow='||vOut||
					', IRow106='||vInc106||
					', ORow106='||vOut106||
					', MIRow='||vMInc||
					', MORow='||vMOut ||
					', MIRow108='||vMInc108||
					', MORow108='||vMOut108 ||
					' cnt='||dTbl.Count,0
			)
		
			vDealNum := 0;
			if dTbl.Count = 1 then
				ClearCells(17, 6, vMOut108-1, 8);

				&xl.Merge(21, 1, 21, 5, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
				&xl.Merge(vOut, 1, vOut, 5, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
				&xl.Merge(vOut106, 1, vOut106, 5, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
				&xl.Merge(vMOut, 1, vMOut, 5, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);

			elsif dTbl.Count >= 2 then
				ci := dTbl.First;
				ci := dTbl.Next(ci);
				&inc(vDealNum)
				&xl.Put(18,  GetCol('DEALNO', vDealNum), dTbl(ci).DealNumber);
				
				ci := dTbl.Next(ci);
				&inc(vDealNum)		

				var vDelta pls_integer;
				vDelta := 0;
					
				--копируем таблицу для отдельного сшива(вправо)
				while ci is not null
				loop
					bt := GetCol('TBL', vDealNum);
				
					--признак копирования названия строк (прихо/расход/мемориальные)
					if (vFormat and bt in (17,31,45,59)) or (not vFormat and bt in (14,25,36,47)) then
						--шапку отчета не копируем на новые листы		
						--копируем стили ячеек таблицы
						&xl.PasteSpecial(17,1,vMOut108-1,2,	17,bt-2,vMOut108-1,bt-1,null,null,true,true);
						if not vScaling then
							&inc(vDelta)
						end if;
						--проставляем номер первой колонки
						&xl.Put(20,  bt - 2, (vDealNum*2)+1+vDelta);
						
					end if;
					&xl.PasteSpecial(17,6,vMOut108-1,8,	17,bt,vMOut108-1,bt+2,null,null,true,true);

					--номера колонок
					&xl.Put(20,  bt,     (vDealNum*2)+2+vDelta);
					&xl.Put(20,  bt + 1, (vDealNum*2)+3+vDelta);
					
					--печать № дела(сшива)
					&xl.Put(18,  GetCol('DEALNO', vDealNum), dTbl(ci).DealNumber);
					
					if vFormat then
						if bt in (9, 12) then
							&xl.Merge(21, 1, 21, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 1, vOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 1, vOut106, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vMOut, 1, vMOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							
							if not vScaling then
								&xl.Merge(17, 6, 17, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;
						elsif bt < 31 then
							&xl.Merge(21, 15, 21, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 15, vOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 15, vOut106, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);			
							&xl.Merge(vMOut, 15, vMOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);			
							
							if not vScaling then
								&xl.Merge(17, 17, 17, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;

						elsif bt < 45 then
							&xl.Merge(21, 29, 21, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 29, vOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 29, vOut106, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);	
							&xl.Merge(vMOut, 29, vMOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);				
							
							if not vScaling then
								&xl.Merge(17, 31, 17, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;

						elsif bt < 59 then
							&xl.Merge(21, 43, 21, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 43, vOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 43, vOut106, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);		
							&xl.Merge(vMOut, 43, vMOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);			
							
							if not vScaling then
								&xl.Merge(17, 45, 17, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;

						else
							&xl.Merge(21, 57, 21, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 57, vOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 57, vOut106, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);			
							&xl.Merge(vMOut, 57, vMOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);		
							
							if not vScaling then
								&xl.Merge(17, 59, 17, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;
						end if;			
					else
						if bt = 9 then
							&xl.Merge(21, 1, 21, 11, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 1, vOut, 11, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 1, vOut106, 11, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vMOut, 1, vMOut, 11, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							
							if not vScaling then
								&xl.Merge(17, 6, 17, 11, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;
						elsif bt < 25 then
							&xl.Merge(21, 12, 21, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 12, vOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 12, vOut106, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);	
							&xl.Merge(vMOut, 12, vMOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);					
							
							if not vScaling then
								&xl.Merge(17, 14, 17, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;

						elsif bt < 36 then
							&xl.Merge(21, 23, 21, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 23, vOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 23, vOut106, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);		
							&xl.Merge(vMOut, 13, vMOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);			
							
							if not vScaling then
								&xl.Merge(17, 25, 17, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;
						
						elsif bt < 47 then
							&xl.Merge(21, 34, 21, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 34, vOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 34, vOut106, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);					
							&xl.Merge(vMOut, 34, vMOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							
							if not vScaling then
								&xl.Merge(17, 36, 17, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;

						else
							&xl.Merge(21, 45, 21, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut, 45, vOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							&xl.Merge(vOut106, 45, vOut106, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);			
							&xl.Merge(vMOut, 45, vMOut, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);		
							
							if not vScaling then
								&xl.Merge(17, 47, 17, bt+2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
							end if;
						end if;		
					end if;
					
					&inc(vDealNum)
					ci := dTbl.Next(ci);
				end loop;
			end if;
			
			ci := dTbl.Count;
			idx := dTbl.First;
			vDealNum := 0;
			while idx is not null
			loop
				--печать приходов
				nRow := SUM_PrintOnePart('INC',  glStartRow_SUMM, idx, ci, not vScaling, GetCol('TBL',vDealNum));
				--печать расходов
				nRow := SUM_PrintOnePart('OUT',  greatest(vInc, nRow), idx, ci, not vScaling, GetCol('TBL',vDealNum));
				--печать приходов 106 (сдвигаем на 1 строку для заголовка)
				nRow := SUM_PrintOnePart('INC_106',  greatest(vOut, nRow) + 1, idx, ci, not vScaling, GetCol('TBL',vDealNum));
				--печать расходов 106
				nRow := SUM_PrintOnePart('OUT_106',  greatest(vInc106, nRow), idx, ci, not vScaling, GetCol('TBL',vDealNum));
				--печать приходов 106 (сдвигаем на 1 строку для заголовка)
				nRow := SUM_PrintOnePart('MINC',  greatest(vOut106, nRow) + 1, idx, ci, not vScaling, GetCol('TBL',vDealNum));
				--печать расходов 106
				nRow := SUM_PrintOnePart('MOUT',  greatest(vMInc, nRow), idx, ci, not vScaling, GetCol('TBL',vDealNum));
				
				--печать Мемориальных приходов (сдвигаем на 1 строку для заголовка)
				SplitPage := not vScaling;
				if SplitPage then
					SplitPage := true;
					nRow := greatest(vMOut, nRow) + 1;
					--подвал не поместился
					if (nRow > vPage1 - 2 and nRow <= vPage1)
						or
						(nRow > vPage2 - 2 and nRow <= vPage2)
						or
						(nRow > vPage3 - 2 and nRow <= vPage3)
						or
						(nRow > vPage4 - 2 and nRow <= vPage4)
						or
						(nRow > vPage5 - 2 and nRow <= vPage5)
						or
						(nRow > vPage6 - 2 and nRow <= vPage6)
					then
						--шапка на новой странице
						if dTbl(idx).DealNo = 0 then
							SUM_PutFullHead(nRow - 1, ci, true, 3);
						end if;
						nRow := nRow + 4;
						&xl.Put(nRow-1, GetCol('TBL',vDealNum)-2, 'Мемор. ордера 0401108');
						SplitPage := false;
					end if;
				else
					nRow := greatest(vMOut, nRow) + 1;
				end if;				

				prev_Nrow := nRow;
				nRow := SUM_PrintOnePart('MINC_108', nRow, idx, ci, not vScaling, GetCol('TBL',vDealNum));
				-- Если нет мемор. ордеров 0401108 по дебету(nRow не изменился),
				-- то сдвигаем на 1 строку, чтобы данные по кредиту печатались в следующей строке
				if prev_Nrow = nRow then
					&inc(nRow)
				end if;

				--печать Мемориальных расходов		
				SplitPage := not vScaling;
				if SplitPage then
					SplitPage := true;
					nRow := greatest(vMInc108, nRow);
					--подвал не поместился
					if (nRow > vPage1 - 11 and nRow <= vPage1)
						or
						(nRow > vPage2 - 11 and nRow <= vPage2)
						or
						(nRow > vPage3 - 11 and nRow <= vPage3)
						or
						(nRow > vPage4 - 11 and nRow <= vPage4)
						or
						(nRow > vPage5 - 11 and nRow <= vPage5)
						or
						(nRow > vPage6 - 11 and nRow <= vPage6)
					then
						--шапка на новой странице
						if dTbl(idx).DealNo = 0 then
							SUM_PutFullHead(nRow, ci, true);
						end if;
						nRow := nRow + 5;
						&xl.Put(nRow-1, GetCol('TBL',vDealNum)-2, 'Мемор. ордера 0401108');
						SplitPage := false;
					end if;
				else
					nRow := greatest(vMInc108, nRow);
				end if;				

				nRow := SUM_PrintOnePart('MOUT_108', nRow, idx, ci, SplitPage, GetCol('TBL',vDealNum));

				-- запоминаем самую последнюю строку, от которой будет считаться начало блока с подписями
				vEndRow := greatest(vEndRow, nRow);
				
				&inc(vDealNum)
				idx := dTbl.Next(idx);
			end loop;
			
			if vScaling then
				if  dTbl.Count > GetCol('TMPL',3) then
					-- запомним ширины столбцов, так как Delete_Column сбивает их
					vDealNum := dTbl.Last-dTbl.First;
					bt := greatest(GetCol('TBL', vDealNum),GetCol('TMPL',11))+4;
					for ii in 1..bt loop
						if (vFormat and ii in (15,16,29,30 ,43,44,57,58)) or (not vFormat and ii in (12,13,23,24 ,34,35,45,46)) then
							idxtbl2(ii) := -1;
						else
							idxtbl2(ii) := &xl.get_column_width(ii);
						end if;
					end loop;
				
					vDealNum := 0;
					ci := dTbl.First;
					ci := dTbl.Next(ci);
					&inc(vDealNum)
					ci := dTbl.Next(ci);
						
					while ci is not null
					loop
						&inc(vDealNum)
						bt := GetCol('TBL', vDealNum);
						if (vFormat and bt in (17,31,45,59)) or (not vFormat and bt in (14,25,36,47)) then
							dlt:=dlt+2;
							&xl.Delete_Column(bt-2-dlt, 2);		
						end if;
		
						ci := dTbl.Next(ci);
					end loop;
					
					gc12temp := GetCol('TMPL',9) + 3; -- координаты "Код формы по ОКУД"
					bt := greatest(GetCol('TBL', vDealNum)-dlt,GetCol('TMPL',11));
					dlt:=round((bt-GetCol('TMPL',11))/2)+1;
					
					&xl.PasteSpecial(1,gc12temp-2,3,gc12temp-1, 1,bt-1,3,bt,null,null,true,true);

					ClearCells(1,gc12temp-2,3,gc12temp-1);
					
					&xl.PasteSpecial(4,1,15,GetCol('TMPL',11), 4,bt+1,15,bt+gc12temp-1,null,null,true,true);

					ClearCells(4, 1, 15,gc12temp);
					&xl.PasteSpecial(17,1,nRow+10,11,17,bt+gc12temp,nRow+10,bt+gc12temp+10,null,null,true,true);
					&xl.Delete_Column(1, 11);
					&xl.Ins_Column(1, 11);
					&xl.PasteSpecial(17,bt+gc12temp,nRow+10,bt+gc12temp+10,17,1,nRow+10,11,null,null,true,true);

					
					-- чтобы правильно отработал PasteSpecial при попадании на область, где уже есть объединение ячеек
					&xl.Merge(4, dlt, 5, dlt+gc12temp-2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					&xl.Merge(6, dlt, 7, dlt+gc12temp-2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					if vFormat then
						&xl.Merge(8, dlt, 11, dlt+gc12temp-2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					else				
						&xl.Merge(8, dlt, 10, dlt+gc12temp-2, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					end if;
					
					&xl.PasteSpecial(4,bt+1,15,bt+gc12temp-1, 4,dlt,15,dlt+gc12temp-2,null,null,true,true);
					&xl.Delete_Column(bt+1, gc12temp+12);	
					
					-- вернём ширины столбцов, так как Delete_Column сбивает их
					for ii in idxtbl2.First..idxtbl2.Last loop
						if (idxtbl2(ii) = -1) then
							dlt2 := dlt2+1;
						else
							&xl.set_column_width(idxtbl2(ii),ii-dlt2);
						end if;
					end loop;
					
					&xl.Merge(21, 1, 21, bt, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					&xl.Merge(vOut, 1, vOut, bt, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					&xl.Merge(vOut106, 1, vOut106, bt, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
					
					&xl.Merge(17, 6, 17, bt, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);

				end if;
			else
				--перемещение подписей
				if dTbl.Count > GetCol('TMPL',12) then
					&xl.PasteSpecial(vEndRow+2, 1, vEndRow+9, 11,	vEndRow+2, GetCol('TMPL',45), vEndRow+9, GetCol('TMPL',45)+10,null,null,true,true);
					ClearCells(vEndRow+2, 1, vEndRow+9, 11);

				elsif dTbl.Count > GetCol('TMPL',9) then
					&xl.PasteSpecial(vEndRow+2, 1, vEndRow+9, 11,	vEndRow+2, GetCol('TMPL',34), vEndRow+9, GetCol('TMPL',34)+10,null,null,true,true);
					ClearCells(vEndRow+2, 1, vEndRow+9, 11);
							
				elsif dTbl.Count > GetCol('TMPL',6) then
					&xl.PasteSpecial(vEndRow+2, 1, vEndRow+9, 11,	vEndRow+2, GetCol('TMPL',23), vEndRow+9, GetCol('TMPL',23)+10,null,null,true,true);
					ClearCells(vEndRow+2, 1, vEndRow+9, 11);
				
				elsif dTbl.Count > GetCol('TMPL',3) then
					&xl.PasteSpecial(vEndRow+2, 1,  vEndRow+9, 11,	vEndRow+2, GetCol('TMPL',12), vEndRow+9, GetCol('TMPL',12)+10,null,null,true,true);
					ClearCells(vEndRow+2, 1,  vEndRow+9, 11);
				
				end if;
			end if;
		end;
		
begin
	--заполнение неизменяемых данных в страницах-шаблонах
	BankName := substr(::[NOTRADE].[LIB_RPT].GET_BANK_NAME_3353U(pDepart), 1, BankName%size);

-- PSB Вывод корректного наименования кассы в Энгельсе
	if pDepart.[CODE] like '001-6%' then
		if Instr(BankName,pDepart.[NAME])>0 then null;
		else BankName:=substr(BankName||' '||pDepart.[NAME], 1, BankName%size);
		end if;
		
		--Касса ДО "Энгельс" ВСП - № 538/0/11
		if pDepart.[CODE] like '001-62' and instr(BankName,'ВСП - № 538/0/11')=0
		then BankName:=substr(BankName||' '||'ВСП - № 538/0/11', 1, BankName%size);
		end if;
	end if;
	--Башкиров В.Г. 30.07.2025 CFT-2156
	if p_kassa.[NUM_PK]<>'00113' then --00100-Удаленная точка обслуживания ООО "Промсельхозбанк" (УТО)
		BankName:=trim(replace(BankName,'          ',' ')); --См. Настройки. FORM_BANK_NAME-Формат для вывода наименования банка в кассовых отчетах для <DEP_LEVEL>=Внутреннее структурное подразделение
	end if;
-- PSB

	RepName := nvl(::[FP_TUNE].[LIB].get_str_value('F0402433_NAME'),'ТЕКСТ'||lf$||'ДЛЯ ДЕЛА С КАССОВЫМИ ДОКУМЕНТАМИ');
	--шаблон сводный

	&xl.Open_Sheet('SUMMARY');
	&xl.Put(4,  1, RepName);
	&xl.Put(6,  1, BankName);								--название банка
	&debug('SUMMARY '||RepName||' '||BankName, dp)

	if vFormat then
		&xl.Put(12, GetCol('TMPL',5), ::[RUNTIME].[VIEWFUN].DAT_STR(pDate, '2'));	--отчетная дата
		&xl.Put(14, 9, AllParts);								--Количество дел (сшивов)
	else
		&xl.Put(11, GetCol('TMPL',5), ::[RUNTIME].[VIEWFUN].DAT_STR(pDate, '2'));	--отчетная дата
		&xl.Put(13, 9, AllParts);								--Количество дел (сшивов)
	end if;

	--должности
	if pUser1 is not null and pUser1.[CASTA] is not null then
		&xl.Put(43, 1, pUser1.[CASTA].[VALUE]);
	end if;
	if pUser2 is not null and pUser2.[CASTA] is not null then
		&xl.Put(48, 1, pUser2.[CASTA].[VALUE]);
	end if;
	&xl.Put(43, 8, stdlib.Fio(pUser1.[NAME], 'Ф И.О.'));	--Заведующий кассой
	&xl.Put(48, 8, stdlib.Fio(pUser2.[NAME], 'Ф И.О.'));	--Заместитель главного бухгалтера
	
	--шаблон отдельного сшива
	&xl.Open_Sheet('SEW');
	&xl.Put(4,  1, RepName);
	&xl.Put(6,  1, BankName);								--название банка
	&debug('SEW '||RepName||' '||BankName, dp)

	&xl.Put(11, 4, ::[RUNTIME].[VIEWFUN].DAT_STR(pDate, '2'));	--отчетная дата
	&xl.Put(13, 7, AllParts);								--Количество дел (сшивов)
	--должности
	if pUser1 is not null and pUser1.[CASTA] is not null then
		&xl.Put(41, 1, pUser1.[CASTA].[VALUE]);
	end if;
	if pUser2 is not null and pUser2.[CASTA] is not null then
		&xl.Put(46, 1, pUser2.[CASTA].[VALUE]);
	end if;
	&xl.Put(41, 8, stdlib.Fio(pUser1.[NAME], 'Ф И.О.'));	--Заведующий кассой
	&xl.Put(46, 8, stdlib.Fio(pUser2.[NAME], 'Ф И.О.'));	--Заместитель главного бухгалтера
	
--создание отчета с копированием листов	
	
	--печать сводного сшива
	if pPartOfReport is null or pPartOfReport = 0 then
		&xl.Open_Sheet('SUMMARY');
		&debug('SUMMARY печать сводного сшива', dp)

		idx := dTbl.First;
		
		if idx is not null then
			if vFormat then
				--Срок хранения
				&xl.Put(15,  9, dTbl(idx).Period);
			
				--печать № дела(сшива)
				&xl.Put(15,  3, dTbl(idx).DealNumber);
			else
				--Срок хранения
				&xl.Put(14,  10, dTbl(idx).Period);
			
				--печать № дела(сшива)
				&xl.Put(14,  4, dTbl(idx).DealNumber);
			end if;			
		end if;

		SUMM_PreparePageForPrint(idx);
	end if;
	
	--печать отдельных сшивов
	if pPartOfReport is null or pPartOfReport > 0 then
		--удаляем пустые строки
		declare
			sdx	string;
		begin	
			idx := dTbl.First;
			while idx is not null loop
				if dTbl(idx).DealNo != 0 then
					sdx := dTbl(idx).RepData.First;
					while sdx is not null loop
						if dTbl(idx).RepData(sdx).DocSumm is null and dTbl(idx).RepData(sdx).DocCount is null and dTbl(idx).RepData(sdx).DocElCount is null then
							if dTbl(idx).RepData(sdx).PartOfReport = 'INC' then
								dTbl(idx).IncCount := dTbl(idx).IncCount - 1;
							elsif dTbl(idx).RepData(sdx).PartOfReport = 'OUT' then
								dTbl(idx).OutCount := dTbl(idx).OutCount - 1;
							elsif dTbl(idx).RepData(sdx).PartOfReport = 'INC_106' then
								dTbl(idx).IncCount106 := dTbl(idx).IncCount106 - 1;
							elsif dTbl(idx).RepData(sdx).PartOfReport = 'OUT_106' then
								dTbl(idx).OutCount106 := dTbl(idx).OutCount106 - 1;								
							elsif dTbl(idx).RepData(sdx).PartOfReport = 'MINC' then
								dTbl(idx).MIncCount := dTbl(idx).MIncCount - 1;
							elsif dTbl(idx).RepData(sdx).PartOfReport = 'MOUT' then
								dTbl(idx).MOutCount := dTbl(idx).MOutCount - 1;
							elsif dTbl(idx).RepData(sdx).PartOfReport = 'MINC_108' then
								dTbl(idx).MIncCount108 := dTbl(idx).MIncCount108 - 1;
							elsif dTbl(idx).RepData(sdx).PartOfReport = 'MOUT_108' then
								dTbl(idx).MOutCount108 := dTbl(idx).MOutCount108 - 1;
							end if;
							dTbl(idx).RepData.delete(sdx);
						end if;
						sdx := dTbl(idx).RepData.Next(sdx);
					end loop;
				end if;
				idx := dTbl.Next(idx);
			end loop;
		end;
				
		idx := dTbl.First;
		while idx is not null
		loop
			if dTbl(idx).DealNo = 0	then
				idx := dTbl.Next(idx);
				continue;
			end if;
			sList := 'SEW_' || dTbl(idx).DealNo;
			--копируем шаблонную страницу (отдельного сшива) в новую для заполнения данными
			&xl.AddCopySheet('SEW', sList);
			&xl.Open_Sheet(sList);
			&xl.Put(6,  1, BankName);								--название банка
			&debug(sList||' '||BankName, dp)

			--Срок хранения
			&xl.Put(14,  8, dTbl(idx).Period);
			
			--печать № дела(сшива)
			&xl.Put(14,  4, dTbl(idx).DealNumber);
	
			SEW_PreparePageForPrint(idx);
			
			nRow := glStartRow_SEW;
			--печать приходов
			nRow := SEW_PrintOnePart('INC', nRow, idx);
			--печать расходов
			nRow := SEW_PrintOnePart('OUT', nRow, idx);	
			--печать приходов 106
			nRow := SEW_PrintOnePart('INC_106', nRow+1, idx);
			--печать расходов 106
			nRow := SEW_PrintOnePart('OUT_106', nRow, idx);
			--печать Мемориальных приходов
			nRow := SEW_PrintOnePart('MINC', nRow+1, idx);

			declare
				SplitPage boolean;
			begin	
				SplitPage := true;
				--подвал не поместился
				if (nRow > vPage1_sew - 11 and nRow <= vPage1_sew) then
					SEW_PutFullHead(nRow, true);
					nRow := nRow + 4;
					&xl.Put(nRow-1, 2, 'Ордера по передаче ценностей 0402102');
					SplitPage := false;
				end if;
				
				--печать Мемориальных расходов
				nRow := SEW_PrintOnePart('MOUT', nRow, idx, SplitPage );
				
				--печать Мемориальных приходов 108
				nRow := SEW_PrintOnePart('MINC_108', nRow+1, idx, SplitPage);
				--печать Мемориальных расходов 108
				nRow := SEW_PrintOnePart('MOUT_108', nRow, idx, SplitPage);

			end;
				
			&xl.Cell(1, 1,'');
			idx := dTbl.Next(idx);
		end loop;
	end if;
	
	--удаление страниц - шаблонов
	if pPartOfReport > 0 then
		&xl.delSheet('SUMMARY');
	end if;
	&xl.delSheet('SEW');	
end;

--сформировать отчет
procedure Draw_Report(pDate date, pFilial ref [BRANCH], pDepart ref [DEPART], pKasses string(4000), pPartOfReport number, pUser1 ref [USER], pUser2 ref [USER], p_kassa ref [NOTRADE]) is
idx string;
sdx  	string;
isNull	boolean;
begin
	::[NOTRADE].[SRV].Set_Context(pFilial);

	&debug('getdata.begin',0)
	GetDataForReport(pDate, pFilial, pDepart, trim(pKasses), pPartOfReport);
	&debug('getdata.end',0)
	
	-- удаление пустых сшивов
	if not nvl(::[FP_TUNE].[LIB].get_bool_value('F0402433_PRINT_COLUMNS'), false) then
		&debug('cleardata.begin',0)
		idx := dTbl.First;
		while idx is not null
		loop
			isNull := true;

			sdx := dTbl(idx).RepData.First;
			while sdx is not null
			loop
				if nvl(dTbl(idx).RepData(sdx).DocCount, 0) > 0 or nvl(dTbl(idx).RepData(sdx).DocElCount, 0) > 0 or nvl(dTbl(idx).RepData(sdx).DocSumm,0) > 0 then
					isNull := false;
				end if;
				sdx := dTbl(idx).RepData.Next(sdx);
			end loop;

			if (nvl(dTbl(idx).IncCount,0) = 0
				and nvl(dTbl(idx).OutCount,0) = 0
				and nvl(dTbl(idx).IncCount106,0) = 0
				and nvl(dTbl(idx).OutCount106,0) = 0
				and nvl(dTbl(idx).MIncCount,0) = 0
				and nvl(dTbl(idx).MOutCount,0) = 0
				and nvl(dTbl(idx).MIncCount108,0) = 0
				and nvl(dTbl(idx).MOutCount108,0) = 0
			) or (isNull) then
				AllParts := AllParts - 1;
				dTbl.delete(idx);
			end if;
			
			idx := dTbl.Next(idx);
		end loop;
		&debug('cleardata.end',0)
	end if;
	
	&debug('postdata.begin',0)
	PostData(pPartOfReport, pDepart, pDate, pUser1, pUser2, P_KASSA);
	&debug('postdata.end',0)
end;
PSH_REP_0402433U (
	@name('Дата')               P_DATA      in [DATE],
	@name('Подразделение')      P_DEPART    in [DEPART_REF],
	@name('Номер кассы')        P_KASSA     in [S_NOTRADE],
	@name('Касса')              P_SP_KASS   in [STRING_4000],
	@name('Заполнить список')   P_ALL_KASSA in [BOOLEAN],
	@name('Номер сшива')        P_N_KIND    in [SHORT2],
	@name('Первая подпись')     P_SIGN_1    in [USER_REF],
	@name('Вторая подпись')     P_SIGN_2    in [USER_REF],
	@name('Количество сшивов')  P_N_KIND_K  in [SHORT2],
	@name('Имя файла  (EXCEL)') P_FILE      in [STRING],
	@name('Филиал')             P_FILIAL    in [BRANCH_REF]
) is

validate is
begin
declare
rpt_blob	blob;
is_open		boolean;
vRepId		string;

procedure Clear is
begin
	P_SP_KASS	:= null;
	P_KASSA := null;
	P_ALL_KASSA := false;
	EmptyTune;
end;

BEGIN
	IF  P_MESSAGE = 'DEFAULT' THEN
		P_DATA		:= ::[SYSTEM].[OP_DATE];
		P_DEPART	:= this.[DEPART];
		P_FILIAL	:= this.[FILIAL];
		V_SCALING	:= false;
		P_ALL_KASSA := false;
		P_N_KIND	:= null;
		P_SIGN_2	:= null;
		P_SP_KASS	:= null;
		GetEmptyTune;
		vFormat := nvl(::[FP_TUNE].[LIB].get_bool_value('F0402433_ORIENTATION'),false);

		if vFormat then
			vPage1 := 37;
			vPage2 := 65;
			vPage3 := 97;
			vPage4 := 133;
			vPage5 := 173;
			vPage6 := 217;
		else
			vPage1 := 51;
			vPage2 := 98;
			vPage3 := 145;
			vPage4 := 192;
			vPage5 := 239;
			vPage6 := 286;
		end if;

		AddKasse(this, P_SP_KASS);
		
		begin
			select	s(s.[SAFE_MANAGER])
			in		::[SAFE] all
			where	s.[SAFE_MANAGER] is not null
					and s.[KASSA] = this
			into	P_SIGN_1;
		exception
			when NO_DATA_FOUND or TOO_MANY_ROWS then
				P_SIGN_1 := null;
		end;

		select	x(count(1))
		in		::[KOP_PATT_0402433]
		into	P_N_KIND_K;

-- PSB Башкиров В.Г. 16.08.2023 Сохраняем и вытаскиваем 1-ю подпись
		P_SIGN_1:=nvl(::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_SIGN_1'),stdlib.UserID);
		-- P_SIGN_2	:=	::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_SIGN_2');
		P_SIGN_2:=nvl(::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_SIGN_2'),::[BRANCH].[SLIB].GetGeneralACC(null));
-- PSB
	--Башкиров В.Г. 25.07.2025 CFT-2129
	if P_KASSA is null then
		P_KASSA:=this; --::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_KASSA');
		if P_KASSA is not null then P_DEPART:=P_KASSA.[DEPART]; end if;
		debug_pipe('(1)P_FILIAL='||P_FILIAL.[CODE]||' P_KASSA='||P_KASSA.[NUM_PK]||' P_DEPART='||P_DEPART.[CODE],dp);
		
		if P_KASSA is null then
			for (
			select n(n%id : C_ID, n.[PK_CASH] :C_PK_CASH) in ::[NOTRADE]
			where instr(sPsbActivNotrade,''''||n.[NUM_PK]||'''')>0
			order by n.[KASS_DEP] desc --Основная касса первой
					,n.[NUM_PK]
			) loop
				for pkc in n.C_PK_CASH
				where pkc.[KASSIR].[KASSIR]=stdlib.userid
				loop
					P_KASSA:=n.C_ID;
					P_DEPART:=P_KASSA.[DEPART];
					debug_pipe('(2)P_FILIAL='||P_FILIAL.[CODE]||' P_KASSA='||P_KASSA.[NUM_PK]||' P_DEPART='||P_DEPART.[CODE],dp);
					exit;
				end loop;
				if P_KASSA is not null then
					exit;
				end if;
			end loop;
		end if;
		debug_pipe('(3)P_FILIAL='||P_FILIAL.[CODE]||' P_KASSA='||P_KASSA.[NUM_PK]||' P_DEPART='||P_DEPART.[CODE],dp);

		if P_KASSA is null then
			P_KASSA:=this;
			P_DEPART:=P_KASSA.[DEPART];
			debug_pipe('(4)P_FILIAL='||P_FILIAL.[CODE]||' P_KASSA='||P_KASSA.[NUM_PK]||' P_DEPART='||P_DEPART.[CODE],dp);
		/** /
		else
			Clear; 							--ОЧИСТИТЬ
			AddKasse(P_KASSA, P_SP_KASS);	--Заполнить список
			P_DEPART:=P_KASSA.[DEPART];
			P_FILIAL:=P_KASSA.[FILIAL];
			debug_pipe('(5)P_FILIAL='||P_FILIAL.[CODE]||' P_KASSA='||P_KASSA.[NUM_PK]||' P_DEPART='||P_DEPART.[CODE],dp);
		/**/
		end if;
	end if;

	ELSIF  P_MESSAGE = 'VALIDATE'  THEN

		if P_INFO = 'P_KASSA' then
			if P_KASSA is not null then
				AddKasse(P_KASSA, P_SP_KASS);
			end if;
		end if;		

		if P_INFO = 'P_FILIAL' then
			if P_FILIAL is null then
				pragma error('Задайте филиал отчета');
			else
				if P_DEPART.[FILIAL] != P_FILIAL then
					P_DEPART := null;
				end if;
				Clear;
			end if;
		end if;
		
		if P_INFO = 'P_DEPART' then
			Clear;
		end if;

		if P_INFO = 'P_ALL_KASSA' then
			if P_ALL_KASSA then
				for(
					select n(n%id : kId) in ::[NOTRADE] all
					where	n.[FILIAL] = P_FILIAL
						and	n.[DEPART] = nvl(P_DEPART, n.[DEPART])
				)loop
					AddKasse(n.kId, P_SP_KASS);
				end loop;
			end if;	
		end if;	

		if P_INFO = 'P_DATA' then
			if P_DATA is null then
				pragma error('Задайте дату');
			end if;	
		end if;

		if P_INFO = 'P_N_KIND' then
			if P_N_KIND is not null then
				declare
					ko	ref	[KOP_PATT_0402433];
				begin
					locate ko in ::[KOP_PATT_0402433] all where ko.[N_KIND] = to_char(P_N_KIND);
				exception
					when NO_DATA_FOUND then
						pragma error('В справочнике Кассы и ОП. Настройка шаблонов для сшива кассовых документов'||NL$||
									'не заведено дело № ' || P_N_KIND);
				end;
			end if;
		end if;

		if P_INFO = 'ОЧИСТИТЬ' then
			Clear;
		end if;

		if P_INFO = 'OK' then
			P_FILE		:= 'КАССА_Ф_1413'||bool_char(vFormat,'_l','');
			&xl.INIT_XLS;
			::[SHABLON_DOC].[LIB_OOXML].load_blob(P_FILE, rpt_blob, null, null, null,::[SYSTEM].[VARIABLES].OurBranch);
			is_open := false;
			is_open	:= &xl.open_file(rpt_blob);
		
			if not is_open then
				pragma error('Не найден шаблон "'||P_FILE||'" в справочнике шаблонов документов!');    		
			end if;			

			vScaling:=nvl(V_SCALING,vScaling);
			if vScaling then
				&xl.fit_in_page(&xl.getSheetNum('SUMMARY'),1,1,40);
			end if;

			CheckBeforeReport(P_DATA, P_DEPART, P_SP_KASS, P_N_KIND, P_N_KIND_K);

			begin
				DRAW_REPORT(P_DATA, P_FILIAL, P_DEPART, P_SP_KASS, P_N_KIND, P_SIGN_1, P_SIGN_2, P_KASSA); 		--Формирование отчета
	  			rpt_blob := empty_blob();
				&xl.finish(rpt_blob);
			exception when OTHERS then
					/* Причина перехвата others:
					 * Отсутствие механизма checked/unchecked исключений в платформе не позволяет предугадать,
					 * какое исключение может возникнуть при вызове сторонних методов.
					 * Поэтому перехватываем все возможные исключения и откатываем транзакцию, чтобы избежать
					 * возможной "поломанной" транзакции в архитектуре DBI PG 
					 */
					stdio.put_line_buf('Ошибка формирования отчета: '||sqlerrm
						||NL$||::[RUNTIME].[UTILS].error_stack(true)
					);
					raise;
			end;

			vRepId	:= &orsa.putReport2Run(rpt_blob,'xlsx','Текст для дела');

		end if; --OK

	END IF;
END;
end;

execute is
begin
	--Башкиров В.Г. 25.07.2025 CFT-2129
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_KASSA', P_KASSA, 'NOTRADE');

	ttbl.delete;
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_SIGN_1', P_SIGN_1, 'USER'); --PSB
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_SIGN_2', P_SIGN_2, 'USER');
end;
end;
end;
