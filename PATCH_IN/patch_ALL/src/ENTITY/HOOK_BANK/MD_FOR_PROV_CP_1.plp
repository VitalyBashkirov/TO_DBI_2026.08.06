if vPSB_ADD_LISTPAY_CARDOVER then --ПСБ.Добавлять в факты "Учет начисленных %%" и "Гашение учтенных процентов" для Пластиковых оверов
	AddListPayCardOver(DOCUMENT,ACCOUNT_DT,ACCOUNT_CT,IT_DT,ANALYSE_OK,P_ADDS,P_MESS);
