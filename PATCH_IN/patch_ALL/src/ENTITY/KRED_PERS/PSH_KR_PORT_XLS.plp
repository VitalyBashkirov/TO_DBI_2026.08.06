class KRED_PERS;

@import_plsql(true)
@name('[ПСБ] Кредитный портфель в Эксель')
@tag('COPIED')
static method PSH_KR_PORT_XLS is

@name('V_DEST') public V_DEST [STRING_32000];

d date := ::[SYSTEM].[OP_DATE];

public function Get_d return date is 
begin
	return d;
end;
pragma restrict_references(Get_d,wnds,wnps);

public function fGetMort(iCr in ref [PR_CRED], iTp in varchar2) return varchar2 is 
pRes varchar2(2000);
begin
      pRes := null;
      if iTp = 'ACC' then
	      for (select distinct mort(mort.[ARRAY_DOG_ACC].[ACCOUNT_DOG].[1].[2].MAIN_V_ID :acc)
	           in ::[ZALOG] all
	           where mort.[PART_TO_LOAN].PRODUCT = iCr
	             and f.a('В'||mort.[ARRAY_DOG_ACC].[ACCOUNT_DOG].[1].[2].[ARC_MOVE]||'СН', d+1) != 0)
	      loop
	            pRes := pRes||','||mort.acc;
            end loop;
      elsif iTp in ('NAME', 'KK') then
            for (select distinct mort(decode(iTp, 'NAME', mort.[VID_GUARANTEE].NAME, 'KK', mort.[VID_GUARANTEE].[SECS_CALCS_PARTS].NAME) :str)
	           in ::[ZALOG] all
	           where mort.[PART_TO_LOAN].PRODUCT = iCr
	             and f.a('В'||mort.[ARRAY_DOG_ACC].[ACCOUNT_DOG].[1].[2].[ARC_MOVE]||'СН', d+1) != 0)
	      loop
	            pRes := pRes||','||mort.str;
            end loop;
      else
            return null;
      end if;
      return ltrim(pRes, ',');
end;--fGetMort
pragma restrict_references(fGetMort,wnds,wnps);

public function fGetResLimAcc(pCr in ref [PR_CRED]) return ref [AC_FIN] is 
    iAcc ref [AC_FIN];
begin
    select ttt(
          ttt.[RES_ACC]
    ) in
          ::[RES_BASE_ACCS]
    where
          ttt.[PROD_RES]=pCr
      and substr(ttt.[ACC].[MAIN_V_ID],1,5) in ('91316','91317')
	and substr(ttt.[RES_ACC].[MAIN_V_ID],1,5)='47425'
    into iAcc;
    return iAcc;
exception when NO_DATA_FOUND then
    return null;
end;--fGetResLimAcc
pragma restrict_references(fGetResLimAcc,wnds,wnps);

public function fGetMortAccBal(pDea in ref [PR_CRED], pDate in date, pAcc in varchar2) return number is 
      vBal number;
begin
    select a(
          sum(abs(coalesce(f.a('В'||a.[ARRAY_DOG_ACC].[ACCOUNT_DOG].[1].[2].[ARC_MOVE]||'СН', pDate+1), 0)))
    ) in ::[ZALOG] all
    where
          a.[PART_TO_LOAN].PRODUCT=pDea
      and a.[ARRAY_DOG_ACC].[ACCOUNT_DOG].[1].[2].MAIN_V_ID like pACC||'%'
    into vBal;
    return vBal;
exception when others then
    return null;
end;--fGetMortAccBal
pragma restrict_references(fGetMortAccBal,wnds,wnps);

-- Количество дней просрочки за предыдущие 180 дней
public function itog_prosr_180(id_kred in ref [PR_CRED], pDate in date) return number is 
day_prosr number;
prosr_od number;
prosr_prc number;
begin
day_prosr:=0;

for i in 0 .. 179 loop
prosr_od:=0;
prosr_prc:=0;

prosr_od:=  ::[RUNTIME].[F_5].A('И'||id_kred.[ACC_DEBTS_CR] ||'СВ',pDate-i);
prosr_prc:= ::[RUNTIME].[F_5].A('И'||id_kred.[ACC_DEBTS_PRC]||'СВ',pDate-i);

if prosr_od!=0 or prosr_prc!=0 then day_prosr:=day_prosr+1;
end if;

end loop;

return(day_prosr);
end;

-- Башкиров В.Г. 25.01.2019 21:50 Обновление 18.6.07
-- Возвращает дату возникновения суммы задолженности по списку кодов (p_Debts) задолженностей по кредиту (id_cred)
Function DateCreateDebt(
	id_cred    ref [PR_CRED]
	,p_Debts varchar2(32000)
	,on_date   [DATE]
)return [DATE] is
	type TrecDebt is record (
		  sCode		varchar2(1000)
		, nSumma	[SUMMA]
	);
	
	type TtblDebts	is table of TrecDebt index by varchar2(128);
	
	type TrecVOD is record (
		  rDebt		ref	[VID_DEBT]
		, bDT		boolean
	);
	type TtblVOD	is table of TrecVOD index by varchar2(128);
	
	tblDebts		TtblDebts;
	tblVOD			TtblVOD;
	sDebtCode		varchar2(1000);
	iPos			integer;
	rDebt		ref	[VID_DEBT];
	dMinDate		date;
	vTotalSum		[SUMMA];
begin
	
	if substr(p_Debts, 1, 1) != '#' then p_Debts := '#' || p_Debts;	end if;
	if substr(p_Debts, length(p_Debts), 1) != '#' then p_Debts := p_Debts || '#'; end if;
	-- Вычисляем общую сумму задолженности
	p_Debts   := substr(p_Debts, 2);
	vTotalSum := 0;		-- общая сумма задолженности
	
	-- Определяем набор задолженностей для расчёта
	while length(p_Debts) > 0 loop
		iPos := instr(p_Debts, '#');
		if iPos > 0 then
			sDebtCode := substr(p_Debts, 1, iPos - 1);
			p_Debts := substr(p_Debts, iPos + 1);
			begin
				rDebt := ::[VID_DEBT]([CODE] = sDebtCode);
				tblDebts(rDebt).sCode  := sDebtCode;
				tblDebts(rDebt).nSumma := ::[PR_CRED].[L].GetSumDebt(id_cred, rDebt, on_date);
				vTotalSum := vTotalSum + tblDebts(rDebt).nSumma;
			exception
				when NO_DATA_FOUND or TOO_MANY_ROWS then
					null;
			end;
		end if;
	end loop;

	if tblDebts.count = 0 or vTotalSum = 0 then return null; end if;
	
	-- Заполняем участие в задолженностях для кредитных видов операций
	for (
		select rVidOper
			( rVidOper						: RID
			, rVidOper.[TAKE_DEBT].[DEBT]	: DEBT
			, rVidOper.[TAKE_DEBT].[DT]		: DT
			)
			in ::[VID_OPER_DOG] all
		 where	rVidOper.[CODE_GROUP] like 'КРЕДИТ%'
			and	not (rVidOper.[TAKE_DEBT].[DEBT] is null)					-- У участия в задолженности проставлен вид задолженности
		)
	loop
		if tblDebts.exists(rVidOper.[DEBT]) and tblDebts(rVidOper.[DEBT]).nSumma > 0 then
			tblVOD(rVidOper.[RID]).rDebt := rVidOper.[DEBT];
			tblVOD(rVidOper.[RID]).bDT := nvl(rVidOper.[DT], false);
		end if;
	end loop;
	
	dMinDate := on_date;
	
	-- [по факту] определяем момент, когда общая сумма (vTotalSum) уйдёт в ноль
	for (
		select rFactOper
			( rFactOper.[SUMMA]	: SUMMA
			, rFactOper.[OPER]	: OPER
			, rFactOper.[DATE]	: OP_DATE
			)
			in id_cred.[LIST_PAY]
		where rFactOper.[DATE] <= on_date
		order by rFactOper.[DATE] desc
		)
	loop
		if tblVOD.exists(rFactOper.[OPER]) then
			if tblVOD(rFactOper.[OPER]).bDT
				then vTotalSum := vTotalSum	+ rFactOper.[SUMMA];
				else vTotalSum := vTotalSum	- rFactOper.[SUMMA];
			end if;
			
			if vTotalSum <= 0 then
				dMinDate := least(dMinDate, rFactOper.[OP_DATE]);
				exit;
			elsif  vTotalSum > 0 then
				dMinDate := least(dMinDate, rFactOper.[OP_DATE]);
			end if;
		end if;
	end loop;
	
	return dMinDate;
	
end;
-- срок существования задолженности с кодом CODE по договору id_cred на дату on_date
Function PeriodDebt(
	id_cred		ref [PR_CRED]
	,CODE		varchar (25)
	,on_date	[DATE] default [VIEWFUN].GetOpDate
)return number is
mindate date;
period number := 0;
begin
	mindate := DateCreateDebt(id_cred, CODE, on_date);
	if mindate is not null then
		period := on_date - mindate;
	end if;
	return period;
end;
PSH_KR_PORT_XLS (
	@name('За дату') P_BEGDATE in [DATE]
) is

validate is
pragma macro(GD,'::[KRED_PERS].[PSH_KR_PORT_XLS].GET_D',substitute);
pragma macro(RD,'trunc(::[KRED_PERS].[PSH_KR_PORT_XLS].GET_D+1,''MM'')-1',substitute);
pragma macro(BAL,'abs(f.a(''В''||[1]||''СН'',::[KRED_PERS].[PSH_KR_PORT_XLS].GET_D+1))',substitute);
pragma macro(RBAL,'abs(f.a(''В''||[1]||''СН'',trunc(::[KRED_PERS].[PSH_KR_PORT_XLS].GET_D+1,''MM'')))',substitute);
pragma macro(MD,'to_date(''31.12.4012'',''DD.MM.YYYY'')',substitute);

i 			number;
vColCount 	number; -- колво колонок в отчете

begin

  if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
		[EXCEL].Init_Xls;
		--P_BEGDATE:= ::[SYSTEM].[OP_DATE];
							
  elsif P_MESSAGE = 'VALIDATE' then -- переход между полями

		if p_info = 'OK' then
		
  			if P_BEGDATE is null  then
  				pragma error('Необходимо указать дату!');
  			end if;

			d := P_BEGDATE;
			::[PR_CRED].[PSH_CRED_REP].pCalcPtf(trunc(P_BEGDATE+1, 'MM')-1);
  			  			  	
			if [EXCEL].F_Click then
				[EXCEL].F_Click := False;

				vColCount := 104; -- всего колонок в отчете
				i := 4; -- первая строка в Excel
				
				-- обнуляем переменные
				-- запуск Excel
				[EXCEL].open_file(NULL,false, true);
				[EXCEL].Write(1,1,null,false,false,10,'Times New Roman','LT');
				[EXCEL].PasteSpecial(1,1,1,1,1,1,6000,vColCount);
				[EXCEL].Write(1, 4, 'Кредитный портфель за ' ||to_char(P_BEGDATE,'DD.MM.YYYY'));

				[EXCEL].Set_Column_Width(1,vColCount,20);
				[EXCEL].Write(i-1,1,null,true,false,10,'Times New Roman','LT');
				[EXCEL].PasteSpecial(i-1,1,i-1,1,i-1,1,i-1,vColCount);
				-- Шапка
				
				[EXCEL].Write(i-1,1,'ID кредита');
				[EXCEL].Write(i-1,2,'Ошибка');
				[EXCEL].Write(i-1,3,'Подразделение');
