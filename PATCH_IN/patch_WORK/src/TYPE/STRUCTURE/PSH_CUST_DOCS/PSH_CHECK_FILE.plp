class PSH_CUST_DOCS;

@import_plsql(true)
@name('[ПСБ] 2.1.Проверить документ')
@tag('COPIED')
batch method PSH_CHECK_FILE is
pragma include(::[PSH_CUST_DOCS].[PSH_LIB]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
pragma include(::[PSH_CUST_DOCS].[PSH_LIB_TC]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
PSH_CHECK_FILE is

execute is
v_tab_docs	&lib.T_Doc;
begin
	for i in 1..this.count loop
		if this(i).[DOC_STATE] = &libtc.stNew and this(i)%class = ::[PSH_CUST_DOCS_IN]%class then		
			v_tab_docs(i).doc		:= this(i);
			v_tab_docs(i).doc_type	:= this(i).[DOC_TYPE];
		end if;
	end loop;

	&lib.check_files(v_tab_docs);
end;
end;
end;
