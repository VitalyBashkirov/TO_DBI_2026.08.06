class RUNTIME;

@import_plsql(true)
@name('[ПСБ] Вызов удаления файлов с FIO  из клиент-скрипта')
@tag('COPIED')
static method PSH_DELFIOFILES is
public tbl_F$L [DOCUMENT].COPYFILES.FILE_tbl_type;

/*
			P_EI_FILE.[SRC_NAME] := tbl_F$L(idx).[SRC_NAME];
			P_EI_FILE.[DST_NAME] := tbl_F$L(idx).[DST_NAME];
			P_EI_FILE.[SRC_MASK] := tbl_F$L(idx).[SRC_MASK];
			P_EI_FILE.[DST_MASK] := tbl_F$L(idx).[DST_MASK];
			P_EI_FILE.[SRC_DELETE] := tbl_F$L(idx).[SRC_DELETE];
			P_EI_FILE.[DST_DELETE] := tbl_F$L(idx).[DST_DELETE];
			P_EI_FILE.[SRC_PATH] := tbl_F$L(idx).[SRC_PATH];
			P_EI_FILE.[DST_PATH] := tbl_F$L(idx).[DST_PATH];
			P_EI_FILE.[SRC_TYPE] := tbl_F$L(idx).[SRC_TYPE];
			P_EI_FILE.[DST_TYPE] := tbl_F$L(idx).[DST_TYPE];
*/
PSH_DELFIOFILES is

execute is
idx pls_integer;

begin	
		idx := tbl_F$L.first;
		while  idx is not null
		loop
			--DEBUG_PIPE(&METHOD$ || ' ' || lpad(to_char(idx), 6)  || ' Удаление ' || tbl_F$L(idx).[SRC_NAME], 5);
			stdio.delete_file ( tbl_F$L(idx).[SRC_NAME] );
			idx := tbl_F$L.next(idx);
		end loop;
		tbl_F$L.delete;
		
exception when OTHERS then
	pragma error(sqlerrm);
end;
end;
end;
