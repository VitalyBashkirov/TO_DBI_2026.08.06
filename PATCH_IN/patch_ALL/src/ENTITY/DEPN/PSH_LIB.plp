class DEPN;

@import_plsql(true)
@name('PSH_LIB')
library PSH_LIB is
--Башкиров В.Г. 13.05.2019
public gDepn reference; gSum [SUMMA]; LastDateIFRS [DATE];

--Башкиров В.Г. 16.10.2022
public DATE_FOR_VIEW [DATE]; --Глобальная переменная для представлений
pragma include(::[RUNTIME].[DEBUG_MACRO]);
dp number:=null;	--управление &debug
dp1 number:=0;	--управление &debug
fmt string(10):='dd/mm/yyyy';
fmtt string(10):='dd.mm.yyyy';
d31 [DATE]:=to_date('31/12/2018',fmt);
d09 [DATE]:=to_date('09/01/2019',fmt);

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

public function GetUL(cl ref [CLIENT], p_add string(100) default null) return string(1024) is 
rClPriv ref [CL_PRIV];
oClPriv [CL_PRIV];
ret_str string(1024);
begin
	if cl%class='CL_PRIV' then
		rClPriv:=cl;
		oClPriv:=rClPriv;
		if    p_add='Серия'				then ret_str:=oClPriv.[DOC].[SER];
		elsif p_add='Номер'				then ret_str:=oClPriv.[DOC].[NUM];
		elsif p_add='Дата выдачи'		then ret_str:=iif(oClPriv.[DOC].[DATE] is null,'',to_char(oClPriv.[DOC].[DATE], fmt));
		elsif p_add='Дата окончания'	then ret_str:=iif(oClPriv.[DOC].[DATE_END] is null,'',to_char(oClPriv.[DOC].[DATE_END], fmt));
		elsif p_add='Дата акта смерти'	then ret_str:=iif(oClPriv.[DOC].[DATE_AKT_DEATH] is null,'',to_char(oClPriv.[DOC].[DATE_AKT_DEATH], fmt));
		elsif p_add='Кем выдан'			then ret_str:=iif(oClPriv.[DOC].[WHO] is null,'',oClPriv.[DOC].[WHO]);
		else
			ret_str:=trim(oClPriv.[DOC].[TYPE].[NAME]||' '
			||iif(oClPriv.[DOC].[SER] is null,'',' серия '||oClPriv.[DOC].[SER])
			||iif(oClPriv.[DOC].[NUM] is null,'',' №'||oClPriv.[DOC].[NUM])
			||iif(oClPriv.[DOC].[WHO] is null,'',' выдан '|| oClPriv.[DOC].[WHO])
			||iif(oClPriv.[DOC].[DATE] is null,'',' '||to_char(oClPriv.[DOC].[DATE], fmtt)));
		end if;
	end if;
	return ret_str;
end;

public function get_FactOperSumm(p_dp ::[DEPN], p_tfo string) return number(16,8) is 
	list_pay	::[DEPN].[LIST_PAY]%type;
	tmpSumm		[SUMMA];
begin
	select debt(debt.[LIST_PAY])
		in ::[DEPN] all where debt = p_dp
		into list_pay;	
	
	select f( sum(f.[SUMMA]): sm)	
    	in ::[FACT_OPER] all
	where f%collection = list_pay and f.oper = ::[VID_OPER_DOG]([code] = p_tfo)
		into tmpSumm;	


	return tmpSumm;
	exception when others then
	--pragma error(sqlerrm);
	return null;
end;

--Башкиров В.Г. 13.05.2019 [ПСБ] Журналы %% (Расчет корректировок)
public function GetDateJIFRS  (d in ::[DEPN], TypeInfo integer) return [DATE] is 
begin
	if TypeInfo=1 then
		for (select isp(isp.[DATE_BEG] : C_DATE_BEG) in ::[IFRS_STRING_PRC]
		where isp.[OBJ_REF]=d%id and isp.[DATE_END]<=d31
		order by isp.[DATE_BEG])
		loop
			return isp.C_DATE_BEG;
		end loop;
	else
		for (select isp(isp.[DATE_END] : C_DATE_END) in ::[IFRS_STRING_PRC]
		where isp.[OBJ_REF]=d%id and isp.[DATE_END]<=d31
		 order by isp.[DATE_END] desc)
		loop
			return isp.C_DATE_END;
		end loop;
	end if;
	return null;
end;

public function GetDateJIFRS_2(d in ::[DEPN], d1 in [DATE], d2 in [DATE], TypeInfo integer) return [DATE] is 
begin
	for (select isp(isp.[DATE_BEG] : C_DATE_BEG
				   ,isp.[DATE_END] : C_DATE_END
					) in ::[IFRS_STRING_PRC]
	where isp.[OBJ_REF]=d%id and isp.[DATE_END]<=d31
	order by isp.[DATE_BEG])
	loop
		if d1=d.[DATE_BEGIN] or d1=d.[DATE_BEGIN]+1 then
			if TypeInfo=1 then return d.[DATE_BEGIN];
			else			   return d.[DATE_ENDING];
			end if;
		end if;
		exit;
	end loop;
	return null;
end;

--строка с пролонгацией
--строка с пролонгацией ?
public function IsProl22      (d in ::[DEPN], d1 in [DATE], d2 in [DATE], TypeInfo integer) return number is 
begin
	if TypeInfo=22 then --строка с пролонгацией
		if d1=d2 then
			&debug('.IsProl22 -- '||to_char(d1,fmt)||'-'||to_char(d2,fmt),dp1)
			for (select lstp(lstp%id) in d.[LIST_PROL] where lstp.[PROL_BEG]=d1)
			loop
				&debug('.IsProl22 -- Пролонгация!!!',dp1)
				return 1;
			end loop;
		end if;
		return 0;
	end if;
	return 0;
end;

--%% по Журналу начисл.%% за расчетный период
function Sum19(d in ::[DEPN], d1 in [DATE], d2 in [DATE], TypeInfo integer) return [SUMMA] is
tSum [SUMMA];
dBeg [DATE];
dEnd [DATE];
begin
	if TypeInfo=19 then --%% по Журналу начисл.%% за расчетный период
		dEnd:=GetDateJIFRS(d,2);
		&debug('.Sum19 -- dEnd='||to_char(dEnd,fmt),dp1)
		if dEnd=d2 then
			dBeg:=GetDateJIFRS(d,1);
			&debug('.Sum19 -- dBeg='||to_char(dBeg,fmt),dp1)
			tSum:=0;
			for (select j(j.[SUMMA_PRC_ROUND] : C_SUMMA_PRC_ROUND
						 ,j.[DATE_BEG] : C_DATE_BEG
						 ,j.[DATE_END] : C_DATE_END
			) in d.[JOUR_CALC_PRC]
			where (dBeg<=j.[DATE_BEG] and j.[DATE_END]<=dEnd)
				and 1<>IsProl22(d,j.[DATE_BEG],j.[DATE_END],22))--not строка с пролонгацией
			loop
				--if 1<>IsProl22(d,j.C_DATE_BEG,j.C_DATE_END,22) then --not строка с пролонгацией
					&debug('.Sum19 -- ЖНП:'||to_char(j.C_DATE_BEG,fmt)||'-'||to_char(j.C_DATE_END,fmt)||' j.C_SUMMA_PRC_ROUND='||j.C_SUMMA_PRC_ROUND,dp1)	
					tSum:=tSum+j.C_SUMMA_PRC_ROUND;
				--end if;
			end loop;
			&debug('.Sum19 -- tSum='||tSum,dp1)
			return tSum;
		end if;
	end if;
	return null;
end;

--%% по Журналу стоимости ФИ (МСФО) за расчетный период
function Sum20(d in ::[DEPN], d1 in [DATE], d2 in [DATE], TypeInfo integer) return [SUMMA] is
tSum [SUMMA];
dBeg [DATE];
dEnd [DATE];
begin
	if TypeInfo=20 then
		dEnd:=GetDateJIFRS(d,2);
		if dEnd=d2 then
			tSum:=0;
			dBeg:=GetDateJIFRS(d,1);
			for (select isp(isp.[SUM_PRC] : C_SUM_PRC) in ::[IFRS_STRING_PRC]
			where isp.[OBJ_REF]=d%id and(dBeg<=isp.[DATE_BEG] and isp.[DATE_END]<=dEnd))
			loop
				tSum:=tSum+isp.C_SUM_PRC;
			end loop;
			return tSum;
		end if;
	end if;
	return null;
end;

--Сумма для документа корректировки
function Sum21(d in ::[DEPN], d1 in [DATE], d2 in [DATE], TypeInfo integer) return [SUMMA] is
tSum19 [SUMMA];
tSum20 [SUMMA];
begin
	tSum19:=Sum19(d,d1,d2,19); 	--%% по Журналу начисл.%% за расчетный период
    &debug('.Sum21 -- tSum19='||tSum19,dp1)

	if tSum19 is not null then
	   tSum20:=Sum20(d,d1,d2,20); --%% по Журналу стоимости ФИ (МСФО) за расчетный период
	   &debug('.Sum21 -- tSum20='||tSum20,dp1)
	   return tSum19-tSum20;
	end if;
	
	return null;
end;

public function GetInfoJIFRS  (d in ::[DEPN], d1 in [DATE], d2 in [DATE], TypeInfo integer) return varchar2 is 
vDoc ref [DOCUMENT];
md ref [MAIN_DOCUM];
tSum [SUMMA];
dBeg [DATE];
dEnd [DATE];
begin
	if TypeInfo=16 and (gDepn is null or gDepn<>d%id or LastDateIFRS is null or LastDateIFRS>d1) then
		gDepn:=d%id;
		LastDateIFRS=dBeg:=GetDateJIFRS(d,1);
		gSum:=null;
		&debug('.GetInfoJIFRS -- =1= №'||d.[NUM_DOG]||' LastDateIFRS='||to_char(LastDateIFRS,fmt),dp1)
	end if;

	for (select isp(isp.[DATE_BEG] : C_DATE_BEG
				   ,isp.[DATE_END] : C_DATE_END
				   ,isp.[DAYS] : C_DAYS_IFRS
				   ,isp.[SUM_COST_BEFORE] : C_SUM_COST_BEFORE
				   ,isp.[SUM_COST_AFTER] : C_SUM_COST_AFTER
				   ,isp.[RATE] : C_RATE
				   ,isp.[IS_MARKET] : C_IS_MARKET
				   ,isp.[SUM_PRC] : C_SUM_PRC
					) in ::[IFRS_STRING_PRC]
	where isp.[OBJ_REF]=d%id and
		isp.[DATE_BEG]<=d1 and d1<=isp.[DATE_END] and
		isp.[DATE_BEG]<=d2 and d2<=isp.[DATE_END]
	order by isp.[DATE_BEG])
	loop
		if d2=isp.C_DATE_END then
			if TypeInfo=16 then
				dEnd:=isp.C_DATE_END ;
				&debug('.GetInfoJIFRS -- -2- ЖСФИ.МСФО LastDateIFRS-dEnd '||to_char(LastDateIFRS,fmt)||'-'||to_char(dEnd,fmt),dp1)
			end if;
		
			if    TypeInfo=1 then --ЖСФИ. МСФО. Сумма АС/СС до ДП
				  return isp.C_SUM_COST_BEFORE;
			elsif TypeInfo=2 then --ЖСФИ. МСФО. Количество дней
				  return isp.C_DAYS_IFRS; --d2-d1+1;
			elsif TypeInfo=3 then --ЖСФИ. МСФО. Сумма АС/СС после ДП
				  if d2<isp.C_DATE_END then return isp.C_SUM_COST_BEFORE;
				  else					    return isp.C_SUM_COST_AFTER;	
				  end if;
			elsif TypeInfo=4 then --ЖСФИ. МСФО. Сумма %% ЭПС
			    --return round(isp.C_SUM_COST_BEFORE*(d2-d1+1)*isp.C_RATE/365/100,6);
				--return round(round(isp.C_SUM_COST_BEFORE,2)*(d2-d1+1)*isp.C_RATE/365/100,2);
				  return isp.C_SUM_PRC;
			elsif TypeInfo=5 then --ЖСФИ. МСФО. Процентная ставка
				  return isp.C_RATE;
			elsif TypeInfo=6 then --ЖСФИ. МСФО. РПС
				  return isp.C_IS_MARKET;
			elsif TypeInfo=7 then --ЖСФИ. МСФО. Документ корректировки
				  if d2=d31 then
				  	for (select lp(lp.[DOC] : C_DOC) in d.[LIST_PAY]
				  	where lp.[DATE]=d09 and
				  		lp.[OPER] in
				  			(::[VID_OPER_DOG]([CODE]='КОР_БС_АС_МИНУС'), --МСФО. Корректировки, уменьшающие стоимость до АС
				  			 ::[VID_OPER_DOG]([CODE]='КОР_БС_АС_ПЛЮС'))) --МСФО. Корректировки, увеличивающие стоимость до АС
				  	loop
				  		vDoc:=lp.C_DOC;
				  		return vDoc%class||'.'||vDoc%id||'.'||vDoc%state;
				  	end loop;
				  	--Ищем фин распоряги
				  	for fo in ::[FIN_ORDER]
				  	where fo.[DATE_OPER]=d09
				  		and fo.[PATTERN_DOC_REF]=::[PATTERN_DOC]([PATTERN_CODE]='DEP_ADJ_AC') --МСФО. Корректировка до амортизированной стоимости
				  		and fo.[PRODUCT]=d
				  	loop	
				  		for dcm in fo.[DOCUMENTS] loop
				  			if dcm.[]%class = 'MAIN_DOCUM' then
				  				md:=dcm.[];
				  				if md.[ACC_DT].[MAIN_V_ID] like '10%' or md.[ACC_KT].[MAIN_V_ID] like '10%' then
				  					vDoc:=md;
				  					return vDoc%class||'.'||vDoc%id||'.'||vDoc%state;			
				  				end if;
				  			end if;
				  		end loop;
				  	end loop;
				  end if;
			elsif TypeInfo in (8,9,10,11,12,13,14,15) then --ЖСФИ. МСФО. Документ корректировки. №,Вид,Дата проводки,Сумма Дт, Сумма Кт, Дт,Кт, Назначение
				  if d2=d31 then
				  	for (select lp(lp.[DOC] : C_DOC) in d.[LIST_PAY]
				  	where lp.[DATE]=d09 and
				  		lp.[OPER] in
				  			(::[VID_OPER_DOG]([CODE]='КОР_БС_АС_МИНУС'), --МСФО. Корректировки, уменьшающие стоимость до АС
				  			 ::[VID_OPER_DOG]([CODE]='КОР_БС_АС_ПЛЮС'))) --МСФО. Корректировки, увеличивающие стоимость до АС
				  	loop
				  		vDoc:=lp.C_DOC;
				  		if vDoc%class='MAIN_DOCUM' then md:=vDoc;
				  			if    TypeInfo = 8 then return md.[DOCUMENT_NUM]; 		  --№
				  			elsif TypeInfo = 9 then return md.[VID_DOC].[SHORT_NAME]; --Вид
				  			elsif TypeInfo =10 then return to_char(md.[DATE_VAL],fmt);--Дата проводки
				  			elsif TypeInfo =11 then return md.[SUM]; 				  --Сумма Дт
				  			elsif TypeInfo =12 then return md.[SUM_PO]; 			  --Сумма Кт
				  			elsif TypeInfo =13 then return md.[ACC_DT].[MAIN_V_ID];   --Дт
				  			elsif TypeInfo =14 then return md.[ACC_KT].[MAIN_V_ID];   --Кт
				  			elsif TypeInfo =15 then return md.[NAZN];   			  --Назначение
				  			end if;
				  		end if;
				  		exit;
				  	end loop;
				  	--Ищем фин распоряги
				  	for fo in ::[FIN_ORDER]
				  	where fo.[DATE_OPER]=d09
				  		and fo.[PATTERN_DOC_REF]=::[PATTERN_DOC]([PATTERN_CODE]='DEP_ADJ_AC') --МСФО. Корректировка до амортизированной стоимости
				  		and fo.[PRODUCT]=d
				  	loop	
				  		for dcm in fo.[DOCUMENTS] loop
				  			if dcm.[]%class = 'MAIN_DOCUM' then
				  				md:=dcm.[];
				  				if md.[ACC_DT].[MAIN_V_ID] like '10%' or md.[ACC_KT].[MAIN_V_ID] like '10%' then
						  			if    TypeInfo = 8 then return md.[DOCUMENT_NUM]; 		  --№
						  			elsif TypeInfo = 9 then return md.[VID_DOC].[SHORT_NAME]; --Вид
						  			elsif TypeInfo =10 then return to_char(md.[DATE_VAL],fmt);--Дата проводки
						  			elsif TypeInfo =11 then return md.[SUM]; 				  --Сумма Дт
						  			elsif TypeInfo =12 then return md.[SUM_PO]; 			  --Сумма Кт
						  			elsif TypeInfo =13 then return md.[ACC_DT].[MAIN_V_ID];   --Дт
						  			elsif TypeInfo =14 then return md.[ACC_KT].[MAIN_V_ID];   --Кт
						  			elsif TypeInfo =15 then return md.[NAZN];   			  --Назначение
						  			end if;
				  				end if;
				  			end if;
				  		end loop;
				  	end loop;
				  end if;
			elsif TypeInfo=17 then --ЖСФИ. МСФО. Дата начала периода
				  return to_char(isp.C_DATE_BEG,fmt);
			elsif TypeInfo=18 then --ЖСФИ. МСФО. Дата окончания периода
				  return to_char(isp.C_DATE_END,fmt);
			elsif TypeInfo=19 then return Sum19(d,d1,d2,TypeInfo); --%% по Журналу начисл.%% за расчетный период
			elsif TypeInfo=20 then return Sum20(d,d1,d2,TypeInfo); --%% по Журналу стоимости ФИ (МСФО) за расчетный период
			elsif TypeInfo=21 then return Sum21(d,d1,d2,TypeInfo); --Сумма для документа корректировки
			end if;
		end if;
	end loop;
	if TypeInfo=16 and LastDateIFRS is not null and dEnd is not null then --ДП по Журналу начисл. %%
		&debug('.GetInfoJIFRS -- .3. Смотрим ЖНП для '||to_char(LastDateIFRS,fmt)||'-'||to_char(dEnd,fmt),dp1)
		for (select j(j.[SUMMA_PRC_ROUND] : C_SUMMA_PRC_ROUND
					 ,j.[DATE_BEG] : C_DATE_BEG
					 ,j.[DATE_END] : C_DATE_END
					 ) in d.[JOUR_CALC_PRC]
		where (LastDateIFRS<=j.[DATE_BEG] and j.[DATE_END]<=dEnd)
			and 1<>IsProl22(d,d1,d2,22) --not строка с пролонгацией
			--and
			--(
			--  (j.[DATE_BEG]<=gD1 and gD1<=j.[DATE_END])
			--  or
			--  (j.[DATE_BEG]<=gD2 and gD2<=j.[DATE_END])
			--)
			)
		loop
			gSum:=nvl(gSum,0)-j.C_SUMMA_PRC_ROUND;
			&debug('.GetInfoJIFRS -- ЖНП j.[DATE_BEG]='||to_char(j.C_DATE_BEG,fmt)||' j.[DATE_END]='||to_char(j.C_DATE_END,fmt)||' j.[SUMMA_PRC_ROUND]='||j.C_SUMMA_PRC_ROUND||' gSum='||gSum,dp1)
		end loop;
		LastDateIFRS:=nvl(dEnd,LastDateIFRS);
		&debug('.GetInfoJIFRS -- ДП по Журналу начисл.%% gSum='||gSum||' LastDateIFRS='||to_char(LastDateIFRS,fmt),dp1)
		tSum:=gSum; gSum:=null;
		return tSum;
	end if;
	return null;
end;

--Клиент - пользователь ?
public function Is_User(cl ref [CLIENT]) return string(3) is 
begin
	for (select c(c%id : C_ID) in ::[USER] where c.[CL_PRIV_REF]%id=cl%id) loop
		return 'Да';
	end loop;
	return 'Нет';
end;


--Башкиров В.Г. 30.09.2022
public function ErrCalc (d in ::[DEPN]) return varchar2 is 
flErr boolean;
ExStr string(100);
--d_BeginYear [DATE]:=DATEFUN.boy(d.[FILIAL].[OP_DATE]);
d21092022 [DATE]:=to_date('21/09/2022',fmt);
begin
	if d.[VID_DOG] in (
			 [VID_DEPOSIT]([CODE]='PSB_CARD_RUB_001')	--Карточный в РУБЛЯХ для частных лиц
			,[VID_DEPOSIT]([CODE]='PSB_CARD_OLD')		--Карточный старый для частных лиц
			,[VID_DEPOSIT]([CODE]='PSB_CARD_RU_001E')	--Карточный в РУБЛЯХ для сотрудников Банка
			,[VID_DEPOSIT]([CODE]='PSB_NAD_91_6.5')		--Надежный. 2022 RUB 91 день
			,[VID_DEPOSIT]([CODE]='PSB_NAD_181_6')		--Надежный. 2022 RUB 181 день
--			,[VID_DEPOSIT]([CODE]='PSB_NAD_91')			--Надежный. 2022 RUB 91 день
			)
	then

		for jcp in var oJcp d.[JOUR_CALC_PRC] 
		where jcp.[DATE_BEG]<=d21092022 and d21092022<=jcp.[DATE_END]
		loop
			flErr:=false;
			ExStr:='';
			
			if d.[VID_DOG]=[VID_DEPOSIT]([CODE]='PSB_CARD_RUB_001')   and oJcp.[PRC]<>6   then flErr:=true; --Карточный в РУБЛЯХ для частных лиц
			elsif d.[VID_DOG]=[VID_DEPOSIT]([CODE]='PSB_CARD_OLD')    and oJcp.[PRC]<>6   then flErr:=true; --Карточный старый для частных лиц
			elsif d.[VID_DOG]=[VID_DEPOSIT]([CODE]='PSB_CARD_RU_001E')and oJcp.[PRC]<>6   then flErr:=true; --Карточный в РУБЛЯХ для сотрудников Банка
			elsif d.[VID_DOG]=[VID_DEPOSIT]([CODE]='PSB_NAD_91_6.5')  and oJcp.[PRC]<>6.5 then flErr:=true; --Надежный. 2022 RUB 91 день
			elsif d.[VID_DOG]=[VID_DEPOSIT]([CODE]='PSB_NAD_181_6')   and oJcp.[PRC]<>6   then flErr:=true; --Надежный. 2022 RUB 181 день
			end if;

			if flErr then
				ExStr:=oJcp.[PRC]||'% '||to_char(jcp.[DATE_BEG],fmt)||'-'||to_char(jcp.[DATE_END],fmt);
				return ExStr;
			end if;
		end loop;
	end if;
	return null;
end;

--Башкиров В.Г. 16.10.2022
public function Get_DATE_FOR_VIEW return [DATE] is 
begin
	return DATE_FOR_VIEW; --Глобальная переменная для представлений
end;

--Башкиров В.Г. 21.10.2022
public function GetStatusOnDate(prd ref [PRODUCT], DateOn [DATE]) return [NAME] is 
ExStatus ref [COM_STATUS_PRD];
ExStatusName [NAME];
rDepn ref [DEPN];
rRKO ref [RKO];
oDepn ref [DEPN];
oRKO ref [RKO];

vDATE_BEGIN		[DATE]; -- Дата создания договора
vDATE_BEGINING	[DATE]; -- Дата начала действия договора
vDATE_ENDING	[DATE]; -- Дата окончания действия договора
vDATE_CLOSE		[DATE]; -- Дата закрытия договора

mAddAgrArr [ADD_AGR_ARR];
rADD_AGR ref [ADD_AGR];
oADD_AGR [ADD_AGR];

ProlsContract [PROLS_CONTRACT];

DateOpenAcc [DATE];
rAcc ref [AC_FIN];
oAcc [AC_FIN];

ExName [NAME];
begin
	if prd%class in ('DEPN','DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then
		rDepn:=prd;
		oDepn:=rDepn;
		vDATE_BEGIN		:=oDepn.[DATE_BEGIN];
		vDATE_BEGINING	:=oDepn.[DATE_BEGINING];
		vDATE_ENDING	:=oDepn.[DATE_ENDING];
		vDATE_CLOSE		:=oDepn.[DATE_CLOSE];
	  --mAddAgrArr		:=oDepn.[ADD_AGR_ARR];
		ProlsContract	:=oDepn.[LIST_PROL];
		rAcc			:=oDepn.[ACCOUNT];
		oAcc			:=rAcc;
	elsif prd%class in ('RKO','RKO_CUR') then
		rRKO:=prd;
		oRKO:=rRKO;
		vDATE_BEGIN		:=oRKO.[DATE_BEGIN];
		vDATE_BEGINING	:=oRKO.[DATE_BEGINING];
		vDATE_ENDING	:=oRKO.[DATE_ENDING];
		vDATE_CLOSE		:=oRKO.[DATE_CLOSE];
		mAddAgrArr		:=oRKO.[ADD_AGR_ARR];
		rAcc			:=oRKO.[ACCOUNT];
		oAcc			:=rAcc;
	end if;
	
	if rDepn is not null or rRKO is not null then
		if vDATE_BEGINING is null	then vDATE_BEGINING:=oAcc.[DATE_OP]; end if;
		if vDATE_CLOSE is null		then vDATE_CLOSE:=oAcc.[DATE_CLOSE]; end if;
		
		if vDATE_BEGINING is null	then vDATE_BEGINING:=vDATE_BEGIN; end if;
		if vDATE_BEGIN    is null	then vDATE_BEGIN:=vDATE_BEGINING; end if;

		if		DateOn<vDATE_BEGIN then ExStatus:=null; rAcc:=null; oAcc:=null;
		elsif	vDATE_BEGIN=DateOn and DateOn=vDATE_BEGINING	then ExStatus:=::[COM_STATUS_PRD]([CODE]='WORK');		&debug('1',dp)
		elsif	vDATE_BEGIN<=DateOn and DateOn<vDATE_BEGINING	then ExStatus:=::[COM_STATUS_PRD]([CODE]='WAIT_CONF');	&debug('2',dp)
		elsif	vDATE_BEGINING<=DateOn and DateOn<vDATE_CLOSE	then ExStatus:=::[COM_STATUS_PRD]([CODE]='WORK');		&debug('3',dp)
		elsif	vDATE_BEGINING<=DateOn and vDATE_CLOSE is null	then ExStatus:=::[COM_STATUS_PRD]([CODE]='WORK');		&debug('4',dp)
		elsif	vDATE_CLOSE<=DateOn								then ExStatus:=::[COM_STATUS_PRD]([CODE]='CLOSE');		&debug('5',dp)
			--rAcc:=null; oAcc:=null;
		end if;
		if rAcc is not null then ExName:=ExStatus.[NAME]; end if;

		if rRKO is not null then
			&debug(rRKO.[NUM_DOG]||' '||rRKO.[CLIENT].[NAME]||' '||to_char(DateOn,fmt)||' '||oAcc.[MAIN_V_ID],dp)
			&debug('vDATE_BEGIN    = '||to_char(vDATE_BEGIN,fmt),dp)
			&debug('vDATE_BEGINING = '||to_char(vDATE_BEGINING,fmt),dp)
			&debug('DateOn         = '||to_char(DateOn,fmt)||' ExName='||ExName||' '||oAcc.[MAIN_V_ID],dp)
			&debug('vDATE_CLOSE    = '||to_char(vDATE_CLOSE,fmt),dp)
		
		
		elsif rDepn is not null then --and ProlsContract%size(1)>0 then
			&debug(rDepn.[NUM_DOG]||' '||rDepn.[CLIENT].[NAME]||' '||to_char(DateOn,fmt)||' '||oAcc.[MAIN_V_ID],dp)
			&debug('vDATE_BEGIN    = '||to_char(vDATE_BEGIN,fmt),dp)
			&debug('vDATE_BEGINING = '||to_char(vDATE_BEGINING,fmt),dp)
			&debug('DateOn         = '||to_char(DateOn,fmt)||' ExName='||ExName,dp)
			&debug('vDATE_CLOSE    = '||to_char(vDATE_CLOSE,fmt),dp)
		
			for (select pcnt(pcnt.[PREV_ACCOUNT] : C_PREV_ACCOUNT) in ProlsContract where pcnt.[PROL_BEGIN]<=DateOn and DateOn<=pcnt.[PROL_END]
		  --order by pcnt.[PROL_BEGIN]
				)
			loop
				--A1.[PROL_BEGIN] : C_PROL_BEGIN,				--Дата вступления в силу
				--A1.[PROL_BEG] : C_PROL_BEG,					--Дата начала
				--A1.[PROL_END] : C_PROL_END,					--Дата окончания
				--A1.[LAST_DATE_ENDING] : C_LAST_DATE_ENDING,	--Предыдущая дата окончания договора
				ExStatus:=::[COM_STATUS_PRD]([CODE]='WORK');
				if rAcc is not null then ExName:=ExStatus.[NAME]; end if;
				exit;
			end loop;
		end if;
	end if;
	return ExName;
end;
-----------
public function GetAccOnDate(prd ref [PRODUCT], DateOn [DATE]) return ref [AC_FIN] is 
ExStatus ref [COM_STATUS_PRD];
ExStatusName [NAME];
rDepn ref [DEPN];
rRKO ref [RKO];
oDepn ref [DEPN];
oRKO ref [RKO];

vDATE_BEGIN		[DATE]; -- Дата создания договора
vDATE_BEGINING	[DATE]; -- Дата начала действия договора
vDATE_ENDING	[DATE]; -- Дата окончания действия договора
vDATE_CLOSE		[DATE]; -- Дата закрытия договора

mAddAgrArr [ADD_AGR_ARR];
rADD_AGR ref [ADD_AGR];
oADD_AGR [ADD_AGR];

ProlsContract [PROLS_CONTRACT];

DateOpenAcc [DATE];
rAcc ref [AC_FIN];
oAcc [AC_FIN];

ExName [NAME];
begin
	if prd%class in ('DEPN','DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then
		rDepn:=prd;
		oDepn:=rDepn;
		vDATE_BEGIN		:=oDepn.[DATE_BEGIN];
		vDATE_BEGINING	:=oDepn.[DATE_BEGINING];
		vDATE_ENDING	:=oDepn.[DATE_ENDING];
		vDATE_CLOSE		:=oDepn.[DATE_CLOSE];
	  --mAddAgrArr		:=oDepn.[ADD_AGR_ARR];
		ProlsContract	:=oDepn.[LIST_PROL];
		rAcc			:=oDepn.[ACCOUNT];
		oAcc			:=rAcc;
	elsif prd%class in ('RKO','RKO_CUR') then
		rRKO:=prd;
		oRKO:=rRKO;
		vDATE_BEGIN		:=oRKO.[DATE_BEGIN];
		vDATE_BEGINING	:=oRKO.[DATE_BEGINING];
		vDATE_ENDING	:=oRKO.[DATE_ENDING];
		vDATE_CLOSE		:=oRKO.[DATE_CLOSE];
		mAddAgrArr		:=oRKO.[ADD_AGR_ARR];
		rAcc			:=oRKO.[ACCOUNT];
		oAcc			:=rAcc;
	end if;
	
	if rDepn is not null or rRKO is null then
		if vDATE_BEGINING is null	then vDATE_BEGINING:=oAcc.[DATE_OP]; end if;
		if vDATE_CLOSE is null		then vDATE_CLOSE:=oAcc.[DATE_CLOSE]; end if;
		
		if vDATE_BEGINING is null	then vDATE_BEGINING:=vDATE_BEGIN; end if;
		if vDATE_BEGIN    is null	then vDATE_BEGIN:=vDATE_BEGINING; end if;

		if		DateOn<vDATE_BEGIN then ExStatus:=null; rAcc:=null; oAcc:=null;
		elsif	vDATE_BEGIN=DateOn and DateOn=vDATE_BEGINING	then ExStatus:=::[COM_STATUS_PRD]([CODE]='WORK');
		elsif	vDATE_BEGIN<=DateOn and DateOn<vDATE_BEGINING	then ExStatus:=::[COM_STATUS_PRD]([CODE]='WAIT_CONF');
		elsif	vDATE_BEGINING<=DateOn and DateOn<vDATE_CLOSE	then ExStatus:=::[COM_STATUS_PRD]([CODE]='WORK');
		elsif	vDATE_BEGINING<=DateOn and vDATE_CLOSE is null	then ExStatus:=::[COM_STATUS_PRD]([CODE]='WORK');
		elsif	vDATE_CLOSE<=DateOn								then ExStatus:=::[COM_STATUS_PRD]([CODE]='CLOSE');
			--rAcc:=null; oAcc:=null;
		end if;
		if rAcc is not null then ExName:=ExStatus.[NAME]; end if;

		if rRKO is not null then
			&debug(rRKO.[NUM_DOG]||' '||rRKO.[CLIENT].[NAME]||' '||to_char(DateOn,fmt)||' '||oAcc.[MAIN_V_ID],dp)
			&debug('vDATE_BEGIN    = '||to_char(vDATE_BEGIN,fmt),dp)
			&debug('vDATE_BEGINING = '||to_char(vDATE_BEGINING,fmt),dp)
			&debug('DateOn         = '||to_char(DateOn,fmt)||' ExName='||ExName,dp)
			&debug('vDATE_CLOSE    = '||to_char(vDATE_CLOSE,fmt),dp)
		
		elsif rDepn is not null then --and ProlsContract%size(1)>0 then
			&debug(rDepn.[NUM_DOG]||' '||rDepn.[CLIENT].[NAME]||' '||to_char(DateOn,fmt)||' '||oAcc.[MAIN_V_ID],dp)
			&debug('vDATE_BEGIN    = '||to_char(vDATE_BEGIN,fmt),dp)
			&debug('vDATE_BEGINING = '||to_char(vDATE_BEGINING,fmt),dp)
			&debug('DateOn         = '||to_char(DateOn,fmt)||' ExName='||ExName,dp)
			&debug('vDATE_CLOSE    = '||to_char(vDATE_CLOSE,fmt),dp)

			for (select pcnt(pcnt.[PREV_ACCOUNT]	: C_PREV_ACCOUNT
				,pcnt.[PROL_BEGIN]					: C_PROL_BEGIN
				,pcnt.[PROL_END]					: C_PROL_END
			) in ProlsContract 
			order by pcnt.[PROL_BEGIN]
				)
			loop
				if pcnt.C_PROL_BEGIN<=DateOn and DateOn<=pcnt.C_PROL_END then
					--A1.[PROL_BEGIN] : C_PROL_BEGIN,				--Дата вступления в силу
					--A1.[PROL_BEG] : C_PROL_BEG,					--Дата начала
					--A1.[PROL_END] : C_PROL_END,					--Дата окончания
					--A1.[LAST_DATE_ENDING] : C_LAST_DATE_ENDING,	--Предыдущая дата окончания договора
					ExStatus:=::[COM_STATUS_PRD]([CODE]='WORK');
					ExName:=ExStatus.[NAME];
					exit;
				end if;
				if pcnt.C_PROL_END is not null then
					rAcc:=pcnt.C_PREV_ACCOUNT;
				end if;
			end loop;
		end if;
	end if;
	return rAcc;
end;
