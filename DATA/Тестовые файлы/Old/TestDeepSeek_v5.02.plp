-- ============================================================================
-- Правило: v5.STYLE.CODE_IN_COMMENT.п.4.6
-- Описание: Удалите закомментированный код
-- Категория: STYLE
-- Приоритет: medium
-- Теги: comment, code, cleanup
-- 3.RUBRICATOR_FIXES.md: Удалите закомментированный код
-- 4.RUBRICATOR_PROMPTS.json:
--   documentation_text: Закомментированный код засоряет код и должен быть удален.
--   plplus_materials_note: Используйте систему контроля версий для хранения истории изменений.
--   search_prompt: Найти закомментированные строки кода.
--   code_example_bad: -- DELETE FROM table WHERE id = 1;
--   fix_instruction: Удалить закомментированный код.
-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_CODE_IN_COMMENT_p_4_6 IS
    v_id NUMBER := 1;
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.CODE_IN_COMMENT.п.4.6 Удалите закомментированный код =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- v_id := 2;
        -- DELETE FROM table WHERE id = v_id;
        
        -- [+] ПРАВИЛЬНО
        v_id := 2;
        -- обновление выполнено
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;

-- ============================================================================
-- Правило: v5.STYLE.EXIST_ALL_OR_COLLECTIONS.п.4.7
-- Описание: Обращение к ТБП без опций all и collection
-- Категория: STYLE
-- Приоритет: medium
-- Теги: tbp, all, collection
-- 3.RUBRICATOR_FIXES.md: Обращение к ТБП без опций all и collection
-- 4.RUBRICATOR_PROMPTS.json:
--   documentation_text: При обращении к ТБП необходимо указывать all или collection.
--   plplus_materials_note: Опции all и collection определяют режим выборки из ТБП.
--   search_prompt: Найти обращения к ТБП без all и collection.
--   code_example_bad: SELECT * FROM ::[SOME_TBP];
--   fix_instruction: Добавить условие на collection is null.
-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_EXIST_ALL_p_4_7 IS
    v_id NUMBER;
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.EXIST_ALL_OR_COLLECTIONS.п.4.7 Обращение к ТБП без опций all и collection =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- SELECT id INTO v_id FROM ::[CLIENT] WHERE id = 1;
        
        -- [+] ПРАВИЛЬНО
        SELECT id INTO v_id FROM ::[CLIENT] WHERE collection IS NULL AND id = 1;
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;

-- ============================================================================
-- Правило: v5.STYLE.NOT_MENTIONED.п.4.8
-- Описание: Переменная/Параметр/Алиас более нигде не упоминается
-- Категория: STYLE
-- Приоритет: low
-- Теги: unused, variable, cleanup
-- 3.RUBRICATOR_FIXES.md: Переменная/Параметр/Алиас более нигде не упоминается
-- 4.RUBRICATOR_PROMPTS.json:
--   documentation_text: Неиспользуемые переменные и параметры следует удалять.
--   plplus_materials_note: Неиспользуемый код усложняет поддержку.
--   search_prompt: Найти объявления переменных, которые не используются.
--   code_example_bad: v_unused NUMBER;
--   fix_instruction: Удалить неиспользуемую переменную.
-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_NOT_MENTIONED_p_4_8 IS
    v_used NUMBER := 1;
    v_unused NUMBER := 2;
    v_result NUMBER;
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.NOT_MENTIONED.п.4.8 Переменная/Параметр/Алиас более нигде не упоминается =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- v_unused NUMBER := 2; -- не используется
        
        -- [+] ПРАВИЛЬНО
        v_result := v_used * 2;
        debug_pipe('Result: ' || v_result, 0);
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;

