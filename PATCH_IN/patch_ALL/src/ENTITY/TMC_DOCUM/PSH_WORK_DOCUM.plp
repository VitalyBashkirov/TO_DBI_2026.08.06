::[TMC_DOCUM].[WORK_DOCUM].V_SUM_WITHOUT_NDS_PD   :=V_SUM_WITHOUT_NDS_PD   ;
::[TMC_DOCUM].[WORK_DOCUM].V_SUM_NDS_PD           :=V_SUM_NDS_PD           ;
