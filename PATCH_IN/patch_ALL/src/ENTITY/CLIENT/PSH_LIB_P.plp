			else
		 		P_DATA := nvl(::[RUNTIME].[FDP].pdat(client_priv.[DATE_FORM_UPD]), '');
	 		end if;
*/
		elsif p_info = 'ДАТА_ЗАПОЛН_NEW' then		--Дата заполнения
--> ivanov a.v. 17/04/2017 Анкета
			P_DATA := '';
			P_DATA:=::[RUNTIME].[FDP].pdat(t_date_upd.first)||';';
--< ivanov a.v. 17/04/2017 Анкета

		-- Башкиров В.Г. 11.03.2012
		elsif p_info = 'ДАТА_ОБНОВЛ_ALL' 	then		--Дата обновления
			/** /
			if client_org_ref is not null then
				P_DATA := GetEditDates_(client_org_ref, P_DATE_PRINT, client_corp.[DATE_FORM_UPD]);
			else
				P_DATA := GetEditDates_(cl_ref, P_DATE_PRINT, client_priv.[DATE_FORM_UPD]);
			end if;
			/**/
			
			--NGA07082013 Берем из массивов "Даты обновлений" и "История рекв.". См.описание функции!
			if client_corp%id is not NULL then
			   P_DATA := ::[CLIENT].[PSH_LIB_P].GetDateAll(client_ref, P_DATE_PRINT);
			   if trim(P_DATA) is NULL then
			      P_DATA:=::[CL_HIST].[PSH_LIB].GetLastEditAll(cl_ref,false,DATE_TMP_1,DATE_TMP_2); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
			   end if;
			elsif client_priv%id is not null then
			   P_DATA:=::[CL_HIST].[PSH_LIB].GetLastEditAll(cl_ref,false,DATE_TMP_1,DATE_TMP_2); -- как было -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
			end if;
			--NGA07082013 end
			--NGA07082013 P_DATA:=::[CL_HIST].[PSH_LIB].GetLastEditAll(cl_ref,false,DATE_TMP_1,DATE_TMP_2); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
			
			/* NGA07082013 отключим -- Башкиров В.Г. 22.08.2012
			P_DATE_UPD:=::[CL_DATE_FORM_UPD].[PSH_LIB].GetLastDateFormUpd(cl_ref); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
			debug_pipe('PSB_WRD_FIZCL_AN -- P_DATE_UPD='||to_char(P_DATE_UPD,fmt)||' P_DATA='||P_DATA,dp);
		  --debug_pipe('PSB_WRD_FIZCL_AN -- P_DATE_UPD='||P_DATE_UPD||' P_DATA='||P_DATA,dp);
			if P_DATE_UPD is not null and nvl(InStr(P_DATA,to_char(P_DATE_UPD,fmt)),0)=0 then
				P_DATA:=to_char(P_DATE_UPD,fmt)||';'||P_DATA;
				P_DATA:=trim(P_DATA,';');
			end if;
		    NGA*/
		elsif p_info = 'ДАТА_ОБНОВЛ_ALL_N' 	then		--Дата обновления
--> ivanov a.v. 17/04/2017 Анкета
		P_DATA := '';
		v_idx_upd := t_date_upd.first;
		v_idx_upd := t_date_upd.next(v_idx_upd);
		while v_idx_upd is not null loop
			if P_DATA is not null then
				P_DATA := P_DATA||'; '||to_char(t_date_upd(v_idx_upd).date_upd,'dd/mm/yyyy');
			else
				P_DATA := P_DATA||to_char(t_date_upd(v_idx_upd).date_upd,'dd/mm/yyyy');
			end if;
		v_idx_upd := t_date_upd.next(v_idx_upd);
		end loop;
		if P_DATA is null then
			P_DATA := '.';
		end if;
--< ivanov a.v. 17/04/2017 Анкета

		-- Башкиров В.Г. 15.09.2011
		elsif p_info = 'ДАТА_ОБНОВЛ' then		--Дата обновления
		    --NGA07082013 ДЛЯ ИП для поиска в дальнейшем массива дат обновления
		    if ip then
			   /*if    client_corp%id is not NULL then
			         client_ref:=client_corp%id;
			   elsif client_priv%id is not NULL then
			         client_ref:=client_priv%id;
			   else
			      client_ref:=cl_ref%id;
			   end if;*/
			   --NGA07082013 Берем из массивов "Даты обновлений" и "История рекв.". См.описание функции!
    	       P_DATA := ::[CLIENT].[PSH_LIB_P].GetDateAll(cl_ref, P_DATE_PRINT);
			   if trim(P_DATA) is NULL then
			      ::[CL_HIST].[PSH_LIB].GetLastEdit(cl_ref,false,DATE_TMP_1,DATE_TMP_2); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
			      P_DATA:=::[RUNTIME].[FDP].pdat(DATE_TMP_2);
			   end if;
		    else
			   ::[CL_HIST].[PSH_LIB].GetLastEdit(cl_ref,false,DATE_TMP_1,DATE_TMP_2); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
			   P_DATA:=::[RUNTIME].[FDP].pdat(DATE_TMP_2);
		   end if;			
		   --NGA07082013 end
			
			/*NGA07082013
			::[CL_HIST].[PSH_LIB].GetLastEdit(cl_ref,false,DATE_TMP_1,DATE_TMP_2); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
			P_DATA:=::[RUNTIME].[FDP].pdat(DATE_TMP_2);
            NGA*/
		
		elsif p_info = 'УРОВЕНЬ_РИСКА' then	 	--Уровень риска
			if client_corp%id is not null then
				-- NGA P_DATA := nvl(client_corp.[FAIL_LEVEL].[NAME], client_corp.[FAIL_LEVEL].[CODE]) || ' ' || client_corp.[FAIL_MARK];
				--P_DATA := client_corp.[FAIL_MARK];
				P_DATA := nvl(trim(client_corp.[FAIL_MARK]),'0, отсутствуют критерии для отнесения к высокому уровню риска');
			elsif client_bank%id is not null then
			    P_DATA := nvl(trim(client_bank.[FAIL_MARK]),'0, отсутствуют критерии для отнесения к высокому уровню риска');
			elsif client_priv%id is not null then
				-- NGA P_DATA := nvl(client_priv.[FAIL_LEVEL].[NAME], client_priv.[FAIL_LEVEL].[CODE]) || ' ' || client_priv.[FAIL_MARK];
				--P_DATA := client_priv.[FAIL_MARK];
				P_DATA := nvl(trim(client_priv.[FAIL_MARK]),'0, отсутствуют критерии для отнесения к высокому уровню риска');
				if P_DATA = ' ' then
					P_DATA := '0, отсутствуют критерии для отнесения к высокому уровню риска';
				end if;
	 		end if;
	 	elsif p_info = 'УРОВЕНЬ_РИСКА_T' then	 	--Уровень риска с текстом
	 	    P_DATA := 'НИЗКИЙ, отсутствуют критерии для отнесения к высокому уровню риска';
			if    client_corp%id is not null then if trim(client_corp.[FAIL_MARK]) is NOT NULL then P_DATA := 'ВЫСОКИЙ, '||trim(client_corp.[FAIL_MARK]); end if;
			elsif client_bank%id is not null then if trim(client_bank.[FAIL_MARK]) is NOT NULL then P_DATA := 'ВЫСОКИЙ, '||trim(client_bank.[FAIL_MARK]); end if;
			elsif client_priv%id is not null then if trim(client_priv.[FAIL_MARK]) is NOT NULL then P_DATA := 'ВЫСОКИЙ, '||trim(client_priv.[FAIL_MARK]); end if;
	 		end if;	
	 	
		elsif p_info = 'УР_РИСКА_КРИТ' then	 	--Уровень риска с критериями. Начало - как в УРОВЕНЬ_РИСКА из дистрибутива!
		declare
			fl	ref [FAIL_LEVEL];
			fv	number;
			mrk	::[CLIENT].[FAIL_MARK]%type;
			begin
			 if client_corp%id is not null then
				::[LEGAL_INTERFACE].[PRX_CLIENT].getRisk_FailValueAndLevel(client_corp%id, fl, fv, P_DATE_PRINT);
				mrk := client_corp.[FAIL_MARK];
			 elsif client_priv%id is not null then
				::[LEGAL_INTERFACE].[PRX_CLIENT].getRisk_FailValueAndLevel(client_priv%id, fl, fv, P_DATE_PRINT);
				mrk := client_priv.[FAIL_MARK];
			 end if;
			 P_DATA := COALESCE(fl.[CODE], fl.[NAME]) || ' ' || mrk;
			 -- NGA
			 if fl is NULL OR fl.[CODE] = 'НИЗКИЙ'  then  -- текст как было
			    P_DATA := '0, отсутствуют критерии для отнесения к высокому уровню риска';
			 else  -- добавим критерии
			    for mc in ::[MONITORING_CRIT] where	mc.[CLIENT] = client_priv%id
		                                      and nvl(mc.[CRIT_DATE_BEGIN], P_DATE_PRINT) <= P_DATE_PRINT
		                                      and nvl(mc.[CRIT_DATE_END],   P_DATE_PRINT) >= P_DATE_PRINT
			    loop
			      P_DATA := P_DATA ||LF$||mc.[CRITERIA].[NAME];
			    end loop;
			 end if;
			end;

		elsif p_info = 'КОНТРАГЕНТ' then		--КОНТРАГЕНТ
			P_DATA := '';
			if client_corp%id is not null then
				for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'КОНТРАГЕНТ' loop
					temp_str := nvl(cl_link.[PARTNER].[NAME], '');
					P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
				end loop;
				P_DATA := trim(P_DATA);
				P_DATA := substr(P_DATA,1,length(P_DATA)-1);
			end if;
		elsif p_info = 'ИНД_ПРЕДПРИН' then		--Сведения о инд. предпринимателе
			if ip then
				--номер свид-ва
				temp_str := nvl(client_corp.[REGISTER].[NUM_SERT], '');
				P_DATA := rtl.bool_char(temp_str is null, null, 'Номер свид-ва: '||temp_str||', ');
				--дата рег-ии
				temp_str := nvl(::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REG]), ::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REESTR]));
				P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Дата регистрации: '||temp_str||', ');
				--место рег-ии
--				STULY в населенном пункте хранится район области, а не район населенного пункта, поэтому район населенного пункта можно взять только из реквизита	DISTRICT 			
--				temp_str := nvl(client_org_ref.[REGISTER].[DISTRICT].[NAME], client_org_ref.[REGISTER].[CITY].[AREA].[NAME]);
				temp_str := client_corp.[REGISTER].[DISTRICT].[NAME];
				temp_str := rtl.bool_char(temp_str is null, '', temp_str||' р-он');

				--Башкиров В.Г. 26.06.2014 Удалена обработка полей для ОКАТО при переходе на 14.3
				-- меняю client_corp.[REGISTER].[CITY].[REGION_GNI]
				-- на ::[PERSONAL_ADDRESS].[LIB].get_region(client_corp.[REGISTER].[CITY]%ID)
				--[PEOPLE_PLACE] на [KIND]
				temp_str := nvl(client_corp.[REGISTER].[CITY].[COUNTRY].[VALUE], '')||'  '||
							nvl(::[PERSONAL_ADDRESS].[LIB].get_region(client_corp.[REGISTER].[CITY]%ID).[NAME], '')||'  '||
							nvl(client_corp.[REGISTER].[CITY].[KIND].[SHORT_NAME], '')||' '||
							nvl(client_corp.[REGISTER].[CITY].[NAME], '')||' '||
							temp_str;
--							nvl(client_org_ref.[REGISTER].[DISTRICT].[NAME], client_org_ref.[REGISTER].[CITY].[AREA].[NAME]);
				temp_str := ltrim(rtrim(temp_str));
				P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Место выдачи: '||temp_str||', ');
				--рег-ий орган
				temp_str := nvl(client_corp.[REGISTER].[REG_BODY].[NAME], '');
				P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Рег. орган: '||temp_str||', ');

				P_DATA := substr(P_DATA,1,length(P_DATA)-2);
			else
				P_DATA :='';
			end if;
--------

		elsif p_info like 'ИП_%' then		--Сведения о инд. предпринимателе
		  IF is_first <> 0 then  -- NGA27/10/2017 для последующих вызовов ф-ии для вычисления очередных закладок снова рассчитаем переменную IP!
		     &debug('22222222++++%%%%++++',0)
		     IF cl_ref%class = 'CL_ORG' AND cl_ref->(CL_CORP)[FORMA].[SHORT_NAME] = 'ИП' then
			    declare
				  dolg_fase [PERSONS_POS];
			    begin
				  locate exact dolg_fase in cl_ref->(CL_CORP)[ALL_BOSS] where dolg_fase.[FASE] is not null and dolg_fase.[CHIEF] = true; -- для ИП должностных лиц может быть несколько и надо учитывать "Признак руководителя"
				  -- устанавливаем глоб. парам. - ссылку на должностное лицо
				  cl_org_dolg_fase:=dolg_fase;
				  client_priv := dolg_fase.[FASE];
			    exception when NO_DATA_FOUND then pragma error ('Не найдено ни одной ссылки на ФЛ с "Признаком руководителя" в массиве "Должностные лица" для данного ИП!');
				          when TOO_MANY_ROWS then pragma error ('Найдено несколько ссылок на ФЛ с "Признаком руководителя" в массиве "Должностные лица" для данного ИП!');
			    end;
			    client_corp := [CL_HIST].[LIB].get_cl_corp(cl_ref,P_DATE_PRINT+1);
			    ip:=true;
		    end if;
		  END IF; --NGA27/10/2017 end
			p_info := substr(p_info,4);
			if ip then
				if p_info = 'РЕГ_НОМЕР' then
				--номер свид-ва
--					temp_str := nvl(client_corp.[REGISTER].[NUM_SERT], ' ');
					temp_str := nvl(client_corp.[REGISTER].[NUM_REESTR], ' ') || ' / ' || nvl(client_corp.[REGISTER].[GOS_REG_NUM_REC],' ');
					P_DATA := temp_str;
				elsif p_info = 'ДАТА_РЕГ' then
				--дата рег-ии
--					temp_str := nvl(::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REG]), ::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REESTR]));
					temp_str := nvl(::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REESTR]), ' ') || ' / ' || nvl(::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REG]), ' ');
					P_DATA := temp_str;
				elsif p_info = 'МЕСТО_РЕГ' then
					if client_corp%id is not null then
				--место рег-ии
--				STULY в населенном пункте хранится район области, а не район населенного пункта, поэтому район населенного пункта можно взять только из реквизита	DISTRICT 			
--				temp_str := nvl(client_org_ref.[REGISTER].[DISTRICT].[NAME], client_org_ref.[REGISTER].[CITY].[AREA].[NAME]);
					  temp_str := client_corp.[REGISTER].[DISTRICT].[NAME];
					  temp_str := rtl.bool_char(temp_str is null, '', temp_str||' р-он');

					  temp_str := nvl(client_corp.[REGISTER].[CITY].[COUNTRY].[VALUE], '')||'  '||
					  		nvl(::[PERSONAL_ADDRESS].[LIB].get_region(client_corp.[REGISTER].[CITY]%ID).[NAME], '')||'  '||
					  		nvl(client_corp.[REGISTER].[CITY].[KIND].[SHORT_NAME], '')||' '||
					  		nvl(client_corp.[REGISTER].[CITY].[NAME], '')||' '||
					  		temp_str;
--					  		nvl(client_org_ref.[REGISTER].[DISTRICT].[NAME], client_org_ref.[REGISTER].[CITY].[AREA].[NAME]);
					  temp_str := ltrim(rtrim(temp_str));
				       P_DATA := temp_str;
					elsif client_bank%id is not null then
							  temp_str := client_bank.[REGISTER].[DISTRICT].[NAME];
					  temp_str := rtl.bool_char(temp_str is null, '', temp_str||' р-он');
				
					  temp_str := nvl(client_bank.[REGISTER].[CITY].[COUNTRY].[VALUE], '')||'  '||
					  		nvl(::[PERSONAL_ADDRESS].[LIB].get_region(client_bank.[REGISTER].[CITY]%ID).[NAME], '')||'  '||
					  		nvl(client_bank.[REGISTER].[CITY].[KIND].[SHORT_NAME], '')||' '||
					  		nvl(client_bank.[REGISTER].[CITY].[NAME], '')||' '||
					  		temp_str;
--					  		nvl(client_org_ref.[REGISTER].[DISTRICT].[NAME], client_org_ref.[REGISTER].[CITY].[AREA].[NAME]);
					  temp_str := ltrim(rtrim(temp_str));
					  P_DATA := temp_str;
					end if;
				elsif p_info = 'РЕГ_ОРГАН' then
				 if client_corp%id is not null then
					temp_str := nvl(client_corp.[REGISTER].REGISTRAR, ' ') || ' / ' || nvl(client_corp.[REGISTER].[REG_BODY].[NAME], client_corp.[REGISTER].[REG_BODY].[LONG_NAME]);
				 elsif client_bank%id is not null then
				 	temp_str := nvl(client_bank.[REGISTER].REGISTRAR, ' ') || ' / ' || nvl(client_bank.[REGISTER].[REG_BODY].[NAME], client_corp.[REGISTER].[REG_BODY].[LONG_NAME]);
				 end if;

					P_DATA := temp_str;
				end if;
			else
				P_DATA := ' ';
			end if;
--------
		elsif p_info = 'ЛИЦЕНЗИИ' then	 	--ЛИЦЕНЗИИ
			if client_corp%id is not null then
				P_DATA := null;
				-- optimaze
				for
				(
					select lic
					(
						lic.[TYPE_LICENCE].[NAME]: 		l_type,
						lic.[NUM_LICENCE]:				l_num,
						lic.[DATE_BEGIN]:				l_date1,
						lic.[DATE_END]:					l_date2,
						lic.[WHO]:						l_who,
						lic.[LIST_TYPES]:				l_list
					)
				in client_corp.[LICENCES]
				where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
					  nvl(lic.[DATE_END],op_dat) >= op_dat
				)
				loop
				P_DATA := P_DATA
						  ||rtl.bool_char(lic.l_type is null, null, 'Вид лицензии: '||lic.l_type||' ')
						  ||rtl.bool_char(lic.l_num is null, null, 'Номер: '||lic.l_num||' ')
						  ||rtl.bool_char(lic.l_date1 is null, null, ' Дата выдачи: '||to_char(lic.l_date1, 'DD.MM.YYYY')||' ')
						  ||rtl.bool_char(lic.l_date2 is null, null, ' Дата окончания: '||to_char(lic.l_date2, 'DD.MM.YYYY')||' ')
						  ||rtl.bool_char(lic.l_who is null, null, ' Выдана: '||lic.l_who||' ')
						  ||rtl.bool_char(lic.l_list is null, null, ' Виды лицензируемой деятельности: '||lic.l_list)
						  ||NL$||NL$;
				end loop;

				P_DATA := trim(P_DATA);
				P_DATA := rtl.bool_char(P_DATA is null, null, substr(P_DATA, 1, length(P_DATA)-4));
			else
				P_DATA := '';
			end if;
			
		elsif p_info = 'ДАТА_СЧЕТА1' then	 	--ДАТА_СЧЕТА1
			if account is not null then
				begin
				P_DATA := nvl(::[RUNTIME].[FDP].pdat(date_acc1), '');
				exception when  NO_DATA_FOUND then
					pragma error('Ошибка при вычислении реквизита клиента ДАТА_СЧЕТА1');
				end;
			else
				P_DATA :='';
			end if;
		
		elsif p_info = 'ДАТА_СЧЕТА_NEW' then	 	--ДАТА_СЧЕТА_NEW
--> ivanov a.v. 17/04/2017 Анкета
			P_DATA :='';
			if v_date_beg_cl is not null then
				P_DATA := nvl(::[RUNTIME].[FDP].pdat(v_date_beg_cl), '');
			end if;
--< ivanov a.v. 17/04/2017 Анкета

		---->--Дианков А.В. 15/01/16
		elsif p_info = 'ДАТА_ЗАК_СЧЕТА' then	 	--ДАТА_ЗАК_СЧЕТА

			P_DATA :='';

				declare
				  acc ref [AC_FIN];
				begin
					locate acc in ::[AC_FIN] all where acc.[CLIENT_V]=cl_ref
														AND (acc.[DATE_CLOSE] is null OR P_DATE_PRINT <= acc.[DATE_CLOSE]);
					P_DATA :='';
				exception when NO_DATA_FOUND then
					begin
					select x(x)
					in ::[AC_FIN] all
					where x.[CLIENT_V]=cl_ref
						  AND rownum < 2
					order by x.[DATE_CLOSE] desc
					into acc;
					
					P_DATA := nvl(::[RUNTIME].[FDP].pdat(acc.[DATE_CLOSE]), '');
					exception when NO_DATA_FOUND then
						pragma error('Ошибка при вычислении реквизита клиента ДАТА_ЗАК_СЧЕТА');
					end;
				end;
				
			
		elsif p_info = 'ДАТА_ЗАК_СЧЕТА_NEW' then	 	--ДАТА_ЗАК_СЧЕТА_NEW
--> ivanov a.v. 17/04/2017 Анкета
			P_DATA :='';
			if v_date_end_cl <> to_date('01/01/4000','dd/mm/yyyy') then
				P_DATA := nvl(::[RUNTIME].[FDP].pdat(v_date_end_cl), '');
			end if;
--< ivanov a.v. 17/04/2017 Анкета

		elsif p_info = 'КЛ_ТЕРРОРИСТ' then  --проверка на терроризм
			declare
				dt date;
				l_data	[MEMO_32767];
			begin	
				P_DATA:=null;
				dt:='2016.01.01';

				for (	select x(	x%id :id,
									x.[CHECK_DATE]	:cd,
									x.[CHECK_VAL].[NAME]: cvn)
							in ::[CL_CHECK_RESULT] all
						where	x.[CHECK_OBJ] = cl_ref and
								x.[CHECK_TYPE].[CODE] = 'TERROR_LIST' and
								dt <= x.[CHECK_DATE])
				loop
					l_data := to_char(x.[cd],'dd.mm.yyyy')||' Результат: '||x.[CVN];
					if P_DATA is null then
						P_DATA:= l_data;
					else
						if instr(P_DATA, l_data) = 0 then
							P_DATA := P_DATA || chr(10) || l_data;
						end if;
					end if;
					&debug('P_DATA = '||P_DATA,0)
					&debug('length(P_DATA) = '||length(P_DATA),0)
				end loop;

				&debug('return P_DATA КЛ_ТЕРРОРИСТ',0)
			exception when others then
				pragma error ('Ошибка при выводе. Параметра "КЛ_ТЕРРОРИСТ" '||sqlerrm);	
			end;

		elsif p_info = 'КЛ_ТЕРРОРИСТ_NEW' then  --проверка на терроризм
				
--> ivanov.a.v. 17/04/2017 Анкета
		  declare
		  	dt date;
		  	l_data	[MEMO_32767];
		  begin	
			&debug('!!!!!  КЛ_ТЕРРОРИСТ_NEW v_date_beg_cl = '||to_char(v_date_beg_cl,'dd.mm.yy'),0)
			&debug('!!!!!  КЛ_ТЕРРОРИСТ_NEW v_date_end_cl = '||to_char(v_date_end_cl,'dd.mm.yy'),0)
			&debug('!!!!!  КЛ_ТЕРРОРИСТ_NEW v_is_once = '||bool_char(v_is_once),0)
				if v_date_beg_cl = v_date_end_cl and v_is_once then
					&debug('!!!!!  Перед циклом и разовая операция',0)
					for (	select x(x%id :id,
									x.[CHECK_DATE]	:cd,
									x.[CHECK_VAL].[NAME]: cvn)
								in ::[CL_CHECK_RESULT] all
							where x.[CHECK_OBJ] = cl_ref and
								x.[CHECK_TYPE].[CODE] = 'TERROR_LIST' and
								v_date_end_cl >= trunc(x.[CHECK_DATE])
							order by x.[CHECK_DATE] desc
					)loop
						&debug('!!!!!  В цикле разовая',0)
						if v_date_end_cl > trunc(x.[cd]) then
							l_data := to_char(v_date_end_cl,'dd.mm.yyyy')||' Результат: '||x.[CVN];
						else
							l_data := to_char(x.[cd],'dd.mm.yyyy')||' Результат: '||x.[CVN];
						end if;
						P_DATA:= l_data;
						&debug('!!!!!  В цикле P_DATA = '||P_DATA,0)
						exit;
					end loop;
				else
					&debug('!!!!!  не разовая операция',0)
					dt:= greatest(v_date_beg_cl, to_date('01/01/2016','dd/mm/yyyy'));
					--> TTI 28/07/2017   "рисуем проверку на терроризм"  для катигории клиентов "с работающими продуктами"
					P_DATA:= to_char(dt,'dd.mm.yyyy')||' Результат: Не выявлено совпадений со справочником террористов РФ';  -- "рисуем проверку на терроризм"   в дату начала отношений с клиентом
					--< TTI 28/07/2017
					for (select x(x%id :id,
									x.[CHECK_DATE]	:cd,
									x.[CHECK_VAL].[NAME]: cvn)
							in ::[CL_CHECK_RESULT] all
						where x.[CHECK_OBJ] = cl_ref and
							x.[CHECK_TYPE].[CODE] = 'TERROR_LIST' and
						--	dt <= x.[CHECK_DATE] and
							dt < x.[CHECK_DATE] and    --28.07.2017 TTI Делаем  строго больше т.к."рисуем проверку" в дату начала отношений с клиентом
							v_date_end_cl >= trunc(x.[CHECK_DATE])
							order by x.[CHECK_DATE] asc
					)loop
						&debug('!!!!!  В цикле не разовая',0)
						l_data := to_char(x.[cd],'dd.mm.yyyy')||' Результат: '||x.[CVN];
						&debug('!!!!!  В цикле не разовая l_data'||l_data,0)
						if P_DATA is null then
							P_DATA:= l_data;
						else
							if instr(P_DATA, l_data) = 0 then
								P_DATA := P_DATA || chr(10) || l_data;
							end if;
						end if;
						&debug('P_DATA = '||P_DATA,0)
						&debug('length(P_DATA) = '||length(P_DATA),0)
					end loop;
				end if;
		  end;
--< ivanov.a.v. 17/04/2017 Анкета

		----------<---Дианков А.В.
----
		elsif p_info = 'ДАТА_ОПЕРАЦИИ' then	 	--ДАТА_ОПЕРАЦИИ NGA24/12/2014
		  if client_corp%id is not null OR client_bank%id is not null then
		  	if account is not null then
	 			P_DATA := to_char(get_first_move_date(account), 'DD.MM.YYYY');
	 		else
	 		    P_DATA :='';
	 		end if;
		  elsif client_priv%id is not null then
		    var date_vop  date default [CONSTANT].DATE_MAX;  -- дата 1-ой ВОП Клиента
		    var date_safe date default [CONSTANT].DATE_MAX;  -- дата 1-ого договора Аренды ячейки с арендатором-Клиентом
		
		    for kv in ::[KASSA_V] where -- найдем дату 1-ой ВОП Клиента.
		         --1. В операции ВОП нет ссылки на Клиента, но есть такие же серия/номер, как в истории изменений Клиента
		        (kv.[CLIENT] is NULL and
		         exists (select v(v) in ::[CL_HIST] where
		                             v.[VALUE] = kv.[NEW_CLIENT].[SERIA] AND
		                             v.[QUAL]='DOC.SER' AND
		                             v.[CLIENT_REF] = client_priv%id
		                             and rownum=1) and
                 exists (select v(v) in ::[CL_HIST] where
		                             v.[VALUE] = kv.[NEW_CLIENT].[NUMBER] AND
		                             v.[QUAL]='DOC.NUM' AND
		                             v.[CLIENT_REF] = client_priv%id
		                             and rownum=1)		
		        )  OR
		         --2. В операции ВОП нет ссылки на Клиента, но есть такие же паспорт/серия/номер, как у Клиента
		        (kv.[CLIENT] is NULL and
		         kv.[NEW_CLIENT].[PASSPORT] = client_priv.[DOC].[TYPE].[FULL_NAME] and
		         kv.[NEW_CLIENT].[SERIA]    = client_priv.[DOC].[SER]  and
		         kv.[NEW_CLIENT].[NUMBER]   = client_priv.[DOC].[NUM])   OR
		         --3. Есть прямая ссылка на клиента 	
		         kv.[CLIENT] = client_priv%id
		         order by kv.[DATE]
		    loop
		        date_vop:=trunc(kv.[DATE]);
		        exit;
		    end loop;
debug_pipe('PSB_WRD_FIZCL_AN -- p_info=ДАТА_ОПЕРАЦИИ1  дата 1-ой ВОП Клиента(макс.дата=нет) date_vop='||date_vop,0);		
		    for h in ::[HOLDER] ALL where h.[CLIENT] = client_priv%id order by h.[DATA_BEG]  -- найдем дату 1-ого договора Аренды с арендатором-Клиентом
		    loop
		       date_safe:=trunc(h.[DATA_BEG]);
		       exit;
		    end loop;
debug_pipe('PSB_WRD_FIZCL_AN -- p_info=ДАТА_ОПЕРАЦИИ1  дата 1-ого договора Аренды(макс.дата=нет) date_safe='||date_safe,0);		    		
--
            date_mov1:=[CONSTANT].DATE_MAX;
            if account_tmp is not null then
               date_mov1 := trunc(get_first_move_date(account_tmp));
			   if (date_acc1 < to_date('31.12.2008', 'dd.mm.yyyy')) and (date_mov1 = to_date('31.12.2008', 'dd.mm.yyyy')) then
			       date_mov1 := date_acc1;
			   end if;
            end if;
debug_pipe('PSB_WRD_FIZCL_AN -- p_info=ДАТА_ОПЕРАЦИИ1  дата 1-ого движ.по счету(макс.дата=нет) date_mov1='||date_mov1||'  счет='||account_tmp.[MAIN_V_ID],0);
            date_mov1 := least(date_vop, date_safe, date_mov1);
            if date_mov1 < [CONSTANT].DATE_MAX then
               P_DATA := ::[RUNTIME].[FDP].pdat(date_mov1, '');
            else
               P_DATA :='';
            end if;
		  end if;

			/*
			if account_tmp is not null then
--				date_acc1 := trunc(account.[DATE_OP]);
				date_mov1 := trunc(get_first_move_date(account_tmp));
				if (date_acc1 < to_date('31.12.2008', 'dd.mm.yyyy')) and (date_mov1 = to_date('31.12.2008', 'dd.mm.yyyy')) then
					P_DATA := ::[RUNTIME].[FDP].pdat(date_acc1, '');
				else
					P_DATA := ::[RUNTIME].[FDP].pdat(get_first_move_date(account_tmp), '');
				end if;
			else
				P_DATA :='';
			end if;
			*/

		elsif p_info = 'СОТР_ОТКР' then		--СОТР_ОТКР
			declare u ref [USER];
			begin
				u := account.[USER_OP];
				if (account is not null) and (u is not null) then
					P_DATA := nvl(::[RUNTIME].[FDP_2].fio_short(u.[NAME]), '') || ', ' || u.[CASTA].[VALUE];
				else
					P_DATA :='';
				end if;
			end;
		elsif p_info = 'СОТР_УТВ' then		--СОТР_УТВ
			P_DATA :='';

		elsif p_info = 'ЗАПОЛНИЛ' then		--ЗАПОЛНИЛ
			P_DATA := nvl(stdlib.userid.[CASTA].[VALUE], '')||' '||nvl(::[RUNTIME].[FDP_2].fio_short(stdlib.userid.[NAME]), '');

------
		elsif p_info like 'ЗАПОЛН_%' then		--ЗАПОЛНИЛ
			p_info := substr(p_info, 8);
			if p_info = 'ДОЛЖН' then
				P_DATA := nvl(P_HEADUSER.[CASTA].[VALUE], ' ');
			elsif p_info = 'ФИО' then
				P_DATA := nvl(::[RUNTIME].[FDP_2].fio_short(P_HEADUSER.[NAME]), ' ');
			else
				P_DATA := ' ';
			end if;

------
		elsif p_info = 'РУК_ПОДР' then	 	--РУК_ПОДР
			if P_HEADUSER is not null then
				P_DATA := nvl(::[RUNTIME].[FDP_2].fio_short(P_HEADUSER.[NAME]), '');
				P_DATA := rtl.bool_char(P_DATA is not null, nvl(P_HEADUSER.[CASTA].[VALUE], '')||' '||P_DATA, '');
			else
				P_DATA :='';
			end if;
------	
		elsif p_info = 'СОТР_ОТВ_НАЧ'  then --Дианков А.В. начальник ответственного сотрудника (Лотес Н.В.)
			P_DATA:='';
			-- 19.01.2016 Вычислим должность сотрудника Банка, принявшего решение о приеме клиента на обслуживание.
			-- Всегда будет начальник РОО (Лотес Н.В.)
			-- Картешкина 24/08/16 для Тюмени должность PSB_uprav_filial сделала и добавила должность к имени
			for us in ::[USER] all
			where	us.[FILIAL]=account.[FILIAL] and
					--- (us.[FILIAL] = ::[BRANCH]([CODE]='002') and us.[CASTA].[CODE] = 'PSB_uprav_filial' or
					--- 	us.[FILIAL] != ::[BRANCH]([CODE]='002') and us.[CASTA].[CODE] in ('PSB_gl_buh_nroo' , 'nch_POO', 'PSB_grav_buch')
					--- ) and
					us.[BEG_DATE] <= P_DATE_PRINT and
					(us.[END_DATE] is null OR P_DATE_PRINT <= us.[END_DATE])
			loop
				if P_DATA is null then
					P_DATA:=us.[NAME]|| ', ' || us.[CASTA].[VALUE];
				else
					P_DATA:=P_DATA||';'||us.[NAME]|| ', ' || us.[CASTA].[VALUE];
				end if;
			end loop;

		elsif p_info = 'СОТР_ОТВ_НАЧ_NEW'  then --Дианков А.В. начальник ответственного сотрудника (Лотес Н.В.)
--> ivanov a.v. 17/04/2017 Анкета
			P_DATA :='';
			for i in 1..v_rec_prod_tbl.count loop
				if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
					exit;
				else
					if i = 1 then
						v_user_cr := v_rec_prod_tbl(i).create_user;
					end if;
					if nvl(v_rec_prod_tbl(i).split,'0') = '1' then
						v_user_cr := v_rec_prod_tbl(i).create_user;
					end if;
				end if;
			end loop;
			if v_user_cr is not null then
				for us in ::[USER] all
				where us%id = v_user_cr
				loop
					if P_DATA is null then
						P_DATA:=us.[NAME]|| ', ' || us.[CASTA].[VALUE];
					else
						P_DATA:=P_DATA||';'||us.[NAME]|| ', ' || us.[CASTA].[VALUE];
					end if;
				end loop;
			end if;
--< ivanov a.v. 17/04/2017 Анкета

		elsif p_info = 'СОТР_ОТВ' then	 	--СОТР_ОТВ
			declare u ref [USER];
			begin
				--Башкиров В.Г. 22.08.2012 Вычислим куратора или ответсвенного по счету
				u := nvl(GetCurator(cl_ref,P_DATE_PRINT),account.[OTV]);
				--Башкиров В.Г. 22.08.2012 Если уволился, сбросим.
				--NGA05/06/2015 if u is not null and (u.[END_DATE] is null or u.[END_DATE]<=P_DATE_PRINT) then
				if u is not null and u.[END_DATE] is not null and u.[END_DATE]<=P_DATE_PRINT then  --NGA05/06/2015 Дата ув.есть и она меньше даты печати
				   u:=null;
				end if;
                -- NGA 17/08/2015
                if u is null then
                   /*declare
			         cl_ref ref [CLIENT];*/
	               begin
	    	        /*if client_org_ref is not null then cl_ref := client_org_ref;
	    	        else             	    		    cl_ref := cl_ref;
	    	        end if;*/
    	            --1. Если отв.по 1-му откр.счету уволен,попробуем поискать неувол.отв.по другим счетам клиента
                    for a in ::[AC_FIN] where a%id <> account%id and a.[CLIENT_V] = cl_ref order by a.[DATE_OP] asc
                    loop
                        if a.[OTV].[END_DATE] is null or -- не уволен или уволен позже даты печати
                           a.[OTV].[END_DATE] is not null and a.[OTV].[END_DATE]>P_DATE_PRINT then
                           u:=a.[OTV];
		   		           exit;
                        end if;
		            end loop;
						debug_pipe('u1='||u.[NAME]);
		            --2. Если ни по какому счету нет неувол.ответ-ого,ищем любого неувол.сотр-ка этого отдела
		            if u is null then
	                   for a in ::[AC_FIN] where a.[CLIENT_V] = cl_ref order by a.[DATE_OP] asc
                       loop
                          for u2 in ::[USER] where (u2.[END_DATE] is null or u2.[END_DATE] is not null and u2.[END_DATE]>P_DATE_PRINT)
                                            and u2.[DEPART]=a.[OTV].[DEPART]
                          loop
			 			   u:=u2;
			 		  	   exit;
			 		      end loop;  -- по юзерам того же подразделения
			 		      if u is NOT NULL then
                             exit;
			 		      end if;
		               end loop;  -- по счетам
		            end if;
	               end;
                end if;
                -- NGA 17/08/2015 end

				--Башкиров В.Г. 22.08.2012 заявка от Брюжецовой Н.М.
				--У физ лиц, которые, которые являются  директорами( представителями)
				--клиентов-юридических лиц должна проставляться ФИО и должность
				--сотрудника, ответственного за работу с клиентом-юридическим лицом и
				--желательно подтягиваться автоматически при проставлении или изменении
				--сотрудника, ответственного за работу с клиентом-фр лицом.
				if u is null then
					if cl_ref%class='CL_PRIV' then
						for p in ::[PERSONS_POS] all where p.[FASE]=cl_ref loop
							for cc in ::[CL_CORP] all where p%collection=cc.[ALL_BOSS] loop
								for af in ::[AC_FIN] where af.[CLIENT_V]=cc and (af.[OTV].[END_DATE] is null or af.[OTV].[END_DATE]<=P_DATE_PRINT) loop
									u:=af.[OTV];
									exit;
								end loop;
							end loop;
							if u is not null then
								exit;
							end if;
						end loop;
					end if;
				end if;
				--У физ лиц - не имеющих счетов в Банке в графе "Должность ФИО сотрудника,
				--ответственного за работу с Клиентом" должна проставляться фио и
				--должность сотрудника, который завел сведения о данном клиенте в ЦФТ или
				--произвел их последнее обновление.
				/*if u is null then --смотрим по 6.1. История изменения реквизитов экземпляров
					var vUserName [STRING_30];
					::[SYS_DIARYS].[CRIT_DIARY](to_date('01/01/1901','dd/mm/yyyy'),::[SYSTEM].[OP_DATE]+1); --!!! здесь определяется контекст сессии для этого представления
					for (select a1(
								a1.C_1  : C_1,
								a1.C_2  : C_2,
								a1.C_3  : C_3,
								a1.C_11 : C_11,
								a1.id   : a1_id)
								in (VW_CRIT_VALUES_HISTORY%RowType : a1)
								where a1.C_1=cl_ref
								order by to_date(a1.C_2,'yyyy-mm-dd hh24:mi:ss') desc, a1.C_11 desc
								)
					loop
						 u:=GetUser(a1.C_3);
						 debug_pipe('СОТР_ОТВ-3-...: фио = '||u.[NAME],0);
						 if u is not null and (u.[END_DATE] is null or u.[END_DATE]<=P_DATE_PRINT) then
						 	 debug_pipe('PSB_WRD_FIZCL_AN -- a1.C_1='||a1.C_1||' a1.C_2='||a1.C_2||' a1.C_3='||a1.C_3||' a1.C_11='||a1.C_11||' -> '||u.[NAME],dp);
						     exit;
						 end if;
					end loop;
				end if;*/
				--А если данный сотрудник уже уволен-то
				--любой сотрудник операционного офиса.
			 	if u is not null and not (u.[END_DATE] is null or u.[END_DATE]<=P_DATE_PRINT) then
			 		for u2 in ::[USER] where u2.[DEPART]=u.[DEPART] and (u2.[END_DATE] is null or u2.[END_DATE]<=P_DATE_PRINT) loop
			 			u:=u2;
			 			exit;
			 		end loop;
				end if;
			 	if u is not null and not (u.[END_DATE] is null or u.[END_DATE]<=P_DATE_PRINT) then
			 		var hDepart ref [DEPART]:=u.[DEPART].[HIGH];
			 		var vFilial ref [BRANCH]:=u.[FILIAL];
			 		var iErr integer:=0;
			 		u:=null;
			 		for iErr in 1..100 loop
				 		for u2 in ::[USER] where hDepart is not null and u2.[DEPART]=hDepart and (u2.[END_DATE] is null or u2.[END_DATE]<=P_DATE_PRINT) loop
				 			u:=u2;
				 			exit;
				 		end loop;
				 		hDepart:=hDepart.[HIGH];
				 		if u is not null then exit; end if;
			 		end loop;
			 		if u is null then
				 		for u2 in ::[USER] where u2.[FILIAL]=vFilial and (u2.[END_DATE] is null or u2.[END_DATE]<=P_DATE_PRINT) loop
				 			u:=u2;
				 			exit;
				 		end loop;
			 		end if;
				end if;
			
				if u is not null then P_DATA := nvl(::[RUNTIME].[FDP_2].fio_short(u.[NAME]), '') || ', ' || u.[CASTA].[VALUE];
				else				  P_DATA :='';
				end if;
			end;
		
			
	 	elsif p_info = 'ВЫГОДОПРИОБРЕТАТЕЛЬ' then
		  if client_corp%id is not null then
		  	for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОПРИОБРЕТАТЕЛЬ' loop
				--NGA temp_str := nvl(cl_link.[PARTNER].[NAME], '');
				temp_str  := nvl(cl_link.[PARTNER].[NAME], cl_link.[CLIENT_NAME]);
				temp_str2 := cl_link.[FOUND];  -- NGA основание
				--NGA P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
				P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str||' основание:' || temp_str2 || ', ', '');
			end loop;
			--NGA23092013 temp_str1 := rtrim(P_DATA,' ,');
			temp_memo := rtrim(P_DATA,' ,');
			temp_str2 := '';  --NGA
			P_DATA := '';
			for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ' loop
				temp_str := nvl(cl_link.[PARTNER].[NAME], '');
				P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
			end loop;
			temp_str2 := rtrim(P_DATA,' ,');

			/*NGA23092013
			if length(temp_str1) > 1 then
		 		temp_str1 := 'Выгодоприобретатели: ' || temp_str1;
			else
			  temp_str1 := ' ';
			end if;
            */
            if length(temp_memo) > 1 then -- NGA23092013
		 		temp_memo := 'Выгодоприобретатели: ' || temp_memo;
			else
			  temp_memo := ' ';
			end if;
			
			if length(temp_str2) > 1 then
		 		temp_str2 := 'Выгододатели: ' || temp_str2;
			else
			  temp_str2 := ' ';
			end if;

			if /*NGA23092013 temp_str1 != ' '*/ temp_memo != ' ' then
				if temp_str2 = ' ' then
					--NGA23092013 P_DATA := temp_str1;
					P_DATA := temp_memo;
				else
					--NGA23092013 P_DATA := temp_str1 || NL$ || temp_str2;
					P_DATA := temp_memo || NL$ || temp_str2;
				end if;
			else
				if temp_str2 = ' ' then
					P_DATA := 'Отсутствует';
				else
					P_DATA := temp_str2;
				end if;
			end if;	
			
		  elsif client_priv%id is not null then
			for cl_link in client_priv.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОПРИОБРЕТАТЕЛЬ' loop
				temp_str := nvl(nvl(cl_link.[PARTNER].[NAME],cl_link.CLIENT_NAME),'');
				P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
			end loop;
			temp_str1 := rtrim(P_DATA,' ,');
			P_DATA := '';
			for cl_link in client_priv.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ' loop
				temp_str := nvl(nvl(cl_link.[PARTNER].[NAME],cl_link.CLIENT_NAME), '');
				P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
			end loop;
			temp_str2 := rtrim(P_DATA,' ,');
			if length(temp_str1) > 1 then
		 		temp_str1 := 'Выгодоприобретатели: ' || temp_str1;
			else
			  temp_str1 := ' ';
			end if;

			if length(temp_str2) > 1 then
		 		temp_str2 := 'Выгододатели: ' || temp_str2;
			else
			  temp_str2 := ' ';
			end if;

			if temp_str1 != ' ' then
				if temp_str2 = ' ' then
					P_DATA := temp_str1;
				else
					P_DATA := temp_str1 || NL$ || temp_str2;
				end if;
			else
				if temp_str2 = ' ' then
					P_DATA := 'Отсутствует';
				else
					P_DATA := temp_str2;
				end if;
			end if;	
	 	 end if;
