end;
/*-----------------------------------------------------------
Определение типа клиента по счету
------------------------------------------------------------*/
function type_cl_on_acc(acc [ACCNUM]) return string(40) is
	ps	[PS$];
	balance_account	varchar2(6);
	vl ref [FT_MONEY];
	result_priv string(20) default '';
	result_org 	string(20) default '';
	result_bank string(20) default '';
	
begin
	balance_account := substr(acc, 1, 5) || '%';
	begin
		--Физик?
		locate ps in ::[PS$] all
		where ps%parent([PL_US]::[B_PS]).[NUM] like balance_account
		and ps.[] in (	::[PS]([PS_CODE] = 'C_CL_PRIV')
						);
		result_priv := 'CL_PRIV';
		exception when others then
		null;
	end;
	begin --Юрик?
		locate ps in ::[PS$] all
		where ps%parent([PL_US]::[B_PS]).[NUM] like balance_account
		and ps.[] in (	::[PS]([PS_CODE] = 'C_CL_ORG'));
		result_org := 'CL_ORG';
		exception when others then
		null;
	end;
	begin
		--Банк?
		locate ps in ::[PS$] all
		where ps%parent([PL_US]::[B_PS]).[NUM] like balance_account
		and ps.[] in (	::[PS]([PS_CODE] = 'C_CL_BANK_F'),
						::[PS]([PS_CODE] = 'C_CL_BANK_N')
					);
		result_bank := 'CL_BANK';
		exception when others then
		null;
	end;
	return result_priv||';'||result_org||';'||result_bank;

end;
--
function EZP(md ref [MAIN_DOCUM]) return string(1) is
begin
		for i in ::[BC_MAIN_DOC_SIGN] where i.[MDOC_REF]= md
		loop
			return '1';
			exit;
		end loop;
	/*if md.[DOCUMENT_UNO] like 'IB%' then
		return '1';
		exit;
	end if;
	*/
	return '0';
end;

-- sadunov Возвращает true если находит хоть что-нибудь из реквизитов в массиве индексных строк
public function req_is_our(req [REQ_CLIENT]) return boolean is 
begin
	if req.[0] = 1 then -- Клиент банка, проверяем Владельца счета
		if obtbl.exists(req.[1].[2].[CLIENT_V]%id) then return true; end if;
		if obtbl.exists(req.[1].[2].[CLIENT_V].[NAME]) then return true; end if;
		if req.[1].[2].[CLIENT_V]%Class = 'CL_BANK_N' then
				if obtbl.exists(req.[1].[2].[CLIENT_V]->(CL_BANK_N)[BIC]) then return true; end if;				
		end if;
	elsif req.[0] = 2 then -- не клиент банка
		if obtbl.exists(req.[2].[2]) and obtbl.exists(req.[2].[3]%id) then return true; end if;
	end if;
	return false;
end;

-- sadunov Заполняет массив индексных строк данными о филиалах
public procedure init_bank_table is 
	procedure adtbl(idnt string) is
	begin
		if idnt is not null then
			obtbl(idnt) := 1;
		end if;
	end;
begin
	if obtbl.count = 0 then
		for fl in ::[BRANCH] loop
			adtbl(fl.[BANK]%id);
			adtbl(fl.[BANK].[BIC]);
			adtbl(fl.[BANK].[NAME]);
			adtbl(fl.[BANK].[SWIFT_C]);
			adtbl(substr(fl.[BANK].[SWIFT_C],1,8));
			adtbl(fl.[BANK_REQ]%id);
			if fl.[BANK_REQ]%Class = 'CL_PART' then
				adtbl(fl.[BANK_REQ]->(CL_PART)[BANK]%id);
				adtbl(fl.[BANK_REQ]->(CL_PART)[BANK].[BIC]);
				adtbl(fl.[BANK_REQ]->(CL_PART)[BANK].[SWIFT_C]);
				adtbl(substr(fl.[BANK_REQ]->(CL_PART)[BANK].[SWIFT_C],1,8));
				adtbl(fl.[BANK_REQ]->(CL_PART)[BANK_F]%id);
				adtbl(fl.[BANK_REQ]->(CL_PART)[BANK_F].[SWIFT_C]);
				adtbl(substr(fl.[BANK_REQ]->(CL_PART)[BANK_F].[SWIFT_C],1,8));
			elsif fl.[BANK_REQ]%Class = 'CL_BANK_F' then
				adtbl(fl.[BANK_REQ]->(CL_BANK_F)[SWIFT_C]);
				adtbl(substr(fl.[BANK_REQ]->(CL_BANK_F)[SWIFT_C],1,8));
			elsif fl.[BANK_REQ]%Class = 'CL_BANK_N' then
				adtbl(fl.[BANK_REQ]->(CL_BANK_N)[BIC]);
				adtbl(fl.[BANK_REQ]->(CL_BANK_N)[SWIFT_C]);
				adtbl(substr(fl.[BANK_REQ]->(CL_BANK_N)[SWIFT_C],1,8));
			end if;
		end loop;	
				
	end if;	
end;

function GET_SUM_SCALE(RKO ref [RKO]) return [SUMMA] is
rk1 			ref [RKO];
today 			[DATE];
SUMA_BP             [SUMMA] := 0;            -- СУММА БАЗНАЛИЧНЫХ ПОСТУПЛЕНИЙ
SUMA_PRED           [SUMMA] := 0;            -- СУММА ПРЕДЫДУЩИХ СНЯТИЙ ЗА ПОСЛЕДНИЕ 30 ДНЕЙ
SUMA                [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_DOC            [SUMMA] := 0;            -- СУММА ДОКУМЕНТА
SUM_DEN             [SUMMA] := 0;            -- СУММА СНЯТИЙ ЗА ДЕНЬ ПО СЧЕТУ
SUMA_SH1            [SUMMA] := 149999;       -- СУММА ПО ШКАЛЕ №1
SUMA_SH2            [SUMMA] := 599999;       -- СУММА ПО ШКАЛЕ №2
SALDO               [SUMMA] := 0;            -- ВХОДЯЩИЙ ОСТАТОК ПО СЧЕТУ КЛИЕНТА
SALDO_MID           [SUMMA] := 0;            -- СРЕДНЕДНЕВНОЙ ОСТАТОК
SUMA_IN_NAL_RUB     [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_IN_BN_RUB      [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_OUT_NAL_RUB    [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_OUT_BN_RUB     [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА

mn_ref ref [MAIN_DOCUM];
begin
&OpDate;
			BEGIN
		         LOCATE MN_REF IN ::[MAIN_DOCUM] WHERE MN_REF%ID = RKO;
				 EXCEPTION WHEN NO_DATA_FOUND THEN
						MN_REF:=::[PATTERN_DOC].[BUSINESS_OP].DOC_REF;
			END;
			IF MN_REF.[VID_DOC].[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR MN_REF.[ACC_DT].[MAIN_USV].[NUM] = '20202' THEN
			   RETURN 0;
			END IF;					
	       SUMA_DOC := mn_ref.[SUM];  -- СУММА ДОКУМЕНТА
        -----------------------------   Обновление массива "Операции клиента" ---------------------------------------
            ::[CLIENT].[GENERATOR_TASK](
										 RKO.[FILIAL]           /*P_FILIAL*/		--Филиал
										,TODAY                  /*P_DATE*/		--Дата начала
										,TODAY                  /*P_DATE_END*/		--Дата окончания
										,TRUE    		        --Удалить загруженные данные
										,RKO.[CLIENT]           /*P_CLIENT*/		--Клиент
										,NULL                   /*P_STAT_PAR*/		--Статистический параметр
										,NULL                   /*P_ONLY_POST*/		--Пересчет стат.параметоров по документам вставки прошлой датой
										,NULL                   /*P_DAY*/		--Контроль вставки документов прошлой датой (дней)
										);	
        -------------------------------   находим входящий остаток по счету на 01.01.2013 -----------
          SALDO := ABS(F.A('И'||RKO.[ACCOUNT]||'СН', TO_DATE('01.01.2013', 'DD.MM.YYYY')));		
        ------------------- СТАРТ ОПЕРАЦИИ КЛИЕНТА ПО КОДУ 'PSH_IN_NAL_RUB' -------------------------------------------------------------------
          FOR (SELECT S(
                        SUM(S.[OPER_SUM])    : SUMA_OPER
                       )           												 			
               IN [CL_OPERATIONS] ALL
               WHERE RKO.[CLIENT].[CL_OPER1] = S%COLLECTION AND S.[OPER_ACC] = RKO.[ACCOUNT] AND S.[STATE_PARAM].[CODE] IN ('PSH_IN_NAL_RUB')
              )
          LOOP
              SUMA_IN_NAL_RUB := NVL(SALDO,0) + NVL(S.SUMA_OPER,0);
          END LOOP;
        ------------------- СТАРТ ОПЕРАЦИИ КЛИЕНТА ПО КОДУ 'PSH_IN_BN_RUB' -------------------------------------------------------------------
          FOR (SELECT S(
                        SUM(S.[OPER_SUM])    : SUMA_OPER
                       )           												 			
               IN [CL_OPERATIONS] ALL
               WHERE RKO.[CLIENT].[CL_OPER1] = S%COLLECTION AND S.[OPER_ACC] = RKO.[ACCOUNT] AND S.[STATE_PARAM].[CODE] IN ('PSH_IN_BN_RUB')
              )
          LOOP
              SUMA_IN_BN_RUB := NVL(S.SUMA_OPER,0);
          END LOOP;
        ------------------- СТАРТ ОПЕРАЦИИ КЛИЕНТА ПО КОДУ 'PSH_OUT_NAL_RUB' -------------------------------------------------------------------
          FOR (SELECT S(
                        SUM(S.[OPER_SUM])    : SUMA_OPER
                       )           												 			
               IN [CL_OPERATIONS] ALL
               WHERE RKO.[CLIENT].[CL_OPER1] = S%COLLECTION AND S.[OPER_ACC] = RKO.[ACCOUNT] AND S.[STATE_PARAM].[CODE] IN ('PSH_OUT_NAL_RUB')
              )
          LOOP
              SUMA_OUT_NAL_RUB := NVL(S.SUMA_OPER,0);
          END LOOP;
        ------------------- СТАРТ ОПЕРАЦИИ КЛИЕНТА ПО КОДУ 'PSH_OUT_BN_RUB' -------------------------------------------------------------------
          FOR (SELECT S(
                        SUM(S.[OPER_SUM])    : SUMA_OPER
                       )           												 			
               IN [CL_OPERATIONS] ALL
               WHERE RKO.[CLIENT].[CL_OPER1] = S%COLLECTION AND S.[OPER_ACC] = RKO.[ACCOUNT] AND S.[STATE_PARAM].[CODE] IN ('PSH_OUT_BN_RUB')
              )
          LOOP
              SUMA_OUT_BN_RUB := NVL(S.SUMA_OPER,0);
          END LOOP;
        --------------------------------  РАССЧИТАЕМ СРЕДНЕДНЕВНОГО ОСТАТКА
          SALDO_MID := RKO.[ACCOUNT].[GET_SALDO_AVER](
														 (CASE WHEN RKO.[ACCOUNT].[DATE_OP] < TO_DATE('01.01.2013', 'DD.MM.YYYY') THEN
														  TO_DATE('01.01.2013', 'DD.MM.YYYY') ELSE RKO.[ACCOUNT].[DATE_OP] END)  /*P#DATE_1*/		--Дата начала
														,TRUNC(TODAY)              /*P#DATE_2*/		--Дата окончания
														,SALDO                     /*P#SALDO*/		--Среднедневной остаток в валюте
														,SALDO                     /*P#SALDO_NAT*/		--Среднедневной остаток в основной валюте
														--22.6.05 ,FALSE                      /*P#ZO*/		--Признак учета ЗО
														,FALSE                      /*P#NT*/		--Признак возвращения остатка в основной валюте
													 ); 	
		 -------------------СТАРТ ---- НАХОДИМ СУММУ СНЯТИЙ ЗА ДЕНЬ ПО СЧЕТУ --------------
		   FOR (SELECT MD(
			  	          SUM(MD.[SUM]) : SUM_DOC
			  	         )
			  	IN [MAIN_DOCUM]
			  	WHERE TRUNC(MD.[DATE_PROV]) = TRUNC(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
			  	      AND MD.[ACC_KT].[MAIN_USV].[NUM] in ('20202')
			  	)
		   LOOP
	            SUM_DEN := MD.SUM_DOC;
		   END LOOP;
		 -- ----------------- НАХОДИМ СУММУ, С КОТОРОЙ НУЖНО БРАТЬ КОМИССИЮ ПО ШКАЛЕ -------
		   SUMA_BP := NVL(SUMA_IN_NAL_RUB,0) - (NVL(SUMA_OUT_NAL_RUB,0) + NVL(SUMA_OUT_BN_RUB,0));
		   IF SUM_DEN IS NOT NULL THEN
	          SUMA := SUMA_DOC + NVL(SUM_DEN,0);
		   ELSE
		      SUMA := SUMA_DOC;
		   END IF;
		   IF SUMA_BP >= SUMA THEN
		      RETURN 0;
		   ELSE
		      SUMA_BP := NVL(SUMA_IN_BN_RUB,0) - ABS(NVL(SUMA_BP,0)) - NVL(SALDO_MID,0);
		   END IF;
		
	return greatest(SUMA_BP,0);
end;

function get_sum_calc(sum_oper [SUMMA],sum_bp [SUMMA]) return [SUMMA] is
begin
	if sum_oper <= sum_bp then
		return sum_oper;
	else
		return sum_oper-sum_bp;
	end if;	
end;

FUNCTION GET_SUM_FROM_RC(P_DOC REF [MAIN_DOCUM]) RETURN INTEGER
IS
                -- В случае если документ SWIFT с комиссией BEN, то сумма записи в БВО должна браться из поля 33B документа SWIFT
   DRC_REF       REF [DOCUM_RC];
   V_SUM_STR     STRING;
   V_SUM         NUMBER(17,2);
   SF            ::[TYPE_DOC_RC].[SFORM]%TYPE;
BEGIN
     DRC_REF := ::[FIN_ACCOUNT_INT].[PRX_DOCUMENT].DOCUM_RC_GETDOCRC(P_DOC);
     IF DRC_REF IS NOT NULL THEN   -- Если определен документ РЦ и комиссия OUR = 0 И BEN = 1
       IF DRC_REF.[MT103] IS NOT NULL AND DRC_REF.[CHARGPAY]=0 THEN
          RETURN 1;
       ELSIF DRC_REF.[MT103] IS NOT NULL AND DRC_REF.[CHARGPAY]=1 THEN
          RETURN 2;
       END IF;
     END IF;
     RETURN 0;
end;

function GET_SUM_OBOR_MONTH(RKO ref [RKO], P_PAR VARCHAR2(100)) return [SUMMA] is
rk1 			ref [RKO];
today 			[DATE];
SUMA                [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_DOC            [SUMMA] := 0;            -- СУММА ДОКУМЕНТА
SUM_DEN             [SUMMA] := 0;            -- СУММА СНЯТИЙ ЗА ДЕНЬ ПО СЧЕТУ
mn_ref ref [MAIN_DOCUM];
begin
&OpDate;
   IF P_PAR = 'СУММА_РКОМ_ЗАЙМЫ' THEN
  	FOR (SELECT MD(
                   SUM(MD.[SUM_KSPL].[2]) : SUM_KSPL
		  	      )
		 IN [MAIN_DOCUM]
		 WHERE TRUNC(TODAY, 'mm') <= TRUNC(MD.[DATE_PROV]) AND TRUNC(MD.[DATE_PROV]) <= TRUNC(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
		  	   AND MD.[ACC_KT].[MAIN_USV].[NUM] = '20202'
		  	   AND MD.[VID_DOC].[CODE] IN ('КАСС_ЧЕК_ВЫДАЧА', 'КАСС_РАСХОД_ОРД')
		  	   AND MD.[SUM_KSPL].[1].[1] NOT IN ('40','41','50','58')
		  	   AND SYSDATE > MD.[ASTR_DATE_PROV]+(60/86400)*5
		)
     LOOP
         SUM_DEN := MD.SUM_KSPL;
 	 END LOOP;
   ELSIF P_PAR = 'СУММА_РАСЧ_ИНД_ПРЕД' THEN
  	FOR (SELECT MD(
                   SUM(MD.[SUM_KSPL].[2]) : SUM_KSPL
		  	      )
		 IN [MAIN_DOCUM]
		 WHERE TRUNC(TODAY, 'mm') <= TRUNC(MD.[DATE_PROV]) AND TRUNC(MD.[DATE_PROV]) <= TRUNC(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
		  	   AND MD.[ACC_KT].[MAIN_USV].[NUM] = '20202'
		  	   AND MD.[SUM_KSPL].[1].[1] IN ('58')
		  	   AND SYSDATE > MD.[ASTR_DATE_PROV]+(60/86400)*5
		)
     LOOP
         SUM_DEN := MD.SUM_KSPL;
 	 END LOOP;
   ELSIF P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ' THEN
  	FOR (SELECT MD(
                   SUM(MD.[SUM_KSPL].[2]) : SUM_KSPL
		  	      )
		 IN [MAIN_DOCUM]
		 WHERE TRUNC(TODAY, 'mm') <= TRUNC(MD.[DATE_PROV]) AND TRUNC(MD.[DATE_PROV]) <= TRUNC(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
		  	   AND MD.[ACC_KT].[MAIN_USV].[NUM] = '20202'
		  	   AND MD.[SUM_KSPL].[1].[1] NOT IN ('40','41','42') --,'54'
		  	   AND SYSDATE > MD.[ASTR_DATE_PROV]+(60/86400)*5
		)
     LOOP
         SUM_DEN := MD.SUM_KSPL;
 	 END LOOP;
   ELSIF P_PAR = 'СУММА_РАСЧ_ЗП_СТИП' THEN
  	FOR (SELECT MD(
                   SUM(MD.[SUM_KSPL].[2]) : SUM_KSPL
		  	      )
		 IN [MAIN_DOCUM]
		 WHERE TRUNC(TODAY, 'mm') <= TRUNC(MD.[DATE_PROV]) AND TRUNC(MD.[DATE_PROV]) <= TRUNC(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
		  	   AND MD.[ACC_KT].[MAIN_USV].[NUM] = '20202'
		  	   AND MD.[SUM_KSPL].[1].[1] IN ('40','41')
		  	   AND SYSDATE > MD.[ASTR_DATE_PROV]+(60/86400)*5
		)
     LOOP
         SUM_DEN := MD.SUM_KSPL;
 	 END LOOP;   	 	
   END IF;
    RETURN NVL(SUM_DEN,0);
END;	


function GET_SUM_OBOR_DN(RKO ref [RKO], P_PAR VARCHAR2(100)) return [SUMMA] is
rk1 			ref [RKO];
today 			[DATE];
SUMA                [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_DOC            [SUMMA] := 0;            -- СУММА ДОКУМЕНТА
