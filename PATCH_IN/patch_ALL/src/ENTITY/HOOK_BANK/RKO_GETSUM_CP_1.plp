class HOOK_BANK;

@name('РКО. Получение суммы для бизнес-операции. Вер.01 (точка вызова)')
@tag('COPIED')
static method RKO_GETSUM_CP_1 is
pragma macro (OpDate, 'today := ::[BRANCH].SLIB.opdate_filial(rk1.[FILIAL])');

function GET_SUM_SCALE(RKO ref [RKO]) return [SUMMA] is
rk1 			ref [RKO];
today 			[DATE];
SUMA_BP             [SUMMA] := 0;            -- СУММА БАЗНАЛИЧНЫХ ПОСТУПЛЕНИЙ
SUMA_PRED           [SUMMA] := 0;            -- СУММА ПРЕДЫДУЩИХ СНЯТИЙ ЗА ПОСЛЕДНИЕ 30 ДНЕЙ
SUMA                [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_DOC            [SUMMA] := 0;            -- СУММА ДОКУМЕНТА
SUM_DEN             [SUMMA] := 0;            -- СУММА СНЯТИЙ ЗА ДЕНЬ ПО СЧЕТУ
SUMA_SH1            [SUMMA] := 149999;       -- СУММА ПО ШКАЛЕ №1
SUMA_SH2            [SUMMA] := 599999;       -- СУММА ПО ШКАЛЕ №2
SALDO               [SUMMA] := 0;            -- ВХОДЯЩИЙ ОСТАТОК ПО СЧЕТУ КЛИЕНТА
SALDO_MID           [SUMMA] := 0;            -- СРЕДНЕДНЕВНОЙ ОСТАТОК
SUMA_IN_NAL_RUB     [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_IN_BN_RUB      [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_OUT_NAL_RUB    [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_OUT_BN_RUB     [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА

mn_ref ref [MAIN_DOCUM];
begin
&OpDate;
			BEGIN
		         LOCATE MN_REF IN ::[MAIN_DOCUM] WHERE MN_REF%ID = RKO;
				 EXCEPTION WHEN NO_DATA_FOUND THEN
						MN_REF:=::[PATTERN_DOC].[BUSINESS_OP].DOC_REF;
			END;
	       SUMA_DOC := mn_ref.[SUM];  -- СУММА ДОКУМЕНТА
        -----------------------------   Обновление массива "Операции клиента" ---------------------------------------
            ::[CLIENT].[GENERATOR_TASK](
										 RKO.[FILIAL]           /*P_FILIAL*/		--Филиал
										,TODAY                  /*P_DATE*/		--Дата начала
										,TODAY                  /*P_DATE_END*/		--Дата окончания
										,TRUE    		        --Удалить загруженные данные
										,RKO.[CLIENT]           /*P_CLIENT*/		--Клиент
										,NULL                   /*P_STAT_PAR*/		--Статистический параметр
										,NULL                   /*P_ONLY_POST*/		--Пересчет стат.параметоров по документам вставки прошлой датой
										,NULL                   /*P_DAY*/		--Контроль вставки документов прошлой датой (дней)
										);	
        -------------------------------   находим входящий остаток по счету на 01.01.2013 -----------
          SALDO := ABS(F.A('И'||RKO.[ACCOUNT]||'СН', TO_DATE('01.01.2013', 'DD.MM.YYYY')));		
        ------------------- СТАРТ ОПЕРАЦИИ КЛИЕНТА ПО КОДУ 'PSH_IN_NAL_RUB' -------------------------------------------------------------------
          FOR (SELECT S(
                        SUM(S.[OPER_SUM])    : SUMA_OPER
                       )           												 			
               IN [CL_OPERATIONS] ALL
               WHERE RKO.[CLIENT].[CL_OPER1] = S%COLLECTION AND S.[OPER_ACC] = RKO.[ACCOUNT] AND S.[STATE_PARAM].[CODE] IN ('PSH_IN_NAL_RUB')
              )
          LOOP
              SUMA_IN_NAL_RUB := NVL(SALDO,0) + NVL(S.SUMA_OPER,0);
          END LOOP;
        ------------------- СТАРТ ОПЕРАЦИИ КЛИЕНТА ПО КОДУ 'PSH_IN_BN_RUB' -------------------------------------------------------------------
          FOR (SELECT S(
                        SUM(S.[OPER_SUM])    : SUMA_OPER
                       )           												 			
               IN [CL_OPERATIONS] ALL
               WHERE RKO.[CLIENT].[CL_OPER1] = S%COLLECTION AND S.[OPER_ACC] = RKO.[ACCOUNT] AND S.[STATE_PARAM].[CODE] IN ('PSH_IN_BN_RUB')
              )
          LOOP
              SUMA_IN_BN_RUB := NVL(S.SUMA_OPER,0);
          END LOOP;
        ------------------- СТАРТ ОПЕРАЦИИ КЛИЕНТА ПО КОДУ 'PSH_OUT_NAL_RUB' -------------------------------------------------------------------
          FOR (SELECT S(
                        SUM(S.[OPER_SUM])    : SUMA_OPER
                       )           												 			
               IN [CL_OPERATIONS] ALL
               WHERE RKO.[CLIENT].[CL_OPER1] = S%COLLECTION AND S.[OPER_ACC] = RKO.[ACCOUNT] AND S.[STATE_PARAM].[CODE] IN ('PSH_OUT_NAL_RUB')
              )
          LOOP
              SUMA_OUT_NAL_RUB := NVL(S.SUMA_OPER,0);
          END LOOP;
        ------------------- СТАРТ ОПЕРАЦИИ КЛИЕНТА ПО КОДУ 'PSH_OUT_BN_RUB' -------------------------------------------------------------------
          FOR (SELECT S(
                        SUM(S.[OPER_SUM])    : SUMA_OPER
                       )           												 			
               IN [CL_OPERATIONS] ALL
               WHERE RKO.[CLIENT].[CL_OPER1] = S%COLLECTION AND S.[OPER_ACC] = RKO.[ACCOUNT] AND S.[STATE_PARAM].[CODE] IN ('PSH_OUT_BN_RUB')
              )
          LOOP
              SUMA_OUT_BN_RUB := NVL(S.SUMA_OPER,0);
          END LOOP;
        --------------------------------  РАССЧИТАЕМ СРЕДНЕДНЕВНОГО ОСТАТКА
          SALDO_MID := RKO.[ACCOUNT].[GET_SALDO_AVER](
														 (CASE WHEN RKO.[ACCOUNT].[DATE_OP] < TO_DATE('01.01.2013', 'DD.MM.YYYY') THEN
														  TO_DATE('01.01.2013', 'DD.MM.YYYY') ELSE RKO.[ACCOUNT].[DATE_OP] END)  /*P#DATE_1*/		--Дата начала
														,TRUNC(TODAY)              /*P#DATE_2*/		--Дата окончания
														,SALDO                     /*P#SALDO*/		--Среднедневной остаток в валюте
														,SALDO                     /*P#SALDO_NAT*/		--Среднедневной остаток в основной валюте
														--22.6.05,FALSE                      /*P#ZO*/		--Признак учета ЗО
														,FALSE                      /*P#NT*/		--Признак возвращения остатка в основной валюте
													 ); 	
		 -------------------СТАРТ ---- НАХОДИМ СУММУ СНЯТИЙ ЗА ДЕНЬ ПО СЧЕТУ --------------
		   FOR (SELECT MD(
			  	          SUM(MD.[SUM]) : SUM_DOC
			  	         )
			  	IN [MAIN_DOCUM]
			  	WHERE TRUNC(MD.[DATE_PROV]) = TRUNC(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
			  	      AND MD.[ACC_KT].[MAIN_USV].[NUM] in ('20202')
			  	)
		   LOOP
	            SUM_DEN := MD.SUM_DOC;
		   END LOOP;
		 -- ----------------- НАХОДИМ СУММУ, С КОТОРОЙ НУЖНО БРАТЬ КОМИССИЮ ПО ШКАЛЕ -------
		   SUMA_BP := NVL(SUMA_IN_NAL_RUB,0) - (NVL(SUMA_OUT_NAL_RUB,0) + NVL(SUMA_OUT_BN_RUB,0));
		   IF SUM_DEN IS NOT NULL THEN
	          SUMA := SUMA_DOC + NVL(SUM_DEN,0);
		   ELSE
		      SUMA := SUMA_DOC;
		   END IF;
		   IF SUMA_BP >= SUMA THEN
		      RETURN 0;
		   ELSE
		      SUMA_BP := NVL(SUMA_IN_BN_RUB,0) - ABS(NVL(SUMA_BP,0)) - NVL(SALDO_MID,0);
		   END IF;
		
	return SUMA_BP;
end;
RKO_GETSUM_CP_1 (
	@name('Договор РКО')              P_RKO        in [RKO_REF],
	@name('Тип суммы')                P_TYPE_SUMMA in [SUM_GUIDE_REF],
	@name('Дополнительные параметры') P_ADDS       in [STRING_32000]  default null
) return [SUMMA_16_6] is

execute is
pragma macro (OpDate, 'today := ::[BRANCH].SLIB.opdate_filial(rk1.[FILIAL])');
today 			    [DATE];
rk1 			ref [RKO] := P_RKO;
v_main_doc      ref [main_docum];
MN_REF          ref [MAIN_DOCUM];
v_sum               number(17,2) := 0;
SUMA_BP             [SUMMA] := 0;            -- СУММА БАЗНАЛИЧНЫХ ПОСТУПЛЕНИЙ
SUMA                [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_DOC            [SUMMA] := 0;            -- СУММА ДОКУМЕНТА
SUM_DEN             [SUMMA] := 0;            -- СУММА СНЯТИЙ ЗА ДЕНЬ ПО СЧЕТУ
SUMA_SH1            [SUMMA] := 149999;       -- СУММА ПО ШКАЛЕ №1
SUMA_SH2            [SUMMA] := 599999;       -- СУММА ПО ШКАЛЕ №2

sumRet [SUMMA_16_6];
strAdds varchar2(32000) := null;	-->> PSH VRI 24/11/2025 CFT-2894 Начисление %% на остаток по счету ЮЛ
begin
	IF p_type_summa = ::[SUM_GUIDE]([COD]='СУММА_ДОК_ПРЕД') THEN
	   v_main_doc := ::[RUNTIME].[STR].get_str_par(P_ADDS, 'DOC_RKO');
	   RETURN v_sum;
	ELSIF p_type_summa = ::[SUM_GUIDE]([COD]='СУММА_РАСЧ_КОМ') THEN
	   &OpDate;
       MN_REF := ::[RUNTIME].[STR].get_str_par(P_ADDS, 'DOC_RKO');	
       SUMA_DOC := mn_ref.[SUM];  -- СУММА ДОКУМЕНТА
        	FOR (SELECT MD(
			  	          SUM(MD.[SUM]) : SUM_DOC
			  	         )
			  	IN [MAIN_DOCUM]
			  	WHERE TRUNC(MD.[DATE_PROV]) = TRUNC(TODAY) AND MD.[ACC_DT] = P_RKO.[ACCOUNT]
			  	      AND MD.[ACC_KT].[MAIN_USV].[NUM] in ('20202')
			  	)
		   LOOP
	            SUM_DEN := MD.SUM_DOC;
		   END LOOP;
		 -- ----------
		  IF SUM_DEN IS NOT NULL THEN
	          SUMA := SUMA_DOC + NVL(SUM_DEN,0);
		   ELSE
		      SUMA := SUMA_DOC;
		   END IF;
		
		   SUMA_BP := GET_SUM_SCALE(P_RKO);
		  ------------------------   КОНЕЦ --------------------------------------------------
	       IF SUMA_BP > 0 AND SUM_DEN IS NOT NULL THEN
	          IF SUMA <= SUMA_SH1 AND SUMA_BP >= SUMA_DOC THEN
	             RETURN SUMA_DOC;
	          ELSIF SUMA <= SUMA_SH1 AND SUMA_BP < SUMA_DOC AND SUM_DEN IS NULL THEN
	             SUMA := SUMA_BP;
	          ELSIF SUMA <= SUMA_SH1 AND SUMA_BP < SUMA_DOC AND SUM_DEN IS NOT NULL THEN
	             SUMA := SUMA_BP - NVL(SUM_DEN,0);
	          END IF;
	          IF SUMA > SUMA_SH1 AND SUMA_BP >= SUMA_SH1 THEN
	             SUMA := SUMA_SH1 - NVL(SUM_DEN,0);
	             IF SUMA > 0 THEN
	                RETURN SUMA;
	             ELSE
	                SUMA := 0;
	                RETURN SUMA;
	             END IF;
	          ELSIF SUMA > SUMA_SH1 AND SUMA_BP < SUMA_SH1 THEN
	             SUMA := SUMA_BP - NVL(SUM_DEN,0);
	             IF SUMA > 0 THEN
	                RETURN SUMA;
	             ELSE
	                RETURN 0;
	             END IF;
	          END IF;
	       END IF;		
	       IF SUMA_BP >= SUMA_DOC AND SUMA_DOC <= SUMA_SH1 THEN
	          RETURN SUMA_DOC;			   	
	       ELSIF SUMA_BP >= SUMA_DOC AND SUMA_DOC > SUMA_SH1 THEN
	          RETURN SUMA_BP;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC <= SUMA_SH1 THEN
	          RETURN SUMA_BP;	
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC > SUMA_SH1 THEN
	          IF SUMA_BP <= SUMA_SH1 THEN
	             RETURN SUMA_BP;
	          ELSE
	             RETURN SUMA_SH1;	
	          END IF;	
	       END IF;
	       RETURN 0;
	ELSIF p_type_summa = ::[SUM_GUIDE]([COD]='СУММА_РАСЧ_КОМ2') THEN
	   &OpDate;
       MN_REF := ::[RUNTIME].[STR].get_str_par(P_ADDS, 'DOC_RKO');	
       SUMA_DOC := mn_ref.[SUM];  -- СУММА ДОКУМЕНТА
        	FOR (SELECT MD(
			  	          SUM(MD.[SUM]) : SUM_DOC
			  	         )
			  	IN [MAIN_DOCUM]
			  	WHERE TRUNC(MD.[DATE_PROV]) = TRUNC(TODAY) AND MD.[ACC_DT] = P_RKO.[ACCOUNT]
			  	      AND MD.[ACC_KT].[MAIN_USV].[NUM] in ('20202')
			  	)
		   LOOP
	            SUM_DEN := MD.SUM_DOC;
		   END LOOP;
		 -- ----------
		  IF SUM_DEN IS NOT NULL THEN
	          SUMA := SUMA_DOC + NVL(SUM_DEN,0);
		   ELSE
		      SUMA := SUMA_DOC;
		   END IF;
		
		   SUMA_BP := GET_SUM_SCALE(P_RKO);
	  ------------------------   КОНЕЦ --------------------------------------------------
	       IF SUMA_BP > 0 AND SUM_DEN IS NOT NULL THEN
	          IF SUMA > SUMA_SH1 AND SUMA <= SUMA_SH2 AND SUMA_BP >= SUMA_DOC THEN
	             IF NVL(SUM_DEN,0) > SUMA_SH1 THEN
	                RETURN SUMA_DOC;
	             ELSE
	                SUMA := SUMA - SUMA_SH1;
	             END IF;
	             RETURN SUMA;
	          ELSIF SUMA <= SUMA_SH1 THEN
	             SUMA := 0;
	             RETURN SUMA;
	          ELSIF SUMA > SUMA_SH2 AND SUMA_BP >= SUMA_DOC THEN
	             IF NVL(SUM_DEN,0) > SUMA_SH2 THEN
	                SUMA := 0;
	                RETURN SUMA;
	             ELSIF NVL(SUM_DEN,0) <= SUMA_SH1 THEN
	                SUMA := SUMA_SH2 - SUMA_SH1;
	                RETURN SUMA;
	             ELSIF NVL(SUM_DEN,0) > SUMA_SH1 AND NVL(SUM_DEN,0) <= SUMA_SH2 THEN
	                SUMA := SUMA_SH2 - NVL(SUM_DEN,0);
	                RETURN SUMA;
	             END IF;
	          ELSIF SUMA > SUMA_SH2 AND SUMA_BP < SUMA_DOC THEN    --- ESLI SUMA SNIATII > 2 GRANITSI SHKALI I NEHVATAET BEZNALICHNIH PEREVODOV
	             IF (SUM_DEN + SUMA_BP)<= SUMA_SH1 THEN
	                SUMA := 0;
	                RETURN SUMA;
	             ELSIF SUM_DEN > SUMA_SH2 THEN
	                SUMA := 0;
	                RETURN SUMA;
	             ELSIF SUM_DEN <= SUMA_SH2 AND SUM_DEN > SUMA_SH1 AND (SUM_DEN + SUMA_BP) <= SUMA_SH2 THEN
	                RETURN SUMA_BP;
	             ELSIF SUM_DEN <= SUMA_SH2 AND SUM_DEN > SUMA_SH1 AND (SUM_DEN + SUMA_BP) > SUMA_SH2 THEN
	                SUMA := SUMA_SH2 - SUM_DEN;
	                RETURN SUMA;
	             END IF;
	          ELSIF SUMA > SUMA_SH1 AND SUMA <= SUMA_SH2 AND SUMA_BP < SUMA_DOC THEN
	             IF (SUM_DEN + SUMA_BP) <= SUMA_SH1 THEN
	                SUMA := 0;
	                RETURN SUMA;
	             ELSIF SUM_DEN > SUMA_SH1 AND (SUM_DEN + SUMA_BP) <= SUMA_SH2 THEN
	                RETURN SUMA_BP;
	             ELSIF SUM_DEN > SUMA_SH1 AND SUM_DEN <= SUMA_SH2 AND (SUM_DEN + SUMA_BP) > SUMA_SH2 THEN
	                SUMA := SUMA_SH2 - SUM_DEN;
	                RETURN SUMA_BP;
	             END IF;
	          END IF;
	       END IF;		
	       IF SUMA_BP >= SUMA_DOC AND SUMA_DOC <= SUMA_SH1 THEN
	          RETURN 0;			   	
	       ELSIF SUMA_BP >= SUMA_DOC AND SUMA_DOC > SUMA_SH1 AND SUMA_DOC <= SUMA_SH2 THEN
	          SUMA := SUMA_DOC - SUMA_SH1;
	          RETURN SUMA;
	       ELSIF SUMA_BP >= SUMA_DOC AND SUMA_DOC > SUMA_SH2 THEN
	          SUMA := SUMA_SH2 - SUMA_SH1;
	          RETURN SUMA;	
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC <= SUMA_SH1 THEN
	          RETURN 0;	
	       ELSIF SUMA_BP < SUMA_SH1 THEN
	          RETURN 0;
	       ELSIF SUMA_BP < SUMA_SH2 THEN
	          RETURN SUMA_DOC;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC > SUMA_SH1 AND SUMA_DOC <= SUMA_SH2 AND SUMA_BP < SUMA_SH1 THEN
              RETURN 0;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC > SUMA_SH1 AND SUMA_DOC <= SUMA_SH2 AND SUMA_BP > SUMA_SH1 THEN
	          SUMA := SUMA_BP - SUMA_SH1;
              RETURN SUMA;              	
	       END IF;
	        RETURN 0;
---------------------------------------    РАСЧЕТ СУММЫ ДЛЯ 3 ШКАЛЫ -----
	ELSIF p_type_summa = ::[SUM_GUIDE]([COD]='СУММА_РАСЧ_КОМ3') THEN
	   &OpDate;
       MN_REF := ::[RUNTIME].[STR].get_str_par(P_ADDS, 'DOC_RKO');	
       SUMA_DOC := mn_ref.[SUM];  -- СУММА ДОКУМЕНТА
        	FOR (SELECT MD(
			  	          SUM(MD.[SUM]) : SUM_DOC
			  	         )
			  	IN [MAIN_DOCUM]
			  	WHERE TRUNC(MD.[DATE_PROV]) = TRUNC(TODAY) AND MD.[ACC_DT] = P_RKO.[ACCOUNT]
			  	      AND MD.[ACC_KT].[MAIN_USV].[NUM] in ('20202')
			  	)
		   LOOP
	            SUM_DEN := MD.SUM_DOC;
		   END LOOP;
		 -- ----------
		  IF SUM_DEN IS NOT NULL THEN
	          SUMA := SUMA_DOC + NVL(SUM_DEN,0);
		   ELSE
		      SUMA := SUMA_DOC;
		   END IF;
		
		   SUMA_BP := GET_SUM_SCALE(P_RKO);
		
	       IF SUMA_BP > 0 AND SUM_DEN IS NOT NULL THEN
	          IF SUMA > SUMA_SH2 AND SUMA_BP >= SUMA_DOC THEN
	             IF NVL(SUM_DEN,0) > SUMA_SH2 THEN
	                RETURN SUMA_DOC;
	             ELSE
	                SUMA := SUMA - SUMA_SH2;
	             END IF;
	             RETURN SUMA;
	          ELSIF SUMA <= SUMA_SH2 THEN
	             SUMA := 0;
	             RETURN SUMA;
	          ELSIF SUMA > SUMA_SH2 AND SUMA_BP < SUMA_DOC THEN    --- ESLI SUMA SNIATII > 2 GRANITSI SHKALI I NEHVATAET BEZNALICHNIH PEREVODOV
	             IF (SUM_DEN + SUMA_BP) <= SUMA_SH2 THEN
	                SUMA := 0;
	                RETURN SUMA;
	             ELSIF SUM_DEN > SUMA_SH2 AND SUMA_BP > SUM_DEN THEN
	                SUMA := SUMA_BP - SUM_DEN;
	                RETURN SUMA;
	             ELSIF SUM_DEN < SUMA_SH2 AND SUMA_BP > SUMA_SH2 THEN
	                SUMA := SUMA_BP - SUMA_SH2;
	                RETURN SUMA;
	             ELSIF SUM_DEN > SUMA_BP THEN
	                SUMA := 0;
	                RETURN SUMA;
	             END IF;
	          END IF;
	       END IF;		
	       IF SUMA_BP >= SUMA_DOC AND SUMA_DOC <= SUMA_SH2 THEN
	          RETURN 0;			   	
	       ELSIF SUMA_BP >= SUMA_DOC AND SUMA_DOC > SUMA_SH2 THEN
	          SUMA := SUMA_DOC - SUMA_SH2;
	          RETURN SUMA;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC <= SUMA_SH2 THEN
	          RETURN 0;	
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC > SUMA_SH2 THEN
	          IF SUMA_BP <= SUMA_SH2 THEN
	             RETURN 0;
	          ELSE
	             RETURN SUMA_BP;	
	          END IF;	
	       END IF;
	       RETURN 0;
	elsif p_type_summa = ::[SUM_GUIDE]([COD]='СУМПОРУЧ')  then
		declare
			v_fns_order ref [FNS_ORDER];
			v_acc_num	varchar2(32000);
			v_acc_ref	ref [AC_FIN];
			v_acc_lim_work	ref [ACC_LIM_WORK];
		begin
			v_fns_order := ::[RUNTIME].[STR].get_num_par(P_ADDS, 'FNS_ORDER');			
			v_acc_lim_work	:= ::[RUNTIME].[STR].get_num_par(P_ADDS, 'ACC_LIM_WORK');
			v_acc_ref := v_acc_lim_work.[ACCOUNT];
			
			if v_fns_order is not null and v_acc_ref is not null then
				--if v_fns_order.[RECOVERY_SUM] <= abs(v_acc_ref.[SALDO]) then
					return v_fns_order.[RECOVERY_SUM];
				--else
				--	return abs(v_acc_ref.[SALDO]);
				--end if;
			end if;
		end;	

	-->> PSH VRI 24/11/2025 CFT-2894 Начисление %% на остаток по счету ЮЛ
	elsif P_TYPE_SUMMA->[COD] like 'PSB_CL_NAL%' then
		return ::[RKO].[CALC_PAR]( P_TYPE_SUMMA->[COD], null, P_RKO, strAdds);
	--<< PSH VRI 24/11/2025 CFT-2894 Начисление %% на остаток по счету ЮЛ
		
	END IF;
	
	sumRet := ::[HOOK_BANK].[RKO_GETSUM_CP_2](P_RKO,P_TYPE_SUMMA,P_ADDS);
	RETURN sumRet;
END;
end;
end;
