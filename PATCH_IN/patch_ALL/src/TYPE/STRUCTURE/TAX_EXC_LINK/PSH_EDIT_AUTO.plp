class TAX_EXC_LINK;

@name('[ПСБ] Изменить (служебная)')
@tag('CREATED')
method PSH_EDIT_AUTO is
PSH_EDIT_AUTO (
	@name('Тип связи')            P_LINK_TYPE in [TAX_EXC_LT_REF],
	@name('Порождающий документ') P_REASON    in [DOC_TAX_REF],
	@name('Порождаемый документ') P_RESULT    in [DOC_TAX_REF]
) is

validate is
begin
	-- Start initialization of parameters and variables
	if p_message = 'DEFAULT' then
		P_LINK_TYPE := this.[LINK_TYPE];
		P_REASON := this.[REASON];
		P_RESULT := this.[RESULT];
	end if;
	-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Тип связи"
	[LINK_TYPE] := P_LINK_TYPE;
	-- Установка значения реквизита "Порождающий документ"
	[REASON] := P_REASON;
	-- Установка значения реквизита "Порождаемый документ"
	[RESULT] := P_RESULT;
end;
end;
end;
