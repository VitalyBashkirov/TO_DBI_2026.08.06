class PSH_FTC;

@name('[ПСБ] Добавить')
@tag('CREATED')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('Имя файла')                  P_F_NAME     in [STRING_100],
	@name('Дата загрузки')              P_DATE_IN    in [DATE_TIME],
	@name('Действует')                  P_WORK       in [BOOLEAN],
	@name('ИНН участника ВЭД')          P_FTC_INN    in [STRING_12],
	@name('Наименование участника ВЭД') P_FTC_NAME   in [STRING_300],
	@name('Примечание')                 P_NOTE       in [MEMO],
	@name('Ссылка на Клиента в АБС')    P_FTC_CLIENT in [CLIENT_REF]
) return ref [PSH_FTC] is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_F_NAME := this.[F_NAME];
	P_DATE_IN := this.[DATE_IN];
	P_WORK := this.[WORK];
	P_FTC_INN := this.[FTC_INN];
	P_FTC_NAME := this.[FTC_NAME];
	P_NOTE := this.[NOTE];
	P_FTC_CLIENT := this.[FTC_CLIENT];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Имя файла"
	[F_NAME] := P_F_NAME;
	-- Установка значения реквизита "Дата загрузки"
	[DATE_IN] := P_DATE_IN;
	-- Установка значения реквизита "Действует"
	[WORK] := P_WORK;
	-- Установка значения реквизита "ИНН участника ВЭД"
	[FTC_INN] := P_FTC_INN;
	-- Установка значения реквизита "Наименование участника ВЭД"
	[FTC_NAME] := P_FTC_NAME;
	-- Установка значения реквизита "Примечание"
	[NOTE] := P_NOTE;
	-- Установка значения реквизита "Ссылка на Клиента в АБС"
	[FTC_CLIENT] := P_FTC_CLIENT;
end;
end;
end;
