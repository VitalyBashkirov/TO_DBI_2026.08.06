class PRODUCT;

@name('[ПСБ] Библиотека функций')
@tag('KUP_P')
library PSH_LIB is
-- !!! При внесение изменений в get_product_on_date в части поиска рабочих продуктов
--     необходимо вносить изменения в get_product_on_date_bool и наоборот

/*
Запись возвращенных ссылок функцией get_product_on_date
*/
public type rec_prod is record (
							prod_id			number,
							prod_class		varchar2(16),
							p_filial	ref	[BRANCH],
							p_date_begin	[DATE],
							p_date_close	[DATE],
							p_acc			varchar2(20),
							split			varchar2(1),
							p_is_once		boolean,
							create_user		number
);
public type t_rec_prod is table of rec_prod index by integer;
public rec_prod_tbl 		t_rec_prod;

pragma include ([RUNTIME]::[DEBUG_MACRO]);

v_csp	ref	[COM_STATUS_PRD] := ::[COM_STATUS_PRD]([CODE] = 'ANNUL');	

/*
Функция возвращает список работающих продуктов на дату
Для карт проверяется клиент держатель карты, даже если у него отсутствует депозит.
*/
public function get_product_on_date(	p_client	ref	[CLIENT],
								/*ссылка на клиента*/
								p_date			[DATE] default null ,
								/*дата на которую запрашиваем, если пустое, то на текущую дату*/
								p_str_product	varchar2(2000) default null,
								/*список классов(глобальных) через запятую. При пустом списке запрашивается по всем продуктам*/
								p_is_once		boolean	default	false,
								p_wite_close_card boolean default false)
								/*Не возвращаются карты в состоянии ожидают закрытие. При пустом списке возвращаются карты и в состоянии ожидает закрытие*/
return	rec_prod_tbl is 
i					integer := 1;
f					integer;
tmp_rec				rec_prod_tbl;
v_rec_prod_tbl		rec_prod_tbl;
max_date_split		date;
v_cl_priv		ref	[CL_PRIV];
begin
	v_rec_prod_tbl.delete;
/*	if p_client is null then
		pragma error('Ошибка! Не передан клиент.');
	end if;*/

	&debug('DEPN',0)
	if instr(p_str_product, 'DEPN') > 0 or p_str_product is null then
		for(	select	x(	x%id			:c_id,
							x%class			:c_class,
							x.[FILIAL]		:c_filial,
							d.[ACCOUNT].[MAIN_V_ID]	: c_acc,
							least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN]))	:c_date_begin,
							nvl(x.[DATE_CLOSE],to_date('01/01/4000','dd/mm/yyyy'))	:c_date_close,
							x.[CREATE_USER]	:c_create_user)
					in	[PRODUCT],
						([DEPN] all :d) all
				where	d.[CLIENT] = p_client and d%id =x%id and
						--(instr(p_str_product, x%class) > 0 or p_str_product is null) and
						(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
						nvl(x.[COM_STATUS],0) <> v_csp)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			v_rec_prod_tbl(i).p_acc := x.c_acc;
			v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
			v_rec_prod_tbl(i).p_date_close := x.c_date_close;
			v_rec_prod_tbl(i).create_user := x.c_create_user;
			i := i + 1;
		end loop;
	end if;

	&debug('PR_CRED',0)
	if instr(p_str_product, 'PR_CRED') > 0 or p_str_product is null then
		for(	select	x(	x%id			:c_id,
							x%class			:c_class,
							x.[FILIAL]		:c_filial,
							least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN]))	:c_date_begin,
							nvl(x.[DATE_CLOSE],to_date('01/01/4000','dd/mm/yyyy'))	:c_date_close,
							x.[CREATE_USER]	:c_create_user)
					in	[PRODUCT],
						([PR_CRED] all :d) all
				where	d.[CLIENT] = p_client and d%id =x%id and
						--(instr(p_str_product, x%class) > 0 or p_str_product is null) and
						(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
						nvl(x.[COM_STATUS],0) <> v_csp)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
			v_rec_prod_tbl(i).p_date_close := x.c_date_close;
			v_rec_prod_tbl(i).create_user := x.c_create_user;
			i := i + 1;
		end loop;
	end if;

	&debug('VZ_CARDS',0)
	if instr(p_str_product, 'VZ_CARDS') > 0 or p_str_product is null then
		for(	select	x(	x%id			:c_id,
							x%class			:c_class,
							x.[FILIAL]		:c_filial,
							least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN]))	:c_date_begin,
							nvl(x.[DATE_CLOSE],to_date('01/01/4000','dd/mm/yyyy'))	:c_date_close,
							x.[CREATE_USER]	:c_create_user)
					in	[PRODUCT],
						([VZ_CARDS] all :d) all
				where	d.[CLIENT] = p_client and d%id =x%id and
						--(instr(p_str_product, x%class) > 0 or p_str_product is null) and
						(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
						nvl(x.[COM_STATUS],0) <> v_csp
						and not (d%state in ('CLS', 'ARC') and p_wite_close_card)
						)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
			v_rec_prod_tbl(i).p_date_close := x.c_date_close;
			v_rec_prod_tbl(i).create_user := x.c_create_user;
			i := i + 1;
		end loop;
	end if;

	&debug('RKO',0)
	if instr(p_str_product, 'RKO') > 0 or p_str_product is null then
		for(	select	x(	x%id			:c_id,
							x%class			:c_class,
							x.[FILIAL]		:c_filial,
							least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN]))	:c_date_begin,
							nvl(x.[DATE_CLOSE],to_date('01/01/4000','dd/mm/yyyy'))	:c_date_close,
							x.[CREATE_USER]	:c_create_user)
					in	[PRODUCT],
						([RKO] all :d) all
				where	d.[CLIENT] = p_client and d%id =x%id and
						--(instr(p_str_product, x%class) > 0 or p_str_product is null) and
						(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
						nvl(x.[COM_STATUS],0) <> v_csp)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
			v_rec_prod_tbl(i).p_date_close := x.c_date_close;
			v_rec_prod_tbl(i).create_user := x.c_create_user;
			i := i + 1;
		end loop;
	end if;

	&debug('IND_SAFE_LEASE',0)
	if instr(p_str_product, 'IND_SAFE_LEASE') > 0 or p_str_product is null then
		for(	select	x(	x%id			:c_id,
							x%class			:c_class,
							x.[FILIAL]		:c_filial,
							least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN]))	:c_date_begin,
							nvl(x.[DATE_CLOSE],to_date('01/01/4000','dd/mm/yyyy'))	:c_date_close,
							x.[CREATE_USER]	:c_create_user)
					in	[PRODUCT],
						([IND_SAFE_LEASE] all :d),
						(::[HOLDER]  all : hld) all
				where	hld.[CLIENT] = p_client and hld%collection = d.[SAFE_HOLDERS] and d%id =x%id and
						(hld.[DATA_BEG] <= p_date and hld.[DATA_END] >= p_date  and
						--(instr(p_str_product, x%class) > 0 or p_str_product is null) and
						least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
						nvl(x.[COM_STATUS],0) <> v_csp)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
			v_rec_prod_tbl(i).p_date_close := x.c_date_close;
			v_rec_prod_tbl(i).create_user := x.c_create_user;
			i := i + 1;
		end loop;
	end if;

	&debug('GUARANTIES',0)
	if instr(p_str_product, 'GUARANTIES') > 0 or p_str_product is null then
		for(	select	x(	x%id			:c_id,
							x%class			:c_class,
							x.[FILIAL]		:c_filial,
							least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN]))	:c_date_begin,
							nvl(x.[DATE_CLOSE],to_date('01/01/4000','dd/mm/yyyy'))	:c_date_close,
							x.[CREATE_USER]	:c_create_user)
					in	[PRODUCT],
						([GUARANTIES] all :d) all
				where	d.[PRINCIPAL] = p_client and d%id =x%id and
						--(instr(p_str_product, x%class) > 0 or p_str_product is null) and
						(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
						(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
						nvl(x.[COM_STATUS],0) <> v_csp)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
			v_rec_prod_tbl(i).p_date_close := x.c_date_close;
			v_rec_prod_tbl(i).create_user := x.c_create_user;
			i := i + 1;
		end loop;
	end if;

	&debug('VEKSEL_GUIDE',0)
	if instr(p_str_product, 'VEKSEL_GUIDE') > 0 or p_str_product is null then
		for(	select	x(	x%id			:c_id,
							x%class			:c_class,
							x.[F_ISSUER]	:c_filial)
					in	[VEKSEL_GUIDE] all
				where	x.[FIRST_TENANT] = p_client and
						(x.[DATE_BEG_RASP] <= p_date and
						(x.[DATE_END] >= p_date or x.[DATE_END] is null) or p_date is null) -- узнать когда вексель закончился
						)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			i := i + 1;
		end loop;
	end if;


	&debug('TRUST_FOR_PROD',0)
	if instr(p_str_product, 'TRUST_FOR_PROD') > 0 or p_str_product is null then
		for(	select	x(	x%id				:c_id,
							x%class				:c_class,
							x.[FILIAL]			:c_filial,
							x.[DOCUMENT_DATE]	:c_date_begin,
							least(nvl(x.[END_DATE],to_date('01/01/4000','dd/mm/yyyy')),nvl(p.[DATE_CLOSE],to_date('01/01/4000','dd/mm/yyyy')))		:c_date_close,
							x.[DOCUMENT_USER]	:c_create_user)
					in	[TRUST_FOR_PROD],
						([PRODUCT] all :p) all
				where	x.[INI_CLIENT] = p_client and x%state <> 'AN' and
						x.[DEPOSIT] = p%id and
						(x.[DOCUMENT_DATE] <= p_date and
						( least(nvl(x.[END_DATE],p_date),
								nvl(p.[DATE_CLOSE],p_date)) >= p_date) or p_date is null)
			)
		loop
			v_rec_prod_tbl(i).prod_id := x.c_id;
			v_rec_prod_tbl(i).prod_class := x.c_class;
			v_rec_prod_tbl(i).p_filial := x.c_filial;
			v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
			v_rec_prod_tbl(i).p_date_close := x.c_date_close;
			v_rec_prod_tbl(i).create_user := x.c_create_user;
			i := i + 1;
		end loop;
	end if;
	-- разовые операции
	if p_is_once	then
		&debug('KASSA_V',0)
		if instr(p_str_product, 'KASSA_V') > 0 or p_str_product is null then
			for(	select	x(	x%id			:c_id,
								x%class			:c_class,
								x.[FILIAL]		:c_filial,
								x.[DOCUMENT_DATE]	:c_date_begin,
								x.[DOCUMENT_DATE]	:c_date_close,
								x.[DOCUMENT_USER]	:c_create_user)
						in	[DOCUMENT],
							([KASSA_V] all :d) all
					where	d.[CLIENT] = p_client and d%id =x%id and
							(trunc(x.[DOCUMENT_DATE]) = trunc(p_date) or p_date is null))
			loop
				v_rec_prod_tbl(i).prod_id := x.c_id;
				v_rec_prod_tbl(i).prod_class := x.c_class;
				v_rec_prod_tbl(i).p_filial := x.c_filial;
				v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
				v_rec_prod_tbl(i).p_date_close := x.c_date_close;
				v_rec_prod_tbl(i).p_is_once := true;
				v_rec_prod_tbl(i).create_user := x.c_create_user;
				i := i + 1;
			end loop;
		end if;
		
		--Башкиров В.Г. 08.07.2019 Отключил API DECL_ON_GET_CRED
		/** /
		&debug('DECL_ON_GET_CRED',0)
		if instr(p_str_product, 'DECL_ON_GET_CRED') > 0 or p_str_product is null then
			for(	select	x(	x%id			:c_id,
								x%class			:c_class,
								x.[FILIAL]		:c_filial,
								x.[DOCUMENT_DATE]	:c_date_begin,
								x.[DOCUMENT_DATE]	:c_date_close,
								x.[DOCUMENT_USER]	:c_create_user)
						in	[DOCUMENT],
							([DECL_ON_GET_CRED] all :d) all
					where	d.[CLIENT] = p_client and d%id =x%id and
							(trunc(x.[DOCUMENT_DATE]) = trunc(p_date) or p_date is null)and
							d.[CREDIT] is null)
			loop
				v_rec_prod_tbl(i).prod_id := x.c_id;
				v_rec_prod_tbl(i).prod_class := x.c_class;
				v_rec_prod_tbl(i).p_filial := x.c_filial;
				v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
				v_rec_prod_tbl(i).p_date_close := x.c_date_close;
				v_rec_prod_tbl(i).p_is_once := true;
				v_rec_prod_tbl(i).create_user := x.c_create_user;
				i := i + 1;
			end loop;
		end if;
		/**/
		
--		&debug('DECLARE',0)
		if instr(p_str_product, 'DECLARE') > 0 or p_str_product is null then
/*			for(	select	x(	x%id			:c_id,
								x%class			:c_class,
								x.[FILIAL]		:c_filial,
								x.[DOCUMENT_DATE]	:c_date_begin,
								x.[DOCUMENT_DATE]	:c_date_close,
								x.[DOCUMENT_USER]	:c_create_user)
						in	[DOCUMENT],
							([DECLARE] all :d) all
					where	d.[OPER] = [TYPE_SALE]([PRODUCT_NAME]= 'DECLARE' and [CODE] = 'OUTPUT') and
							d.[SENDER_REQ].[CLIENTREF] = p_client and
							d%id =x%id and
							(trunc(x.[DOCUMENT_DATE]) = trunc(p_date) or p_date is null)
					union all
					select	x(	x%id			:c_id,
								x%class			:c_class,
								x.[FILIAL]		:c_filial,
								x.[DOCUMENT_DATE]	:c_date_begin,
								x.[DOCUMENT_DATE]	:c_date_close,
								x.[DOCUMENT_USER]	:c_create_user)
						in	[DOCUMENT],
							([DECLARE] all :d) all
					where	d.[OPER] = [TYPE_SALE]([PRODUCT_NAME]= 'DECLARE' and [CODE] = 'INPUT') and
							d.[RECEIVER_REQ].[CLIENTREF] = p_client and
							d%id =x%id and
							(trunc(x.[DOCUMENT_DATE]) <= trunc(p_date) or p_date is null)
							)
			loop
				v_rec_prod_tbl(i).prod_id := x.c_id;
				v_rec_prod_tbl(i).prod_class := x.c_class;
				v_rec_prod_tbl(i).p_filial := x.c_filial;
				v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
				v_rec_prod_tbl(i).p_date_close := x.c_date_close;
				v_rec_prod_tbl(i).p_is_once := true;
				v_rec_prod_tbl(i).create_user := x.c_create_user;
				i := i + 1;
			end loop;*/

			if p_client%class = 'CL_PRIV' then
				v_cl_priv := p_client;
				&debug('MAIN_DOCUM',0)
				for(	select	x(	x%id			:c_id,
									x%class			:c_class,
									x.[FILIAL]		:c_filial,
									x.[DOCUMENT_DATE]	:c_date_begin,
									x.[DOCUMENT_DATE]	:c_date_close,
									x.[DOCUMENT_USER]	:c_create_user)
							in ::[MAIN_DOCUM]
						where -- найдем перевод БОС Клиента.
						--1. В переводе БОС нет ссылки на Клиента, но есть такие же серия/номер, как в истории изменений Клиента
						(
							(	x.[REQ_MAN].[CLIENTREF] is NULL and
								exists (select	v(v)
											in	::[CL_HIST]
										where	replace(upper(v.[VALUE]),' ','') = replace(x.[REQ_MAN].[SERIA],' ','') and
												v.[QUAL]='DOC.SER' and v.[DATE_EDIT]> to_date('01/01/1900','dd/mm/yyyy') and
												v.[CLIENT_REF] = p_client and
												(v.[DATE_EDIT] <= trunc(p_date) or p_date is null) and
												rownum=1) and
								exists (select	v(v)
											in ::[CL_HIST]
										where	upper(v.[VALUE]) = x.[REQ_MAN].[NUMBER] and
												v.[QUAL]='DOC.NUM' and v.[DATE_EDIT]> to_date('01/01/1900','dd/mm/yyyy') and
												v.[CLIENT_REF] = p_client and
												(v.[DATE_EDIT] <= trunc(p_date) or p_date is null) and
												rownum=1)
							)	or
						--2. В переводе БОС нет ссылки на Клиента, но есть такие же паспорт/серия/номер, как у Клиента
						(	x.[REQ_MAN].[CLIENTREF] is NULL and
							x.[REQ_MAN].[PASSPORT] = v_cl_priv.[DOC].[TYPE].[FULL_NAME] and
							replace(x.[REQ_MAN].[SERIA],' ','')= replace(v_cl_priv.[DOC].[SER],' ','') and
							x.[REQ_MAN].[NUMBER] = v_cl_priv.[DOC].[NUM]) or
							--3. Есть прямая ссылка на клиента
							x.[REQ_MAN].[CLIENTREF] = p_client
						)	-- условия на клиента end
						and
							(x.[ACC_DT].[MAIN_V_ID] like '20202%' and x.[ACC_KT].[MAIN_V_ID] like '409%' or
							x.[ACC_DT].[MAIN_V_ID] like '409%' and x.[ACC_KT].[MAIN_V_ID] like '20202%') and
							upper(x%state) = 'PROV' and
							(trunc(x.[DOCUMENT_DATE]) <= trunc(p_date) or p_date is null))
				loop
					v_rec_prod_tbl(i).prod_id := x.c_id;
					v_rec_prod_tbl(i).prod_class := x.c_class;
					v_rec_prod_tbl(i).p_filial := x.c_filial;
					v_rec_prod_tbl(i).p_date_begin := x.c_date_begin;
					v_rec_prod_tbl(i).p_date_close := x.c_date_close;
					v_rec_prod_tbl(i).p_is_once := true;
					v_rec_prod_tbl(i).create_user := x.c_create_user;
					i := i + 1;
				end loop;
			end if;

		end if;

	end if;

	-- отсортируем по дате открытия
	for j in 1..v_rec_prod_tbl.count - 1  loop
		f := 0;
		for i in 1..v_rec_prod_tbl.count - j  loop
			if v_rec_prod_tbl(i).p_date_begin > v_rec_prod_tbl(i+1).p_date_begin then
				tmp_rec.delete;
				tmp_rec(1) := v_rec_prod_tbl(i);
				v_rec_prod_tbl(i) := v_rec_prod_tbl(i+1);
				v_rec_prod_tbl(i+1) := tmp_rec(1);
				f := 1;
			end if;
		end loop;
		if f = 0 then
			exit;
		end if;
	end loop;

	-- определим разрывы клиентности
	for i in 1..v_rec_prod_tbl.count-1 loop
		if i = 1 then
			max_date_split := trunc(nvl(v_rec_prod_tbl(i).p_date_close,sysdate));
		end if;
		if max_date_split < trunc(nvl(v_rec_prod_tbl(i).p_date_close,sysdate)) then
			max_date_split := trunc(nvl(v_rec_prod_tbl(i).p_date_close,sysdate));
		end if;
		if max_date_split < trunc(v_rec_prod_tbl(i+1).p_date_begin) then
			v_rec_prod_tbl(i+1).split := '1';
		end if;
	end loop;

	return v_rec_prod_tbl;

end;

/*
Функция возвращает есть или нет работающие продуктов на дату
*/
public function get_product_on_date_bool(	p_client	ref	[CLIENT],
									/*ссылка на клиента*/
									p_date			[DATE] default sysdate ,
									/*дата на которую запрашиваем, если пустое, то на текущую дату*/
									p_str_product	varchar2(2000) default null)
									/*список классов(глобальных) через запятую. При пустом списке запрашивается по всем продуктам*/
return	boolean is 
begin
  &debug('DEPN',0)
	if instr(p_str_product, 'DEPN') > 0 or p_str_product is null then
		for(select	x(x)
				in	[PRODUCT],
					([DEPN] all :d) all
			 where	d.[CLIENT] = p_client and d%id =x%id and
					(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
					(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
					nvl(x.[COM_STATUS],0) <> v_csp)
		loop
          return true;
		end loop;
	end if;

  &debug('PR_CRED',0)
	if instr(p_str_product, 'PR_CRED') > 0 or p_str_product is null then
		for(select	x(x)
				in	[PRODUCT],
					([PR_CRED] all :d) all
			 where	d.[CLIENT] = p_client and d%id =x%id and
					(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
					(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
					nvl(x.[COM_STATUS],0) <> v_csp)
		loop
          return true;
		end loop;
	end if;	

  &debug('TRUST_FOR_PROD',0)
	if instr(p_str_product, 'TRUST_FOR_PROD') > 0 or p_str_product is null then
		for(select	x(x)
				in	[TRUST_FOR_PROD],
					([PRODUCT] all :p) all
			 where	x.[INI_CLIENT] = p_client and x%state <> 'AN' and
					x.[DEPOSIT] = p%id and
					(x.[DOCUMENT_DATE] <= p_date and
					(least(nvl(x.[END_DATE],p_date),
					nvl(p.[DATE_CLOSE],p_date)) >= p_date) or p_date is null)
			)
		loop
          return true;
		end loop;
	end if;	

  &debug('VZ_CARDS',0)
	if instr(p_str_product, 'VZ_CARDS') > 0 or p_str_product is null then
		for(select	x(x)
				in	[PRODUCT],
					([VZ_CARDS] all :d) all
			 where	d.[CLIENT] = p_client and d%id =x%id and
					(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
					(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
					nvl(x.[COM_STATUS],0) <> v_csp)
		loop
		  return true;
		end loop;
	end if;	
	
  &debug('RKO',0)
	if instr(p_str_product, 'RKO') > 0 or p_str_product is null then
		for(select	x(x)
				in	[PRODUCT],
					([RKO] all :d) all
			 where	d.[CLIENT] = p_client and d%id =x%id and
					(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
					(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
					nvl(x.[COM_STATUS],0) <> v_csp)
		loop
          return true;
		end loop;
	end if;	

  &debug('VEKSEL_GUIDE',0)
	if instr(p_str_product, 'VEKSEL_GUIDE') > 0 or p_str_product is null then
		for(select	x(x)
				in	[VEKSEL_GUIDE] all
			 where	x.[FIRST_TENANT] = p_client and
					(x.[DATE_BEG_RASP] <= p_date and
		            (x.[DATE_END] >= p_date or x.[DATE_END] is null) or p_date is null)) -- узнать когда вексель закончился
		loop
	      return true;
		end loop;
	end if;

  &debug('GUARANTIES',0)
	if instr(p_str_product, 'GUARANTIES') > 0 or p_str_product is null then
		for(select	x(x)
				in	[PRODUCT],
					([GUARANTIES] all :d) all
			 where	d.[PRINCIPAL] = p_client and d%id =x%id and
					(least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
					(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
					nvl(x.[COM_STATUS],0) <> v_csp)
		loop
		  return true;
		end loop;
	end if;
	
  &debug('IND_SAFE_LEASE',0)
	if instr(p_str_product, 'IND_SAFE_LEASE') > 0 or p_str_product is null then
		for(select	x(x)
				in	[PRODUCT],
					([IND_SAFE_LEASE] all :d),
					(::[HOLDER]  all : hld) all
			 where	hld.[CLIENT] = p_client and hld%collection = d.[SAFE_HOLDERS] and d%id =x%id and
					(hld.[DATA_BEG] <= p_date and hld.[DATA_END] >= p_date  and
					least(x.[DATE_BEGIN], nvl(x.[DATE_BEGINING], x.[DATE_BEGIN])) <= p_date and
					(x.[DATE_CLOSE] >= p_date or x.[DATE_CLOSE] is null) or p_date is null) and
					nvl(x.[COM_STATUS],0) <> v_csp)
		loop
		  return true;
		end loop;
	end if;

  return false;
end;

-- Функция возвращает филиал первого найденого работающего продукта на дату
public function get_filial_product_on_date(p_client ref [CLIENT], /*ссылка на клиента*/
