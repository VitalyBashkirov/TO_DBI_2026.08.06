-- ============================================================================
-- Правило 34: v50.PROC.CHARSET.п.3.16 - Использование [RUNTIME].[CHARSET] для кодировок
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Использование [RUNTIME].[CHARSET] для кодировок
--   Подробное описание: Для работы с кодировками использовать ::[RUNTIME].[CHARSET]. Запрещены функции NLS_INITCAP, NLS_LOWER, NLS_UPPER.
--   Пример кода для корректировки: nls_upper(name)
--   Пример исправленного кода: upper(name)
--   Теги: charset, encoding
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Для работы с кодировками использовать ::[RUNTIME].[CHARSET]. Запрещены функции NLS_INITCAP, NLS_LOWER, NLS_UPPER, NCHR, ASCIISTR, COMPOSE, DECOMPOSE, DUMP, UNISTR, LENGTHC, LENGTH2, LENGTH4, SUBSTRC, SUBSTR2, SUBSTR4.
--   plplus_materials_note: В PostgreSQL нет NLS_* функций.
--   search_prompt: Найти запрещённые NLS_* функции и функции работы с кодировками.
--   regex_patterns.for_search: \b(NLS_INITCAP|NLS_LOWER|NLS_UPPER|NCHR|ASCIISTR|COMPOSE|DECOMPOSE|DUMP|UNISTR|LENGTHC|LENGTH2|LENGTH4|SUBSTRC|SUBSTR2|SUBSTR4)\s*\(
--   code_example_bad: nls_upper(name)
--   fix_instruction: Заменить NLS_* функции на стандартные (upper/lower). Для конвертации кодировок использовать ::[RUNTIME].[CHARSET].convert.
--   fix_prompt: Замени NLS_* функции на стандартные.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.CHARSET.п.3.16'.
--   priority: high
--   category: PROC
--   subcategory: PROC.CHARSET
--   source_files: v50.docx
--   source_sections: п.3.16
-- ============================================================================
PROCEDURE v50_PROC_CHARSET_p_3_16 IS
	v_name VARCHAR2(100);
	v_upper_name VARCHAR2(100);
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		v_upper_name := nls_upper(v_name);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		v_upper_name := upper(v_name);
	-- end pl/sql
END;

-- ============================================================================
