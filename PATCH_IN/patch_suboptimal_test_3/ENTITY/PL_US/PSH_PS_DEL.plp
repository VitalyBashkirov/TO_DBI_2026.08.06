class PL_US;

@import_plsql(true)
@name('[ПСБ] Удалить признак счета')
@tag('COPIED')
batch method PSH_PS_DEL is
PSH_PS_DEL (
	@name('Признак счета') P_PS in [PS$]
) is

execute is
	v_ps	ref [PS];
	idx		integer;
begin
	idx := this.first;
	while idx is not null
	loop
		for v_ps in this(idx).[B_PS]
		where v_ps = P_PS
		loop
			v_ps.[DELETE#AUTO];
			exit;
		end loop;

		idx := this.next(idx);
	end loop;
end;
end;
end;
