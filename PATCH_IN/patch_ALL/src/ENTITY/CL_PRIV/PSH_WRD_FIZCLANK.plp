				elsif COALESCE(client_corp.[INN], client_priv.[INN]) is not null then
					P_DATA := COALESCE(client_corp.[INN], client_priv.[INN])||' / '||P_DATA;
				end if;	
		 		
		 		P_DATA := nvl(trim(P_DATA), 'НЕТ');
		 		
