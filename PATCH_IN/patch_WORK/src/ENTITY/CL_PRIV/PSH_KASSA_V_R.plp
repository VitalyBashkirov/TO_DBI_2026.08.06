		&debug('V_EXCHG_POINT='||V_EXCHG_POINT.[NUM_PK]||' V_TYPE_CODE='||V_TYPE_CODE||' P_PAY_DOC_TYPE='||P_PAY_DOC_TYPE.[CODE]||' P_DATE='||to_char(P_DATE,fmt)||' v_back_rate='||v_back_rate,dp)
		
		&srv.GET_DUMB_RATES(V_EXCHG_POINT, V_TYPE_CODE, P_IN_CURR, P_OUT_CURR, P_PAY_DOC_TYPE, P_IN_AM, P_OUT_AM, P_DATE, V_DUMB_RATE, V_DUMB_CB_RATE, v_back_rate);
		V_DUMB_CB_RATE := &srv.Get_CB_RATE_for_321P(V_TYPE_CODE, P_IN_CURR, P_OUT_CURR, P_DATE, v_back_rate);
	end if;

	
