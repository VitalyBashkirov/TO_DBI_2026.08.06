class END_OD_OPERATION;

@name('[ПСБ] ЗОД дергаем настройки по коду (INS_DAYS. в 7:00, доступ в пятницу )')
@tag('COPIED')
static method PSH_NAST_EDIT_G5 is
dp number:=null;	--управление debug_pipe
PSH_NAST_EDIT_G5 (
	@name('Код настройки')  P_KODE      in [STRING_30] default null,
	@name('Значение')       P_ZNACH     in [STRING_30] default null,
	@name('Без исключений') P_ALL_ZNACH in [BOOLEAN]   default null
) is

validate is
begin
  if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
  	P_KODE:='INS_DAYS';
  	P_ZNACH:=3;
  	P_ALL_ZNACH:=false;
  end if;
end;

execute is
/*********************************************************************
Назначение: Изменяет значение настройки INS_DAYS за исключением определённых юзеров

kurganov, последнее изменение 26 Май 2015 г.
*********************************************************************/
nastroyka ref [FP_TUNE];
--i number:=0;
code_len const pls_integer := ::[FP_TUNE].[VARS].code_len; /*длина поля для хранения значения критерия поиска*/
P_user ref [USER];
tune_canons	string(2000);

delta number; --Башкиров В.Г. 28.04.2025
str_tune_INS_DAYS_LONG string (2000);
tmp_sysdate [DATE]:=sysdate;
n number;
system_od [DATE]:=[SYSTEM].[OP_DATE];
begin
	--Башкиров В.Г. 29.04.2025
	--INS_DAYS_LONG-[ПСБ] Глубина выдаваемых пользователям закрытых опердней, с учетом длинных выходных и праздничных
	--30/04/2025(4);07/05/2025(4);11/06/2025(4)
	debug_pipe('(1)P_ZNACH='||P_ZNACH,dp);
	
	str_tune_INS_DAYS_LONG:=::[FP_TUNE].[LIB].get_str_value('INS_DAYS_LONG',null, 0);
	debug_pipe('INS_DAYS_LONG='||str_tune_INS_DAYS_LONG,dp);
	n:=instr(str_tune_INS_DAYS_LONG,to_char(system_od,'dd/mm/yyyy'));
	if nvl(n,0)=0 then
		n:=instr(str_tune_INS_DAYS_LONG,to_char(system_od,'dd.mm.yyyy'));
	end if;
	if n>0 then
		str_tune_INS_DAYS_LONG:=trim(trim(substr(str_tune_INS_DAYS_LONG,n+10),';'));
		--( 4);...
		--1234
		debug_pipe('(1)str_tune_INS_DAYS_LONG='||str_tune_INS_DAYS_LONG,dp);
		begin
			str_tune_INS_DAYS_LONG:=trim(substr(str_tune_INS_DAYS_LONG,2,instr(str_tune_INS_DAYS_LONG,')')-2));
			debug_pipe('(2)str_tune_INS_DAYS_LONG='||str_tune_INS_DAYS_LONG,dp);
			
			delta:=str_tune_INS_DAYS_LONG;
			debug_pipe('(3)delta='||delta,dp);
		exception when others then
			pragma error('Ош. вычисление дельты в INS_DAYS_LONG-[ПСБ] Глубина выдаваемых пользователям закрытых опердней, с учетом длинных выходных и праздничных');
		end;
	end if;
	
	P_KODE:=nvl(P_KODE,'INS_DAYS');
	if nvl(delta,0)<>0 then
		P_ZNACH:=delta;
	else
		P_ZNACH:=nvl(P_ZNACH,3);
	end if;
	debug_pipe('(2)P_ZNACH='||P_ZNACH,dp);
	
	begin
	select x(x) in ::[FP_TUNE] where x.[CODE]=P_kode into nastroyka;
	exception when others then nastroyka:=null;
	end;
	
if nastroyka is not null then
/*	for edit in ::[FP_TUNE_VAL]all where edit%collection=nastroyka.[VALUES] loop
		if P_all_znach then edit.[EDIT#AUTO](
											P_znach
											,edit.[CANON_VALS]
											);
							i:=i+1;					
		else 	if to_number(substr(edit.[CANON_VALS],code_len*1+1,code_len)) not in (32303141,32303187,8935328,8935362,32303095) --Пользователи критерий 2
					and nastroyka.[CODE]='INS_DAYS'  --Код настройки
				then 	edit.[EDIT#AUTO](
										P_znach
										,edit.[CANON_VALS]
										);
						i:=i+1;		
				end if;													
		end if;
	end loop;*/
	
	for edit in ::[FP_TUNE_VAL]all where edit%collection=nastroyka.[VALUES] and edit.[VALUE]!=P_ZNACH loop
		P_user:= to_number(substr(edit.[CANON_VALS],code_len*1+1,code_len));
		--if nvl(P_user%id,0) not in (0,32303141,32303187,8935328,8935362,32303095,3959606065) 
		--and nastroyka.[CODE]='INS_DAYS' and P_user.[OTVET]='777' then
		if nvl(P_user%id,0) not in (0
					,32303141	--Администратор 001 
					,8935362	--Банковский Расчетный Центр
					,8935328	--Администратор Банковской Модели
					,22647190	--Агальцова Наталия Юрьевна
					,3959606065
					--,32303187	--Администратор 101 
					--,32303095	--Банковский Расчетный Центр Филиала 101
					,5089144666 --Шлюз Это Платежи
					,5582023283 --user ETO_GATE
					) and nastroyka.[CODE]='INS_DAYS' then
	     	if to_number(substr(edit.[CANON_VALS],1,code_len))!=0 then tune_canons := ::[FP_TUNE].[LIB].set_canons('BRANCH', P_user.[FILIAL]%id,'DEPART', P_user.[DEPART]%id, 'USER', P_user%id);
	     	else tune_canons := ::[FP_TUNE].[LIB].set_canons('BRANCH', substr(edit.[CANON_VALS],1,code_len),'DEPART', substr(edit.[CANON_VALS],1,code_len), 'USER', P_user%id);
	     	end if;
	     	edit.[VALUE_HISTORY].[NEW#AUTO](
											sysdate/*P_VALDATE*/		--Дата, ранее которой действовало значение
											,edit.[VALUE]/*P_VALUE*/		--Значение настройки
											,null);
	     	--::[FP_TUNE].[LIB].get_value('INS_DAYS', P_ZNACH, tune_canons);
	       	::[FP_TUNE].[LIB].set_value('INS_DAYS', P_ZNACH, tune_canons);	
	       	P_user:=null;
		end if;
	end loop;	
	
end if;
end;
end;
end;
