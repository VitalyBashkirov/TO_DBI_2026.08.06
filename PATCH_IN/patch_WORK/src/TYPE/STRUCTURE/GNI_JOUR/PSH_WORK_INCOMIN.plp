class GNI_JOUR;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Обработать файлы уполномоченных органов')
@tag('COPIED')
static method PSH_WORK_INCOMIN is

@name('Путь на локальном диске') public P_PATH                    [STRING];
@name('Имя файла')               public V_FILENAME                [STRING_32000];
@name('Путь')                    public P_PATH_SERV               [STRING];
@name('Путь для архива')         public P_PATH_ARC                [STRING];
@name('Таблица имен файлов')     public V_LIST_FILES     table of [STRING_48];
@name('Место хранения файлов')   public V_GNI_FILE_PLACE          [INTEGER];
pragma include(::[RUNTIME].[MACRO_LIB]);
pragma include(::[RUNTIME].[DEBUG_MACRO]);
pragma include(::[GNI_JOUR].[PSH_LIB_TC]); -- updated CHANGE_SHORT_NAME PSB_LIB_TC->PSH_LIB_TC 14/10/25

-- Башкиров В.Г. 19.11.2025 из ::[GNI_JOUR].[LIB_FUN] патч 25.4.05
public pfr_confirm	const varchar(1)	:= 'P'; -- Принятие ПФР
public pfr_error	const varchar(1)	:= 'N'; -- Ошибки ПФР
public fss_confirm	const varchar(1)	:= 'R'; -- Принятие ФСС
-- Башкиров В.Г. 19.11.2025 из ::[GNI_JOUR].[PSH_LIB_TC] патч 25.4.05
public FOND_FSS const ref [FOND_TYPE] := ::[FOND_TYPE]([CODE] = 'ФСС'); -- Социальные фонды
public FOND_PFR const ref [FOND_TYPE] := ::[FOND_TYPE]([CODE] = 'ПФР');
-- Башкиров В.Г. 28.11.2025 из ::[FIN_ACCOUNT_INT].[PRX_ESI] патч 25.4.05
public type TFilesTable is table of blob;

bManual boolean;
ourBranch ref [BRANCH];

procedure parseAnswer
(
	  xml_data 		CLOB
	, p_jour	ref [GNI_JOUR]
	, p_stage		integer
	, p_history	ref [GNI_JOUR_HISTORY]
	, p_pref_file	varchar2(3)
)
is
d 			&xml.DOMDocument;
de 			&xml.DOMElement;
nl 			&xml.DOMNodeList;
e 			&xml.DOMElement;
n 			&xml.DOMNode;
v_DNM 		&xml.DOMNamedNodeMap;
code_err	varchar2(3);
dDateForm	date;
name		varchar2(1000);
val 		varchar2(1000);
detail		varchar2(4000);
bCritical	boolean := false;
ind			integer;
begin
	d 	:= &xml.newDOMDocument(xml_data);
	de 	:= &xml.getDocumentElement(d);
	
	nl 	:= &xml.getChildrenByTagName(de, 'Документ');	--контейнер Документ
	n 	:= &xml.item(nl, 0);
	
	dDateForm := to_date(&lx.get_attr(n, 'ДатаОбр'), 'dd.mm.yyyy');
	
	-- инициализация для сохранения ошибок
	&lr.init_error(p_jour, dDateForm, p_stage);
	
	e := &xml.makeElement(n);
	
	-- Обработка ошибок
	nl 	:= &xml.getChildrenByTagName(e, 'Ошибки');	--контейнер Ошибки
	ind := &xml.getLength(nl);
	
	&debug('ind='||ind,0)
	
	if ind > 0 then
		for i in 0..ind - 1 loop
			val = name = detail = code_err := null;
			bCritical := false;
			
			n := &xml.item(nl, i);					
			v_DNM :=&xml.GetAttributes(n);
			
			for j in 0..&xml.GetLength(v_DNM)-1 loop
			   	name := &xml.getNodeName(&xml.Item(v_DNM, j));
			   	val := &xml.getNodeValue(&xml.Item(v_DNM, j));
			   	detail := detail || name||'="'||val||'" ';
			end loop;
				
			code_err := &lx.get_attr(n,'КодОшибки');
			
			&debug('i='||i,0)
			&debug('code_err='||code_err,0)
			&debug('p_pref_file='||p_pref_file,0)
			&debug('detail='||detail,0)
			&debug('p_pref_file='||p_pref_file,0)
			
			if p_pref_file in ('SBE','SFE') then
				bCritical := true;
			end if;
			
			-- добавим ошибки в структуру
			&lr.add_error(code_err, detail, bCritical, p_history);
		end loop;	
	end if;	
		
	-- Сохраним ошибки
	&lr.save_error(p_jour);
	
	&xml.freeDocument(d);
end;

procedure add_history
(	
	  p_history		[GNI_JR_HIST_ARR]							-- История сообщений из НО/соц.фондов
	, p_text		::[GNI_JOUR_HISTORY].[IN_FILE_TEXT]%type	-- Текст файла из НО/соц. фонда
	, p_name		::[GNI_JOUR_HISTORY].[TO_FILENAME]%type		-- Имя файл из НО/соц. фонда
	, p_fund		ref [FOND_TYPE]								-- Соц. фонд
	, p_jr_hist	out ref [GNI_JOUR_HISTORY]						-- Ссылка на экземпляр в истории сообщений из НО
)
is
gni_history	[GNI_JOUR_HISTORY];
begin
	gni_history%init;
	gni_history.[IN_FILE_DATETIME]	:= sysdate;
	gni_history.[IN_FILE_TEXT]		:= p_text;
	gni_history.[TO_FILENAME]		:= p_name;
	gni_history.[SOC_FUND]			:= p_fund;
	
	p_jr_hist := p_history%insert(gni_history);	-- получим экземпляр истории для хранения в структуре ошибок.
end;					

procedure SetCloseStatus
(	
	  p_jour		ref [GNI_JOUR]
	, p_num			::[GNI_OPCLOS_ACFIN].[NUM]%type
	, p_sec			::[GNI_OPCLOS_ACFIN].[SEC]%type
	, p_soc_fund	ref [FOND_TYPE]
	, p_status		ref [COM_STATUS_PRD]
	, p_description ::[GNI_JOUR].[DESCRIPTION]%type
	, p_filetype	integer
)
is
v_cnt		pls_integer;
v_skip_pfr	boolean;
v_patt_str	varchar2(128);
begin
	&debug('Установка статуса для сообщения № '||p_num||'/'||p_sec, 0)
	&debug('Текущий статус сообщения: '||p_status.[NAME], 0)
	&debug('Соц. фонд: '||p_soc_fund.[CODE], 0)	
	
	if  p_filetype != 1 or p_soc_fund is not null then
		/*	Сообщения такого вида не отправляются в соц. фонды, или сообщение было отправлено в конкретный фонд =>
			мог прийти только ответ или из НО, или одного фонда - сразу переводим в IMNS_CLOSE
		*/
		if p_status = &tc.stSend then -- Изменяем статус только по тем сообщениям, по которым еще не было ответов
			p_jour.[COM_STATUS]	:= &tc.stClose;
			p_jour.[DESCRIPTION]:= substr(&date2str(sysdate) || ' Обработка завершена ' || stdlib.FIO(stdlib.userid.[NAME], 'Ф И.О.') || chr(10) || p_description, 1, p_jour.[DESCRIPTION]%size);
		end if;	
		
		&debug('Сообщению '||p_num||'/'||p_sec||' установлен статус IMNS_CLOSE', 0)
	else -- По сообщению должно быть получено три подтверждения из НО и из фондов соц. страхования
		if p_status = &tc.stSend then -- Получен первый ответ
			p_jour.[COM_STATUS] := &tc.stWait;
			&debug('Сообщению '||p_num||'/'||p_jour.[GNI_BLANK].[SEC]||' установлен статус IMNS_WAIT_REPLAY', 0)
		
		elsif p_status = &tc.stWait then -- Проверим, может быть пришли все три ответа
			v_skip_pfr := nvl(&ft.get_bool_value('GNI_SKIP_PFR', null, '0'), false);
			&debug('Не ждать ПФР: '||v_skip_pfr, 0)
			if v_skip_pfr then
				v_patt_str := ::[GNI_JOUR].[LIB_FUN].no_confirm||';'||::[GNI_JOUR].[LIB_FUN].fss_confirm;
			else
				v_patt_str := ::[GNI_JOUR].[LIB_FUN].no_confirm||';'||::[GNI_JOUR].[LIB_FUN].fss_confirm||';'||pfr_confirm; 
			end if;

			select	h(count(distinct decode(h.[SOC_FUND], null, 'НО', h.[SOC_FUND]%id)))	
			in		p_jour.[IN_FILE_HISTORY]
			where	instr(v_patt_str, substr(h.[TO_FILENAME], 3, 1)) > 0
			into	v_cnt;
			
			&debug('Получено ответов: '||v_cnt, 0)
			if v_cnt = 3 or v_cnt = 2 and v_skip_pfr then
				p_jour.[COM_STATUS] := &tc.stClose;
				p_jour.[DESCRIPTION] := substr(&date2str(sysdate) || ' Обработка завершена ' || stdlib.FIO(stdlib.userid.[NAME], 'Ф И.О.') || chr(10) || p_description, 1, p_jour.[DESCRIPTION]%size);
				&debug('Сообщению '||p_num||'/'||p_jour.[GNI_BLANK].[SEC]||' установлен статус IMNS_CLOSE', 0)
			end if;		
		end if;
	end if;	

end;

-- Получение уникального имени файла
-- (выяснилось, что может приходить несколько файлов с одинаковыми именами
-- сохраняем такие файлы в архиве с добавлением к имени постфикса)
function GetDstFileName
(	
	  p_history		[GNI_JR_HIST_ARR] -- История сообщений из НО/соц.фондов
	, p_src_name	[FILE$PATH]
)
return [FILE$PATH]
is
cnt integer;
dst_name [FILE$PATH];
begin
	&debug('Определение имени файла в архиве, имя файла: '||p_src_name, 0)
	
	select	h(count(h))
	in		p_history
	where	upper(h.[TO_FILENAME]) = upper(p_src_name)
	into	cnt;
	
	&debug('	Количество файлов с совпадающим именем: '||to_char(cnt), 0)
	
	if cnt > 0 then -- Уже есть записи о получении файла с именем fname
		if substr(p_src_name, - 4, 1) = '.' then
			dst_name := substr(p_src_name, 1, length(p_src_name) - 4) || '_' || to_char(cnt) || substr(p_src_name, -4);
		else
			dst_name := p_src_name || '_' || to_char(cnt);
		end if;	
		&debug('Изменено имя файла на '||dst_name, 0)
	else
		dst_name := p_src_name;
		&debug('Имя файла не изменено', 0)
	end if;	
	
	return dst_name;
end;						

function is_valid_name(p_filename string)
return boolean
is
ret			boolean := false;
ras			string;
v_point_pos	integer;
v_filename	string(2000);
begin
	v_filename := upper(p_filename);
	
	v_point_pos := instr(v_filename,'.');
	if v_point_pos = 0 then
		return false;
	end if;	
	
	--расширение файла
	ras := substr(v_filename, v_point_pos + 1);
	
	if		ras = 'TXT' and instr(v_filename, 'SB') > 0
		or	ras = 'XML' and substr(v_filename, 1, 2) in ('SB', 'SF')
	then
		if substr(v_filename, 3, 1) in ('E', 'K', 'F', 'P', 'R', 'N', 'T') then
			ret := true;
		end if;
	end if;
	
	return ret;
end;

function processFile
(
	p_fileName varchar2
	, p_fileContent in out nocopy CLOB
	, p_useAudit boolean
	, p_fileFormat integer default 3
	, p_fileHistoryArr out [GNI_JR_HIST_ARR]
)
return varchar2(32000)
is
x				XMLType;
fileText		[MEMO];
file3Letter		varchar2(1);
filePrefix		varchar2(3);
fileType		integer;
foundInJour		boolean;
socFund		ref [FOND_TYPE];
histJour	ref [GNI_JOUR_HISTORY];

msg string(2000);

psb_msg string(2000);
tmpFileName varchar2;
begin
	if p_fileFormat = 3 then
		x := XMLType(p_fileContent);
		fileText := substr(x.extract('//Файл').getstringval(), 1, 2000);
	end if;	
	
	file3Letter	:= upper(substr(p_fileName, 3, 1));
	filePrefix	:= upper(substr(p_fileName, 1, 3));
	
	&debug('.processFile -- file3Letter='||file3Letter||' filePrefix='||filePrefix, 0)
	
	foundInJour := false;	
	if file3Letter in (::[GNI_JOUR].[LIB_FUN].no_reject, ::[GNI_JOUR].[LIB_FUN].no_error, ::[GNI_JOUR].[LIB_FUN].fss_error, pfr_error) then
		&debug('.processFile -- Обработка файлов с ошибками', 0)
		msg:=SubStr(msg||'Обработка файлов с ошибками ',1,350);
		for (	
				select	j(
							  j						: jour
							, j.[IN_FILE_HISTORY]	: history
							, j.[DESCRIPTION]		: description
							, j.[COM_STATUS] 		: status
							
							, b						: blank
							, b.[SOC_FUND_TYPE]		: socFund
							, b.[DATE_REJECT]		: dateReject
							, b.[FORMAT_TYPE].[0] 	: format
						)
				in		::[GNI_JOUR], (::[GNI_OPCLOS_ACFIN] all : b)
				where	upper(substr(j.[FILENAME], 4)) = upper(substr(p_fileName, 4)) -- тут функциональный индекс, в идеале возвращается 1 запись только по этому условию, все остальные условия под циклом
					and b = j.[GNI_BLANK]
				order by j desc	
		) loop
			if		(j.status in (&tc.stSend, &tc.stClose, &tc.stWait)
						or
					j.status = &tc.stError and j.dateReject is null)
				and j.format = p_fileFormat
					-- поиск сообщения, отправленного в НИ, ПФР, ФСС
				and
					(
						j.socFund is null -- нет проверки на то, откуда получен файл, т.к. на сообщение, отправленное в НО может прийти ответ и из любого фонда (но только для файлов первого типа, проверка ниже)
							or
						j.socFund = case file3Letter when pfr_error then FOND_PFR when ::[GNI_JOUR].[LIB_FUN].fss_error then &tc.FOND_FSS else null end
					)
			then
				fileType := coalesce(::[GNI_JOUR].[LIB_FUN].GetFileType(j.blank), 0);
				&debug('.processFile -- Тип файла ' || fileType||' j.socFund='||j.socFund||' file3Letter='||file3Letter, 0)
				msg:=SubStr(msg||'Тип файла '||fileType||' ',1,350);
				if		j.socFund is null								-- если файл отправлялся в НО,
					and file3Letter in (pfr_error, ::[GNI_JOUR].[LIB_FUN].fss_error)	-- а грузим файл, полученный из фондов
					and fileType != 1 									-- и файл не первого типа
				then
					&debug('.processFile -- Пропустим обработку такого файла', 0)
-----------------------------
					-- нужно пропустить обработку такого файла (т.к. в фонды отправляются только файлы первого типа)
					-- Для 2446-У - 4 типа файла
					-- 1: Сообщения об открытии/закрытии/изменении счёта организации или ИП, и для сообщений ЕДИНСООБЩ
					-- 2: Сообщения об открытии/закрытии/изменении счёта адвоката или нотариуса
					-- 3: Сообщение в ПФР
					-- 4: Сообщение в ФСС
					-- Для 134-ФЗ
					-- 1: Сообщения об открытии/закрытии/изменении счёта организации или ИП и для сообщений ЕДИНСООБЩ
					-- 2: Сообщения об открытии/закрытии/изменении депозита организации или ИП и для сообщений об открытии/закрытии/изменении счёта адвоката или нотариуса
					-- 3: Сообщение в ПФР
					-- 4: Сообщение в ФСС
					psb_msg:='Сообщение отправлялось в НО а получен файл из фондов и файл типа "'||fileType||'" не первого типа (Сообщения об открытии/закрытии/изменении 1-счета; 2-депозита; 3-в ПФР; 4-в ФСС)';
					psb_msg:=psb_msg||' пропускаем обработку (т.к. в фонды отправляются только файлы первого типа) ';
					&debug('.processFile -- (1) '||psb_msg, 0)
-----------------------------
					continue;  -- пропустим обработку такого файла
				end if;
				
				foundInJour := true;
				socFund := null;
								
				case file3Letter of
					: ::[GNI_JOUR].[LIB_FUN].no_error : -- в файле обнаружены ошибки
						&debug('.processFile --  в файле обнаружены ошибки', 0)
						msg:=SubStr(msg||'В файле обнаружены ошибки ',1,350);
						j.jour.[COM_STATUS] := &tc.stError;
					
					: ::[GNI_JOUR].[LIB_FUN].no_reject : 	-- файл не принят
						&debug('.processFile --  файл не принят', 0)
						msg:=SubStr(msg||'Файл не принят ',1,350);
						j.jour.[COM_STATUS] := &tc.stReject;
					
					: pfr_error : -- требуется корректировка в ПФР
						&debug('.processFile --  требуется корректировка в ПФР', 0)
						msg:=SubStr(msg||'Требуется корректировка в ПФР ',1,350);
						socFund := FOND_PFR;
						j.jour.[COM_STATUS] := &tc.stError;
				
					: ::[GNI_JOUR].[LIB_FUN].fss_error : -- требуется корректировка в ФСС	
						&debug('.processFile --  требуется корректировка в ФСС', 0)
						msg:=SubStr(msg||'Требуется корректировка в ФСС ',1,350);
						socFund := &tc.FOND_FSS;
						j.jour.[COM_STATUS] := &tc.stError;
				end;
				
				add_history(j.history, fileText, p_fileName, socFund, histJour);
				if p_useAudit then
					ParseAnswer(p_fileContent, j.jour, 2, histJour, filePrefix);
				end if;	
			
				j.jour.[DESCRIPTION] := substr(&date2str(sysdate) || ' Обнаружены ошибки ' || stdlib.FIO(stdlib.userid.[NAME], 'Ф И.О.') || chr(10) || j.description, 1, j.description%size);
				msg:=SubStr(msg||j.jour.[DESCRIPTION]||' ',1,350);
				j.jour.[IN_FLAG] := true;
				
				p_fileHistoryArr := j.history;

				exit;
			end if;
		end loop;
	
	elsif file3Letter in (::[GNI_JOUR].[LIB_FUN].no_confirm, ::[GNI_JOUR].[LIB_FUN].fss_confirm, pfr_confirm) then -- подтверждения
		&debug('.processFile -- Подтверждение ' || case file3Letter when ::[GNI_JOUR].[LIB_FUN].no_confirm then 'НО' when ::[GNI_JOUR].[LIB_FUN].fss_confirm then 'ФСС' when pfr_confirm then 'ПФР' else 'Неизвестно' end, 0)
		msg:=SubStr(msg||'Подтверждение ' || case file3Letter when ::[GNI_JOUR].[LIB_FUN].no_confirm then 'НО' when ::[GNI_JOUR].[LIB_FUN].fss_confirm then 'ФСС' when pfr_confirm then 'ПФР' else 'Неизвестно' end||' ',1,350);
		tmpFileName :=upper(substr(p_fileName, 4));

		&debug('.processFile -- (0) tmpFileName='||tmpFileName, 0)
	
		if                 InStr(tmpFileName,'_1.XML')>0 then
			tmpFileName:=Replace(tmpFileName,'_1.XML','.XML'); 
			          &debug('.processFile -- (1) tmpFileName='||tmpFileName, 0)
		end if;
		if                 InStr(tmpFileName,'_2.XML')>0 then
			tmpFileName:=Replace(tmpFileName,'_2.XML','.XML'); 
			          &debug('.processFile -- (1) tmpFileName='||tmpFileName, 0)
		end if;
		if                 InStr(tmpFileName,'_3.XML')>0 then
			tmpFileName:=Replace(tmpFileName,'_3.XML','.XML'); 
			          &debug('.processFile -- (3) tmpFileName='||tmpFileName, 0)
		end if;
		if                 InStr(tmpFileName,'_4.XML')>0 then
			tmpFileName:=Replace(tmpFileName,'_4.XML','.XML'); 
			          &debug('.processFile -- (4) tmpFileName='||tmpFileName, 0)
		end if;
		if                 InStr(tmpFileName,'_5.XML')>0 then
			tmpFileName:=Replace(tmpFileName,'_5.XML','.XML'); 
			          &debug('.processFile -- (5) tmpFileName='||tmpFileName, 0)
		end if;
		for	(
				select	j(
							  j						: jour
							, j%id					: jour_id
							, j.[IN_FILE_HISTORY]	: history
							, j.[DESCRIPTION] 		: description
							, j.[COM_STATUS]		: status
							
							, b						: blank
							, b.[NUM]				: num
							, b.[SEC]				: sec
							, b.[SOC_FUND_TYPE]		: socFund
							, b.[DATE_REJECT]		: dateReject
							, b.[FORMAT_TYPE].[0]	: format
						)
				in		::[GNI_JOUR], (::[GNI_OPCLOS_ACFIN] all : b)
				where	upper(substr(j.[FILENAME], 4)) = tmpFileName --upper(substr(p_fileName, 4)) -- тут функциональный индекс, в идеале возвращается 1 запись только по этому условию, все остальные условия под циклом
					and b = j.[GNI_BLANK]
				order by j desc
		) loop
			&debug('.processFile -- j.jour_id='||j.jour_id||' j.status='||j.status||' j.format='||j.format||' p_fileFormat='||p_fileFormat||' j.socFund='||j.socFund, 0)
			if		j.status in (
									  &tc.stSend
									, &tc.stLetter
									, &tc.stWait
									, &tc.stError
									, &tc.stClose	-- загружаем подтверждения даже, если статус "Обработка завершена", т.к. некоторые фонды шлют несколько подтверждений
									, &tc.stReject	-- загружаем подтверждения даже, если статус "Забракован", т.к. выяснилось, что фонды могут присылать подтверждения по сообщениям, забракованными НО
								)
				and j.format = p_fileFormat
				and	
					(	
						j.socFund is null  -- на сообщение, отправленное в НО, могут приходить подтверждения и из фондов
							or
						j.socFund = case file3Letter when pfr_confirm then FOND_PFR when ::[GNI_JOUR].[LIB_FUN].fss_confirm then &tc.FOND_FSS else null end
					)
			then
				fileType := coalesce(::[GNI_JOUR].[LIB_FUN].GetFileType(j.blank), 0);
				&debug('.processFile --  ТИП файла ' || fileType||' j.socFund='||j.socFund||' file3Letter='||file3Letter, 0)
				msg:=SubStr(msg||'Тип файла ' || fileType||' ',1,350);
				if		-- если это не так (сообщение не первого типа), перейдём к следующей найденной записи
						j.socFund is null 									-- Если сообщение отправлялось в НО
					and file3Letter in (pfr_confirm, ::[GNI_JOUR].[LIB_FUN].fss_confirm) 	-- а получен файл из фондов
					and fileType != 1 										-- и файл не первого типа
				then -- нужно пропустить обработку такого файла (т.к. в фонды отправляются только файлы первого типа)
					-- Для 2446-У - 4 типа файла
					-- 1: Сообщения об открытии/закрытии/изменении счёта организации или ИП, и для сообщений ЕДИНСООБЩ
					-- 2: Сообщения об открытии/закрытии/изменении счёта адвоката или нотариуса
					-- 3: Сообщение в ПФР
					-- 4: Сообщение в ФСС
					-- Для 134-ФЗ
					-- 1: Сообщения об открытии/закрытии/изменении счёта организации или ИП и для сообщений ЕДИНСООБЩ
					-- 2: Сообщения об открытии/закрытии/изменении депозита организации или ИП и для сообщений об открытии/закрытии/изменении счёта адвоката или нотариуса
					-- 3: Сообщение в ПФР
					-- 4: Сообщение в ФСС
					psb_msg:='Сообщение отправлялось в НО а получен файл из фондов и файл типа "'||fileType||'" не первого типа (Сообщения об открытии/закрытии/изменении 1-счета; 2-депозита; 3-в ПФР; 4-в ФСС)';
					psb_msg:=psb_msg||' пропускаем обработку (т.к. в фонды отправляются только файлы первого типа) ';
					&debug('.processFile -- (2) '||psb_msg, 0)
					continue;
				end if;
				
				foundInJour := true;
				j.jour.[IN_FLAG] := true;
				socFund := null;
				&debug('.processFile -- file3Letter='||file3Letter, 0)
				
				case file3Letter of
					: pfr_confirm :	
						socFund := FOND_PFR;
					
					: ::[GNI_JOUR].[LIB_FUN].fss_confirm :
						socFund := &tc.FOND_FSS;
				
				end;	
				
				if tmpFileName=upper(substr(p_fileName, 4)) then
						&debug('.processFile -- Не дубль. Сохраним в {истории сообщений}', 0)
						add_history(j.history, fileText, p_fileName, socFund, histJour); -- в историю передаем соц. фонд, из которого пришло сообщение
						SetCloseStatus(j.jour, j.num, j.sec, j.socFund, j.status, j.description, fileType); -- для установки статуса нужен соц. фонд, в который было сформировано сообщение
		
						p_fileHistoryArr := j.history;
				else
					if psb_msg is null then
						&debug('.processFile -- Дубль. Не обрабатываем psb_msg='||psb_msg, 0)
						foundInJour:=false;
						psb_msg:=' Дубль. Не обрабатываем';
					end if;
				end if;
				
				exit;
			end if;
		end loop;
	end if;
	
	if not foundInJour then
	  --msg:=SubStr(msg||'Файл '||upper(substr(p_fileName, 4))||' не обработан. Не найдена запись для исходного файла ',1,350);
		msg:=SubStr(msg||'Файл '||p_fileName||' не обработан. '||nvl(psb_msg,'Не найдена запись для исходного файла '),1,350);

	  --return 'Файл '||upper(substr(p_fileName, 4))||' не обработан. Не найдена запись для исходного файла.';
		if psb_msg is null then
			msg:=trim(msg);
			debug_pipe(msg, 0);
			::[CL_PRIV].[PSH_DATE_DEATH].UniLog(
				Substr(msg,1,350),
				Rpad('WORK_INC',10),			--тема
				'_'||&METHOD$SNAME||'.log');	--log
			return msg;
		end if;
	end if;

	msg:=trim(msg);
	if msg is not null then
		debug_pipe(msg, 0);
		::[CL_PRIV].[PSH_DATE_DEATH].UniLog(
			Substr(msg,1,350),
			Rpad('WORK_INC',10),			--тема
			'_'||&METHOD$SNAME||'.log');	--log
	end if;
	return null;
end;
PSH_WORK_INCOMIN (
	@name('Филиал')    P_FILIAL    in [BRANCH_REF] default null,
	@name('Имя файла') P_FILE_NAME in [STRING_50]  default null
) is

validate is
begin  	
	if P_MESSAGE = 'DEFAULT' then
		bManual:=true;
		
		ourBranch := &sys.OurBranch;
		
		-- Возьмем значение настройки GNI_FILE_PATH. Критерий USER передаем пустым, так как он добавлен для использования только в операции "Формирование файлов" (FORM_FILE_ALL).
		P_PATH := &ft.get_str_value('GNI_FILE_PATH', &ft.set_canons(::[BRANCH]%class, ourBranch%id, '<GNI_FOLDER>', 'IN', ::[USER]%class, null), '0');
		
		V_GNI_FILE_PLACE := &ft.get_num_value('GNI_FILE_PLACE', &ft.set_canons(::[BRANCH]%class, ourBranch%id), '0');
		&debug('Настройка V_GNI_FILE_PLACE = ' || V_GNI_FILE_PLACE, 0)
		
		if V_GNI_FILE_PLACE in (0, 1) then
			if V_GNI_FILE_PLACE = 1 then
				P_PATH_SERV := ::[SYSTEM_PARAMS].[GET]('PATH', False);
			elsif V_GNI_FILE_PLACE = 0 then
				P_PATH_SERV := P_PATH;
			end if;
	
			P_PATH_ARC := &ft.get_str_value('GNI_FILE_PATH', &ft.set_canons(::[BRANCH]%class, ourBranch%id, '<GNI_FOLDER>', 'ARC', ::[USER]%class, null), '0');
	
			&debug('P_PATH_SERV = '||P_PATH_SERV, 0)
			&debug('P_PATH      = '||P_PATH, 0)
			&debug('P_PATH_ARC  = '||P_PATH_ARC, 0)

		end if;

	elsif P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'OK' then
			case V_GNI_FILE_PLACE of
				: 0 :
					--для сервера просто считываем файлы из папки.
					declare
						v_dir		integer;
						v_name		string;
						v_attrs 	string;
						v_uowner	string;
						v_gowner	string;
						v_mdate 	string;
						v_fsize 	string;
						v_num		integer := 1;
						v_close_dir integer;
						v_idx		number;
					begin
						v_idx := 1; -- индекс 1
						v_dir := stdio.OPENDIR( P_PATH, dir_flag == 1); -- открываем папку на чтение
						if v_dir > 0 then -- если удачно открыли
							while v_num > 0 loop -- пока номер элемента больше нуля, читаем элементы
								v_num := stdio.READDIR(
															v_dir,
															v_name,
								                   			v_attrs,
								                   			v_uowner,
								                   			v_gowner,
								                   			v_mdate,
								                   			v_fsize
								                  		);
				
								if v_num > 0 then -- и добавляем записи в таблицу файлов
									if is_valid_name(v_name) then
										V_LIST_FILES(v_idx) := v_name;
										v_idx:=v_idx+1;	--&inc(v_idx)
									end if;
				
								elsif v_num < 0 then -- при ошибке - сообщаем
									pragma error('Ошибка чтения элемента каталога '||P_PATH||' : '|| stdio.error_message(v_num));
				
								end if;
				
							end loop;
				
							v_close_dir := stdio.CLOSEDIR(v_dir); -- закрываем каталог
							if v_close_dir < 0 then -- при ошибке - сообщаем
								pragma error('Ошибка закрытия каталога '||P_PATH||' : '|| stdio.error_message(v_close_dir));
							end if;
				
						else -- при ошибке - сообщаем
							pragma error('Ошибка открытия каталога '||P_PATH||' : '|| stdio.error_message(v_dir));
						end if;
				
						&debug('Количество файлов = '||(v_idx - 1) ,0)	
					end;
				
				: 1 :
					-- для клиента копируем файлы на сервер
					declare
						v_idx integer;
					begin
						&debug('Количество файлов для копирования на сервер' || V_LIST_FILES.count, 0)
						if V_LIST_FILES.count > 0 then
							v_idx := V_LIST_FILES.first;
							while v_idx is not null loop
								stdio.put_line_buf('<%PLPCALL [GNI_JOUR].[EXPORT_LOCAL](%VAR%.V_SRC_NAME=>'''||V_LIST_FILES(v_idx)||''',%VAR%.V_DST_PATH=>'''||P_PATH_SERV||''',%VAR%.V_SRC_PATH=>'''||P_PATH||''',%VAR%.V_FROM_SERVER=>'''||0||''')%>');
								v_idx := V_LIST_FILES.next(v_idx);
							end loop;
						end if;
					end;				
			
			end; -- case
		elsif p_info = 'ADD_FILE' then
			if is_valid_name(v_filename) then
				V_LIST_FILES(V_LIST_FILES.count + 1) := v_filename; --сохраняем имя файла
			else
				null;
				&debug('Пропущен файл ' || v_filename || '. Имя файла не соответствует формату', 0)
			end if;
		end if;
	end if;
end;

execute is
fname			[FILE$PATH];
tmp_memo		[MEMO];
tmp_memo_str	[MEMO];
v_fhandler		integer;
cnt				number;			-- кол-во обработанных файлов
fname_dst		[FILE$PATH];	-- Имя файла в архиве
v_idx			integer;
v_num_format	integer;		-- Формат сообщения, 2 = 2446-У, 3 = 134-ФЗ
bUseAudit		boolean;
v_clob 			[CLOB];
historyArr		[GNI_JR_HIST_ARR];
errText			varchar2(32000);
filesFromEsi	TFilesTable; -- Башкиров В.Г. 28.11.2025 из ::[FIN_ACCOUNT_INT].[PRX_ESI] патч 25.4.05
idx				varchar2;
begin
	&debug('bManual = ' || bManual, 0)
	if bManual is null then
		&debug('------------', 0)
		ourBranch := &sys.OurBranch;
		
		-- Возьмем значение настройки GNI_FILE_PATH. Критерий USER передаем пустым, так как он добавлен для использования только в операции "Формирование файлов" (FORM_FILE_ALL).
		P_PATH := &ft.get_str_value('GNI_FILE_PATH', &ft.set_canons(::[BRANCH]%class, ourBranch%id, '<GNI_FOLDER>', 'IN', ::[USER]%class, null), '0');
		
		V_GNI_FILE_PLACE := &ft.get_num_value('GNI_FILE_PLACE', &ft.set_canons(::[BRANCH]%class, ourBranch%id), '0');
		&debug('Настройка V_GNI_FILE_PLACE = ' || V_GNI_FILE_PLACE, 0)
		
		if V_GNI_FILE_PLACE in (0, 1) then
			if V_GNI_FILE_PLACE = 1 then
				P_PATH_SERV := ::[SYSTEM_PARAMS].[GET]('PATH', False);
			elsif V_GNI_FILE_PLACE = 0 then
				P_PATH_SERV := P_PATH;
			end if;
	
			P_PATH_ARC := &ft.get_str_value('GNI_FILE_PATH', &ft.set_canons(::[BRANCH]%class, ourBranch%id, '<GNI_FOLDER>', 'ARC', ::[USER]%class, null), '0');
	
			&debug('P_PATH_SERV = '||P_PATH_SERV, 0)
			&debug('P_PATH      = '||P_PATH, 0)
			&debug('P_PATH_ARC  = '||P_PATH_ARC, 0)

		end if;
		case V_GNI_FILE_PLACE of
			: 0 :
				--для сервера просто считываем файлы из папки.
				&debug('Для сервера просто считываем файлы из папки', 0)
				declare
					v_dir		integer;
					v_name		string;
					v_attrs 	string;
					v_uowner	string;
					v_gowner	string;
					v_mdate 	string;
					v_fsize 	string;
					v_num		integer := 1;
					v_close_dir integer;
					v_idx		number;
				begin
					v_idx := 1; -- индекс 1
					v_dir := stdio.OPENDIR( P_PATH, dir_flag == 1); -- открываем папку на чтение
					if v_dir > 0 then -- если удачно открыли
						while v_num > 0 loop -- пока номер элемента больше нуля, читаем элементы
							v_num := stdio.READDIR(
														v_dir,
														v_name,
							                   			v_attrs,
							                   			v_uowner,
							                   			v_gowner,
							                   			v_mdate,
							                   			v_fsize
							                  		);
			
							if v_num > 0 then -- и добавляем записи в таблицу файлов
								&debug('Добавляем записи в таблицу файлов v_idx='||v_idx||' v_name='||v_name, 0)
								if is_valid_name(v_name) then
									V_LIST_FILES(v_idx) := v_name;
									v_idx:=v_idx+1; --&inc(v_idx)
								end if;
			
							elsif v_num < 0 then -- при ошибке - сообщаем
								pragma error('Ошибка чтения элемента каталога '||P_PATH||' : '|| stdio.error_message(v_num));
			
							end if;
			
						end loop;
			
						v_close_dir := stdio.CLOSEDIR(v_dir); -- закрываем каталог
						if v_close_dir < 0 then -- при ошибке - сообщаем
							pragma error('Ошибка закрытия каталога '||P_PATH||' : '|| stdio.error_message(v_close_dir));
						end if;
			
					else -- при ошибке - сообщаем
						pragma error('Ошибка открытия каталога '||P_PATH||' : '|| stdio.error_message(v_dir));
					end if;
					&debug('Количество файлов = '||(v_idx - 1) ,0)	
				end;
		end; -- case
		&debug('============', 0)
	end if;
	
	cnt	:= 0;
	bUseAudit := coalesce(&ft.get_bool_value('1B010048', null, '0'), false);
	dbms_lob.createtemporary(v_clob, true);
	&debug('V_GNI_FILE_PLACE = ' || V_GNI_FILE_PLACE, 0)
	
	if V_GNI_FILE_PLACE in (0, 1) then
		&debug('Количество файлов = ' || V_LIST_FILES.count, 0)
		if nvl(V_LIST_FILES.count,0) = 0 then
			::[CL_PRIV].[PSH_DATE_DEATH].UniLog(
				Substr('Кол-во файлов=' || V_LIST_FILES.count,1,350),
				Rpad('WORK_INC',10),			--тема
				'_'||&METHOD$SNAME||'.log');	--log
		else	--V_LIST_FILES.count > 0 then
			v_idx := V_LIST_FILES.first;
			while v_idx is not null loop
				fname := V_LIST_FILES(v_idx);
	
				if V_GNI_FILE_PLACE = 1 then
					fname := upper(fname);
				end if;
	
				if upper(fname) like '%.XML' then
					v_num_format := 3;
				else
					v_num_format := 2;	
				end if;
				
				tmp_memo = tmp_memo_str := null;
				cnt:=cnt+1; --&inc(cnt)
				
				&debug('--- Файл '||P_PATH_SERV||fname||' ---', 0)
				::[CL_PRIV].[PSH_DATE_DEATH].UniLog(
					Substr('Кол-во файлов=' || V_LIST_FILES.count||' Файл '||P_PATH_SERV||fname,1,350),
					Rpad('WORK_INC',10),			--тема
					'_'||&METHOD$SNAME||'.log');	--log

				v_fhandler := stdio.open(P_PATH_SERV, fname, 'R');
				while stdio.get_line(v_fhandler, tmp_memo_str, false, case v_num_format when 3 then stdio.WINTEXT else stdio.DOSTEXT end) loop
					tmp_memo := tmp_memo || tmp_memo_str || chr(10);
				end loop;			
				
				stdio.close(v_fhandler);
	
				v_clob := tmp_memo;
				/**/
				errText := processFile(fname, v_clob, bUseAudit, v_num_format, historyArr);
	
				&debug('=== errText:'||errText, 0)
				if errText is null then
					-- BS00172668: дубли файлов приходили от ПФР, а ПФР сейчас вообще не участвует в обмене и по сути этот код нерабочий. Пока удалять его не будем. При необходимости рассмотреть откат всей заявки BS00172668
					&debug('BS00172668: дубли файлов приходили от ПФР, а ПФР сейчас вообще не участвует в обмене и по сути этот код нерабочий. Пока удалять его не будем. При необходимости рассмотреть откат всей заявки BS00172668', 0)
					fname_dst := GetDstFileName(historyArr, fname);
					&debug('fname_dst='||fname_dst||' V_GNI_FILE_PLACE='||V_GNI_FILE_PLACE, 0)
					if V_GNI_FILE_PLACE = 1 then 					
						&debug('Копирование файла ['||fname||'] из ['||P_PATH_ARC||'] в ['||P_PATH_SERV||'] ', 0)						
						stdio.put_line_buf('<%PLPCALL [GNI_JOUR].[EXPORT_LOCAL](%VAR%.V_SRC_NAME=>'''||fname||''',%VAR%.V_DST_PATH=>'''||P_PATH_ARC||''',%VAR%.V_SRC_PATH=>'''||P_PATH_SERV||''',%VAR%.V_FROM_SERVER=>'''||1||''', %VAR%.V_DST_NAME=>'''||fname_dst||''')%>');
					elsif V_GNI_FILE_PLACE = 0 then
						&debug('Перемещение файла из ['||P_PATH_SERV||''||fname||'] в ['||P_PATH_ARC||''||fname_dst||'] ', 0)
						stdio.MOVE_FILE(P_PATH_SERV||'\'||fname, P_PATH_ARC||'\'||fname_dst);
					end if;
				else
					--&debug(errText, 0)
					debug_pipe(errText, 0);
					&debug('V_GNI_FILE_PLACE='||V_GNI_FILE_PLACE, 0)
					if V_GNI_FILE_PLACE = 1 then							
						&debug('Копирование файла ['||fname||'] из ['||P_PATH||'] в ['||P_PATH_SERV||'] ', 0)
						stdio.put_line_buf('<%PLPCALL [GNI_JOUR].[EXPORT_LOCAL](%VAR%.V_SRC_NAME=>'''||fname||''',%VAR%.V_DST_PATH=>'''||P_PATH||''',%VAR%.V_SRC_PATH=>'''||P_PATH_SERV||''',%VAR%.V_FROM_SERVER=>'''||1||''')%>');
					end if;
				end if;	
				/**/
				
				v_idx := V_LIST_FILES.next(v_idx);
				dbms_lob.freetemporary(v_clob);
			end loop;
		end if;
	end if;
	
  --&debug('Обработано ' || cnt || ' файлов уполномоченных органов', 0)
	debug_pipe('Обработано ' || cnt || ' файлов уполномоченных органов', 0);
end;
end;
end;
