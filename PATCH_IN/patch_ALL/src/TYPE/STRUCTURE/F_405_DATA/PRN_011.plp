class F_405_DATA;

@generate_ansi_joins(true)
@import_plsql(true)
@name('Печать в EXCEL (7047-У)')
library PRN_011 is

pragma include(::[SYSTEM].[PRODUCTS]);
pragma include(::[REPS_DATA].[LIB_VIEW]);
pragma include (::[RUNTIME].[LIB_MACRO]	);

pragma macro(lib,		'::[F_405_DATA].[LIB_FUNC_005]'	);
pragma macro(lp,		'::[REPS_DATA].[LIB_PRINT]'		);
pragma macro(xl,		'::[OOXML].[API_XL]'			);
pragma macro(lc,		'::[REPS_DATA].[LIB_CLIENT]'	);
pragma macro (lib_exp,	'::[F_405_DATA].[LIB_EXP_002]'	);
pragma macro(xl_cell,	'::[OOXML].[API_XL].cell([1],[2],[3], p_fontId == liFont, p_wrapText == true)', substitute);

lcvCoreVer	const	varchar2(10) := '11:';

/**
 * Получение ядра конфигурации операции
 *
 * @return	-	Строка с версией ядра конфигурации операции
 */
public function GetCoreVer
	return	varchar2(10)
is
begin
	return lcvCoreVer;
end;

/**
 * Функция, возвращающая информацию о приложении
 */
public function GetCoreInfo
	return	varchar2(4000)
is
	vStr	varchar2(4000);
begin
	::[RUNTIME].[STR].set_par(vStr, 'P_IS_EXT', '0');
	::[RUNTIME].[STR].set_par(vStr, 'P_PRIL_NAME', 'Печать в Excel');

	return vStr;
end;

--	Данные реализации
lrecParamInfo	&lib_exp.rec_ParamInfo;
--	Признак агрегирования данных в пределах дня
lbGrp			boolean;
liBorder		integer;				-- Идентификатор границ ячейки
liFont			integer;				-- Идентификатор шрифта ячейки
liSumFmt		integer;				-- Идентификатор формата суммы ячейки
liCnt			integer			:=	0;	-- Счетчик строк

-- Таблица, хранящая максимальную длину значений, индексируется по столбцам (в отчете используется один лист)
ltiMaxColLengths	::[REPS_DATA].[LIB_TYPE].arr_int;

--	Подтип - данные курсора по разделу 1
subtype rec_CurDataS1 is &lib_exp.rec_CurDataS1;
--	Подтип - данные курсора по разделу 2
subtype rec_CurDataS2 is &lib_exp.rec_CurDataS2;


/**
 *	Процедура рассчитывает максимальную длину значений по столбцу и сохраняет её в таблице ltiMaxColLengths
 *	используются для установки ширины столбцов такими, чтобы вмещались все числовые значения.
 *
 *	@param	P_COL	-- Столбец, куда записывается числовое значение
 *	@param	P_VALUE	-- Числовое значение
 */
procedure PutMaxLen
		(
			P_COL	integer
		,	P_VALUE	varchar2(32767)
		)
is
	iLen	integer;
begin
	-- Рассчитывается длина значения
	iLen := coalesce(length(P_VALUE), 0);

	-- Если столбец уже присутствует в таблице
	if ltiMaxColLengths.exists(P_COL) then
		-- То записывается максимум предыдущего значения и текущего
		ltiMaxColLengths(P_COL) := greatest(ltiMaxColLengths(P_COL), iLen);
	else
		-- Иначе просто записывается текущее
		ltiMaxColLengths(P_COL) := iLen;
	end if;
end;

/**
 *	Получить ширину столбца
 *
 *	@param	P_COL	-- Номер столбца
 *	@return	- число, ширина колонки
 */
function GetColumnWidthMerge
		(
			P_COL	number
		)
	return	number
is
	iLen	number	:=	0;
	iCol	number;
begin
	case P_COL of
	:10:
		iCol := 10;
	:11:
		iCol := 10;
	else
		return &xl.get_column_width(P_COL);
	end;

	for i in 0 .. iCol
	loop
		iLen := iLen + &xl.get_column_width(P_COL + i);
	end loop;

	return iLen;
end;

/**
 *	Процедура устанавливает ширину, соответствующую максимальному числовому значению по столбцу, там, где это необходимо.
 *	необходимо вызывать после завершения записи всех значений, она проходит по таблице ltiMaxColLengths
*/
procedure SetAutoWidth
is
	iCol		integer;	-- Текущий обрабатываемый столбец
	iWidth		integer;	-- Ширина столбца
	iWidthMerge	integer;	-- Ширина объед.столбцов
begin
	-- Цикл по столбцам
	iCol := ltiMaxColLengths.first;
	while iCol is not null
	loop
		-- Получаем значение максимальной ширины из таблицы
		iWidth = ltiMaxColLengths(iCol) := coalesce(ltiMaxColLengths(iCol), 0) + 3;

		iWidthMerge := GetColumnWidthMerge(iCol);

		-- Если оно больше, чем текущая ширина столбца
		if iWidth > iWidthMerge then
			-- То устанавливаем новую ширину
			&xl.set_column_width(&xl.get_column_width(iCol) + (iWidth - iWidthMerge), iCol);
		end if;

		iCol := ltiMaxColLengths.next(iCol);
	end loop;

	-- Очищение кэша
	ltiMaxColLengths.delete;
end;

/**
 *	Процедура подстановки значений вида "{{Значение}}" в шаблоне
 *
 *	@param	P_PARAM		- Ссылка на реализацию
 *	@param	P_DATE		- Дата
 *	@param	P_STR		- Строка
 */
procedure PlaceHolders
		(
			P_PARAM		ref	[REPS_PARAMS]
		,	P_DATE		date
		,	P_STR		varchar2(4000)
		)
is
	mapVars	&lp.tp_tabPlaceholders_v;
begin
	-- Получение списка подстановочных значений реализации
	mapVars := ::[REPS].[SLIB].get_placeholders(P_PARAM, P_DATE_1 == P_DATE);

	-- Заполнение списка подстановочных значений для подписей
	::[REPS].[SLIB].add_placeholders_for_footer
						(	P_STR				==	P_STR
						,	P_TAB_PLACEHOLDERS	==	mapVars	-- [in/out]
						);

	-- Заполнение списка подстановочных значений в шаблоне
	&lp.fill_xl_placeholders(mapVars);
end;

/**
 *	Процедура заполнения отчетной даты/периода
 */
procedure FillHeader
is
	iFont	integer;
Begin
	-- Получение идентификатора шрифта
	iFont := &xl.get_font
				(	p_name		==	'Arial CYR'
				,	p_fontsize	==	11
				,	p_bold		==	true
				);

	-- Вывод даты отчёта
	if lrecParamInfo.dDateBegin = add_months(lrecParamInfo.dDateEnd + 1, -1) then
		&xl.put(12, 13, 'за ' || to_char(lrecParamInfo.dDateEnd, 'month', 'NLS_DATE_LANGUAGE = RUSSIAN') || '   (месяц)   ' || to_char(lrecParamInfo.dDateEnd, 'yyyy') || ' г.');
	else
		&xl.cell(12, 13,'c ' || to_char(lrecParamInfo.dDateBegin, 'dd.mm.yyyy') || ' по ' || to_char(lrecParamInfo.dDateEnd, 'dd.mm.yyyy'), p_fontId == iFont, p_horizontal == &xl.xl_ah_center);
	end if;
end;

/**
 *	Процедура установки высоты строки
 *
 *	@param	P_NAME_R1C12_R2C9		-- Наименование резидента (раздел 1)/покапателя (раздел 2)
 *	@param	P_NAME_R1C14_R2C11		-- Наименование нерезидента (раздел 1)/продавца (раздел 2)
 *	@param	P_NAME_R1C16_R2C13		-- Наименование эмитента (раздел 1)/эмитента (раздел 2)
  *	@param	P_NOTE_R1_R2			-- Примечание (раздел 1)/примечание (раздел 2)
 */
procedure SetRowHigh
		(
			P_NAME_R1C12_R2C9	varchar2(32767)
		,	P_NAME_R1C14_R2C11	varchar2(32767)
		,	P_NAME_R1C16_R2C13	varchar2(32767)
		,	P_NOTE_R1_R2		varchar2(32767)
		)
is
	iLen	integer;
begin
	-- Определение максимальной длины
	iLen := greatest
				(	nvl(length(P_NAME_R1C12_R2C9), 0)
				,	nvl(length(P_NAME_R1C14_R2C11), 0)
				,	nvl(length(P_NAME_R1C16_R2C13), 0)
				,	nvl(length(P_NOTE_R1_R2), 0)
				);

	if iLen > 11 then
		&xl.set_row_height(iLen / 11 * 16, liCnt, liCnt);
	end if;
end;

/**
 *	Процедура заполнения раздела 1
 */
procedure FillR1
is
	--	Ссылочный курсор по нерезидентам
	curData		::[RUNTIME].[UTILS].ref_cursor;
	bFirst		boolean;
	vRezType	varchar2(2);
	vNRezType	varchar2(2);
	iRowNum		integer;
begin
	&xl.Open_Sheet(1);

	-- Стартовая позиция строки
	liCnt	:= 26;
	iRowNum	:= 0;
	bFirst	:= true;

	--	Открытие курсора по данным подраздела
	curData		:= &lib_exp.OpenCursorS1(
											P_PARAM_INFO	== lrecParamInfo
										,	P_GRP			== lbGrp
										);

	&for_opened_cursor(recData, curData, rec_CurDataS1, 1000)
		liCnt		:= liCnt + 1;

		-- Если сменился подраздел, вывести заголовок
		if recData.vSection = '1.2' and bFirst then
			-- Вывод заголовка подраздела 2
			&xl.pasteSpecial(26, 1, 26, 23, liCnt, 1, liCnt, 23);
			&xl.put(liCnt, 1, 'Подраздел 1.2. Операции по погашению основного долга (корпуса), выплатам дивидендов по акциям, процентов (купонов) по облигациям и иным ценным бумагам, цифровым финансовым активам, выкупу долей, паев, выплате распределенной части прибыли');
			-- Переход на следующую строку
			liCnt	:= liCnt + 1;
			bFirst	:= false;
			iRowNum	:= 0;
		end if;

		iRowNum := iRowNum + 1;

		&xl.pasteSpecial(21, 1, 21, 23, liCnt, 1, liCnt, 23);

		vRezType := recData.vTypeRez;

		-- Если тип резидента не указан
		if vRezType is null then
			vRezType := &lib.GetTypeRes(recData.rRezRef);
		end if;

		vNRezType := recData.vTypeNerez;

		-- Если тип нерезидента не указан
		if vNRezType is null then
			vNRezType := &lib.GetTypeNRes(recData.rNRezRef);
		end if;

		&xl.cell(liCnt, 1, recData.vSection || '.' || iRowNum, p_fontId == liFont);
		&xl.cell(liCnt, 2, to_char(recData.dDateOp, 'dd.mm.yyyy'), p_fontId == liFont);
		&xl.cell(liCnt, 3, recData.vFullCode, p_fontId == liFont);
		&xl.cell(liCnt, 4, recData.vKodCB, p_fontId == liFont);
		&xl.cell(liCnt, 5, recData.vKodOper, p_fontId == liFont);
		&xl.cell(liCnt, 6, recData.vKodNPl, p_fontId == liFont);

		-- Для граф "количество" и "размер доли" для некоторых кодов инструмента необходимо при нулевой сумме выводить null
		recData.nQuantity	:=	case
								when	recData.nQuantity = 0
									and	upper(recData.vKodCB) in ('DOL1', 'DOL2', 'DOL3', 'DOL4', 'DOL5', 'DOL6', 'DOL7', 'OTH3', 'OTH4')
								then
									null
								else
									recData.nQuantity
							end;

		recData.nPart		:=	case
								when	recData.nPart = 0
									and	upper(recData.vKodCB) in ('DOL3', 'DOL4', 'DOL5', 'DOL7', 'OTH3', 'OTH4','BON1', 'BON2', 'BON3', 'BON4', 'BON5', 'BON6', 'BON7', 'BIL1', 'BIL2', 'BIL3', 'BIL4', 'BIL5', 'BIL6', 'BIL7')
								then
									null
								else
									recData.nPart
							end;

		&xl.cell(liCnt, 7, recData.nQuantity, p_fontId == liFont);
		&xl.cell(liCnt, 8, recData.nPart, p_fontId == liFont);
		&xl.cell(liCnt, 9, recData.vCurPl, p_fontId == liFont);
		&xl.cell(liCnt, 10, recData.nSumTotal, p_numFmtId == liSumFmt, p_fontId == liFont);

		PutMaxLen(10, ltrim(to_char(recData.nSumTotal, '999,999,999,999,999,999.99')));

		&xl.cell(liCnt, 11, recData.nSumPrc, p_numFmtId == liSumFmt, p_fontId == liFont);

		PutMaxLen(11, ltrim(to_char(recData.nSumPrc, '999,999,999,999,999,999.99')));

		&xl.cell(liCnt, 12, recData.nTaxPrc, p_numFmtId == liSumFmt, p_fontId == liFont);

		PutMaxLen(12, ltrim(to_char(recData.nTaxPrc, '999,999,999,999,999,999.99')));

		&xl.cell(liCnt, 13, case when vRezType in ('ФЛ', 'ИП') then vRezType else nvl(&lib.GetNameClRes(recData.rRezRef, true, lrecParamInfo.dDateEnd, lrecParamInfo.rProf), recData.vRezident) end, p_fontId == liFont, p_wrapText == true);
		&xl.cell(liCnt, 14, case when vRezType in ('ФЛ', 'ИП') then null else recData.vResCode end, p_fontId == liFont, p_wrapText == true);

		&xl.cell(liCnt, 15, case	when vNRezType in ('ФЛ') then vNRezType
									when recData.rNRezRef%class = ::[CL_BANK_F]%class then	&lib.GetNameClQual(recData.rNRezRef, 'NAME', lrecParamInfo.dDateEnd)
									else nvl(&lib.GetNameClRes(recData.rNRezRef, false, lrecParamInfo.dDateEnd, lrecParamInfo.rProf), recData.vNerezident)
							end
						,	p_fontId == liFont, p_wrapText == true);
		&xl.cell(liCnt, 16, recData.vNRezCountry, p_fontId == liFont, p_wrapText == true);

		&xl.cell(liCnt,	17,	case	when	recData.rEmitent%class = ::[CL_BANK_F]%class	then	&lib.GetNameClQual(recData.rEmitent, 'NAME', lrecParamInfo.dDateEnd)
										else
										nvl(&lib.GetNameClRes(recData.rEmitent, &lib.isResident(recData.rEmitent, lrecParamInfo.dDateEnd), lrecParamInfo.dDateEnd, lrecParamInfo.rProf), recData.vEmitentName)
								end
							, p_fontId == liFont, p_wrapText == true);

		&xl.cell(liCnt, 18, recData.vEmitCode, p_fontId == liFont, p_wrapText == true);
		&xl.cell(liCnt, 19, recData.vRegNum, p_fontId == liFont, p_wrapText == true);
		&xl.cell(liCnt, 20, to_char(recData.dDateReg, 'dd.mm.yyyy'), p_fontId == liFont);

		if recData.dDatePay is not null then
			&xl.cell(liCnt, 21, to_char(recData.dDatePay, 'dd.mm.yyyy'), p_fontId == liFont);
		end if;

		&xl.cell(liCnt, 22, recData.vCurCB, p_fontId == liFont);
		&xl.cell(liCnt, 23, recData.vNotesPrint, p_horizontal == &xl.xl_ah_left, p_wrapText == true, p_vertical == &xl.xl_av_top);

		SetRowHigh
			(	&lib.GetNameClRes(recData.rRezRef, true, lrecParamInfo.dDateEnd, lrecParamInfo.rProf)
			,	&lib.GetNameClRes(recData.rNRezRef, false, lrecParamInfo.dDateEnd, lrecParamInfo.rProf)
			,	&lib.GetNameClRes(recData.rEmitent, &lib.isResident(recData.rEmitent, lrecParamInfo.dDateEnd), lrecParamInfo.dDateEnd, lrecParamInfo.rProf)
			,	recData.vNotesPrint
			);
	&end_forcursor;


	&xl.Set_Format_Range
			(	26
			,	1
			,	liCnt
			,	23
			,	p_borderId		==	liBorder
			,	p_fontId		==	liFont
			,	p_wrapText		==	true
			,	p_horizontal	==	&xl.xl_ah_center
			,	p_vertical		==	&xl.xl_av_bottom
			);

	SetAutoWidth;
	-- Устанавливаем альбомную ориентацию на листе и вписываем содержимое по ширине
	&xl.set_orientation(p_orientation == 1, p_sheet == 1);
	&xl.fit_in_page_width(1);
end;

/**
 *	Процедура вывода данных второго раздела
 */
procedure FillR2
is
	--	Ссылочный курсор по нерезидентам
	curData				::[RUNTIME].[UTILS].ref_cursor;
	cvAgrNote	const	varchar2(128)		:=	'Агрегация';
	vBuyerType			varchar2(2);
	vSellerType			varchar2(2);
	iRowNum				integer;
	vNotes				varchar2(32767);
	bFirst				boolean;

begin
	-- Переход на 2-й лист
	&xl.Open_Sheet(2);

	-- Смещение в первую позицию
	liCnt	:= 9;
	iRowNum	:= 0;
	bFirst	:= true;

	--	Открытие курсора по данным подраздела
	curData		:= &lib_exp.OpenCursorS2(
											P_PARAM_INFO	== lrecParamInfo
										,	P_GRP			== lbGrp
										);

	&for_opened_cursor(recData, curData, rec_CurDataS2, 1000)
		liCnt := liCnt + 1;
		-- Если сменился подраздел, вывести заголовок
		if recData.vSection = '2.2' and bFirst then
			-- Установка формата ячеек строки подзаголовка
			&xl.pasteSpecial(9, 1, 9, 17, liCnt, 1, liCnt, 17);
			-- Вывод заголовка подраздела 2
			&xl.put( liCnt, 1, 'Подраздел 2.2. Операции, выгодоприобретателями по которым являются клиенты - резиденты кредитной организации');
			-- Переход на следующую строку
			liCnt	:= liCnt + 1;
			bFirst	:= false;
			iRowNum	:= 0;
		end if;

		iRowNum := iRowNum + 1;

		&xl.pasteSpecial(1, 1, 1, 142, liCnt, 1, liCnt, 142);

		vBuyerType := coalesce(recData.vBuyerType, &lib.GetTypeRes(recData.rBuyerRef));

		vSellerType := coalesce(recData.vSellerType, &lib.GetTypeRes(recData.rSellerRef));

		vNotes := recData.vNotesPrint;

		-- Если несколько Брокерских биржевых сделок были сагрегированы, то дописываем примечание
		if		recData.nCountFPDeal > 1
			and	upper(nvl(vNotes, '#')) not like '%' || upper(cvAgrNote) ||'%'
		then
			vNotes := rtrim(cvAgrNote || '/' || vNotes, '/');
		end if;

		&xl.cell(liCnt, 1, recData.vSection || '.' || iRowNum , p_fontId == liFont);				-- 1. Номер строки
		&xl.cell(liCnt, 2, to_char(recData.dDateOp, 'dd.mm.yyyy'), p_fontId == liFont);			-- 2. Дата операции
		&xl.cell(liCnt, 3, recData.vKodCB, p_fontId == liFont);								-- 3. Код инструмента
		&xl.cell(liCnt, 4, recData.vKodOper, p_fontId == liFont);								-- 4. Код вида операции

		-- Для граф "колчиство" и "размер доли" необходимо в случае нулевой суммы необходимо выводить null
		recData.nQuantity	:=	case
								when recData.nQuantity = 0 then
									null
								else
									recData.nQuantity
							end;

		recData.nPart		:=	case
								when recData.nPart = 0 then
									null
								else
									recData.nPart
							end;

		&xl.cell(liCnt, 5, recData.nQuantity, p_fontId == liFont);								-- 5. Количество
		&xl.cell(liCnt, 6, recData.nPart, p_fontId == liFont);									-- 6. Размер доли
		&xl.cell(liCnt, 7, recData.vISOPl, p_fontId == liFont);								-- 7. Код валюты платежа
		&xl.cell(liCnt, 8, recData.nSumTotal, p_numFmtId == liSumFmt, p_fontId == liFont);		-- 8. Сумма платежа по операции ед. валюты

		PutMaxLen(8, ltrim(to_char(recData.nSumTotal, '999,999,999,999,999,999.99')));

		&xl.cell(liCnt, 9, case when vBuyerType in ('ФЛ','ИП') then vBuyerType else recData.vBuyerName end , p_fontId == liFont, p_wrapText == true);		--9. (Покупатель) Наименование
		&xl.cell(liCnt, 10, case when vBuyerType in ('ФЛ','ИП') then null else recData.vBuyerCode end  , p_fontId == liFont, p_wrapText == true);			--10. (Покупатель) Код
		&xl.cell(liCnt, 11, case when vSellerType in ('ФЛ','ИП') then vSellerType else recData.vSellerName end , p_fontId == liFont, p_wrapText == true);	--11. (Продавец) Наименование
		&xl.cell(liCnt, 12, case when vSellerType in ('ФЛ','ИП') then null else recData.vSellerCode end, p_fontId == liFont, p_wrapText == true);			--12. (Продавец) Код
		&xl.cell(liCnt, 13, recData.vEmitName, p_fontId == liFont, p_wrapText == true);			--13. (Эмитент) Наименование
		&xl.cell(liCnt, 14, recData.vEmitCode, p_fontId == liFont, p_wrapText == true);		--14. (Эмитент) Код
		&xl.cell(liCnt, 15, recData.vVekRegN, p_fontId == liFont, p_wrapText == true);			--15. Регистрационный номер ценной бумаги
		&xl.cell(liCnt, 16, recData.vISOVek, p_fontId == liFont);								--16. Код валюты ценной бумаги
		&xl.cell(liCnt, 17, vNotes, p_horizontal == &xl.xl_ah_left, p_wrapText == true, p_vertical == &xl.xl_av_top);	-- 17. Примечание

		SetRowHigh(recData.vBuyerName, recData.vSellerName, recData.vEmitName, vNotes);
	&end_forcursor;

	&xl.Set_Format_Range
			(	9
			,	1
			,	liCnt
			,	17
			,	p_borderId		==	liBorder
			,	p_fontId		==	liFont
			,	p_wrapText		==	true
			,	p_horizontal	==	&xl.xl_ah_center
			,	p_vertical		==	&xl.xl_av_bottom
			);

	SetAutoWidth;
	-- Устанавливаем альбомную ориентацию на листе и вписываем содержимое по ширине
	&xl.set_orientation(p_orientation == 1, p_sheet == 2);
	&xl.fit_in_page_width(2);
end;

/**
 *	Заполнение подписей
 */
procedure FillSign
is
	iSheetNum	integer;
begin
	liCnt := liCnt + 1;

	&xl.Open_Sheet(2);

	-- Копируем подписи с закладки с подписями и удаляем её
	iSheetNum := &xl.getSheetNum('signatures');

	&xl.CopyPasteRows
			(	p_src_row_b		==	1
			,	p_src_row_e		==	10
			,	p_row			==	liCnt
			,	p_src_sheet		==	iSheetNum
			,	p_sheet			==	2
			);

	&xl.delSheet(iSheetNum);
end;

/**
 *	Инициализация параметров форматирования
 */
procedure InitFormat
is
begin
	liBorder	:=	&xl.get_border
						(	p_top		==	&xl.xl_b_thin
						,	p_bottom	==	&xl.xl_b_thin
						,	p_left		==	&xl.xl_b_thin
						,	p_right		==	&xl.xl_b_thin
						);

	liFont		:=	&xl.get_font
						(	p_name == 'Times New Roman'
						,	p_fontsize == 8
						);

	liSumFmt	:=	&xl.get_numFmt('### ### ### ### ### ##0.00');
end;

/**
 * Запуск печати
 *
 * @param P_PARAM	- Параметры реализации
 * @param P_STR		- Строка параметров
 */
public function Run
		(
			P_PARAM		ref	[REPS_PARAMS]
		,	P_STR		varchar2(1000)
		)
	return	integer
is
	vPath	varchar2(512);
	iResult	integer := -1;
begin
	for	(
			select	rp
				(
					rp.[PROF]		:	C_PROF
				,	rp.[BRANCH]		:	C_BRANCH
				,	rp.[DATE1]		:	C_DATE1
				,	rp.[DATE2]		:	C_DATE2
				,	rp.[BANK]		:	C_BANK
				)
			in		::[REPS_PARAMS] all
			where	rp = P_PARAM
			fetch	1
		)
	loop
		lrecParamInfo.rParam		:= P_PARAM;				--	Ссылка на реализацию
		lrecParamInfo.rProf			:= rp.C_PROF;			--	Ссылка на профиль
		lrecParamInfo.rBranch		:= rp.C_BRANCH;			--	Ссылка на филиал
		lrecParamInfo.dDateBegin	:= rp.C_DATE1;			--	Дата начала отчётного периода
		lrecParamInfo.dDateEnd		:= rp.C_DATE2;			--	Дата окончания отчётного периода
		lrecParamInfo.rBank			:= rp.C_BANK;			--	Ссылка на банк
		iResult	:= 1;
	end loop;

	--	Признак агрегирования данных в пределах дня
	lbGrp	:=	nvl(::[RUNTIME].[STR].get_bool_par(P_STR, 'P_GR'), false);

	-- Актуализируем документы перед печатью
	::[F_405_DOC_DATA].[UPDATE_DOCS](lrecParamInfo.dDateBegin, lrecParamInfo.dDateEnd, false);

	vPath := coalesce(P_PARAM.[PROF].[REP_TEMPLATE], 'F_405_6800.XLSX');

	&lp.xl_init(vPath);
	&lib.InitParamInfo(P_PARAM);

	-- Инициализация параметров форматирования
	InitFormat();

	-- Заполнение заголовка
	FillHeader();

	-- Заполнение раздела 1
	FillR1();

	-- Заполнение раздела 2
	FillR2();

	-- Получаем параметры автозаполнения подписей
	PlaceHolders(lrecParamInfo.rParam, P_DATE == lrecParamInfo.dDateEnd, P_STR == P_STR);

	-- Заполнение подписей
	FillSign();

	&lp.xl_finish;

	return iResult;
end;
end;
