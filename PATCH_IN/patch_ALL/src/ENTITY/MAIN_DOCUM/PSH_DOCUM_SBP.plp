class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Реестр СБП')
static method PSH_DOCUM_SBP is
pragma macro (xl,'::[OOXML].[API_XL]');
PSH_DOCUM_SBP (
	@name('Дата')      P_DATE    in [DATE],
	@name('1 подпись') P_PODPIS1 in [USER_REF],
	@name('2 подпись') P_PODPIS2 in [USER_REF]
) is

validate is
iRow		number;
nRow		number;
nSum        number;
iBorder		integer;
xl_tmpl 	blob := empty_blob();

begin
	if P_MESSAGE = 'DEFAULT' then
		P_DATE:= ::[SYSTEM].[OP_DATE]-1;
		P_PODPIS1 := ::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_PODPIS1');
		P_PODPIS2 := ::[DEFVALS].[SLIB].RestoreRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_PODPIS2');

	elsif P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'OK' then
			::[SHABLON_DOC].[LIB_OOXML].load_blob('PSB_REESTR_SBP', xl_tmpl, null, null, null, null);
				     
			if xl_tmpl is null then pragma error('Не найден шаблон отчета'); end if;				
			if not &xl.open_file(xl_tmpl) then pragma error('Ошибка при открытии печатной формы шаблона');	end if;		  
		    &xl.Open_Sheet(1);			
			&xl.RenameSheet(1,to_char(P_DATE,'dd.mm.yy')); 			
			iRow := 4;
			nRow := 0;
			nSum:=0;
			iBorder := &xl.get_border(p_top==&xl.xl_b_thin, p_bottom==&xl.xl_b_thin, p_left==&xl.xl_b_thin, p_right==&xl.xl_b_thin);
		
		    &xl.Write(1, 9, 'Ресстр документов по операциям электронной коммерции  за '||to_char(P_DATE,'dd.mm.yyyy') ||' года');  -- bold
		    &xl.set_autofilter(4,4,1,14);
			for (
			        select d(
						      d  					: c_id			
						    , d.[DOCUMENT_NUM]      : c_document_num
						    , d.[VID_DOC].SHORT_CODE		:c_vid_doc_cod
						    , d.[VID_DOC].SHORT_NAME		:c_vid_doc_name
						    , d.[DATE_EXEC]         : c_date_exec
						    , d.[VALUTA].CODE_ISO    :c_valute
						    , d.[SUM]				: c_sum
						    , d.[SUM_NT]			: c_sum_nt
						    , d.[ACC_DT].[MAIN_V_ID]: c_num_dt
						    , d.[ACC_KT].[MAIN_V_ID]: c_num_kt				    
							, d.[NAZN]   : c_nazn
							, d.[PRIORITET]   : c_prioritet
							, d.[DOCUMENT_UNO]   : c_doc_uno
							,coalesce(d.[KL_DT].[2].[2], d.[KL_DT].[1].[1].[NAME])	: c_name_d
							,coalesce(d.[KL_KT].[2].[2], d.[KL_KT].[1].[1].[NAME])	: c_name_k
								) in ::[MAIN_DOCUM]
								join (::[USER] u1) on d.[DOCUMENT_USER] = u1 and u1.[USERNAME] in ('PAY_GATE', 'PAY_GATE2')  
								where	d.[DATE_PROV] >= P_DATE
									and d.[DATE_PROV] <  P_DATE + 1  
									and d%state='PROV'
						order by 5,6
				)
			loop
			    
				iRow :=	iRow + 1;	
				nRow :=	nRow + 1;
				&xl.Ins_Row(iRow,1,1,true);
		
		        &xl.put(iRow,1, nRow);      
		        &xl.put(iRow,2, to_char(d.c_date_exec,'dd/mm/yyyy')); 
		        &xl.put(iRow,3,d.c_vid_doc_name);
		        &xl.put(iRow,4,d.c_vid_doc_cod);
		        &xl.put(iRow,5,d.c_document_num);
		        nSum:=nSum+d.c_sum_nt;
		        &xl.put(iRow,6, d.c_sum);	
		        &xl.put(iRow,7, d.c_sum_nt);	
		        &xl.put(iRow,8, d.c_valute);	
		        &xl.put(iRow,9, d.c_num_dt);	
		        &xl.put(iRow,10, d.c_num_kt);
		        &xl.put(iRow,11, d.c_nazn);
		        &xl.put(iRow,12, d.c_name_d);      
		        &xl.put(iRow,13, d.c_name_k);    
		        &xl.put(iRow,14, d.c_prioritet);    
			end loop;
			&xl.Set_Format_Range(4, 1, iRow, 14, p_borderId == iBorder);
			
			iRow:=iRow+1;
			
			&xl.Formula(iRow,7,'=SUM(G4:G'||to_char(iRow-1)||')');   
			&xl.put(iRow+3,1, 'Количество документов '||nRow|| ' на сумму '||to_char( nSum ,'FM99,999,999,999,990.00')|| ' ('||::[RUNTIME].[STDLIB].N2Str(nSum, 'NatCur') ||')');  --фор   
			
			&xl.put(iRow + 5,1, P_PODPIS1.[CASTA].[VALUE]);    
			&xl.put(iRow + 5,9, ::[RUNTIME].[STDLIB].fio(P_PODPIS1.[NAME], 'Ф И.О.'));    
			&xl.put(iRow + 7,1, P_PODPIS2.[CASTA].[VALUE]);    
			&xl.put(iRow + 7,9, ::[RUNTIME].[STDLIB].fio(P_PODPIS2.[NAME], 'Ф И.О.'));

			&xl.Open_Sheet(1);		
		    &xl.finish(xl_tmpl);
			[OOXML]::[API_ORSA].putReport2RunExtProc(xl_tmpl,'xlsx','Реестр СБП за '||to_char(P_DATE,'dd.mm.yy')||' ');														
		
		end if;
	end if;
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_PODPIS1', P_PODPIS1, 'USER');
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_PODPIS2', P_PODPIS2, 'USER');
end;

execute is
begin
	null;							
end;
end;
end;
