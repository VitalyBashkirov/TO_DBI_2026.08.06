class PSH_CUST_DOCS;

@name('[ПСБ] Посмотреть ошибки выполнения')
@tag('COPIED')
method PSH_LOOK_ERRORS is

@name('Ошибки') public V_ERROR [MEMO_4000];
PSH_LOOK_ERRORS is

validate is
PRAGMA INCLUDE('[RUNTIME].[MACRO_LIB]');
begin
	if P_MESSAGE = 'DEFAULT' then
		&get_memo(this%class,this,'ERR_MESSAGE',V_ERROR)
	end if;
end;

execute is

begin
	null;
end;
end;
end;
