/**********************************************************
Функция возвращает ссылку на адрес
**********************************************************/
--Функция возвращает ссылку на адрес
public Function GetAddressRef(	cl_adresses		[CLIENT].[ADDRESSES]%type
						,AddRecv varchar2(100) default null
						,AddrCode varchar2(20) default null
			)return ref [PERSONAL_ADDRESS] is 
addr_ref		ref [PERSONAL_ADDRESS];
begin
	AddrCode := upper(AddrCode);
	begin
		select a(a)
			in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all : t ) all
			where	a%collection = cl_adresses
					and t = a.[TYPE]
					and t.[KOD] = AddrCode
					and rownum <= 1
			into addr_ref;
	exception
		when NO_DATA_FOUND then
			if AddrCode is null then   -- ищем любой адрес
				begin
					select a(a)
						in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all: t) all
						where	a%collection = cl_adresses
								and t = a.[TYPE]
								and rownum <= 1
						into addr_ref;
				exception when NO_DATA_FOUND then
					null;
				end;
			end if;
	end;

	return addr_ref;
end;


