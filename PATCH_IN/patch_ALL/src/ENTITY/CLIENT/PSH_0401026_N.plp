	HunTbl('8').fval := 'восемьсот';    HunTbl('8').sval := 'восьмисотого';
	HunTbl('9').fval := 'девятьсот';    HunTbl('9').sval := 'девятисотого';

	/*------------------------------Тысячи------------------------------*/
	ThsTbl('0').fval := '';				ThsTbl('0').sval := '';
	ThsTbl('1').fval := 'тысяча';		ThsTbl('1').sval := 'тысячного';
	ThsTbl('2').fval := 'две тысячи';	ThsTbl('2').sval := 'двухтысячного';
	ThsTbl('3').fval := 'три тысячи';	ThsTbl('3').sval := 'трехтысячного';
	ThsTbl('4').fval := 'четыре тысячи';ThsTbl('4').sval := 'четырёхтысячного';
