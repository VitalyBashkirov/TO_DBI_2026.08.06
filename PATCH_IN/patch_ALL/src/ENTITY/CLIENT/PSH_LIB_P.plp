function GetAccs(cl_ref [CLIENT_REF], on_date date) return varchar2(3000) is  --NGA 400
tmp_str varchar2(3000);  --  NGA 400
begin
	tmp_str := '';
	
 	for a in ::[AC_FIN]
		where a.[CLIENT_V] = cl_ref
			and trunc(a.[DATE_OP]) < on_date+1
		order by a.[DATE_OP] asc loop
 		tmp_str := tmp_str || NL$ || a.[MAIN_V_ID];
 	end loop;
	
	return ltrim(tmp_str, NL$);
end;

--Башкиров В.Г. 22.08.2012 Вычислим куратора или ответсвенного по счету
public function GetCurator(cl_ref [CLIENT_REF], on_date date default [SYSTEM].[OP_DATE]) return [USER_REF] is 
NameUser [NAME];
begin
	NameUser:=GetProp(cl_ref,'PSB_CURATOR',on_date);
	if NameUser is not null then
		for u in ::[USER] where u.[NAME]=NameUser and (u.[END_DATE] is null or u.[END_DATE]<=on_date) loop
			debug_pipe('Ответственный = '||u.[NAME],dp);
			return u;
		end loop;
	end if;
	return null;
end;

public function GetUser (StrUserMachine string(1000)) return [USER_REF] is 
t integer:=InStr(StrUserMachine,'.');
vUserName string(1000);
begin
	if t>0 then
		vUserName:=SubStr(StrUserMachine,1,t-1);
		for u in ::[USER] where u.[USERNAME]=vUserName loop --and (u.[END_DATE] is null or u.[END_DATE]<=on_date) loop
			return u;
		end loop;
	end if;
	return null;
end;

-- Функция возвращает основной код ОКВЭД клиента
-- Функция возвращает  ссылку на основной код ОКВЭД клиента
public function Get_Main_OKVED
(	p_client ref [CLIENT],
	p_date date default null
)return char is 
begin		
	if p_date is null then
		p_date := ::[SYSTEM].[OP_DATE];
	end if;	
	/*
	for ( select c(c.[OKVED].[NAME]: ok_ref)
			in p_client.[OKVED_IN_PERIOD]
			where	nvl(c.[MAIN], false)= true
					and nvl(c.[DATE_BEGIN],p_date) <= p_date
					and nvl(c.[DATE_END],p_date) >= p_date
	)loop
		return c.ok_ref;
	end loop;			
	*/
	for ( select c(c.[OKVED]: ok_ref)
			in p_client.[OKVED_IN_PERIOD]
			where	nvl(c.[MAIN], false)= true
					and nvl(c.[DATE_BEGIN],p_date) <= p_date
					and nvl(c.[DATE_END],p_date) >= p_date
	)loop
		return nvl(nvl(c.ok_ref.upper.upper.[NAME],c.ok_ref.upper.[NAME]),c.ok_ref.upper.[NAME]);
	end loop;			
end;

-- Башкиров В.Г. 10.06.2011 Работа с доп.признаками
public function GetValProp(PropRef ref [PROPERTIES]) return varchar2(32767) is 
ExStr varchar2(32767);
begin
	--Башкиров В.Г. 08.06.2014 Переписана GetValProp
	/** /
	ExStr:=
		'Дополнительное свойство '||PropRef.[GROUP_PROP].[FORM_CODE]||'-'||PropRef.[GROUP_PROP].[NAME]||LF$||
		'на период '||to_char(PropRef.[DATE_BEG],fmt)||'-'||to_char(PropRef.[DATE_END],fmt)||LF$||
		'Значение '||
			iif(PropRef.[PROP] 	is not null,'свойство:'||				PropRef.[PROP].[CODE]||'-'||PropRef.[PROP].[NAME] ,'')||
			iif(PropRef.[STR] 	is not null,'текст:'||					PropRef.[STR] 								,'')||
			iif(PropRef.[NUM] 	is not null,'число:'||					PropRef.[NUM] 								,'')||
			iif(PropRef.[V_DATE] is not null,'дата:'||					to_char(PropRef.[V_DATE],fmt) 				,'')||
			iif(PropRef.[BOOL] 	is not null,'логика:'||					PropRef.[BOOL] 								,'')||
			iif(PropRef.[OBJ] 	is not null,'ссылка на объект класса:'||PropRef.[OBJ]%class||' ID:'||PropRef.[OBJ]%ID,'');
	/**/
	ExStr:=
		--PropRef.[GROUP_PROP].[FORM_CODE]||'-'||PropRef.[GROUP_PROP].[NAME]||' '||
		'('||to_char(PropRef.[DATE_BEG],fmt)||iif(PropRef.[DATE_END] is null,'','-')||to_char(PropRef.[DATE_END],fmt)||')' ||
			iif(PropRef.[PROP] 	is not null,' '||PropRef.[PROP].[CODE]||'-'||PropRef.[PROP].[NAME] ,'')||
			iif(PropRef.[STR] 	is not null,' '||PropRef.[STR] 				   ,'')||
			iif(PropRef.[NUM] 	is not null,' '||PropRef.[NUM] 				   ,'')||
			iif(PropRef.[V_DATE]is not null,' '||to_char(PropRef.[V_DATE],fmt) ,'')||
			iif(PropRef.[BOOL] 	is not null,' '||iif(PropRef.[BOOL],'Да','Нет'),'')||
			iif(PropRef.[OBJ] 	is not null,' ссылка на объект класса:'||PropRef.[OBJ]%class||' ID:'||PropRef.[OBJ]%ID,'');
	return ExStr;
end;
--Z$CLIENT_PSB_LIB.GetProp(A1_1.ID,PSB_CURATOR,null,2)
public function GetProp(p_client ref [CLIENT],	P_PROP_CODE [STRING_35], p_date [DATE] default null, TypeVal integer default 0) return varchar2(32767) is 
ExStr varchar2(32767);
begin
	if p_date is null then p_date :=::[SYSTEM].[OP_DATE]; end if;
	
	for(
		select ap (
					ap.[GROUP_PROP].[TYPE_VALUE]	: c_g_prop_type_val
					, ap.[PROP].[NAME]				: c_prop_name
					, ap.[NUM]						: c_num
					, ap.[STR]						: c_str
					, ap.[V_DATE]					: c_v_date
					, ap.[BOOL]						: c_bool
					, ap.[OBJ]						: c_obj
					, ap.[GROUP_PROP].[TBP]			: c_g_prop_tbp
					
					)
		in p_client.[ADD_PROP] all
	
	    where ap.[GROUP_PROP].[CODE] = P_PROP_CODE
	    and	nvl(ap.[DATE_BEG],p_date) <= p_date
	    and	nvl(ap.[DATE_END],p_date) >= p_date
	    	
	)loop
		if    ap.c_g_prop_type_val is null 		then 	ExStr := ap.c_prop_name;
		elsif ap.c_g_prop_type_val ='NUMBER'	then 	ExStr := to_char(ap.c_num,'999G999G999G999G990D0099');
		elsif ap.c_g_prop_type_val ='STRING'    then 	ExStr := ap.c_str;
		elsif ap.c_g_prop_type_val ='DATE' 	    then 	ExStr := to_char(ap.c_v_date,fmt);
		elsif ap.c_g_prop_type_val ='BOOL' 	    then 	ExStr := iif(ap.c_bool, 'Да', iif(ap.c_bool is null,'Null','Нет'));
		elsif ap.c_g_prop_type_val ='REF' 	    then 	ExStr := ::[RUNTIME].[OBJ].GetObjValue(ap.c_obj, ap.c_g_prop_tbp);
		else						     				ExStr:='!Ошибка! Тип значения не определён!';
		end if;		
		
		exit;
	end loop;
	
	return trim(ExStr);
end;

public function getDisposits
(	p_client ref [CLIENT],
	p_date date default null
)return char is 
begin		
	if p_date is null then
		p_date := ::[SYSTEM].[OP_DATE];
	end if;	
	/*
	for ( select c(c.[OKVED].[NAME]: ok_ref)
			in p_client.[OKVED_IN_PERIOD]
			where	nvl(c.[MAIN], false)= true
					and nvl(c.[DATE_BEGIN],p_date) <= p_date
					and nvl(c.[DATE_END],p_date) >= p_date
	)loop
		return c.ok_ref;
	end loop;			
	*/
	for ( select c(c.[DISPOSITION]: desp_ref)
			in p_client.[DISPOSITS]
			where	/*nvl(c.[DISPOSITION].[MAIN], false)= true
					and*/ nvl(c.[DATE_BEG],p_date) <= p_date
					and nvl(c.[DATE_END],p_date) >= p_date
	)loop
		return c.desp_ref.[SHORT_NAME];
	end loop;			
end;

--NGA07082013
--NGA07082013 Список дат из массива "Даты обновлений"
--                        и массива "История реквизитов"(только некоторые-изменение оценки риска при заполнении анкеты
--                                                       и установка связи типа выгодо-приобретатель/даатель др.клиентами)
--            Если массив "Даты обновлений" пуст, то история тоже не нужна! Значение посчитают сами процедуры, вызывающие эту функцию.
public function GetDateAll(Cl ref [CLIENT], max_date [DATE] default [constant].DATE_MAX)
return [MEMO] is 
all_date [MEMO_32767];
begin

--> ivanov a.v. 17/04/2017 Оптимизация
--*******************************
	/** /
	-- по датам обновлений
	for	(	select	cl_du( cl_du.[DATE_UPD]	:c_date_upd)
				in	[CL_DATE_FORM_UPD] all
			where	cl_du.[DATE_UPD] is not null and
					cl_du%collection = cl.[DATES_FORM_UPD] and
					trunc(cl_du.[DATE_UPD])<=trunc(max_date)
			order by cl_du.[DATE_UPD] desc)
	loop
		if InStr(all_date,to_char(cl_du.c_date_upd,fmt))>0 then
			null;
		else
			--NGA20012014 all_date:=all_date||to_char(cl_du.[DATE_UPD],fmt)||'; ';
			all_date:=all_date||to_char(cl_du.c_date_upd,fmt_s)||'; ';
		end if;
	end loop;

	if trim(all_date) is not NULL then
		all_date:=all_date||chr(10);
	else
		return '';
	end if;
	/**/
	-- по датам из истории изменений (только основание смены уровня риска и выгодо(приобретатель/датель)
	for	(	select cl_h( cl_h.[DATE_EDIT]	:c_date_edit)
				in ::[CL_HIST]
			where
				(	cl_h.[QUAL] = 'FAIL_MARK' or
					cl_h.[QUAL] = 'LINKS_OTHER' and
						exists (	select a(a)
										in ::[LINKS_CL] all
									where a%collection = cl_h.[VALUE] and
										a.[VID_LINK].[CODE] in ('ВЫГОДОПРИОБРЕТАТЕЛЬ','ВЫГОДОДАТЕЛЬ') )
				) and
				nvl(cl_h.[CLIENT_REF],cl_h.[CLIENT_ID])=Cl and
				trunc(cl_h.[DATE_EDIT])<=trunc(max_date)
			order by cl_h.[DATE_EDIT] desc)
	loop
		if InStr(all_date,to_char(cl_h.c_date_edit,fmt))>0 then
			null;
		else
			--NGA20012014 all_date:=all_date||to_char(cl_h.[DATE_EDIT],fmt)||'; ';
			all_date:=all_date||to_char(cl_h.c_date_edit,fmt_s)||'; ';
		end if;
	end loop;
--< ivanov a.v. 17/04/2017 Оптимизация
	return trim(trim(all_date),';');
end;

-- Дианков А.В. 24.10.2014  Должность
--							ФИО первого лица
--							Дата рождения
--							Телефон
--							Email
public function position(cl_pos number) return memo is 						
list memo;
n number:=0;
begin
	for dt in ::[PERSONS_POS] all where dt%collection=cl_pos AND dt.[CHIEF]=true
	loop
		n:=n+1;
		
		if n = 1 then
		 list:=dt.[RANGE].[VALUE];
		else
		 list:=list||chr(10)||dt.[RANGE].[VALUE];
		end if;
		
	end loop;
	
	return list;
end;

public function fio_first(cl_pos number) return memo is 
list memo;
n number:=0;
begin
	for dt in ::[PERSONS_POS] all where dt%collection=cl_pos AND dt.[CHIEF]=true
	loop
		n:=n+1;
		
		if n = 1 then
		 list:=dt.[FASE].[NAME];
		else
		 list:=list||chr(10)||dt.[FASE].[NAME];
		end if;
		
	end loop;
	
	return list;
end;

public function fio_date_first(cl_pos number) return memo is 
list memo;
n number:=0;
begin
	for dt in ::[PERSONS_POS] all where dt%collection=cl_pos AND dt.[CHIEF]=true
	loop
		n:=n+1;
		
		if n = 1 then
		 list:=to_char(dt.[FASE].[DATE_PERS], 'dd.mm.yyyy');
		else
		 list:=list||chr(10)||to_char(dt.[FASE].[DATE_PERS], 'dd.mm.yyyy');
		end if;
		
	end loop;
	
	return list;
end;

public function fio_tel_first(cl_pos number) return memo is 
list memo;
n number:=0;
begin
	for dt in ::[PERSONS_POS] all where dt%collection=cl_pos AND dt.[CHIEF]=true
	loop
		n:=n+1;
		
		if n = 1 then
		 list:=::[CL_PRIV].[PSH_LIB_CL].cl_phone_10(dt.[FASE].[CONTACTS]); -- updated CHANGE_SHORT_NAME PSB_LIB_CL->PSH_LIB_CL 14/10/25
		else
		 list:=list||chr(10)||::[CL_PRIV].[PSH_LIB_CL].cl_phone_10(dt.[FASE].[CONTACTS]); -- updated CHANGE_SHORT_NAME PSB_LIB_CL->PSH_LIB_CL 14/10/25
		end if;
		
	end loop;
	
	return list;
end;

public function fio_email_first(cl_pos number) return memo is 
list memo;
n number:=0;
begin
	for dt in ::[PERSONS_POS] all where dt%collection=cl_pos AND dt.[CHIEF]=true
	loop
		n:=n+1;
		
		if n = 1 then
		 list:=::[CL_PRIV].[PSH_LIB_CL].cl_email(dt.[FASE].[CONTACTS]); -- updated CHANGE_SHORT_NAME PSB_LIB_CL->PSH_LIB_CL 14/10/25
		else
		 list:=list||chr(10)||::[CL_PRIV].[PSH_LIB_CL].cl_email(dt.[FASE].[CONTACTS]); -- updated CHANGE_SHORT_NAME PSB_LIB_CL->PSH_LIB_CL 14/10/25
		end if;
		
	end loop;
	
	return list;
end;

public function cl_email(cl ref [CLIENT]) return memo is 
ret memo;
begin
   for cnt in cl.[CONTACTS] where cnt.[TYPE].[CODE] = 'MAIL' AND cnt.[ACTIV]       						
   loop
       if ret is null then ret:= substr(cnt.[NUMB],1,100);
       else ret:= ret ||chr(10)||substr(cnt.[NUMB],1,100);
       end if;
   end loop;

   return ret;	
end;

--NGA 19/12/2014
public function GET_CONTACT(Cl ref [CLIENT]
,tp ::[CONTACTS].[TYPE].[CODE]%type    default 'MOBILEPHONE'  -- тип связи
,pr ::[CONTACTS].[PRIVATE].[CODE]%type default 'SMS'  -- принадлежность
) return varchar2(100) is 
  ret varchar2(100);
  tp2 ::[CONTACTS].[TYPE].[CODE]%type    default 'PHONE';
begin
  ret := '  -  ';
   for cnt in cl.[CONTACTS] where (cnt.[TYPE].[CODE] = tp OR cnt.[TYPE].[CODE] = tp2)
       AND cnt.[PRIVATE].[CODE] = pr AND cnt.[ACTIV]
       order by cnt.[TYPE].[CODE]
   loop
       ret:= substr(cnt.[NUMB],1,100);
       exit;
   end loop;
   return ret;
end;
--NGA 19/12/2014 end

--Картешкина Н.Н.  23.11.16 Получить СНИЛС - begin
function get_snils_doc(doc_coll [CERTIFICATE_ARR]) return string is
	snils string;
begin
	snils := NULL;
	-- в удостоверениях
	for (select x(regexp_replace(x.[NUM], '\D'): NUM) in doc_coll where x.[TYPE] = ::[CERTIFIC_TYPE]([KOD] = 'СНИЛС')) loop
		snils := x.NUM;
		exit;
	end loop;

	return snils;
end;

function get_snils(priv_ref ref [CL_PRIV]) return string is
	snils string;
	priv [CL_PRIV];
begin
	snils := NULL;
	priv := priv_ref;
	-- в удостоверениях
	snils := get_snils_doc(priv.[DOC_ARR]);
	-- в пользователях
	if snils is NULL then
		for (select x(x.[PF] : C_SNILS) in ::[USER]
					where x.[CL_PRIV_REF]=priv_ref )
				loop	
					snils := replace(replace(x.[C_SNILS],' ',''),'-','');				
				end loop;
	end if;
	return snils;
end;
--Картешкина Н.Н.  23.11.16 Получить СНИЛС - end

--Картешкина Н.Н.  23.12.16 Действует ли банк - begin
function is_bank_active(ref_cl_bank_n ref [CL_BANK_N]) return boolean is
	l_state boolean := true;
begin

	for (
		select x(x.[ACTIVE]   : BANK_STATE)
			in ::[CL_BANK_N] all
			where	x%id= ref_cl_bank_n
					
		)
	loop
		return x.BANK_STATE;
	end loop;	

	return l_state;
	
end;
--Картешкина Н.Н.  23.12.16 Действует ли банк - end
