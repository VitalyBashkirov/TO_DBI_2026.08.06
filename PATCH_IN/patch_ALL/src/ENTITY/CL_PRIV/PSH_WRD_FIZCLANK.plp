				P_DATA := nvl(trim(P_DATA), '---');
				case substr(p_info,5,1) of 	: '1' :  P_DATA := nvl(trim(Migr_doc1.num), '---')	;
											: '2' :  P_DATA := nvl(trim(Migr_doc2.num), '---')	;
											: '3' :  P_DATA := nvl(trim(Migr_doc3.num), '---')	;
				end;
				
			elsif p_info = 'МИГР1_ДН' or p_info = 'МИГР2_ДН' or p_info = 'МИГР3_ДН' then
				P_DATA := nvl(trim(P_DATA), '---');
				case substr(p_info,5,1) of 	: '1' :  P_DATA := nvl(trim(Migr_doc1.date_b), '---')	;
											: '2' :  P_DATA := nvl(trim(Migr_doc2.date_b), '---')	;
											: '3' :  P_DATA := nvl(trim(Migr_doc3.date_b), '---')	;
				end;
			elsif p_info = 'МИГР1_ДО' or p_info = 'МИГР2_ДО' or p_info = 'МИГР3_ДО' then
				P_DATA := nvl(trim(P_DATA), '---');
				case substr(p_info,5,1) of 	: '1' :  P_DATA := nvl(trim(Migr_doc1.date_e), '---')	;
											: '2' :  P_DATA := nvl(trim(Migr_doc2.date_e), '---')	;
											: '3' :  P_DATA := nvl(trim(Migr_doc3.date_e), '---')	;
				end;	
																							
			elsif p_info = 'РАБОТА' then           --Место работы и должность
				if client_corp%id is not null then
