dp  number:=0;		--управление debug_pipe  Башкиров В.Г. 09.10.2024
dp2 number:=0;
dp3 number:=null;	--для GET_EXTRACT
fmt string(10):='dd/mm/yyyy';
pnt string(10):='dd.mm.yyyy';
pragma macro (iResRow, 'if [2] is not null then ins_OUERY_result_row(QUERY_ID,ROW_NUMBER,[1],[2],LINE_NUMBER); end if;', substitute);
pragma macro (dbg, 'if [2] is not null then &debug([1],[2]) end if;', substitute);

