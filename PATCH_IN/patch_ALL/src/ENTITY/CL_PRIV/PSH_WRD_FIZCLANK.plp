			    --ищем рабочий телефон
			    P_DATA := GetContacts(client_priv.[CONTACTS], 'PHONE')||
			    		  GetContacts(client_priv.[CONTACTS], 'MOBILEPHONE')||
			              GetContacts(client_priv.[CONTACTS], 'FAX');
				if client_corp%id is not null then
					P_DATA := GetContacts(client_corp.[CONTACTS], 'PHONE')||
				    		  GetContacts(client_corp.[CONTACTS], 'MOBILEPHONE')||				
							  GetContacts(client_corp.[CONTACTS], 'FAX')||
							  trim(P_DATA);
				end if;
*/			
			elsif p_info = 'КОНТАКТ_ТЕЛ' then        --КОНТАКТЫ
			    --ищем телефоны и факсы
				P_DATA := GetContacts(client_priv.[CONTACTS], 'PHONE')||
			    		  GetContacts(client_priv.[CONTACTS], 'MOBILEPHONE')||
			              GetContacts(client_priv.[CONTACTS], 'FAX');
			elsif p_info = 'КОНТАКТ_ПОЧ' then        
				P_DATA := GetContacts(client_priv.[CONTACTS], 'MAIL');
				
			elsif p_info = 'Е_МАЙЛ' then
		 		P_DATA := GetContacts(client_priv.[CONTACTS], 'MAIL');
				if client_corp%id is not null then
					P_DATA := GetContacts(client_corp.[CONTACTS], 'MAIL') || trim(P_DATA);
				end if;
			--BS00123652
			elsif p_info = 'ИПДЛ' then
				P_DATA := GetPDLStr(client_priv.[IS_IPDL], &IPDL);
			elsif p_info = 'ДЛМО' then
				P_DATA := GetPDLStr(client_priv.[IS_IPDL], &DLMO);		
			elsif p_info = 'ПДЛ' then
				--P_DATA := GetPDLStr(client_priv.[IS_IPDL], null);		
				if client_priv.[IS_IPDL].[CODE] in ('RPDL','IPDL') then P_DATA := client_priv.[IS_IPDL].[NAME];
				else P_DATA := 'Нет';
				end if;

			--elsif p_info = 'РПДЛ' then P_DATA := GetPDLStr(client_priv.[IS_IPDL], &RPDL);
			elsif p_info = 'РПДЛ' then
				temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
				for dop in this.[ADD_PROP] where dop.[GROUP_PROP].[CODE]='PSH_PDL_RODSTVO' and dop.[DATE_BEG]<P_DATE_PRINT and (dop.[DATE_END] is null or dop.[DATE_END]>=P_DATE_PRINT)
				loop
				temp_str := dop.[PROP].[NAME];
				end loop;
				if temp_str is null then P_DATA:='Нет';
				else P_DATA:='Да'||chr(13)||'Степень родства либо статус (супруг или супруга) клиента по отношению к ПДЛ - '||temp_str;
				end if;
				
			elsif p_info = 'ПРЦ_ВЛАДЕНИЯ' then
				
				declare cl_ ref [CLIENT];
				begin
				cl_ := client_priv%id;
				for fff in [FOUNDERS] all where fff.[FOUNDER] = cl_ and fff.[DATE_BEG]<=P_DATE_PRINT and (fff.[DATE_END] is null or fff.[DATE_END]>=P_DATE_PRINT)
				loop
					--if P_DATA is null then
						P_DATA :='Владение '||fff.[PERCENT]||'% УК Общества';
					--else
					--	P_DATA :=P_DATA||NL$||fff.[PERCENT]||'% УК Общества';
					--end if;	
				end loop;		
				end;
			elsif p_info = 'ДАТА_ЗАПОЛН' then		--Дата заполнения
				P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_ANK, op_dat)), '');
--but				
			elsif p_info = 'ДАТА_ЗАПОЛН1' then		--Дата заполнения
			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_ANK, op_dat)), '');
			elsif p_info = 'ДАТА_ПЕЧАТИ' then		--Печать анкеты на дату
			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_PRINT, op_dat)), '');
			elsif p_info = 'ДАТА_ОД' then		--Дата заполнения
			P_DATA := ::[RUNTIME].[VIEWFUN].DAT_STR(op_dat);
--	
			elsif p_info = 'ДАТА_ОБНОВЛ' then		--Дата обновления
			/*	P_DATA:=this.[FAIL_MARK];
				--Башкиров В.Г. 27.01.2021
				--Поправил расчет параметра 'ДАТА_ОБНОВЛ'.
				--Теперь, если она не определена, вычисляю ее дистрибутивной функцией get_date_upd
				--Если и она не определяет, вывожу дату операционного дня.
				if P_DATA is null then
					var tmpClientRef ref [CLIENT];
					tmpClientRef:=this%id;
					P_DATA:=nvl( ::[RUNTIME].[VIEWFUN].DAT_STR( nvl(get_date_upd(tmpClientRef,P_DATE_PRINT),op_dat) ), '');
				end if;
			*/	if to_char(this.[DATE_FORM_UPD],fmt) != to_char(nvl(P_DATE_ANK, op_dat),fmt) then
					P_DATA:=to_char(this.[DATE_FORM_UPD],fmt);
				end if;
	
			elsif p_info = 'ПСХ_ДАТА_ОБНОВЛ' then		--Дата обновления
				P_DATA :=  to_char( ::[SYSTEM].[VARIABLES].OpDate+364, ShortFmt);		

			elsif p_info = 'УРОВЕНЬ_РИСКА' then	 	--Уровень риска
				declare
					fl	ref [FAIL_LEVEL];
					fv	number;
					mrk	::[CLIENT].[FAIL_MARK]%type;
				begin
					if client_corp%id is not null then
						::[LEGAL_INTERFACE].[PRX_CLIENT].getRisk_FailValueAndLevel(client_corp%id, fl, fv, P_DATE_PRINT);
						mrk := client_corp.[FAIL_MARK];
					else
						::[LEGAL_INTERFACE].[PRX_CLIENT].getRisk_FailValueAndLevel(client_priv%id, fl, fv, P_DATE_PRINT);
						mrk := client_priv.[FAIL_MARK];
			 		end if;

--					P_DATA := COALESCE(fl.[NAME], fl.[CODE]) || ' ' || mrk; --but
					P_DATA := COALESCE(fl.[NAME], fl.[CODE]);

				end;
 					if trim(P_DATA) is null then P_DATA := 'Низкий'; end if;      --but если ничего нет, ставим Низкий (Котельников)				
			elsif p_info = 'ИСТОРИЯ_РИСКА' then	 	--история риска
					P_DATA := COALESCE(client_priv.[FAIL_MARK],'.');
			
--< Отметки банка 08042024
			elsif p_info like '%ДАТА_ТЕРРОР' then		--Дата проверки				
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
					order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt);
							if p_info = 'ДАТА_ТЕРРОР' then
								P_DATA := P_DATA ||' - '||rez.[CHECK_VAL].[NAME];
							end if;
							exit;
						end loop;
			elsif p_info like '%ДАТА_ООН' then		--Дата проверки				
					for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='LIST_OON' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
						order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt);
							if p_info = 'ДАТА_ООН' then
								P_DATA := P_DATA ||' - '||rez.[CHECK_VAL].[NAME];
							end if;
							exit;
						end loop;		
			elsif p_info like '%ДАТА_ЗАМ_СР' then		--Дата проверки				
					for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='FREEZE_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
						order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt);
							if p_info = 'ДАТА_ЗАМ_СР' then
								P_DATA := P_DATA ||' - '||rez.[CHECK_VAL].[NAME];
							end if;
							exit;
						end loop;		
			elsif p_info = 'РЕШ_БАНК' then		--Решение банка
				--для ФЛ
				P_DATA := 'Бенефициарный владелец установлен';
		 		    
			elsif p_info = 'ОСН_РЕШ_БАНК' then		--Основание решения
				--для ФЛ
				P_DATA := 'Бенефициарным владельцем является клиент-физическое лицо';
		 		   
			elsif p_info like 'ДАТА_НАЧ_ОТН%' then		--Дата начала отношений
	 			P_DATA := nvl(to_char(cl_info.[FIRST_ACC_DATE],fmt) , '');
	 		elsif p_info = 'ДАТА_ПРЕК_ОТН' then		--Дата прекращения отношений
	 			if cl_info.[CLOSE_DATE] is null then
	 				begin
	 					locate ac in ::[AC_FIN] where ac.[CLIENT_V] = this and ac.[DATE_CLOSE] is null and rownum = 1;
	 				exception when NO_DATA_FOUND then
	 					begin
	 						select distinct ac(max(ac.[DATE_CLOSE])) in ::[AC_FIN] where ac.[CLIENT_V] = this into cl_info.[CLOSE_DATE];
	 					exception when NO_DATA_FOUND then
	 						null;
	 					end;
	 				end;	 					
	 			end if;
	 			P_DATA := nvl(to_char(cl_info.[CLOSE_DATE],fmt) , '');
	 		elsif p_info = 'ДАТА_ОФОР_АНК' then		--Дата оформления
	 			P_DATA := to_char(nvl(P_DATE_ANK, op_dat),fmt);
	 			
			elsif p_info = 'ДАТА_ЗАПОЛН' then		--Дата заполнения
	 			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_ANK, op_dat)), '');
			elsif p_info = 'ДАТА_ПЕЧАТИ' then		--Дата печати
	 			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_PRINT, op_dat)), '');
			elsif p_info = 'ДАТА_ОБНОВЛ' then		--Дата обновления
								--P_DATA:=this.[FAIL_MARK];			
								P_DATA:=to_char(this.[DATE_FORM_UPD],fmt);	--Башкиров В.Г. 14.11.2020
			elsif p_info = 'ДАТА_ПРЕД_ОБНОВЛ' then	--Даты предыдущих обновлений	--Ильин Д.А. 09.12.2024
				P_DATA := '';
				for (
				select distinct y(y.c_value : c_y_value) in
				(select distinct x(to_char(to_date(trim(x.[VALUE]),'yyyy-MM-dd hh24:mi:ss'), fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = this%id and x.[QUAL] = 'DATE_FORM_UPD'
				union all
				select distinct x(to_char(x.[DATE_EDIT], fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = this%id and x.[QUAL] = 'MANUAL_EDIT')
				order by to_date(y.c_value, 'dd/MM/yyyy') desc
				)
				loop
					if to_date(y.c_y_value, 'dd/MM/yyyy') < this.[DATE_FORM_UPD] then 
						P_DATA := P_DATA || y.c_y_value || ', ';
					end if;
				end loop;
				P_DATA := rtrim(ltrim(P_DATA, ', '), ', ');	
			elsif p_info = 'ДАТЫ_ОБНОВЛ_ВСЕ' then
				P_DATA := to_char(this.[DATE_FORM_UPD],fmt);
				for (
				select distinct y(y.c_value : c_y_value) in
				(select distinct x(to_char(to_date(trim(x.[VALUE]),'yyyy-MM-dd hh24:mi:ss'), fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = this%id and x.[QUAL] = 'DATE_FORM_UPD'
				union all
				select distinct x(to_char(x.[DATE_EDIT], fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = this%id and x.[QUAL] = 'MANUAL_EDIT')
				where y.c_value is not null
					and to_date(y.c_value, 'dd/MM/yyyy') < this.[DATE_FORM_UPD]
				order by to_date(y.c_value, 'dd/MM/yyyy') desc
				)
				loop
					P_DATA := P_DATA || ', ' || y.c_y_value;
				end loop;
			elsif p_info = 'ДАТА_ЗАКРЫТИЯ' then		--Дата прекращения отношений с клиентом
                if cl_info.[CLOSE_DATE] is not null then
               		if cl_info.[CLOSE_DATE] <= P_DATE_PRINT then
			 			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_info.[CLOSE_DATE]),'нет');
               		end if;
            end if;	
            -- Обоснование степени (уровня) риска
            elsif p_info = 'ОБОСНОВ_РИСКА' then
            	P_DATA := '';
                is_benef:=false; is_country:=false; is_prod:=false; is_vid_op:=false;
 				for(
					select crit(
						crit.[CRIT_DATE_BEGIN]	:date_begin
						,crit.[CRIT_DATE_END]	:date_end
						,crit.[CRITERIA].[NAME] :NAME
						,crit.[ACTIVE_FACTORS] :pArr
						,crit.[CRITERIA].[CODE]:code						
					)
					in ::[MONITORING_CRIT] all
					where crit.[CLIENT] = this
					and (crit.[CRIT_DATE_BEGIN] is null or crit.[CRIT_DATE_BEGIN] <= op_dat)
					and (crit.[CRIT_DATE_END] is null or crit.[CRIT_DATE_END] >= op_dat)
				)
				loop
 				  if    crit.[CODE] like 'PSH_BENEF%'    then is_benef:=true; 	
                  elsif crit.[CODE] like 'PSH_COUNTRY%'  then is_country:=true; 	
                  elsif crit.[CODE] like 'PSH_PROD%'     then is_prod:=true; 	
                  elsif crit.[CODE] like 'PSH_VID_OP%'   then is_vid_op:=true; 	
                  end if;
                  P_DATA := P_DATA||to_char(crit.date_begin, fmt)||' ';
                  if crit.date_end is not null then
                  	P_DATA := P_DATA||'- '||to_char(crit.date_end, fmt)||' ';
                  end if;					
			      P_DATA := P_DATA||crit.[NAME]||NL$;
				--далее ищем факторы клиента по текущему критерию
						for(
								select x(x%Id : Id)
								in		crit.[pArr]
						
						        where x.[DATE_BEGIN]<= op_dat
						     			and nvl(x.[DATE_END], op_dat)	>= op_dat
						     			)
						     loop
								fc := x.Id;
						        rf:= fc.[FACTOR];
								P_DATA := P_DATA||rf.[NAME]||NL$;
						    end loop;
				end loop;
				
				If P_DATA = ' ' or P_DATA is null then
					P_DATA := 'Критерий риска не соответствует ни одному пункту ПВК оценки высокого или среднего уровня риска';
				else
					P_DATA := ltrim(P_DATA, '; ');
				end if;
	            --
--> Отметки банка 08042024 г.
			
			elsif p_info = 'КОНТРАГЕНТ' then	 	--КОНТРАГЕНТ
				P_DATA := '';
				if client_corp%id is not null then
					for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'КОНТРАГЕНТ' loop
						temp_str := nvl(cl_link.[PARTNER].[NAME], '');
						P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
					end loop;						
			 		P_DATA := trim(P_DATA);
		 			P_DATA := substr(P_DATA,1,length(P_DATA)-1);
		 		end if;
			elsif p_info = 'ИНД_ПРЕДПРИН' then	 	--Сведения о инд. предпринимателе
				if client_corp%id is not null then
					-- Гос. рег. номер
					temp_str := nvl(client_corp.[REGISTER].[GOS_REG_NUM_REC], '');	
					P_DATA := rtl.bool_char(temp_str is null, null, 'Гос.рег. номер: '||temp_str||', ');
					--Серия свид-ва
					temp_str := nvl(client_corp.[REGISTER].[SER_SERT], '');	
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Серия свид-ва: '||temp_str||', ');
					--номер свид-ва
					temp_str := nvl(client_corp.[REGISTER].[NUM_SERT], '');
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Номер свид-ва: '||temp_str||', ');
					--дата рег-ии
					temp_str := COALESCE(::[RUNTIME].[VIEWFUN].DAT_STR(client_corp.[REGISTER].[DATE_REG]), ::[RUNTIME].[VIEWFUN].DAT_STR(client_corp.[REGISTER].[DATE_REESTR]));
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Дата регистрации: '||temp_str||', ');
		 			--место рег-ии	 			
	-- 				STULY в населенном пункте хранится район области, а не район населенного пункта, поэтому район населенного пункта можно взять только из реквизита	DISTRICT 			
	--	 			temp_str := nvl(client_org_ref.[REGISTER].[DISTRICT].[NAME], client_org_ref.[REGISTER].[CITY].[AREA].[NAME]);
		 			temp_str := client_corp.[REGISTER].[DISTRICT].[NAME];
		 			temp_str := rtl.bool_char(temp_str is null, '', temp_str||' р-он');

		 			declare
		 				vCity [NAMES_CITY];
		 			begin
			 			vCity 	 := client_corp.[REGISTER].[CITY];
						temp_str := nvl(vCity.[COUNTRY].[VALUE], '')||'  '||
									nvl(vCity.[OKATO].[NAME], '')||'  '||
									nvl(vCity.[KIND].[SHORT_NAME], '')||' '||
									nvl(vCity.[NAME], '')||' '||
									temp_str;			
		 			end;
	--							nvl(client_org_ref.[REGISTER].[DISTRICT].[NAME], client_org_ref.[REGISTER].[CITY].[AREA].[NAME]);
					temp_str := ltrim(rtrim(temp_str));
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Место выдачи: '||temp_str||', ');
					--рег-ий орган
					temp_str := nvl(client_corp.[REGISTER].[REG_BODY].[NAME], '');
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Рег. орган: '||temp_str||', ');
					
					P_DATA := substr(P_DATA,1,length(P_DATA)-2);
				else
					P_DATA :='';
				end if;
				
			elsif p_info = 'ЛИЦЕНЗИИ' then	 	--ЛИЦЕНЗИИ
				if client_corp%id is not null then
					P_DATA := null;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat				
					)
					loop
					P_DATA := P_DATA
							  ||rtl.bool_char(lic.l_type is null, null, 'Вид лицензии: '||lic.l_type||' ')
							  ||rtl.bool_char(lic.l_num is null, null, 'Номер: '||lic.l_num||' ')
							  ||rtl.bool_char(lic.l_date1 is null, null, ' Дата выдачи: '||to_char(lic.l_date1, ShortFmt)||' ')
							  ||rtl.bool_char(lic.l_date2 is null, null, ' Дата окончания: '||to_char(lic.l_date2, ShortFmt)||' ')
							  ||rtl.bool_char(lic.l_who is null, null, ' Выдана: '||lic.l_who||' ')
							  ||rtl.bool_char(lic.l_list is null, null, ' Виды лицензируемой деятельности: '||lic.l_list)
							  ||NL$||NL$;
					end loop;				
					
					P_DATA := trim(P_DATA);
					P_DATA := rtl.bool_char(P_DATA is null, null, substr(P_DATA, 1, length(P_DATA)-4));
				else
			 		P_DATA := '';
				end if;
				
			elsif p_info = 'ДАТА_СЧЕТА1' then	 	--ДАТА_СЧЕТА1
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_info.[FIRST_ACC_DATE]), '');	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
		 			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(account.[DATE_OP]), '');
		 		else
		 		    --P_DATA :='';
		 		    P_DATA :=nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_ANK, op_dat)), ''); -- ВОО
		 		end if;

			elsif p_info = 'НОМЕР_СЧЕТА1' then	 	--НОМЕР_СЧЕТА1
				if account is not null then
					P_DATA := account.[MAIN_V_ID];
		 		else
		 		    P_DATA :='';
		 		end if;
		 		
			elsif p_info = 'НОМЕР_СЧЕТА_ПСЛ' then	 	--Номер последнего открытого счета
				if account is not null then
					P_DATA := v_acc_last.[MAIN_V_ID];
		 		else
		 		    P_DATA :='';
		 		end if;

--/* Расширение анкеты IDA2506
			elsif p_info = 'СОХР_В_ЮЛ' then
				if P_CL_LINK.[CODE] in ('ПРЕДСТАВИТЕЛЬ', 'ВЫГОДОПРИОБРЕТАТЕЛЬ', 'БЕНЕФИЦИАР') and P_LINKS.[PARTNER] is not null then
					P_DATA := P_LINKS.[PARTNER].[NAME] || ' ' || P_LINKS.[PARTNER].[INN];
				end if;
			elsif p_info = 'ЗАГОЛОВОК_ПРЕДСТ' then
				if P_CL_LINK.[CODE] = 'ПРЕДСТАВИТЕЛЬ' and P_LINKS.[PARTNER] is not null then
					P_DATA := P_LINKS.[PARTNER].[NAME] || ' (ИНН ' || nvl(P_LINKS.[PARTNER].[INN], '-') || ')';
				end if;
			elsif p_info = 'ЗАГОЛОВОК_ВЫГОДОПР' then
				if P_CL_LINK.[CODE] = 'ВЫГОДОПРИОБРЕТАТЕЛЬ' and P_LINKS.[PARTNER] is not null then
					P_DATA := P_LINKS.[PARTNER].[NAME] || ' (ИНН ' || nvl(P_LINKS.[PARTNER].[INN], '-') || ')';
				end if;
			elsif p_info = 'ЗАГОЛОВОК_БЕНЕФ' then
				if P_CL_LINK.[CODE] = 'БЕНЕФИЦИАР' and P_LINKS.[PARTNER] is not null then
					P_DATA := P_LINKS.[PARTNER].[NAME] || ' (ИНН ' || nvl(P_LINKS.[PARTNER].[INN], '-') || ')';
				end if;
			--Сведения о представителе Клиента
			elsif p_info = 'ПРЕДСТАВИТЕЛЬ_ФИО' then
				for ( select l(l.[PARTNER].[NAME] : l_name)
					in client_priv.[LINKS_OTHER]
					where (l.[DATE_END] is null or l.[DATE_END] > ::[SYSTEM].[OP_DATE])
					and l.[VID_LINK].[CODE] = 'ПРЕДСТАВИТЕЛЬ'
				)
				loop
					P_DATA := l.l_name;
				end loop;
			elsif p_info = 'ПРЕДСТАВИТЕЛЬ_ДОК' then
				for ( select l(l.[FOUND] : l_found)
					in client_priv.[LINKS_OTHER]
					where (l.[DATE_END] is null or l.[DATE_END] > ::[SYSTEM].[OP_DATE])
					and l.[VID_LINK].[CODE] = 'ПРЕДСТАВИТЕЛЬ'
				)
				loop
					P_DATA := l.l_found;
				end loop;
			elsif p_info = 'ПРЕДСТАВИТЕЛЬ_НАЧ' then
				for ( select l(l.[DATE_BEG] : l_beg)
					in client_priv.[LINKS_OTHER]
					where (l.[DATE_END] is null or l.[DATE_END] > ::[SYSTEM].[OP_DATE])
					and l.[VID_LINK].[CODE] = 'ПРЕДСТАВИТЕЛЬ'
				)
				loop
					P_DATA := to_char(l.l_beg, 'dd/mm/yyyy');
				end loop;
			elsif p_info = 'ПРЕДСТАВИТЕЛЬ_ОКОН' then
				for ( select l(l.[DATE_END] : l_end)
					in client_priv.[LINKS_OTHER]
					where (l.[DATE_END] is null or l.[DATE_END] > ::[SYSTEM].[OP_DATE])
					and l.[VID_LINK].[CODE] = 'ПРЕДСТАВИТЕЛЬ'
				)
				loop
					P_DATA := to_char(l.l_end, 'dd/mm/yyyy');
				end loop;
			--
			elsif p_info = 'CheckBox7' then
				if nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'REGISTRATION'), '') = nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'REAL_LIVE'), '') then
					P_DATA := '1';
				end if;
			elsif p_info = 'CheckBox161' then --CL_EXT_ANK_PRIV_N16
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_PRIV]
 					where x = client_priv%id
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_PRIV_N16'
 				)
 				loop
 					if x.c_value like '%Расчетно-кассовое обслуживание%' then
 						P_DATA := P_DATA || '1'; end if;
 					if x.c_value like '%Депозиты%' then
 						P_DATA := P_DATA || '2'; end if;
 					if x.c_value like '%Внешнеэкономическая деятельность%' then
 						P_DATA := P_DATA || '3'; end if;
 					if x.c_value like '%Прием/выдача наличных денежных средств%' then
 						P_DATA := P_DATA || '4'; end if;
 					if x.c_value like '%Кредитование%' then
 						P_DATA := P_DATA || '5'; end if;
 					if x.c_value like '%Овердрафт%' then
 						P_DATA := P_DATA || '6'; end if;
 					if x.c_value like '%Зарплатные проекты%' then
 						P_DATA := P_DATA || '7'; end if;
 					if x.c_value like '%Операции с ценными бумагами, с векселями%' then
 						P_DATA := P_DATA || '8'; end if;
				end loop;
			elsif p_info = 'ДРУГОЕ16' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_PRIV]
 					where x = client_priv%id
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_PRIV_N16'
 				)
				loop
					if x.c_value not like '%Расчетно-кассовое обслуживание%' 
					and x.c_value not like '%Депозиты%'
					and x.c_value not like '%Внешнеэкономическая деятельность%'
					and x.c_value not like '%Прием/выдача наличных денежных средств%'
					and x.c_value not like '%Кредитование%'
					and x.c_value not like '%Овердрафт%'
					and x.c_value not like '%Зарплатные проекты%'
					and x.c_value not like '%Операции с ценными бумагами, с векселями%'
					then
 						P_DATA := x.c_value;
					end if;
 				end loop;
 			elsif p_info = 'CheckBox181' then --CL_EXT_ANK_PRIV_N18
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_PRIV]
 					where x = client_priv%id
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_PRIV_N18'
 				)
 				loop
 					if x.c_value like '%Стабильное%' then
 						P_DATA := '1';
 					elsif x.c_value like '%Условно стабильное%' then
 						P_DATA := '2';
 					elsif x.c_value like '%Не стабильное%' then
 						P_DATA := '3';
 					end if;
				end loop;
			elsif p_info = 'ДРУГОЕ18' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_PRIV]
 					where x = client_priv%id
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_PRIV_N18'
 				)
				loop
					if x.c_value not like '%Стабильное%' 
					and x.c_value not like '%Условно стабильное%'
					and x.c_value not like '%Не стабильное%'
					then
 						P_DATA := x.c_value;
					end if;
 				end loop;
 			elsif p_info = 'CheckBox191' then --CL_EXT_ANK_PRIV_N19
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_PRIV]
 					where x = client_priv%id
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_PRIV_N19'
 				)
 				loop
 					if x.c_value like '%Положительная%' then
 						P_DATA := '1';
 					elsif x.c_value like '%Отрицательная%' then
 						P_DATA := '2';
 					end if;
				end loop;
			elsif p_info = 'ДРУГОЕ19' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_PRIV]
 					where x = client_priv%id
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_PRIV_N19'
 				)
				loop
					if x.c_value not like '%Положительная%' 
					and x.c_value not like '%Отрицательная%'
					then
 						P_DATA := x.c_value;
					end if;
 				end loop;
 			elsif p_info = 'CheckBox201' then --CL_EXT_ANK_PRIV_N20
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_PRIV]
 					where x = client_priv%id
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_PRIV_N20'
 				)
 				loop
 					if x.c_value like '%Заработная плата%' then
 						P_DATA := P_DATA || '1'; end if;
 					if x.c_value like '%Процентный доход по вкладам%' then
 						P_DATA := P_DATA || '2'; end if;
 					if x.c_value like '%Наследство%' then
 						P_DATA := P_DATA || '3'; end if;
 					if x.c_value like '%Доходы от предпринимательской деятельности%' then
 						P_DATA := P_DATA || '4'; end if;
 					if x.c_value like '%Пенсия%' then
 						P_DATA := P_DATA || '5'; end if;
 					if x.c_value like '%Накопления%' then
 						P_DATA := P_DATA || '6'; end if;
 					if x.c_value like '%Доходы от продажи имущества%' then
 						P_DATA := P_DATA || '7'; end if;
 					if x.c_value like '%Дивиденды, страховое возмещение%' then
 						P_DATA := P_DATA || '8'; end if;
				end loop;
			elsif p_info = 'ДРУГОЕ20' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_PRIV]
 					where x = client_priv%id
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_PRIV_N20'
 				)
				loop
					if x.c_value not like '%Заработная плата%' 
					and x.c_value not like '%Процентный доход по вкладам%'
					and x.c_value not like '%Наследство%'
					and x.c_value not like '%Доходы от предпринимательской деятельности%'
					and x.c_value not like '%Пенсия%'
					and x.c_value not like '%Накопления%'
					and x.c_value not like '%Доходы от продажи имущества%'
					and x.c_value not like '%Дивиденды, страховое возмещение%'
					then
 						P_DATA := x.c_value;
					end if;
 				end loop;
			elsif p_info = 'ВОО' then
				if stdlib.userid.[CASTA].[CODE] in ('PSB_73', 'PSH_58', 'IBS') then
					P_DATA := 1;
				else
					P_DATA := 0;
				end if;
			elsif p_info = 'ПЕРЕЧЕНЬ_КОНТР_ДАТ' then
				P_DATA := to_char(cl_info.[FIRST_ACC_DATE], 'dd/mm/yyyy');
				for (select x(x.[CTRL_DATE] : ctrl_date)
					in ::[PSH_LEGAL_DATES]
					where x.[CTRL_DATE] > cl_info.[FIRST_ACC_DATE] and x.[CTRL_DATE] <= nvl(cl_info.[CLOSE_DATE], ::[SYSTEM].[OP_DATE])
					order by x.[CTRL_DATE] asc
				)
				loop
					P_DATA := P_DATA || ', ' || to_char(x.ctrl_date, 'dd/mm/yyyy');
				end loop;
--*/ Расширение анкеты IDA2506
--/* Расширение анкеты CRS IDA2603
			elsif p_info = 'ЛАТ_НАИМ_КЛИЕНТА' then
				P_DATA := nvl(client_priv.[I_NAME], '');
			elsif p_info = 'ИН_ДАТА_И_МЕСТО_РОЖД' then
				P_DATA := nvl(to_char(client_priv.[DATE_PERS], 'dd.mm.yyyy'), '');
				if client_priv.[DOC].[TYPE].[KOD] = '10' then
					P_DATA := P_DATA || ', ' || client_priv.[DOC].[BIRTH_PLACE];
				end if;
			elsif p_info = 'ИН_НОМЕР_ДОК' then
				if client_priv.[DOC].[TYPE].[KOD] = '10' then
					P_DATA := client_priv.[DOC].[NUM];
				end if;
			elsif p_info = 'ИН_ТИП_ДОК' then
				if client_priv.[DOC].[TYPE].[KOD] = '10' then
					P_DATA := client_priv.[DOC].[TYPE].[FULL_NAME];
				end if;
			elsif p_info like 'ИН_СТРАНА_ДОК%' then
				P_DATA := client_priv.[COUNTRY].[VALUE];
			elsif p_info = 'CheckBox_CRS_addr1' then
				if GetAddress(client_priv.[ADDRESSES],'ALL', 'REGISTRATION') = GetAddress(client_priv.[ADDRESSES],'ALL', 'SWIFT_ADDRESS') then
					P_DATA := '1';
				end if;
			elsif p_info = 'CheckBox_CRS_addr2' then
				if GetAddress(client_priv.[ADDRESSES],'ALL', 'REAL_LIVE') = GetAddress(client_priv.[ADDRESSES],'ALL', 'SWIFT_ADDRESS') then
					P_DATA := '1';
				end if;
			elsif p_info = 'CheckBox_CRS80X' then
				debug_pipe('CheckBox_CRS80X' || P_CL_LINK.[CODE], 0);
				P_DATA := P_CL_LINK.[CODE];
			elsif p_info = 'CRS_TIN' then
				P_DATA := null;
				for (select x(x.[STR] : val)
					in client_priv.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CRS_TIN'
				)
				loop
					P_DATA := x.val;
				end loop;
				if P_DATA is null then
					for (select x(x.[CL_DOC].[DOC_VALUE] : val)
						in ::[FATCA_INFO_REQ]
						where x.[CLIENT] = client_priv%id
					)
					loop
						P_DATA := x.val;
					end loop;
				end if;

--*/ Расширение анкеты CRS IDA2603

--		'ДАТА_ЗАКРЫТИЯ':
			elsif p_info = 'ДАТА_ЗАКРЫТИЯ' then	 	--ДАТА_ЗАКРЫТИЯ
				
				declare
					v_date date;
				begin
					v_date := get_date_close(cl_info, bool_char(client_corp%id is not null, client_corp%id, client_priv%id), P_DATE_PRINT);
				
					if v_date is not null then
						P_DATA:= ::[RUNTIME].[VIEWFUN].DAT_STR(v_date);
					end if;
				end;

			elsif p_info = 'СОТР_ОТКР' then	 	--СОТР_ОТКР
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_info_user('ACC_OPEN_USER', cl_info.[CL_WORK_USERS], P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[USER_OP];
						if (account is not null) and (u is not null) then
							P_DATA := nvl(u.[NAME], '') || ', ' || u.[CASTA].[VALUE];
						else
							P_DATA :='';
						end if;
					end;
				end if;

			elsif p_info = 'СОТР_ОТКР_ПОСЛ' then
				if v_acc_last is not null then
					declare u ref [USER];
					begin
						u := v_acc_last.[USER_OP];
						if u is not null then
							P_DATA := nvl(u.[NAME], '') || ', ' || u.[CASTA].[VALUE];
						else
							P_DATA :='';
						end if;
					end;
				end if;

			elsif p_info = 'СОТР_ОТВ_ПОСЛ' then
				if v_acc_last is not null then
					declare u ref [USER];
					begin
						u := v_acc_last.[OTV];
						if u is not null then
							P_DATA := nvl(u.[NAME], '') || ', ' || u.[CASTA].[VALUE];
						else
							P_DATA:=' ';		
						end if;
					end;
				else
								for(
										select a(	a.[USER_NAME]	: USER_NAME,
													a.[USER_CASTA]	: USER_CASTA
												)
										in		::[CL_HIST] all
										where	a.[CLIENT_REF]	= this
												and a.[QUAL]	= 'DATE_ANK'
										order by a.[DATE_EDIT] desc
									)loop
										temp_str:= a.[USER_NAME]|| bool_char(a.USER_CASTA is not null, ', '||a.USER_CASTA, ''); --ВОО
										exit;
									end loop;
									P_DATA:=temp_str;	
				end if;

			elsif p_info = 'СОТР_ОТКР_ПОДР' then
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_depart('ACC_OPEN_USER', cl_info.[CL_WORK_USERS], P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[USER_OP];
						if (account is not null) and (u is not null) then
							P_DATA := ::[DEPART].[LIB].get_declension(u.[DEPART]);
						else
							P_DATA :='';
						end if;
					end;
				end if;	
			elsif p_info = 'СОТР_УТВ' then	 	--СОТР_УТВ
				P_DATA := get_cl_info_user('ACC_CONFIRM', cl_info.[CL_WORK_USERS], P_DATE_PRINT);
			elsif p_info = 'СОТР_УТВ_ПОДР' then
				P_DATA := get_cl_depart('ACC_CONFIRM', cl_info.[CL_WORK_USERS], P_DATE_PRINT);
				
			elsif p_info = 'СОТР_ОТВ' then	 	--СОТР_ОТВ
				if cl_info.[FIRST_ACC_DATE] is not null and account is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_info_user('ACC_MANAGER', cl_info.[CL_WORK_USERS],  P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[OTV];
						--debug_pipe('Сююююда дошли!',0);
						if (account is not null) and (u is not null) then
							P_DATA := nvl(u.[NAME], '') || ', ' || u.[CASTA].[VALUE];
						else
							P_DATA:=' ';		
						end if;
					end;
				else
					for(
										select a(	a.[USER_NAME]	: USER_NAME,
													a.[USER_CASTA]	: USER_CASTA
												)
										in		::[CL_HIST] all
										where	a.[CLIENT_REF]	= this
												and a.[QUAL]	= 'DATE_ANK'
										order by a.[DATE_EDIT] desc
									)loop
										 temp_str:= a.[USER_NAME]|| bool_char(a.USER_CASTA is not null, ', '||a.USER_CASTA, ''); --ВОО
										exit;
									end loop;
							P_DATA:=temp_str;	
				end if;		 	
			elsif p_info = 'СОТР_ОТВ_ПОДР' then	 	--СОТР_ОТВ
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_depart('ACC_MANAGER', cl_info.[CL_WORK_USERS],  P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[OTV];
						if (account is not null) and (u is not null) then
							P_DATA := ::[DEPART].[LIB].get_declension(u.[DEPART]);
						else
							P_DATA :='';
						end if;
					end;
				end if;
			elsif p_info = 'ПРАВЛЕНИЕ_ФИО' then
				if cl_info.[FIRST_ACC_DATE] is not null then
					P_DATA := ::[CLIENT].[PSH_LIB_1].head_master_fio(cl_info.[FIRST_ACC_DATE]);
				end if;
			elsif p_info = 'ПРАВЛЕНИЕ_ДОЛЖ' then
				if cl_info.[FIRST_ACC_DATE] is not null then
					P_DATA := ::[CLIENT].[PSH_LIB_1].head_master_casta(cl_info.[FIRST_ACC_DATE]);
				end if;
			elsif p_info = 'УТВЕРДИЛ_ФИО' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(client_priv%id);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_CONFIRM', cl_info, p_name, p_casta);
					P_DATA := p_name;
				end;
			elsif p_info = 'УТВЕРДИЛ_ДОЛЖ' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(client_priv%id);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_CONFIRM', cl_info, p_name, p_casta);
					P_DATA := p_casta;
				end;
			elsif p_info = 'ОБН_ЗАПОЛН_ПОЛН' then	 	--ЗАПОЛНИЛ ФИО полностью
				P_DATA := null;
				for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
							where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_FORM_UPD'
								order by a.[DATE_EDIT] desc )
				loop
					P_DATA := a.[USER_NAME];
					exit;
				end loop;
				if P_DATA is null then
					for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
								where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_ANK'
									order by a.[DATE_EDIT] desc )
					loop
						P_DATA := a.[USER_NAME];
						exit;
					end loop;
				end if;
			elsif p_info = 'ОБН_ЗАПОЛН_ДОЛЖ' then
				P_DATA := null;
				for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
							where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_FORM_UPD'
								order by a.[DATE_EDIT] desc )
				loop
					P_DATA := a.[USER_CASTA];
					exit;
				end loop;
				if P_DATA is null then
					for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
							where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_ANK'
								order by a.[DATE_EDIT] desc )
					loop
						P_DATA := a.[USER_CASTA];
						exit;
					end loop;
				end if;			
			elsif p_info = 'СФОРМИРОВАЛ' then	 	--СФОРМИРОВАЛ
				P_DATA := nvl(::[RUNTIME].[STDLIB].fio(stdlib.userid.[NAME], 'Ф И. О.'), '');
			elsif p_info = 'СФОРМИРОВАЛ_ПОЛН' then	 	--СФОРМИРОВАЛ ФИО полностью
				P_DATA := nvl(::[RUNTIME].[STDLIB].fio(stdlib.userid.[NAME], 'Ф И О'), '');
			elsif p_info = 'СФОРМИРОВАЛ_ДОЛЖ' then
				P_DATA := nvl(stdlib.userid.[CASTA].[VALUE], '');	
			elsif p_info = 'СФОРМИРОВАЛ_ПОДР' then
				P_DATA := nvl(::[DEPART].[LIB].get_declension(::[SYSTEM].[VARIABLES].OurDepart), '');		
		 		
			elsif p_info = 'РУК_ПОДР' then	 	--РУК_ПОДР
				if P_HEADUSER_STR  is not null then
					P_DATA := P_HEADUSER_STR;
		 		else
		 		    P_DATA :='';
		 		end if;
		 		
			elsif p_info = 'ДАТА_АНКЕТЫ' then
				P_DATA :=to_char(P_DATE_PRINT, 'DD.MM.YYYY');
		 		
		 	elsif p_info = 'ВЫГОДОПРИОБРЕТАТЕЛЬ' then

		 		P_DATA := null; --but
		 		if client_corp%id is null then
		 			v_cl_links := client_priv.[LINKS_OTHER];
		 		else
		 			v_cl_links := client_corp.[LINKS_OTHER];
		 		end if;	
		 		
		 		for(select l(l.[PARTNER]->(false)[NAME] : partner_name)
					in v_cl_links
					where l.[VID_LINK].[CODE] = 'ВЫГОДОПРИОБРЕТАТЕЛЬ')
				loop
					temp_str := nvl(l.partner_name, '');
					P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
				end loop;
				
				if P_DATA is null then
					P_DATA := 'Нет';
				ELSE P_DATA := 'да, предоставляются сведения о выгодоприобретателе (Анкета)';
				end if;

		 	elsif p_info = 'ВЫГОДОДАТЕЛЬ' then
		 		P_DATA := null;
		 		if client_corp%id is null then
		 			links_ref := client_priv.[LINKS_OTHER];
		 		else
		 			links_ref := client_corp.[LINKS_OTHER];
		 		end if;	
		 		
		 		for(select cl_link(cl_link.[PARTNER]->(false)[NAME] : partner_name,
                             cl_link.[PARTNER] : partner)
					in ::[LINKS_CL] all
					where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ'
                    		and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)					
					
				loop
					var rTmpCl ref [CL_PRIV];
					temp_str := nvl(cl_link.partner_name, '');
					P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
					declare
   					acc	ref [AC_FIN];

					begin
     				    rTmpCl:=cl_link.[PARTNER];
                        locate acc in ::[AC_FIN] where acc.[CLIENT_V] = rTmpCl;
                        if acc.[MAIN_V_ID] is not null then
	                        P_DATA := P_DATA || ' счет '||acc.[MAIN_V_ID];
                        end if;
					exception
						when NO_DATA_FOUND then null;
					end;
		 		end loop;

				
				if P_DATA is null then
					P_DATA := 'Нет';
				end if;
/*				
				P_DATA := rtrim(P_DATA,' ,');
				P_DATA := P_DATA || NL$ || 'Выгододатели: ';
				for(
					select l(l.[PARTNER]->(false)[NAME] : partner_name)
					in v_cl_links
					where l.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ')
				loop
					temp_str := nvl(l.partner_name, '');
					P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
				end loop;
				P_DATA := rtrim(P_DATA,' ,');
*/				
			elsif	p_info = 'ПОДРАЗДЕЛЕНИЕ' then
				if P_DEPART_STR is not null then
					P_DATA := P_DEPART_STR;
				else
					P_DATA := '           ';
				end if;
	
			elsif p_info = 'ОСНОВАНИЕ' then
				P_DATA := '';
				links_ref := NULL;
				if (client_corp%id is not null) then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];				
				end if;
				
				if (links_ref is not null) then
					for cl_link
						in ::[LINKS_CL] ALL
						where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОПРИОБРЕТАТЕЛЬ'
								and cl_link%collection = links_ref
						order by cl_link.[DATE_BEG]
					loop
						if (cl_link.[FOUND] is not null)
							and (cl_link.[DATE_BEG]<=P_DATE_PRINT or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END]>=P_DATE_PRINT or cl_link.[DATE_END] is null) then
							P_DATA := rtl.bool_char(P_DATA is not null, P_DATA || NL$, '') || cl_link.[FOUND];
						end if;			
					end loop;			 					
				end if;
				
				if P_DATA is null then
--but				P_DATA := 'нет сведений';
					P_DATA := 'Нет';
				end if;
				
	
			elsif p_info = 'ДАТА_ЗАПОЛН_ВЫГ' then	
				P_DATA := '';
				links_ref := NULL;
				if (client_corp%id is not null) then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];				
				end if;
				
				if (links_ref is not null) then
					for cl_link in ::[LINKS_CL] ALL
							 where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ'
							   and cl_link%collection = links_ref
					      order by cl_link.[DATE_BEG]
					loop
						if (cl_link.[DATE_BEG] is not null) then
							P_DATA := ::[RUNTIME].[VIEWFUN].DAT_STR(cl_link.[DATE_BEG]);
							exit;
						end if;			
					end loop;			 					
				end if;	
			elsif p_info in ('ВЫГОДОДАТ_С_ОСН', 'ВЫГОДОПРИ_С_ОСН') then
				if (client_corp%id is not null) then
					V_CL_LINKS := client_corp.[LINKS_OTHER];
				else
					V_CL_LINKS := client_priv.[LINKS_OTHER];				
				end if;
				
				if p_info = 'ВЫГОДОДАТ_С_ОСН' then
					P_DATA := fill_benefit(P_DATE_PRINT, V_CL_LINKS, ::[CL_LINK]([CODE]='ВЫГОДОДАТЕЛЬ'), true, true);
				elsif p_info = 'ВЫГОДОПРИ_С_ОСН' then
					P_DATA := fill_benefit(P_DATE_PRINT, V_CL_LINKS, ::[CL_LINK]([CODE]='ВЫГОДОПРИОБРЕТАТЕЛЬ'), true, true);
				end if;
			elsif p_info = 'КОДЫ_ОКВЭД' and client_corp%id is not null then
				declare
					okv [OKVED];
					date_ank date;
				begin
					date_ank := nvl(P_DATE_ANK, op_dat);
					okv := ::[LEGAL_INTERFACE].[PRX_CLIENT].Get_Main_OKVED(client_corp%id, date_ank);
					P_DATA := 'Основной: ' || okv.[CODE] || ' ' || okv.[NAME] || NL$ || 'Допустимые: ';
					
					for (
						select o(
							o.[OKVED].[CODE] : CODE,
							o.[OKVED].[NAME] : NAME
						)
						in client_corp.[OKVED_IN_PERIOD]
						where nvl(o.[MAIN], false) = false
							and (o.[DATE_BEGIN] <= date_ank or o.[DATE_BEGIN] is null)
							and (o.[DATE_END] >= date_ank or o.[DATE_END] is null)
					)loop
						P_DATA := P_DATA || o.[CODE] || ' ' || o.[NAME] || NL$;
					end loop;
				end;
			
			elsif p_info = 'ПРИНЦИПАЛ' then   --ПРИНЦИПАЛ BS00299498
				for i in principal.first..principal.last
				loop
					P_DATA := P_DATA || ', ' || principal(i);					
				end loop;	
				P_DATA := nvl(rtrim(ltrim(P_DATA, ', '), ', '), '');	
			
	 		elsif p_info = 'ОБОСН_РИСКА' then
                is_benef:=false; is_country:=false; is_prod:=false; is_vid_op:=false;
 				for(
					select crit(
						crit.[CRITERIA].[NAME] :NAME
					    ,crit.[ACTIVE_FACTORS] :pArr
						,crit.[CRITERIA].[CODE]:code
					)
					in ::[MONITORING_CRIT] all
					where (crit.[CLIENT] = client_org_ref or ( crit.[client] = this and client_org_ref is null))
						and (crit.[CRIT_DATE_BEGIN] is null or crit.[CRIT_DATE_BEGIN] <= op_dat)
						and (crit.[CRIT_DATE_END] is null or crit.[CRIT_DATE_END] >= op_dat)
				)loop
					P_DATA := P_DATA||crit.[NAME]||NL$;
 				  if    crit.[CODE] like 'PSH_BENEF%'    then is_benef:=true; 	
                  elsif crit.[CODE] like 'PSH_COUNTRY%'  then is_country:=true; 	
                  elsif crit.[CODE] like 'PSH_PROD%'     then is_prod:=true; 	
                  elsif crit.[CODE] like 'PSH_VID_OP%'   then is_vid_op:=true; 	
                  end if;						
--далее ищем факторы клиента по текущему критерию
for(
		select x(x%Id : Id)
		in		crit.[pArr]

        where x.[DATE_BEGIN]<= op_dat
     			and nvl(x.[DATE_END], op_dat)	>= op_dat
     			)
     loop
		fc := x.Id;
        rf:= fc.[FACTOR];
		P_DATA := P_DATA||rf.[NAME]||NL$;
    end loop;
				end loop;
				
                  if not is_benef   then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск по типу клиента и (или) бенефициарного владельца;'||NL$; end if;
                  if not is_country then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Страновой риск;'||NL$; end if;
                  if not is_prod    then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск продукта;'||NL$; end if;
                  if not is_vid_op  then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск, связанный с проведением клиентом определенного вида операций;'||NL$; end if;
				
-- Кокорин АС 03.09.14 для печати обоснования оценки рика из реквизита "Оценка риска легализации"				
			--	P_DATA := ltrim(P_DATA, '; ');
				If P_DATA = ' ' or P_DATA is null then
					P_DATA := 'Критерий риска не соответствует ни одному пункту ПВК оценки высокого или среднего уровня риска';
				else
				--	P_DATA := this.[FAIL_MARK];
					P_DATA := ltrim(P_DATA, '; ');
				end if;
--------------------------------------------------------------------------------------------------				
			elsif p_info = 'OPER_CHARACTER' then
				P_DATA := client_priv.[OPER_CHARACTER];

	 		elsif p_info = 'ВНОСИТЕЛЬ' then
	 			declare
	 				m_card string(100)	:= null;
	 			begin
	 				for(
						select links(
							links.[PARTNER] 			:PARTNER,
							decode(links.[PARTNER]->([CL_PRIV])[BORN],
										null,
										links.[PARTNER]->([CL_PRIV])[DOC].[BIRTH_PLACE],
										links.[PARTNER]->([CL_PRIV])[BORN].[NAME]
									)	:B_PLACE
						)
						in [LINKS_OTHER]
						where links.[VID_LINK].[CODE] = 'ВНОСИТЕЛЬ'
						and links.[PARTNER]%class = 'CL_PRIV'
					)
					loop
						m_card := migr_card_str(links.[PARTNER]);
						if m_card is not null then
							m_card := 'Миграционная карта № '||m_card||LF$;
						end if;
						P_DATA := P_DATA||::[LEGAL_INTERFACE].[PRX_FP].stock_lib_client_get_reqvs(
												links.[PARTNER],
												'{[_ИМЯ];'||LF$||'}'||
												'{[ДАТАРОЖД]; }'||links.[B_PLACE]||LF$||
												'{[_ГРАЖДАНСТВО];'||LF$||'}'||
												'{[адрес_ю];'||LF$||'}'||
												'{[документ];'||LF$||'}'||
												m_card||
												'{[ИНН];'||LF$||'}'||
												'{[тел.]}{/[факс]}'||' '||GetContacts(links.[PARTNER].[CONTACTS], 'MAIL')
											)||NL$;
					end loop;
	 			end;

			elsif p_info = 'ВИД_ДЕЯТЕЛЬНОСТИ' then --BS00478024
				declare
					cl ref [CL_ORG];
				begin
					locate cl in ::[CL_ORG] where cl%id = client_corp%id;
					P_DATA := trim(cl.[BUSINESS]);
				exception
					when NO_DATA_FOUND then null;
				end;

	 		elsif p_info like 'КТО_БЕНЕФИЦИАР%' then
				P_DATA := 'Бенефициарным владельцем клиента  является:'||CHR(13)||'Предоставляются сведения о бенефициаром владельце (Анкета)'; --null;

				/*	select cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name
							)
						in client_priv.[LINKS_OTHER]
						where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
                         into link_ben;
				if link_ben.count = 0 then
                   P_DATA:= 'Бенефициарным владельцем клиента - физического лица является это лицо';
                else
                   P_DATA:= 'Бенефициарным владельцем клиента  является иное лицо. Предоставляются сведения о бенефициаром владельце (Анкета)';
                end if;*/			

	 		elsif p_info = 'БЕНЕФИЦИАР' then
				P_DATA := null;
				if client_corp%id is not null then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];
				end if;
				for
					(select cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name,
							         cl_link.[PARTNER]	: partner
							)
						in ::[LINKS_CL] all
						where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
							and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)
				loop
					var sTempStr	varchar2(1024);
					var rTempCl		ref [CL_PRIV];
					var	sAddr		varchar2(1024);
					sTempStr := cl_link.partner_name;
					if cl_link.[PARTNER] is not null and cl_link.[PARTNER]%class='CL_PRIV' then
						rTempCl := cl_link.[PARTNER];
						sAddr := GetAddress(rTempCl.[ADDRESSES],'ALL', 'REGISTRATION');
						sTempStr := sTempStr || ', ' ||
								Get_passport(rTempCl) || ', ' ||
								'Адрес: ' || bool_char(sAddr is not null, sAddr, 'отсутствует') || ', ' ||
								'Дата рожд: '|| bool_char(rTempCl.[DATE_PERS] is not null, to_char(rTempCl.[DATE_PERS], ShortFmt), 'отсутствует' ) || ', ' ||
								'Место рожд: '|| bool_char(nvl(rTempCl.[BORN].[NAME], rTempCl.[DOC].[BIRTH_PLACE]) is not null, nvl(rTempCl.[BORN].[NAME], rTempCl.[DOC].[BIRTH_PLACE]), 'отсутствует');
					end if;
					if p_data is null then
						P_DATA := sTempStr;
					else
						P_DATA := P_DATA || NL$ || sTempStr;
					end if;
				end loop;
				P_DATA := ltrim(P_DATA,', ');
--but
--if P_DATA is null then	P_DATA:= 'отсутствует'; end if;

if P_DATA is null then
rTempCl := this;
						sAddr := GetAddress(rTempCl.[ADDRESSES],'ALL', 'REGISTRATION');
						-- Vorobey 2019.05.31 - Добавил строку в начале, про бенефициара, по просьбе сотрудника Карзанова Екатерина.
						sTempStr :='Бенефициарным владельцем клиента - физического лица является это лицо: '||nvl(this.[NAME], '')|| ', '||
								'гражданство: '||COALESCE(this.[COUNTRY].[NAME],'Лицо без гражданства')|| ', ' ||
								Get_passport(rTempCl) || ', ' ||
								'адрес: ' || bool_char(sAddr is not null, sAddr, 'отсутствует') || ', ' ||
								'дата рожд: '|| bool_char(rTempCl.[DATE_PERS] is not null, to_char(rTempCl.[DATE_PERS], ShortFmt), 'отсутствует' ) || ', ' ||
								'место рожд: '|| bool_char(nvl(rTempCl.[BORN].[NAME], rTempCl.[DOC].[BIRTH_PLACE]) is not null, nvl(rTempCl.[BORN].[NAME], rTempCl.[DOC].[BIRTH_PLACE]), 'отсутствует') || ', ' ||
								'ИНН: '||nvl(this.[INN],' нет');
								
P_DATA := sTempStr;
end if;

--	 		
	 		
	 		elsif p_info = 'ПРЕДСТАВИТЕЛЬ' then
				P_DATA := null;
				-- Кокорин АС 01.03.17 Сначала тянем из должностных лиц по просьбе Елемешиной
				for	(select distinct boss	(cli_corp.[NAME] : c_parent_name,
													boss.[NOTES] : c_notes,
													--to_char(boss.[WORK_END], ShortFmt): c_d_end)
													decode(boss.[WORK_END], null, ', бессрочно', ', действ. до '||to_char(boss.[WORK_END], ShortFmt)): c_d_end)
						in ::[PERSONS_POS], ( ::[CL_CORP] cli_corp) all
						where boss.[FASE] = client_priv%id
							and boss%collection = cli_corp.[ALL_BOSS]
							and (boss.[WORK_BEGIN] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or boss.[WORK_BEGIN] is null)
							and (boss.[WORK_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or boss.[WORK_END] is null)
					)
				loop
					if p_data is null then
						P_DATA := boss.c_parent_name||' '||boss.c_notes||boss.c_d_end;		
					else
						P_DATA := P_DATA || NL$ || boss.c_parent_name||' '||boss.c_notes||boss.c_d_end;		
					end if;				
				end loop;
								
				if client_corp%id is not null then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];
				end if;
	
				for
					-- Кокорин АС 01.03.17 Добавл основание и срок действия по просьбе Елемешиной				
					--(select distinct cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name)
					(select distinct cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name,
													cl_link.[FOUND] : c_found,
													decode(cl_link.[DATE_END], null, ', бессрочно', ', действ. до '||to_char(cl_link.[DATE_END], ShortFmt)): c_d_end)
						in ::[LINKS_CL] all
						where cl_link.[VID_LINK].[CODE] = 'ПРЕДСТАВИТЕЛЬ'
							and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)
				loop
					if p_data is null then
						P_DATA := cl_link.partner_name||' '||cl_link.c_found||cl_link.c_d_end;	
					else
						P_DATA := P_DATA || NL$ || cl_link.partner_name||' '||cl_link.c_found||cl_link.c_d_end;	
					end if;
				end loop;

				-- Клиент представляет другого клиента по доверености
				for(
			 		 select x(x.[ini_client].[name]		: client_name,
			 		 		  x.[document_uno]			: document_num,
			 		 		  x.[begin_date]			: begin_date,
			 		 		  x.[END_DATE]				: end_date
			 		 		)
						in ::[TRUST_FOR_PROD] all
						where this =x.[TRUST_CLIENT] --x.[ini_client]	
							and (x.[begin_date] is null or x.[begin_date]<= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat))
							and (x.[end_date] is null or coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat)<=x.[end_date])
				)loop
					if P_DATA is null then
						P_DATA := x.[client_name] || ' - Дов. № ' || trim(x.[document_num]) || ' от '||to_char(x.[begin_date], ShortFmt)|| ' действует до '||to_char(x.end_date, ShortFmt);
					else
						P_DATA := P_DATA || NL$ || x.client_name || ' Дов. № ' || trim(x.document_num) || ' от '||to_char(x.begin_date, ShortFmt)|| ' действует до '||to_char(x.end_date, ShortFmt);
					end if;
				end loop;

				P_DATA := ltrim(P_DATA,', ');

					if P_DATA is null then
--but				P_DATA := 'нет сведений';
					P_DATA := 'Нет';
				end if;

	 		elsif p_info = 'ПРЕДСТ_КЛИЕНТА' then
				P_DATA := null;
				-- Сначала тянем из должностных лиц по просьбе Елемешиной
				for	(select distinct boss	(cli_corp.[NAME] : c_parent_name,
													cli_corp.[INN] : c_parent_inn,
													boss.[NOTES] : c_notes,
													decode(boss.[WORK_END], null, ', бессрочно', ', действ. до '||to_char(boss.[WORK_END], ShortFmt)): c_d_end)
						in ::[PERSONS_POS], ( ::[CL_CORP] cli_corp) all
						where boss.[FASE] = client_priv%id
							and boss%collection = cli_corp.[ALL_BOSS]
							and (boss.[WORK_BEGIN] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or boss.[WORK_BEGIN] is null)
							and (boss.[WORK_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or boss.[WORK_END] is null)
					)
				loop
					if p_data is null then
						P_DATA := boss.c_parent_name||' ИНН '||boss.c_parent_inn;		
					else
						P_DATA := P_DATA || ', ИНН ' || boss.c_parent_name||' '||boss.c_parent_inn	;		
					end if;				
				end loop;
								
				if client_corp%id is not null then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];
				end if;
	
				for
					-- Добавл основание и срок действия по просьбе Елемешиной				
					(select distinct cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name,
													trim(cl_link.[PARTNER]->(true)[INN]) : partner_inn,
													cl_link.[FOUND] : c_found,
													decode(cl_link.[DATE_END], null, ', бессрочно', ', действ. до '||to_char(cl_link.[DATE_END], ShortFmt)): c_d_end)
						in ::[LINKS_CL] all
						where cl_link.[VID_LINK].[CODE] = 'ПРЕДСТАВИТЕЛЬ'
							and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)
				loop
					if p_data is null then
						P_DATA := cl_link.partner_name||' ИНН '||cl_link.partner_inn;		
					else
						P_DATA := P_DATA || ', ИНН ' || cl_link.partner_name||' '||cl_link.partner_inn	;		
					end if;	
				end loop;

				
				P_DATA := ltrim(P_DATA,', ');

				if P_DATA is null then
					P_DATA := 'Нет';
				end if;


	 		elsif p_info = 'НАЛОГОВЫЙ_СТАТУС2023' then
	 		--Сведения о налоговом статусе
                if client_priv.[NU_REZIDENT] = false then
		 			P_DATA := 'ДА';
		 			--if client_priv.[COUNTRY].[NAME] is not null then
					--    P_DATA :=P_DATA||client_priv.[COUNTRY].[NAME];
					--end if;		 			
                else
					P_DATA := 'НЕТ';
                end if;				

	 		elsif p_info = 'НАЛОГОВЫЙ_СТАТУС' then
	 		--Сведения о налоговом статусе
                if client_priv.[NU_REZIDENT] then
		 			P_DATA := 'являюсь налоговым резидентом только РФ';
                else
		 			P_DATA := 'являюсь налоговым резидентом иностранного государства ';
		 			if client_priv.[COUNTRY].[NAME] is not null then
					    P_DATA :=P_DATA||client_priv.[COUNTRY].[NAME];
					end if;
                end if;	

	 		elsif p_info = 'ГРАЖД_США' then
