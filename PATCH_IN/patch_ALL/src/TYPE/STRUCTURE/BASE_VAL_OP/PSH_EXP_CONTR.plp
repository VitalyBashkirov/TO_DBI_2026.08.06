--
---- Функция формирует таблицу с полями для файла с типом p_file
--public function GetFields(p_file ::[PSB_BASE_VAL_EXP].[TYPE_FILE]%type) return FieldTblType is
--tbl FieldTblType;
--begin
--	select t(	  t.[NUM]			: num
--				, t.[CODE]			: code
--				, t.[NAME]			: name
--				, t.[REQUIED]		: requied
