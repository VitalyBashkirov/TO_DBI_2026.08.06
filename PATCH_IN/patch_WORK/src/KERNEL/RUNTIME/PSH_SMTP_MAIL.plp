class RUNTIME;

@import_plsql(true)
@name('[ПСБ] RIP_23.1 Библиотека для отправки E-mail через SMTP')
method PSH_SMTP_MAIL is
public tuneHost		const ::[SYSTEM_PARAMS].[CODE]%type := 'SMTP_HOST'
/* Код системного параметра (справочник "Системные параметры"), содержащего ip-адрес или имя smtp-сервера. */
;
public tuneHelo		const ::[SYSTEM_PARAMS].[CODE]%type := 'SMTP_HELO'
/* Код системного параметра (справочник "Системные параметры"), содержащего домен smtp-сервера. */
;
public tuneDefEMail	const ::[SYSTEM_PARAMS].[CODE]%type := 'SMTP_DEF_EMAIL'
/* Код системного параметра (справочник "Системные параметры"), содержащего адрес отправителя, который должен использоваться по умолчанию. */
;
public tunePort		const ::[SYSTEM_PARAMS].[CODE]%type := 'SMTP_PORT'
/* Код системного параметра (справочник "Системные параметры"), содержащего порт smtp-сервера. */
;

-- win 'АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдежзийклмнопрстуфхцчшщъыьэюяЁё'
public CHARSET_ISO const varchar2(66)
		:=chr(176)||chr(177)||chr(178)||chr(179)||chr(180)||chr(181)||chr(182)||chr(183)||chr(184)||chr(185)||chr(186)||chr(187)||chr(188)||chr(189)||chr(190)||chr(191)
		||chr(192)||chr(193)||chr(194)||chr(195)||chr(196)||chr(197)||chr(198)||chr(199)||chr(200)||chr(201)||chr(202)||chr(203)||chr(204)||chr(205)||chr(206)||chr(207)
		||chr(208)||chr(209)||chr(210)||chr(211)||chr(212)||chr(213)||chr(214)||chr(215)||chr(216)||chr(217)||chr(218)||chr(219)||chr(220)||chr(221)||chr(222)||chr(223)
		||chr(224)||chr(225)||chr(226)||chr(227)||chr(228)||chr(229)||chr(230)||chr(231)||chr(232)||chr(233)||chr(234)||chr(235)||chr(236)||chr(237)||chr(238)||chr(239)
		||chr(161)||chr(241)
/* Строка для смены кодировки - символы, соответствующие кодировке  ISO 8859-5. В текущей версии библиотеки не используется. Оставлено для совместимости. */
;
public CHARSET_KOI constant varchar2(66)
		:=chr(225)||chr(226)||chr(247)||chr(231)||chr(228)||chr(229)||chr(246)||chr(250)||chr(233)||chr(234)||chr(235)||chr(236)||chr(237)||chr(238)||chr(239)||chr(240)
		||chr(242)||chr(243)||chr(244)||chr(245)||chr(230)||chr(232)||chr(227)||chr(254)||chr(251)||chr(253)||chr(255)||chr(249)||chr(248)||chr(252)||chr(224)||chr(241)
		||chr(193)||chr(194)||chr(215)||chr(199)||chr(196)||chr(197)||chr(214)||chr(218)||chr(201)||chr(202)||chr(203)||chr(204)||chr(205)||chr(206)||chr(207)||chr(208)
		||chr(210)||chr(211)||chr(212)||chr(213)||chr(198)||chr(200)||chr(195)||chr(222)||chr(219)||chr(221)||chr(223)||chr(217)||chr(216)||chr(220)||chr(192)||chr(209)
		||chr(179)||chr(163)
/* Строка для смены кодировки - символы, соответствующие кодировке KOI8-R. В текущей версии библиотеки не используется. Оставлено для совместимости. */
;

public HOST varchar2(256)
/* Значения настройки "Сервер SMTP" */
;
public PORT PLS_INTEGER
/*  Значения настройки "Порт сервера SMTP" */
;
public HELO varchar2(256)
/*  Значения настройки "Домен отправителя" */
;
public DEF_EMAIL varchar2
/*  Значения настройки "E-Mail отправителя по умолчанию" */
;

public ERROR_ON_SEND exception
/* Исключение, вызываемое если возникла ошибка при отправке сообщения. В текущей версии библиотеки не используется. Оставлено для совместимости. */
;


/*	Внимание!
	Процедуры, которые объявлены ниже, являются обёртками для вызова функции ::[RUNTIME].[EMAIL].send.
	Из объявленых выше переменных, в ::[RUNTIME].[EMAIL].send передаются только  HOST, PORT, HELO, DEF_EMAIL. Остальные переменные игнорируются и планируются к удалению в следующих версиях.
	Также в следующих версиях планируется удалить подпрограммы объявленные ниже комментария DEPRECATED.
*/

public subtype address_rec is [EMAIL].address_rec
/* Запись для размещения информации об адресате с полями:
	name varchar2(256) -- Наименование адресата.
	address varchar2(256) -- Адрес электронной почты.
	recipient_type varchar2(10) -- Тип получателя (имеет смысл только для получателя, иначе игнорируется). Поддерживаемые значения (могут указываться в любом регистре): "To" (получатель), "Cc" (получатель копии), "Bcc" (получатель скрытой копии). Все остальные значения (включая null) интерпретируются как "To".
*/
;
public subtype address_array is [EMAIL].address_array
/* Массив из записей типа address_rec для размещения информации о списке адресатов. */
;
public subtype attach_rec is [EMAIL].attach_rec
/* Запись для размещения информации о файле, который должен быть прикреплён к письму с полями
	filename varchar2(256) -- Имя файла. Предназначается для почтового клиента: будет использовано при сохранении файла на диск получателя, и если не указан тип MIME, то он будет определён по расширению имени файла (для открытия файла будет использоваться программа, которая ассоциирована с типом MIME на компьютере пользователя).
	bdata blob -- Бинарные данные.
	cdata clob -- Текстовые данные.
	mimetype varchar2(100) -- Тип MIME. По умолчанию используется 'application/octet-stream'.
*/
;
public subtype attach_array is [EMAIL].attach_array
/* Массив из записей типа attach_rec для размещения информации о списке файлов, которые должны быть прикреплены к письму. */
;




