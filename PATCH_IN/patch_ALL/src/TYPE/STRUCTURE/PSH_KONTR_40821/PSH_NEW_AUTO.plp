class PSH_KONTR_40821;

@import_plsql(true)
@name('[ПСБ] Добавить')
@tag('CREATED')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('Номер счета 40821') P_AC_40821 in [AC_FIN_REF],
	@name('Получатель')        P_RECEIVER in [REQ_CLIENT]
) return ref [PSH_KONTR_40821] is

validate is
begin
	if p_message = 'DEFAULT' then
		null;
	elsif P_MESSAGE = 'VALIDATE' then
		if p_info = 'P_RECEIVER.0' then
			if P_RECEIVER.[0] = 1 then
				P_RECEIVER.[2].[1] := null;
				P_RECEIVER.[2].[INN] := null;
				P_RECEIVER.[2].[2] := null;
			elsif P_RECEIVER.[0] = 2 then
				P_RECEIVER.[1].[1] := null;
				P_RECEIVER.[1].[2] := null;
			end if;
		elsif p_info = 'P_RECEIVER.1.2' then
			P_RECEIVER.[1].[1] := P_RECEIVER.[1].[2].[CLIENT_V];
		elsif p_info = 'P_RECEIVER.2.1' and not(regexp_like(P_RECEIVER.[2].[1], '^\d{20}$')) then 
			pragma error('В поле "Счет" необходимо ввести только 20 цифр!');
		elsif p_info = 'P_RECEIVER.2.INN' and not(regexp_like(P_RECEIVER.[2].[INN], '^\d{10}$') or regexp_like(P_RECEIVER.[2].[INN], '^\d{12}$')) then 
			pragma error('В поле "ИНН" необходимо ввести только 10 или 12 цифр!');
		end if;
	end if;
end;

execute is
begin
	if P_AC_40821 is null
	 or (P_RECEIVER.[0] = 1 and P_RECEIVER.[1].[2] is null)
	 or (P_RECEIVER.[0] = 2 and (P_RECEIVER.[2].[1] is null or P_RECEIVER.[2].[2] is null))
	then
		pragma error('Необходимо заполнить все поля на форме!');
	end if;
	
	if ::[PSH_KONTR_40821].[PSH_EDIT_AUTO].contr_exists(P_RECEIVER, P_AC_40821) then -- updated CHANGE_QUALIFIER PSB_KONTR_40821->PSH_KONTR_40821 09/10/25 -- updated CHANGE_SHORT_NAME EDIT_AUTO->PSH_EDIT_AUTO 15/10/25
		pragma error('Запись с такими же реквизитами уже имеется в справочнике');
	end if;

	-- Установка значения реквизита "Номер счета 40821"
	[AC_40821] := P_AC_40821;
	-- Реквизиты получателя
	[RECEIVER] := P_RECEIVER;
	-- Пользователь
	[USER]	   := stdlib.user_id;
	-- Дата изменения
	[DATE_CH]  :=  sysdate;
end;
end;
end;
