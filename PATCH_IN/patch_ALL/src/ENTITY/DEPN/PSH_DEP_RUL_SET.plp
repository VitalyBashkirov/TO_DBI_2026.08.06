class DEPN;

@import_plsql(true)
@name('[ПСБ] Депозит. Настройка обслуживания (служебная)')
@tag('COPIED')
method PSH_DEP_RUL_SET is
PSH_DEP_RUL_SET (
	@name('список')  LIST in [PSH_REF_DEP_SET],
	@name('депозит') DEP  in [DEPN_REF]
) is

validate is
Begin
	if p_message = 'DEFAULT' then
	DEP:=this;
	end if;
end;	

execute is
begin	
    null;																	

end;
end;
end;
