public function UR_AccSUMOBR_ARND	(p_acc ref [AC_FIN], p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is 
sm number(18,2);
begin
	--debug_pipe('p_d_beg='||p_d_beg||' '||'p_d_end='||p_d_end,0 );
	sm := 0;	
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_DT] = p_acc
		loop
			if	upper(md.[NAZN]) like upper('%аренд%')
