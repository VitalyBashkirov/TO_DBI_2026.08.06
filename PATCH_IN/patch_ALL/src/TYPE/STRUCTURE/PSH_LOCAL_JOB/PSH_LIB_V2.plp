class PSH_LOCAL_JOB;

@import_plsql(true)
@name('[ПСБ] Библиотека v2')
@tag('COPIED')
library PSH_LIB_V2 is
--Башкиров В.Г. 13.01.2025
work_name string(32):='IBSO'; --'IBSZ'; --Башкиров В.Г. 16.01.2025

pragma include(::[RUNTIME].[DEBUG_MACRO]);
dp  number:=0;	--управление debug_pipe
dp2 number:=0;	--управление debug_pipe
dp3 number:=10;	--управление debug_pipe

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

fmt    string(10):='dd/mm/yyyy';
fmtP   string(10):='dd.mm.yyyy';
fmtHMS string(22):='dd/mm/yyyy HH24:MI:SS';
fmtYMD string( 8):='yyyymmdd';

ft_XAU ref [FT_MONEY]:=::[FT_MONEY]([CUR_SHORT]='XAU'); --Золото в гр. 959
rRecountCurList ref [RECONT_CUR_LIST]; --Список валют для переоценки



pragma macro (lj_lib,'::[PSH_LOCAL_JOB].[PSH_LIB_V2]'); -- updated CHANGE_QUALIFIER CFB_LOCAL_JOB->PSB_LOCAL_JOB 22/10/22 -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25 -- updated CHANGE_SHORT_NAME PSB_LIB_V2->PSH_LIB_V2 15/10/25
pragma macro ('xml','[XML_DB]');
p_date date;
p_date1 date;
cnt integer;
n integer;
v_instance_name		varchar2(100);

--Текстовое задание RECONT_CUR_LIST.IMP_VAL_CBRF -- Загрузка курсов валют
-- begin
--           PSB_LOCAL_JOB.PSB_LIB.IMP_MTE_CBRF;
--           PSB_LOCAL_JOB.PSB_LIB.IMP_VAL_CBRF;
-- end;
public Procedure IMP_VAL_CBRF(
		p_date date default null --Башкиров В.Г. 13.01.2025
							)
is
 str_clob CLOB;
 req   utl_http.req;
 resp  utl_http.resp;

 doc &xml.DOMDocument;
 Element &xml.DOMElement;
 rootNode &xml.DOMNode;
 node &xml.DOMNode;
 node1 &xml.DOMNode;
 nodeList &xml.DOMNodeList;
 nodeList1 &xml.DOMNodeList;
 map		&xml.DOMNamedNodeMap;
 parser 	&xml.Parser;
 fragment varchar2(32000);
 item XMLTYPE;
 elem &xml.DOMElement;
 CharCode  string;
 Value string;
 Nominal string;
 date1 string;
 rc		ref [RECONT_CUR_LIST];
 ft_m 	 ref [FT_MONEY];
 base_curr ref [DIC_INT_CUR];
 v_cnt	number;
 v_text	varchar2(32000);

 --Башкиров В.Г. 11.07.2025 CFT-2024
 rate_16_6 [SUMMA_16_6];
 fmt_16_6 string(16):='999999999.999999';
 tmp_date [DATE];
begin
	select x(x.INSTANCE_NAME)
	in v$instance%rowtype
	into v_instance_name; if work_name is null then work_name:='IBSO'; end if;
	
	&debug('.IMP_VAL_CBRF -- '||v_instance_name||' p_date='||to_char(p_date,fmt),dp)
	if [CALENDAR].CHECK_DATE('HOLIDAYS', sysdate) then
		&debug('.IMP_VAL_CBRF -- День не рабочий. Выходим',dp)
		return;
	end if;

/* subbotin - 2025-07-11 закомментировал временно на IBSZ
	if v_instance_name != work_name then
		&debug('.IMP_VAL_CBRF -- Схема '||v_instance_name||' не рабочая '||work_name||'. Выходим',dp)
		return;
	end if;
*/

	select x(count(1))
	in ::[RECONT_CUR_LIST]
	where x.[DATE_BEGIN] < [system].[OP_DATE]+1
	and x.[CURRENCY]!=101159967   --.[CUR_SHORT]!='BYR'
	into v_cnt;

	if v_cnt = 0 then
		return;
	end if; 

	select t(min(t.[DATE_BEGIN])) in  ::[RECONT_CUR_LIST] all where t.[CURRENCY]!=101159967 into p_date1;
	--p_date := [system].[OP_DATE]+1;  
	--p_date := to_date('15.04.2023','dd.mm.yyyy');

	--p_date := [CALENDAR].next_date('WORK', '0', p_date1)+1;
	p_date := nvl(p_date,[CALENDAR].next_date('WORK', '0', p_date1)+1);	--Башкиров В.Г. 13.01.2025
	&debug('.IMP_VAL_CBRF -- p_date ='||to_char(p_date,fmt),dp)
	&debug('.IMP_VAL_CBRF -- p_date1='||to_char(p_date1,fmt),dp)

	begin 
		UTL_HTTP.set_body_charset ('windows-1251');
		req := utl_http.begin_request ('http://www.cbr.ru/scripts/XML_daily.asp?date_req='||to_char(p_date, 'dd/mm/yyyy'));
		resp := utl_http.get_response(req); utl_http.read_text(resp, str_clob); utl_http.end_response(resp); utl_http.close_persistent_conns;
	exception
		when OTHERS then 
		&debug('.IMP_VAL_CBRF -- Ош.'||LF$||sqlerrm,dp)
		return;
	end;
	&debug(substr(str_clob,   1,4000),dp2)
	&debug(substr(str_clob,4001,4000),dp2)
	&debug(substr(str_clob,8001,4000),dp2)

	parser := &xml.newParser;
	&xml.parseCLOB(parser, str_clob);
	dbms_lob.freetemporary(str_clob);
	doc := &xml.getDocument(parser);
	if &xml.IsNull(doc) then
		&debug('.IMP_VAL_CBRF -- Ошибка разбора XML. Выходим.'||LF$||sqlerrm,dp)
		pragma error('Ошибка разбора XML');
		return;
	end if;

	Element:=&xml.getDocumentElement(doc);
	date1 := &xml.getAttribute(Element,'Date');

	&lj_lib.write_log('RECONT','Курсы на '||date1);
	&debug('.IMP_VAL_CBRF -- Курсы на '||date1,dp)
	--Башкиров В.Г. 15.07.2025 CFT-2024
	if instr(date1,'.')>0 then	tmp_date:=to_date(date1,'dd.mm.yyyy');
	else						tmp_date:=to_date(date1,'dd/mm/yyyy');
	end if;
	if tmp_date<=p_date1 then
		&debug('.IMP_VAL_CBRF -- Курсы на '||to_char(tmp_date,fmt)|| '<=' ||to_char(p_date1,fmt)||'-min из "RECONT_CUR_LIST-Список валют для переоценки". Выходим',dp)
		return;
	end if;

	nodeList := &xml.getChildrenByTagName(Element, 'Valute');
	cnt := &xml.getLength(nodeList );
	for i in 0 .. cnt - 1
	loop
		nodeList1 := &xml.getChildNodes(&xml.item(nodeList ,i));
		if not &xml.IsNull(nodeList1) then
			for j in 0..&xml.getLength(nodeList1)-1 loop
				node:=&xml.item(nodeList1, j);
				--&debug(&xml.getNodeName(node)|| '== '||&xml.getNodeValue(&xml.getFirstChild(node)),dp2)
				
				case &xml.getNodeName(node) of
				 :'Value' :		Value:= &xml.getNodeValue(&xml.getFirstChild(node));
				 :'Nominal' : 	Nominal:= &xml.getNodeValue(&xml.getFirstChild(node));
				 :'CharCode' :	 CharCode:= &xml.getNodeValue(&xml.getFirstChild(node));
				end;
			end loop;

			ft_m := ::[FT_MONEY].[LIB].Get_money(CharCode);
			if ft_m is null then
				null;
				&debug('.IMP_VAL_CBRF -- Валюта '||CharCode ||' не найдено в справочнике FT_MONEY',0)
			else
				begin
					locate rc in ::[RECONT_CUR_LIST] where rc.[CURRENCY] = ft_m;
					&debug('.IMP_VAL_CBRF -- Найден  '||CharCode ||' '||Value||' '||Nominal,0)
					rc.[RATE_NEW]:= to_number(replace(Value,',','.'));
					rc.[UNIT_NEW]:= to_number(Nominal);
					rc.[DATE_BEGIN] := to_date(date1,'dd.mm.yyyy');
					commit;
				exception when NO_DATA_FOUND then
					&debug('.IMP_VAL_CBRF -- Не найдено  '|| CharCode||' добавим ft_m.'||ft_m||'('||ft_m.[CUR_SHORT]||'-'||ft_m.[NAME]||') Value='||Value||' Nominal='||Nominal||' date1='||date1,0)

					--Башкиров В.Г. 11.07.2025 CFT-2024
					rate_16_6:= to_number(replace(Value,',','.'),fmt_16_6);
					&debug('.IMP_VAL_CBRF -- Value=rate_16_6='||rate_16_6,0)
					&debug('.IMP_VAL_CBRF -- Nominal='||to_number(Nominal),0)
					
					rc := ::[RECONT_CUR_LIST].[NEW#AUTO](
							ft_m,			
							rate_16_6, --to_number(Value), --Башкиров В.Г. 11.07.2025 CFT-2024
							to_number(Nominal),
							to_date(date1,'dd.mm.yyyy')
							);
					commit;
				end;
			end if;
		end if;
	end loop;

	&xml.freeParser(parser);
	select x(count(1))
	in ::[RECONT_CUR_LIST]
	where x.[DATE_BEGIN] <= [system].[OP_DATE] 
	and x.[CURRENCY]!=101159967   --.[CUR_SHORT]!='BYR'
	into v_cnt;

	if v_cnt > 0 then
		v_text :=
		'<html>
		<style type="text/css">
		table {
		 background: #ffffff; /* цвет фона */
		 border: 1px #ff0000 solid; /* стиль рамки */
		 border-collapse: collapse ; /* убирание задвоенности рамки */
		}
		td {
		 border: 1px #000000 solid; /* стиль рамки ячеек */
		 padding: 0.2em;
		 font-size: small;
		 font-family: Calibri;
		}
		th {
		 background: #e0e0e0;
		 border: 1px #000000 solid; /* стиль рамки заголовков */
		 padding: 0.2em;
		 font-family: Calibri;
		}
		
		</style>'||v_instance_name||'<br><br>';
		v_text:=replace(v_text,TB$); --Башкиров В.Г. 13.01.2025
		
		select x(count(1))
		in ::[RECONT_CUR_LIST]
		where x.[DATE_BEGIN] > [system].[OP_DATE] 
		and x.[CURRENCY]!=101159967   --.[CUR_SHORT]!='BYR'
		into v_cnt;
	
		if v_cnt = 0 then 
			v_text := v_text || '<p><font color="red">отсутствует файл</font></p>';
		else 
			v_text := v_text || 
			'<p><font color="red">Неудачная загрузка курсов</font></p>
			<table>
			  <tr>
			    <th> Код </th>
			    <th> Валюта </th>
			    <th> Текущий курс </th>
			    <th> Новый курс </th>
			    <th> Дата </th>
			  </tr>';
			v_text:=replace(v_text,TB$); --Башкиров В.Г. 13.01.2025

			for (select x(x%rowtype)
				in VW_CRIT_RECONT_CUR_LIST%rowtype
				where  x.c_1!='BYR' 
				and x.c_5<=[system].[OP_DATE]
				order by x.c_1
			)
			loop
				v_text := v_text || '<tr><td>'||x.c_1||'</td><td>'||x.c_2||'</td><td>'||x.c_3||'</td><td>'||x.c_4||'</td><td>'||to_char(x.c_5,'dd/mm/yyyy')||'</td>';
			end loop;
			v_text := v_text || '</table></html>';
		end if;

		::[FP_INTERFACE].[PRX_PCORE].Send_Mail(
			'bashkirov@pshb.ru;'	--'sobolev@pshb.ru;slopuhov@pshb.ru;asankulov@pshb.ru'
			,v_instance_name||' ЗОД. Загрузка курсов. Не успех ('||v_instance_name||')'
			,v_text
			,p_isHtml == true
			);
	else
		v_text :=
		'<html>
		<style type="text/css">
		table {
		 background: #ffffff; /* цвет фона */
		 border: 1px #ff0000 solid; /* стиль рамки */
		 border-collapse: collapse ; /* убирание задвоенности рамки */
		}
		td {
		 border: 1px #000000 solid; /* стиль рамки ячеек */
		 padding: 0.2em;
		 font-size: small;
		 font-family: Calibri;
		}
		th {
		 background: #e0e0e0;
		 border: 1px #000000 solid; /* стиль рамки заголовков */
		 padding: 0.2em;
		 font-family: Calibri;
		}
		
		</style>'|| --v_instance_name||'<br><br>
		'Курсы загружены успешно <br><br>
		
		<table>
		  <tr>
		    <th> Код </th>
		    <th> Валюта </th>
		    <th> Текущий курс </th>
		    <th> Новый курс </th>
		    <th> Дата </th>
		  </tr>';
		v_text:=replace(v_text,TB$); --Башкиров В.Г. 13.01.2025

		for (select x(x%rowtype)
			in VW_CRIT_RECONT_CUR_LIST%rowtype
			where  x.c_1!='BYR' 
			order by x.c_1)
		loop
			v_text := v_text || '<tr><td>'||x.c_1||'</td><td>'||x.c_2||'</td><td>'||x.c_3||'</td><td>'||x.c_4||'</td><td>'||to_char(x.c_5,'dd/mm/yyyy')||'</td>';
		end loop;

		v_text := v_text || '</table></html>';

		::[FP_INTERFACE].[PRX_PCORE].Send_Mail(
			'bashlirov@pshb.ru;'	--'sobolev@pshb.ru;slopuhov@pshb.ru;asankulov@pshb.ru'
			,v_instance_name||' ЗОД. Загрузка курсов. Успех ('||v_instance_name||')'
			,v_text
			,p_isHtml == true
			);
	end if;
end;

public Procedure IMP_MTE_CBRF(
		p_date date default null --Башкиров В.Г. 13.01.2025
							)
is
 str_clob CLOB;
 req   utl_http.req;
 resp  utl_http.resp;

 doc &xml.DOMDocument;
 Element &xml.DOMElement;
 rootNode &xml.DOMNode;
 node &xml.DOMNode;
 node1 &xml.DOMNode;
 nodeList	&xml.DOMNodeList;
 nodeList1	&xml.DOMNodeList;
 map		&xml.DOMNamedNodeMap;
 parser 	&xml.Parser;
 fragment varchar2(32000);
 item XMLTYPE;
 elem &xml.DOMElement;
 CharCode  string;
 Value string;
 Nominal string;
 date1 string;
 rc		ref [RECONT_CUR_LIST];
 ft_m 	 ref [FT_MONEY];
 base_curr ref [DIC_INT_CUR];
 v_cnt	number;
 v_text	varchar2(32000);
begin
	select x(x.INSTANCE_NAME)
	in v$instance%rowtype
	into v_instance_name; if work_name is null then work_name:='IBSO'; end if;

	&debug('.IMP_MTE_CBRF -- '||v_instance_name||' p_date='||to_char(p_date,fmt),dp)
	if [CALENDAR].CHECK_DATE('HOLIDAYS', sysdate) then
		&debug('.IMP_MTE_CBRF -- День не рабочий. Выходим',dp) --Башкиров В.Г. 13.01.2025
		return;
	end if;
	/** /
	if v_instance_name != work_name then
		&debug('.IMP_MTE_CBRF -- Схема "'||v_instance_name||'" не рабочая "'||work_name||'". Выходим',dp)
		return;
	end if;
	/**/
	select x(count(1))
	in ::[RECONT_CUR_LIST]
	where x.[DATE_BEGIN] < [system].[OP_DATE]+1
	and x.[CURRENCY]=ft_XAU --9502591   --.[CUR_SHORT]!='BYR' --Золото
	into v_cnt;

	if v_cnt = 0 then
		return;
	end if; 

	--9502591 - Золото 
	select t(min(t.[DATE_BEGIN])) in  ::[RECONT_CUR_LIST] all where t.[CURRENCY]=ft_XAU into p_date1;
	select t(t%id) in  ::[RECONT_CUR_LIST] all where t.[CURRENCY]=ft_XAU into rRecountCurList;
	&debug('.IMP_MTE_CBRF -- p_date1='||to_char(p_date1,fmt)||' rRecountCurList('||rRecountCurList.[CURRENCY].[CUR_SHORT]||').id='||rRecountCurList,dp)
	--p_date := [system].[OP_DATE]+1;  
	--p_date := to_date('15.04.2023','dd.mm.yyyy');

	--p_date := [CALENDAR].next_date('WORK', '0', p_date1)+1;
	p_date := nvl(p_date,[CALENDAR].next_date('WORK', '0', p_date1)+1);	--Башкиров В.Г. 13.01.2025
	&debug('.IMP_MTE_CBRF -- p_date ='||to_char(p_date,fmt)||' rRecountCurList('||rRecountCurList.[CURRENCY].[CUR_SHORT]||').id='||rRecountCurList,dp)

	-------------------------------------------------------------------------------
	begin 
		UTL_HTTP.set_body_charset ('windows-1251');
		                        &debug('http://www.cbr.ru/scripts/xml_metall.asp?date_req1='||to_char(p_date, 'dd/mm/yyyy')||'&date_req2='||to_char(p_date, 'dd/mm/yyyy'),dp)
		req := utl_http.begin_request ('http://www.cbr.ru/scripts/xml_metall.asp?date_req1='||to_char(p_date, 'dd/mm/yyyy')||'&date_req2='||to_char(p_date, 'dd/mm/yyyy'));
		resp := utl_http.get_response(req); utl_http.read_text(resp, str_clob); utl_http.end_response(resp); utl_http.close_persistent_conns;
	exception
		when OTHERS then
		&debug('.IMP_MTE_CBRF -- Ош.'||LF$||sqlerrm,dp)
		return;
	end;
	&debug(substr(str_clob,1,4000),dp2)

	parser := &xml.newParser;
	&xml.parseCLOB(parser, str_clob);
	dbms_lob.freetemporary(str_clob);
	doc := &xml.getDocument(parser);

	if &xml.IsNull(doc) then
		&debug('.IMP_MTE_CBRF -- Ошибка разбора XML. Выходим.'||LF$||sqlerrm,dp)
		pragma error('Ошибка разбора XML');
		return;
	end if;

	Element:=&xml.getDocumentElement(doc);
	date1 := &xml.getAttribute(Element,'FromDate');

	&lj_lib.write_log('RECONT','Металл на '||to_char(to_date(date1,'yyyymmdd'),fmt));
	&debug('.IMP_MTE_CBRF -- Курсы на '||to_char(to_date(date1,'yyyymmdd'),fmt),dp)
	if to_date(date1,'yyyymmdd')<=p_date1 then
		&debug('.IMP_MTE_CBRF -- Курсы на '||to_char(to_date(date1,'yyyymmdd'),fmt)
			|| '<=' ||to_char(p_date1,fmt)
			||'-min из "RECONT_CUR_LIST-Список валют для переоценки". Выходим',dp)
		return;
	end if;

	nodeList := &xml.getChildrenByTagName(Element, 'Record');
	cnt := &xml.getLength(nodeList );
	&debug('.IMP_MTE_CBRF -- cnt "Record" = '||cnt,dp)
	for i in 0 .. cnt - 1
	loop
		nodeList1 := &xml.getChildNodes(&xml.item(nodeList ,i));
		map := &xml.getAttributes(&xml.item(nodeList, i));
		&debug('.IMP_MTE_CBRF -- ('||i||') getLength(map)='||&xml.getLength(map),dp)
		if &xml.getLength(map)>0 then
			for i in 0..&xml.getLength(map)-1
			loop
				node1 := &xml.item(map, i);
				&debug(TB$||'<'||i||'>  - '||&xml.getNodeName(node1)||' : "'||&xml.getNodeValue(node1)||'"' ,dp2)
				if &xml.getNodeName(node1)='Code' and &xml.getNodeValue(node1)='1' then 
					if not &xml.IsNull(nodeList1) then
						for j in 0..&xml.getLength(nodeList1)-1 loop
							node:=&xml.item(nodeList1, j);			   
							if &xml.getNodeName(node)='Buy' then 
								&debug(TB$||&xml.getNodeName(node)|| '== '||&xml.getNodeValue(&xml.getFirstChild(node))  ,dp2)
								Value:=&xml.getNodeValue(&xml.getFirstChild(node));
								ft_m := ::[FT_MONEY].[LIB].Get_money('XAU');
								Nominal:=1;
								locate rc in ::[RECONT_CUR_LIST] where rc.[CURRENCY] = ft_m;
								begin
									rc.[DATE_BEGIN] := to_date(date1,'yyyymmdd');
									rc.[RATE_NEW]:= to_number(replace(Value,',','.'));
									rc.[UNIT_NEW]:= Nominal;
									&debug(TB$||'Обновим в "Список валют для переоценки" для '||rc.[CURRENCY].[CUR_SHORT]||' Курс:'||rc.[RATE_NEW]||' Новая Ед.изм.:'||rc.[UNIT_NEW]||' Дата нач.действия курса:'||to_char(rc.[DATE_BEGIN],fmt),dp2)
									commit;
									
									if rc.[RATE_NEW] is not null then
										&debug(TB$||'Переписываем курс в {Журнал переоценки}. Новый курс '||ft_m.[CUR_SHORT]
											||' на '||to_char(rc.[DATE_BEGIN],fmt)
											||' '||rc.[RATE_NEW]||' Новая.Ед.изм.:'||rc.[UNIT_NEW],dp2)
										rc.[PSH_REWRITE](rc.[DATE_BEGIN]); -- updated CHANGE_SHORT_NAME PSB_REWRITE->PSH_REWRITE 15/10/25
										if rc.[DATE_BEGIN]=::[SYSTEM].[OP_DATE] then
											&debug('.Recont_Acc -- Сбросим Новый курс т.к. он на '||to_char(::[SYSTEM].[OP_DATE],fmt)||' и равен текущему',dp2)
											rc.[RATE_NEW]:=null;
										end if;
										commit;
									end if;

								exception when NO_DATA_FOUND then
									rc := ::[RECONT_CUR_LIST].[NEW#AUTO](
											ft_m,
											to_number(Value),
											to_number(Nominal),
											to_date(date1,'yyyymmdd')
											);
									&debug('Добавим в "Список валют для переоценки" для '||rc.[CURRENCY].[CUR_SHORT]||' Курс:'||rc.[RATE_NEW]||' Новая Ед.изм.:'||rc.[UNIT_NEW]||' Дата нач.действия курса:'||to_char(rc.[DATE_BEGIN],fmt),dp2)
									commit;

									if rc.[RATE_NEW] is not null then
										&debug(TB$||'Переписываем курс в {Журнал переоценки}. Новый курс '||ft_m.[CUR_SHORT]
											||' на '||to_char(rc.[DATE_BEGIN],fmt)
											||' '||rc.[RATE_NEW]||' Новая.Ед.изм.:'||rc.[UNIT_NEW],dp2)
										rc.[PSH_REWRITE](rc.[DATE_BEGIN]); -- updated CHANGE_SHORT_NAME PSB_REWRITE->PSH_REWRITE 15/10/25
										commit;
									end if;
								end;
							end if;
						end loop;
					end if;
				end if;
			end loop;	
		end if;
	end loop;
	&xml.freeParser(parser);
	&debug('.IMP_MTE_CBRF -- Выходим',dp)
end;

public Procedure Recont_Acc(
		 p_date date default null 		--Башкиров В.Г. 13.01.2025
		,ft ref [FT_MONEY] default null	--Башкиров В.Г. 13.01.2025
							)
is
 sald		[SUMMA];
 sald_nt		[SUMMA];
 p_rate	number;
 fp [SORT_OF_RECONT];
 str_msg	varchar2(32000);
 str_tmp varchar2(32000);
 lg_l ref [PSH_LOCAL_JOBS_F]; -- updated CHANGE_QUALIFIER CBF_LOCAL_JOBS_F->PSH_LOCAL_JOBS_F 07/10/25
 cnt integer;
 --p_date date; --Башкиров В.Г. 13.01.2025
 rRecountCurList ref [RECONT_CUR_LIST]; --Башкиров В.Г. 14.01.2025
begin
	select x(x.INSTANCE_NAME)
	in v$instance%rowtype
	into v_instance_name; if work_name is null then work_name:='IBSO'; end if;
	
	&debug('.Recont_Acc -- '||v_instance_name||' p_date='||to_char(p_date,fmt)||' ft='||ft.[CUR_SHORT],dp)

	if v_instance_name != work_name then
		&debug('.Recont_Acc -- Схема '||v_instance_name||' не рабочая '||work_name||'. Выходим',dp)
		return;
	end if;

   -- ::[SYSTEM].[VARIABLES].set_system_vars_by_user(15470352); ::[END_OD_INTERFACE].[PRX_DOCUMENT].trc_set_var_current;
   -- fp.[0] := 3;
	p_date := nvl(p_date,::[SYSTEM].[OP_DATE] -3);
	&debug('.Recont_Acc -- p_date='||to_char(p_date,fmt),dp2)

	if ft is not null then
		--9502591 - Золото 
		select t(min(t.[DATE_BEGIN])) in  ::[RECONT_CUR_LIST] all where t.[CURRENCY]=ft_XAU into p_date1;
		select t(t%id) in  ::[RECONT_CUR_LIST] all where t.[CURRENCY]=ft_XAU into rRecountCurList;
		if rRecountCurList.[RATE_NEW] is not null then
			&debug('.Recont_Acc -- Переписываем курс в {Журнал переоценки}. Новый курс '||ft.[CUR_SHORT]||' на p_date1='||to_char(p_date1,fmt)||' '||rRecountCurList.[RATE_NEW]||' Новая.Ед.изм.:'||rRecountCurList.[UNIT_NEW]||' rRecountCurList('||rRecountCurList.[CURRENCY].[CUR_SHORT]||').id='||rRecountCurList,dp2)
			rRecountCurList.[PSH_REWRITE](p_date1); -- updated CHANGE_SHORT_NAME PSB_REWRITE->PSH_REWRITE 15/10/25
		end if;
	end if;
	
	str_msg:='';
	while p_date <= ::[SYSTEM].[OP_DATE]-1
	loop
		&debug(TB$||'p_date='||to_char(p_date,fmt),dp2)
		if ft is null then
			for acc in ::[AC_FIN] all where acc.[FINTOOL] != [SYSTEM]::[SYS_MAIN_VAL]
				and (acc.[RECONT_ACC].[0]!=3 or acc.[RECONT_ACC].[0] is null)
			loop
				p_rate	:= ::[DOCUMENT].[LIB_CUR].Get_Rate(acc.[FINTOOL], p_date);
				sald 	:= abs(f.a('И'||acc||'СВ',p_date));
				sald_nt := abs(f.a('И'||acc||'СН',p_date));
				
				&debug(TB$||acc.[MAIN_V_ID]||' '||acc.[FINTOOL].[CUR_SHORT]||' p_rate='||p_rate||' на '||to_char(p_date,fmt),dp3)
				for (
					select  rec
						(	trunc(rec.[DATE])	: c_date
							--, rec.[SUMMA] 		: c_sum
							--, rec.[DOC]			: c_doc
							--, rec.[DT]          : c_dt
							--, rec.[SUMMA_NAT]   : c_sum_NAT
							--, rec.[START_SUM_NAT]: c_START_SUM_NAT
							--, rec.[START_SUM]    : c_START_SUM
							, rec.[START_SUM] +decode(rec.[DT], '1', -1, 1)*rec.[SUMMA]  : c_end_sum
							, rec.[START_SUM_NAT]+decode(rec.[DT], '1', -1, 1)*rec.[SUMMA_NAT] : c_end_sum_nat
						)	
					in	 ::[RECORDS]
						 join (::[AC_FIN]:a)	on 	rec%collection = a.[ARC_MOVE] and a%id=acc
						 join (::[MAIN_DOCUM]:d) on d%id=rec.[DOC]
						all	
						where	trunc(rec.[DATE]) = p_date and d.[KOD_NAZN_PAY].[KOD_NAZN] ='RECONT'
					)	
				loop
					sald_nt:=abs(rec.c_end_SUM_NAT);
					exit;
				end loop;
				if sald_nt - round(p_rate*sald,2)!=0 and to_char(p_date,'dd.mm.yy') not in ('26.11.21','16.12.21') then
					str_tmp:=to_char(p_date,'dd.mm.yy')||'  '||acc.[MAIN_V_ID] ||' вх.ост. '||sald_nt ||' не равен переоценке ' || sald|| ' * '|| p_rate||' = '||round(p_rate*sald,2);
					str_msg:=substr(str_msg||str_tmp||' '||'<BR>'||nl$,1,str_msg%size);
				end if;
			end loop;
		else
			for acc in ::[AC_FIN] all where acc.[FINTOOL]=ft
				and (acc.[RECONT_ACC].[0]!=3 or acc.[RECONT_ACC].[0] is null)
			loop
				p_rate	:= ::[DOCUMENT].[LIB_CUR].Get_Rate(acc.[FINTOOL], p_date);
				sald 	:= abs(f.a('И'||acc||'СВ',p_date));
				sald_nt := abs(f.a('И'||acc||'СН',p_date));
				
				&debug(TB$||acc.[MAIN_V_ID]||' '||acc.[FINTOOL].[CUR_SHORT]||' p_rate='||p_rate||' на '||to_char(p_date,fmt),dp2)
				for (
					select  rec
						(	trunc(rec.[DATE])	: c_date
							--, rec.[SUMMA] 		: c_sum
							--, rec.[DOC]			: c_doc
							--, rec.[DT]          : c_dt
							--, rec.[SUMMA_NAT]   : c_sum_NAT
							--, rec.[START_SUM_NAT]: c_START_SUM_NAT
							--, rec.[START_SUM]    : c_START_SUM
							, rec.[START_SUM] +decode(rec.[DT], '1', -1, 1)*rec.[SUMMA]  : c_end_sum
							, rec.[START_SUM_NAT]+decode(rec.[DT], '1', -1, 1)*rec.[SUMMA_NAT] : c_end_sum_nat
						)	
					in	 ::[RECORDS]
						 join (::[AC_FIN]:a)	on 	rec%collection = a.[ARC_MOVE] and a%id=acc
						 join (::[MAIN_DOCUM]:d) on d%id=rec.[DOC]
						all	
						where	trunc(rec.[DATE]) = p_date and d.[KOD_NAZN_PAY].[KOD_NAZN] ='RECONT'
					)	
				loop
					sald_nt:=abs(rec.c_end_SUM_NAT);
					exit;
				end loop;
				if sald_nt - round(p_rate*sald,2)!=0 and to_char(p_date,'dd.mm.yy') not in ('26.11.21','16.12.21') then
					str_tmp:=to_char(p_date,'dd.mm.yy')||'  '||acc.[MAIN_V_ID] ||' вх.ост. '||sald_nt ||' не равен переоценке ' || sald|| ' * '|| p_rate||' = '||round(p_rate*sald,2);
					str_msg:=substr(str_msg||str_tmp||' '||'<BR>'||nl$,1,str_msg%size);
				end if;
			end loop;
		end if;

	 -- if length(str_msg)>1 then &lj_lib.write_log('RECONT',str_msg);  end if;
		&debug(substr(LF$||str_msg,1,4000),dp)
		if ft is null and length(str_msg)>1 then 
			::[FP_INTERFACE].[PRX_PCORE].Send_Mail(
				'bashkirov@pshb.ru;'	--'sobolev@pshb.ru;'
				,'Переоценка ('||v_instance_name||')'
				,str_msg
				,p_isHtml == true
				);
			null;
		end if;
		p_date := p_date + 1;
	end loop;

	if ft is not null and p_date>=::[SYSTEM].[OP_DATE] then
		select t(t%id) in  ::[RECONT_CUR_LIST] all where t.[CURRENCY]=ft into rRecountCurList;
		if rRecountCurList.[RATE_NEW] is not null and rRecountCurList.[DATE_BEGIN]=::[SYSTEM].[OP_DATE]
		and ::[DOCUMENT].[LIB_CUR].Get_Rate(ft, p_date)=rRecountCurList.[RATE_NEW]
		then
			&debug('.Recont_Acc -- Сбросим Новый курс т.к. он на '||to_char(p_date,fmt)||' и равен текущему',dp2)
			rRecountCurList.[RATE_NEW]:=null;
		end if;
	end if;
	&debug('.Recont_Acc -- Выход',dp)
end;

public Procedure OP_DATE is
P_FILE  integer;
begin
	select x(x.INSTANCE_NAME)
	in v$instance%rowtype
	into v_instance_name; if work_name is null then work_name:='IBSO'; end if;

	if v_instance_name != work_name then
		return;
	end if;

	if  ::[SYSTEM].[OP_DATE]<trunc(sysdate) and work_name='ISBO' then 
		P_FILE := stdio.Open(::[SYSTEM_PARAMS].[GET]('PATH')||'/SMS', 'SMS_'||to_char(sysdate,'yyyymmdd_hh24mi')||'.txt', 'W');
		-- Соболев С.О.
		-- stdio.put_line(P_FILE,'+79104287704:Операционный день '||to_char(::[SYSTEM].[OP_DATE],'dd.mm.yyyy')|| ' не переведен!',null,null,stdio.WINTEXT);    
		
		-- Башкиров В.Г.
		stdio.put_line(P_FILE,'+79299726017:Операционный день '||to_char(::[SYSTEM].[OP_DATE],'dd.mm.yyyy')|| ' не переведен!',null,null,stdio.WINTEXT);
		
		-- Заернюк Р.В.
		stdio.put_line(P_FILE,'+79162916835:Операционный день '||to_char(::[SYSTEM].[OP_DATE],'dd.mm.yyyy')|| ' не переведен!',null,null,stdio.WINTEXT);    
		
		-- Кузнецов С.Е.
		stdio.put_line(P_FILE,'+79038819268:Операционный день '||to_char(::[SYSTEM].[OP_DATE],'dd.mm.yyyy')|| ' не переведен!',null,null,stdio.WINTEXT);
		stdio.close(P_FILE);	
	
		::[FP_INTERFACE].[PRX_PCORE].Send_Mail(
			 iif(v_instance_name='IBSO',::[PSH_EMAIL_RASSIL]([PSH_EMAIL_COD] = 'ZOD_ERR').[PSH_EMAIL_ADRES],'bashkirov@pshb.ru;')
			,v_instance_name||' ЗОД. Операционный день не переведен'
			,'Операционный день не переведен'
			,'IT@pshb.ru'
			,false
			,null
			);
	end if; 
end;

-- запись лога выполнения операции
public procedure write_log (job_name string, str MEMO_BIG) is
rec ref [PSH_LOCAL_JOB]; -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
begin
	locate rec in ::[PSH_LOCAL_JOB] where rec.[CODE]=job_name;  -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
	rec.[TEXT_LIST].[PSH_CFB_NEW](null,false,false,sysdate,rtrim(ltrim(str))); -- updated CHANGE_SHORT_NAME CFB_NEW->PSH_CFB_NEW 15/10/25
exception when OTHERS then  exit;
end;	

--Список Email группы
public function get_email_list_for_group(job_name string) return string is
rec ref [PSH_LOCAL_JOB];  -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
vRet string;
Begin
   begin
     	locate rec in ::[PSH_LOCAL_JOB] where rec.[CODE]=job_name;  -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
      exception when OTHERS then  exit;
	end;	
	for f in rec.[CLIENT_LIST] where f.[EMAIL] loop
		for (select t(t.[NUMB] :Email) in f.[CLIENT_REF].[CONTACTS] all where t.[TYPE].[CODE] = 'MAIL' and t.[PRIVATE].[CODE] = 'CFB_BANK')
		loop vRet:=vRet||t.Email||';';end loop;
	end loop;
	return vRet;	
end;

-- рассылка уведомлений
public  procedure send_info_jobs_email is
begin
	for j in ::[PSH_LOCAL_JOB] all where     exists (select r(1) in j.[TEXT_LIST] all where nvl(r.[EMAIL],false) = false)  -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
	                                     and exists (select r(1) in j.[CLIENT_LIST] all where nvl(r.[EMAIL],false) = true)
		loop
		    for m in j.[TEXT_LIST] all where nvl(m.[EMAIL],false) = false
			    loop
			        for u in j.[CLIENT_LIST] all where nvl(u.[EMAIL],false) = true
				        loop
				            for c in u.[CLIENT_REF].[CONTACTS] all where c.[TYPE].[CODE] = 'MAIL' and c.[PRIVATE].[CODE] = 'CFB_BANK' and c.[NUMB] is not null
					            loop
					                begin
					                    ::[FP_INTERFACE].[PRX_PCORE].Send_Mail(c.[NUMB],j.[NAME],m.[TEXT],null, true, true);
					                    null;
					                exception when OTHERS then write_log('JOB_SENDMAIL','Ошибка '||j.[NAME]||' '||u.[CLIENT_REF].[NAME]); end;
					            end loop;
				        end loop;
			        m.[EMAIL] := true;
			    end loop;
		end loop;
end;

public  function is_it_work_db return boolean
is
res BOOLEAN DEFAULT FALSE;
v_instance_name varchar2;
begin
	select x(x.INSTANCE_NAME)
	in v$instance%rowtype
	into v_instance_name; if work_name is null then work_name:='IBSO'; end if;
	IF v_instance_name=work_name THEN res := TRUE; END IF;
	return res;
end;	

public function GetPhoneNumber
/*	Функция для получения номера телефона клиента */
(
	p_CONTACTS	[CONTACTS_ARR]
	/*	Массив контактов клиента */
) return varchar2(100) is 
	v_ret_value			varchar2(100);
	v_prev_num_comm		number := null;
	v_prev_num_own		number := null;
	v_new_num_comm		number := null;
	v_new_num_own		number := null;
begin
	for(
		select x(	x.[NUMB]	:	C_NUM, x.[TYPE].[CODE] : C_TYPE_CODE, x.[PRIVATE] : C_PRIVATE)
		in p_CONTACTS all
		where x.[TYPE] in (::[COMUNICATION]([CODE] = 'PHONE'), ::[COMUNICATION]([CODE] = 'MOBILEPHONE'))
		order by  x.[ACTIV] desc -- сначала действующие контакты
				, x.[PRIVATE].[CODE]
	)loop
		v_new_num_comm := coalesce(::[FP_TUNE].[LIB].GET_NUM_VALUE('COMMUNICATION_PRIORITY',::[FP_TUNE].[LIB].SET_CANONS('<COMMUNICATION_TYPE>',to_char(x.C_TYPE_CODE)),'0'),99);
		v_new_num_own := coalesce(::[FP_TUNE].[LIB].GET_NUM_VALUE('OWNER_COM_PRIORITY',::[FP_TUNE].[LIB].SET_CANONS('OWNER_COM',to_char(x.C_PRIVATE)),'0'),99);
		if v_prev_num_comm is null or v_prev_num_comm >= v_new_num_comm then
			if v_prev_num_own is null or v_prev_num_own > v_new_num_own then
				v_ret_value := x.C_NUM;
			end if;
		end if;
		v_prev_num_comm := v_new_num_comm;
		v_prev_num_own := v_new_num_own;
	end loop;
	return v_ret_value;
end;
end;
