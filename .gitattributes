# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.py  text eol=lf
*.js  text eol=lf
*.ts  text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Markdown
*.md  text eol=crlf

# YAML
*.yaml text eol=lf
*.yml  text eol=lf

# Binary
*.png binary
*.jpg binary
*.zip binary
