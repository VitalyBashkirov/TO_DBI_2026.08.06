						end if;
					end;
				end loop;
				P_DATA := nvl(ltrim(P_DATA), 'НЕТ');								
			elsif p_info = 'ПРЕД_ДОК_2023'	then
				P_DATA := '----------';
			elsif p_info = 'ПРЕД_СРОКН_2023'	then
				P_DATA := '----------';
			elsif p_info = 'ПРЕД_СРОКО_2023'	then
				P_DATA := '----------';		
			------------ Миграционные карты и документы, подтверждающих право иностранного гражданина или лица без гражданства на пребывание ---------
			elsif p_info = 'МИГР1_ВИД' or p_info = 'МИГР2_ВИД' or p_info = 'МИГР3_ВИД' then
				P_DATA := nvl(trim(P_DATA), '---');
				case substr(p_info,5,1) of 	: '1' :  P_DATA := nvl(trim(Migr_doc1.vid), '---')	;
											: '2' :  P_DATA := nvl(trim(Migr_doc2.vid), '---')	;
											: '3' :  P_DATA := nvl(trim(Migr_doc3.vid), '---')	;
				end;
				
			elsif p_info = 'МИГР1_СЕР' or p_info = 'МИГР2_СЕР' or p_info = 'МИГР3_СЕР' then
				P_DATA := nvl(trim(P_DATA), '---');
				case substr(p_info,5,1) of 	: '1' :  P_DATA := nvl(trim(Migr_doc1.ser), '---')	;
											: '2' :  P_DATA := nvl(trim(Migr_doc2.ser), '---')	;
											: '3' :  P_DATA := nvl(trim(Migr_doc3.ser), '---')	;
				end;

