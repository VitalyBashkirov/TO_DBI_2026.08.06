	/**/
	:'1B620920':	-- расчет данных по F_250
		-- если отмена регистрации, то проверить наличие записей в справочнике данных

		for	(
				select	p(p.PROF		: C_PROF_LIST)
				in		(	select	x(x.[PARAM].[PROF].[CODE] : PROF)
							in		::[F_250_DT]
							group by x.[PARAM].[PROF].[CODE]
						)
				order by 1
				fetch 9
			)
		loop
			if vProfList is null then
				vProfList := '"'||p.C_PROF_LIST||'"';
			else
				vProfList := vProfList||', "'||p.C_PROF_LIST||'"';
			end if;

		end loop;
		
		if vProfList is not null then
				return 'Перед отключением приложения необходимо очистить все реализации отчета Ф-250 по профилям: '||vProfList;
		end if;

	:'1B620930':
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(	select	x(x)
				in		::[F_159_DATA]
				fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник F_159_DATA';
		end if;

	:'1B620990':
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(	select	x(x)
				in		::[F_702_DATA]
				fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник F_702_DATA';
		end if;

	:'1B620970':
	
		var iCountPRC	integer;
		
		-- если отмена регистрации, то проверить наличие записей
		select	x(count(1))
		in	(	select	x(x)
				in		::[F_119_DATA]
				fetch 1
			)
		into iCount;
		
		select	x(count(1))
		in	(	select	x(x)
				in		::[REPS_PRC]
				fetch 1
			)
		into iCountPRC;

		if coalesce(iCount, 0) + coalesce(iCountPRC, 0) > 0 then
			return 'Перед отключением приложения необходимо очистить справочники "ОП Ф-119 Данные" (F_119_DATA) и "ОП Данные о полной стоимости вкладов" (REPS_PRC)';
		end if;

	:'1B620980':
		-- если отмена регистрации, то проверить наличие настроек с фильтром  "Отражать счета, отсутствующие в продукте "Резервирование"
		vPril	:= '#';
		iCount	:= 0;
		for (
			select	u(u.[PROF].[CODE]	:C_PROF)
			in		::[REPS_TUNING]
			where	u.[REPORT] = ::[REPS]([CODE]='F_115')
				and	u.[ANALYTIC].[PATT_NORMAL].[PRODUCT].[CODE] = 'ACC_MISS_IN_RES_BASE'
			)
		loop
			iCount := iCount + 1;
			if instr(vPril, '#' || u.C_PROF || '#') = 0 then
				vPril := vPril || u.C_PROF || '#' ;
			end if;
		end loop;

		if iCount > 0 then
			vPril := replace(trim (vPril, '#'), '#', ', ');
			return 'Перед отключением приложения необходимо удалить фильтр "Отражать счета, отсутствующие в продукте "Резервирование" из профилей настроек формы 0409115 c кодами: '||vPril;
		end if;

