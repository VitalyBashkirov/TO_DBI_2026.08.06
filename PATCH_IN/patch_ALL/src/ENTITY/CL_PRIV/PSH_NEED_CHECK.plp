class CL_PRIV;

@name('[ПСБ] Установка признака "Требует проверки"') /* Свойство операции "Наименование" */
method PSH_NEED_CHECK is

/* Секция глобальных переменных */
@name('Буфер обмена с клиент-скриптом')
public V_CS_BUF [STRING];
/* Конец секции глобальных переменных */
	
/* Описания */

cvNeedCheckPropertyYes		constant varchar2(3) := 'YES';
cvNeedCheckPropertyNo		constant varchar2(2) := 'NO';
 vNeedCheckPropertyRef				 ref [PROPERTIES];
cvNeedCheckPropertyGrpRef	constant ref [PROPERTY_GRP] := getNeedCheckPropertyGrpRef();

public function getNeedCheckPropertyGrpRef return ref [PROPERTY_GRP] is
begin
	for (select x(x :c_ref)
		 in ::[PROPERTY_GRP]
		 where x.[CODE] = 'PP_NEED_CHECK'
		 and instr(x.[CLASSES_LIST], 'CL_PRIV') > 0
		)
	loop
		return x.c_ref;
	end loop;
	return null;
end;

function getPropertyValue(pNeedCheck boolean) return varchar2 is
begin
	return case when pNeedCheck then cvNeedCheckPropertyYes else cvNeedCheckPropertyNo end;
end;

/* Блок инициализации */

/* Описания */

PSH_NEED_CHECK
/* Секция параметров операции */
(
	@name('Требует проверки') P_NEED_CHECK in [BOOLEAN]
) 
/* Конец секции параметров операции */
	 is

validate is /* Секция "Проверка" */
begin
	if P_MESSAGE = 'DEFAULT' then
		P_NEED_CHECK	:= false;
		V_CS_BUF		:= 'null';
		for (select x(x			:c_prop_ref
					 ,x.[STR]	:c_prop_str
					 )
			 in this.[ADD_PROP]
			 where x.[GROUP_PROP] = cvNeedCheckPropertyGrpRef
			)
		loop
			vNeedCheckPropertyRef	:= x.c_prop_ref;
			P_NEED_CHECK			:= case when x.c_prop_str = cvNeedCheckPropertyYes then true else false end;
			V_CS_BUF				:= case when x.c_prop_str = cvNeedCheckPropertyYes then 'true' else 'false' end;
		end loop;
	end if;
end;

execute is /* Секция "Тело" */
begin
	if vNeedCheckPropertyRef is not null then
		vNeedCheckPropertyRef.[STR] := getPropertyValue(P_NEED_CHECK);
	else
		declare
			vProperty [PROPERTIES];
		begin
			vProperty.[GROUP_PROP]	:= cvNeedCheckPropertyGrpRef;
			vProperty.[STR]			:= getPropertyValue(P_NEED_CHECK);
			this.[ADD_PROP]%insert(vProperty);
		end;
	end if;
end;

end; 
end; /* конeц method PSH_NEED_CHECK */
