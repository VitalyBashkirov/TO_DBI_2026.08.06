public function GetDTPayContragent_noNDS_PRC_DT(p_acc ref [AC_FIN], p_INN string, p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is  -- KAS 21/05/2020 по задаче Шмидт для представления
