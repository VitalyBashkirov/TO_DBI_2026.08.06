class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Платежи 40807')
static method PSH_DOCUM_40807 is
PSH_DOCUM_40807 (
	@name('Дата начала')    P_DATE   in [DATE] default null,
	@name('Дата окончания') P_DATE_K in [DATE]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE := [SYSTEM]::[OP_DATE];
end if;
-- End initialization of parameters and variables
declare
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma macro (xl,'::[OOXML].[API_XL]');
iFmt1		integer;
iFmt2		integer;
iRow		number;
nRow		number;
iBorder		integer;
xl_tmpl 		blob := empty_blob();

begin
	
	if P_MESSAGE = 'DEFAULT' then
	    P_DATE := trunc(::[SYSTEM].[OP_DATE],'month');
		P_DATE_K := ::[SYSTEM].[OP_DATE];
	end if; --*/

	if P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'OK' then
	   ::[SHABLON_DOC].[LIB_OOXML].xl_init;
       &xl.Open_Sheet(1);			
       &xl.RenameSheet(1,to_char(P_DATE,'dd.mm.yy')); 	
			
			
	iRow := 1;
	nRow := 1;
	
	iFmt1 := &xl.Get_numFmt ('###0');
	iFmt2 := &xl.Get_numFmt ('#,##0.00');
	iBorder := &xl.get_border(p_top==&xl.xl_b_thin, p_bottom==&xl.xl_b_thin, p_left==&xl.xl_b_thin, p_right==&xl.xl_b_thin);
	
    &xl.Write(iRow, 1, 'Дата');
    &xl.Write(iRow, 2, 'Сумма');
    &xl.Write(iRow, 3, 'Счет по кредиту');
    &xl.Write(iRow, 4, 'Получатель');
    &xl.Write(iRow, 5, 'Плательщик');
    &xl.Write(iRow, 6, 'Назначение платежа');
	&xl.set_column_width(10,1);
	&xl.set_column_width(15,2);
	&xl.set_column_width(30,3);
	&xl.set_column_width(30,4);
	&xl.set_column_width(21,5);
	&xl.set_column_width(70,6);
    
    
    &xl.set_autofilter(1,1,1,6);
    
    /*&xl.New_Sheet('Клиенты');			
    &xl.Open_Sheet(2);			
    &xl.Write(iRow, 1, 'Номер счета');
    &xl.Write(iRow, 2, 'id клиен');--*/

	for (
	        select d(
				      d  					: c_id			
				    , d.[SUM]				: c_sum
				    , d.[SUM_NT]			: c_sum_nt
				    , d.[ACC_DT].[MAIN_V_ID]: c_num_dt
				    , d.[ACC_KT].[MAIN_V_ID]: c_num_kt
				    , d.[ACC_KT].[CLIENT_V].[NAME]: c_name_kt
				    , d.[DATE_EXEC]         : c_date_exec 
					, d.[NAZN]   : c_nazn
					--, d.[ACC_DT].[CLIENT_V].[NAME] :c_client_name_d
					--, d.[ACC_DT].[CLIENT_V]		   :c_client_id_d
					--, d.[ACC_KT].[CLIENT_V].[NAME] :c_client_name_k
					--, d.[ACC_KT].[CLIENT_V]		   :c_client_id_k
					,coalesce(d.[KL_DT].[2].[2], d.[KL_DT].[1].[1].[NAME])	: c_name_d
					,coalesce(d.[KL_KT].[2].[2], d.[KL_KT].[1].[1].[NAME])	: c_name_k
					
					
						) in ::[MAIN_DOCUM]
						where
						substr(d.[ACC_KT].[MAIN_V_ID],1,5)='40807'  and (substr(d.[ACC_DT].[MAIN_V_ID],1,5)='30102' or  substr(d.[ACC_DT].[MAIN_V_ID],1,5)='47416')
						and  trunc(d.[DATE_EXEC])>=trunc(P_DATE) and trunc(d.[DATE_EXEC])<=trunc(P_DATE_K)
						
						and  d%state='PROV'
						
				order by 5,6
					
	)loop
	    
	
		iRow :=	iRow + 1;	
		

        &xl.put(iRow,1, to_char(d.c_date_exec,'dd/mm/yyyy'));      
        &xl.put(iRow,2, d.c_sum_nt);
        --&xl.put(iRow,3, d.c_num_kt);
        &xl.put(iRow,3, d.c_name_kt);
        &xl.put(iRow,4, d.c_name_k);	
        &xl.put(iRow,5, d.c_name_d);      
        &xl.put(iRow,6, d.c_nazn);
        
        
         

        
		--*/
	end loop;
	
	-- Границы таблицы
	&xl.Open_Sheet(1);		
	&xl.Set_Format_Range(2, 1, iRow, 6, p_borderId == iBorder);
    
			--Формируем результат
			&xl.finish(xl_tmpl);
	
			[OOXML]::[API_ORSA].putReport2RunExtProc(xl_tmpl,'xlsx','Платежи 40807 '||to_char(P_DATE_K,'dd.mm.yy')||' ');														

		end if; -- p_info
	end if; -- p_messge
End;
end;

execute is

begin
 null;							
end;
end;
end;
