-- ============================================================================
-- Правило: v5.STYLE.BAD_PREFIX.п.4.3
-- Описание: Не корректный префикс
-- Категория: STYLE
-- Приоритет: high
-- Теги: prefix, naming, style
-- 3.RUBRICATOR_FIXES.md: Не корректный префикс
-- 4.RUBRICATOR_PROMPTS.json:
--   documentation_text: Имена переменных и параметров должны соответствовать стандартам именования.
--   plplus_materials_note: В PL+ используются префиксы: p_ - параметры, v_ - переменные, cn_ - константы.
--   search_prompt: Найти объявления с нестандартными префиксами.
--   code_example_bad: idx VARCHAR2(100);
--   code_example_bad2: t_ref TAB_TYPE;
--   fix_instruction: Переименовать с правильным префиксом: v_idx, gt_ref_tab_type.
-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_BAD_PREFIX_p_4_3 IS
    idx VARCHAR2(100);
    t_ref TAB_TYPE;
    p_var NUMBER;
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.BAD_PREFIX.п.4.3 Не корректный префикс =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- idx VARCHAR2(100); -- должно быть v_idx
        -- t_ref TAB_TYPE;    -- должно быть gt_ref_tab_type
        
        -- [+] ПРАВИЛЬНО
        v_idx VARCHAR2(100);
        gt_ref_tab_type TAB_TYPE;
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;

-- ============================================================================
-- Правило: v5.STYLE.PREFIX_TYPE.п.4.4
-- Описание: Наименование переменной не содержит префикс типа
-- Категория: STYLE
-- Приоритет: high
-- Теги: prefix, type, naming
-- 3.RUBRICATOR_FIXES.md: Наименование переменной не содержит префикс типа
-- 4.RUBRICATOR_PROMPTS.json:
--   documentation_text: Переменные должны содержать префикс типа: s_ - строка, n_ - число, d_ - дата, r_ - ссылка.
--   plplus_materials_note: Префиксы типа помогают понимать тип переменной при чтении кода.
--   search_prompt: Найти переменные без префикса типа.
--   code_example_bad: name VARCHAR2(100);
--   code_example_bad2: date_val DATE_TIME;
--   fix_instruction: Добавить префикс типа: sName, dDateVal.
-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_PREFIX_TYPE_p_4_4 IS
    name VARCHAR2(100);
    date_val DATE_TIME;
    rClLastChange REF [CLIENT];
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.PREFIX_TYPE.п.4.4 Наименование переменной не содержит префикс типа =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- name VARCHAR2(100);      -- должно быть sName
        -- date_val DATE_TIME;     -- должно быть dDateVal
        
        -- [+] ПРАВИЛЬНО
        sName VARCHAR2(100);
        dDateVal DATE_TIME;
        rClLastChange REF [CLIENT];
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;

