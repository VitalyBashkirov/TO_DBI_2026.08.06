class CL_PRIV;

@import_plsql(true)
@name('[ПСБ] RBO. Библиотека для работы с физ. лицами через DB_LINK 1')
@tag('COPIED')
/*
 * Скопировано для переопределения типа MigrCardType для миграционной карты.
 * Т.к. в дистрибутвной операции не учитывается серия карты - О_О !!!
 * Возможно это временное решение.
 */
library PSH_DBLINKCLIENT is
--public pragma macro (lib_cl, '::[CL_PRIV].[DB_LINK_CLIENT]');
public pragma macro (lib_cl, '::[CL_PRIV].[PSH_DBLINKCLIENT]');

--#include [INTERFACE].[COMPILE_LIB]

/*********************************************************************
Описание структур для создания/обновления досье физического лица.
Вспомогательные структуры.
*********************************************************************/
--Счета в банках
public type AccsBankType is record	(
							 BANK			Varchar(100)	--Наименование банка
							,DATE_BEGIN		date			--Дата открытия
							,DATE_END		date			--Дата закрытия
							,INN			Varchar(12)		--ИНН
							,MAIN_V_ID		Varchar(25)		--Номер счета
							,NAME_ORG		Varchar(160)	--Наименование организации
							,NOTES			Varchar(2000)	--Назначение
							,PR_FORM		boolean			--Признак формирования п/п
							,TYPE_			Varchar(20)		--Код типа счета
							,USH			Varchar(20)		--Код участника расчетов
							);
--Список счетов в банках
public type AccsBankTable is table of AccsBankType;

--Адреса
public type AddressType is record	(
							 ADDR_TYPE		Varchar2(20)	--Тип адреса
							,COUNTRY		Varchar2(50)	--Государство (буквенный код - альфа 3)
							,KLADR_CODE		Varchar2(50)	--Код КЛАДР, принадлежащий улице, городу или ре-гиону
							,POST_CODE		Varchar2(50)	--Индекс
							,REGION			Varchar2(128)	--Регион (обл., край, респ) (наименование)
							,DISTRICT		Varchar2(128)	--Район региона (наименование)
							,CITY			Varchar2(128)	--Населенный пункт (наименование)
							,CITY_TYPE		Varchar2(50)	--Тип населенного пункта
							,STREET			Varchar2(128)	-- Улица населенного пункта (наименование)
							,HOUSE			Varchar2(50)	--Дом
							,KORPUS			Varchar2(50)	--Корпус/строение
							,FLAT			Varchar2(50)	--Квартира
							,IMP_STR		Varchar2(250)	--Адрес строкой
							,REG_PLACE_CODE Varchar2(20)
							,REG_PLACE_NAME Varchar2(250)
							);
--Список адресов
public type AddressTable is table of AddressType;

--Место рождения
public type BornType is record		(
							 COUNTRY		Varchar2(100)	--Государство (буквенный код ? альфа 3)
							,REGION			Varchar2(100)	--Регион (обл., край, респ) (наименование)
							,CITY			Varchar2(250)	--Населенный пункт (наименование)
							,CITY_TYPE		Varchar2(50)	--Тип населенного пункта
							,KLADR_CODE		Varchar2(20)	--Код КЛАДР, принадлежащий городу
							);

--Операции клиента
public type ClOperType is record	(
							 OPER_COUNT		Varchar2(20)	--Число операций за квартал
							,OPER_DATE		date		 	--Дата
							,OPER_SUM		number			--Общая сумма операции
							,OPERATION		Varchar2(100)	--Название операции
							);
--Список операций клиента
public type ClOperTable is table of ClOperType;

--Контакты для связи
public type ContactType is record	(
							 ACTIV			boolean			--Признак действия контакта
							,NUMB			Varchar2(100)	--Номер (адрес) контакта
							,PRIVATE		Varchar2(16)	--Код принадлежности контакта
							,TYPE_			Varchar2(16)	--Код типа связи контакта
							);
--Список контактов для связи
public type ContactTable is table of ContactType;


--Склонения наименований
public type DeclFioType is record	(
							 CASE_GR		Varchar2(16)	--Код падежа
							,NAME			Varchar2(100)	--Склоненное наименование
							);
--Список склонений наименований
public type DeclFioTable is table of DeclFioType;

--История характера отношений с банком
public type DispositType is record	(
							 DISPOSITION	Varchar2(3)		--Код характера отношений с банком
							,DATE_BEG		date	 		--Дата начала действия отношения
							,DATE_END		date 			--Дата окончания действия отношения
							);
--Список истории характера отношений с банком
public type DispositTable is table of DispositType;

--Удостоверения
public type CertificType is record	(
							 TYPE_			Varchar2(128)	--Тип удостоверения клиента
							,SER			Varchar2(32)	--Серия удостоверения клиента
							,NUM			Varchar2(32)	--Серия удостоверения клиента
							,WHO			[CERTIFICATE].[WHO]%type	--Организация, выдавшая паспорт
							,DATE_			date			--Дата выдачи
							,DATE_END		date			--Дата окончания действия
							,DEPART_CODE	Varchar2(20)	--Код подразделения, выдавшего паспорт
							,PLACE			varchar2(250)	--Место выдачи
							,MAIN			boolean			--Признак основного удостоверения
							,VALID_BEFORE	date			--Действует по
							);
--Список удостоверений
public type CertificTable is table of CertificType;

--Налоговая инспекция
public type InspectType is record	(
							 DATE_			date			--Дата регистрации в налоговом органе
							,INSPECTOR		Varchar2(100)	--Инспектор
							,NUM			Varchar2(10)	--Номер налоговой инспекции
							,NOTES			Varchar2(2000)	--Примечание
							);
--Список налоговых инспекций
public type InspectTable is table of InspectType;

--Допустимое наименование клиента
public type NamesType is record	(
							 DATE_			date			--Дата
							,FLAG_NO		boolean			--Признак "Запрещено использовать"
							,FLAG_YES		boolean			--Признак "Разрешено использовать"
							,NAME			Varchar2(250)	--Допустимое наименование
							);
--Список допустимых наименований клиента
public type NamesTable is table of NamesType;

--Миграционная карта
public type MigrCardType is record	(
							 CARD_NUM		varchar2(16)	--Номер миграционной карты
							,CARD_SERIA		varchar2(16)	--Серия миграционной карты
							,DATE_BEG		date			--Дата начала действия миграционной карты
							,DATE_END		date			--Дата окончания действия миграционной карты
							);
--Список миграционных карт
public type MigrCardTable is table of MigrCardType;

--Трудовая деятельность клиента
public type WorkActivityType is record	(
							 CORP			varchar2(1000)	--Наименование организации
							,INN_CORP		varchar2(10)	--ИНН организации
							,JOB_ADDRESS	AddressType		--Адрес организации
							,RANGE			varchar2(250)	--Должность
							,START_DATE		date			--Дата начала работы в организации
							,PHONE			varchar2(100)	--Телефон организации
							);
--Список трудовой деятельности клиента
public type WorkActivityTable is table of WorkActivityType;

/*********************************************************************
Описание структур для создания/обновления досье физического лица.
Основные структуры.
*********************************************************************/
--Запрос на создание досье физического лица
public type ReqClPrivType is record(
							 CONFORM_EXT_CODE	boolean			--Признак использования справочника соответствия кодов из внешних систем
							,ID_EXT				Varchar(128)	--ID в передающей Системе (в РБО)
							,ID_INT				Varchar(128)	--ID в принимающей Системе (в ИБСО)
							,NAME				Varchar2(512)	--Наименование клиента
							,LAST_NAME			Varchar(128)	--Фамилия клиента
							,FIRST_NAME			Varchar(128)	--Имя клиента
							,SUR_NAME			Varchar(128)	--Отчество клиента
							,ACCS_BANK			AccsBankTable	--Контейнер счетов в других банках - массив "Счета в банках"
							,ADDRESSES			AddressTable	--Контейнер, содержащий данные об адресах клиента
							,BORN				BornType		--Контейнер параметров место рождения клиента
							,CL_OPER			ClOperTable		--Контейнер операций клиента - массив "Операции клиента"
							,OKONH				Varchar2(2000)	--Действующий код ОКОНХ(перечисление с разделителем)
							,COM_STATUS			Varchar2(16)	--Код статуса
							,CONTACTS			ContactTable	--Контейнер контактов клиента - массив "Контакты для связи"
							,COUNTRY			Varchar2(2000)	--Cтрана гражданства клиента
							,DATE_OP			date 			--Дата заведения досье клиента
							,MODIFY_DATE		date 			--Дата последних изменений
							,DATE_PERS			date 			--Дата рождения клиента
							,DECL_FIO			DeclFioTable	--Контейнер данных о склонении наименований клиента - массив "Склонения наименований"
							,DEPART				Varchar2(16)	--Код подразделения
							,DISPOSITS			DispositTable	--Контейнер отношений клиента с банком - массив "История характера отношений с банком"
							,CERTIFICATES		CertificTable	--Контейнер удостоверений клиента - массив "Удостоверения"
							,FAIL_LEVEL			Varchar2(16)	--Код уровня риска клиента по легализации
							,FAIL_MARK			Varchar2(2000)	--Обоснование уровня риска клиента по легализации
							,FILIAL				Varchar2(4)		--Код филиала
							,GROUP_LINK			Varchar2(16)	--Номер группы взаимосвязанных клиентов
							,I_NAME				Varchar2(250)	--Интернациональное наименование клиента
							,INN				Varchar2(12)	--ИНН клиента
							,INSPECT			InspectTable	--Контейнер налоговых инспекций - массив "Налоговая инспекция"
							,INTERNAL_CODE		Varchar2(25)	--Внутренний код для импорта
							,LOW				Varchar2(2000)	--Отношения с законом
							,MARIGE_STATUS		Varchar2(16)	--Код семейного положения
							,NAMES				NamesTable		--Контейнер допустимых наименований клиента - массив "Допустимые наименования клиента"
							,NOTES				Varchar2(2000)	--Примечание
							,OPER_CHARACTER		Varchar2(2000)	--Характеристика операций
							,REG_STATUS			Varchar2(20)	--Код статуса зарегистрированного лица
							,REGISTR_NUM		Varchar2(9)		--Регистрационный номер
							,RESIDENT			boolean			--Признак налогового резидентсва
							,RESIDENT_VAL		boolean			--Признак валютного резидентства
							,IPDL_TYPE			Varchar2(16)	--Код принадлежности к ИПДЛ
							,SEX				Varchar2(16)	--Код пола клиента
							,VID_CL				Varchar2(16)	--Категория клиента
							,VISA_INFO			Varchar2(2000)	--Сведения о въездной визе (для нерезидентов)
							,MIGR_CARD			MigrCardTable	--Список миграционных карт
							,WORK_ACTIVITY		WorkActivityTable--Список трудовой деятельности клиента
							,CODEWORD			Varchar2(100)	--Кодовое слово
							,SNILS				Varchar2(30)	--СНИЛС клиента
							,CRS_INVEST_NATIONALITY			varchar2(255)
							,CRS_TIN						varchar2(255)
							,CRS_TIN_ABSCENCE				varchar2(255)
							,CRS_REASON_FOR_TIN_ABSCENCE	varchar2(255)
							,CRS_SUBREASON_FOR_TIN_ABSCENCE	varchar2(255)
							,NEED_CHECK						varchar2(255)							
							,PP_FOREIGN_PUBLIC_OFFICIAL		varchar2(1024)
							,PP_INTERNATIONAL_PUBLIC_OFFICIAL	varchar2(1024)
							,PP_RUSSIAN_PUBLIC_OFFICIAL		varchar2(1024)
							,PP_PURPOSE_OF_RELATIONSHIP		varchar2(1024)
							,PP_PURPOSE_OF_ACTIVITY			varchar2(1024)
							,PP_FINANCIAL_STATUS			varchar2(1024)
							,PP_BUSINESS_REPUTATION			varchar2(1024)
							,PP_SOURCE_OF_FUNDS				varchar2(1024)
							,PP_NEED_CHECK					varchar2(1024)
							);

pragma Include([RUNTIME]::[DEBUG_MACRO]);
pragma Include([RUNTIME].[MACRO_LIB]);
pragma include([CLIENT_INTERFACE].[PRX_CIT]);
pragma macro (prx_cit, '::[CLIENT_INTERFACE].[PRX_CIT]');
pragma macro (lib_conf_code, '::[CLIENT_INTERFACE].[PRX_CIT]');

--Код текущей системы-абонента
current_ab_code varchar2(16);

--Макросы для ведения статистики времени обработки, используемые при получении запроса через Интегратор
procedure start_timer(p_timer_code varchar2(64))
is
begin
	if [CIT_INTERFACE].[CL_PRIV_INT].is_starting then
		&start_timer(p_timer_code)
	end if;
end;

procedure finish_timer(p_timer_code varchar2(64))
is
begin
	if [CIT_INTERFACE].[CL_PRIV_INT].is_starting then
		&finish_timer(p_timer_code)
	end if;
end;

--pragma macro(debug,'stdio.put_line_pipe([1],''DB_LINK_CLIENT'');',substitute);

function get_cert_type
	( p_ext_code varchar2(100)
	, p_conform_ext_code boolean
	, p_error_msg out varchar2(4000)
	)
	return ref [CERTIFIC_TYPE]
is
	v_cert_type ref [CERTIFIC_TYPE];
begin
	if nvl(p_conform_ext_code,false) and current_ab_code is not null then
		begin
			v_cert_type%id := &lib_conf_code.get_ibso_ref(current_ab_code, [CERTIFIC_TYPE]%class, p_ext_code);
		exception when message.app_exception then
			p_error_msg := substr('Ошибка получения типа удостоверения с кодом "'||p_ext_code||'" из справочника "Справочник соответствия кодов из внешних систем". Текст ошибки: '||sqlerrm,1,2000);
		end;
	else
		begin
			v_cert_type := ::[CERTIFIC_TYPE](upper(KOD) = upper(p_ext_code));
		exception when NO_DATA_FOUND then
			begin
				v_cert_type := ::[CERTIFIC_TYPE](upper(CODE_GNI) = upper(p_ext_code));
			exception when NO_DATA_FOUND then
				p_error_msg := 'Не найден тип удостоверения с кодом или кодом ГНИ '||p_ext_code;
			when TOO_MANY_ROWS then
				p_error_msg := 'Найдено несколько типов удостоверений с кодом ГНИ '||p_ext_code;
			end;
		when TOO_MANY_ROWS then
			p_error_msg := 'Найдено несколько типов удостоверений с кодом '||p_ext_code;
		end;
	end if;
	return v_cert_type;
end;

procedure extract_snils_from_cert
	( p_snils in out varchar2(30)
	, p_certificates in out CertificTable
	, p_conform_ext_code boolean := false
	)
is
	idx pls_integer;
	idx_prev pls_integer;
	idx_next pls_integer;
	v_cert_type_snils ref [CERTIFIC_TYPE];
	function cert_type_is_snils(p_type varchar2) return boolean is
		v_err_msg varchar2(4000);
	begin
		if v_cert_type_snils is null then
			for (select t(t:cert_type_snils) in ::[CERTIFIC_TYPE] where t.[KOD] = 'СНИЛС') loop
				v_cert_type_snils := t.cert_type_snils;
			end loop;
		end if;
		return nvl(v_cert_type_snils = get_cert_type(p_type,p_conform_ext_code,v_err_msg), false);
	exception
		when message.app_exception then
			return false;
	end;
begin
	&debug('<extract_snils_from_cert>',0)
	p_snils := regexp_replace(p_snils,'\D+');
	&debug('p_snils = '||p_snils,0)
	idx := p_certificates.first;
	while idx is not null loop
		&debug('p_certificates('||idx||').TYPE_ = '||p_certificates(idx).TYPE_,0)
		if cert_type_is_snils(p_certificates(idx).TYPE_) then -- Тип удостовереня опознан как "СНИЛС"
			p_snils := coalesce(p_snils,regexp_replace(p_certificates(idx).NUM,'\D+'));
			&debug('p_snils = '||p_snils,0)
			-- Сдвигаем все последующие элементы в сторону удаляемого, чтобы сохранить плотную нумерацию (чтобы не переписывать обработку массива)
			idx_prev := idx;
			idx_next := p_certificates.next(idx_prev);
			while idx_next is not null loop
				p_certificates(idx_prev) := p_certificates(idx_next);
				idx_prev := idx_next;
				idx_next := p_certificates.next(idx_prev);
			end loop;
			p_certificates.delete(idx_prev);
		end if;
		idx := p_certificates.next(idx);
	end loop;
	&debug('</extract_snils_from_cert>',0)
end;

public function create_client(	ext_id reference,				-- ссылка на открытый счёт в др. системе
						int_id reference,
						acc_bank varchar2(32000),		-- счета в банках		массив
														--		* Банк
														--		* Дата открытия
														--		* Дата закрытия
														--		* ИНН
														--		* Номер счета
														--		* Наименование организации
														--		* Назначение
														--		* Признак формиров...
														--		* код типа счета
														--		* код Участника расчетов
						addresses varchar2(32000),		-- адреса				массив
														--		* код города
														--		* район
														--		* квартира
														--		* дом
														--		* корпус
														--		* почтовый код
														--		* улица
														--		* код типа адреса
						born varchar2(2000),			-- место рождения		код города из NAMES_CITY
						cl_oper varchar2(32000),		-- операции клиента		массив
														--		* количество операций
														--		* дата
														--		* сумма
														--		* имя метакласса операции
						codes_okonh varchar2(32000),	-- коды ОКОНХ			массив
														--		* код оконх
						com_status	varchar2(16),		-- обобщенный статус	CODE из COM_STATUS_PRD
						contacts varchar2(32000),		-- контакты				массив
														--		* активен
														--		* номер (адрес)
														--		* принадлежность
														--		* тип связи
						country	varchar2(3),			-- гражданство			CODE из COUNTRY
						date_ank date,					-- дата заполн. анкеты
						date_pers date,					-- дата рождения
						decl_fio varchar2(32000),		-- склонения			массив
						depart varchar2(16),			-- подразделение		CODE из DEPART
						disposit varchar2(32000),		-- хар. отнош с банком	массив
						doc	varchar2(32000),			-- удостоверения		массив
						fail_level varchar2(16),		-- уровень риска		CODE из FAIL_LEVEL
						fail_mark  varchar2(32000),		-- оц.риска легализ.дох.MEMO
						branch	varchar2(3),			-- филиал				CODE из FILIAL
						group_link varchar2(200),		-- группа связ.клиентов NUM из GROUP_LINK
						i_name	varchar2(160),			-- интернац. наименов.
						inn	varchar2(12),				-- ИНН
						inspect varchar2(32000),		-- налоговая инспекция	массив
						internal_code varchar2(25),		-- внутренний код
						--limit_cred number(22,2),		-- лимит кредитования
						--limit_val varchar2(3),		-- CODE_ISO из FT_MONEY
						law	varchar2(32000),			-- отнош. с законом		MEMO
						marige_status varchar2(16),		-- семейн. статус		CODE из FAMILY_TYPE
						name varchar2(160),				-- наименование
						names varchar2(32000),			-- допустимые наименов.	массив
						notes varchar2(32000),			-- примечание			MEMO
						oper_character varchar2(32000),	-- характеристика опер.	MEMO
						REG_STATUS varchar2(20),		-- Статус лица			REG_STATUS из PERSON_STAT
						REGISTR_NUM	number(9,0),		-- Регистрационный номер
						RESIDENT	BOOLEAN,			-- Резидент
						RES_INFO	varchar2(32000),	-- Резервирование.		массив
						SEX	varchar2(16),				-- Пол					CODE из SEX
						VID_CL	varchar2(16),			-- Категория клиента	CODE из CL_GROUP
						VISA_INFO varchar2(32000),		-- Сведения о въездной визе (нерезидент)
						error_message in out varchar2(200),
						last_name varchar2(128) default null,	-- Фамилия клиента.
						first_name varchar2(128) default null,	-- Имя клиента.
						sur_name varchar2(128) default null		-- Отчество клиента.
						) return Reference is
--------------------------------------------------------------------------------
sep             const varchar2(3)  := ';';				-- Разделитель
client_ref		Ref [CL_PRIV];
ReqClPriv		&lib_cl.ReqClPrivType;
ret_value		integer;
new_id			ref [RBS_SYNC_OBJ];
--------------------------------------------------------------------------------
Function getNextValue (inst in out varchar2(32000)) return varchar2(32000) is
res	varchar2(32000);
pos integer;
Begin
	pos:=instr(inst,sep);
	if pos>0 then
		res:=substr(inst,1,pos-1);
		inst:=substr(inst,pos+1);
		return res;
	else
		res:=inst;
		inst:='';
		return res;
	end if;
End;
--------------------------------------------------------------------------------
function getAccBank(acc_bank varchar2(32000)) return &lib_cl.AccsBankTable is
AccsBank	&lib_cl.AccsBankTable;
cnt			integer := 0;
Begin
	if acc_bank is not null then
		while length(acc_bank)>0 loop
			cnt := cnt + 1;
			AccsBank(cnt).BANK			:= getNextValue(acc_bank);						--Наименование банка
			AccsBank(cnt).DATE_BEGIN	:= getNextValue(acc_bank);						--Дата открытия
			AccsBank(cnt).DATE_END		:= getNextValue(acc_bank);						--Дата закрытия
			AccsBank(cnt).INN			:= getNextValue(acc_bank);						--ИНН
			AccsBank(cnt).MAIN_V_ID		:= getNextValue(acc_bank);						--Номер счета
			AccsBank(cnt).NAME_ORG		:= getNextValue(acc_bank);						--Наименование организации
			AccsBank(cnt).NOTES			:= getNextValue(acc_bank);						--Назначение
			AccsBank(cnt).PR_FORM		:= nvl(getNextValue(acc_bank)=1,false);			--Признак формирования п/п
			AccsBank(cnt).TYPE_			:= getNextValue(acc_bank);						--Код типа счета
			AccsBank(cnt).USH			:= getNextValue(acc_bank);						--Код участника расчетов
		end loop;
	end if;
	return AccsBank;
End;
--------------------------------------------------------------------------------
function getBorn(born_str varchar2(2000)) return &lib_cl.BornType
is
Born &lib_cl.BornType;
begin
	if born_str is not null then
		Born.CITY	 := getNextValue(born_str);
		Born.REGION	 := getNextValue(born_str);
		Born.COUNTRY := getNextValue(born_str);
	end if;
	return Born;
end;
--------------------------------------------------------------------------------
function getAddresses(addresses varchar2(32000)) return &lib_cl.AddressTable
is
AddressTbl	&lib_cl.AddressTable;
cnt			integer := 0;
Begin
	if addresses is not null then
		while length(addresses) > 0 loop
			cnt := cnt + 1;
			AddressTbl(cnt).COUNTRY			:= getNextValue(addresses);	--Государство (буквенный код - альфа 3)
			AddressTbl(cnt).KLADR_CODE		:= getNextValue(addresses);	--Код КЛАДР, принадлежащий улице, городу или региону
			AddressTbl(cnt).POST_CODE		:= getNextValue(addresses);	--Индекс
			AddressTbl(cnt).DISTRICT		:= getNextValue(addresses);	--Район региона (наименование)
			AddressTbl(cnt).CITY			:= getNextValue(addresses);	--Населенный пункт (наименование)
			AddressTbl(cnt).STREET			:= getNextValue(addresses);	--Улица населенного пункта (наименование) или адрес строкой
			AddressTbl(cnt).HOUSE			:= getNextValue(addresses);	--Дом
			AddressTbl(cnt).KORPUS			:= getNextValue(addresses);	--Корпус/строение
			AddressTbl(cnt).FLAT			:= getNextValue(addresses);	--Квартира
			AddressTbl(cnt).ADDR_TYPE		:= getNextValue(addresses);	--Тип адреса
			AddressTbl(cnt).REG_PLACE_CODE	:= getNextValue(addresses);	--Код регистратора
			AddressTbl(cnt).REG_PLACE_NAME	:= getNextValue(addresses);	--Наименование регистратора
		end loop;
	end if;
	return AddressTbl;
end;
--------------------------------------------------------------------------------
function getOperations(operations varchar2(32000)) return &lib_cl.ClOperTable
is
ClOperTbl	&lib_cl.ClOperTable;
cnt			integer := 0;
Begin
	if operations is not null then
		while length(operations)>0 loop
			cnt := cnt + 1;
			ClOperTbl(cnt).OPER_COUNT	:= getNextValue(operations);	--Число операций за квартал
			ClOperTbl(cnt).OPER_DATE	:= getNextValue(operations);	--Дата
			ClOperTbl(cnt).OPER_SUM		:= getNextValue(operations);	--Общая сумма операции
			ClOperTbl(cnt).OPERATION	:= getNextValue(operations);	--Название операции
		end loop;
	end if;
	return ClOperTbl;
End;
--------------------------------------------------------------------------------
function getContacts(contacts varchar2(32000)) return &lib_cl.ContactTable
is
ContactTbl	&lib_cl.ContactTable;
cnt			integer := 0;
Begin
	if contacts is not null then
		while length(contacts)>0 loop
			cnt := cnt + 1;
			ContactTbl(cnt).ACTIV	:= nvl(getNextValue(contacts)=1,false);	--Признак действия контакта
			ContactTbl(cnt).NUMB	:= replace(getNextValue(contacts),chr(15), ';' );				--Номер (адрес) контакта
			ContactTbl(cnt).PRIVATE	:= getNextValue(contacts);				--Код принадлежности контакта
			ContactTbl(cnt).TYPE_	:= getNextValue(contacts);				--Код типа связи контакта
		end loop;
	end if;
	return ContactTbl;
End;
--------------------------------------------------------------------------------
function getDecl(decl varchar2(32000)) return &lib_cl.DeclFioTable
is
DeclFioTbl	&lib_cl.DeclFioTable;
cnt			integer := 0;
Begin
	if decl is not null then
		while length(decl)>0 loop
			cnt := cnt + 1;
			DeclFioTbl(cnt).CASE_GR	:= getNextValue(decl);	--Код падежа
			DeclFioTbl(cnt).NAME	:= getNextValue(decl);	--Склоненное наименование
		end loop;
	end if;
	return DeclFioTbl;
End;
--------------------------------------------------------------------------------
function getDisposit(disposit varchar2(32000)) return &lib_cl.DispositTable
is
DispositTbl	&lib_cl.DispositTable;
cnt			integer := 0;
Begin
	if disposit is not null then
		while length(disposit)>0 loop
			cnt := cnt + 1;
			DispositTbl(cnt).DISPOSITION	:= getNextValue(disposit);							--Код характера отношений с банком
			DispositTbl(cnt).DATE_BEG		:= to_date(getNextValue(disposit),'YYYY-MM-DD');	--Дата начала действия отношения
			DispositTbl(cnt).DATE_END		:= to_date(getNextValue(disposit),'YYYY-MM-DD');	--Дата окончания действия отношения
		end loop;
	end if;
	return DispositTbl;
End;
--------------------------------------------------------------------------------
--------------------------------------------------------------------------------
function getDoc( doc varchar2(32000)) return &lib_cl.CertificTable
is
CertificTbl	&lib_cl.CertificTable;
cnt			integer := 0;
Begin
	if doc is not null then
		while length(doc) > 0 loop
			cnt := cnt + 1;
			CertificTbl(cnt).DATE_			:= getNextValue(doc);					--Дата выдачи
			CertificTbl(cnt).DATE_END		:= getNextValue(doc);					--Дата окончания действия
			CertificTbl(cnt).MAIN			:= nvl(getNextValue(doc)=1,false);		--Признак основного удостоверения
			CertificTbl(cnt).SER			:= getNextValue(doc);					--Серия
			CertificTbl(cnt).NUM			:= getNextValue(doc);					--Номер
			CertificTbl(cnt).PLACE			:= getNextValue(doc);					--Место выдачи
			CertificTbl(cnt).TYPE_			:= getNextValue(doc);					--Тип удостоверения клиента
			CertificTbl(cnt).WHO			:= getNextValue(doc);					--Организация, выдавшая паспорт
			CertificTbl(cnt).DEPART_CODE	:= getNextValue(doc);					--Код подразделения, выдавшего паспорт
			if trim(CertificTbl(cnt).SER||CertificTbl(cnt).NUM) is null then
				CertificTbl.delete(cnt);
				cnt := cnt - 1;
			end if;
		end loop;
	end if;
	return CertificTbl;
End;
--------------------------------------------------------------------------------
function getInspect(insp varchar2(32000)) return &lib_cl.InspectTable
is
InspectTbl	&lib_cl.InspectTable;
cnt			integer := 0;
Begin
	if insp is not null then
		while length(insp)>0 loop
			cnt := cnt + 1;
			InspectTbl(cnt).DATE_		:= getNextValue(insp);		--Дата регистрации в налоговом органе
			InspectTbl(cnt).INSPECTOR	:= getNextValue(insp);		--Инспектор
			InspectTbl(cnt).NUM			:= getNextValue(insp);		--Номер налоговой инспекции
			InspectTbl(cnt).NOTES		:= getNextValue(insp);		--Примечание
		end loop;
	end if;
	return InspectTbl;
End;
--------------------------------------------------------------------------------
function getNames(names varchar2(32000)) return &lib_cl.NamesTable
is
NamesTbl	&lib_cl.NamesTable;
cnt			integer := 0;
Begin
	if names is not null then
		while length(names) > 0 loop
			cnt := cnt + 1;
			NamesTbl(cnt).DATE_		:= getNextValue(names);					--Дата
			NamesTbl(cnt).FLAG_NO	:= nvl(getNextValue(names)=1,false);	--Признак "Запрещено использовать"
			NamesTbl(cnt).FLAG_YES	:= nvl(getNextValue(names)=1,false);	--Признак "Разрешено использовать"
			NamesTbl(cnt).NAME		:= 	getNextValue(names);				--Допустимое наименование
		end loop;
	end if;
	return NamesTbl;
End;

--------------------------------------------------------------------------------
-- НАЧАЛО
--------------------------------------------------------------------------------
Begin
	&sp(a1)
	error_message    := null;
	&debug('check reqs',0)
	ReqClPriv.ID_EXT		:= ext_id;			--ID в передающей Системе (в РБО)
	ReqClPriv.ID_INT		:= int_id;			--ID в принимающей Системе (в ИБСО)
	ReqClPriv.NAME			:= name;			--Наименование клиента
	ReqClPriv.LAST_NAME		:= last_name;		--Фамилия клиента
	ReqClPriv.FIRST_NAME	:= first_name;		--Имя клиента
	ReqClPriv.SUR_NAME		:= sur_name;		--Отчество клиента
	ReqClPriv.OKONH			:= codes_okonh;		--Действующий код ОКОНХ(перечисление с разделителем)
	ReqClPriv.COM_STATUS	:= com_status;		--Код статуса
	ReqClPriv.COUNTRY		:= country;			--Цифровой код страны гражданства клиента
	ReqClPriv.DATE_OP		:= date_ank;		--Дата заведения досье клиента
	ReqClPriv.DATE_PERS		:= date_pers;		--Дата рождения клиента
	ReqClPriv.DEPART		:= depart;			--Код подразделения
	ReqClPriv.FAIL_LEVEL	:= fail_level;		--Код уровня риска клиента по легализации
	ReqClPriv.FAIL_MARK		:= fail_mark;		--Обоснование уровня риска клиента по легализации
	ReqClPriv.FILIAL		:= branch;			--Код филиала
	ReqClPriv.GROUP_LINK	:= group_link;		--Номер группы взаимосвязанных клиентов
	ReqClPriv.I_NAME		:= i_name;			--Интернациональное наименование клиента
	ReqClPriv.INN			:= inn;				--ИНН клиента
	ReqClPriv.INTERNAL_CODE	:= internal_code;	--Внутренний код для импорта
	ReqClPriv.LOW			:= law;				--Отношения с законом
	ReqClPriv.MARIGE_STATUS	:= marige_status;	--Код семейного положения
	ReqClPriv.NOTES			:= notes;			--Примечание
	ReqClPriv.OPER_CHARACTER:= oper_character;	--Характеристика операций
	ReqClPriv.REG_STATUS	:= REG_STATUS;		--Код статуса зарегистрированного лица
	ReqClPriv.REGISTR_NUM	:= REGISTR_NUM;		--Регистрационный номер
	ReqClPriv.RESIDENT		:= RESIDENT;		--Резидент
	ReqClPriv.SEX			:= SEX;				--Код пола клиента
	ReqClPriv.VID_CL		:= VID_CL;			--Категория клиента
	ReqClPriv.VISA_INFO		:= VISA_INFO;		--Сведения о въездной визе (нерезидент)
	--Массивы
	&debug('check arrays',0)
	ReqClPriv.ACCS_BANK		:= getAccBank(acc_bank);	--Контейнер счетов в других банках - массив "Счета в банках"
	ReqClPriv.ADDRESSES		:= getAddresses(addresses); --Контейнер, содержащий данные об адресах клиента
	ReqClPriv.BORN			:= getBorn(born); 			--Контейнер параметров место рождения клиента
	ReqClPriv.CL_OPER		:= getOperations(cl_oper); 	--Контейнер операций клиента - массив "Операции клиента"
	ReqClPriv.CONTACTS		:= getContacts(contacts); 	--Контейнер контактов клиента - массив "Контакты для связи"
	ReqClPriv.DECL_FIO		:= getDecl(decl_fio);		--Контейнер данных о склонении наименований клиента - массив "Склонения наименований"
	ReqClPriv.DISPOSITS		:= getDisposit(disposit);	--Контейнер отношений клиента с банком - массив "История характера отношений с банком"
	ReqClPriv.CERTIFICATES	:= getDoc(doc);				--Контейнер удостоверений клиента - массив "Удостоверения"
	ReqClPriv.INSPECT		:= getInspect(inspect);		--Контейнер налоговых инспекций - массив "Налоговая инспекция"
	ReqClPriv.NAMES			:= getNames(names);			--Контейнер допустимых наименований клиента - массив "Допустимые наименования клиента"
	&debug('create client',0)
	--Обработка клиента
	ret_value := &lib_cl.RegClient(ReqClPriv, client_ref, error_message);
	&debug('client='||client_ref,0)
	&debug('ret_value='||ret_value,0)
	--Обновление записи в справочнике синхронизации аналитических систем
	if client_ref is not null then
		begin
			new_id := null;
			update	r(	r.[NUMBER_RBS]	= ext_id,
						r.[PREV_TIME]	= null,
						r.[PASS_TIME]	= Sysdate,
						r.[RETURN_STR]	= error_message,
						r.[PASS_USER]	= StdLib.User_ID
					)
			in		::[RBS_SYNC_OBJ] all
			where	r.[NUMBER_IBSO] = to_char(client_ref) and
					r.[OBJ_TYPE]	= &prx_cit.c_client_obj_type
			return r%id into new_id;
		exception
			when TOO_MANY_ROWS then
				
				select	r( r%id )
				in		::[RBS_SYNC_OBJ] all
				where	r.[NUMBER_IBSO] = to_char(client_ref) and
						r.[OBJ_TYPE]	= &prx_cit.c_client_obj_type
				fetch 1
				into new_id;
				delete	r
				in		::[RBS_SYNC_OBJ] all
				where	r.[NUMBER_IBSO] = to_char(client_ref) and
						r.[OBJ_TYPE]	= &prx_cit.c_client_obj_type
						and	r%id != new_id;
	
				update	r(	r.[NUMBER_RBS]	= ext_id,
							r.[PREV_TIME]	= null,
							r.[PASS_TIME]	= Sysdate,
							r.[RETURN_STR]	= error_message,
							r.[PASS_USER]	= StdLib.User_ID
						)
				in		::[RBS_SYNC_OBJ] all
				where	r%id = new_id;
		end;
		if new_id is null then
			&prx_cit.AddRecord(client_ref, ext_id, null,
								&prx_cit.c_client_obj_type,
								Null, Null, true, error_message, SysDate, StdLib.User_Id);
		end if;
	end if;
	
	return to_char(client_ref);
 exception when others then
	&rb(a1)
	error_message := 'Ошибка при создании/обновлении досье физического лица: '||::[RUNTIME].[UTILS].error_stack;
End;

/*********************************************************************
Функции обработки запросов.
Основные функции.
*********************************************************************/
pragma macro (replace_e,'replace(replace(upper([1]),''Ё'',''Е''),'' '')',substitute);

/*********************************************************************
Функции обработки запросов.
Основные функции.
*********************************************************************/
--Создание/обновление физического лица с учетом поиска
--	ReqClPriv - структура запроса
--	p_cl_priv - ссылка на созданное/обновленное физическое лицо
--	p_error_msg - текст ошибки, возникшей при обработке
--Функция возвращает целое значение:
--	0 - Клиент обработан успешно
--	> 0 - ошибка при обработке
public function RegClient(ReqClPriv ReqClPrivType, p_cl_priv out ref [CL_PRIV], p_error_msg out varchar2(2000), p_just_return_ok_if_exist boolean := false) return integer is
find_result		integer;
update_result	integer;
reg_result		integer;
V#ADDS			varchar2(2000);
begin
	&sp(a#01)
	--Заполнение кода текущей системы-абонента
	if &tlib.current_ab is not null and nvl(ReqClPriv.CONFORM_EXT_CODE,false) then
		current_ab_code := &tlib.current_ab.[CODE];
	end if;
	--Заполнение наименования клиента из фамилии, имени и отчества, если наименование заполнено не было
	ReqClPriv.NAME		:= trim(ReqClPriv.NAME);
	ReqClPriv.LAST_NAME	:= trim(ReqClPriv.LAST_NAME);
	ReqClPriv.FIRST_NAME:= trim(ReqClPriv.FIRST_NAME);
	ReqClPriv.SUR_NAME	:= trim(ReqClPriv.SUR_NAME);
	if ReqClPriv.NAME is null and ReqClPriv.LAST_NAME is not null then
		ReqClPriv.NAME := ReqClPriv.LAST_NAME;
		if ReqClPriv.FIRST_NAME is not null then
			ReqClPriv.NAME := ReqClPriv.NAME||' '||ReqClPriv.FIRST_NAME;
		end if;
		if ReqClPriv.SUR_NAME is not null then
			ReqClPriv.NAME := ReqClPriv.NAME||' '||ReqClPriv.SUR_NAME;
		end if;
	end if;
	--Поиск клиента
	start_timer('FIND_CLIENT');
	find_result := findClient(ReqClPriv, p_cl_priv, p_error_msg);
	finish_timer('FIND_CLIENT');
	--Обработка результатов поиска
	if find_result = 1 then												--Клиент найден
		if p_just_return_ok_if_exist then
			return 0;
		end if;
		start_timer('UPDATE_CLIENT');
		update_result := UpdateClient(ReqClPriv, p_cl_priv, p_error_msg);--Обновление
		finish_timer('UPDATE_CLIENT');
		if update_result = -1 then 										--Ошибка обновления
			&rb(a#01)
			return 5;
		end if;
		-- Вызов хука без дистрибутивных проверок
		begin
			start_timer('CALL_HOOK');
			::[RUNTIME].[STR].set_par(V#ADDS, 'NEW_CLIENT', '0');
			::[CL_PRIV].[LIB].hook_uya_check_cl_a(p_cl_priv, false, V#ADDS, true);
			finish_timer('CALL_HOOK');
		exception when others then
			-- Причина перехвата others: при возникновении непредвиденной ошибки необходимо продолжить выполнение операции
			&rb(a#01)
			finish_timer('CALL_HOOK');
			p_error_msg := substr('Ошибка при выполнении расширения "УЯ. Дополнительная проверка клиента": '||sqlerrm,1,2000);
			return 7;
		end;
	elsif find_result = 0 then										--Клиент не найден
		start_timer('REG_CLIENT');
		reg_result := CreateClient(ReqClPriv, p_cl_priv, p_error_msg);--Регистрация клиента
		finish_timer('REG_CLIENT');
		if reg_result = -1 then 									--Ошибка регистрации
			&rb(a#01)
			return 6;
		end if;
		-- Дополнительные проверки
		begin
			start_timer('CALL_HOOK');
			::[RUNTIME].[STR].set_par(V#ADDS, 'NEW_CLIENT', '1');
			::[CL_PRIV].[LIB].hook_uya_check_cl_a(p_cl_priv, false, V#ADDS);
			finish_timer('CALL_HOOK');
		exception when others then
			-- Причина перехвата others: при возникновении непредвиденной ошибки необходимо продолжить выполнение операции
			&rb(a#01)
			finish_timer('CALL_HOOK');
			p_error_msg := substr('Ошибка при выполнении расширения "УЯ. Дополнительная проверка клиента": '||sqlerrm,1,2000);
			return 7;
		end;
	elsif find_result = -1 then										--Ошибка поиска
		p_cl_priv := null;
		return 4;
	end if;
	
	return 0;
exception when others then
	&rb(a#01)
	p_error_msg := substr('Ошибка при cоздании/обновлении физического лица: '||sqlerrm,1,2000);
	return 3;
end;


/*********************************************************************
Функции обработки запросов.
Вспомогательные функции.
*********************************************************************/
--Сохранение списка счетов в банках
function save_accs_bank(AccsBank in AccsBankTable, client in out [CL_PRIV], p_error_msg out varchar2(2000)) return integer;
--Сохранение списка адресов
function save_address(AddressList in AddressTable, client in out [CL_PRIV], p_error_msg out varchar2(2000)) return integer;
--Сохранение списка операций клиента
function save_cl_oper(ClOper in ClOperTable, client in out [CL_PRIV], p_error_msg out varchar2(2000)) return integer;
--Сохранение списка действующих кодов ОКОНХ
