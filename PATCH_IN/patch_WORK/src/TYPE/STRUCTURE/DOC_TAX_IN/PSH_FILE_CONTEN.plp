class DOC_TAX_IN;

@import_plsql(true)
@name('[ПСБ] Редактироваь содержимое файла (CLOB)')
@tag('COPIED')
method PSH_FILE_CONTEN is

@name('Клиент-скрипт') public V_VB [STRING_32000];
PSH_FILE_CONTEN (
	@name('Текст сообщения')           P_FILE_CONTENT in [MEMO_32767],
	@name('Дополнительная информация') P_ADD_INFO     in [MEMO]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_ADD_INFO := this.[ADD_INFO];

end if;
-- End initialization of parameters and variables
declare
	v_amount	integer;
	v_err varchar2(32000);
	
	v_clob	clob;
	v_DOM_mess [XML_DB].DOMDocument;
	v_XDB_parser	[XML_DB].Parser;

begin
	if P_MESSAGE = 'DEFAULT' then

		-- Считываем значение реквизита CLOB в текстовый параметр - мемополе
		P_FILE_CONTENT := null;
		
		if this.[FILE_CONTENT] is not null and dbms_lob.getlength( this.[FILE_CONTENT] ) != 0 then
			v_amount := 32000;
			dbms_lob.read(this.[FILE_CONTENT], v_amount, 1, P_FILE_CONTENT);
		end if;
	end if;
	
	if P_MESSAGE = 'VALIDATE' then
		if p_info = 'OK' then
			begin
				[XML_DB].initialize;
				v_XDB_parser := [XML_DB].newParser;			
				[XML_DB].parseBuffer(v_XDB_parser, P_FILE_CONTENT);	
				v_DOM_Mess := [XML_DB].getDocument(v_XDB_parser);

				-- Освобождаем ресурсы
				[XML_DB].freeParser(v_XDB_parser);
				[XML_DB].FREEDOCUMENT(v_DOM_Mess);
			exception
				when others then
					v_err := 'Ошибка разбора XML';
					-- Освобождаем ресурсы
					[XML_DB].freeParser(v_XDB_parser);
					[XML_DB].FREEDOCUMENT(v_DOM_Mess);
			end;
		
			if v_err is not null then
				csmd.command(V_VB,
				'if MsgBox("В сообщении обнаружены ошибки: '|| translate ( v_err, chr (10)||chr(13), ' ') || ' Продолжить формирование сообщения?", vbQuestion + vbYesNo) <> vbYes Then
					Main = null
				end if' );
			end if;
		end if;
	end if;
	
end;
end;

execute is
	v_amount	integer;
	v_clob		clob;
begin
	DBMS_LOB.CREATETEMPORARY(v_clob, TRUE, DBMS_LOB.CALL);
	if P_FILE_CONTENT is not null then
		v_amount := LENGTH(P_FILE_CONTENT);
    	DBMS_LOB.WRITE(v_clob, v_amount, 1, P_FILE_CONTENT);
	end if;
	
	[FILE_CONTENT] := v_clob;
	[ADD_INFO]:=P_ADD_INFO;
end;
end;
end;
