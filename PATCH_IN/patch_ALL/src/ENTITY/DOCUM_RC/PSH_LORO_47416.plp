class DOCUM_RC;

@import_plsql(true)
@name('[ПСБ] Постановка на невыясненные зачислений на Лоро счета')
method PSH_LORO_47416 is
PSH_LORO_47416 is

validate is
begin
	if P_MESSAGE = 'DEFAULT' then
		if not (nvl(this.[AUDIT].[FROM_ROUT],false)
			and this.[DOG_RC].[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT]='L')
			and this.[ISO] = ::[SYSTEM].[SYS_MAIN_VAL].[CUR_SHORT]
			and this%state in ('S_5', 'S_6'))
		then
			pragma error('Данная операция предназначена только для входящих рублёвых платежей на счета Лоро в 5 или 6 статусе!');
		end if;
	end if;
end;

execute is
	v_rec_part	ref [CL_PART]; 
begin
	if this%state in ('S_5', 'S_6')
		and this.[DOG_RC].[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT]='L') 
		and this.[ISO] = ::[SYSTEM].[SYS_MAIN_VAL].[CUR_SHORT] 
	then
		v_rec_part := ::[CL_PART]([CODE] = '0010000000' and [DATE_CL] is null); 
		 if v_rec_part is not null then
			this.[RCCLCODE] := v_rec_part.[CODE];
			this.[RECEIVER].[PART_REF] := v_rec_part;
			this.[DOG_RC] := ::[DOCUM_RC].[LIB_NEW].get_dog(v_rec_part, null, ::[SYSTEM].[SYS_MAIN_VAL]);	
			stdio.put_line_buf('<% CALL DOCUM_RC PROC ' || this%id || ' %>');
		end if;
	end if;
end;
end;
end;
