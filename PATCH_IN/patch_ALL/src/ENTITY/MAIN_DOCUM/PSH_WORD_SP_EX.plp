class MAIN_DOCUM;

@import_plsql(true)
@this(create_on_start:=true)
@name('Печать документов (WORD) (расширение)')
@tag('EXTENSION')
method PSH_WORD_SP_EX is

@name('Клиент скрипт')              public V_VB   [STRING_32000];
@name('Строка для передачи данных') public V_DATA [STRING_32000];
P_DATE_NOTIF [DATE];
P_SIGN_DOL string_100;
P_SIGN_FIO string_100;
str1 string;
PSH_WORD_SP_EX (
	@name('Шаблон документа') P_TEMPLATE in [SHABLON_DOC_REF],
	@name('Дата')             P_DATE     in [DATE],
	@name('Первая подпись')   P_SIGN1    in [USER_REF],
	@name('Вторая подпись')   P_SIGN2    in [USER_REF]
) is

validate is
begin
	&BASE$SETVARS;
	&BASE$VALIDATE;
	&BASE$GETVARS;
	
	if P_MESSAGE = 'DEFAULT' then
		P_SIGN1 :=stdlib.userid;
	end if;
	
	if P_MESSAGE = 'VALIDATE' then

		if p_info = 'OK' then
				begin
					select u(u.[CASTA].[VALUE], stdlib.fio(u.[NAME]))
					in		::[USER]
					where	u = P_SIGN1
					into	P_SIGN_DOL, P_SIGN_FIO;
				exception
					when no_data_found then
						null;	
				end;	

		elsif p_info = '[PSH_ДАТА_ПЕЧАТИ]' then
/********
			begin
				select v(v.[DAT_NOTIFICATION]) in ::[TO_EXPORT] where v.[DOC] = this into P_DATE_NOTIF;
			exception
				when no_data_found or too_many_rows then
					null;
			end;
			if P_DATE_NOTIF is null then
				P_DATE_NOTIF := trunc(sysdate);
			end if;
***********/
			P_DATE_NOTIF := trunc(sysdate);

			V_DATA:= ::[RUNTIME].[VIEWFUN].dat_str(P_DATE_NOTIF);
            V_DATA:=REPLACE(V_DATA,'г.','года');

		elsif p_info = '[PSH_ДАТА_ПРОВ]' then
			V_DATA:= ::[RUNTIME].[VIEWFUN].dat_str(this.[DATE_PROV]);
            V_DATA:=REPLACE(V_DATA,'г.','года');
		elsif p_info = '[PSH_СУММА]' then
			V_DATA := ltrim(to_char(this.[SUM_PO], '9G999G999G999G999D99', 'NLS_NUMERIC_CHARACTERS = ''-,'''));
--		elsif p_info = '[PSH_СУММА_ПРОПИСЬЮ]' then
--			V_DATA :=STDLIB.N2STR(this.[SUM_PO],this.[VALUTA_PO].[CUR_SHORT]);
		elsif p_info = '[PSH_СУММА_ПРОПИСЬЮ]' then
			V_DATA :='('||STDLIB.N2STR(this.[SUM_PO],NULL,1)||'/100) ';
            str1:=trim(Replace(STDLIB.N2STR(this.[SUM_PO],this.[VALUTA_PO].[CUR_SHORT],0),STDLIB.N2STR(this.[SUM_PO],NULL,0)));
            V_DATA:= V_DATA || Upper(Substr(str1,1,1))||Substr(str1,2);
/**
			V_DATA :='('||STDLIB.N2STR(this.[SUM_PO],NULL,1)||'/100) ';
            V_DATA:= V_DATA||Replace(STDLIB.N2STR(this.[SUM_PO],this.[VALUTA_PO].[CUR_SHORT],0),STDLIB.N2STR(this.[SUM_PO],NULL,0));
**/
		elsif p_info = '[НАИМЕНОВАНИЕ_ПОЛУЧ]' then
				V_DATA:=this.[ACC_KT].[CLIENT_V].[NAME];

		elsif p_info = '[PSH_ДОЛЖНОСТЬ]' then
	 		V_DATA := P_SIGN_DOL;	

		elsif p_info = '[PSH_ДАТА_РАСП]' then

		  --V_DATA:= ::[TO_EXPORT].[ADD_CONTR].get_conf_date(this.[DATE_PROV]);
			V_DATA:= CALENDAR.NEXT_DATE('HOLIDAYS','0',TRUNC(this.[DATE_PROV])+1,NVL(Z$FP_TUNE_LIB.GET_NUM_VALUE('CONF_DOCS_DAYS'),15));
			V_DATA:= ::[RUNTIME].[VIEWFUN].dat_str(V_DATA);
            V_DATA:=REPLACE(V_DATA,'г.','года');

		elsif p_info = '[PSH_FIO]' then
			V_DATA:=stdlib.FIO(P_SIGN1.[NAME],'И.О. Ф');
		end if;

	end if;	
	
end;

execute is
begin
	&BASE$SETVARS;
	&BASE$EXECUTE;
end;
end;
end;
