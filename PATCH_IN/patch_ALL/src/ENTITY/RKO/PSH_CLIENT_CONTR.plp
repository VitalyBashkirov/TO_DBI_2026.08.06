class RKO;

@import_plsql(true)
@name('[ПСБ] Расшифровка по клиенту контрагентов(OOXML)')
@tag('COPIED')
method PSH_CLIENT_CONTR is

pragma macro(xl,'[OOXML]::[API_XL]');
pragma include([DEBUG_TRIGGER]::[MACRO_LIB]);	
pragma macro(align_horizontal_center,  '&xl.xl_ah_center');	-- горизонтальное выравнивание по центру

function NumDays( p_dDateBeg date, p_dDateEnd date ) return varchar2(15) 
is

sQuantity		varchar2(5)	default null;

begin	
  sQuantity := to_char(p_dDateEnd - p_dDateBeg + 1);     
  return(sQuantity);  
end;

type TColumnInfoRec is record (
		num number,
        organization varchar2(1000),
		inn varchar2(30),
		innK varchar2(30),
		summa number,
		percent  varchar2(10),
		code_p   varchar2(2000),
		date_reject date,
		risk_level	varchar2(10),
		acc	ref [AC_FIN],
		acc1	ref [AC_FIN],
		--v_acc   varchar2(30),
		v_acc   boolean,
		flag	boolean
		
);
type ColumnInfoTbl is table of TColumnInfoRec index by string(128);
tColumnInfo ColumnInfoTbl;
tColumnInfoR ColumnInfoTbl;

procedure Put(	p_nRow				number,								
				p_nCol				number,								
				p_sValue			varchar2,					
				p_sAllighment		varchar2		default null,		
				p_bBold				boolean			default false		
				) is
				
iFont				integer;				
iFontFormat 		integer;
iBoldFontFormat 	integer;
iBorder				integer;

begin	

	iFontFormat 	:= &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == false, p_rgb == null);
	iBoldFontFormat := &xl.get_font(p_name == 'Arial', p_family == 2, p_fontsize == 8, p_theme == 1, p_underline == false, p_italic == false, p_bold == true, p_rgb == null); 
	if not p_bBold then
		iFont := iFontFormat;
	else
		iFont := iBoldFontFormat;
	end if;	

	&xl.cell(
	           p_row	==	p_nRow,
	           p_col	==	p_nCol,
	           p_value	==	p_sValue,
	           p_fontId	==	iFont,
	           p_horizontal	==	case	
	           						when p_sAllighment = 'R' then 'right'
                    				when p_sAllighment = 'L' then 'left'
                    				when p_sAllighment = 'C' then 'center'
				  				end,
				p_borderId == iBorder
	          );				
	
 	&xl.Set_Format_Range(p_tl_row==p_nRow, 
	 	p_tl_col==1,
	 	p_br_row==p_nRow, 
	 	p_br_col==7, 
	 	p_borderId == &xl.GET_BORDER(p_top == &xl.xl_b_thin,
						  p_bottom	== &xl.xl_b_thin,
						  p_left	== &xl.xl_b_thin,
						  p_right	== &xl.xl_b_thin));


end;

---получаем менеджера клиента
/*function get_cl_info_user(p_rko ref [RKO]) return varchar2(100)
is
v_str   varchar2(100);
begin 	  
  select x(x.[CL_WORK_USERS].[NAME]: t) in [CL_INFO_REQ] where x.[CLIENT]=p_rko.[CLIENT] order by x.[CL_WORK_USERS]%collection desc fetch 1 into v_str;
	   return v_str; 
  exception when NO_DATA_FOUND then
	   return null;  
