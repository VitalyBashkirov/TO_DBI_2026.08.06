class HOOK_BANK;

@import_plsql(true)
@generate_ansi_joins(true)
@name('[ПСБ]. РЦ. Дополнительный анализ после создания проводки.')
@tag('EXP_SWIFT')
method RC_DC_MAIN_1 is
pragma include(::[RUNTIME].[DEBUG_MACRO]);
RC_DC_MAIN_1 (
	@name('Ссылка на документ РЦ')        P_RC_DOC_REF   in [DOCUM_RC_REF],
	@name('Ссылка на созданную проводку') P_NEW_MAIN_DOC in [MAIN_DOCUM_REF]
) is

execute is
vErr 	[MEMO];
v_20	varchar2(1000);
v_sber	ref [CL_BANK_N];
v_tranz	ref [AC_FIN];
begin
	::[PSH_EXP_TRA].[PSH_L].dbg('Вызов HOOK_BANK.EXP_CUR_RC_DIC', 0);
	::[HOOK_BANK].[EXP_CUR_RC_DIC](null,vErr,P_RC_DOC_REF);
	
	P_RC_DOC_REF.[PAYER].[NAME] := coalesce(::[RUNTIME].[STR].get_str_par(P_RC_DOC_REF.[BLOCK_DATA], 'PSB_PAYER_NAME'), P_RC_DOC_REF.[PAYER].[NAME]);
	-->> PSB VRI 12/08/2025 CFT-2161 MT103, поступающих по системе SBER Finline: новая схема проводок  -->> PSH VRI 27/01/2026 CFT-3470
	if P_RC_DOC_REF.[DOG_SD].[CLIENT].[CODE] like 'LK_SBANK%' 
		and P_NEW_MAIN_DOC is not null 
		and P_RC_DOC_REF.[FIRST_REF].[TYPE_DOC] || '.' || P_RC_DOC_REF.[FIRST_REF].[SUB_TYPE] = '001.B'
		and P_RC_DOC_REF.[FIRST_REF].[CRCLCODE] like 'LK_SBANK%'
		and P_RC_DOC_REF%state in ('S_5', 'S_6')
	then
		if P_RC_DOC_REF.[ISO] <> 'RUB' then
			v_sber := ::[CL_BANK_N]([BIC] = '044525225' and [BANK_STATE].[SHORT_NAME] = 'ДЕЙС');
			v_tranz := ::[AC_FIN]([MAIN_V_ID] like '30220%' and [FINTOOL].[CUR_SHORT] = P_RC_DOC_REF.[ISO] and [CLIENT_R] = v_sber);
		end if;

		if P_NEW_MAIN_DOC.[ACC_KT].[MAIN_V_ID] not like '30220%' 
			and P_RC_DOC_REF.[ISO] <> 'RUB' 
			and v_sber is not null
			and v_tranz is not null 
		then
			P_NEW_MAIN_DOC.[ACC_KT] := v_tranz;
			P_NEW_MAIN_DOC.[KL_KT].[1].[1] := P_NEW_MAIN_DOC.[ACC_KT].[CLIENT_V];
			P_NEW_MAIN_DOC.[KL_KT].[1].[2] := P_NEW_MAIN_DOC.[ACC_KT];
			P_NEW_MAIN_DOC.[KL_KT].[2].[1] := P_NEW_MAIN_DOC.[ACC_KT].[MAIN_V_ID];
			P_NEW_MAIN_DOC.[KL_KT].[2].[2] := P_NEW_MAIN_DOC.[ACC_KT].[CLIENT_V].[NAME];
		end if;
		if  P_NEW_MAIN_DOC.[VID_DOC] <> ::[NAME_PAYDOC]([CODE] = 'БЕЗН_БАНК_ОРД') then
			P_NEW_MAIN_DOC.[VID_DOC] := ::[NAME_PAYDOC]([CODE] = 'БЕЗН_БАНК_ОРД');
		end if;

		P_NEW_MAIN_DOC.[NAZN] := 'Перевод средств '
							 		   || nvl(P_NEW_MAIN_DOC.[VALUTA_PO].[CUR_SHORT], P_NEW_MAIN_DOC.[VALUTA].[CUR_SHORT])
							 		   || ' ' || trim(to_char(nvl(P_NEW_MAIN_DOC.[SUM_PO], P_NEW_MAIN_DOC.[SUM]), '9,999,999,999,990.99')) 
									   || ' сумма (' ||  P_RC_DOC_REF.[FIRST_REF].[ISO] || ' ' || trim(to_char( P_RC_DOC_REF.[FIRST_REF].[SUMMA], '9,999,999,999,990.99')) 
									   || '), МТ103 реф.' || replace( P_RC_DOC_REF.[FIRST_REF].[AUDIT].[UNICUM_CODE], '+') || ' от ' 
									   || to_char( P_RC_DOC_REF.[FIRST_REF].[CRDATE], 'DDMMYYYY');

		/*v_20 := P_RC_DOC_REF.[AUDIT].[UNICUM_CODE];	
		if instr(P_NEW_MAIN_DOC.[NAZN], 'референс') > 0 and v_20 is not null and P_NEW_MAIN_DOC.[NAZN] not like '%' || v_20 || '%' then
			P_NEW_MAIN_DOC.[NAZN] := replace(P_NEW_MAIN_DOC.[NAZN], 'референс', 'референс ' || v_20 || ' /RPP/');
		end if;*/
	end if;
	--<< PSB VRI 12/08/2025 CFT-2161 MT103, поступающих по системе SBER Finline: новая схема проводок --<< PSH VRI 27/01/2026 CFT-3470
end;
end;
end;
