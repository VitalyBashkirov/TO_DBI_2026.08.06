--function cl_mon(cl_id number) return number; -- возвращает доход
public function cl_fam(cl_fam number) return memo is  -- возвращает родственников
fam memo;
rez_fam memo;
n integer:=0;
begin
	
	for dp in ::[RELATIVES] all where dp%collection = cl_fam
	loop
		n:=n+1;
		fam:=dp.[NAME]||' ('||dp.[COGNATE_STATUS].[VALUE]||')';
		
		if n = 1 then
			rez_fam:=fam;
		else rez_fam:=rez_fam||chr(10)||fam;
		end if;
		
	end loop;		
		
	return	rez_fam;	
end;

public function cl_email(cl_con number) return memo is  -- возвращает email
mail memo;
rez_mail memo;
n integer:=0;
begin
	
	for dp in ::[CONTACTS] all where dp%collection = cl_con AND dp.[TYPE].[CODE]='MAIL'
	loop
		n:=n+1;
		mail:=dp.[NUMB];
		
		if n = 1 then
			rez_mail:=mail;
		else rez_mail:=rez_mail||chr(10)||mail;
		end if;
		
	end loop;		
		
	return	rez_mail;	
end;

public function cl_phone(cl_con number) return memo is  -- возвращает телефон
ph memo;
rez_ph memo;
n integer:=0;
begin
	
	for dp in ::[CONTACTS] all where dp%collection = cl_con AND (dp.[TYPE].[CODE]='MOBILEPHONE' OR dp.[TYPE].[CODE]='PHONE')
	loop
		n:=n+1;
		ph:=dp.[NUMB];
		
		if n = 1 then
			rez_ph:=ph;
		else rez_ph:=rez_ph||chr(10)||ph;
		end if;
		
	end loop;		
		
	return	rez_ph;	
end;

public function cl_phone_10(cl_con number) return memo is  -- возвращает телефон (формат 10)
ph memo;
rez_ph memo;
n integer:=0;
fn varchar2;

begin
	
	for dp in ::[CONTACTS] all where dp%collection = cl_con AND (dp.[TYPE].[CODE]='MOBILEPHONE' OR dp.[TYPE].[CODE]='PHONE')
	loop
		n:=n+1;
		ph:=dp.[NUMB];
		
		
	ph:=trim(replace(replace(ph,' ',''),chr(9),''));
	ph:=replace(ph,'(','');
	ph:=replace(ph,')','');
	ph:=replace(ph,'-','');
	ph:=replace(ph,'+','');
	
	
	fn:=length(ph);
	if fn = 11 then ph:=substr(ph, 2); end if;
	
	if n = 1 then
			rez_ph:=ph;
	else rez_ph:=rez_ph||chr(10)||ph;
	end if;
	
	end loop;
		
	return	rez_ph;	
end;

