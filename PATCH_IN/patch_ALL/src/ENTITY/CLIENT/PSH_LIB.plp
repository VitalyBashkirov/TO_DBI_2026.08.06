											(md.[KL_DT].[0] = 1 and (substr(md.[ACC_DT].[MAIN_V_ID],1,5) 	in ('40701','40702','40703','40804','40805','40806','40807','40802') ))
											or
											(md.[KL_DT].[0] = 2 and (substr(md.[KL_DT].[2].[1],1,5) 		in ('40701','40702','40703','40804','40805','40806','40807','40802') ))
										)
		loop
			if not checkNaznPlat_ZRP(md.[NAZN]) then
				sm := sm + md.[SUM_NT];
			end if;
		end loop;
	end loop;

	sm1 := 0;	
	for acc in [AC_FIN] where 	acc.[CLIENT_V] = p_client
								and  (acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] >= p_d_beg)
								and acc.[DATE_OP]<=p_d_end -- or acc.[DATE_CLOSE]
	loop
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_KT] = acc
									/*and (
											(md.[KL_DT].[0] = 1 and (substr(md.[ACC_DT].[MAIN_V_ID],1,5) 	in ('40701','40702','40703','40804','40805','40806','40807','40802') ))
											or
											(md.[KL_DT].[0] = 2 and (substr(md.[KL_DT].[2].[1],1,5) 		in ('40701','40702','40703','40804','40805','40806','40807','40802') ))
										)*/
		loop
			--if not checkNaznPlat_ZRP(md.[NAZN]) then
				sm1 := sm1 + md.[SUM_NT];
			--end if;
		end loop;
	end loop;
	if sm1 = 0 then
		return -1;
	else
		return sm/sm1*100;
	end if;
end;


/*
0 - нет счета

*/
public function isAccOpen 			(p_client ref [CLIENT], p_d_beg	[DATE], p_d_end	[DATE]) return varchar(1) is 
ret varchar(1);
closed_in_period boolean;
has_opened 	 boolean;

begin

	ret  := '0';
	closed_in_period  := false;
	has_opened 	      := false;
	
	--debug_pipe('p_d_beg='||p_d_beg||' '||'p_d_end='||p_d_end,0 );
	
	for acc in [AC_FIN] where acc.[CLIENT_V] = p_client and substr(acc.[MAIN_V_ID], 1,5) not in ('40905','40909','40910','40911','40912','40913')
	--and (acc.[DATE_CLOSE] acc.[DATE_CLOSE] >= p_d_beg)-- or acc.[DATE_CLOSE]
	-- бежим по счетам
	loop
		-- если закрыт в диапазоне
		if acc.[DATE_CLOSE] >= p_d_beg and  acc.[DATE_CLOSE] <= p_d_end  then
			closed_in_period := true;
		end if;
		-- если есть открытые
		if acc.[DATE_CLOSE] is null or acc.[DATE_CLOSE] > p_d_end then
			has_opened  := true;
		end if;
		
	end loop;
	
	if closed_in_period and not has_opened then
		ret := '1';
	end if;
	
	return ret;
end;


public function UR_AccSUMOBR 		(p_acc ref [AC_FIN], p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is 
ret varchar(1);
closed_in_period boolean;
has_opened 	 boolean;
--acc_id ref [AC_FIN];
sm number(18,2);

begin

	ret  := '0';
	closed_in_period  := false;
	has_opened 	      := false;
	
	--debug_pipe('p_d_beg='||p_d_beg||' '||'p_d_end='||p_d_end,0 );

	sm := 0;	
	
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_DT] = p_acc
									and (
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,5) =	'40101' ))
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) 	 =	'40101' ))

											/*or
											(md.[KL_DT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,3) in ('423', '426')) )
											or
											(md.[KL_DT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) in ('40817','40820','30232','40802')) )
											or
											(md.[KL_DT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,3) in ('423', '426') ))*/
										)
		loop
			sm := sm + md.[SUM_NT];
		end loop;
		
	
	return sm;
	
end;

