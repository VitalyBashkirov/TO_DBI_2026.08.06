--Воробей В.А. 29.05.2019 Прочие вычисляемые параметры Клиента
function CalcParmClient(p_info string(100), cl ref client) return varchar2(32767) is
clPrivRef  ref [CL_PRIV];
clOrgRef ref [CL_ORG];
ExStr varchar2(32767);
begin
	if    cl%class='CL_PRIV' then clPrivRef:=cl%id;
	elsif cl%class='CL_ORG'  then clOrgRef:=cl%id;
		if ::[LEGAL_INTERFACE].[PRX_CLIENT].isClientCHP(cl) then
			--	Если это инд. предприн. то ищем для него ссылку на физ. лицо:
			clPrivRef := ::[LEGAL_INTERFACE].[PRX_CLIENT].getCHPclPriv(cl);
			&debug('.CalcParmClient -- ИПшник clPrivRef.[NAME]='||clPrivRef.[NAME],dp)
			-- Max длина кода 20 символов !!!
			-- Для старых ИПшников подтягиваем реквизиты из clOrgRef.[REGISTER]
			if  clOrgRef.[REGISTER].[DATE_REESTR] is not null or
				clOrgRef.[REGISTER].[NUM_REESTR] is not null or
				clOrgRef.[REGISTER].[REGISTRAR] is not null or
				clOrgRef.[REGISTER].[REG_PLACE] is not null
			then
				if    p_info='ИП_ДАТА_РЕГИСТРАЦИИ' then ExStr:=nvl(to_char(clOrgRef.[REGISTER].[DATE_REESTR],fmt),'Нет');
				elsif p_info='ИП_ГОС_РЕГ_НОМ'      then ExStr:=nvl(clOrgRef.[REGISTER].[NUM_REESTR]              ,'Нет');
				elsif p_info='ИП_НАИМ_РЕГ_ОРГАН'   then ExStr:=nvl(clOrgRef.[REGISTER].[REGISTRAR]               ,'Нет');
				elsif p_info='ИП_МЕСТО_РЕГ_РН'     then ExStr:=nvl(clOrgRef.[REGISTER].[REG_PLACE]               ,'Нет');
				end if;
			else
				if    p_info='ИП_ДАТА_РЕГИСТРАЦИИ' then ExStr:=nvl(to_char(clOrgRef.[REGISTER].[DATE_REG],fmt)                                        ,'Нет');
				elsif p_info='ИП_ГОС_РЕГ_НОМ'      then ExStr:=nvl(clOrgRef.[REGISTER].[GOS_REG_NUM_REC]                                              ,'Нет');
				elsif p_info='ИП_НАИМ_РЕГ_ОРГАН'   then ExStr:=nvl(clOrgRef.[REGISTER].[REG_BODY].[NAME]                                              ,'Нет');
				elsif p_info='ИП_МЕСТО_РЕГ_РН'     then ExStr:=nvl(trim(clOrgRef.[REGISTER].[CITY].[NAME]||' '||clOrgRef.[REGISTER].[DISTRICT].[NAME]),'Нет');
				end if;
			end if;
		end if;
	end if;
	
	&debug('.CalcParmClient -- p_info='||p_info||' cl='||cl%class||'.'||cl%id||' -> '||ExStr,dp)
	return ExStr;
end;


/**************************************************************
 возвращает строку, содержащую все контакты типа contact_type
 и принадлежности contact_private
***************************************************************/
function GetContacts(cont_arr [CONTACTS_ARR], contact_type string) return varchar2(1000) is
str varchar2(1000);
begin
	str := '';
	if contact_type is not null  then
	-- optimaize
		for
		(
			select res
			(
				res.[PRIVATE].[VALUE]: 	c_priv,
				res.[TYPE].[VALUE]:		c_val,
				res.[NUMB]:				c_numb
			)
		in		cont_arr
		where	res.[ACTIV] = true
				and res.[NUMB] is not null
				and res.[TYPE].[CODE] = contact_type
				and (res.[PRIVATE].[CODE] in ('1', '2', '3') or res.[PRIVATE] is null)
		order by res.[PRIVATE].[CODE]
		)loop
		  str := str || LTRIM(res.c_priv || ' ' || res.c_val || ' ' || res.c_numb || NL$);
		end loop;
	else
		return '';
	end if;
	return str;
end;

/*******************************************
 Функция возвращает сведения о документах,
 подтверждающих право проживания в РФ
********************************************/
function Get_Visa(p_cl [CL_PRIV], p_date date) return varchar2(32000)
is
	str varchar2(32000) := '';
begin
	-- optimaize
	for
	(
		select v_visa
		(
			v_visa.[TYPE].[FULL_NAME]: 	v_name,
			v_visa.[SER]:				v_ser,
			v_visa.[NUM]:				v_num,			
			v_visa.[DATE]:				v_date,
			v_visa.[DATE_END]:			v_date_end,
			v_visa.[WHO]:				v_who
		)
	in p_cl.[DOC_ARR]
	where v_visa.[TYPE].[RESIDENCE_RIGHT]  and
		  nvl(v_visa.[DATE],p_date) <= p_date and
		  nvl(v_visa.[DATE_END],p_date) >= p_date	
	)	
	loop
		-- VISA инфо
		str :=  str||
				nvl(v_visa.v_name, '')||
				' Серия: '||nvl(v_visa.v_ser,'-')||' №: '||nvl(v_visa.v_num,'-')||
				' Действует с '||nvl(to_char(v_visa.v_date,'dd.mm.rr'),'-/-/--')||' по '||nvl(to_char(v_visa.v_date_end,'dd.mm.rr'),'-/-/--')||
				' Выдан: '||ltrim(rtrim(v_visa.v_who))
				||NL$;	
	end loop;	
	
	return str;
end;

/*******************************************
 Функция возвращает сведения о СНИЛС
********************************************/

function Get_SNILS(p_cl [CL_PRIV], p_date date) return varchar2(32000)
is
	str varchar2(32000) := '';
begin
	-- optimaize
	if nvl(p_cl.[SNILS], '-') = '-' then

	for
	(
		select v_visa
		(
			v_visa.[TYPE].[FULL_NAME]: 	v_name,
			v_visa.[TYPE].[KOD]: 	v_kod,
			v_visa.[SER]:				v_ser,
			v_visa.[NUM]:				v_num,			
			v_visa.[DATE]:				v_date,
			v_visa.[DATE_END]:			v_date_end,
			v_visa.[WHO]:				v_who
		)
	in p_cl.[DOC_ARR]
	where 	(v_visa.[TYPE].[KOD] = '15' or v_visa.[TYPE].[KOD] = 'СНИЛС') and
		  nvl(v_visa.[DATE],p_date) <= p_date and
		  nvl(v_visa.[DATE_END],p_date) >= p_date	
	)	
	loop
		-- СНИЛС инфо
		str := nvl(v_visa.v_num,'-');
		exit;
	end loop;	
	else
		str := p_cl.[SNILS];
	end if;
	
	return str;
end;
/*******************************************
 Функция возвращает сведения о месте работы
********************************************/
function Get_Work(p_cl [CL_PRIV], p_date date) return varchar2(32000)
is
	str varchar2(32000) := '';
	op_dat date;
begin
	op_dat := nvl(p_date, ::[SYSTEM].[VARIABLES].OpDate);
	for
		(
			select rabota
				( nvl(rabota.[CORP_R].[NAME], rabota.[CORP])	:vCorp
				, rabota.[RANGE]								:vRange
				)
			in p_cl.[WORK_ACTIVITY]
			where
				    (nvl(rabota.[START_DATE],op_dat) <= op_dat )
				and	(nvl(rabota.[END_DATE],op_dat) >= op_dat )
				and (rabota.[CORP_R] is not null or rabota.[CORP] is not null or rabota.[RANGE] is not null)
			order by nvl(rabota.[START_DATE],op_dat) desc
		)
	loop
		str := str || trim(rabota.vCorp || ' ' || rabota.vRange) || NL$;
	end loop;
	str := substr(str, 1, length(str) - 2);	
	return str;
end;

/**********************************************************
 Функция возвращает сведения обо всех минграционных картах
**********************************************************/
function Get_Migration_Card(p_cl [CL_PRIV], p_date date) return varchar2(32000) is
str varchar2(32000);
begin
	str :='';
	for (
		select x(x.[CARD_NUM] :CARD_NUM
				,x.[DATE_BEG] :DATE_BEG
				,x.[DATE_END] :DATE_END)
		in p_cl.[MIGR_CARD]
		where	nvl(x.[DATE_BEG],p_date) <= p_date
			and	nvl(x.[DATE_END],p_date) >= p_date
		)
	loop
		str := str || 'Номер карты: ' || nvl(x.[CARD_NUM], '-') ||
					  ' Действует с ' || nvl(to_char(x.[DATE_BEG],'dd.mm.rr'), '-/-/--') ||
					  ' по ' || nvl(to_char(x.[DATE_END],'dd.mm.rr'), '-/-/--') || NL$;
	end loop;	
	return str;	                        	
end;

/**********************************************************
Функция возвращает паспортные данные клиента - физ лица.
**********************************************************/
function Get_passport(p_cl [CL_PRIV]) return string is
doc [CERTIFICATE];
begin
	doc := p_cl.[DOC];
	if doc.[TYPE] is not null then
	 	return doc.[TYPE].[NAME]||
	 		   bool_char(doc.[SER] is null, null, ' '||doc.[SER])||
 			   bool_char(doc.[NUM] is null, null, ' №'||doc.[NUM])||
			   bool_char(doc.[DATE]is null, null, '  выдан '||to_char(doc.[DATE],'dd/mm/yyyy'))||
			   bool_char(doc.[WHO] is null, null, ' '||doc.[WHO])||
			   bool_char(doc.[DEPART_CODE] is null, null, ' код подр. '||doc.[DEPART_CODE]);
	elsif doc.[WHO] is not null then
		return doc.[WHO];
	end if;
end;


/**********************************************************
Функция возвращает адрес строкой
**********************************************************/
Function GetAddress(	cl_adresses		[CLIENT].[ADDRESSES]%type
						,AddRecv varchar2(100) default null
						,AddrCode varchar2(20) default null
			)return varchar2(1000)
is
addr			varchar2(1000);
addr_ref		ref [PERSONAL_ADDRESS];
begin
	AddrCode := upper(AddrCode);
	begin
		select a(a)
			in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all : t ) all
			where	a%collection = cl_adresses
					and t = a.[TYPE]
					and t.[KOD] = AddrCode
					and rownum <= 1
			into addr_ref;
	exception
		when NO_DATA_FOUND then
			if AddrCode is null then   -- ищем любой адрес
				begin
					select a(a)
						in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all: t) all
						where	a%collection = cl_adresses
								and t = a.[TYPE]
								and rownum <= 1
						into addr_ref;
				exception when NO_DATA_FOUND then
					null;
				end;
			end if;
	end;
	addr := VIEWFUN.GetAddressByRef(	a		== addr_ref,
										AddRecv	== AddRecv);
	return addr;
end;

-- Получение подразделения пользователя, работающего с клиентом, в родительном падеже
function get_cl_depart(code ::[VID_OPER_DOG].[CODE]%type, collection_id [CL_INFO_USER_ARR], event_date date) return ::[DECLENSION].[NAME]%type is
begin
	for (	select x(d : depart)
			in collection_id, (::[DEPART] : d)
			where	x.[PERSON_TYPE].[CODE] = code
				and d.[CODE] = x.[DEPART_CODE]
				and	trunc(x.[OPER_DATE]) <= trunc(event_date)
			order by x.[OPER_DATE] desc
		)
	loop
		return ::[DEPART].[LIB].get_declension(x.depart);	
	end loop;		
	return null;
end;

public function fill_benefit
/*Функция заполнения данных о выголоприобретателе и выгододателе и основаниии с возможностью отдельного вывода*/
(
	P_DATE_PRINT date
		/*Дата печати анкеты*/
	, P_CL_LINKS [LINKS_CL_ARR]
		/*Клиент, для которого ищутся взаимосвязи*/
	, P_TYPE ref [CL_LINK]
		/*Тип взаимосвязи. Ссылка*/
	, P_FOUND boolean
		/*Выводить основание*/
	, P_BEN boolean
		/*выводить выгододателя/выгодоприобретателя*/
)
/*Возвращается строка вида:
<ИМЯ>, на основании: <ОСНОВАНИЕ>
<ИМЯ2>, на основании: <ОСНОВАНИЕ2>

либо (если основания нет, либо вывод основания не нужен):
<ИМЯ>
<ИМЯ2>

либо(если вывод выгододателя/приобретателя не нужен):
<ОСНОВАНИЕ>
<ОСНОВАНИЕ2>
*/
return string(32000) is 
	ret_DATA string(32000);
	header boolean := true;
begin
	for cl_link in P_CL_LINKS
	where
		cl_link.[VID_LINK]  = P_TYPE
		and (cl_link.[DATE_BEG]<=P_DATE_PRINT or cl_link.[DATE_BEG] is null)
		and (cl_link.[DATE_END]>=P_DATE_PRINT or cl_link.[DATE_END] is null)
  	order by cl_link.[DATE_BEG]
	loop
		ret_DATA := rtl.bool_char(ret_DATA is not null, ret_DATA || bool_char(cl_link.[PARTNER] is not null or cl_link.[FOUND] is not null, ';'|| NL$,'') , '');
		if P_BEN then
			if header then
				if P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОПРИОБРЕТАТЕЛЬ') then
					ret_DATA := ret_DATA ||'Выгодоприобретатели: ';
				elsif P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОДАТЕЛЬ') then
					ret_DATA := ret_DATA ||'Выгододатели: ';
				end if;
				header := false;
			end if;
			ret_DATA := ret_DATA || cl_link.[PARTNER].[NAME];
		end if;
		
		if P_FOUND and cl_link.[FOUND] is not null then
			if P_BEN then
				ret_DATA := ret_DATA || ', на основании: ';--если выводятся и сами выгододатели, напишем слово "на основании"
			end if;
			ret_DATA := ret_DATA || cl_link.[FOUND];
		end if;
	end loop;
	if trim(ret_DATA) is null then
		if P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОПРИОБРЕТАТЕЛЬ') then
			ret_DATA := 'Выгодоприобретатели: нет сведений';
		elsif P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОДАТЕЛЬ') then
			ret_DATA := 'Выгододатели: нет сведений';
		end if;
	end if;

	return ret_DATA;--удалим последнюю запятую
end;

-- Получает номер миграционной карты
function migr_card_str (CLIENT_ID in ref [CL_PRIV]) return string(100) is
ans string(100) := null;
begin
	select migr( migr.[CARD_NUM] : CARD_NUM )
	in		CLIENT_ID.[MIGR_CARD]
	where	migr.[DATE_BEG] <= op_dat
			and migr.[DATE_END] >= op_dat
			and rownum = 1
	into ans;
	return ans;
exception
	when NO_DATA_FOUND then
		return null;
end;


function GetAddProps(pOnDate date, pCode string) return string(4000) is
str string(4000);
rec ref [PROPERTIES];
begin
	if client_corp%id is null then
		return null;
	end if;
	pOnDate := trunc(nvl(pOnDate, sysdate));
	begin
		locate rec in client_corp.[ADD_PROP]
			where	rec.[GROUP_PROP].[CODE] = pCode
					and nvl(rec.[DATE_BEG], pOnDate) <= pOnDate
					and nvl(rec.[DATE_END], pOnDate) >= pOnDate;
		str := trim(substr(rec.[STR], 1, str%size));
	exception
		when NO_DATA_FOUND then null;
	end;
	
	return str;
end;

function GetOKVED(p_cl ref [CL_ORG], pDate date) return string(32000) is
str	varchar(32000);
begin
	if p_cl is null then
		return null;
	end if;
	pDate := trunc(nvl(pDate, sysdate));
	debug_pipe('pDate='||pDate, 0);
	str :='';
	for (
		select x(x.[OKVED].[CODE]	: CODE
				,x.[OKVED].[NAME]	: NAME)
		in p_cl.[OKVED_IN_PERIOD]
		where	nvl(x.[DATE_BEGIN],pDate) <= pDate
			and	nvl(x.[DATE_END],pDate) >= pDate
		order by nvl(x.[PRIMARY], false) desc
		)
	loop
		str := str || x.[CODE]|| ', ';
	end loop;	
	if str = '' then
		str := 'ОКВЭД: нет сведений';
	else
		str := 'ОКВЭД: ' || str;
		str := substr(str,1,length(str)-2);
		str := str;
	end if;
	return str;	                        	
end;

function GetPDLStr(	  p_pdl_ref		ref [IPDL_TYPE]
					, p_pdl_type	::[IPDL_CATEGORY].[PDL_TYPE]%type
					)return varchar2(32000)
is
v_ret GetPDLStr%type;
begin
	select c(analytic(listagg(c.[CATEGORY].[NAME], ','), 'within group (order by [1])', c.[CATEGORY].[NAME]))
	in p_pdl_ref.[CATEGORY_LIST]
	where c.[CATEGORY].[PDL_TYPE] = p_pdl_type or c.[CATEGORY].[PDL_TYPE] is null or p_pdl_type is null
	into v_ret;
	
	return v_ret;
	
end;

function GetPDLStr_(	  p_pdl_ref		ref [IPDL_TYPE]
					, p_pdl_type	::[IPDL_CATEGORY].[PDL_TYPE]%type
					, code string
					)return varchar2(32000)
is
v_ret string;
begin
	select c(analytic(listagg(c.[CATEGORY].[CODE], ','), 'within group (order by [1])', c.[CATEGORY].[CODE]))
	in p_pdl_ref.[CATEGORY_LIST]
	where
--	c.[CATEGORY].[CODE] = 'RELATIVE' and
			c.[CATEGORY].[PDL_TYPE] = p_pdl_type or c.[CATEGORY].[PDL_TYPE] is null or p_pdl_type is null
	into v_ret;
	return v_ret;
	
end;

function get_date_close(
	p_cl_info [CL_INFO_REQ]
	, p_client ref [CLIENT]
	, p_date_print date
)
return date
is
	v_has_open integer;
	v_close_date date;
	v_close_date_v date;
	v_close_date_r date;
begin
	v_close_date := p_cl_info.[CLOSE_DATE];
	if v_close_date is null then
			
		select acc(max(acc.[DATE_CLOSE]), max(decode(acc.[COM_STATUS], ::[COM_STATUS_PRD]([CODE] = 'CLOSE'), 0, 1)))
			in ::[AC_FIN]
			where acc.[CLIENT_V]=p_client
				and (acc.[COM_STATUS] is null
					or not (
						acc.[COM_STATUS] in (::[COM_STATUS_PRD]([CODE] = 'TO_OPEN'), ::[COM_STATUS_PRD]([CODE] = 'SHIFR'))
						or acc.[COM_STATUS] = ::[COM_STATUS_PRD]([CODE] = 'CLOSE') and acc.[DATE_CLOSE] is null
						)
					)
		into v_close_date_v, v_has_open;
		
		if v_has_open = 1 then
			return null;
		else
			select acc(max(acc.[DATE_CLOSE]), max(decode(acc.[COM_STATUS], ::[COM_STATUS_PRD]([CODE] = 'CLOSE'), 0, 1)))
				in ::[AC_FIN]
				where acc.[CLIENT_R]=p_client
					and (acc.[COM_STATUS] is null
						or not (
							acc.[COM_STATUS] in (::[COM_STATUS_PRD]([CODE] = 'TO_OPEN'), ::[COM_STATUS_PRD]([CODE] = 'SHIFR'))
							or acc.[COM_STATUS] = ::[COM_STATUS_PRD]([CODE] = 'CLOSE') and acc.[DATE_CLOSE] is null
							)
						)
			into v_close_date_r, v_has_open;
			
			if v_has_open = 1 then
				return null;
			else
				if v_close_date_r > v_close_date_v then
					v_close_date := v_close_date_r;
				else
					v_close_date := v_close_date_v;
				end if;
			end if;
		end if;
	end if;
	
	-- дата прекращения отношений клиента не может быть больше даты печати анкеты
	if v_close_date > p_date_print then
		return null;
	end if;
	
	if p_cl_info.[CLOSE_DATE] is null and v_close_date is not null then
		::[CL_INFO_REQ].[LIB].InsertOrUpdateFirstDate(
			p_client
			, null
			, p_cl_info.[FIRST_ACC_DATE]
			, v_close_date
		);
	end if;
	
	return v_close_date;
end;

function GetAddPropVal (p_client ref [CLIENT], p_prop_code varchar2(64), P_DATE_PRINT date) return varchar2(4000)
is

v_temp_str varchar2(4000);

begin
		v_temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
		 --debug_pipe('p_client='||p_client,0);
		for dop in p_client.[ADD_PROP]
		 		where Upper(dop.[GROUP_PROP].[CODE])=Upper(p_prop_code) and
				nvl(dop.[DATE_BEG],P_DATE_PRINT)<=P_DATE_PRINT and P_DATE_PRINT<=nvl(dop.[DATE_END],P_DATE_PRINT)
		loop
			--debug_pipe('dop.[GROUP_PROP].[TYPE_VALUE]='||dop.[GROUP_PROP].[TYPE_VALUE],0);
			v_temp_str := trim(
						iif(dop.[GROUP_PROP].[TYPE_VALUE] is null ,dop.[PROP].[NAME],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='NUMBER',to_char(dop.[NUM],'999G999G999G999G990D0099'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='STRING',dop.[STR],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='DATE'  ,to_char(dop.[V_DATE],fmt),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='BOOL'  ,iif(dop.[BOOL],'Да','Нет'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='REF'   ,::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),'')
						);
		end loop;
						
		return 	v_temp_str;			
end;


function get_date_upd(cl ref [CLIENT], on_date date default trunc(sysdate) ) return date is 
	is_auto		boolean;
	last_date	date;
	value		varchar2(4000);
	cl_hist_ref ref [CL_HIST];
begin
	is_auto := ::[CL_CORP].[EDIT_ANKETA].is_auto_fill_date_upd( nvl(on_date, trunc(sysdate)) );
	if is_auto then
		last_date := ::[LEGAL_INTERFACE].[PRX_CLIENT].cl_hist_get_last_date(cl, on_date);
		return last_date;
	else
		cl_hist_ref := ::[LEGAL_INTERFACE].[PRX_CLIENT].cl_hist_get_value(cl, 'DATE_FORM_UPD', on_date + 1, value);
		if cl_hist_ref is not null then
			return value;
		else
			return CL.[DATE_FORM_UPD];
		end if;
	end if;
	return null;
end;

-- Получение пользователя, работающего с клиентом
function get_cl_info_user(code ::[VID_OPER_DOG].[CODE]%type, collection_id [CL_INFO_USER_ARR], event_date date) return string(350) is 
begin
	if collection_id is not null then
		for (	select x(x.[NAME] : name, x.[CASTA_NAME] : casta)
				in collection_id
				where	x.[PERSON_TYPE].[CODE] = code
					and trunc(x.[OPER_DATE]) <= trunc(event_date)
					and	x.[OPER_TYPE].[CODE] = 'FIRST_ACCOUNT_OPEN'
				order by x.[OPER_DATE]
			)
		loop
			return x.name || bool_char(x.casta is not null, ', '||x.casta, '');
		end loop;
		return null;
	else
		return null;
	end if;
end;
PSH_WRD_IPCLANK (
	@name('Руководитель подразделения')         P_HEADUSER        in [USER_REF],
	@name('Строка для передачи данных')         P_DATA            in [MEMO_32767],
	@name('Дата заполнения анкеты')             P_DATE_ANK        in [DATE],
	@name('Печать анкеты на дату')              P_DATE_PRINT      in [DATE],
	@name('Подразделение')                      P_DEPART          in [DEPART_REF]       default null,
	@name('Подразделение')                      P_DEPART_STR      in [STRING_128]       default null,
	@name('Работа с клиентом в подразделениях') P_WORK_IN_DEPARTS in [CL_INFO_USER_REF] default null,
	@name('Руководитель подразделения')         P_HEADUSER_STR    in [STRING_500]       default null,
	@name('Дата обновления анкеты')             P_DATE_FORM_UPD   in [DATE],
	@name('Документ')                           P_SHABLON         in [SHABLON_DOC_REF],
	@name('Без поднятия формы')                 P_NO_FORM         in [BOOLEAN]          default null,
	@name('Отправить на печать')                P_AUTO_PRINT      in [BOOLEAN]          default null
) is

validate is
temp_string [MEMO_32767] := '';
temp_str	varchar2(2000) := '';
v_cl_links	[LINKS_CL_ARR];
links_ref	number;
rClient		ref [CLIENT];
cl_priv ref [CL_PRIV];
cl_hist_ref	ref [CL_HIST];
val			string(4000);

flSpace boolean:=false; --Башкиров В.Г. 28.05.2019 Для кодов типа CL_ANK_PDL_INFO_ (последний символ "_") если значение пустое - выдавать " " вместо "нет"
rClOrg ref [CL_ORG]; 	--Воробей В.А. 29.05.2019 Прочие вычисляемые параметры клиента
begin
	if p_message = 'DEFAULT' then
		-- Инициализация переменных		
		op_dat 		:= ::[SYSTEM].[VARIABLES].OpDate;
		rabota 		:= null;
		account 	:= null;
		client_priv	:= null;
		client_corp	:= null;

		V_UPD_ANKETA 	:= false;
		V_LAST_VERSION  := true;
		V_VB			:= null;
		
		declare
			cl_ref ref [CLIENT];		    		
	    begin
	    	if client_org_ref is not null then
	    		cl_ref := client_org_ref;
	    	else
	    		cl_ref := this;
	    	end if;
	    	
	    	for a
	    		in ::[AC_FIN]
	    		where a.[CLIENT_V] = cl_ref
	    		order by a.[DATE_OP] asc
	    	loop
	    		account := a;
	    		exit;
	    	end loop;

			P_DATE_ANK := cl_ref.[DATE_ANK];
	 	end;
		
		--По умолчанию показываем дату печати - текущую дату.
		P_DATE_PRINT := nvl(P_DATE_PRINT,trunc(sysdate));

		
		if client_org_ref is null then
			V_PRIV_BUSINES := false;
			P_DATE_FORM_UPD = V_DATE_UPD_TO_PRINT := [DATE_FORM_UPD_F];
		else
			V_PRIV_BUSINES := true;
			P_DATE_FORM_UPD = V_DATE_UPD_TO_PRINT := client_org_ref.[DATE_FORM_UPD_F];
--			P_SHABLON := ::[SHABLON_DOC]([CODE] = 'АНК_ИП');
		end if;

		is_auto := 	::[CL_CORP].[EDIT_ANKETA].is_auto_fill_date_upd;	
		if is_auto then
			csmd.Disable(V_VB, 'P_DATE_FORM_UPD');
			csmd.Show(V_VB, 'V_UPD_ANKETA', 'V');
		else
			V_UPD_ANKETA :=  P_DATE_ANK is not null and P_DATE_FORM_UPD is null; -- обновляем
			csmd.Enable(V_VB, 'P_DATE_FORM_UPD');
			csmd.Hide(V_VB, 'V_UPD_ANKETA', 'V');
		end if;

		begin
			P_SHABLON := null;
			locate P_SHABLON in ::[SHABLON_DOC] where P_SHABLON.[CODE] = 'АНК_ФИЗ_ЛИЦ_ИП' order by P_SHABLON;
		exception
			when NO_DATA_FOUND then 
			null;
		end;
		
		if nvl(::[FP_TUNE].[LIB].get_bool_value('REG_WORK_IN_DEPARTS', ::[FP_TUNE].[LIB].set_canons('<TYPE_REG_IN_DEPART>', 'WORK_REG')),false) then
			[CSMD].Enable(V_VB, 'P_WORK_IN_DEPARTS');			
			
			executor.set_context( 'CL_INFO_DATE', to_char(nvl(P_DATE_PRINT, sysdate), 'DD/MM/YYYY'));
			declare
				collect_id collection;
			begin
				if client_org_ref is not null then
					select x(x.[CL_WORK_USERS]) in ::[CL_INFO_REQ] where x.[CLIENT] = client_org_ref into collect_id;
				else
					select x(x.[CL_WORK_USERS]) in ::[CL_INFO_REQ] where x.[CLIENT] = this into collect_id;
				end if;
				executor.set_context('CL_INFO_COLLECTION', to_char(collect_id));
			exception when NO_DATA_FOUND then
				executor.set_context('CL_INFO_COLLECTION', null );	
			end;		
		else
			[CSMD].Disable(V_VB, 'P_WORK_IN_DEPARTS');			
		end if;
		
		-- Заполнение подразделения и руководителя подразделения
		P_DEPART 		:= ::[SYSTEM].[VARIABLES].OurDepart;
		P_HEADUSER 		:= ::[CL_CORP].[EDIT_ANKETA].get_chief_user(P_DEPART, 'DEPART_BOSS');
		P_DEPART_STR 	:= P_DEPART.[NAME];
		P_HEADUSER_STR	:= P_HEADUSER.[NAME];
		P_NO_FORM		:= nvl(P_NO_FORM, false);
		P_AUTO_PRINT	:= nvl(P_AUTO_PRINT, false);

	elsif p_message = 'VALIDATE' then
		--debug_pipe('p_info='||p_info, 0);
	    if p_info = '%PLPCALL%' and nvl(P_NO_FORM, false) then
	        V_VB := V_VB || NL$ || 'Call Form1.ScriptPostEvent(OK,"CLICK")' || NL$;
	    end if;

		P_DATA := ' ';
		--debug_pipe('Vorobey (str 0110) - p_info = '||p_info,0); -- Vorobey 30.05.2019 debug
		if p_info = 'P_HEADUSER' then
			if P_HEADUSER is not null then
				--P_HEADUSER_STR := P_HEADUSER.[NAME]|| bool_char(P_HEADUSER.[CASTA].[VALUE] is not null, )
				P_HEADUSER_STR := nvl(::[RUNTIME].[STDLIB].fio(P_HEADUSER.[NAME],'Ф И. О.'), '');
				P_HEADUSER_STR := rtl.bool_char(P_HEADUSER_STR is not null, nvl(P_HEADUSER.[CASTA].[VALUE], '')||' '||P_HEADUSER_STR, '');				
			end if;
		elsif P_INFO = 'P_DEPART' then
			if P_DEPART is not null then
				P_DEPART_STR := P_DEPART.[NAME];
			end if;
		elsif P_INFO = 'P_WORK_IN_DEPARTS' then
			P_HEADUSER_STR := 	P_WORK_IN_DEPARTS.[NAME_CHIEF]||
								bool_char( P_WORK_IN_DEPARTS.[CASTA_CHIEF] is not null, ', ' || P_WORK_IN_DEPARTS.[CASTA_CHIEF], '');
			P_DEPART_STR :=	P_WORK_IN_DEPARTS.[DEPART_NAME]||' '||
							bool_char(P_WORK_IN_DEPARTS.[DEPART_CODE]is not null,'('||P_WORK_IN_DEPARTS.[DEPART_CODE]||')', '');
		elsif P_INFO = 'P_DATE_PRINT' then
			executor.set_context( 'CL_INFO_DATE', to_char(nvl(P_DATE_PRINT, sysdate), 'DD/MM/YYYY'));
			if nvl(P_DATE_PRINT, trunc(sysdate)) <> trunc(sysdate) then
				V_DATE_UPD_TO_PRINT := get_date_upd(this,P_DATE_PRINT);
				V_LAST_VERSION 		:= false;
			else
				V_DATE_UPD_TO_PRINT := P_DATE_FORM_UPD;
			end if;
					
		elsif p_info = 'P_DATE_FORM_UPD' then
			 -- если пользователь сам установил дату или удалил, тогда
			 V_UPD_ANKETA := false;

		elsif p_info = '%VAR%.V_UPD_ANKETA' then
			 -- если пользователь сам установил дату или удалил, тогда
			if V_UPD_ANKETA then
				P_DATE_FORM_UPD := trunc(sysdate);
			else
				P_DATE_FORM_UPD := [DATE_FORM_UPD_F];
			end if;

			if nvl(P_DATE_PRINT, trunc(sysdate)) <> trunc(sysdate) then
				V_DATE_UPD_TO_PRINT := get_date_upd(this,P_DATE_PRINT);
				V_LAST_VERSION 		:= false;
			else
				V_DATE_UPD_TO_PRINT := P_DATE_FORM_UPD;
			end if;
			
		end if;

		if p_info = 'CANCEL' then
			client_org_ref := null;
		elsif p_info = 'OK' then
			V_BEN_STR := '';
			if V_UPD_ANKETA then
				V_MESSAGE := 'Хотите изменить дату обновления на текущую -' ||to_char(sysdate, 'dd/mm/yyyy') || '?';
			end if;

			-- Если дата заполнения анкеты не указана, тогда не печатаем анкету
			if P_DATE_ANK is null then
				pragma error('Укажите дату заполнения анкеты!');
			end if;
			--Если дата печати не заполнена, то печатаем только из текущих значений
			P_DATE_PRINT := nvl(P_DATE_PRINT,trunc(sysdate));
			--P_DATE_FORM_UPD := nvl(P_DATE_FORM_UPD,trunc(SYSDATE)); -- Дата обновления МОЖЕТ быть пустая
			--Получаем структуры клиентов на дату
			--Изменения анкеты, сделанные в дату P_DATE_PRINT, начинают действовать сразу же,
			--т.е. прежние реквизиты будут действительны до (P_DATE_PRINT-1) включительно.
			client_priv := ::[LEGAL_INTERFACE].[PRX_CLIENT].CL_HIST_GET_PRIV(this,P_DATE_PRINT+1);
			if client_org_ref is not null then
				client_corp := ::[LEGAL_INTERFACE].[PRX_CLIENT].CL_HIST_GET_CORP(client_org_ref, P_DATE_PRINT + 1);
				cl_info := ::[CL_INFO_REQ].[LIB].GetClInfoReq_OnDate(client_org_ref, P_DATE_PRINT + 1);
			else
				cl_info := ::[CL_INFO_REQ].[LIB].GetClInfoReq_OnDate(this, P_DATE_PRINT + 1);
			end if;

			V_CHECK_VIG	:= P_SHABLON.[CODE];
			P_DATA		:= '';
			
			if V_CHECK_VIG = 'АНК_ПРЕДСТ_ФЛ' then --ПРИНЦИПАЛ BS00299498				
				select a(nvl(a.[CLIENT_NAME], a.[PARTNER].[NAME]) : clien_name)
					in client_priv.[LINKS_OTHER]
					where a.[VID_LINK] = ::[CL_LINK]([CODE] = 'ПРИНЦИПАЛ')					
					  and (a.[DATE_BEG] is null or a.[DATE_BEG] <= P_DATE_PRINT)
					  and (a.[DATE_END] is null or a.[DATE_END] >= P_DATE_PRINT)
					into principal;
				if principal.count = 0 then
					pragma error('Данный клиент не является представителем');
				end if;					
			end if;	

			/***********************************************************************
				 ПЕЧАТЬ ОТЧЕТОВ О БЕНЕФИЦИАРНЫХ ВЛАДЕЛЬЦАХ ФИЗИЧЕСКОГО ЛИЦА
				 анкета каждого физ.лица печатается в отдельный Word - документ.
				 печать анкет физических лиц являющихся бенефицирами реализуется в другой операции,
				 здесь передается только ссылка на физ.лицо.
			***********************************************************************/
			if V_CHECK_VIG = 'АНК_БЕН_ФЛ' then
				if client_corp%id is not null then
					links_ref := client_corp.[LINKS_OTHER];
					V_NAME := client_corp.[NAME];
				else
					links_ref := client_priv.[LINKS_OTHER];
					V_NAME := client_priv.[NAME];
				end if;
				for
					(select
						c (c.[PARTNER] : cl_priv_id)
						in  ::[LINKS_CL] all
						where c.[VID_LINK] = ::[CL_LINK]([CODE] = 'БЕНЕФИЦИАР')
							and c%collection = links_ref
							and (c.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or c.[DATE_BEG] is null)
							and (c.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or c.[DATE_END] is null)
							and c.[PARTNER] is not null
					)
				loop
					V_BEN_STR := V_BEN_STR||c.cl_priv_id||'#';
				end loop;
				if V_BEN_STR is null then
					pragma error(case when client_corp%id is not null then 'Индивидуальный предприниматель' else 'Физическое лицо' end||' не имеет действующих бенефициаров - клиентов');
				end if;
			end if;
		else
			if p_info = 'REPORTFILE' then
		 		P_DATA := P_SHABLON.[FILE_NAME];--&ReportFile;
	
		 	elsif p_info = 'REPORTPATH' then
		 		--P_DATA := [MSLIB].GetReportPath;
		 		P_DATA := ::[SYSTEM_PARAMS].[GET]('PATH_PRINT_DOC');
			---------------------------------------------------------------------------
	
		 	elsif p_info = 'КАТЕГОРИЯ' then   --КАТЕГОРИЯ
		 		if client_corp%id is not null then
		 			P_DATA := 'индивидуального предпринимателя';
		 		else
		 			P_DATA := 'физического лица';
		 		end if;
													
		 	elsif p_info like 'НАИМ_КЛИЕНТА%' then   --НАИМ_КЛИЕНТА
		 		P_DATA := coalesce(client_corp.[NAME], client_priv.[NAME], '');
		 		
			elsif p_info = 'ДАТА_РОЖД' then      --ДАТА_РОЖД
		 		P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(client_priv.[DATE_PERS]), '');
		 		
			elsif p_info = 'МЕСТО_РОЖД' then     --МЕСТО_РОЖД
			
				temp_str := client_priv.[DOC].[BIRTH_PLACE];
				if temp_str is not null then -- BFS00023043 теперь есть реквизит
				P_DATA := temp_str;
				else
					temp_str := nvl(client_priv.[BORN].[COUNTRY].[VALUE], '');
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, temp_str||', ');
					
					temp_str := nvl(client_priv.[BORN].[OKATO].[NAME], '');
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, temp_str||', ');
			
					P_DATA := P_DATA||nvl(client_priv.[BORN].[KIND].[SHORT_NAME]||' '||client_priv.[BORN].[NAME], ', ');
	
					P_DATA := substr(rtrim(ltrim(P_DATA)),1,length(P_DATA)-1);
			 	end if;
	
			elsif p_info = 'ГРАЖД' then          --ГРАЖДАНСТВО
				P_DATA := COALESCE(client_corp.[COUNTRY].[NAME],client_priv.[COUNTRY].[NAME],'Лицо без гражданства');
				
			elsif p_info = 'ДОКУМЕНТ' then       --ДОКУМЕНТ, удостоверяющий личность
				P_DATA := nvl(Get_passport(client_priv), '');
	
			elsif p_info = 'ВИЗА' then            --ВИЗА
				P_DATA := Get_Visa(client_priv,P_DATE_PRINT);
			elsif p_info = 'СНИЛС' then            --ВИЗА
				P_DATA := Get_SNILS(client_priv,P_DATE_PRINT);	
			elsif p_info = 'СНИЛС_ФОРМАТ' then     --СНИЛС - форматированный
				P_DATA := regexp_replace(client_priv.[SNILS], '(.{3})(.{3})(.{3})(.{2})', '\1-\2-\3 \4');	
			elsif p_info = 'МИГР_КАРТА' then            --МИГР_КАРТА
				P_DATA := Get_Migration_Card(client_priv, P_DATE_PRINT);					
				
			elsif p_info = 'РЕГ_АДРЕС' then      --Адрес регистрации
				if client_corp%id is not null then
					P_DATA := COALESCE(GetAddress(client_corp.[ADDRESSES],'ALL', 'FACT'), GetAddress(client_priv.[ADDRESSES],'ALL', 'REGISTRATION'));
				else
					P_DATA := nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'REGISTRATION'), '');
	 			end if;
	 			
			elsif (p_info = 'ПОЧТ_АДРЕС') then --ПОЧТ_АДРЕС (почтовый)

				if client_corp%id is not null then
					P_DATA := COALESCE(GetAddress(client_corp.[ADDRESSES],'ALL', 'POST'), GetAddress(client_priv.[ADDRESSES],'ALL', 'POST'));
				else
					P_DATA := nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'POST'), '');
	 			end if;

--				P_DATA := nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'POST'), ''); --but
			elsif p_info = 'ФАКТ_АДРЕС'	then

				if client_corp%id is not null then
					P_DATA := COALESCE(GetAddress(client_corp.[ADDRESSES],'ALL', 'FACT'), GetAddress(client_priv.[ADDRESSES],'ALL', 'REAL_LIVE'));
				else
					P_DATA := nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'REAL_LIVE'), '');
	 			end if;

--				if client_priv%id is not null then --but
--					P_DATA := nvl(GetAddress(client_priv.[ADDRESSES],'ALL', 'REAL_LIVE'), '');
--				end if;

			elsif p_info = 'РАБОТА' then           --Место работы и должность
				if client_corp%id is not null then
					P_DATA := COALESCE(client_corp.[NAME], client_corp.[LONG_NAME])||' '||nvl(cl_org_dolg_fase.[RANGE].[VALUE], '');
					P_DATA := trim(P_DATA);
				else
					P_DATA := nvl(Get_Work(client_priv,P_DATE_PRINT),'');
				end if;
	
			elsif p_info = 'ИНН' then            --ИНН
		 		P_DATA := COALESCE(client_corp.[INN], client_priv.[INN]);
		 		
			elsif p_info = 'КОНТАКТ_ТЕЛ' then        --КОНТАКТЫ
			    --ищем рабочий телефон
			    P_DATA := GetContacts(client_priv.[CONTACTS], 'PHONE')||
			    		  GetContacts(client_priv.[CONTACTS], 'MOBILEPHONE')||
			              GetContacts(client_priv.[CONTACTS], 'FAX');
				if client_corp%id is not null then
					P_DATA := GetContacts(client_corp.[CONTACTS], 'PHONE')||
				    		  GetContacts(client_corp.[CONTACTS], 'MOBILEPHONE')||				
							  GetContacts(client_corp.[CONTACTS], 'FAX')||
							  trim(P_DATA);
				end if;
				
			elsif p_info = 'Е_МАЙЛ' then
		 		P_DATA := GetContacts(client_priv.[CONTACTS], 'MAIL');
				if client_corp%id is not null then
					P_DATA := GetContacts(client_corp.[CONTACTS], 'MAIL') || trim(P_DATA);
				end if;
		
			elsif p_info = 'INFO_ADDR' then          --INFO_ADDR

                    cl_hist_ref := ::[CL_INFO_REQ].[LIB].GetClInfoQual_OnDate(this, P_DATE_PRINT + 1, 'PRESENCE', val);
				if cl_hist_ref is not null then --по старому, когда реквизит был типа "ЛОГИКА"
					if nvl(val, '0') = '1' then
						P_DATA := 'Присутствует' 	|| NL$;
					else
					    P_DATA := 'Отсутствует'		|| NL$;
					end if;
				else

					if cl_info.[PRESENCE_PLACE].[0] in (1, 2) then
              			P_DATA := P_DATA || 'Отсутствует'	|| NL$;
					else
              			P_DATA := P_DATA || 'Присутствует'	|| NL$;
					end if;

				end if;				
				
			--BS00123652
/*******
			elsif p_info = 'ИПДЛ' then
				P_DATA := GetPDLStr(client_priv.[IS_IPDL], &IPDL);
			elsif p_info = 'РПДЛ' then
				P_DATA := GetPDLStr(client_priv.[IS_IPDL], &RPDL);
			elsif p_info = 'ДЛМО' then
				P_DATA := GetPDLStr(client_priv.[IS_IPDL], &DLMO);
			elsif p_info = 'ПДЛ' then
				P_DATA := GetPDLStr(client_priv.[IS_IPDL], null);		
***********/
			elsif p_info like 'ПДЛ%' then  --для елемешиной

    			val:= GetPDLStr_(client_priv.[IS_IPDL], null,null);		
                if p_info = 'ПДЛ' then
                   if val = 'DLMO' or val = 'IPDL' or val = 'RPDL' then
						P_DATA:='да';
                   else P_DATA:='нет';
                   end if;
			    elsif p_info = 'ПДЛ_РОДСТВЕННИК' then
                   if INSTR(val,'RELATIVE')>0 then
						P_DATA:='да';
                   else P_DATA:='нет';
                   end if;
			    elsif p_info = 'ПДЛ_ОТ_ИМЕНИ' then
                   if INSTR(val,'REPR')>0 then
						P_DATA:='да';
                   else P_DATA:='нет';
                   end if;
                end if;

            elsif p_info = 'РПДЛ' then
				temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
				for dop in this.[ADD_PROP] where dop.[GROUP_PROP].[CODE]='PSH_PDL_RODSTVO' and dop.[DATE_BEG]<P_DATE_PRINT and (dop.[DATE_END] is null or dop.[DATE_END]>=P_DATE_PRINT)
				loop
				temp_str := dop.[PROP].[NAME];
				end loop;
				if temp_str is null then P_DATA:='Нет';
				else P_DATA:='Да'||chr(13)||'Степень родства либо статус (супруг или супруга) клиента по отношению к ПДЛ - '||temp_str;
				end if;

	 		elsif p_info = 'НАЛОГОВЫЙ_СТАТУС' then
	 		--Сведения о налоговом статусе
                if client_priv.[NU_REZIDENT] then
		 			P_DATA := 'являюсь налоговым резидентом только РФ';
                else
		 			P_DATA := 'являюсь налоговым резидентом иностранного государства ';
		 			if client_priv.[COUNTRY].[NAME] is not null then
					    P_DATA :=P_DATA||client_priv.[COUNTRY].[NAME];
					end if;
                end if;				

	 		elsif p_info = 'ГРАЖД_США' then
	 		--Сведения о гражданстве США
                 if client_priv.[BORN].[COUNTRY].[ALFA_3] = 'USA' then
                     if client_priv.[COUNTRY].[ALFA_3] = 'USA' then
	                   P_DATA := 'да';
                     else
		    			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PSH_WAY_NOT');
                     end if;
                 end if;	
			
			elsif p_info = 'ДАТА_ЗАПОЛН' then		--Дата заполнения
				P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_ANK, op_dat)), '');
	
			elsif p_info = 'ДАТА_ОБНОВЛ' then		--Дата обновления
			/*	P_DATA:=client_corp.[FAIL_MARK];
				--Башкиров В.Г. 27.01.2021
				--Поправил расчет параметра 'ДАТА_ОБНОВЛ'.
				--Теперь, если она не определена, вычисляю ее дистрибутивной функцией [CL_CORP].[WRD_JURCL_ANK].get_date_upd
				--Если и она не определяет, вывожу дату операционного дня.
				if P_DATA is null then
					var tmpClientRef ref [CLIENT];
					tmpClientRef:=client_corp%id;
					P_DATA:=coalesce(to_char(get_date_upd(tmpClientRef,P_DATE_PRINT), fmt),to_char(op_dat,fmt), '');
				end if;
			*/	if to_char(client_corp.[DATE_FORM_UPD],fmt) != to_char(nvl(P_DATE_ANK, op_dat),fmt) then
					P_DATA:=to_char(client_corp.[DATE_FORM_UPD],fmt);
				end if;
				
			elsif p_info = 'УРОВЕНЬ_РИСКА' then	 	--Уровень риска
				declare
					fl	ref [FAIL_LEVEL];
					fv	number;
					mrk	::[CLIENT].[FAIL_MARK]%type;
				begin
					if client_corp%id is not null then
						::[LEGAL_INTERFACE].[PRX_CLIENT].getRisk_FailValueAndLevel(client_corp%id, fl, fv, P_DATE_PRINT);
						mrk := client_corp.[FAIL_MARK];
					else
						::[LEGAL_INTERFACE].[PRX_CLIENT].getRisk_FailValueAndLevel(client_priv%id, fl, fv, P_DATE_PRINT);
						mrk := client_priv.[FAIL_MARK];
			 		end if;

					P_DATA := COALESCE(fl.[NAME], fl.[CODE]); --|| ' ' || mrk;

 					if trim(P_DATA) is null then P_DATA := 'Низкий'; end if;      --but если ничего нет, ставим Низкий (Котельников)	
				end;
				
			elsif p_info = 'ИСТОРИЯ_РИСКА' then	 	--история риска
					P_DATA := COALESCE(client_corp.[FAIL_MARK],' ');
					
			-------------------Отметки банка--------------------
			elsif p_info = 'ДАТА_ТЕРРОР' then
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=client_corp%id and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
				order by rez.[CHECK_DATE] desc
					loop
						P_DATA :=to_char(rez.[CHECK_DATE],fmt)||' - '||rez.[CHECK_VAL].[NAME];
					exit;
					end loop;
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
				order by rez.[CHECK_DATE] desc
					loop
						P_DATA :=to_char(rez.[CHECK_DATE],fmt)||' - '||rez.[CHECK_VAL].[NAME];
					exit;
					end loop;
			elsif p_info = 'ДАТА_ЗАМ_СР' then
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=client_corp%id and rez.[CHECK_TYPE].[CODE]='FREEZE_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
						order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt)||' - '||rez.[CHECK_VAL].[NAME];
							exit;
						end loop;
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='FREEZE_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
						order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt)||' - '||rez.[CHECK_VAL].[NAME];
							exit;
						end loop;
			elsif p_info = 'ДАТА_ООН' then
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=client_corp%id and rez.[CHECK_TYPE].[CODE]='LIST_OON' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
						order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt)||' - '||rez.[CHECK_VAL].[NAME];
							exit;
						end loop;
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='LIST_OON' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
						order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt)||' - '||rez.[CHECK_VAL].[NAME];
							exit;
						end loop;
			elsif p_info = 'ОБОСНОВ_РИСКА' then
				P_DATA := '';
                is_benef:=false; is_country:=false; is_prod:=false; is_vid_op:=false;
 				for(
					select crit(
						crit.[CRIT_DATE_BEGIN]	:date_begin
						,crit.[CRIT_DATE_END]	:date_end
						,crit.[CRITERIA].[NAME] :NAME
						,crit.[ACTIVE_FACTORS] :pArr
						,crit.[CRITERIA].[CODE]:code						
					)
					in ::[MONITORING_CRIT] all
					where crit.[CLIENT] = client_corp%id
					and (crit.[CRIT_DATE_BEGIN] is null or crit.[CRIT_DATE_BEGIN] <= op_dat)
					and (crit.[CRIT_DATE_END] is null or crit.[CRIT_DATE_END] >= op_dat)
				)
				loop
 				  if    crit.[CODE] like 'PSH_BENEF%'    then is_benef:=true; 	
                  elsif crit.[CODE] like 'PSH_COUNTRY%'  then is_country:=true; 	
                  elsif crit.[CODE] like 'PSH_PROD%'     then is_prod:=true; 	
                  elsif crit.[CODE] like 'PSH_VID_OP%'   then is_vid_op:=true; 	
                  end if;
                  P_DATA := P_DATA||to_char(crit.date_begin, fmt)||' ';
                  if crit.date_end is not null then
                  	P_DATA := P_DATA||'- '||to_char(crit.date_end, fmt)||' ';
                  end if;				
			      P_DATA := P_DATA||crit.[NAME]||NL$;
				--далее ищем факторы клиента по текущему критерию
						for(
								select x(x%Id : Id)
								in		crit.[pArr]
						
						        where x.[DATE_BEGIN]<= op_dat
						     			and nvl(x.[DATE_END], op_dat)	>= op_dat
						     			)
						     loop
								fc := x.Id;
						        rf:= fc.[FACTOR];
								P_DATA := P_DATA||rf.[NAME]||NL$;
						    end loop;
				end loop;
				
				If P_DATA = ' ' or P_DATA is null then
					P_DATA := 'Критерий риска не соответствует ни одному пункту ПВК оценки высокого или среднего уровня риска';
				else
					P_DATA := ltrim(P_DATA, '; ');
				end if;
			elsif p_info = 'РЕШ_БАНК' then
				P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_RESH_BANK');--CL_ANK_PSH_IDENT_BEN_JUR
	 			if nvl(P_DATA,' ')!=' ' then
	 			   -- P_DATA := 'Бенефициарный владелец установлен';
	 			   null;
	 			end if;
			elsif p_info = 'ОСН_РЕШ_БАНК' then
				P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_OSNOV_RESH');--CL_ANK_PSH_IDENT_BEN_JUR
               	if nvl(P_DATA,' ')=' ' then
                	null;
	 			 	--P_DATA := 'в результате принятых мер Бенефициарный владелец не выявлен';
	 		   	end if;
			elsif p_info = 'ДАТА_НАЧ_ОТН' then
				P_DATA := nvl(to_char(cl_info.[FIRST_ACC_DATE],fmt) , '');
			elsif p_info = 'ДАТА_ПРЕК_ОТН' then
				if cl_info.[CLOSE_DATE] is null then
					declare
					ac	ref	[AC_FIN];
	 				begin
	 					locate ac in ::[AC_FIN] where ac.[CLIENT_V] = client_corp%id and ac.[DATE_CLOSE] is null and rownum = 1;
	 				exception when NO_DATA_FOUND then
	 					begin
	 						select distinct ac(max(ac.[DATE_CLOSE])) in ::[AC_FIN] where ac.[CLIENT_V] = client_corp%id into cl_info.[CLOSE_DATE];
	 					exception when NO_DATA_FOUND then
	 						null;
	 					end;
	 				end;	 					
	 			end if;
	 			P_DATA := nvl(to_char(cl_info.[CLOSE_DATE],fmt) , '');
			elsif p_info = 'ДАТА_ОФОР_АНК' then
				P_DATA := to_char(nvl(P_DATE_ANK, op_dat),fmt);
			elsif p_info = 'ДАТА_ПРЕД_ОБНОВЛ' then
				P_DATA := '';
				for (
				select distinct y(y.c_value : c_y_value) in
				(select distinct x(to_char(to_date(trim(x.[VALUE]),'yyyy-MM-dd hh24:mi:ss'), fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = client_corp%id and x.[QUAL] = 'DATE_FORM_UPD'
				union all
				select distinct x(to_char(x.[DATE_EDIT], fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = client_corp%id and x.[QUAL] = 'MANUAL_EDIT')
				order by to_date(y.c_value, 'dd/MM/yyyy') desc
				)
				loop
					if to_date(y.c_y_value, 'dd/MM/yyyy') < client_corp.[DATE_FORM_UPD] then 
						P_DATA := P_DATA || y.c_y_value || ', ';
					end if;
				end loop;
				P_DATA := rtrim(ltrim(P_DATA, ', '), ', ');
			elsif p_info = 'ДАТЫ_ОБНОВЛ_ВСЕ' then
				P_DATA := to_char(client_corp.[DATE_FORM_UPD],fmt);
				for (
				select distinct y(y.c_value : c_y_value) in
				(select distinct x(to_char(to_date(trim(x.[VALUE]),'yyyy-MM-dd hh24:mi:ss'), fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = client_corp%id and x.[QUAL] = 'DATE_FORM_UPD'
				union all
				select distinct x(to_char(x.[DATE_EDIT], fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = client_corp%id and x.[QUAL] = 'MANUAL_EDIT')
				where y.c_value is not null
					and to_date(y.c_value, 'dd/MM/yyyy') < client_corp.[DATE_FORM_UPD]
				order by to_date(y.c_value, 'dd/MM/yyyy') desc
				)
				loop 
					P_DATA := P_DATA || ', ' || y.c_y_value;
				end loop;
			elsif p_info = 'ПРАВЛЕНИЕ_ФИО' then
				if cl_info.[FIRST_ACC_DATE] is not null then
					P_DATA := ::[CLIENT].[PSH_LIB_1].head_master_fio(cl_info.[FIRST_ACC_DATE]); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB_1 14/10/25
				end if;
			elsif p_info = 'ПРАВЛЕНИЕ_ДОЛЖ' then
				if cl_info.[FIRST_ACC_DATE] is not null then
					P_DATA := ::[CLIENT].[PSH_LIB_1].head_master_casta(cl_info.[FIRST_ACC_DATE]); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB_1 14/10/25
				end if;
			elsif p_info = 'ПРИНЯЛ_ФИО' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(client_org_ref);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_OPEN_USER', cl_info, p_name, p_casta);
					P_DATA := p_name;
				end;
			elsif p_info = 'ПРИНЯЛ_ДОЛЖ' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(client_org_ref);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_OPEN_USER', cl_info, p_name, p_casta);
					P_DATA := p_casta;
				end;
			elsif p_info = 'УТВЕРДИЛ_ФИО' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(client_org_ref);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_CONFIRM', cl_info, p_name, p_casta);
					P_DATA := p_name;
				end;
			elsif p_info = 'УТВЕРДИЛ_ДОЛЖ' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(client_org_ref);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_CONFIRM', cl_info, p_name, p_casta);
					P_DATA := p_casta;
				end;
			elsif p_info = 'ОБН_ЗАПОЛН_ДОЛЖ' then
				P_DATA := null;
				for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
							where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_FORM_UPD'
								order by a.[DATE_EDIT] desc )
				loop
					P_DATA := a.[USER_CASTA];
					exit;
				end loop;
				if P_DATA is null then
					for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
							where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_ANK'
								order by a.[DATE_EDIT] desc )
					loop
						P_DATA := a.[USER_CASTA];
						exit;
					end loop;
				end if;
			elsif p_info = 'ОБН_ЗАПОЛН_ПОЛН' then
				P_DATA := null;
				for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
							where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_FORM_UPD'
								order by a.[DATE_EDIT] desc )
				loop
					P_DATA := a.[USER_NAME];
					exit;
				end loop;
				if P_DATA is null then
					for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
								where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_ANK'
									order by a.[DATE_EDIT] desc )
					loop
						P_DATA := a.[USER_NAME];
						exit;
					end loop;
				end if;
			elsif p_info = 'СФОРМИРОВАЛ_ДОЛЖ' then
				P_DATA := nvl(stdlib.userid.[CASTA].[VALUE], '');
			elsif p_info = 'СФОРМИРОВАЛ_ПОЛН' then
				P_DATA := nvl(::[RUNTIME].[STDLIB].fio(stdlib.userid.[NAME], 'Ф И О'), '');
			-------------------Отметки банка--------------------
				
			elsif p_info = 'КОНТРАГЕНТ' then	 	--КОНТРАГЕНТ
				P_DATA := '';
				if client_corp%id is not null then
					for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'КОНТРАГЕНТ' loop
						temp_str := nvl(cl_link.[PARTNER].[NAME], '');
						P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
					end loop;						
			 		P_DATA := trim(P_DATA);
		 			P_DATA := substr(P_DATA,1,length(P_DATA)-1);
	                P_DATA := P_DATA ||nvl(GetAddProps(P_DATE_PRINT, 'CL_ANK_OSN_KONTR'), '');
		 		end if;
			elsif p_info = 'ИНД_ПРЕДПРИН' then	 	--Сведения о инд. предпринимателе
				if client_corp%id is not null then
					-- Гос. рег. номер
					temp_str := nvl(client_corp.[REGISTER].[GOS_REG_NUM_REC], '');	
					P_DATA := rtl.bool_char(temp_str is null, null, 'Гос.рег. номер: '||temp_str||', ');
					--Серия свид-ва
					temp_str := nvl(client_corp.[REGISTER].[SER_SERT], '');	
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Серия свид-ва: '||temp_str||', ');
					--номер свид-ва
					temp_str := nvl(client_corp.[REGISTER].[NUM_SERT], '');
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Номер свид-ва: '||temp_str||', ');
					--дата рег-ии
					temp_str := COALESCE(::[RUNTIME].[VIEWFUN].DAT_STR(client_corp.[REGISTER].[DATE_REG]), ::[RUNTIME].[VIEWFUN].DAT_STR(client_corp.[REGISTER].[DATE_REESTR]));
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Дата регистрации: '||temp_str||', ');
		 			--место рег-ии	 			
	-- 				STULY в населенном пункте хранится район области, а не район населенного пункта, поэтому район населенного пункта можно взять только из реквизита	DISTRICT 			
	--	 			temp_str := nvl(client_org_ref.[REGISTER].[DISTRICT].[NAME], client_org_ref.[REGISTER].[CITY].[AREA].[NAME]);
		 			temp_str := client_corp.[REGISTER].[DISTRICT].[NAME];
		 			temp_str := rtl.bool_char(temp_str is null, '', temp_str||' р-он');

		 			declare
		 				vCity [NAMES_CITY];
		 			begin
			 			vCity 	 := client_corp.[REGISTER].[CITY];
						temp_str := nvl(vCity.[COUNTRY].[VALUE], '')||'  '||
									nvl(vCity.[OKATO].[NAME], '')||'  '||
									nvl(vCity.[KIND].[SHORT_NAME], '')||' '||
									nvl(vCity.[NAME], '')||' '||
									temp_str;	
		 			end;
	--							nvl(client_org_ref.[REGISTER].[DISTRICT].[NAME], client_org_ref.[REGISTER].[CITY].[AREA].[NAME]);
					temp_str := ltrim(rtrim(temp_str));
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Место выдачи: '||temp_str||', ');
					--рег-ий орган
					temp_str := nvl(client_corp.[REGISTER].[REG_BODY].[NAME], '');
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, 'Рег. орган: '||temp_str||', ');
					
					P_DATA := substr(P_DATA,1,length(P_DATA)-2);
				else
					P_DATA :='';
				end if;
				
			elsif p_info = 'ЛИЦЕНЗИИ' then	 	--ЛИЦЕНЗИИ
				if client_corp%id is not null then
					P_DATA := null;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat				
					)
					loop
					P_DATA := P_DATA
							  ||rtl.bool_char(lic.l_type is null, null, 'Вид лицензии: '||lic.l_type||' ')
							  ||rtl.bool_char(lic.l_num is null, null, 'Номер: '||lic.l_num||' ')
							  ||rtl.bool_char(lic.l_date1 is null, null, ' Дата выдачи: '||to_char(lic.l_date1, ShortFmt)||' ')
							  ||rtl.bool_char(lic.l_date2 is null, null, ' Дата окончания: '||to_char(lic.l_date2, ShortFmt)||' ')
							  ||rtl.bool_char(lic.l_who is null, null, ' Выдана: '||lic.l_who||' ')
							  ||rtl.bool_char(lic.l_list is null, null, ' Виды лицензируемой деятельности: '||lic.l_list)
							  ||NL$||NL$;
					end loop;				
					
					P_DATA := trim(P_DATA);
					P_DATA := rtl.bool_char(P_DATA is null, null, substr(P_DATA, 1, length(P_DATA)-4));
				else
			 		P_DATA := '';
				end if;
				
			elsif p_info = 'ДАТА_СЧЕТА1' then	 	--ДАТА_СЧЕТА1
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_info.[FIRST_ACC_DATE]), '');	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
		 			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(account.[DATE_OP]), '');
		 		else
		 		    P_DATA :='';
		 		end if;

			elsif p_info = 'НОМЕР_СЧЕТА1' then	 	--НОМЕР_СЧЕТА1
				if account is not null then
					P_DATA := account.[MAIN_V_ID];
		 		else
		 		    P_DATA :='';
		 		end if;

--		'ДАТА_ЗАКРЫТИЯ':
			elsif p_info = 'ДАТА_ЗАКРЫТИЯ' then	 	--ДАТА_ЗАКРЫТИЯ
				
				declare
					v_date date;
				begin
					v_date := get_date_close(cl_info, bool_char(client_corp%id is not null, client_corp%id, client_priv%id), P_DATE_PRINT);
				
					if v_date is not null then
						P_DATA:= ::[RUNTIME].[VIEWFUN].DAT_STR(v_date);
					end if;
				end;
		 		
			elsif p_info = 'СОТР_ОТКР' then	 	--СОТР_ОТКР
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_info_user('ACC_OPEN_USER', cl_info.[CL_WORK_USERS], P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[USER_OP];
						if (account is not null) and (u is not null) then
							P_DATA := nvl(u.[NAME], '') || ', ' || u.[CASTA].[VALUE];
						else
							P_DATA :='';
						end if;
					end;
				end if;
				
			if trim(P_DATA) is null then
				P_DATA := 'нет';
			end if;

			elsif p_info = 'СОТР_ОТКР_ПОДР' then
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_depart('ACC_OPEN_USER', cl_info.[CL_WORK_USERS], P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[USER_OP];
						if (account is not null) and (u is not null) then
							P_DATA := ::[DEPART].[LIB].get_declension(u.[DEPART]);
						else
							P_DATA :='';
						end if;
					end;
				end if;	

			if trim(P_DATA) is null then
				P_DATA := 'нет';
			end if;

			elsif p_info = 'СОТР_УТВ' then	 	--СОТР_УТВ
				P_DATA := get_cl_info_user('ACC_CONFIRM', cl_info.[CL_WORK_USERS], P_DATE_PRINT);
			elsif p_info = 'СОТР_УТВ_ПОДР' then
				P_DATA := get_cl_depart('ACC_CONFIRM', cl_info.[CL_WORK_USERS], P_DATE_PRINT);
				
			elsif p_info = 'СОТР_ОТВ' then	 	--СОТР_ОТВ
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_info_user('ACC_MANAGER', cl_info.[CL_WORK_USERS],  P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[OTV];
						if (account is not null) and (u is not null) then
							P_DATA := nvl(u.[NAME], '') || ', ' || u.[CASTA].[VALUE];
						else
							P_DATA :='';
						end if;
					end;
				end if;		 	
			elsif p_info = 'СОТР_ОТВ_ПОДР' then	 	--СОТР_ОТВ
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_depart('ACC_MANAGER', cl_info.[CL_WORK_USERS],  P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[OTV];
						if (account is not null) and (u is not null) then
							P_DATA := ::[DEPART].[LIB].get_declension(u.[DEPART]);
						else
							P_DATA :='';
						end if;
					end;
				end if;				
			elsif p_info = 'ЗАПОЛНИЛ' then	 	--ЗАПОЛНИЛ
				P_DATA := nvl(::[RUNTIME].[STDLIB].fio(stdlib.userid.[NAME], 'Ф И. О.'), '');
			elsif p_info = 'ЗАПОЛНИЛ_ДОЛЖ' then
				P_DATA := nvl(stdlib.userid.[CASTA].[VALUE], '');	
			elsif p_info = 'ЗАПОЛНИЛ_ПОДР' then
				P_DATA := nvl(::[DEPART].[LIB].get_declension(::[SYSTEM].[VARIABLES].OurDepart), '');		
		 		
			elsif p_info = 'РУК_ПОДР' then	 	--РУК_ПОДР
				if P_HEADUSER_STR  is not null then
					P_DATA := P_HEADUSER_STR;
		 		else
		 		    P_DATA :='';
		 		end if;

		 	elsif p_info = 'ВЫГОДОПРИОБРЕТАТЕЛЬ' then
		 		P_DATA := null; --but
		 		if client_corp%id is null then
		 			v_cl_links := client_priv.[LINKS_OTHER];
		 		else
		 			v_cl_links := client_corp.[LINKS_OTHER];
		 		end if;	
		 		
		 		for(select l(l.[PARTNER]->(false)[NAME] : partner_name)
					in v_cl_links
					where l.[VID_LINK].[CODE] = 'ВЫГОДОПРИОБРЕТАТЕЛЬ')
				loop
					temp_str := nvl(l.partner_name, '');
					P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
				end loop;
				
				if P_DATA is null then
					P_DATA := 'нет';
				ELSE P_DATA := 'да, предоставляются сведения о выгодоприобретателе (Анкета)';
				end if;
		 	
		 	
/******
		 		if client_corp%id is null then
		 			v_cl_links := client_priv.[LINKS_OTHER];
		 		else
		 			v_cl_links := client_corp.[LINKS_OTHER];
		 		end if;	
		 		
		 		for(select l(l.[PARTNER]->(false)[NAME] : partner_name)
					in v_cl_links
					where l.[VID_LINK].[CODE] = 'ВЫГОДОПРИОБРЕТАТЕЛЬ')
				loop
					temp_str := nvl(l.partner_name, '');
					P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
				end loop;
				
				if P_DATA is null then
					P_DATA := 'нет сведений';
				end if;
*/				
/*				
				P_DATA := rtrim(P_DATA,' ,');
				P_DATA := P_DATA || NL$ || 'Выгододатели: ';
				for(
					select l(l.[PARTNER]->(false)[NAME] : partner_name)
					in v_cl_links
					where l.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ')
				loop
					temp_str := nvl(l.partner_name, '');
					P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
				end loop;
				P_DATA := rtrim(P_DATA,' ,');
*/				

		 	elsif p_info = 'ВЫГОДОДАТЕЛЬ' then
		 		P_DATA := null;
		 		if client_corp%id is null then
		 			links_ref := client_priv.[LINKS_OTHER];
		 		else
		 			links_ref := client_corp.[LINKS_OTHER];
		 		end if;	
		 		
		 		for(select cl_link(cl_link.[PARTNER]->(false)[NAME] : partner_name,
                             cl_link.[PARTNER] : partner)
					in ::[LINKS_CL] all
					where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ'
                    		and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)					
					
				loop

					var rTmpCl number;
--                        rTmpCl:=links_ref;
					temp_str := nvl(cl_link.partner_name, '');
					P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');
					declare
   					acc	ref [AC_FIN];

					begin
     				    rTmpCl:=cl_link.[PARTNER];
                        locate acc in ::[AC_FIN] where acc.[CLIENT_V] = rTmpCl;
                        if acc.[MAIN_V_ID] is not null then
	                        P_DATA := P_DATA || ' счет '||acc.[MAIN_V_ID];
                        end if;
					exception
						when NO_DATA_FOUND then null;
					end;
		 		end loop;
				
				if P_DATA is null then
					P_DATA := 'нет';
				end if;

			elsif	p_info = 'ПОДРАЗДЕЛЕНИЕ' then
				if P_DEPART_STR is not null then
					P_DATA := P_DEPART_STR;
				else
					P_DATA := '           ';
				end if;
	
			elsif p_info = 'ОСНОВАНИЕ' then
				P_DATA := '';
				links_ref := NULL;
				if (client_corp%id is not null) then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];				
				end if;
				
				if (links_ref is not null) then
					for cl_link
						in ::[LINKS_CL] ALL
						where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ'
								and cl_link%collection = links_ref
						order by cl_link.[DATE_BEG]
					loop
						if (cl_link.[FOUND] is not null)
							and (cl_link.[DATE_BEG]<=P_DATE_PRINT or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END]>=P_DATE_PRINT or cl_link.[DATE_END] is null) then
							P_DATA := rtl.bool_char(P_DATA is not null, P_DATA || NL$, '') || cl_link.[FOUND];
						end if;			
					end loop;			 					
				end if;
	
			elsif p_info = 'ДАТА_ЗАПОЛН_ВЫГ' then	
				P_DATA := '';
				links_ref := NULL;
				if (client_corp%id is not null) then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];				
				end if;
				
				if (links_ref is not null) then
					for cl_link in ::[LINKS_CL] ALL
							 where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ'
							   and cl_link%collection = links_ref
					      order by cl_link.[DATE_BEG]
					loop
						if (cl_link.[DATE_BEG] is not null) then
							P_DATA := ::[RUNTIME].[VIEWFUN].DAT_STR(cl_link.[DATE_BEG]);
							exit;
						end if;			
					end loop;			 					
				end if;	
			elsif p_info in ('ВЫГОДОДАТ_С_ОСН', 'ВЫГОДОПРИ_С_ОСН') then
				if (client_corp%id is not null) then
					V_CL_LINKS := client_corp.[LINKS_OTHER];
				else
					V_CL_LINKS := client_priv.[LINKS_OTHER];				
				end if;
				
				if p_info = 'ВЫГОДОДАТ_С_ОСН' then
					P_DATA := fill_benefit(P_DATE_PRINT, V_CL_LINKS, ::[CL_LINK]([CODE]='ВЫГОДОДАТЕЛЬ'), true, true);
				elsif p_info = 'ВЫГОДОПРИ_С_ОСН' then
					P_DATA := fill_benefit(P_DATE_PRINT, V_CL_LINKS, ::[CL_LINK]([CODE]='ВЫГОДОПРИОБРЕТАТЕЛЬ'), true, true);
				end if;
			elsif p_info = 'КОДЫ_ОКВЭД' and client_corp%id is not null then
				declare
					okv [OKVED];
					date_ank date;
				begin
					date_ank := nvl(P_DATE_ANK, op_dat);
					okv := ::[LEGAL_INTERFACE].[PRX_CLIENT].Get_Main_OKVED(client_corp%id, date_ank);
					P_DATA := 'Основной: ' || okv.[CODE] || ' ' || okv.[NAME] || NL$ || 'Допустимые: ';
					
					for (
						select o(
							o.[OKVED].[CODE] : CODE,
							o.[OKVED].[NAME] : NAME
						)
						in client_corp.[OKVED_IN_PERIOD]
						where nvl(o.[MAIN], false) = false
							and (o.[DATE_BEGIN] <= date_ank or o.[DATE_BEGIN] is null)
							and (o.[DATE_END] >= date_ank or o.[DATE_END] is null)
					)loop
						P_DATA := P_DATA || o.[CODE] || ' ' || o.[NAME] || NL$;
					end loop;
				end;
			
			elsif p_info = 'ПРИНЦИПАЛ' then   --ПРИНЦИПАЛ BS00299498
				for i in principal.first..principal.last
				loop
					P_DATA := P_DATA || ', ' || principal(i);					
				end loop;	
				P_DATA := nvl(rtrim(ltrim(P_DATA, ', '), ', '), '');	
			
	 		elsif p_info = 'ОБОСН_РИСКА' then
                is_benef:=false; is_country:=false; is_prod:=false; is_vid_op:=false;
 				for(
					select crit(
						crit.[CRITERIA].[NAME] :NAME
					    ,crit.[ACTIVE_FACTORS] :pArr						
						,crit.[CRITERIA].[CODE]:code						
					)
					in ::[MONITORING_CRIT] all
					where crit.[CLIENT] = client_org_ref
						and (crit.[CRIT_DATE_BEGIN] is null or crit.[CRIT_DATE_BEGIN] <= op_dat)
						and (crit.[CRIT_DATE_END] is null or crit.[CRIT_DATE_END] >= op_dat)
				)loop
 				  if    crit.[CODE] like 'PSH_BENEF%'    then is_benef:=true; 	
                  elsif crit.[CODE] like 'PSH_COUNTRY%'  then is_country:=true; 	
                  elsif crit.[CODE] like 'PSH_PROD%'     then is_prod:=true; 	
                  elsif crit.[CODE] like 'PSH_VID_OP%'   then is_vid_op:=true; 	
                  end if;					
				  P_DATA := P_DATA||crit.[NAME]||NL$;
--далее ищем факторы клиента по текущему критерию
for(
		select x(x%Id : Id)
		in		crit.[pArr]

        where x.[DATE_BEGIN]<= op_dat
     			and nvl(x.[DATE_END], op_dat)	>= op_dat
     			)
     loop
		fc := x.Id;
        rf:= fc.[FACTOR];
		P_DATA := P_DATA||rf.[NAME]||NL$;
    end loop;
				end loop;

                  if not is_benef   then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск по типу клиента и (или) бенефициарного владельца;'||NL$; end if;
                  if not is_country then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Страновой риск;'||NL$; end if;
                  if not is_prod    then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск продукта;'||NL$; end if;
                  if not is_vid_op  then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск, связанный с проведением клиентом определенного вида операций;'||NL$; end if;

-- Кокорин АС 03.09.14 для печати обоснования оценки рика из реквизита "Оценка риска легализации"				
			--	P_DATA := ltrim(P_DATA, '; ');
				If P_DATA = ' ' or P_DATA is null then
					P_DATA := 'Критерий риска несоответствует ни одному пункту ПВК оценки высокого или среднего уровня риска';
				else
				--	P_DATA := this.[FAIL_MARK];
					P_DATA := ltrim(P_DATA, '; ');
				end if;
--------------------------------------------------------------------------------------------------	

			elsif p_info = 'OPER_CHARACTER' then
				P_DATA := client_corp.[OPER_CHARACTER];
	 		
	 		elsif p_info = 'ВНОСИТЕЛЬ' then
	 			declare
	 				m_card string(100)	:= null;
	 			begin
	 				for(
						select links(
							links.[PARTNER] 			:PARTNER,
							decode(links.[PARTNER]->([CL_PRIV])[BORN],
										null,
										links.[PARTNER]->([CL_PRIV])[DOC].[BIRTH_PLACE],
										links.[PARTNER]->([CL_PRIV])[BORN].[NAME]
									)	:B_PLACE
						)
						in [LINKS_OTHER]
						where links.[VID_LINK].[CODE] = 'ВНОСИТЕЛЬ'
						and links.[PARTNER]%class = 'CL_PRIV'
					)
					loop
						m_card := migr_card_str(links.[PARTNER]);
						if m_card is not null then
							m_card := 'Миграционная карта № '||m_card||LF$;
						end if;
						P_DATA := P_DATA||::[LEGAL_INTERFACE].[PRX_FP].stock_lib_client_get_reqvs(
												links.[PARTNER],
												'{[_ИМЯ];'||LF$||'}'||
												'{[ДАТАРОЖД]; }'||links.[B_PLACE]||LF$||
												'{[_ГРАЖДАНСТВО];'||LF$||'}'||
												'{[адрес_ю];'||LF$||'}'||
												'{[документ];'||LF$||'}'||
												m_card||
												'{[ИНН];'||LF$||'}'||
												'{[тел.]}{/[факс]}'||' '||GetContacts(links.[PARTNER].[CONTACTS], 'MAIL')
											)||NL$;
					end loop;
	 			end;

			elsif p_info = 'ВИД_ДЕЯТЕЛЬНОСТИ' then --BS00478024
				declare
					cl ref [CL_ORG];
				begin
					locate cl in ::[CL_ORG] where cl%id = client_corp%id;
					P_DATA := trim(cl.[BUSINESS]);
				exception
					when NO_DATA_FOUND then null;
				end;
				
	 		elsif p_info like 'КТО_БЕНЕФИЦИАР%' then
				P_DATA := null;

					select cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name
							)
						in client_corp.[LINKS_OTHER]

						where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
                         into link_ben;
				--if link_ben.count = 0 then
                --   P_DATA:= 'Бенефициарным владельцем клиента - физического лица является это лицо';
				--else
                --   P_DATA:= 'Бенефициарным владельцем клиента  является иное лицо. Предоставляются сведения о бенефициаром владельце (Анкета)';
				--end if;							
				P_DATA := 'Бенефициарным владельцем клиента является это лицо';
				
	 		elsif p_info = 'БЕНЕФИЦИАР' then
/********
				P_DATA := '';
				if client_corp%id is not null then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];
				end if;
				for
					(select cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name)
						in ::[LINKS_CL] all
						where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
							and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)
				loop
					P_DATA := P_DATA || ', ' || cl_link.partner_name;
				end loop;
				P_DATA := ltrim(P_DATA,', ');
************/

--				P_DATA := 'Бенефициары: ';
				P_DATA := '';

				links_ref := NULL;
				if client_corp%id is not null then links_ref := client_corp.[LINKS_OTHER];
--debug_pipe('1',0);				
				else links_ref := client_priv.[LINKS_OTHER];
--debug_pipe('2',0);				
				end if;

        	    if (links_ref is not null) then

                 for cl_link in ::[LINKS_CL] ALL
                             where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
  								 and cl_link%collection = links_ref
		 					     and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
		 					     and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
						         order by cl_link.[DATE_BEG]

                 loop
					temp_str := nvl(cl_link.[PARTNER].[NAME], cl_link.[CLIENT_NAME]);
					temp_str := temp_str || '. Адрес регистрации: ' || GetAddress(cl_link.[PARTNER].[ADDRESSES],'ALL','REGISTRATION');					
					temp_str := temp_str || '. Адрес места жительства: ' || GetAddress(cl_link.[PARTNER].[ADDRESSES],'ALL','REAL_LIVE');					

                    cl_priv := cl_link.[PARTNER];
                    temp_str := temp_str || '. Документ: ' || Get_Passport(cl_priv);
                    temp_str := temp_str || '. Дата Рождения: ' || nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_priv.[DATE_PERS]), '');
                    temp_str := temp_str || '. Место Рождения: ' || cl_priv.[DOC].[BIRTH_PLACE];
--										
					P_DATA := P_DATA || rtl.bool_char(temp_str is not null, temp_str|| ', ', '');

                 end loop;
				end if; --links_ref is not null

	           	P_DATA := ltrim(P_DATA,', ');

	 		elsif p_info = 'ПРЕДСТАВИТЕЛЬ' then
				P_DATA := '';
				if client_corp%id is not null then
					links_ref := client_corp.[LINKS_OTHER];
				else
					links_ref := client_priv.[LINKS_OTHER];
				end if;
				for
					(select cl_link	(trim(coalesce(cl_link.[PARTNER]->(true)[NAME],cl_link.[CLIENT_NAME])) : partner_name)
						in ::[LINKS_CL] all
						where cl_link.[VID_LINK].[CODE] = 'ПРЕДСТАВИТЕЛЬ'
							and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)
				loop
					P_DATA := P_DATA || ', ' || cl_link.partner_name;
				end loop;

				-- Клиент представляет другого клиента по доверености
				for(
/*			 		 select x(x.[ini_client].[name]		: client_name,
