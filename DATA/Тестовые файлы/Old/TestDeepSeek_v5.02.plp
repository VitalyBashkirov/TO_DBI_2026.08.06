-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_STRING_AS_CLASS_p_4_15 IS
    v_class_name VARCHAR2(100);
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.STRING_AS_CLASS.п.4.15 Не разрешено использование строки вместо ::[CLASS]%class =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- IF v_class_name = 'CLIENT' THEN ...
        
        -- [+] ПРАВИЛЬНО
        IF v_class_name = ::[CLIENT]%class THEN ...
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;

-- ============================================================================
-- Правило: v5.STYLE.DEREFERENCE_OUT_PARAM.п.4.16
-- Описание: Запрещено передавать в out параметры реквизиты ссылочных переменных
-- Категория: STYLE
-- Приоритет: high
-- Теги: out, parameter, ref
-- 3.RUBRICATOR_FIXES.md: Запрещено передавать в out параметры реквизиты ссылочных переменных
-- 4.RUBRICATOR_PROMPTS.json:
--   documentation_text: Передача реквизитов ссылок в OUT параметры может привести к модификации БД.
--   plplus_materials_note: Используйте промежуточные переменные.
--   search_prompt: Найти вызовы с OUT параметрами, где передаются реквизиты ссылок.
--   code_example_bad: get_value(v_ref.attr, p_out);
--   fix_instruction: Использовать промежуточную переменную.
-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_DEREFERENCE_OUT_p_4_16 IS
    v_ref REF [CLIENT];
    v_value NUMBER;
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.DEREFERENCE_OUT_PARAM.п.4.16 Запрещено передавать в out параметры реквизиты ссылочных переменных =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- get_value(v_ref.[ID], v_value);
        
        -- [+] ПРАВИЛЬНО
        v_value := v_ref.[ID];
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;