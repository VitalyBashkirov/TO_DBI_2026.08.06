			dtt := LAST_DAY(ADD_MONTHS(dt_oper_d,-1));
			dta := LAST_DAY(ADD_MONTHS(dt_oper_d,-2))+1;
			-- ищем соответствие для счета
			ftod := null;
			begin
				locate ftod in ::[OSB_OAO_F_TO_D] where ftod.[ACC_NEW] = vacc;
			exception when OTHERS then
				ftod := null;
			end;
			if ftod is not null then
				if LAST_DAY(dtt+1) = LAST_DAY(ftod.[ACC_PR].[DATE_CLOSE]) then
					vacc := ftod.[ACC_PR];
				end if;
			end if;
			dy := dtt - dta;
			for i in 0..dy loop
				smm := nvl(vacc.[GET_SALDO](dta+i, sm, sm_nt, null, true),0);
				sms := sms + smm;
				&debug(dta+i||' '||dtt||' '||smm);
			end loop;
			&debug(sms);
			sms := sms/(dy+1);
			&debug(sms);
			if sms <= 50000 then
				varRet:= 0; goto nnn;
			else
				varRet:= 1; goto nnn;
			end if;
		end;*/
		null;
	end if;
