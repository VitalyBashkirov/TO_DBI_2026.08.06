class MAIN_DOCUM;

@name('[ПСБ] Перевести документ из состояния "%" - > "Не обработан"')
@tag('KUP_P')
method PSH_TO_NEOB is
PSH_TO_NEOB is

execute is
/*********************************************************************
Назначение:

tirskih, последнее изменение 13 Апрель 2010 г.
*********************************************************************/
begin

	if this%state='WAIT_DVALUT' then
		this%state := 'VOZV';
	end if;
	if this%state='TO_KASSA' then
		this.[TEXT_VOZV]:=sysdate||stdlib.UserId.[NAME]||' Переведен в предыдущее состояние с помощью "'||&METHOD$SNAME||'"';
		this%state := 'VOZV';
	end if;
	if this%state='ON_DISTR' then --На распределении не умеет переходить в Не обработан Башкиров В.Г. 16.06.2014
		this%state := 'TO_KRED';
	end if;
	if this%state='PODTV' then --На подтверждение не умеет переходить в Не обработан Башкиров В.Г. 17.12.2012
		this%state := 'PRO';
	end if;
	if this%state in ('PRO','TO_RKO_CUR','WAIT_PROV') then --Проконтролировать не умеет переходить в Не обработан Башкиров В.Г. 26.07.2012	--Ожидает проводки не умеет переходить в Не обработан Башкиров В.Г. 13.02.2019
		if this%state = 'TO_RKO_CUR' then	--На валютный контроль 
			for vcs in ::[VAL_CONTR_SUBJ] all --Валютные контракты. Субъекты
			where vcs.[DOC]=this
			loop
				vcs%delete;
			end loop;
			for bvc in ::[BASE_VAL_CLIENT] all --Валютный контроль. Контрагент
			where bvc.[DOC]=this
			loop
				bvc%delete;
			end loop;
		end if;
		
		this.[TEXT_VOZV]:=trim(this.[TEXT_VOZV]||' Переведено "На возврат" с помощью служебной операции "'||&METHOD$NAME ||'"');
		this%state := 'VOZV';
	end if;
	this%state := 'FORM';

	for row in this.HISTORY_STATE all loop
		row.[DELETE#AUTO];
	end loop;
	
	--Башкиров В.Г. 28.07.2025 на примере Платежного документ ID:5167683155
	--Документ стал на доп.контроль. Операционист потребовалось его откорректировать. 
	--Вернул в "Не обработан" операцией "[ПСБ]. Перевести документ из состояния "%" - > "Не обработан"",
	--Операционист отредактировали но по F2 повторно в "Дополнительный контроль" документ не становился
	--т.к. в ::[AUX_CTRL_ACCEPT]-Дополнительный контроль. Подтверждение пользователем
	--были с записям с объектом контроля-ID:5167683155
	begin
		delete aca in [AUX_CTRL_ACCEPT] where aca.[CTRL_OBJ]%id=this%id;
	exception when others then
		null;
	end;
end;
end;
end;
