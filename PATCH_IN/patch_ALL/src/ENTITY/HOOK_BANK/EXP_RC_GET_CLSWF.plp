class HOOK_BANK;

@optimize(false)
@import_plsql(true)
@this(create_on_start:=true)
@generate_ansi_joins(true)
@name('[ПСБ]. РЦ. Формирование строки с реквизитами клиента для документа SWIFT')
@tag('EXP_SWIFT')
static method EXP_RC_GET_CLSWF is


pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);

v_ExpTransAddSwift boolean; --[ПСБ]. Включить подмену адресов на английском в документах SWIFT ?

public gTeg string(250); -- Здесь, то что может быть вычислено в ::[HOOK_BANK].[EXP_GET_PR_ADDR]-[ПСБ]. Получить строковое представление адреса

function iif(
	p_v1 boolean
	, p_v2 varchar2(32767)
	, p_v3 varchar2(32767)
) return varchar2(32767) is
ret_val varchar2(32767);
begin
	if p_v1 then
		ret_val := p_v2;
	else
		ret_val := p_v3;
	end if;
	return ret_val;
end;

procedure AddRpadName(p_name in out string(2000)) is
lng integer;
begin
	lng := length(p_name);
	if lng in (0,35,70,105) then
		null;
	elsif lng < 35 then
		p_name:=rpad(p_name, 35);
	elsif lng < 70 then
		p_name:=rpad(p_name, 70);
	elsif lng < 105 then
		p_name:=rpad(p_name,105);
	elsif lng < 140 then
		p_name:=rpad(p_name,140);
	end if;
end;

procedure CropLastChrWord (
	p_s1 in out string(2000)
	, p_s2 in out string(2000)
	, p_flFirstCrop boolean default false
) is
	ret_val number;
	l integer := length(p_s1);
	l2 integer := length(p_s2);
	rzd string(50):=' ,.":;<>()[]!''';
	rzd4 string(50):=',';
	ch1 string(1);
	LenAddChr number:=0;
	ExNum2 number:=0;
	vOtp string(2);

	procedure getExtNum(p_num integer) is
	begin
		ret_val := p_num;
		for i in reverse 1..p_num loop
			ch1:=substr(p_s1,i,1);
			if instr(rzd,substr(p_s1,i,1))>0 then
				ret_val:=greatest(i,0);
				exit;
			end if;
		end loop;
	end;

	procedure getLastExtNum is
	begin
		for i in reverse 106 .. 141 loop
			ch1:=substr(p_s1,i,1);
			if instr(rzd4,substr(p_s1,i,1))>0 then
				ret_val:=greatest(i,0);
				if ret_val<=140 then
					exit;
				end if;
			end if;
		end loop;
		ret_val:=least(ret_val,140);
		p_s1:=rtrim(substr(p_s1,1,ret_val),',');
	end;
begin
	::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||TB$||'.CropLastChrWord > ('||p_flFirstCrop||') p_s1="'||p_s1||'" p_s2="'||p_s2||'"',1);
	if L=0 and L2>0 then 
		p_s1:= trim(p_s2);
		L := length(p_s1);
		p_s2:= null;
		if L <= 35 then
			ret_val:= nvl(length(p_s1),0);
		elsif L <= 70 then
			getExtNum(35);
		elsif L <=105 then
			getExtNum(70);
		elsif L <=140 then
			getExtNum(105);
		else
			getLastExtNum;
		end if;

		vOtp := substr(p_s1,1,2);
		if p_s1 is not null and vOtp in ('1/','2/','3/') then
			AddRpadName(p_s1);
			ret_val:=length(p_s1);
			p_s2:=vOtp||p_s2;
		end if;

		p_s2:=rtrim(substr(substr(p_s1,ret_val+1)||p_s2	,1,p_s2%size));
		p_s1:=substr(substr(p_s1,1,ret_val),1,p_s1%size);
		L :=length(p_s1);
	end if;

	if p_flFirstCrop then
		if L<= 35 then
			ret_val:=L;
		else
			getExtNum(35);
		end if;
		p_s2:=rtrim(substr(substr(p_s1,ret_val+1)||p_s2	,1,p_s2%size));
		L2:=nvl(length(p_s2),0); 
		p_s1:=substr(substr(p_s1,1,ret_val),1,p_s1%size);
		L :=nvl(length(p_s1),0); 
	else
		if L in (0,35,70,105,140) and (L2=0 or nvl(instr(rzd,substr(p_s2,1,1)),0)=1) then
			ret_val:=L;
		elsif L < 35 then
			ret_val:=L;
		elsif L < 70 then
			getExtNum(35);
		elsif L < 105 then
			getExtNum(70);
		elsif L < 140 then
			getExtNum(105);
		else
			getLastExtNum;
		end if;
		
		--Если последний символ p_s1 не разделитель и пограничный, добавим пробел для предотвращения слипания 9ABUILD.3->9A BUILD.3 40702840601000000211-ООО "Формтрэйд"
		if length(p_s1)>0 and length(p_s2)>0 and length(p_s1) not in (35,70,105,140) and instr(rzd,substr(p_s1,length(p_s1),1))=0 and instr(rzd,substr(p_s2,1,1))=0 then
			p_s1:=p_s1||' ';
		end if;
		
		p_s2 := rtrim(substr(substr(p_s1,ret_val+1)||p_s2	,1,p_s2%size));
		L2 := nvl(length(p_s2),0);
		p_s1 := substr(substr(p_s1,1,ret_val),1,p_s1%size);
		L := nvl(length(p_s1),0);
	end if;

	L :=nvl(length(p_s1),0);
	L2:=nvl(length(p_s2),0);
	
	LenAddChr:=0;
	
	if L in (0,35,70,105,140) then
		null;
	elsif ret_val< 35 then
		LenAddChr:= 35-ret_val;
	elsif ret_val< 70 then
		LenAddChr:= 70-ret_val;
	elsif ret_val<105 then
		LenAddChr:=105-ret_val;
	elsif ret_val<140 then
		LenAddChr:=140-ret_val;
	end if;

	if LenAddChr>0 and length(p_s2)>0 then
		if length(p_s2)<LenAddChr or instr(' ',substr(p_s2,LenAddChr+1,1))>0 then
			p_s1:=p_s1||substr(p_s2,1,LenAddChr);
			p_s2:=substr(p_s2,LenAddChr+1);
		else
			ExNum2:=0;
			for i in reverse 1..LenAddChr loop
				ch1:=substr(p_s2,i,1);
				if instr(rzd,substr(p_s2,i,1))>0 then
					ExNum2:=greatest(i,0);
					exit;
				end if;
			end loop;
			if ExNum2>0 then
				ret_val:=ret_val+ExNum2;
				p_s1:=p_s1||substr(p_s2,1,ExNum2);
				p_s2:=substr(p_s2,ExNum2+1);
				if instr(',',substr(p_s2,1,1))>0 then
					p_s2:=substr(p_s2,2);
				end if;
			end if;
		end if;
	end if;

	AddRpadName(p_s1);

	if substr(p_s1,length(p_s1)) = ' ' then
		p_s2:=ltrim(p_s2);
	end if;
	p_s2:=rtrim(p_s2);
	::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||TB$||'.CropLastChrWord < ('||p_flFirstCrop||') p_s1="'||p_s1||'" p_s2="'||p_s2||'"',1);
end;

procedure AddPart
(
	p_s1 in out string(2000)
	, p_s2 in out string(2000)
	, p_opt string(1)
	, p_flFirstCrop boolean default false
)
is
	LnName number;
	vOpt string(2);
	LnName2 number;
	vOpt2 string(2);
begin
	CropLastChrWord(p_s1,p_s2,p_flFirstCrop);

	if p_s2 is not null and p_s2 is not null and nvl(p_opt, '*') = 'F' then
		LnName:=nvl(length(p_s1),0);
		vOpt:=null;

		if LnName<= 35 then
			vOpt:=substr(p_s1, 1,2);
		elsif LnName<= 70 then
			vOpt:=substr(p_s1, 36,2);
		elsif LnName<=105 then
			vOpt:=substr(p_s1, 71,2);
		elsif LnName<=140 then
			vOpt:=substr(p_s1,106,2);
		end if;

		if vOpt not in ('1/','2/','3/') then
			vOpt:=null;
		end if;

		if vOpt is not null then
			LnName2:=nvl(length(p_s2),0);
			vOpt2:=null;
			if LnName2<= 35 then
				vOpt2:=substr(p_s2,  1,2);
			elsif LnName2<= 70 then
				vOpt2:=substr(p_s2, 36,2);
			elsif LnName2<=105 then
				vOpt2:=substr(p_s2, 71,2);
			elsif LnName2<=140 then
				vOpt2:=substr(p_s2,106,2);
			end if;

			if vOpt2 not in ('1/','2/','3/') then
				vOpt2:=null;
			end if;

			if vOpt2 is null then
				p_s2:=vOpt||trim(p_s2);
			end if;
		end if;
	end if;
end;

function IsThisCountry
(
	p_ImpStr [STRING_250]
	, p_rzd string(1)
	, p_Tag number
	, p_cnt_tag number
	, p_country in out string(2)
) return string(2000) is
	ret_val string(2000);
begin
	ret_val:=trim(::[HOOK_BANK].[EXP_GET_PR_ADDR].wbn(p_ImpStr, p_rzd, p_Tag));
	if length(ret_val)=2 and ret_val=trim(::[HOOK_BANK].[EXP_GET_PR_ADDR].wbn(p_ImpStr, p_rzd, p_cnt_tag)) then
		for cntry in ::[COUNTRY] where cntry.[ALFA_2] = ret_val loop
			p_country:=ret_val; 
			ret_val:=null;
			exit;
		end loop;
	end if;
	return ret_val;
end;

procedure NormalName140 (p_name in out string(2000)) is
	s1 string(35):=substr(p_name, 1, 35);
	s2 string(35):=substr(p_name, 36, 35);
	s3 string(35):=substr(p_name, 71, 35);
	s4 string(2000):=substr(p_name,106);
	rzd string(50):=' ,.":;<>()[]!''';
	ch1 char;
	ExNum number;
begin
	::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> s1('||length(s1)||')="'||s1||'"', 5);
	::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> s2('||length(s2)||')="'||s2||'"', 5);
	::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> s3('||length(s3)||')="'||s3||'"', 5);
	::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> s4('||length(s4)||')="'||s4||'"', 5);
	if substr(s2, 1,3) in ('1/ ','2/ ','3/ ') then ExNum:=0;
		for i in reverse 1..35 loop
			ch1:=substr(s2,i,1);
			if instr(rzd,substr(s2,i,1))>0 then
				ExNum:=greatest(i,0);
				exit;
			end if;
		end loop;
		if ExNum>0 then
			s2:=substr(s2,1,2)||substr(s2,4,ExNum-1)||' '||substr(s2,ExNum+1);
		end if;
	end if;
	if substr(s3, 1,3) in ('1/ ','2/ ','3/ ') then ExNum:=0;
		for i in reverse 1..35 loop
			ch1:=substr(s3,i,1);
			::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> s3 ch1('||i||')="'||ch1||'"'||' instr('||rzd||',substr(s3,'||i||',1))='||instr(rzd,substr(s3,i,1)), 5);
			if instr(rzd,substr(s3,i,1))>0 then
				ExNum:=greatest(i,0);
				exit;
			end if;
		end loop;
		::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> (2)ExNum='||ExNum||' length(s3)='||length(s3),1);
		if ExNum>0 then
			s3:=substr(s3,1,2)||substr(s3,4,ExNum-1)||' '||substr(s3,ExNum+1);
		end if;
	end if;
	if substr(s4, 1,3) in ('1/ ','2/ ','3/ ') then
		ExNum:=0;
		for i in reverse 1..35 loop
			ch1:=substr(s4,i,1);
			::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> s4 ch1('||i||')="'||ch1||'"'||' instr('||rzd||',substr(s4,'||i||',1))='||instr(rzd,substr(s4,i,1)), 5);
			if instr(rzd,substr(s4,i,1))>0 then
				ExNum:=greatest(i,0);
				exit;
			end if;
		end loop;
		::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> (3)ExNum='||ExNum||' length(s4)='||length(s4),1);
		if ExNum>0 then
			s4:=substr(s4,1,2)||substr(s4,4,ExNum-1)||' '||substr(s4,ExNum+1);
		end if;
	end if;
	if substr(s2, 1,1)=' ' then
		ExNum:=0;
		for i in reverse 1 .. 35 loop
			ch1:=substr(s2,i,1);
			if instr(rzd,substr(s2,i,1))>0 then
				ExNum:=greatest(i,0);
				exit;
			end if;
		end loop;
		::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> (4)ExNum='||ExNum,1);
		if ExNum>0 then
			s2:=substr(s2,2,ExNum-1)||' '||substr(s2,ExNum+1);
		end if;
	end if;
	if substr(s3, 1,1)=' ' then
		ExNum:=0;
		for i in reverse 1..35 loop
			ch1:=substr(s3,i,1);
			if instr(rzd,substr(s3,i,1))>0 then
				ExNum:=greatest(i,0);
				exit;
			end if;
		end loop;
		::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> (5)ExNum='||ExNum||' length(s3)='||length(s3),1);
		if ExNum>0 then
			s3:=substr(s3,2,ExNum-1)||' '||substr(s3,ExNum+1);
		end if;
	end if;
	if substr(s4, 1,1)=' ' then
		ExNum:=0;
		for i in reverse 1..35 loop
			ch1:=substr(s4,i,1);
			::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> s4 ch1('||i||')="'||ch1||'"'||' instr('||rzd||',substr(s4,'||i||',1))='||instr(rzd,substr(s4,i,1)), 5);
			if instr(rzd,substr(s4,i,1))>0 then
				ExNum:=greatest(i,0);
				exit;
			end if;
		end loop;
		::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'.NormalName140 -> (6)ExNum='||ExNum||' length(s4)='||length(s4),1);
		if ExNum>0 then
			s4:=substr(substr(s4,2,ExNum-1)||' '||substr(s4,ExNum+1),1,s4%size);
		end if;
	end if;

	if instr(rzd,substr(s4,1,1))>0 then
		s4:=substr(s4,2)||' ';
	end if;
	p_name:=s1||s2||s3||s4;
	p_name:=replace(p_name,'INN_','INN ');
	p_name:=replace(p_name,'KIO_','KIO ');
	p_name:=replace(p_name,'ИНН_','ИНН ');
	p_name:=replace(p_name,'КЛО_','КЛО ');
end;
function DEL_SYMBOLS_SWIFT
			( p_str		in		string(2000)
			, p_flag			string(1)
			, convert	in		boolean default false
			, p_str_len	in		integer default 35
			)
	return string(2000)
is
	ret_str string(2000);
	SYMBOLS string(200);
	p integer;
	i integer := 1;
	OneChr string(1);
	msg string(2000);

-- Допустимые символы для документов типа 'S'
SYMBOLS_S const string(200) := '0123456789 qwertyuiopQWERTYUIOPasdfghjklASDFGHJKLzxcvbnmZXCVBNMЁЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮёйцукенгшщзхъфывапролджэячсмитьбю(),.-''?:+/'||chr(13)||chr(10);
-- Допустимые символы для документов типа 'N' и без подтипа
SYMBOLS_N const string(80) := '0123456789 QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm(),.-''?:+/'||chr(13)||chr(10);

begin
	ret_str := p_str;
	if p_str is null then
		return ret_str;
	end if;

	p_str := ::[RUNTIME].[STANDARD].replace(::[RUNTIME].[STANDARD].replace(::[RUNTIME].[STANDARD].replace(p_str, '№', 'N'), '"', ''''), LF$);
	
	p := instr(p_str, CR$);
	while p > 0 loop
		if p_str_len > 0 then
			-- Вырезаем символ CR$, но при этом "добиваем" пробелами справа до длины строки в p_str_len
			p_str := rpad(substr(p_str, 1, p - 1), ceil(p / p_str_len) * p_str_len) || substr(p_str, p + 1);
		else
			p_str := substr(p_str, 1, p - 1) || substr(p_str, p + 1);	-- просто вырезаем символ CR$
		end if;
		p := instr(p_str, CR$);
	end loop;
	
	if P_FLAG = 'S' then
		SYMBOLS := SYMBOLS_S;
		p_str := translate(p_str, 'йцукенгшщзхъфывапролджэячсмитьбю', 'ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ');
	else
		SYMBOLS := SYMBOLS_N;
		-- В сбербанке транслитерируем, в комбанке просто удаляем руские буквы
		if ::[SYSTEM].[VARIABLES].IT_SBRF or convert then
			p_str := ::[RUNTIME].[STR].TRANSLETERATE(p_str);
		else
			p_str := UPPER(p_str);
		end if;
	end if;

	while i <= coalesce(length(p_str), 0) loop
		if instr(SYMBOLS, substr(p_str, i, 1)) = 0 then
			p_str := substr(p_str, 1, i - 1) || ' ' || substr(p_str, i + 1);
			::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||TB$||TB$||' 1>'||' p_str="'||p_str||'"',1);
		end if;
		i := i + 1;
	end loop;

	ret_str := p_str;
	return ret_str;
end;
EXP_RC_GET_CLSWF (
	@name('Счет')              P_ACC         in ref [AC_FIN],
	@name('Тип документа РЦ')  P_TYPE_DOC_RC in ref [TYPE_DOC_RC],
	@name('Участник расчетов') P_PART        in ref [CL_PART],
	@name('Клиент')            P_CLIENT      in ref [CLIENT],
	@name('Опция')             P_OPT         in     [STRING_1]
) return [STRING_500] is

execute is
	UT			varchar2(1);
	oClient		[CLIENT];
	oClOrg		[CL_ORG];
	rClOrg	ref	[CL_ORG];
	is_part_name boolean := false;
	city		string(500);
	addr		[PERSONAL_ADDRESS];
	country		string(2);
	country_ref	ref [COUNTRY];
	oCountry	[COUNTRY];
	inn			string(500);
	street		string(500);
	name_part	string(500);
	name_part_next	string(500);
	INN_after_address	boolean;

	vImpStr	[STRING_250];

	acc ref [AC_FIN];
	oAcc [AC_FIN];
	type_doc ref [TYPE_DOC_RC];
	oType_doc [TYPE_DOC_RC];
	name string(500);
	opt string(1);
	vReg string(2000);
	vObl string(2000);
	nJskaya number;
	vKalu string(2000);

	ShortINameF50 boolean;
	InnAfterAddress boolean;

	nSTREET_TE		number:=2; 
	nHOUSE_TE		number:=3; 
	nKORPUS_TE		number:=4; 
	nFLAT_NT		number:=5; 
	nCITY			number:=6; 
	nREGION			number:=7; 
	nCOUNTRY_ALFA2	number:=8; 
	vZip			string(2000);
	vSTREET_TE		string(2000);
	vHOUSE_TE		string(2000);
	vKORPUS_TE		string(2000);
	vFLAT_NT		string(2000);
	vCITY			string(2000);
	vREGION_AREA	string(2000);
	vCOUNTRY_ALFA2	string(2000);
	cnt_tag number;

	vREGION		string(2000);

	flStreetCity boolean := false;
	flAddInn boolean:=false;
	fl_1 boolean := true;
	fl_2 boolean := true;
	fl_3 boolean := true;
	TmpInn string(20);
	vCountry string(2000);
	s4 string(512);
	spr string(50);
	ch1 char;
	ExNum number;
	LnName number;
	vOpt string(3);
	n1 number;
	n2 number;

	rzd string(1):=',';

	chTmp char;
	ExNumTmp number;
	rzdTmp string(50):=' ,.":;<>()[]!''';
	flFirstCropTmp boolean:=true;

	CntStrNameOrg number:=0;
	tmpLen number;
	NewStrAddr boolean;
begin
	acc			:=P_ACC;
	oAcc		:=acc;
	type_doc	:=P_TYPE_DOC_RC;
	oType_doc	:=type_doc;
	opt			:=P_OPT;

	--[ПСБ]. Включить подмену адресов на английском в документах SWIFT ?
	v_ExpTransAddSwift := nvl(::[FP_TUNE].[LIB].get_bool_value('EXP_TRANSFORN_DOCS_SWIFT', null, '0'),false);
	::[PSH_EXP_TRA].[PSH_L].dbg('[ПСБ]. Включить подмену адресов на английском в документах SWIFT "'||iif(v_ExpTransAddSwift,'Да','Нет')||'"',1);
	if not v_ExpTransAddSwift then
		return null;
	end if;

	ShortINameF50 :=nvl(::[FP_TUNE].[LIB].get_bool_value('EXP_SHORT_INAME_F50', null, '0'),true);	--[ПСБ]. Использовать сокращенное наименование организации при заполнении поля 50 SWIFT-документа
	NewStrAddr    :=nvl(::[FP_TUNE].[LIB].get_bool_value('EXP_NEW_STR_ADDR', null, '0'),false);		--[ПСБ]. Адрес SWIFT в поле 50 SWIFT-документа выводить с новой строки

	if nvl(opt, '*')='F' then
		InnAfterAddress:=false;
	else
		InnAfterAddress:=true;
	end if;

	if acc is null then
		if P_CLIENT is not null then
			oClient := P_CLIENT;
			if oClient%class='CL_ORG' then
				rClOrg:=P_CLIENT;
				oClOrg:=rClOrg;
			end if;
		else
			return null;
		end if;
	else
		oClient := coalesce(oAcc.[CLIENT_R], oAcc.[CLIENT_V]);
		if oClient%id = ::[SYSTEM].[VARIABLES].OurBank then
			is_part_name :=coalesce(oClient.[SI_NAME],oClient.[I_NAME]) is not null;
		end if;
	end if;

	::[PSH_EXP_TRA].[PSH_L].dbg('>	Счет:'||oAcc.[MAIN_V_ID]||' CLIENT_R:'||oAcc.[CLIENT_R].[NAME]||' CLIENT_V:'||oAcc.[CLIENT_V].[NAME],1);
	::[PSH_EXP_TRA].[PSH_L].dbg('>	Тип документа РЦ:'||oType_doc.[CODE]||'-'||oType_doc.[NAME]||' oType_doc.[SFORM]='||oType_doc.[SFORM],1);
	::[PSH_EXP_TRA].[PSH_L].dbg('>	Клиент:'||oClient.[NAME],1);
	::[PSH_EXP_TRA].[PSH_L].dbg('>	Опция:'||opt,1);

	INN_after_address := InnAfterAddress;
	UT := nvl(substr(oType_doc.[SFORM], 4, 1), 'N');

	if oClient%id is not null then
		if not is_part_name then
			inn := trim(oClient.[INN]);
			if inn is null then
				if not oClient.[IS_RESIDENT] and oClient%class = 'CL_ORG' then
					inn := trim(oClOrg.[KIO]);
					inn := bool_char(inn is null, null, 'КИО_'||inn);
				end if;
			else
				inn := 'ИНН_'|| inn;
			end if;
		end if;
		if ShortINameF50 then
			name := coalesce(oClient.[SI_NAME],oClient.[I_NAME]);
		end if;
		if name is null then
			name := coalesce(oClient.[SI_NAME],oClient.[I_NAME]);
			if name is null then
				name := oClient.[NAME];
				if name is null then
					name := oAcc.[NAME];
				end if;
				-- Транслитерация Клиента
				::[PSH_EXP_TRA].[PSH_L].dbg('Транслитерация Клиента:'||name,1);
				name:=::[HOOK_BANK].[EXP_GET_PR_ADDR].transleterate(name);
			end if;
		end if;

		name := DEL_SYMBOLS_SWIFT(name, UT, true);
		if nvl(opt, '*')='K' then 
			name:=trim(name,rzd)||rzd; 
			::[PSH_EXP_TRA].[PSH_L].dbg('Для "К" добавим после Клиента разделитель:'||name,1);
		end if;
		::[PSH_EXP_TRA].[PSH_L].dbg('<1<name('||length(name)||'):"'||name||'"',1);

		addr := ::[DOCUMENT_INT].[PRX_CLIENT].GET_ADDRESS(oClient%id, ::[ADDRESS_TYPE]([KOD]='SWIFT_ADDRESS'));

		vImpStr := trim(addr.[IMP_STR],rzd);
		cnt_tag := length(vImpStr) - length(replace(vImpStr,rzd))+1;
		if addr.[TYPE]<>::[ADDRESS_TYPE]([KOD]='SWIFT_ADDRESS') or vImpStr is null then
			::[PSH_EXP_TRA].[PSH_L].dbg('У клиента '||oClient.[NAME]||' нет переведенного адреса SWIFT. Обрабатываем дистрибутивным алгоритмом',1);
			return null;

		elsif addr.[TYPE]=::[ADDRESS_TYPE]([KOD]='SWIFT_ADDRESS')
		and nvl(addr.[FIX_PRINT],false) and trim(addr.[IMP_STR]) is not null
		then
			::[PSH_EXP_TRA].[PSH_L].dbg('У клиента зафиксирован Адрес строкой:"'||addr.[IMP_STR]||'"',1);
			street:=upper(trim(trim(addr.[IMP_STR]),rzd));
			::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(street,rzd);
			street:=::[HOOK_BANK].[EXP_GET_PR_ADDR].transleterate(street);
			city=country:=null;
			::[PSH_EXP_TRA].[PSH_L].dbg('(1) street('||length(street)||')'||street,1);
		else
			vZip:=::[HOOK_BANK].[EXP_GET_PR_ADDR].wbn(vImpStr, rzd, 1);
			if length(STR.Get_DigitAll(vZip))=length(vZip) then
				::[PSH_EXP_TRA].[PSH_L].dbg('(0.1) Индекс есть '||vZip,1);
				nSTREET_TE		:=2;
				nHOUSE_TE		:=3;
				nKORPUS_TE		:=4;
				nFLAT_NT		:=5;
				nCITY			:=6;
				nREGION			:=7;
				nCOUNTRY_ALFA2	:=8;
			else
				vZip:=null;
				::[PSH_EXP_TRA].[PSH_L].dbg('(0.2) Индекса нет ',1);
				nSTREET_TE		:=1;
				nHOUSE_TE		:=2;
				nKORPUS_TE		:=3;
				nFLAT_NT		:=4;
				nCITY			:=5;
				nREGION			:=6;
				nCOUNTRY_ALFA2	:=7;
			end if;

			street:=IsThisCountry(vImpStr, rzd, nSTREET_TE,	cnt_tag,country);
			street:=replace(street,'TAUAR','TOWER');

			vHOUSE_TE:=IsThisCountry(vImpStr, rzd, nHOUSE_TE,	cnt_tag,country);
			if (instr(vHOUSE_TE,'FL.'  )=1 or instr(vHOUSE_TE,'FL/'  )=1
				or instr(vHOUSE_TE,'FLO.' )=1 or instr(vHOUSE_TE,'FLO/' )=1
				or instr(vHOUSE_TE,'HALL.')=1 or instr(vHOUSE_TE,'HALL/')=1
				or instr(vHOUSE_TE,'APT.' )=1 or instr(vHOUSE_TE,'APT/' )=1
				or instr(vHOUSE_TE,'FL.'  )=1 or instr(vHOUSE_TE,'FL/'  )=1
				or instr(vHOUSE_TE,'RM.'  )=1 or instr(vHOUSE_TE,'RM/'  )=1
				or instr(vHOUSE_TE,'OF.'  )=1 or instr(vHOUSE_TE,'OF/'  )=1)
			then
				::[PSH_EXP_TRA].[PSH_L].dbg('(2.1) Встретилось FL/FLO/HALL/APT/FL/RM/OF/ vKORPUS_TE и vFLAT_NT можно не искать. cnt_tag='||cnt_tag||' nCOUNTRY_ALFA2='||nCOUNTRY_ALFA2,1);
				nCITY			:= nCITY-2;
				nREGION			:= nREGION-2;
				nCOUNTRY_ALFA2	:= nCOUNTRY_ALFA2-2;
			else
				vKORPUS_TE:=IsThisCountry(vImpStr, rzd, nKORPUS_TE,	cnt_tag,country);
				::[PSH_EXP_TRA].[PSH_L].dbg('(2.2) vKORPUS_TE('||length(vKORPUS_TE)    ||')'||vKORPUS_TE,1);
				if (instr(vKORPUS_TE,'FL.'  )=1 or instr(vKORPUS_TE,'FL/'  )=1
					or instr(vKORPUS_TE,'FLO.')=1 or instr(vKORPUS_TE,'FLO/' )=1
					or instr(vKORPUS_TE,'HALL.')=1 or instr(vKORPUS_TE,'HALL/')=1
					or instr(vKORPUS_TE,'APT.')=1 or instr(vKORPUS_TE,'APT/' )=1
					or instr(vKORPUS_TE,'FL.')=1 or instr(vKORPUS_TE,'FL/'  )=1
					or instr(vKORPUS_TE,'RM.')=1 or instr(vKORPUS_TE,'RM/'  )=1
					or instr(vKORPUS_TE,'OF.')=1 or instr(vKORPUS_TE,'OF/'  )=1)
				then
					::[PSH_EXP_TRA].[PSH_L].dbg('(2.2) Встретилось FL/FLO/HALL/APT/FL/RM/OF/ vFLAT_NT можно не искать. cnt_tag='||cnt_tag||' nCOUNTRY_ALFA2='||nCOUNTRY_ALFA2,1);
					nCITY			:=nCITY-1;
					nREGION			:=nREGION-1;
					nCOUNTRY_ALFA2	:=nCOUNTRY_ALFA2-1;
				else
					vFLAT_NT := IsThisCountry(vImpStr, rzd, nFLAT_NT,	cnt_tag,country);
					::[PSH_EXP_TRA].[PSH_L].dbg('(2.3) vFLAT_NT(' || length(vFLAT_NT) || ')' || vFLAT_NT,1);
					if (instr(vFLAT_NT,'FL.')=1 or instr(vFLAT_NT,'FL/')=1
						or instr(vFLAT_NT,'FLO.') =1 or instr(vFLAT_NT,'FLO/')=1
						or instr(vFLAT_NT,'HALL.') =1 or instr(vFLAT_NT,'HALL/')=1
						or instr(vFLAT_NT,'APT.') =1 or instr(vFLAT_NT,'APT/')=1
						or instr(vFLAT_NT,'FL.') =1 or instr(vFLAT_NT,'FL/')=1
						or instr(vFLAT_NT,'RM.') =1 or instr(vFLAT_NT,'RM/')=1
						or instr(vFLAT_NT,'OF.') =1 or instr(vFLAT_NT,'OF/')=1)
					then
						null;
					end if;
				end if;
				if instr(vKORPUS_TE,'FL.')>0 and instr(vKORPUS_TE,' PREM.')>0 and instr(vKORPUS_TE,' OFF.')>0 then
					vKORPUS_TE:=replace(vKORPUS_TE,' PREM.',',PREM.');
					vKORPUS_TE:=replace(vKORPUS_TE,' OFF.' ,',OFF.');
					::[PSH_EXP_TRA].[PSH_L].dbg('(2.5) Добавили ","',1);
				elsif instr(vKORPUS_TE,'FL.')<instr(vKORPUS_TE,' OFF.') then
					vKORPUS_TE:=replace(vKORPUS_TE,' OFF.' ,',OFF.');
					::[PSH_EXP_TRA].[PSH_L].dbg('(2.6) Добавили ","',1);
				end if;
			end if;
			street:=
				iif(vZip		is null,'',vZip			||rzd)||
				iif(street		is null,'',street		||rzd)||
				iif(vHOUSE_TE	is null,'',vHOUSE_TE	||rzd)||
				iif(vKORPUS_TE	is null,'',vKORPUS_TE	||rzd)||
				iif(vFLAT_NT	is null,'',vFLAT_NT		||rzd);
			street:=replace(street,'TAUAR','TOWER');
			::[PSH_EXP_TRA].[PSH_L].dbg('(3) street('||length(street)||')'||street,1);

			vCITY			:=IsThisCountry(vImpStr, rzd, nCITY,	cnt_tag,country);
			vREGION_AREA	:=IsThisCountry(vImpStr, rzd, nREGION,	cnt_tag,country);
			::[PSH_EXP_TRA].[PSH_L].dbg('(4) vCITY ('||length(vCITY)||')'||vCITY,1);
			::[PSH_EXP_TRA].[PSH_L].dbg('(5) vREGION_AREA ('||length(vREGION_AREA)||')'||vREGION_AREA,1);

			city:=
				iif(vCITY			is null,'', vCITY			||rzd)||
				iif(vREGION_AREA	is null,'', vREGION_AREA	||rzd);
			city:=trim(city,rzd);
			::[PSH_EXP_TRA].[PSH_L].dbg('(6) city('||length(city	)||')'||city,1);
			
			if addr.[CITY] is not null then
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1) Пересчитаем vCITY='||vCITY||' и vREGION_AREA='||vREGION_AREA,1);
				::[HOOK_BANK].[EXP_GET_PR_ADDR](addr,'CITY');
				vCITY:=gTeg;
				If instr(vCITY,'CITY')=1 or instr(vCITY,' CITY')>1 then
					vCITY:=trim(replace(vCITY,'CITY'));
				end if;
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.1) vCITY ('||length(vCITY)||')'||vCITY,1);

				::[HOOK_BANK].[EXP_GET_PR_ADDR](addr,'REGION');
				vREGION_AREA:=gTeg;
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2) vREGION_AREA ('||length(vREGION_AREA)||')'||vREGION_AREA,1);

				if instr(vREGION_AREA,',')>0 then
					vREGION:=substr(vREGION_AREA,instr(vREGION_AREA,',')+1);
					::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.0)      vREGION ('||length(vREGION)||')'||vREGION,1);

					if instr(vREGION,',')>0 then
						vReg:=substr(vREGION,1,instr(vREGION,',')-1);
						vObl:=substr(vREGION,instr(vREGION,',')+1);
						nJskaya:=nvl(instr(vObl,'JSKAYA'),0);
						if nJskaya>0 then
							nJskaya:=nJskaya-1;
							for iJsk in reverse 1..nJskaya loop
								if substr(vObl,iJsk,1)=' ' then exit; end if;
								vKalu:=substr(vObl,iJsk,1)||vKalu;
							end loop;
							if length(vKalu)>0 and instr(vReg,vKalu)>0 then
								vREGION:=vReg;
							end if;
						elsif instr(vObl,'OBL ')>0 or instr(vObl,' OBL')>0 then
							vKalu:=trim(replace(replace(vObl,'OBL '),' OBL'));
							if length(vKalu)>0 and instr(vReg,vKalu)>0 then
								vREGION:=vReg;
							end if;
						end if;
					end if;

					vREGION_AREA:=substr(vREGION_AREA,1,instr(vREGION_AREA,',')-1);
					::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.1) vREGION_AREA ('||length(vREGION_AREA)||')'||vREGION_AREA,1);
				end if;

				::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(street,' ');
				::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(vREGION_AREA,' ');
				::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(vREGION,' ');
				::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(vCITY,' ');

				street :=rtrim(street,'.');
				vCITY :=rtrim(vCITY,'.');
				vREGION_AREA :=rtrim(vREGION_AREA,'.');
				vREGION :=rtrim(vREGION,'.');
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.2) street('||length(street)||')'||street||' vCITY('||length(vCITY)||')'||vCITY||' vREGION_AREA('||length(vREGION_AREA)||')'||vREGION_AREA||' vREGION('||length(vREGION)||')'||vREGION,1);

				--street(50)423601,SH-2 STR.,K.4/1,ELABUGA.ALABUGA OAZ TER.,.,
				if length(vREGION)>0 and instr(street,vREGION||'.')>0 then
					street:=replace(street,vREGION||'.');
				else
					street:=replace(street,vREGION);
				end if;
				::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(street,'.,');
				street:=trim(trim(trim(street,','),'.'),',');
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.3) street('||length(street)||')'||street,1);

				street:=replace(street,vREGION_AREA);
				::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(street,'.,');
				street:=trim(trim(trim(street,','),'.'),',');
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.4) street('||length(street)||')'||street,1);
				
				street:=replace(street,vCITY);
				::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(street,',');
				street:=trim(trim(trim(street,','),'.'),',');
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.5) street('||length(street)||')'||street,1);

				tmpLen:=nvl(length(street),0);
				loop
					street :=rtrim(street,'.');
					street :=rtrim(street,',');
					if tmpLen=nvl(length(street),0) then
						exit;
					end if;
					tmpLen:=nvl(length(street),0);
				end loop;
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6) street('||length(street)||')'||street||' vCITY='||vCITY||' vREGION_AREA='||vREGION_AREA||' vREGION='||vREGION,1);

				city:='';
				if vCITY is not null then
					city:=vCITY||rzd;
					::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6.1) city('||length(city)||')'||city||' vREGION_AREA('||length(vREGION_AREA)||')'||vREGION_AREA,1);
					if vREGION_AREA is not null and instr(city,vREGION_AREA)=0 then
						if nvl(opt, '*')='F' then
							if vREGION is not null then
								null;
							else
								city:=city||vREGION_AREA||rzd;
								::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6.2) city('||length(city)||')'||city||' vREGION_AREA('||length(vREGION_AREA)||')'||vREGION_AREA,1);
							end if;
						else
							::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6.3) street('||length(street)||')'||street||' city('||length(city)||')'||city||' vREGION_AREA('||length(vREGION_AREA)||')'||vREGION_AREA||' vREGION('||length(vREGION)||')'||vREGION,1);
							if vREGION_AREA is not null then
								if street is null then
									if instr(city,vREGION_AREA)=0 then
										street:=city||rzd||vREGION_AREA||rzd;
									else
										street:=city||rzd;
									end if;
									::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6.4) city('||length(city)||')'||city,1);
								else
									if instr(street,city)=0 then
										street:=rtrim(rtrim(street,rzd)||rzd||city||rzd,rzd);
										::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6.5) street('||length(street)||')'||street,1);
									end if;
									if instr(street,vREGION_AREA)=0 then
										street:=rtrim(rtrim(street,rzd)||rzd||vREGION_AREA||rzd,rzd);
										::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6.7) street('||length(street)||')'||street,1);
									end if;
								end if;
							end if;
						end if;
					end if;
					if vREGION is not null then
						if street is null then
							if instr(city,vREGION)=0 then
								street:=city||rzd||vREGION||rzd;
							else
								street:=city||rzd;
							end if;
							::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6.8) city('||length(city)||')'||city,1);
						else
							if instr(street,city)=0 then
								street:=rtrim(rtrim(street,rzd)||rzd||city||rzd,rzd);
								::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6.9) street('||length(street)||')'||street,1);
							end if;
							if instr(street,vREGION)=0 then
								street:=rtrim(rtrim(street,rzd)||rzd||vREGION||rzd,rzd);
								::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.6.10) street('||length(street)||')'||street,1);
							end if;
						end if;
					end if;
				else
					city := trim(vREGION_AREA||rzd||vREGION||rzd,rzd);
					::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.7.4) city('||length(city)||')'||city,1);
				end if;
				::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(city,rzd);
				
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.7.5) street('||length(street)||')'||street||' city('||length(city)||')'||city||'     vCITY='||vCITY||' vREGION_AREA='||vREGION_AREA||' vREGION='||vREGION,1);

				street:=replace(street,'MOSKVA','MOSCOW');
				street:=trim(replace(street,'MOSCOW CITY','MOSCOW'));
				street:=trim(replace(street,' CITY'));
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.7.6) street('||length(street)||')'||street,1);
				
				city:=replace(city,  'MOSKVA','MOSCOW');
				city:=trim(replace(city,'MOSCOW CITY','MOSCOW'));
				city:=trim(replace(city,' CITY'));
				::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.7.7) street('||length(street)||')'||street||' city('||length(city)||')'||city,1);
				
				n1:=nvl(instr(city,'('),0);
				n2:=nvl(instr(city,')'),0);
				if n1>0 and n1<n2 then
					street:=trim(street)||substr(city,n1,n2-n1+1);
					city:=substr(city,1,n1-1)||substr(city,n2+1);
					::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(city,' ');
					::[PSH_EXP_TRA].[PSH_L].dbg('(6.1.2.7.8) street('||length(street)||')'||street||' city('||length(city)||')'||city,1);
				end if;
			end if;

			::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(7.0)street('||length(street)||')"'||street||'" city('||length(city)||')"'||city||'"',1);
			if street is not null and city is not null and instr(street,city)>0 then
				city:=null;
				::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(7.1)street('||length(street)||')"'||street||'" city('||length(city)||')"'||city||'"',1);
			end if;

			vCountry := substr(vImpStr, -3);
			if substr(vCountry,1)=rzd then 
				vCountry:=substr(vCountry,2);
				for cntry
				in ::[COUNTRY]
				where cntry.[ALFA_2]=vCountry
				loop
					Country:=vCountry;
					exit;
				end loop;
			end if;
			if country is null then
				country = vCOUNTRY_ALFA2 := trim(::[HOOK_BANK].[EXP_GET_PR_ADDR].wbn(vImpStr, rzd, cnt_tag));
				::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(7.2)country('||length(country)||')'||country,1);
			end if;

			street := trim(street, rzd);
			city := trim(city, rzd);
			country := trim(country, rzd);

			::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(street,' ');
			::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(city,' ');
			::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(country,' ');

			::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(street,rzd);
			::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(city,rzd);
			::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(country,rzd);

			street  := replace(street ,' .','.');
			city    := replace(city   ,' .','.');
			country := replace(country,' .','.');

			street  := replace(street ,' ,',',');
			city    := replace(city   ,' ,',',');
			country := replace(country,' ,',',');

			street  := DEL_SYMBOLS_SWIFT(trim(street), UT, true);
			city    := DEL_SYMBOLS_SWIFT(trim(city), UT, true);
			country := DEL_SYMBOLS_SWIFT(trim(country), UT, true);
		end if;

		::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(7.3)street('||length(street)||')"'||street||'" city('||length(city)||')"'||city||'"'||' country('||length(country)||')"'||country||'"',1);

		if city is not null and instr(street,city)=0 then
			street := street||rzd||city;
			city:=null;
			::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(7.4)street('||length(street)||')"'||street||'" city('||length(city)||')"'||city||'"'||' country('||length(country)||')"'||country||'"',1);
		end if;
		
		if not (nvl(addr.[FIX_PRINT],false) and trim(addr.[IMP_STR]) is not null) then
			if not nvl(opt, '*') in ('F','K') then
				country_ref :=::[PERSONAL_ADDRESS].[LIB].get_country(nvl(addr.[CITY]%id, addr.[STREET_REF]%id));
				oCountry:=country_ref;
				if length(city) < 35 then
					street := DEL_SYMBOLS_SWIFT(rpad(city, 35) || ' ' || nvl(oCountry.[ALFA_2], oCountry.[VALUE]), UT, true);
				else
					street := DEL_SYMBOLS_SWIFT(city || ' ' || nvl(oCountry.[ALFA_2], oCountry.[VALUE]), UT, true);
				end if;
			end if;
		end if;
		::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(7.5)street('||length(street)||')"'||street||'" city('||length(city)||')"'||city||'"'||' country('||length(country)||')"'||country||'"',1);
	end if;
	
	street:=replace(street,'MOSKVA','MOSCOW');
	street:=replace(street,'MOSCOW REG','MOSCOW');
	street:=replace(street,'MOSCOW CITY','MOSCOW');
	street:=replace(street,'MOSCOW,MOSCOW','MOSCOW');
	street:=replace(street,'CITY');
	::[HOOK_BANK].[EXP_GET_PR_ADDR].DelDublSpace(street,' ');
	::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(7.6)street('||length(street)||')"'||street||'" city('||length(city)||')"'||city||'"'||' country('||length(country)||')"'||country||'"',1);

	if INN_after_address and inn is not null then
		::[PSH_EXP_TRA].[PSH_L].dbg('(1.0)INN_after_address='||INN_after_address||' inn='||inn,1);
		tmpInn:=inn;
		inn:=null;
		flAddInn:=true;
	end if;

	::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8)opt('||length(opt)||')'||opt,1);
	if nvl(opt, '*') in ('F','K') then
		if nvl(opt, '*') = 'F' then	
			name:='1/'||name; 
			fl_1:=false; 
			if inn is not null then
				::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.1) Пробуем впихнуть наименование и ИНН в 1-ю строку ('||length(name||' '||inn)||') "'||name||' '||inn||'"',1);
				if length(name||' '||inn)<=140 then
					name:=name||' '||inn;
					inn:=null;
					flAddInn:=false;
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.1) ИНН вошло в наименование клиента',1);
				else
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.2) ИНН не вошло',1);
				end if;
			end if;
			::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.3)name('||length(name)||')"'||name||'" name_part('||length(name_part)||')"'||name_part||'"',1);
			if length(name) > 35 then --Передано слишком длинное наименование организации для F
				CntStrNameOrg:=CntStrNameOrg + 1;
				::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.5)Для F слишком длинное наименование организации, подготовим для обработки только первые 35 символов (с учетом разделителя)',1);
				for i in reverse 1..length(name) loop
					chTmp:=substr(name,i,1);
					if i<=35 and instr(rzdTmp,substr(name,i,1))>0 then
						ExNumTmp:=greatest(i-1,0); 
						::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'chTmp="'||chTmp||'"'||' instr('||rzdTmp||',substr(name,'||i||',1))='||instr(rzdTmp,substr(name,i,1))||' ExNumTmp='||ExNumTmp, 4);
						exit; 
					end if; 
				end loop;
				if nvl(ExNumTmp,0)=0 then
					ExNumTmp:=35;
				end if;
				::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'ExNumTmp='||ExNumTmp, 4);
				name_part := trim(substr(name,ExNumTmp+1));
				name := trim(substr(name,1,ExNumTmp));

				::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.6)name('||length(name)||')"'||name||'" name_part('||length(name_part)||')"'||name_part||'"',1);
				AddPart(name,name_part,Opt,flFirstCropTmp); flFirstCropTmp:=false;
				::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.6.1)name('||length(name)||')"'||name||'" name_part('||length(name_part)||')"'||name_part||'"',1);

				if length(name_part)>35 then
					CntStrNameOrg:=CntStrNameOrg+1;
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.8)Для F все еще слишком длинное наименование, еще часть приклеим к "1/"',1);
					ExNumTmp:=null;
					for i in reverse 1..length(name_part) loop
						chTmp:=substr(name_part,i,1);
						if i<=35 and instr(rzdTmp,substr(name_part,i,1))>0 then
							ExNumTmp:=greatest(i-1,0); 
							::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'chTmp="'||chTmp||'"'||' instr('||rzdTmp||',substr(name_part,'||i||',1))='||instr(rzdTmp,substr(name_part,i,1))||' ExNumTmp='||ExNumTmp, 4);
							exit; 
						end if; 
					end loop;
					if nvl(ExNumTmp,0)=0 then
						ExNumTmp:=35;
					end if;
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'ExNumTmp='||ExNumTmp, 4);
					name_part_next:= trim(substr(name_part,ExNumTmp+1));
					name_part :=trim(substr(name_part,1,ExNumTmp));
					AddPart(name_part,name_part_next,Opt,flFirstCropTmp); flFirstCropTmp:=false;
					name:=name||name_part;
					name_part:=trim(name_part_next);
					name_part_next:=null;
					if name_part is not null then
						name_part:=iif(substr(name_part,1,2)='1/','','1/')||name_part;
					end if;
				end if;
				if length(name_part)>35 then
					CntStrNameOrg:=CntStrNameOrg+1;
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.11)Для F все еще слишком длинное наименование, еще часть приклеим к "1/"',1);
					ExNumTmp:=null;
					for i in reverse 1..length(name_part) loop
						chTmp:=substr(name_part,i,1);
						if i<=35 and instr(rzdTmp,substr(name_part,i,1))>0 then
							ExNumTmp:=greatest(i-1,0); 
							::[PSH_EXP_TRA].[PSH_L].dbg(TB$||TB$||'chTmp="'||chTmp||'"'||' instr('||rzdTmp||',substr(name_part,'||i||',1))='||instr(rzdTmp,substr(name_part,i,1))||' ExNumTmp='||ExNumTmp, 4);
							exit; 
						end if; 
					end loop;
					if nvl(ExNumTmp,0)=0 then
						ExNumTmp:=35;
					end if;
					name_part_next :=trim(substr(name_part,ExNumTmp+1));
					name_part :=trim(substr(name_part,1,ExNumTmp));
					AddPart(name_part,name_part_next,Opt,flFirstCropTmp); flFirstCropTmp:=false;
					name:=name||name_part;
					name_part:=trim(name_part_next);
					name_part_next:=null;
					if name_part is not null then
						name_part:=iif(substr(name_part,1,2)='1/','','1/')||name_part;
					end if;
				end if;
				if length(name_part)>0 then
					CntStrNameOrg:=CntStrNameOrg+1;
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(8.13)Для F все еще есть что приклеить к "1/"',1);
					name:=name||name_part;
					name_part:=null;
					
					if length(name)>140 then
						if length(inn)>0 and instr(name,inn)>0 then
							name:=replace(name,inn);
							name:=substr(name,1,140-length(inn))||inn;
						end if;
					end if;
					if CntStrNameOrg>=4 then
						NormalName140(name);
						return name;
					end if;
				end if;
			end if;
			::[PSH_EXP_TRA].[PSH_L].dbg('<2<name('||length(name)||'):"'||name||'"',1);
		else
			if length(name) <= 35 then
				CntStrNameOrg:=1;
			elsif length(name) <= 70 then
				CntStrNameOrg:=2;
			else
				CntStrNameOrg:=3;
			end if;
		end if;

		CropLastChrWord(name,name_part,flFirstCropTmp);
		flFirstCropTmp:=false;
		::[PSH_EXP_TRA].[PSH_L].dbg('<3<name('||length(name)||'):"'||name||'" CntStrNameOrg='||CntStrNameOrg,1);

		for i in 1..4 loop
			if name_part is null then
				name_part_next:=null;
				if not flAddInn then
					if inn is not null then
						flAddInn:=true;
						if nvl(opt, '*') = 'F' then
							name_part:=iif(substr(name_part,1,2)='1/','','1/')||name_part;
						end if;
						name_part_next:=' '||inn||iif(INN_after_address or inn is null or nvl(opt, '*')='F','',', ');
						AddPart(name_part,name_part_next,Opt);
					end if;
				end if;
				CropLastChrWord(name_part,name_part_next);
				name:=name||name_part;
				name_part:=name_part_next;
				name_part_next:=null;
				::[PSH_EXP_TRA].[PSH_L].dbg('<3.1<name('||length(name)||'):"'||name||'"',1);
				if flStreetCity then
					exit;
				end if;
			elsif inn is not null and (nvl(length(name_part), 0) <= (35-nvl(length(inn), 0))) then
				if not flAddInn then
					flAddInn:=true;
					if nvl(opt, '*') = 'F' then
						name_part:=iif(substr(name_part,1,2)='1/','','1/')||name_part;
					end if;
					name_part_next:=' '||inn||iif(INN_after_address or inn is null or nvl(opt, '*')='F','',', ');
					AddPart(name_part,name_part_next,opt);
				end if;
				CropLastChrWord(name_part,name_part_next);
				name:=name||name_part;
				name_part:=name_part_next;
				name_part_next:=null;
				::[PSH_EXP_TRA].[PSH_L].dbg('<3.2<name('||length(name)||'):"'||name||'"',1);

				if flAddInn and name_part is null and nvl(opt, '*')<>'F' then
					name:=trim(name);
				end if;
				
				if flStreetCity then
					exit;
				end if;

			elsif inn is not null and (nvl(length(name_part), 0) > (35-nvl(length(inn), 0))) then
				if nvl(opt, '*') = 'F' then
					name_part:=iif(substr(name_part,1,2)='1/','','1/')||name_part;
				end if;

				if instr(replace(name_part,' '),replace(inn,' '))=0 and not flAddInn then
					flAddInn:=true;
					name_part_next:=' '||inn||iif(INN_after_address or inn is null or nvl(opt, '*')='F','',', ');
					AddPart(name_part,name_part_next,opt);
				end if;
				CropLastChrWord(name_part,name_part_next);
				name:=name||name_part;
				name_part:=name_part_next;
				name_part_next:=null;
				::[PSH_EXP_TRA].[PSH_L].dbg('<3.3<name('||length(name)||'):"'||name||'"',1);

				if flAddInn and name_part is null and nvl(opt, '*')<>'F' then
					name:=trim(name);
				end if;
				
				if flStreetCity then
					exit;
				end if;
			else
				if nvl(opt, '*') = 'F' then
					name_part:=iif(substr(name_part,1,2)='1/','','1/')||name_part;
				end if;
				CropLastChrWord(name_part,name_part_next);
				name:=name||name_part;
				name_part:=name_part_next;
				name_part_next:=null;
				::[PSH_EXP_TRA].[PSH_L].dbg('<3.4<name('||length(name)||'):"'||name||'"',1);

			end if;
			if name_part is null and not flStreetCity then
				flStreetCity:=true;
				if (nvl(addr.[FIX_PRINT],false) and trim(addr.[IMP_STR]) is not null) then
					country_ref :=::[PERSONAL_ADDRESS].[LIB].get_country(nvl(addr.[CITY]%id, addr.[STREET_REF]%id));
					oCountry := country_ref;
					country := nvl(oCountry.[ALFA_2],country);
				end if;

				if street is not null and length(name)<=105 then -- если есть адрес, то обязательно должна быть доп.информация после кода страны
					if nvl(opt, '*') = 'F' then
						AddRpadName(name);
						name_part_next:='2/'||street; fl_1=fl_2:=false;
					else
						AddRpadName(name);
						name_part_next:=iif(name is null,'',' ')||street;
					end if;

					for j in 1..4 loop
						if nvl(opt, '*')<>'F' and flAddInn and name_part_next is not null and substr(name,1,2) not in ('1/','2/','3/') then
							if j>CntStrNameOrg or not NewStrAddr then
								name:=trim(name);
							end if;
						end if;

						CropLastChrWord(name_part,name_part_next);
						AddPart(name,name_part,Opt);

						name:=name||name_part;
						name_part:=iif(nvl(opt, '*') = 'F' and name_part_next is not null,'2/'||name_part_next,name_part_next);
						name_part_next:=null;
						::[PSH_EXP_TRA].[PSH_L].dbg('<3.5.'||i||'<name('||length(name)||'):"'||name||'"',1);

						if name_part is null then 
							exit;
						end if;
					end loop;
				end if;
				if city is not null then
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(10.'||i||')name('||length(name)||')"'||name||'"   fl_1='||fl_1||' fl_2='||fl_2||' fl_3='||fl_3||'    city('||length(city)||')='||city,1);
					if nvl(opt, '*') = 'F' then
						AddRpadName(name);
						name_part:='3/'||iif(country is null,'',country||'/')||city;
						fl_1=fl_2=fl_3:=false;
						if nvl(opt, '*') = 'F' then
							if country is not null and substr(name,106,2) in ('1/','2/') then
								::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(10.'||i||')name('||length(name)||')"'||name||'" Добавми страну/город за счет "'||substr(name,106)||'"',1);
								name:=substr(name,1,105);
								::[PSH_EXP_TRA].[PSH_L].dbg('<3.6<name('||length(name)||'):"'||name||'"',1);
							end if;
						end if;
					else
						name:=rtrim(rtrim(rtrim(name,rzd)),rzd);
						name_part:=trim(iif(name is null,'',rzd)||city||iif(substr(city,length(city))=rzd,'',rzd)||country,rzd);
						::[PSH_EXP_TRA].[PSH_L].dbg('<3.7<name('||length(name)||'):"'||name||'"',1);
					end if;
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(10.'||i||'.1)name('||length(name)||')"'||name||'"name_part('||length(name_part)||')"'||name_part||'"',1);

					CropLastChrWord(name_part,name_part_next);
					CropLastChrWord(name,name_part);
					name:=name||name_part;
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(10.'||i||'.2)name('||length(name)||')"'||name||'"name_part('||length(name_part)||')"'||name_part||'"',1);

					AddRpadName(name);
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(10.'||i||'.3)name('||length(name)||')"'||name||'"',1);

					name_part:=iif(nvl(opt, '*') = 'F' and name_part_next is not null,'3/'||name_part_next,name_part_next);
					name_part_next:=null;
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(10.'||i||'.4)name_part('||length(name_part)||')"'||name_part||'"name_part_next('||length(name_part_next)||')"'||name_part_next||'"',1);

					for j in 1..4 loop
						if name_part is null or not (nvl(opt, '*') = 'F' and fl_3)	then 
							exit;
						end if;
						::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(10.'||i||'.5.'||j||')name_part('||length(name_part)||')"'||name_part||'"name_part_next('||length(name_part_next)||')"'||name_part_next||'"',1);
						CropLastChrWord(name_part,name_part_next);
						name:=name||name_part;
						::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(10.'||i||'.6.'||j||')name('||length(name)||')"'||name||'"name_part('||length(name_part)||')"'||name_part||'"',1);

						AddRpadName(name);
						name_part:=iif(nvl(opt, '*') = 'F' and name_part_next is not null,'3/'||name_part_next,name_part_next);
						name_part_next:=null;
						::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(10.'||i||'.7.'||j||')name('||length(name)||')"'||name||'"name_part('||length(name_part)||')"'||name_part||'"',1);
					end loop;
				else
					if nvl(opt, '*') = 'F' then
						if name_part is null then
							name:=trim(name,rzd);
							::[PSH_EXP_TRA].[PSH_L].dbg('<3.7<name('||length(name)||'):"'||name||'"',1);
						end if;
						AddRpadName(name);
						::[PSH_EXP_TRA].[PSH_L].dbg('<3.8<name('||length(name)||'):"'||name||'"',1);
						if country is not null then
							name_part:=rtrim(name_part,rzd)||'3/'||country;
							fl_1=fl_2=fl_3:=false;
						end if;
						
						if country is not null and substr(name,106,2) in ('1/','2/') then
							::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(11.'||i||')name('||length(name)||')"'||name||'" Добавми страну за счет "'||substr(name,106)||'"',1);
							name:=substr(name,1,105);
							::[PSH_EXP_TRA].[PSH_L].dbg('<3.9<name('||length(name)||'):"'||name||'"',1);
						end if;
					else
						if not (nvl(addr.[FIX_PRINT],false) and trim(addr.[IMP_STR]) is not null) then
							country:=trim(country,rzd);
							if country is not null then
								name_part:=name_part||rzd||country;
							end if;
						end if;
					end if;
				end if;

				::[PSH_EXP_TRA].[PSH_L].dbg('<4.1<name('||length(name)||'):"'||name||'"',1);
				CropLastChrWord(name,name_part);
				::[PSH_EXP_TRA].[PSH_L].dbg('<4.2<name('||length(name)||'):"'||name||'"',1);

				CropLastChrWord(name_part,name_part_next);
				name := name||name_part;
				name_part := name_part_next;
				name_part_next := null;
			end if;
			::[PSH_EXP_TRA].[PSH_L].dbg('<4.3<name('||length(name)||'):"'||name||'"',1);

		end loop;
		::[PSH_EXP_TRA].[PSH_L].dbg('<5<name('||length(name)||'):"'||name||'"',1);
		if INN_after_address and tmpInn is not null and nvl(instr(name,tmpInn),0)=0 then
			inn:=tmpInn;
			name:=replace(name,inn);
			AddRpadName(name);
			if length(name)>105 then
				name:=rtrim(name);

				var LenInn number;
				inn:=trim(inn);
				if length(inn)>0 then
					inn:=' '||inn;
				end if;
				LenInn:=length(inn);
				if length(name)+LenInn<=140 then
					name:=name||inn;
					::[PSH_EXP_TRA].[PSH_L].dbg(TB$||'(15.3)name('||length(name)||')"'||name,1);
				else
					s4 :=Rtrim(substr(name,106));
					ExNum:=length(s4);
					spr :=' ,.":;<>()[]!''';
					for i in reverse 1..35 loop
						ch1:=substr(s4,i,1);
						if instr(spr,substr(s4,i,1))>0 then
							ExNum:=greatest(i,0);
							if ExNum+LenInn<=35 then
								exit; 
							end if;
						end if;
					end loop;
					if ExNum>0 then
						if instr(spr,substr(s4,1,1))>0 then
							s4:=substr(s4,2,ExNum-1);
						else
							s4:=substr(s4,1,ExNum-1);
						end if;
						s4:=ltrim(s4,',');
						if instr(spr,substr(s4,length(s4)))>0
							and country is not null
							and substr(s4,length(s4)-2)<>country
							and length(s4)+3+LenInn<=35
						then
							name:=substr(name,1,105)||s4||country||',';
						elsif substr(s4,length(s4))<>','
							and country is not null 
							and substr(s4,length(s4)-2)<>country 
							and length(s4)+4+LenInn<=35 
						then
							name:=substr(name,1,105)||s4||','||country||',';
						else
							name:=substr(name,1,105)||s4;
						end if;
					end if;
					name:=name||inn;
				end if;
			else
				name:=name||inn;
			end if;
		end if;
		::[PSH_EXP_TRA].[PSH_L].dbg('<6<name('||length(name)||'):"'||name||'"',1);
	elsif nvl(opt, '*') = 'A' then
		name := null;
	else
		::[PSH_EXP_TRA].[PSH_L].dbg('<name:"'||name||'"',1);
		if INN_after_address then
			if length(name)<=70 then
				name := rpad( name, 35*(trunc(length(name)/35)+ bool_char(mod(length(name),35) = 0, 0, 1)) );
			else
				name := substr(name, 1, 70); -- на наименование отводим только 2 строки
			end if;
			city := DEL_SYMBOLS_SWIFT(trim(city), UT, true);

			name := name || bool_char(is_part_name, null, bool_char(city is null, null, city)); -- добавляем адрес
			::[PSH_EXP_TRA].[PSH_L].dbg('<7<name('||length(name)||'):"'||name||'"',1);
			if length(name)<=105 then
				name := rpad( name, 35*(trunc(length(name)/35)+ bool_char(mod(length(name),35) = 0, 0, 1)) ); -- выровняли строку (до 35-символов)
				name := name || rpad(inn ,35); -- добавили ИНН
				::[PSH_EXP_TRA].[PSH_L].dbg('<8<name('||length(name)||'):"'||name||'"',1);
			else
				-- урежем адрес (чтобы дописать ИНН)
				name := substr(name, 1, 140-length(inn)-1) || ',' ||inn;
				::[PSH_EXP_TRA].[PSH_L].dbg('<9<name('||length(name)||'):"'||name||'"',1);
			end if;
			::[PSH_EXP_TRA].[PSH_L].dbg('<10<name('||length(name)||'):"'||name||'"',1);
		else
			-- Если наименование клиента помещается в 2 строки, то ИНН пишем на новой строке,
			-- в противном случае дописываем на одной строке с наименованием
			if length(name)<=70 then
				name := rpad( name, 35*(trunc(length(name)/35) + bool_char(mod(length(name),35) = 0, 0, 1)));
				name := name || rpad(inn ,35);
			else
				name := name || inn;
			end if;
			-- Если наименование клиента вместе с ИНН помещается в 3 строки, то название города пишем на новой строке,
			-- в противном случае дописываем на одной строке с наименованием
			::[PSH_EXP_TRA].[PSH_L].dbg('<11<name('||length(name)||'):"'||name||'"',1);
			if length(name)<=105 then
				name := rpad( name, 35*(trunc(length(name)/35) + bool_char(mod(length(name),35) = 0, 0, 1)));
				name := name || bool_char(is_part_name, null, bool_char(city is null, null, city));
			else
				name := name || bool_char(is_part_name, null, bool_char(city is null, null, ', '||city));
			end if;
			::[PSH_EXP_TRA].[PSH_L].dbg('<12<name('||length(name)||'):"'||name||'"',1);
		end if;
	end if;

	::[PSH_EXP_TRA].[PSH_L].dbg('<13<name('||length(name)||'):"'||name||'"',1);
	NormalName140(name);
	::[PSH_EXP_TRA].[PSH_L].dbg('<14<name('||length(name)||'):"'||name||'"',1);
	if name is not null and country is not null and inn is null then
		name:=trim(name);
		if length(country)+1<140-length(trim(trim(name,','),'.')) and 
			not (instr(name,','||country,-1)=length(name)-2
			or instr(name,'.'||country,-1)=length(name)-2
			or instr(name,' '||country,-1)=length(name)-2)
		then
			name:=rtrim(name,',');
			name:=rtrim(name,'.');
			name:=name||','||country;
			::[PSH_EXP_TRA].[PSH_L].dbg('Добавлено "'||','||country||'"',1);
		end if;
	end if;
	::[PSH_EXP_TRA].[PSH_L].dbg('<15<name('||length(name)||'):"'||name||'"',1);
	return name;
end;
end;
end;
