public function get_bank(bank_ref ref [CL_BANK]) return [BC_BANK_REQS] is 
                addr_struct [BC_PAY_ADDRESS];
                bank_reqs [BC_BANK_REQS];
begin
                bank_reqs.[BANK_OPT] := NULL;
                if bank_ref%class = 'CL_BANK_N' then -- национальный банк
                               select x(x.[NAME], x.[BIC], x.[BIC], x.[KS]) in ::[CL_BANK_N] where x%id = bank_ref%id into
                                               bank_reqs.[BANK_NAME],
                                               bank_reqs.[BANK_BIC],
                                               bank_reqs.[PSH_BANK_CODE], -- updated CHANGE_QUALIFIER BANK_CODE->PSH_BANK_CODE 13/10/25
                                               bank_reqs.[BANK_KS];
                               addr_struct.[CITY_STR] := [VIEWFUN].[GetAddress](bank_ref, 'CITY', NULL);
                               addr_struct.[ADDR_STR] := [VIEWFUN].[GetAddress](bank_ref,'DISTRICT, STREET, HOUSE, KORPUS', null);
                else
                               select x(x.[I_NAME], x.[SWIFT_C], x.[SWIFT_C]) in ::[CL_BANK_F] where x%id = bank_ref%id into
                                               bank_reqs.[BANK_NAME],
                                               bank_reqs.[BANK_SWIFT_CODE],
                                               bank_reqs.[PSH_BANK_CODE]; -- updated CHANGE_QUALIFIER BANK_CODE->PSH_BANK_CODE 13/10/25
                               bank_reqs.[BANK_KS] := NULL;
                end if;

                addr_struct.[COUNTRY_CODE] := bank_ref.[COUNTRY].[CODE];
                addr_struct.[COUNTRY_NAME] := bank_ref.[COUNTRY].[INAME];

                bank_reqs.[ADDRESS] := addr_struct;
                return bank_reqs;
                exception when NO_DATA_FOUND then
                               null;
end;


-- Получить вид пересылки
public function get_send_type(p_send_type Varchar2) return [VID_SEND_DOCUM]::[COD]%type is 
v_result	[VID_SEND_DOCUM]::[COD]%type;
v_ref		[VID_SEND_DOCUM];
begin
	begin
		locate v_ref in ::[VID_SEND_DOCUM] all where Upper(v_ref->[VID_SEND]) = Upper(p_send_type);
		v_result := v_ref.[COD];
	exception
		when NO_DATA_FOUND then
			v_result := Null;
	end;
	return v_result;
end;

-- Последний Курс банка за день. BUY - покупка банком, SELE - продажа банком
public function kurs_bank (cod_val varchar2(3), data_val date, tip varchar2(4)) return number is 
kursi ref [PRICE_LIST];
kurs number;
begin
kursi := ::[PRICE_LIST](CODE='PSH_DBO');
for kotir in kursi.[ARR_RATES]
	where 	trunc(kotir.[TER_DATE])=trunc(data_val)
			and	upper(kotir.[CURRENCY_2].[CUR_SHORT])=upper(cod_val)
			and upper(kotir.[CURRENCY_1].[CUR_SHORT])='RUB'
			and upper(kotir.[KOD_OPER].[CODE])=upper(tip)
			and kotir.[DATE_DEL] is null
	order by kotir.[TER_DATE]
loop
kurs:=kotir.[RATE];
end loop;	
return (kurs);	
end;
end;
