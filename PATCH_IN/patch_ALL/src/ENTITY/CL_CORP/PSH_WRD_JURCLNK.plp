/*************************************************************************
 возвращает строку, содержащую все действующие контакты типа contact_type
 и принадлежности (рабочий, домашний, мобильный, null)
**************************************************************************/
function GetContacts(cont_arr [CONTACTS_ARR], contact_type string) return varchar2 is
str [MEMO_32767];
begin
	str := '';
	if contact_type is not null  then
	-- optimaze
		for
		(
			select res
			(
				res.[PRIVATE].[VALUE]: 	c_priv,
				res.[TYPE].[VALUE]:		c_val,
				res.[NUMB]:				c_numb
			)
			in cont_arr
			where	res.[ACTIV]=true and
					res.[NUMB] is not null and
					res.[TYPE].[CODE] = contact_type and
					(res.[PRIVATE].[CODE] in ('1', '2', '3') or res.[PRIVATE] is null)
			order by res.[PRIVATE].[CODE]
		)	
		loop
		  str := str||LTRIM(res.c_priv||' '||res.c_val||' '||res.c_numb||CHR(13));
		end loop;
	else
		return '';
	end if;
	return str;
end;


/**********************************************************
Функция возвращает адрес строкой
**********************************************************/
Function GetAddress(	cl_adresses		[CLIENT].[ADDRESSES]%type
						,AddRecv 		varchar2(100) default null
						,AddrCode 		varchar2(20) default null
			)return varchar2(1000)
is
addr			varchar2(1000);
addr_ref		ref [PERSONAL_ADDRESS];
begin
	AddrCode := upper(AddrCode);
	begin
		select a(a)
			in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all : t ) all
			where	a%collection = cl_adresses
					and t = a.[TYPE]
					and t.[KOD] = AddrCode
					and rownum <= 1
			into addr_ref;
	exception
		when NO_DATA_FOUND then
			if AddrCode is null then   -- ищем любой адрес
				begin
					select a(a)
						in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all: t) all
						where	a%collection = cl_adresses
								and t = a.[TYPE]
								and rownum <= 1
						into addr_ref;
				exception when NO_DATA_FOUND then
					null;
				end;
			end if;
	end;
	addr := VIEWFUN.GetAddressByRef(	a		== addr_ref,
										AddRecv	== AddRecv
										--,p_struct == 2
										);
	return addr;
end;

/*************************************************************
 Функция возвращает всех учредителей организации через запятую
**************************************************************/
procedure Get_FOUNDERS(p_cl [CL_CORP], p_used_length in integer, p_founders out [MEMO_32767], p_err out boolean, p_founder_counter out integer, p_date in date default ::[SYSTEM].[VARIABLES].OpDate) is
	available_length integer := 32500 - p_used_length;
	adding_str [MEMO_32767];
begin
	p_founder_counter := 0;
	for	(
		select	fonder(fonder.[FOUNDER].[NAME] : f_name, fonder.[FOUNDER].[ADDRESSES]:f_adr,fonder.[FOUNDER].[INN]:f_INN)
		in		p_cl.[REGISTER].[FOUNDERS]
		where	(fonder.[DATE_BEG] <= p_date or fonder.[DATE_BEG] is null) and
				(fonder.[DATE_END] >= p_date or fonder.[DATE_END] is null))
	loop
		p_founder_counter := p_founder_counter + 1;
        adding_str := to_char(p_founder_counter)||'. '||fonder.f_name||', '||' Адрес: '||GetAddress(fonder.f_adr,'ALL','REGISTRATION')||' ИНН'||chr(13);
		
		if length(adding_str) > available_length then
			p_founders := substr(rtrim(p_founders),1,length(p_founders)-2);
			p_founder_counter := p_founder_counter-1;
			p_err := true;
			return;
		else
			available_length := available_length - length(adding_str);
		end if;
		p_founders := p_founders || adding_str;
	end loop;
	
	p_founders := substr(rtrim(p_founders),1,length(p_founders)-2);
end;

/********************************************************
 Возвращает всех должностных лиц из массива ALL_BOSS
 (ФИО, должность, паспортные данные, дата рождения, адрес)
*********************************************************/
procedure get_all_boss(p_cl in [CL_CORP], p_used_length in integer, p_bosses out [MEMO_32767], p_err out boolean, p_boss_counter out integer) is
	available_length integer := 32500 - p_used_length;
	adding_str [MEMO_32767];
begin
	p_err := false;
	p_bosses := '';
	p_boss_counter := 0;
	for
	(
		select dolg
		(
			dolg.[RANGE].[VALUE]: 	d_range,
			dolg.[FASE].[NAME]:		d_name
		)
	in p_cl.[ALL_BOSS]	
	where dolg.[FASE] is not null and
		  nvl(dolg.[WORK_BEGIN],op_dat) <= op_dat and
		  nvl(dolg.[WORK_END],op_dat) >= op_dat
	)
	loop
		adding_str := rtrim(dolg.d_range || ' ' || dolg.d_name) || chr(13);
		if length(adding_str)>available_length then
			p_err := true;
			return;
		else
			p_bosses := p_bosses || adding_str;
			available_length := available_length - length(adding_str);
			p_boss_counter := p_boss_counter+1;
		end if;
	end loop;
end;

