class TMC_DOCUM;

@optimize(false)
@this(create_on_start:=true)
@name('[ПСБ] Обработать')
@tag('COPIED')
batch method PSH_WORK_DOC_SPI uses WORK_DOCUM_SPIS is

@name('Признак определения курса')         public V_SIGN_COURSE                 [BOOLEAN];
@name('Код материальной операции')         public V#CODE_OPER                   [STRING_16];
@name('Признак наличия ссылки на Договор') public P_IS_TRUST_DOCUM_REF          [BOOLEAN];
@name('Номер счета-фактуры')               public V_NUM_FACT                    [STRING_35];
@name('Дата оплаты')                       public V_DATE_PAY                    [DATE];
@name('Дата принятия на учет')             public V_DATE_USAGE                  [DATE];
@name('Тип счета-фактуры')                 public V_TYPE                        [ONE_FROM_THREE];
@name('Дата создания счета-фактуры')       public V_DATE_FACTURA                [DATE];
@name('Порождать первичный счет-фактуру')  public V_SIGN_SF_INITION             [BOOLEAN];
@name('Порождать вторичный счет-фактуру')  public V_SIGN_SF_INVOICE             [BOOLEAN];
@name('Обработка одного документа')        public V_WORK_ONE                    [BOOLEAN];
@name('Признак наличия хоз.договора')      public V_SIGN_HOZ_DOG                [BOOLEAN];
@name('Признак создания СФ на покупку')    public V_SIGN_SF_BUY                 [BOOLEAN];
@name('Тип счета-фактуры')                 public V_CHOOSE                      [CASE_BETWEEN_TWO];
@name('Переменная валидатора')             public V_EXEC                        [STRING_32000];
@name('Список электронных СФ')             public V_ARR                table of [TEMP_TABLE_S];

use_sed boolean := false;
idx	integer;
factura_temp ref [FACTURA_DOC];
tune_common_folder_for_docs	boolean	:= ::[TMC_IMPORT].[TUNE_PRODUCT].get_common_folder_for_docs;
spisCreateSF	boolean;	-- если требуется создать СФ при списке документов
idxValidate	integer;	-- на этом экземпляре запускаем валидатор с p_message = VALIDATE

procedure check_controls(
	checked boolean
) is
begin
	if nvl(checked, false) then
		[CSMD].Command(V_EXEC, 'TYPE_SF.Visible = True');
	else
		[CSMD].Command(V_EXEC, 'TYPE_SF.Visible = False');
	end if;
end;

function CalcSumDoc(td ref [TMC_DOCUM]) return [SUMMA] is
ExSumma [SUMMA]:=0;
mdoc ref [MAIN_DOCUM];
begin
	for dif in td.[IN_FOLDER].[DOCS_IN_FOLD] where dif.[DOCUMENT]%class='MAIN_DOCUM' loop
		mdoc:=dif.[DOCUMENT]%id;
		ExSumma:=ExSumma+mdoc.[SUM];
	end loop;
	return ExSumma;
end;
PSH_WORK_DOC_SPI (
	@name('Дата обработки документа')         P_DATE                 in [DATE],
	@name('Порождать финансовые проводки')    P_PROVE                in [BOOLEAN],
	@name('Курс валюты договора')             P_COURSE               in [SUMMA_16_6],
	@name('Признак гашения доверенности')     P_TRUST_DOC_CLOSE      in [BOOLEAN]    default null,
	@name('Порождать счета-фактуры')          P_FACTURA_SIGN         in [BOOLEAN]    default null,
	@name('Признак расчета курса на дату')    P_SIGN_EST_COURSE_DATE in [BOOLEAN]    default null,
	@name('Дата расчета курса')               P_DATE_EST_COURSE      in [DATE]       default null,
	@name('Устанавливать дату валютирования') P_SET_DATE_VAL         in [BOOLEAN]    default null
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE := [SYSTEM]::[OP_DATE];

	V_DATE_PAY := [SYSTEM]::[OP_DATE];
	V_DATE_USAGE := [SYSTEM]::[OP_DATE];
end if;
-- End initialization of parameters and variables
declare
i number;
KindSF integer;
client_tmc 	[CLIENT_REF];
vSumma 		[SUMMA] := 0;
vDate		[DATE];
begin
	if p_message = 'DEFAULT' then
		vDate := [SYSTEM]::[OP_DATE];		
		P_SET_DATE_VAL := true;	
		use_sed:= false;
		/** / --API 16.01.2020
		begin
			select x(x.[CLIENTS_REF].[1].[1]) in ::[SED_CLIENTS] all
			where x.[CLIENTS_REF].[1].[1]%id = this(1).[SUP_CLIENT_REF]%id
			and x.[DATE_IN] <= vDate and vDate<=nvl(x.[DATE_OUT], vDate)
			and rownum = 1
			into client_tmc;
			use_sed:= true;
		exception when NO_DATA_FOUND then
			use_sed:= false;
		end;
		/**/
		
		factura_temp := null;
		-- дефолтные валидаторы
		idx := this.last;
		while idx is not null
		loop
			this(idx)=>[WORK_DOCUM](p_message, p_info, P_DATE, P_PROVE, P_COURSE, P_TRUST_DOC_CLOSE, P_FACTURA_SIGN, factura_temp, P_SET_DATE_VAL); -- чтобы сразу вывалились дефолтные прагмы по всем документам
			idx := this.prior(idx);			
		end loop;
		-- доверенность
		idx := this.first;
		while idx is not null
		loop
			if this(idx).[TRUST_DOCUM_REF] is not null then
				P_IS_TRUST_DOCUM_REF := true;
				exit;
			end if;
			P_IS_TRUST_DOCUM_REF := false;
			idx := this.next(idx);
		end loop;
		-- Счета - Фактуры для клиент-скрипта
		if this.count > 1 then
			V_WORK_ONE := false;
		else
			V_WORK_ONE := true;
			
			
			-- если документ один, вытягиваем данные по СФ
			V_NUM_FACT := this(this.first).[ACC_NUM];
			V_DATE_FACTURA := this(this.first).[ACC_DATE];
			V_DATE_PAY := this(this.first).[DATE_PAY];
			
		end if;
		--------v-------------/akuzmin	 20/02/2012   BS00211803
		--тип курса
		if this(this.first).[HOZ_DOG_REF].[RATE_TYPE]is not null and P_COURSE != 1 then
			P_COURSE := P_COURSE*(100+this(this.first).[HOZ_DOG_REF].[RATE_TYPE].[DEVIATION])/100.0;
		end if;
		--наличие хоз договора
		idx := this.first;
		while idx is not null
		loop
			if this(idx).[HOZ_DOG_REF] is not null then
				V_SIGN_HOZ_DOG := true;
				exit;
			end if;
			V_SIGN_HOZ_DOG := false;
			idx := this.next(idx);
		end loop;
		--------^---------------
		idx := this.first;
		while idx is not null
		loop
			if this(idx).[DOC_NAME_REF].[SIGN_SF_INITION] or this(idx).[DOC_NAME_REF].[SIGN_SF_INVOICE] then
				V_SIGN_SF_INITION := this(idx).[DOC_NAME_REF].[SIGN_SF_INITION];
				V_SIGN_SF_INVOICE := this(idx).[DOC_NAME_REF].[SIGN_SF_INVOICE];
				P_FACTURA_SIGN := (V_SIGN_SF_INITION or V_SIGN_SF_INVOICE) and nvl (::[FP_TUNE].[LIB].get_bool_value('SF_CREATE_ON_WORK'), true);
				idxValidate := idx;
				exit;
			end if;
			V_SIGN_SF_INITION := false;
			V_SIGN_SF_INVOICE := false;
			P_FACTURA_SIGN := (V_SIGN_SF_INITION or V_SIGN_SF_INVOICE) and nvl (::[FP_TUNE].[LIB].get_bool_value('SF_CREATE_ON_WORK'), true);
			idxValidate := this.first;
			idx := this.next(idx);
		end loop;
		--курс валюты договора
		idx := this.first;
		while idx is not null
		loop
			if this(idx).[HOZ_DOG_REF].[VALUTA] != sys_context (user_context, 'NatCur')
				and this(idx).[DOC_NAME_REF].[OPER].[CODE] in ('ПРИХОД', 'ДОНАЦЕНКА', 'РЕАЛИЗАЦИЯ', 'РЕМОНТ') then
				V_SIGN_COURSE := true;
				exit;
			end if;
			V_SIGN_COURSE := false;
			idx := this.next(idx);
		end loop;
		if nvl(V_SIGN_SF_INITION, false) then
			-- определим тип создаваемого СФ
			KindSF := ::[VHO_INTERFACE].[PRX_TMC].info_lib_get_factura_kind(This(This.First)%class, This(This.First));
			if KindSF = 1 then -- если СФ будет на покупку
				V_SIGN_SF_BUY := true;
				V_NUM_FACT := this(1).[WORK_DOCUM].V_NUM_FACT;
			else
				V_SIGN_SF_BUY := false;	
				-- номер зачищаем, т.к. на продажу номер должен сформироваться по счетчику
				V_NUM_FACT := null;
			end if;
		end if;	
		V_ARR.delete;
		if nvl(use_sed, false) then
			i := 0;
			for j in 1..this.count loop
				vSumma := vSumma + this(j).[SUM_DOC];
			end loop;
			for (select x(x.[NUM_FACT]	: NUM_FACT
						,x.[KIND].[0]	: KIND
						,x.[INITION]	: INITION
						,x.[INITION_CORR] : INITION_CORR
						,x.[SUM_FACT]	: SUM_FACT
						,x%id			: SCH_F_ID
						,x				: SF
						,x.[CONN]		: CONN
						) in ::[FACTURA_DOC]
			where
				x.[CL_DT].[1].[1]%id = client_tmc%id				
				and x%state = 'ACTIVE'
				and x.[INITION] is null
			) loop

				if ::[VHO_INTERFACE].[PRX_TMC].isSedFacturaReadOnly(p_sf==x.SF) then
					
					if (::[VHO_INTERFACE].[PRX_TMC].get_docs_sum_by_fact(x.[SF]) + vSumma) <= x.[SUM_FACT] then
						i := i + 1;
						V_ARR(i).[L1] := false;
						V_ARR(i).[S1] := x.[NUM_FACT];
						V_ARR(i).[PN1] := x.[SUM_FACT];
						V_ARR(i).[N1] := x.[SCH_F_ID];
						if x.[INITION] is null then
							if x.[INITION_CORR] is null then
								V_ARR(i).[S2] := 'первичный';
							else
								V_ARR(i).[S2] := 'корректировочный';
							end if;
						else
							V_ARR(i).[S2] := 'оплаченный';
						end if;
					end if;
				end if;
			end loop;	
		end if;
		if P_FACTURA_SIGN then
			check_controls(use_sed);
		end if;	

		p_info := 'P_DATE, P_COURSE, P_FACTURA_SIGN, P_DATE_EST_COURSE, P_SIGN_EST_COURSE_DATE';
	elsif p_message = 'VALIDATE' then
		if p_info = 'P_FACTURA_SIGN' then
			this(idxValidate).[WORK_DOCUM].V_SIGN_SF_INITION := nvl(this(idxValidate).[DOC_NAME_REF].[SIGN_SF_INITION], false); -- при валидации P_FACTURA_SIGN в WORK_DOCUM анализируются переменные V_SIGN_SF_INITION и V_SIGN_SF_INVOICE
			this(idxValidate).[WORK_DOCUM].V_SIGN_SF_INVOICE := nvl(this(idxValidate).[DOC_NAME_REF].[SIGN_SF_INVOICE], false);
			
		end if;
		this(idxValidate)=>[WORK_DOCUM](p_message, p_info, P_DATE, P_PROVE, P_COURSE, P_TRUST_DOC_CLOSE, P_FACTURA_SIGN, factura_temp, P_SET_DATE_VAL);
		if p_info in ('P_FACTURA_SIGN', 'P_DATE') then
			V_DATE_PAY := this(idxValidate).[WORK_DOCUM].V_DATE_PAY;
			V_DATE_USAGE := this(idxValidate).[WORK_DOCUM].V_DATE_USAGE;
			if nvl(P_FACTURA_SIGN, false) then
				check_controls(use_sed);
			else
				V_TYPE.[0] := 1;
				check_controls(false);
				[CSMD].Command(V_EXEC, 'Subform1.Visible = False');
				[CSMD].Command(V_EXEC, 'FrmFactura.Visible = True');
			end if;
		---------v---------/akuzmin 13/02/2012  BS00211803
		--установили дату расчета курса			
		elsif p_info = 'P_DATE_EST_COURSE'	then
			if V_WORK_ONE then
				P_COURSE := ::[DOCUMENT].[LIB_CUR].Get_Rate(this(this.first).[HOZ_DOG_REF].[VALUTA], P_DATE_EST_COURSE);
				if this(this.first).[HOZ_DOG_REF].[RATE_TYPE]is not null and P_COURSE != 1 then
					P_COURSE := P_COURSE*(100+this(this.first).[HOZ_DOG_REF].[RATE_TYPE].[DEVIATION])/100.0;
					
				end if;
			else
				P_COURSE := 1;
			end if;		
						
		--убрали крыжык "Признак расчета курса на дату". Возвращаем дефолтные значения	
		elsif p_info = 	'P_SIGN_EST_COURSE_DATE'  then
			if P_SIGN_EST_COURSE_DATE then
				P_DATE_EST_COURSE := P_DATE;
				if V_WORK_ONE then
					P_COURSE := ::[DOCUMENT].[LIB_CUR].Get_Rate(this(this.first).[HOZ_DOG_REF].[VALUTA], P_DATE_EST_COURSE);
					if this(this.first).[HOZ_DOG_REF].[RATE_TYPE]is not null and P_COURSE != 1 then
						P_COURSE := P_COURSE*(100+this(this.first).[HOZ_DOG_REF].[RATE_TYPE].[DEVIATION])/100.0;
					end if;
				else
					P_COURSE := 1;
				end if;
			else
				if V_WORK_ONE then
					if this(this.first).[HOZ_DOG_REF].[COURSE] > 0 then
						P_COURSE := this(this.first).[HOZ_DOG_REF].[Course];
					else
						P_COURSE := this(this.first).[HOZ_DOG_REF].[VALUTA].[VAL_COURCE];
					end if;
					if this(this.first).[HOZ_DOG_REF].[RATE_TYPE]is not null and P_COURSE != 1 then
						P_COURSE := P_COURSE*(100+this(this.first).[HOZ_DOG_REF].[RATE_TYPE].[DEVIATION])/100.0;
					end if;
				else
					P_COURSE := 1;
				end if;
				P_DATE_EST_COURSE := null;
			end if;
		
		elsif p_info='%VAR%.V_CHOOSE.0' then
				if V_CHOOSE.[0] = 1 then
					[CSMD].Command(V_EXEC, 'Subform1.Visible = False');
					[CSMD].Command(V_EXEC, 'FrmFactura.Visible = True');
				elsif V_CHOOSE.[0] = 2 then
					[CSMD].Command(V_EXEC, 'Subform1.Visible = True');
					[CSMD].Command(V_EXEC, 'FrmFactura.Visible = False');
				end if;	
		
		-------^---------------	
		end if;
	end if;
end;
end;

execute is

/*
 *     Дата        Автор       BFS         Описание
 * ----------   -----------	----------- ---------------------------------------------------
 * 14.09.2012	akuzmin		BS00211803	Добавлены параметры "Признак расчета курса на дату", "Дата расчета курса" и их обработка.
 * 25.02.2014	akuzmin		BS00806655	В случае, если создаваемый СФ будет на продажу, то блокируется поле для указания номера СФ. Удален закомментированный код и неиспользуемые переменные
*/
	isOneMatDoc	boolean; -- группируются платежные документы одного мат/документа
	id_int number;
	ac_m ref [TMC_LIST];
	hoz_dog ref [AUR_DOCUM];
	cal_calc ref [CALENDAR_CALC];
	hoz_oper ref [HOZ_OPER];
	p_check boolean;
	lv_canon_val varchar2(2000);

	--Создания календаря IFRS амортизации
	procedure createIFRS_many
	is
		sum_op [SUMMA];
	begin		
		if nvl(::[FP_TUNE].[LIB].get_bool_value('1B580011'), false) = true
			and this(idx).[DOC_NAME_REF].[OPER].[CODE] like '%АМОРТИЗАЦИЯ%'
			and this(idx).[DOC_NAME_REF].[TYPE_SUP].[CODE] like '%АФПП%' then
			
			p_check := false;
			-- проходим по списку тмц
			for ac_m in this(idx).[LIST_TMC]
				where ac_m.[ACC_MAT_SUP] is not null and ac_m.[ACC_MAT_SUP].[GRUPPA].[TYPE].[CODE] = 'АФПП'
			loop
				p_check := true;
				hoz_dog := null;
				-- получаем хоз договор из прихода
				for i in ac_m.[ACC_MAT_SUP].[TAB_MOVE]
				loop
					if i.[TMC_DOCUM_REF].[DOC_NAME_REF].[OPER].[CODE] = 'ПРИХОД' then
						hoz_dog := i.[TMC_DOCUM_REF].[HOZ_DOG_REF];
						EXIT;
					end if;
				end loop;
				
				if hoz_dog is null then
					stdio.PUT_LINE_BUF('По материальному счету №'||ac_m.[ACC_MAT_SUP].[ACC_MAT]||' не созданы экземпляры (АМОРТИЗАЦИЯ_АФПП) в календаре закрытий хозяйственного договора! (договор не определен)');
				elsif nvl(hoz_dog.[IFRS_16], false) then
					begin
						lv_canon_val := ::[FP_TUNE].[LIB].set_canons('VID_DOGOVOR', hoz_dog.[VID_DOG] , '<BP_IFRS16>', 'AM_AFPP');
						hoz_oper := ::[FP_TUNE].[LIB].get_ref_value (code == 'IFRS16_HOZ_OPER', canon_vals == lv_canon_val);
						
						sum_op := 0;
						for (select  x (
									sum (m.[PER_DEPR]) : SUM_DEPR
									,  x : tmc
								)
						in [AC_MAT], (TMC_MOVE all : m)
						where
							x.[TAB_MOVE] = m%collection
							and m.[TMC_DOCUM_REF] = this(idx)
							and x = ac_m.[ACC_MAT_SUP]
						group by x
						)
						loop
							sum_op := x.sum_depr;
						end loop;
						
						if sum_op = 0 then
							stdio.PUT_LINE_BUF('В календаре закрытий хоз. договора №'||hoz_dog.[NUM_DOG]||' от '|| to_char(hoz_dog.[DATE_BEGIN], 'DD/MM/YYYY') ||' экземпляр не создан, сумма операции = 0.');
							continue;
						end if;
						
						cal_calc := ::[VHO_INTERFACE].[PRX_TMC].New_calc(
															P_THIS == hoz_dog.[CALEND_CLOSE]
															, P_HOZ_OPER == hoz_oper
															, P_DATE_OPER == this(idx).[DATE_DOC]
															, P_SUMMA_OPER == sum_op
															, P_SUM_OPER_VAL_DOG == null
															, P_DAYS == 0
															, P_SUMMA_DAY == 0
															, P_SUMMA_NORMA == 0
															, P_SUMMA_NDS == 0
															, P_NDS == ::[SYSTEM].[VAL_ADD_TAX](3, P_DATE)
															, P_KIND_NDS == false
															, P_SUMMA_NSP == 0
															, P_NSP == null
															, P_KIND_NSP == false
															, P_SUMMA_RBP == 0
															, P_SUMMA_NDS_RBP == 0
															, P_VALUTA == hoz_dog.[VALUTA_OPER]
															, P_COURSE == hoz_dog.[COURSE_OPER]
															, P_COURSE_DOG == hoz_dog.[COURSE]
															, P_COURSE_DATE == false
															, P_RATE_TYPE == hoz_dog.[RATE_TYPE]
															, P_NAZN == 0
															, P_CLIENT_ACC == this(idx).[ACC_CLIENT]
															, P_SUB_CLIENT == hoz_dog.[CLIENT]
															, P_SET_CLIENT_ACC == hoz_dog.[SET_CLIENT_ACC]
															, P_BANKS_ACC == hoz_dog.[ACC_BANKS]
															, P_NDS_ACC == null
															, P_CAPITAL_ACC == hoz_dog.[ACC_CAPITAL]
															, P_RASHOD == null
															, P_GRT_RASHOD == null
															, P_ACC_ADD_RASHOD == null
															, P_CLIENT_RBP == hoz_dog.[CLIENT_RBP]
															, P_ACC_RC == null
															, P_KNP == null
															, P_VID_DOC == null
															, P_KIND_EXEC == null
															, P_DATE_EXEC == this(idx).[DATE_DOC]
															, P_TYPE_MESS == null
															, P_DOC_SEND == null
															, P_SYM_KS == null
															, P_NUM_KASSA == null
															, P_NUM_FACT == null
															, P_DATE_FACT == null
															, P_DATE_PAY == null
															, P_DOG_PURPOSE == null
															, P_CON_DOC_NUM == null
															, P_CON_DOC_DATE == null
															, P_BEG_DATE == null
															, P_END_DATE == null
															, P_DATE_COURSE_CALC == null
															, P_BUD_REQS == null
															, P_ACC_OTHER == null
															);
						cal_calc.[TMC_DOCUM_REF] := this(idx);
						cal_calc.[FOLDER] := this(idx).[IN_FOLDER];
						stdio.PUT_LINE_BUF('В календаре закрытий хоз. договора №'||hoz_dog.[NUM_DOG]||' от '|| to_char(hoz_dog.[DATE_BEGIN], 'DD/MM/YYYY') ||'создан экземпляр.');
					exception
						when NO_DATA_FOUND then
							stdio.PUT_LINE_BUF('Не найдена хоз. операция с кодом "АМОРТИЗАЦИЯ_АФПП"!');
					end;
					
				end if;
			end loop;
			
			if not p_check then
				stdio.PUT_LINE_BUF('Не найден мат. счет с типом АФПП!');
			end if;
			

		end if;	
	end;
	
	
	procedure createIFRS_one
	is
	begin		
		if nvl(::[FP_TUNE].[LIB].get_bool_value('1B580011'), false) = true
			and this(idx).[DOC_NAME_REF].[OPER].[CODE] like '%АМОРТИЗАЦИЯ%'
			and this(idx).[DOC_NAME_REF].[TYPE_SUP].[CODE] like '%АФПП%' then
			begin
				if this(idx).[HOZ_DOG_REF] is not null then
					hoz_dog := this(idx).[HOZ_DOG_REF];
					p_check := true;
				else
					locate ac_m in this(idx).[LIST_TMC]
					where ac_m.[ACC_MAT_SUP] is not null and ac_m.[ACC_MAT_SUP].[GRUPPA].[TYPE].[CODE] = 'АФПП';
					p_check := true;
					for i in ac_m.[ACC_MAT_SUP].[TAB_MOVE]
					loop
						if i.[TMC_DOCUM_REF].[DOC_NAME_REF].[OPER].[CODE] = 'ПРИХОД' then
							hoz_dog := i.[TMC_DOCUM_REF].[HOZ_DOG_REF];
							EXIT;
						end if;
					end loop;
				end if;
			exception
				when NO_DATA_FOUND then
					p_check := false;
					stdio.PUT_LINE_BUF('Не найден мат. счет с типом АФПП!');
			end;
			
			if nvl(p_check, false) then
				if hoz_dog is null then
					stdio.PUT_LINE_BUF('По материальному счету №'||ac_m.[ACC_MAT_SUP].[ACC_MAT]||' не созданы экземпляры (АМОРТИЗАЦИЯ_АФПП) в календаре закрытий хозяйственного договора!');
				elsif nvl(hoz_dog.[IFRS_16], false) then
					begin
						lv_canon_val := ::[FP_TUNE].[LIB].set_canons('VID_DOGOVOR', hoz_dog.[VID_DOG] , '<BP_IFRS16>', 'AM_AFPP');
						hoz_oper := ::[FP_TUNE].[LIB].get_ref_value (code == 'IFRS16_HOZ_OPER', canon_vals == lv_canon_val);

						cal_calc := ::[VHO_INTERFACE].[PRX_TMC].New_calc(
															P_THIS == hoz_dog.[CALEND_CLOSE]
															, P_HOZ_OPER == hoz_oper
															, P_DATE_OPER == this(idx).[DATE_DOC]
															, P_SUMMA_OPER == this(idx).[SUM_DEPR]
															, P_SUM_OPER_VAL_DOG == null
															, P_DAYS == 0
															, P_SUMMA_DAY == 0
															, P_SUMMA_NORMA == 0
															, P_SUMMA_NDS == 0
															, P_NDS == ::[SYSTEM].[VAL_ADD_TAX](3, P_DATE)
															, P_KIND_NDS == false
															, P_SUMMA_NSP == 0
															, P_NSP == null
															, P_KIND_NSP == false
															, P_SUMMA_RBP == 0
															, P_SUMMA_NDS_RBP == 0
															, P_VALUTA == hoz_dog.[VALUTA_OPER]
															, P_COURSE == hoz_dog.[COURSE_OPER]
															, P_COURSE_DOG == hoz_dog.[COURSE]
															, P_COURSE_DATE == false
															, P_RATE_TYPE == hoz_dog.[RATE_TYPE]
															, P_NAZN == 0
															, P_CLIENT_ACC == this(idx).[ACC_CLIENT]
															, P_SUB_CLIENT == hoz_dog.[CLIENT]
															, P_SET_CLIENT_ACC == hoz_dog.[SET_CLIENT_ACC]
															, P_BANKS_ACC == hoz_dog.[ACC_BANKS]
															, P_NDS_ACC == null
															, P_CAPITAL_ACC == hoz_dog.[ACC_CAPITAL]
															, P_RASHOD == null
															, P_GRT_RASHOD == null
															, P_ACC_ADD_RASHOD == null
															, P_CLIENT_RBP == hoz_dog.[CLIENT_RBP]
															, P_ACC_RC == null
															, P_KNP == null
															, P_VID_DOC == null
															, P_KIND_EXEC == null
															, P_DATE_EXEC == this(idx).[DATE_DOC]
															, P_TYPE_MESS == null
															, P_DOC_SEND == null
															, P_SYM_KS == null
															, P_NUM_KASSA == null
															, P_NUM_FACT == null
															, P_DATE_FACT == null
															, P_DATE_PAY == null
															, P_DOG_PURPOSE == null
															, P_CON_DOC_NUM == null
															, P_CON_DOC_DATE == null
															, P_BEG_DATE == null
															, P_END_DATE == null
															, P_DATE_COURSE_CALC == null
															, P_BUD_REQS == null
															, P_ACC_OTHER == null
															);
						cal_calc.[TMC_DOCUM_REF] := this(idx);
						cal_calc.[FOLDER] := this(idx).[IN_FOLDER];
						stdio.PUT_LINE_BUF('В календаре закрытий хоз. договора №'||hoz_dog.[NUM_DOG]||' от '|| to_char(hoz_dog.[DATE_BEGIN], 'DD/MM/YYYY') ||'создан экземпляр.');
					exception
						when NO_DATA_FOUND then
							stdio.PUT_LINE_BUF('Не найдена хоз. операция с кодом "АМОРТИЗАЦИЯ_АФПП"!');
					end;
				end if;
			end if;
		end if;	
	end;
	
begin
	spisCreateSF := P_FACTURA_SIGN;
	idx := this.first;
	while idx is not null
	loop
		
		-- эти переменные инициализируются в валидаторе WORK_DOCUM
		if this.count > 1 then -- берем умолчательные значения из документа
			debug_pipe(&METHOD$||' берем умолчательные значения из документа',0);
			this(idx).[PSH_WORK_DOCUM].V_TYPE.[0] := ::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Form_Type(This(idx)%class, This(idx)%Id, 'DEBUG'); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_NUM_FACT := ::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Num_Fact(This(idx)%class, This(idx)%Id); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_DATE_PAY := nvl(::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Pay(This(idx)%class, This(idx)%Id), P_DATE); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_DATE_USAGE :=  nvl(::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Usage(This(idx)%class, This(idx)%Id), P_DATE); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_DATE_FACTURA := ::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Date_Docum(This(idx)%class, This(idx)%Id); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_SIGN_SF_INITION := nvl(This(idx).[DOC_NAME_REF].[SIGN_SF_INITION], false); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_SIGN_SF_INVOICE := nvl(This(idx).[DOC_NAME_REF].[SIGN_SF_INVOICE], false); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			if spisCreateSF then
				P_FACTURA_SIGN := this(idx).[PSH_WORK_DOCUM].V_SIGN_SF_INITION or this(idx).[PSH_WORK_DOCUM].V_SIGN_SF_INVOICE; -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			end if;
		else
			-- для одного документа можно задать реквизиты СФ
			debug_pipe(&METHOD$||' для одного документа можно задать реквизиты СФ',0);
			this(idx).[PSH_WORK_DOCUM].V_TYPE.[0] := ::[VHO_INTERFACE].[PRX_TMC].Info_Lib_Get_Form_Type(This(idx)%class, This(idx)%Id, 'DEBUG'); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_NUM_FACT := V_NUM_FACT; -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_DATE_PAY := nvl(V_DATE_PAY, P_DATE); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_DATE_USAGE :=  nvl(V_DATE_USAGE, P_DATE); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_DATE_FACTURA := V_DATE_FACTURA; -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_SIGN_SF_INITION := V_SIGN_SF_INITION; -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_SIGN_SF_INVOICE := V_SIGN_SF_INVOICE; -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
		end if;
				
		--получение значения курса		
		P_COURSE := P_COURSE/(nvl((100+this(this.first).[HOZ_DOG_REF].[RATE_TYPE].[DEVIATION])/100.0,1));
		--установка дополнительных реквизитов
		if P_SIGN_EST_COURSE_DATE = true and P_DATE_EST_COURSE is null then
			pragma error('Введите дату расчета курса!');
		end if;	

		if P_SIGN_EST_COURSE_DATE and this(idx).[HOZ_DOG_REF] is not null then
			this(idx).[PSH_WORK_DOCUM].V_COURSE_DATE := true; -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_DATE_COURSE_CALC := P_DATE_EST_COURSE; -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
		else
			this(idx).[PSH_WORK_DOCUM].V_COURSE_DATE := null; -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			this(idx).[PSH_WORK_DOCUM].V_DATE_COURSE_CALC := null; -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
		end if;	

		if V_CHOOSE.[0] = 2 then
			declare
				j integer;
				f boolean;
			begin
				f := false;
				j := V_ARR.first;
				while j is not null loop
					if V_ARR(j).[L1] then
						if not f then
							f := true;
							id_int := V_ARR(j).[N1];
						else
							pragma error('Необходимо выбрать один счет-фактуру!');
						end if;
					end if;
					j := V_ARR.next(j);
				end loop;
				if not nvl(f, false) then
					pragma error('Не выбран счет-фактура!');
				end if;
			end;
			select x(x) in ::[FACTURA_DOC] where x%id = id_int into factura_temp;
			debug_pipe(&METHOD$||' (1)',0);
			this(idx).[PSH_WORK_DOCUM](P_DATE, P_PROVE, P_COURSE, P_TRUST_DOC_CLOSE, P_FACTURA_SIGN, factura_temp); --, P_SET_DATE_VAL); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
		else
			debug_pipe(&METHOD$||' (2)',0);
			
			this(idx).[PSH_WORK_DOCUM](P_DATE, P_PROVE, P_COURSE, P_TRUST_DOC_CLOSE, P_FACTURA_SIGN, null); --, P_SET_DATE_VAL); -- updated CHANGE_SHORT_NAME PSB_WORK_DOCUM->PSH_WORK_DOCUM 15/10/25
			
			--Создания календаря IFRS амортизации
			declare
				ac_m_cnt number;
			begin
				select x(count(1) :cnt) in this(idx).[LIST_TMC]
					where x.[ACC_MAT_SUP] is not null and x.[ACC_MAT_SUP].[GRUPPA].[TYPE].[CODE] = 'АФПП'
				into ac_m_cnt;
				if ac_m_cnt = 1 then
					createIFRS_one;
				else
					createIFRS_many;
				end if;
			end;
			
			
			
		end if;
		
		declare
			rashod ref [PL_RASHOD];
			work [CASE_BETWEEN_TWO];
		begin	
			locate rashod
			in ::[PL_RASHOD] all
			where 	rashod.[TMC_DOCUM] = this(idx)
				and rashod%state = 'NOT_WORK';
			work.[0] := 1;
			::[VHO_INTERFACE].[PRX_TMC].pl_rashod_work(rashod, work);
		exception
			when NO_DATA_FOUND then null;
		end;
	
		idx := this.next(idx);
	end loop;
	if tune_common_folder_for_docs and P_PROVE then
		-- объединение папок
		declare
			folder ref [FOLDER_PAY];
			collectionFolder	varchar2(16);
			foldToDel	ref [FOLDER_PAY];
		begin
			idx := this.first;
			folder := this(idx).[IN_FOLDER]; -- папка первого документа
			collectionFolder := folder.[DOCS_IN_FOLD];
			idx := this.next(idx);
			-- все мат/документы ссылаются на папку первого мат/документа, все плат/документы складываются в эту папку
			while idx is not null
			loop
				declare
					calendar	ref [CALENDAR_CALC];
				begin
					locate calendar in [CALENDAR_CALC] all--this(idx).[HOZ_DOG_REF].[CALEND_CLOSE]
						where calendar.[FOLDER] = this(idx).[IN_FOLDER];
					calendar.[FOLDER] := folder;
				exception when NO_DATA_FOUND then
					null;					
				end;
				for mainDoc in this(idx).[IN_FOLDER].[DOCS_IN_FOLD]
				loop
					mainDoc%collection := collectionFolder; -- кидаем в папку
					mainDoc.[DOCUMENT].[IN_FOLDER] := folder;
				end loop;
				-- удаляем ненужную папку
				foldToDel := this(idx).[IN_FOLDER];				
				::[VHO_INTERFACE].[PRX_TMC].FOLDER_PAY_DELETE_AUTO(foldToDel);
				this(idx).[IN_FOLDER] := folder;
				idx := this.next(idx);
				end loop;
		
				
			-- группировка
			isOneMatDoc := false;
			this(this.first).WORK_FOLDER (folder, P_DATE, isOneMatDoc, P_SET_DATE_VAL);
		end;
	end if;	
	this(this.first).[DATE_PROVE]:=P_DATE;
	debug_pipe('Прописали "Дата проводки" '||to_char(this(this.first).[DATE_PROVE],'dd/mm/yyyy'),0);
	
	this(this.first).[SUM_DEPR]:=CalcSumDoc(this(this.first));
	debug_pipe('Прописали "Сумма амортизации" '||this(this.first).[SUM_DEPR],0);
end;
end;
end;
