class ED574_SND_INFO;

@name('[ПСБ] Добавить')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('Банк')                                 P_BANK     in [BANK_RUS_REF],
	@name('Код SWIFT')                            P_SWIFTBIC in [STRING_11],
	@name('Уникальный идентификатор составителя') P_UIS      in [STRING_10]
) return ref [ED574_SND_INFO] is

execute is
begin
[UIS]:=P_UIS;
[SWIFTBIC]:=P_SWIFTBIC;
[BANK]:=P_BANK;

end;
end;
end;
