class PSH_ETO_C_OP;

@name('[ПСБ] Изменить')
@tag('CREATED')
method PSH_EDIT_AUTO uses PSH_NEW_AUTO is
PSH_EDIT_AUTO (
	@name('Дата')           P_DT          in [DATE],
	@name('Запрос CIT')     P_CIT_REQUEST in [CIT_IN_REQUE_REF],
	@name('Папка платежей') P_FOLDER_PAY  in [FOLDER_PAY_REF]
) is

validate is
	v_this ref [PSH_ETO_C_OP];
begin
	if this is not null then
		v_this := this;
		&BASE$SETVARS;
		&BASE$VALIDATE(v_this);
		&BASE$GETVARS;
	end if;
end;

execute is
	v_this ref [PSH_ETO_C_OP];
begin
	if this is not null then
		v_this := this;
		&BASE$SETVARS;
		v_this := &BASE$EXECUTE(v_this);
	end if;
end;
end;
end;
