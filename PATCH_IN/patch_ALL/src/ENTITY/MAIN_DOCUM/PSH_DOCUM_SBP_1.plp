class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Реестр по отмеченным')
batch method PSH_DOCUM_SBP_1 is
PSH_DOCUM_SBP_1 (
	@name('Дата') P_DATE in [DATE] default null
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE := [SYSTEM]::[OP_DATE];
end if;
-- End initialization of parameters and variables
declare
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma macro (xl,'::[OOXML].[API_XL]');
iFmt1		integer;
iFmt2		integer;
iRow		number;
nRow		number;
nSum        number;
iBorder		integer;
xl_tmpl 		blob := empty_blob();
d			ref [MAIN_DOCUM];
rUser		ref [USER] := ::[RUNTIME].[STDLIB].userid;	

begin
	
	if P_MESSAGE = 'DEFAULT' then
	    
		P_DATE:= ::[SYSTEM].[OP_DATE]-1;
	end if; --*/

	if P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'OK' then
	  --::[SHABLON_DOC].[LIB_OOXML].xl_init;
		::[SHABLON_DOC].[LIB_OOXML].load_blob('PSB_REESTR_SBP', xl_tmpl, null, null, null, null);
		     
		if xl_tmpl is null then pragma error('Не найден шаблон отчета'); end if;				
		if not &xl.open_file(xl_tmpl) then pragma error('Ошибка при открытии печатной формы шаблона');	end if;		  
       &xl.Open_Sheet(1);			
	   &xl.RenameSheet(1,to_char(P_DATE,'dd.mm.yy')); 			
			
	iRow := 4;
	nRow := 0;
	nSum:=0;
	
	iFmt1 := &xl.Get_numFmt ('###0');
	iFmt2 := &xl.Get_numFmt ('#,##0.00');
	iBorder := &xl.get_border(p_top==&xl.xl_b_thin, p_bottom==&xl.xl_b_thin, p_left==&xl.xl_b_thin, p_right==&xl.xl_b_thin);

    &xl.Write(1, 9, 'Ресстр документов за '||to_char(P_DATE,'dd.mm.yyyy') ||' года');  -- bold
   /* 
    &xl.Write(iRow, 1, 'Номер п/п');
    &xl.Write(iRow, 2, 'Дата');
    &xl.Write(iRow, 3, 'Документ');
    &xl.Write(iRow, 4, 'ВО');
    &xl.Write(iRow, 5, 'Номер');
    &xl.Write(iRow, 6, 'Сумма');
    &xl.Write(iRow, 7, 'Сумма эквивалента');    
    &xl.Write(iRow, 8, 'Вал');    
    &xl.Write(iRow, 9, 'Счет Дебет');    
    &xl.Write(iRow, 10, 'Счет Кредит');    
    &xl.Write(iRow, 11, 'Назначение платежа');    
    &xl.Write(iRow, 12, 'Плательщик');    
    &xl.Write(iRow, 13, 'Получатель');    
    &xl.Write(iRow, 14, 'Очередность');    --*/
     &xl.set_autofilter(4,4,1,14);
	/*for (
	        select d(
				      d  					: c_id			
				    , d.[DOCUMENT_NUM]      : c_document_num
				    , d.[VID_DOC].SHORT_CODE		:c_vid_doc_cod
				    , d.[VID_DOC].SHORT_NAME		:c_vid_doc_name
				    , d.[DATE_EXEC]         : c_date_exec
				    , d.[VALUTA].CODE_ISO    :c_valute
				    , d.[SUM]				: c_sum
				    , d.[SUM_NT]			: c_sum_nt
				    , d.[ACC_DT].[MAIN_V_ID]: c_num_dt
				    , d.[ACC_KT].[MAIN_V_ID]: c_num_kt				    
					, d.[NAZN]   : c_nazn
					, d.[PRIORITET]   : c_prioritet
					, d.[DOCUMENT_UNO]   : c_doc_uno
					--, d.[ACC_DT].[CLIENT_V].[NAME] :c_client_name_d
					--, d.[ACC_DT].[CLIENT_V]		   :c_client_id_d
					--, d.[ACC_KT].[CLIENT_V].[NAME] :c_client_name_k
					--, d.[ACC_KT].[CLIENT_V]		   :c_client_id_k
					,coalesce(d.[KL_DT].[2].[2], d.[KL_DT].[1].[1].[NAME])	: c_name_d
					,coalesce(d.[KL_KT].[2].[2], d.[KL_KT].[1].[1].[NAME])	: c_name_k
						) in ::[MAIN_DOCUM]
						where
						d.[DOCUMENT_USER]=4089702040
						--substr(d.[ACC_KT].[MAIN_V_ID],1,5)='40807'  and (substr(d.[ACC_DT].[MAIN_V_ID],1,5)='30102' or  substr(d.[ACC_DT].[MAIN_V_ID],1,5)='47416')
						and  trunc(d.[DATE_PROV])=trunc(P_DATE) 
						and  d%state='PROV'
						
				order by 5,6 
	)--*/
	for i in this.first .. this.last
	loop
	locate d in ::[MAIN_DOCUM] where d%id = this(i);    
		iRow :=	iRow + 1;	
		nRow :=	nRow + 1;
		&xl.Ins_Row(iRow,1,1,true);

        &xl.put(iRow,1, nRow);      
        &xl.put(iRow,2, to_char(d.[DATE_EXEC] ,'dd/mm/yyyy')); 
        &xl.put(iRow,3,d.[VID_DOC].SHORT_NAME);
        &xl.put(iRow,4,d.[VID_DOC].SHORT_CODE);
        &xl.put(iRow,5,d.[DOCUMENT_NUM]);
        nSum:=nSum+d.[SUM_NT];
        &xl.put(iRow,6, d.[SUM]);	
        &xl.put(iRow,7, d.[SUM_NT]);	
        &xl.put(iRow,8, d.[VALUTA].CODE_ISO);	
        &xl.put(iRow,9,d.[ACC_DT].[MAIN_V_ID]);	
        &xl.put(iRow,10,d.[ACC_KT].[MAIN_V_ID]);
        &xl.put(iRow,11, d.[NAZN]);
        &xl.put(iRow,12, coalesce(d.[KL_DT].[2].[2], d.[KL_DT].[1].[1].[NAME]));      
        &xl.put(iRow,13, coalesce(d.[KL_KT].[2].[2], d.[KL_KT].[1].[1].[NAME]));    
        &xl.put(iRow,14, d.[PRIORITET]);    
		--*/
	end loop;
	&xl.Set_Format_Range(4, 1, iRow, 14, p_borderId == iBorder);
	
	iRow:=iRow+1;
	
	--&xl.delete_row(iRow);
	
	&xl.Formula(iRow,7,'=SUM(G4:G'||to_char(iRow-1)||')');   
	&xl.put(iRow+3,1, 'Количество документов '||nRow|| ' на сумму '||to_char( nSum ,'FM99,999,999,999,990.00')|| ' ('||::[RUNTIME].[STDLIB].N2Str(nSum, 'NatCur') ||')');  --фор   
	
	
	
	&xl.put(iRow+5,1,rUser.[CASTA].[VALUE]);    
	
	&xl.put(iRow+5,7,rUser.[NAME]);    
	/* 
	&xl.put(iRow+7,1, 'Главный бухгалтер');    
	&xl.put(iRow+7,7, 'Харина Е.М.');    
	*/      
	&xl.Open_Sheet(1);		
    &xl.finish(xl_tmpl);
	[OOXML]::[API_ORSA].putReport2RunExtProc(xl_tmpl,'xlsx','Реестр документов за '||to_char(P_DATE,'dd.mm.yy')||' ');														

		end if; -- p_info
	end if; -- p_messge
End;
end;

execute is

begin
 null;							
end;
end;
end;
