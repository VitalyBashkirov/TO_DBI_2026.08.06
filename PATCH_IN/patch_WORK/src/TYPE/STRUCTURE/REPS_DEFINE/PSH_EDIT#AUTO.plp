class REPS_DEFINE;

@import_plsql(true)
@generate_ansi_joins(true)
@name('[ПСБ] Редактировать конфигурацию')
@tag('COPIED')
method PSH_EDIT#AUTO is

@name('Текущие приложения')       public V_G_LIST       table of [GRID_REPS];
@name('Доступные приложения')     public V_G_LIST_ALL   table of [GRID_REPS];
@name('Справочник приложений')    public V_SRC_APP               [NAME];
@name('Заголовок')                public V_CAPTION               [STRING_256];
@name('Наименование справочника') public V_SRC_APP_NAME          [STRING_4000];
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
dp integer:=0;	--управление &debug
dp10 integer:=0;	--управление &debug
fmt	   string(10):='dd/mm/yyyy';

pragma macro('LibDef', '::[REPS_DATA].[PSH_LIB_DEFINE]'); -- updated CHANGE_SHORT_NAME PSB_LIB_DEFINE->PSH_LIB_DEFINE 14/10/25

vRepCode		varchar2(128);
rProf		ref [REPS_PROF_TUN];

type TblConf is table of ::[LIST_APP]%rowtype;
tConfDefine				TblConf;

function GetMethodName 
	(	P_CLASS_ID		varchar2(128)
	,	P_SHORT_NAME	varchar2(128)
	)
return varchar2(128)
is
	vResult varchar2(128);
begin
	vResult := null;
	for (	select	m(m.NAME : C_METHOD_NAME)
			in		methods%rowtype
			where	m.class_id = P_CLASS_ID
				and m.short_name = P_SHORT_NAME
			fetch 1
		)
	loop
		vResult := m.C_METHOD_NAME;
	end loop;
	return vResult;
end;

-- инициализация грида с операциями по текущей конфигурации
procedure SetList(P_DEFINE ref [REPS_DEFINE])
is
	recGrid		[GRID_REPS];
	vMethName varchar2(128);
	arrDefineList P_DEFINE.[LIST_APP]%type := P_DEFINE.[LIST_APP];
begin
	V_SRC_APP_NAME := 'Класс не найден!';
	for	(
		select cls('"' || cls.[NAME] || '"': C_NAME)
		in ::[METACLASS]
		where 	cls%id = V_SRC_APP
		fetch 1
		)
	loop
		V_SRC_APP_NAME := cls.C_NAME || ' ('|| V_SRC_APP ||')';
	end loop;
	&debug('.SetList -- V_SRC_APP_NAME='||V_SRC_APP_NAME,dp)

	V_G_LIST.delete;
	for(
		select x
			(	x.[CODE] : C_CODE
			,	x.[NAME] : C_NAME
			)
		in ::[LIST_APP] all where x%collection = arrDefineList
		order by x.[CODE]
		)
	loop
		&debug(TB$||x.C_CODE||'-'||x.C_NAME, dp)
		vMethName := null;
		for (
			select m(m.[SHORT_NAME]	: C_SHORT_NAME)
			in methods%rowtype
			where m.[CLASS_ID] = V_SRC_APP and m.[SHORT_NAME] = x.C_CODE
			)
		loop
			vMethName := m.C_SHORT_NAME;
			&debug(TB$||TB$||'vMethName='||vMethName,dp)
		end loop;							
			
		-- Если операция присутствует в конфигурации, но реально такой операции нет в ТБП - удаляем операцию
		if vMethName is null then
			&debug('Внимание! В конфигурации содержалась операция "'||x.C_CODE||'", которая не существует в ТБП "'||V_SRC_APP||'"! Операция была удалена из конфигурации.', dp)
			delete a in ::[LIST_APP] all where a%collection = arrDefineList and a.[CODE] = x.C_CODE;
			commit;
		end if;
		
		recGrid := null;
		recGrid.[CODE] := x.C_CODE;
		recGrid.[NAME] := coalesce
									(	GetMethodName(V_SRC_APP, x.C_CODE)
									,	x.C_NAME
									);
		V_G_LIST(V_G_LIST.count + 1) := recGrid;
		&debug(TB$||TB$||'V_G_LIST('||V_G_LIST.count||') recGrid='||recGrid.[CODE]||' '||recGrid.[NAME],dp)
	end loop;		
end;

-- инициализация грида с доступными операциями
procedure SetListAll
is
	recGrid			[GRID_REPS];
	iIdx			integer;
	v_oper_info		varchar2(4000);
	v_is_ext		varchar2;
	vCompRep		varchar2;
	v_pril			varchar2;
begin
	V_G_LIST_ALL.delete;
	&debug('.SetListAll -- Справочник приложений V_SRC_APP='||V_SRC_APP,dp)

	for(select x(x.[SHORT_NAME]		: CODE
				,x.[NAME]			: NAME
				)
		in methods%rowtype
		where x.[CLASS_ID] = V_SRC_APP
		order by x.[SHORT_NAME]
		)
	loop
		&debug('.SetListAll -- '||V_SRC_APP||'.'||x.CODE||'-'||x.NAME,dp)
		recGrid := null;

		-- Проверка короткого имени операции на допустимость использования в конфигурации
		if not &LibDef.CheckAppShortName(x.CODE) then
			continue;
		-- Проверка на совместимость ядра
		elsif not &LibDef.CheckCoreVer(rProf, x.CODE) then
			continue;
		end if;

		-- Проверка на то, что другая версия данной библиотеки уже добавлена в конфигурацию
		iIdx := V_G_LIST.first;
		while iIdx is not null
		loop
			-- Если уже добавленный метод совпадает по маске с текущим методом
			exit when &LibDef.EqualOperCode(V_SRC_APP, V_G_LIST(iIdx).[CODE], x.CODE);
			iIdx := V_G_LIST.next(iIdx);
		end loop;
		&debug('.SetListAll -- Проверка на то, что другая версия данной библиотеки уже добавлена в конфигурацию приложений iIdx='||iIdx,dp)
		
		-- Подобная библиотека уже добавлена в конфигурацию
		if iIdx is not null then
			&debug('.SetListAll -- Подобная библиотека уже добавлена в конфигурацию',dp)
			continue;
		end if;

		v_oper_info := &LibDef.GetCoreInfo(V_SRC_APP, x.CODE);
		&debug('.SetListAll -- v_oper_info='||v_oper_info,dp)
		
		-- Проверка на совместимость с отчетом
		::[RUNTIME].[STR].get_par(v_oper_info, 'P_COMP_REP', vCompRep);
		if vCompRep is not null and instr(vCompRep, '#' || vRepCode || '#') = 0 then
			continue;
		end if;

		recGrid.[CODE] := x.CODE;
		recGrid.[NAME] := x.NAME;

		::[RUNTIME].[STR].get_par(v_oper_info, 'P_IS_EXT', v_is_ext);
		if v_is_ext = '1' then
			if not ::[REPS_DATA].[PSH_LIB_REG_DOP].IsMethReg(x.CODE, vRepCode, v_pril) then -- updated CHANGE_SHORT_NAME PSB_LIB_REG_DOP->PSH_LIB_REG_DOP 14/10/25
				recGrid.[USE] := true;
			end if;
		end if;

		V_G_LIST_ALL(V_G_LIST_ALL.count + 1) := recGrid;
		&debug(TB$||TB$||'V_G_LIST_ALL('||V_G_LIST_ALL.count||') recGrid='||recGrid.[CODE]||' '||recGrid.[NAME]||' USE:'||recGrid.[USE],dp)
	end loop;
end;

-- удаление записи в гриде с операциями по текущей конфигурации
procedure DelApp(p_idx	integer)
is
begin
	if p_idx > 0 then
		delete x in rProf.[DEFINE].[LIST_APP] where x.[CODE] = V_G_LIST(p_idx).[CODE];
		V_G_LIST.delete(p_idx);
	end if;
end;

-- добавление записи в грид с операциями по текущей конфигурации
procedure SetApp(p_idx	integer)
is
	v_idx	integer;
	v_pril	varchar2;
	v_list_app ref [LIST_APP];
begin
	&debug('.SetApp -- p_idx='||p_idx,dp)
	if p_idx > 0  then
		v_idx := nvl(V_G_LIST.last,0)+1;
		
		&debug('.SetApp -- V_G_LIST_ALL('||p_idx||').[USE]='||V_G_LIST_ALL(p_idx).[USE],dp)
		if V_G_LIST_ALL(p_idx).[USE] then
			if not ::[REPS_DATA].[PSH_LIB_REG_DOP].IsMethReg(V_G_LIST_ALL(p_idx).[CODE], vRepCode, v_pril) then -- updated CHANGE_SHORT_NAME PSB_LIB_REG_DOP->PSH_LIB_REG_DOP 14/10/25
				pragma error('Приложение "' || v_pril || '" не зарегистрировано! Для использования данного приложения необходимо провести его регистрацию в справочнике "Список приложений. Настройка".');
			end if;
		end if;

		V_G_LIST(v_idx).[CODE] := V_G_LIST_ALL(p_idx).[CODE];
		V_G_LIST(v_idx).[NAME] := V_G_LIST_ALL(p_idx).[NAME];

		v_list_app := rProf.[DEFINE].[LIST_APP].[NEW#AUTO](V_G_LIST(v_idx).[CODE], V_G_LIST(v_idx).[NAME]);
		&debug('.SetApp -- +'||V_G_LIST(v_idx).[CODE]||'-'||V_G_LIST(v_idx).[NAME],dp)
	end if;
end;


--	Инициализация бэкапа конфигурации профиля.
procedure SaveListConf(P_DEFINE 			ref [REPS_DEFINE])
is
begin
	select x(x%rowtype)
	in P_DEFINE.[LIST_APP]
	into tConfDefine;
end;


--	Бэкап конфигурации профиля.
procedure BackListConf(P_DEFINE 			ref [REPS_DEFINE])
is
begin
	--	очистка конфигурации
	delete x in P_DEFINE.[LIST_APP];
	--	заполнение конфигурации записями, которые были при открытии операции
	if tConfDefine.count > 0 then
		insert into ::[LIST_APP]
			for i in 1..tConfDefine.count loop
				la(	  la%collection	= tConfDefine(i)%collection
					, la.[CODE]		= tConfDefine(i).[CODE]
					, la.[NAME]		= tConfDefine(i).[NAME]
					);
	end if;
	--	очистка памяти
	tConfDefine.delete;
end;


-- Добавление всех доступных операций в конфигурацию
procedure AddAllItems
is
	iIdx 		integer;
	vPril		varchar2;
	bChanged	boolean;
begin
	-- Так как добавление операции в профиль меняет список доступных операций,
	-- то обработка происходит в виде следующего цикла:
	loop
		-- Сбрасываем флаг, означающий наличие доступной операции, которую мы добавляем в профиль
		bChanged := false;
		-- Проходим по списку операций, начиная с последней к первой (так как они упорядочены по коду)
		-- в поисках операции, доступной для включения
		iIdx := V_G_LIST_ALL.last;
		while iIdx is not null loop
			-- Если обрабатываемая операция не требует регистрации
			if not coalesce(V_G_LIST_ALL(iIdx).[USE], false)
			-- или приложение операции зарегистрированно
			or ::[REPS_DATA].[PSH_LIB_REG_DOP].IsMethReg(V_G_LIST_ALL(iIdx).[CODE], vRepCode, vPril) -- updated CHANGE_SHORT_NAME PSB_LIB_REG_DOP->PSH_LIB_REG_DOP 14/10/25
			then
				-- То устанавливаем флаг наличия доступной для включения операции
				bChanged := true;
				-- Нашли операцию, в iIdx её индекс - выходим из цикла поиска операции.
				exit;
			end if;
			iIdx := V_G_LIST_ALL.prior(iIdx);
		end loop;
		-- Если найдена доступная для включения операция
		if bChanged then
			-- То включаем её
			SetApp(iIdx);
			-- И перестраиваем список доступных операций
			SetListAll();
		end if;
		-- Если нет доступных для добавления операций - выходим
		exit when not bChanged;
		-- иначе будет новая итерация с новым списком доступных операций
	end loop;
end;


-- Удаление всех операций из конфигурации
procedure DelAllItems
is
	iIdx integer;
begin
	-- В цикле по списку операций профиля (от последнего к первому)
	iIdx := V_G_LIST.last;
	while iIdx is not null loop
		-- Удаляем все операции
		DelApp(iIdx);
		iIdx := V_G_LIST.prior(iIdx);
	end loop;
end;
PSH_EDIT#AUTO is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	V_SRC_APP := this.[SRC_APP];
end if;
-- End initialization of parameters and variables
begin
	if p_message = 'DEFAULT' then
		for(select distinct prof
					( prof				: id
					, prof.[NAME]		: c_name
					, prof.[CODE]		: c_code
					, prof.[REP].[CODE]	: c_rep_code
					)
			in ::[REPS_PROF_TUN]
			where prof.[DEFINE] = this
			)
		loop
			rProf 		:= prof.id;
			vRepCode	:= prof.c_rep_code;
			V_CAPTION 	:= &METHOD$NAME || ':  профиль "' || prof.c_name || '" (' || prof.c_code || ')';
		end loop;
		&debug('rProf%id='||rProf%id||' vRepCode='||vRepCode||' '||V_CAPTION,dp)
		
		V_SRC_APP := this.[SRC_APP];

		SetList(this);
		SetListAll();
		SaveListConf(this);

	elsif p_message = 'VALIDATE' then
		&debug('P_INFO='||P_INFO,dp)
		if p_info like 'DEL_APP#%' then
			DelApp(substr(p_info, 9));
			SetListAll();

		elsif p_info like 'SET_APP#%' then
			SetApp(substr(p_info, 9));
			SetListAll();

		elsif p_info = 'BUTTON_SET_ALL' then
			AddAllItems();

		elsif p_info = 'BUTTON_DEL_ALL' then
			DelAllItems();
			SetListAll();

		elsif p_info like 'CANCEL' then
			BackListConf(this);

		elsif p_info like 'OK' then
			--	очистка памяти
			tConfDefine.delete;
		end if;
	end if;
end;
end;
end;
end;
