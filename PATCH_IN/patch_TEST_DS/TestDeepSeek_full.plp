PROCEDURE v50_PROC_JSON_p_3_1_4 IS
	v_json_obj JSON_Object_T;
	v_lib_json_obj ::[RUNTIME].[LIB_JSON].T_JSON_ELEMENT;
BEGIN
	-- [-] НЕПРАВИЛЬНО
