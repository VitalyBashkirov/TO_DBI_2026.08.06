		--!			V_NOMINALS_TBL(V_NOMINALS_TBL.count).[MONEY_TYPE] := n.[VID_MONEY];
		--!			V_NOMINALS_TBL(V_NOMINALS_TBL.count).[IN_AMOUNT] := 0;
		--!			V_NOMINALS_TBL(V_NOMINALS_TBL.count).[OUT_AMOUNT] := 0;
		--!		end loop;
		--!	exception
		--!		when NO_DATA_FOUND then
		--!			null;
		--!	end;			
		--!end if;

		if P_INFO in ('P_OUT_CURR', 'P_OUT_AM', 'P_ARR_CHECKS') and V_TYPE_CODE in ('BUY_OP', 'CON_OP', 'REL_OP', 'PAY_OP', 'BUD_OP', 'CDD_OP', 'BUC_OP', 'CDR_OP', 'PCV_OP', 'PCR_OP') then
			if P_RATE <> 0 then
				if p_back is null then
					P_IN_AM := round(P_OUT_AM / P_RATE, 2);
				else
					P_IN_AM := round(P_OUT_AM * p_back, 2);
				end if;
			end if;
		end if;

		if P_INFO in ('P_OUT_CURR', 'P_OUT_AM', 'P_RATE', 'P_DATE', 'P_PAY_DOC_TYPE', 'P_ARR_CHECKS') and V_TYPE_CODE in ('SEL_OP', 'SED_OP', 'COD_OP', 'VCV_OP', 'VCR_OP') then
			if p_back is null then
				P_IN_AM := round(P_OUT_AM * P_RATE, 2);
			else
				P_IN_AM := round(P_OUT_AM / p_back, 2);
			end if;
		end if;

		if P_PAY_DOC_TYPE is not null then
			CURR := P_PAY_DOC_TYPE.[CURRENCY];

			if V_TYPE_CODE in ('BUD_OP', 'CDD_OP', 'BUC_OP', 'CDR_OP', 'PCV_OP', 'PCR_OP') and CURR <> P_IN_CURR or
			   V_TYPE_CODE in ('SED_OP', 'COD_OP', 'VCV_OP', 'VCR_OP')  and CURR <> P_OUT_CURR then
				P_PAY_DOC_TYPE := null;
				
				--!::[CHECK_NOTRADE].[EDIT#AUTO].G_PLAT_DOCUMENT := null;
				--!::[CHECK_NOTRADE].[EDIT#AUTO].G_CASHIER_INFO := null;
                --!
				--!P_ARR_CHECKS%delete;

				P_IN_AM := 0;
				P_OUT_AM := 0;
				V_RES_IN_AM := 0;
				V_RES_IN_AM_2 := 0;
				V_RES_OUT_AM := 0;
				V_RES_OUT_AM_2 := 0;
			--!else
			--!	::[CHECK_NOTRADE].[EDIT#AUTO].G_PLAT_DOCUMENT := P_PAY_DOC_TYPE;
			--!	::[CHECK_NOTRADE].[EDIT#AUTO].G_CASHIER_INFO := V_CASHIER_INFO;
			end if;
		end if;

		--!if P_INFO in ('P_TICKET_NUM', 'P_TICKET_DATE') and V_TYPE_CODE in ('EXR_OP', 'VIN_OP') then
		--!	P_ARR_INKASSO%delete;
		--!	
		--!	-- Заполним массив документов на экспертизу документами из базы, у которых
		--!	-- номер квитанции совпадает с введенным,
		--!	begin
		--!		P_OUT_CURR := null;
		--!		
		--!		for ink_doc in ::[INKASSO] all
		--!			where ink_doc.[REQ_INKASSO].[TICKET] = P_TICKET_NUM and
		--!				  ink_doc.[REQ_INKASSO].[DOC_VIN_OP] is null and
		--!				  ink_doc.[DOCUMENT_DATE] >= trunc(P_TICKET_DATE) and
		--!				  ink_doc.[DOCUMENT_DATE] < trunc(P_TICKET_DATE) + 1 loop
		--!			P_ARR_INKASSO%insert(ink_doc);
        --!
		--!			if P_OUT_CURR is null then
		--!				P_OUT_CURR := ink_doc.[REQ_INKASSO].[DOC_NIN_OP].[REQ_INPUT].[CURRENCY];
		--!			end if;
		--!		end loop;
		--!	exception when NO_DATA_FOUND then
		--!		null;
		--!	end;
        --!
		--!	select i(nvl(sum(i.[REQ_INKASSO].[NOMINAL]),0), nvl(count(1),0))
		--!		in ::[INKASSO], (::[INKASSO_REF] all : r) all
        --!        where r%collection = P_ARR_INKASSO and r.[] = i%id
		--!		into P_OUT_AM, V_INKASSO_CNT;
        --!
		--!end if;

		--!if (P_INFO in ('P_IN_AM', 'P_OUT_AM') and V_TYPE_CODE in ('EXC_OP', 'RAS_OP')) or
		--!	instr(P_INFO, '%VAR%.V_NOMINALS.IN_AMOUNT[') > 0 or
		--!	instr(P_INFO, '%VAR%.V_NOMINALS.OUT_AMOUNT[') > 0
		--!then
		--!	declare
		--!		i integer;
		--!	begin
		--!		V_G_IN = V_G_OUT := 0;
		--!		i := V_NOMINALS_TBL.first;
		--!		while i is not null loop
		--!			V_G_IN := V_G_IN + V_NOMINALS_TBL(i).[NOMINAL] * V_NOMINALS_TBL(i).[IN_AMOUNT];
		--!			V_G_OUT := V_G_OUT + V_NOMINALS_TBL(i).[NOMINAL] * V_NOMINALS_TBL(i).[OUT_AMOUNT];
		--!		
		--!			i := V_NOMINALS_TBL.next(i);
		--!		end loop;
		--!	end;
		--!end if;
-----------	
	if P_TYPE is null then
		V_DUMB_RATE=V_DUMB_CB_RATE:=null;
	else
		null;
		&debug('Курс    '||V_DUMB_RATE,dp)
		&debug('Курс ЦБ '||V_DUMB_CB_RATE,dp)
	end if;
end;
PSH_KASSA_V_R (
	@name('Касса')                                             V_EXCHG_POINT    in [S_NOTRADE],
	@name('Вид')                                               P_TYPE           in [TP_OPER_REF],
	@name('Номер')                                             P_NUM            in [NUMBER_DOC],
	@name('Дата')                                              P_DATE           in [DATE],
	@name('Валюта принято')                                    P_IN_CURR        in [FT_MONEY_REF],
	@name('Сумма принято')                                     P_IN_AM          in [SUMMA],
	@name('Валюта выдано')                                     P_OUT_CURR       in [FT_MONEY_REF],
	@name('Сумма выдано')                                      P_OUT_AM         in [SUMMA],
	@name('Курс')                                              P_RATE           in [SUMMA_16_6],
	@name('Клиент')                                            P_CUST           in [CLIENT_REF],
	@name('Реквизиты клиента')                                 P_CUST_PROPS     in [SHORT_CLIENT],
	@name('Вид удостоверяюещго личность документа')            P_CUST_DOC_TYPE  in [CERTIFIC_REF],
	@name('Обратный Курс')                                     P_BACK           in [SUMMA_16_6],
	@name('Телефон')                                           P_PHONE          in [STRING_4000],
	@name('Вид документа удостоверяюещго личность доверителя') P_PRIN_DOC_PROPS in [CERTIFIC_REF],
	@name('Вид платежного документа')                          P_PAY_DOC_TYPE   in [CHECK_OTHER_REF]  default null,
	@name('Реквизиты инкассо / экспертизы')                    P_COLL_EXP_PROPS in [INKASSO_STRUCT]   default null,
	@name('Дата квитанции / справки')                          P_TICKET_DATE    in [DATE]             default null,
	@name('Номиналы')                                          P_NOMS           in [ARR_NOMINAL]      default null,
	@name('Реквизиты пластиковой карты')                       P_CARD_PROPS     in [CARD_REQ]         default null,
	@name('Сумма подоходного налога')                          P_INC_TAX_AM     in [SUMMA]            default null,
	@name('Процент подоходного налога')                        P_INC_TAX_RATE   in [PRC12P6]          default null,
	@name('Валюта комиссии')                                   P_CHARGE_CURR    in [FT_MONEY_REF]     default null,
	@name('Сумма комиссии')                                    P_CHARGE_AM      in [SUMMA]            default null,
	@name('Серия и номер бланка чека')                         P_BLANK_NUM      in [N_RAZR]           default null,
	@name('По доверенности')                                   P_LETTER         in [BOOLEAN]          default null,
	@name('Документы инкассо / экспертизы')                    P_ARR_INKASSO    in [INKASSO_REF_ARR]  default null,
	@name('Номер квитанции / справки')                         P_TICKET_NUM     in [STRING_50]        default null,
	@name('Платежные документы')                               P_ARR_CHECKS     in [CHECK_NOTRAD_ARR] default null,
	@name('Доверитель')                                        P_PRINCIPAL      in [SHORT_CLIENT]     default null
) return [CL_PRIV] is

validate is
begin
	if p_message = 'DEFAULT' then
		timeBeg := sysdate;
		
		P_DATE:=trunc(sysdate); --trunc(stdlib.UserId.[FILIAL].[OP_DATE]);
		P_CUST=ClTmp:=this;
		
		InitPCustProps(p_info,this,P_TYPE,P_DATE,P_CUST,P_CUST_PROPS,P_CUST_DOC_TYPE,P_PHONE,
			V_EXCHG_POINT,V_AVAIL_FIN_TOOLS_STR,V_AVAIL_OPERS_STR,
			V_TYPE_CODE,V_NAT_CURR_CODE,
			P_IN_CURR,P_IN_AM,P_OUT_CURR,P_OUT_AM,
			P_RATE,P_PAY_DOC_TYPE,P_BACK,
			V_DUMB_CB_RATE,V_DUMB_RATE,
			V_SOURCE_MONEY_PROVIDED,V_NOTE);
		
		if V_SOURCE_MONEY_PROVIDED and greatest(nvl(P_IN_AM,0),nvl(P_OUT_AM,0))>0 then
			V_LIM_SUM := coalesce(V_LIM_SUM,greatest(nvl(P_IN_AM,0),nvl(P_OUT_AM,0)));
		end if;
		
		V_NAT_CURR_CODE := [FT_MONEY]::[NAT_CUR].nat_code;
		EXCHG_POINT_FILIAL := V_EXCHG_POINT.[FILIAL];
		EXCHG_POINT_DEPART := V_EXCHG_POINT.[DEPART];
	  --P_DATE := ::[BRANCH].[SLIB].sysdate_filial(EXCHG_POINT_FILIAL, EXCHG_POINT_DEPART);	--sysdate;
		V_TIME_UP_FORM := P_DATE;

	--< limit_MES 	  :=coalesce(::[FP_TUNE].[LIB].get_num_value('PSB_LIMIT_MES', 	  ::[FP_TUNE].[LIB].set_canons('METACLASS','KASSA_V')), 12000000);
	    limit_KV 	  :=coalesce(::[FP_TUNE].[LIB].get_num_value('PSB_LIMIT_KV', 	  ::[FP_TUNE].[LIB].set_canons('METACLASS','KASSA_V')), 12000000);
		limit_DAY_EUR :=coalesce(::[FP_TUNE].[LIB].get_num_value('PSB_LIMIT_DAY_EUR', ::[FP_TUNE].[LIB].set_canons('METACLASS','KASSA_V')),  1500000);
		limit_DAY_USD :=coalesce(::[FP_TUNE].[LIB].get_num_value('PSB_LIMIT_DAY_USD', ::[FP_TUNE].[LIB].set_canons('METACLASS','KASSA_V')),  1500000);

	--< &debug('limit_MES='||limit_MES,dp)
		&debug('limit_KV     ='||limit_KV,dp)
	  --&debug('limit_DAY='||limit_DAY,dp)
		&debug('limit_DAY_EUR='||limit_DAY_EUR,dp)
		&debug('limit_DAY_USD='||limit_DAY_USD,dp)
	else
		&debug('p_info='||p_info,dp)
	/** /
	V_CARD_INT := false;
	::[KASSA_V_REF].[CR].CR_VALID(
		null,
		p_message,
		p_info,
		P_TYPE,
		P_NUM,
		P_DATE,
		P_IN_CURR,
		P_IN_AM,
		P_OUT_CURR,
		P_OUT_AM,
		P_RATE,
		P_COLL_EXP_PROPS,
		P_TICKET_DATE,
		P_NOMS,
		P_PAY_DOC_TYPE,
		P_CARD_PROPS,
		P_CUST,
		P_CUST_PROPS,
		P_CUST_DOC_TYPE,
		P_INC_TAX_AM,
		P_INC_TAX_RATE,
		P_CHARGE_CURR,
		P_CHARGE_AM,
		P_BLANK_NUM,
		P_LETTER,
		P_ARR_INKASSO,
		P_TICKET_NUM,
		P_ARR_CHECKS,
		P_PHONE,
		P_PRINCIPAL,
		P_PRIN_DOC_PROPS,
		V_NAT_CURR_CODE,
		V_AVAIL_FIN_TOOLS_STR,
		V_TYPE_CODE,
		V_CB_RATE,
		V_SEL_CUST,
		V_RES_IN_CURR,
		V_RES_IN_AM,
		V_RES_IN_CURR_2,
		V_RES_IN_AM_2,
		V_RES_OUT_CURR,
		V_RES_OUT_AM,
		V_RES_OUT_CURR_2,
		V_RES_OUT_AM_2,
		V_PRINT_RECEIPT,
		V_DOC_TYPE,
		V_AVAIL_OPERS_STR,
		V_PODTV_RATE,
		V_DUMB_CB_RATE,
		V_DUMB_RATE,
		V_DEPOSIT,
		V_MIGR_CARD,
		P_BACK,
		V_DOC_ARR,
		V_DELTA_RATE,
		V_DELTA_RATE_2,
		V_SUSPECT_OPER,
		V_NOMINALS,
		V_PRINT_CHANGES,
		V_G_IN,
		V_G_OUT,
		V_TCD,
		V_ORDER
		);
		
		/**/
		if p_info is not null and V_EXCHG_POINT is null then
			pragma error('Укажите кассу!');
		end if;

		if p_info in ('V_EXCHG_POINT','P_DATE','P_TYPE','P_IN_CURR','P_OUT_CURR','P_IN_AM','P_OUT_AM') then
			InitPCustProps(p_info,this,P_TYPE,P_DATE,P_CUST,P_CUST_PROPS,P_CUST_DOC_TYPE,P_PHONE,
				V_EXCHG_POINT,V_AVAIL_FIN_TOOLS_STR,V_AVAIL_OPERS_STR,
				V_TYPE_CODE,V_NAT_CURR_CODE,
				P_IN_CURR,P_IN_AM,P_OUT_CURR,P_OUT_AM,
				P_RATE,P_PAY_DOC_TYPE,P_BACK,
				V_DUMB_CB_RATE,V_DUMB_RATE,
				V_SOURCE_MONEY_PROVIDED,V_NOTE);
		end if;

		if V_SOURCE_MONEY_PROVIDED and greatest(nvl(P_IN_AM,0),nvl(P_OUT_AM,0))>0 then
			V_LIM_SUM := coalesce(V_LIM_SUM,greatest(nvl(P_IN_AM,0),nvl(P_OUT_AM,0)));
		end if;

		if p_info='%VAR%.V_SEL_CUST' then
			--ClTmp:=coalesce(V_SEL_CUST,this.[CLIENT],ClTmp);
			ClTmp:=coalesce(V_SEL_CUST,this,ClTmp);
			if V_SEL_CUST is not null then
				&debug('V_SEL_CUST.[NAME]='||V_SEL_CUST.[NAME]||' ..[ADD_PROP]%size='||V_SEL_CUST.[ADD_PROP]%size(0)||' P_DATE='||to_char(P_DATE,fmt),dp)
				for ap in V_SEL_CUST.[ADD_PROP] where trunc(ap.[DATE_BEG])=trunc(P_DATE) and ap.[GROUP_PROP].[CODE]='SOURCE_MONEY_PROVIDED' loop
					V_SOURCE_MONEY_PROVIDED:=ap.[BOOL];
					V_NOTE:=ap.[STR];
					&debug('Нашли SOURCE_MONEY_PROVIDED ap.[BOOL]='||ap.[BOOL]||' ap.[STR]='||ap.[STR]||' ap.[OBJ]='||ap.[OBJ],dp)
				end loop;
			end if;
		elsif p_info like '%V_SOURCE_MONEY_PROVIDED' or p_info like '%V_NOTE' or p_info='P_DATE' or p_info like '%V_LIM_SUM' then
			&debug('ClTmp.[NAME]='||ClTmp.[NAME]||' P_DATE='||P_DATE,dp)
			flAdd:=true;
			if ClTmp is not null then
				for ap in ClTmp.[ADD_PROP] where trunc(ap.[DATE_BEG])=trunc(P_DATE) and ap.[GROUP_PROP].[CODE]='SOURCE_MONEY_PROVIDED' loop
					ap.[BOOL]:=V_SOURCE_MONEY_PROVIDED;
					ap.[STR]:=V_NOTE;
					flAdd:=false;
					&debug('Откорректировано доп.свойство Клиента ID: '||ap,dp)
				end loop;
				if flAdd then
					propRef:=ClTmp.[ADD_PROP].[NEW#AUTO](
					 trunc(nvl(P_DATE,stdlib.UserId.[FILIAL].[OP_DATE]))	 --Дата начала действия
					,trunc(nvl(P_DATE,stdlib.UserId.[FILIAL].[OP_DATE]))	 --Дата окончания действия
					,::[PROPERTY_GRP]([CODE]='SOURCE_MONEY_PROVIDED')--Группа свойств
					,null		--Свойство
					,V_NOTE		--Текстовое значение
					,null		--Числовое значение
					,null		--Значение Даты
					,null		--Разрешать пустые значения
					,V_SOURCE_MONEY_PROVIDED --Логическое значение
					,stdlib.UserId%id);--Значение. Ссылка
					&debug('Добавлено доп.свойство Клиента ID: '||propRef,dp)
				end if;
				
				if p_info like '%V_LIM_SUM' then
					flAdd:=true;
					for ap in ClTmp.[ADD_PROP] where trunc(ap.[DATE_BEG])=trunc(P_DATE) and ap.[GROUP_PROP].[CODE]='VOO_SPRAVKA' loop
						ap.[NUM]:=nvl(V_LIM_SUM,0);
						flAdd:=false;
						&debug('Откорректировано доп.свойство Клиента ID: '||ap,dp)
					end loop;
					if flAdd and V_LIM_SUM>0 then
						propRef:=ClTmp.[ADD_PROP].[NEW#AUTO](
						 trunc(nvl(P_DATE,stdlib.UserId.[FILIAL].[OP_DATE]))	 --Дата начала действия
						,trunc(nvl(P_DATE,stdlib.UserId.[FILIAL].[OP_DATE]))	 --Дата окончания действия
						,::[PROPERTY_GRP]([CODE]='VOO_SPRAVKA')--Группа свойств
						,null		--Свойство
						,null		--Текстовое значение
						,V_LIM_SUM	--Числовое значение
						,null		--Значение Даты
						,null		--Разрешать пустые значения
						,null		 --Логическое значение
						,stdlib.UserId%id);--Значение. Ссылка
						&debug('Добавлено доп.свойство Клиента ID: '||propRef,dp)
					end if;
				end if;
			end if;
		end if;
	end if;
end;

execute is
begin
	if V_SOURCE_MONEY_PROVIDED and V_LIM_SUM is not null then
		flAdd:=true;
		ClTmp:=this;
		for ap in ClTmp.[ADD_PROP] where trunc(ap.[DATE_BEG])=trunc(P_DATE) and ap.[GROUP_PROP].[CODE]='VOO_SPRAVKA' loop
			ap.[NUM]:=V_LIM_SUM;
			flAdd:=false;
			&debug('Откорректировано доп.свойство Клиента ID: '||ap,dp)
		end loop;
		if flAdd and V_LIM_SUM>0 then
			propRef:=ClTmp.[ADD_PROP].[NEW#AUTO](
			 trunc(nvl(P_DATE,stdlib.UserId.[FILIAL].[OP_DATE]))	 --Дата начала действия
			,trunc(nvl(P_DATE,stdlib.UserId.[FILIAL].[OP_DATE]))	 --Дата окончания действия
			,::[PROPERTY_GRP]([CODE]='VOO_SPRAVKA')--Группа свойств
			,null		--Свойство
			,null		--Текстовое значение
			,V_LIM_SUM	--Числовое значение
			,null		--Значение Даты
			,null		--Разрешать пустые значения
			,null		 --Логическое значение
			,stdlib.UserId%id);--Значение. Ссылка
			&debug('Добавлено доп.свойство Клиента ID: '||propRef,dp)
		end if;
	end if;

	::[KASSA_V_REF].[PSH_CR_EXT].CheckBLACKLIST(this); --Прогоним Клиента по BLACKLIST	

	::[KASSA_V_REF].[PSH_CR_EXT].CheckLim (this,
	P_OUT_AM,
	P_IN_AM,
	P_TYPE,
	P_CUST_PROPS,
	P_DATE,
	P_RATE,
	P_IN_CURR,
	P_OUT_CURR,
	TruncDateOperKassaV,
	KassaV_FIlial,
	KassaV_NumPoint);

	&debug('Выходим',dp)
end;
end;
end;
