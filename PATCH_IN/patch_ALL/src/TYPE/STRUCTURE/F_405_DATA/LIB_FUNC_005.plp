class F_405_DATA;
@import_plsql(true)
@generate_ansi_joins(true)
@name('Общий функционал')
library LIB_FUNC_005 is

pragma include (::[REPS_DEBUG].[LIB]);
pragma include(::[REPS_DATA].[LIB_VIEW]);
pragma include(::[RUNTIME].[MACRO_LIB]);


pragma macro(lc,		'::[REPS_DATA].[LIB_CLIENT]');
pragma macro(cf,		'::[REPS_COPYFILES].[LIB_CSV]');
pragma macro(lib_type,	'::[REPS_DATA].[LIB_TYPE]');

lvClOrgGr				varchar2(32767); -- шаблон по аналитическому признаку CR_ORG_290FZ
lvFOREIGN_ORG_BR_NAME	varchar2(32767); -- шаблон по аналитическому признаку FOREIGN_ORG_BR_NAME
vTmp1					varchar2(32767);
vTmp2					varchar2(32767);
vTmp3					varchar2(32767);
lrProf					ref [REPS_PROF_TUN];

lcrPP_REPS_CLIENT	const	ref	[PATTERN_PRODUCT] := ::[PATTERN_PRODUCT].[SLIB].get_pp('REPS_CLIENTS');

-- Тип для хранения параметров реализации
public type rec_Param is record
		( rParam		ref [REPS_PARAMS]
		-- Ссылка на реализацию
		, rProf			ref [REPS_PROF_TUN]
		-- Профиль настроек
		, rBranch		ref [BRANCH]
		-- Филиал
		, dBeg				date
		-- Дата начала отчетного периода
		, dEnd				date
		-- Дата окончания отчетного периода
		, vInfo				varchar2(4000)
		-- Доп. параметры расчета
		, bProtocol				boolean
		-- Признак необходимости формирования протокола
		, vProtocolName		varchar2(128)
		-- Имя протокола
		, vProtocolIsklName	varchar2(128)
		-- Имя протокола по исключаемым сделкам
		);

-- Тип для хранения данных для выгрузки в протокол
public type	rec_Protocol is record
		( rTuning		ref [REPS_TUNING]		-- Настройка
		, vProduct			varchar2(100)		-- Продукт
		, dOper				date				-- Дата операции
		, vIDDeal			varchar2(50)		-- ID Сделки
		, nIDSupply			number				-- ID Поставки
		, vCodeDeal			varchar2(20)		-- Номер сделки
		, vCoagent			varchar2(160)		-- Наименование контрагента
		, vRZCoagent		varchar2(1)			-- Резидентность контрагента
		, vInvestor			varchar2(160)		-- Наименование инвестора
		, vRZInvestor		varchar2(1)			-- Резидентность инвестора
		, vBuyerName		varchar2(160)		-- Наименование покупателя
		, vSellerName		varchar2(160)		-- Наименование продавца
		, vEmitent			varchar2(160)		-- Наименование эмитента
		, vRZEmitent		varchar2(1)			-- Резидентность эмитента
		, vKindDeal			varchar2(35)		-- Вид сделки
		, vTypeDeal			varchar2(20)		-- Тип сделки
		, vCBClass			varchar2(30)		-- Класс ЭЦБ
		, vOperCode			varchar2(30)		-- Код операции
		, vPaperCode		varchar2(30)		-- Код инструмента
		, vMarket			varchar2(50)		-- Торговая площадка
		, vCBName			varchar2(100)		-- Наименование ЦБ
		, vCurPay			varchar2(15)		-- Валюта платежа
		, vRegNum			varchar2(35)		-- Регистрационный номер
		, vISIN				varchar2(20)		-- Международный идентификационный код ценной бумаги (ISIN)
		, vRegNumRep		varchar2(35)		-- Код который пошел в отчет
		, dRegCB			date				-- Дата регистрации ЦБ
		, dRegRep			date				-- Дата регистрации ЦБ в отчет
		, vReasonIskl		varchar2(1000)		-- Причина исключения
		, vFilialNum		::[BRANCH].[BANK].[REG_NUM]%type	-- Порядковый номер филиала
		, nSumTotal			number				-- Сумма платежа
		, nSumTotalUsd		number				-- Сумма платежа в $
		, nSumPrc			number				-- Сумма процентов
		, vBal2ACC			varchar2(256)		-- Балансовый счет второго порядка
		);

public	type	arr_Protocol is table of rec_Protocol;

-- Параметры реализации
public grecParam		rec_Param;

-- Разбивка по КВВО
public type map_SumFragment is table of [F_405_SUMS] index by varchar2(128);

-- структура данных по эмитенту
public type rec_IssuerData is record
		(	-- Эмитент
			rIssuer				ref [CLIENT]
		,	-- Наименование эмитента
			vIssuerName			varchar2(32767)
		,	-- Страна эмитента
			rIssuerCountry		ref [COUNTRY]
		,	-- Код страны эмитента
			vIssuerCountryCode	varchar2(128)
		,	-- ИНН эмитента
			vIssuerInn			varchar2(128)
		);

-- кэш данных по эмитенту
public type map_IssuerData is table of rec_IssuerData index by varchar2(128);
lmIssuerData		map_IssuerData;

-- структура для хранения данных интерфейса GetCBData405
public type rec_CBDataInt is record
	(	-- Наименование фин. инструмента
		vFTName			varchar2(100)
		-- Эмитент
	,	recIssuer		rec_IssuerData
		-- класс ЦБ
	,	vFTClass		varchar2(20)
		-- Код ЦБ
	,	vCBCode			varchar2(5)
	,	-- Регистрационный номер ЦБ
		vRegNum			varchar2(30)
		-- Регистрационный номер ISIN
	,	vIsinNum		varchar2(16)
		-- Признак эмиссионной ЦБ
	,	iIsEmission		integer
		--Дата выпуска ЦБ
	,	dDateEmission	date
	,	--Дата погашения ЦБ
		dDateMaturity	date
	,	--Валюта ЦБ
		rCBCur			ref [FT_MONEY]
	);

-- Кэш клиентов с кодом страны из справочника из справочника "ОП Группы клиентов"(REPS_CLIENTS)
-- с индексом [Код группы#CLIENT]
lmRepsClientCodeCountry	&lib_type.map_str;
-- Кэш наименований клиентов с учетом историчности
lmNameClQualHist	&lib_type.map_str;
-- маркер сессии
lvMarker		varchar2(32767)	:= '#';

/**
 * Функция для получения кода для графы 12 по ссылке на клиента
 * 
 * @param P_CLIENT			ссылка на клиента
 * @param P_IS_FIRST_RAZD	принадлежность к первому разделу
 * @return					код для графы 12
 */
public function GetResCode
		(
			P_CLIENT		ref [CLIENT]
		,	P_IS_FIRST_RAZD	boolean := false
		,	P_DATE			date := null
		)
	return					varchar2(128)
is
	-- Информация о клиенте: класс и тип клиента
	recClientInfo	&lc.ClientTypeRec;
	vCode			varchar2(128);
	rHeadBnk		ref [CL_BANK];
	rClient			ref [CLIENT];
	bClPart			boolean := false;
begin
	rClient := P_CLIENT;

	-- Если клиент - участник расчёта, то ищем в участниках расчёта
	if P_CLIENT%class = ::[CL_PART]%class then
		for (
				select	x
					(
						coalesce(
									to_char(x.[BANK_F].[REGISTR_NUM])
								,	x.[REG_NUM]
								)					: C_CODE
					,	x.[BANK]					: C_BANK
					)
				in ::[CL_PART] all
				where	x%id = rClient%id
				fetch 1
			)
		loop
			vCode := x.C_CODE;
			-- клиент - нацбанк - участник расчетов
			bClPart := x.C_BANK is not null;
		end loop;
		--Если клиент - участник расчетов и клиент нацбанка при этом, определяется головная организация ЗА ДАТУ сделки (операции), или за дату начала период расчета
		if bClPart then
			rHeadBnk	:= nvl(::[REPS_INTERFACE].[PRX_CLIENT].getHeadClient(rClient, nvl(P_DATE, grecParam.dBeg) + 1), rClient);
			if rHeadBnk%class = ::[CL_BANK_N]%class then
				vCode := rHeadBnk->(::[CL_BANK_N])[REG_NUM];
			end if;
		end if;
	else
		-- Получение информации по клиенту
		--	Класс (ClClass) может принимать следующие значения:
		--		CL_PRIV 	- Физическое лицо;
		--		CL_ORG 		- Некредитная организация;
		--		CL_BANK_N 	- Российская кредитная организация;
		--		CL_BANK_F 	- Иностранная кредитная организация.
		recClientInfo := &lc.GetClientType(rClient);

		-- Если клиент - нац. банк,
		-- то код равен рег.номеру банка,
		if recClientInfo.ClClass = ::[CL_BANK_N]%class then
			--	Определение головной организации клиента
			rHeadBnk	:= nvl(::[REPS_INTERFACE].[PRX_CLIENT].getHeadClient(rClient, nvl(P_DATE, grecParam.dBeg) + 1), rClient);
			if rHeadBnk is not null and rClient <> rHeadBnk then
				rClient	:= rHeadBnk;
			end if;
			vCode := rClient->(::[CL_BANK_N])[REG_NUM];
		elsif recClientInfo.ClClass = ::[CL_BANK_F]%class then
			vCode := rClient->(::[CL_BANK_F])[REGISTR_NUM];
		-- если клиент - юр.лицо,
		elsif recClientInfo.ClClass = ::[CL_ORG]%class then
			-- то код равен ИНН клиента,
			vCode := &lc.GetClientINN(rClient);
		-- если клиент - физ. лицо,
		else
			-- если первый раздел
			if P_IS_FIRST_RAZD then
				-- то заполняется рег.номером клиента
				vCode := to_char(rClient.[REGISTR_NUM]);
			else
				-- иначе не заполняется
				vCode := null;
			end if;
		end if;
	end if;
	-- возвращаем регистрационный номер или ИНН клиента
	return vCode;
end;


/**
 * Предварительное заполнение таблицы со списком видов валютных операций
 *
 * @param	P_TAB_SF			- массив с Разбивкой по КВВО
 * @param	P_DOC				- id документа
 * @param	P_DOC_CURR_OPER		- Вид валютной операции
 * @param	P_DOC_SUM			- Сумма по дебету
 * @param	P_DOC_SUM_PO		- Сумма по кредиту
 *
 * @return	- массив с Разбивкой по КВВО
 */
public function FillSumFragment
		(
			P_TAB_SF			map_SumFragment
		,	P_DOC				ref [MAIN_DOCUM]
		,	P_DOC_CURR_OPER		ref [CURR_OPERATION]
		,	P_DOC_SUM			number
		,	P_DOC_SUM_PO		number
		)
	return	map_SumFragment
is
	mSumFragment	map_SumFragment;
	bIsFound		boolean := false;

	procedure AddSum
		(
			P_OPER ref [CURR_OPERATION]
		,	P_SUM number
		)
	is
		recSumFragment	[F_405_SUMS];
		vIdx			varchar2(128);
	begin
		if nvl(P_SUM, 0) = 0 then
			return;
		end if;

		vIdx := nvl(to_char(P_OPER), 'EMPTY_OPER');
		if mSumFragment.exists(vIdx) then
			recSumFragment			:= mSumFragment(vIdx);
			recSumFragment.[SUMMA]	:= recSumFragment.[SUMMA] + P_SUM;
		else
			recSumFragment					:= null;
			recSumFragment.[CUR_OPER_REF]	:= P_OPER;	-- Вид валютной операции
			recSumFragment.[SUMMA]			:= P_SUM;	-- Сумма
		end if;
		mSumFragment(vIdx) := recSumFragment;
	end;
begin
	mSumFragment := P_TAB_SF;

	&debug_output('+ Определение видов валютных операций для документа ID:[' || to_char(P_DOC) || '], '
				|| 'вид операции с документа: "' || P_DOC_CURR_OPER.[CODE] || '", '
				|| 'сумма документа ДТ: [' || P_DOC_SUM || '], '
				|| 'сумма документа КТ: [' || P_DOC_SUM_PO || '], '
				|| 'собрано ВВО: ' || mSumFragment.count, 10);

	-- Выполняем поиск связи платежного документа с БДВО
	for (
			select	b
				(	b							: ID
				,	b.[CONTRACTS]				: C_CONTRACTS
				,	case
						when b.[PAYMENT_TYPE] = 1
						then P_DOC_SUM_PO
						else P_DOC_SUM
					end							: C_DOC_SUM
				)
			in	::[BASE_VAL_OP] all
			where	b.[DOC] = P_DOC
			order by b%id desc
			fetch 1
		)
	loop
		&debug_output('Найдена связь документа с БДВО ID:[' || to_char(b.ID) || '], '
					|| 'массив контрактов: [' || to_char(b.C_CONTRACTS) || '], '
					|| 'вид операции с документа: "' || P_DOC_CURR_OPER.[CODE] || '", '
					|| 'сумма документа с учетом направления платежа: [' || b.C_DOC_SUM || ']', 10);
		
		-- Если массив контрактов на БДВО заполнен, то информации о КВВО берется из него
		for	(
				select cntr
					(	cntr.[CURR_OPER]			: C_CURR_OPER
					,	cntr.[SUMMA]				: C_SUMMA
					,	cntr.[CURR_OPER].[CODE]		: C_CURR_OPER_CODE
					)
				in b.C_CONTRACTS
				where	coalesce(cntr.[SUMMA], 0) > 0
					and	cntr.[CURR_OPER] is not null
			)
		loop
			&debug_output('	Данные из массива контрактов БДВО: вид операции: "' || cntr.C_CURR_OPER_CODE || '", '
						|| 'сумма: [' || cntr.[C_SUMMA] || ']', 10);

			-- Найдены записи в массиве контрактов
			bIsFound := true;

			-- Добавление операции с суммой
			AddSum(cntr.C_CURR_OPER, cntr.C_SUMMA);
		end loop;

		-- В случае, если массив контрактов пустой и вид валютной операции заполнен на документе
		if not bIsFound and P_DOC_CURR_OPER is not null then
			&debug_output('Массив контрактов пустой, добавлена запись с информацией с документа: '
						|| 'вид операции: "' || P_DOC_CURR_OPER.[CODE] || '", '
						|| 'сумма: [' || b.C_DOC_SUM || ']', 10);

			-- Добавление операции с суммой
			AddSum(P_DOC_CURR_OPER, b.C_DOC_SUM);
			-- В БВДО была найдена информация
			bIsFound := true;
		end if;

		exit;
	end loop;

	-- Если в БДВО не было найдено информации и вид валютной операции заполнен на документе, берем ее с платежного документа
	if	not bIsFound
	and	P_DOC_CURR_OPER is not null
	then
		&debug_output('В БДВО не было найдено информации о документе, добавлена запись с информацией с документа: '
					|| 'вид операции: "' || P_DOC_CURR_OPER.[CODE] || '", '
					|| 'сумма: [' || P_DOC_SUM || ']', 10);

		-- Добавление операции с суммой
		AddSum(P_DOC_CURR_OPER, P_DOC_SUM);
	end if;
	&debug_output('- Всего собрано ВВО: ' || mSumFragment.count, 10);

	return mSumFragment;
end;

/**
 * Сопоставление разбиваемой суммы со сделки и собранной информации по КВВО
 *
 * @param	P_TAB_SF		- массив с Разбивкой по КВВО
 * @param	P_SUM_PAY		- Сумма
 * @param	P_AMMOUNT		- Количество по агенту
 *
 *	@return	- массив с Разбивкой по КВВО
 */
public function EquateSumFragment
		(
			P_TAB_SF	map_SumFragment
		,	P_SUM_PAY	number
		,	P_AMMOUNT	number
		)
	return map_SumFragment
is
	recSumFragment	[F_405_SUMS];
	mSumFragment	map_SumFragment;
	nSumTotal		number;
	nRatio			number;
	nRndErrSum		number;
	nRndErrQua		number;
	nMaxSum			number;
	vMaxIdx			varchar2(128);
	vIdx			varchar2(128);
begin
	mSumFragment := P_TAB_SF;
	-- Если таблица с КВВО не заполнена, либо сумма для разбивки нулевая
	if		mSumFragment.count = 0
		or	nvl(P_SUM_PAY, 0) = 0
	then
		return mSumFragment;
	end if;
	&debug_output('+ Выравнивание собранного списка валютных операций, всего: ' || mSumFragment.count || ', '
				|| 'сумма для разбиения: [' || P_SUM_PAY || '], '
				|| 'количество для разбиения: [' || P_AMMOUNT || ']', 10);

	-- Если только одна запись
	if mSumFragment.count = 1 then
		vIdx := mSumFragment.first;
		recSumFragment := mSumFragment(vIdx);
		recSumFragment.[SUMMA]	:= round(P_SUM_PAY, 2);
		recSumFragment.[QUANTITY] := P_AMMOUNT;
		mSumFragment(vIdx) := recSumFragment;
		&debug_output('	 Одна запись в списке валютных операций, количество = ' || recSumFragment.[QUANTITY] || ' '
					|| 'сумма=' || recSumFragment.[SUMMA],10);
	-- Если несколько записей
	else
		nSumTotal := 0;
		-- Подсчет общей суммы по всем собранным записям
		vIdx := mSumFragment.first;
		while vIdx is not null
		loop
			nSumTotal := nSumTotal + nvl(mSumFragment(vIdx).[SUMMA], 0);
			vIdx := mSumFragment.next(vIdx);
		end loop;

		&debug_output('	Количество записей в списке валютных операций ' || mSumFragment.count || '. '
					|| 'Общая сумма по всем записям: [' || nSumTotal || ']', 10);

		-- Если сумма для разбивки превышает общую сумму по КВВО
		if P_SUM_PAY > nSumTotal then
			vIdx := 'EMPTY_OPER';
			if not mSumFragment.exists(vIdx) then
				mSumFragment(vIdx).[SUMMA] := 0;
			end if;
			mSumFragment(vIdx).[SUMMA] := mSumFragment(vIdx).[SUMMA] + (P_SUM_PAY - nSumTotal);

			-- Теперь общая сумма по массиву равна сумме для разбивки
			nSumTotal := P_SUM_PAY;
			&debug_output('	Добавлена недостающая разница к записи с незаполненной операцией, '
						|| 'общая сумма по всем записям: [' || nSumTotal || ']', 10);
		end if;

		&debug_output('	Распределение суммы [' || P_SUM_PAY || '] и количества [' || P_AMMOUNT || '] для разбивки по списку КВВО >>', 10);
		-- Выполняем распределение суммы и количества
		vIdx := mSumFragment.first;
		while vIdx is not null
		loop
			recSumFragment := mSumFragment(vIdx);
			-- Определяем долю, приходящуюся на текущую запись
			if nSumTotal <> 0 then
				nRatio := recSumFragment.[SUMMA] / nSumTotal;
			else
				nRatio := 1 / mSumFragment.count;
			end if;

			&debug_output('	Запись [' || vIdx || '] '
						|| 'сумма исходная: [' || recSumFragment.[SUMMA] || '], '
						|| 'операция: "' || recSumFragment.[CUR_OPER_REF].[CODE] || '", '
						|| 'доля: [' || nRatio || ']', 10);

			-- Если общая сумма по разбивке превышает сумму на сделке, то будем распределять сумму на сделке пропорционально
			if nSumTotal > P_SUM_PAY then
				recSumFragment.[SUMMA] := round(P_SUM_PAY * nRatio, 2);
			else
				recSumFragment.[SUMMA] := round(recSumFragment.[SUMMA], 2);
			end if;

			-- Количество также распределяем пропорционально
			recSumFragment.[QUANTITY] := round(P_AMMOUNT * nRatio);

			&debug_output('	Скорректированная сумма: [' || recSumFragment.[SUMMA] || '], '
						|| 'количество, приходящееся на эту запись: [' || recSumFragment.[QUANTITY] || ']', 10);

			-- Подсчитываем ошибку округления, в итоге сумма всех записей массива должна сходится с суммой для разбивки
			nRndErrSum := nvl(nRndErrSum, P_SUM_PAY) - recSumFragment.[SUMMA];
			nRndErrQua := nvl(nRndErrQua, P_AMMOUNT) - recSumFragment.[QUANTITY];

			if	nMaxSum is null
			or	recSumFragment.[SUMMA] > nMaxSum
			then
				nMaxSum := recSumFragment.[SUMMA];
				vMaxIdx	:= vIdx;
			end if;

			mSumFragment(vIdx) := recSumFragment;
			vIdx := mSumFragment.next(vIdx);
		end loop;

		-- Если после распределения сформировалась ошибка округления, скидываем ее на запись с максимальной суммой
		if	nvl(nRndErrSum, 0) <> 0
		or	nvl(nRndErrQua, 0) <> 0
		and	mSumFragment.exists(vMaxIdx)
		then
			recSumFragment := mSumFragment(vMaxIdx);
			recSumFragment.[SUMMA]	:= recSumFragment.[SUMMA]		+ nvl(nRndErrSum, 0);
			recSumFragment.[QUANTITY] := recSumFragment.[QUANTITY]	+ nvl(nRndErrQua, 0);
			mSumFragment(vMaxIdx) := recSumFragment;
			
			&debug_output('	Ошибка округления учтена на записи [' || vMaxIdx || '], '
						|| 'получившаяся сумма: [' || recSumFragment.[SUMMA] || '], '
						|| 'количество: [' || recSumFragment.[QUANTITY] || ']', 10);
		end if;
	end if;

	&debug_output('- Выполнено выравнивание списка КВВО', 10);

	return mSumFragment;
end;


/**
 * Инициализация протокола расчета
 * 
 */
procedure InitProtocol
is
	vTmp		varchar2(4000);
begin
	if grecParam.bProtocol then
		-- Протокол по включенным сделкам
		&debug_output('>>> Инициализация протокола расчета', 1);
		&cf.set_column('PART'		, 10, 'C', null	, 'Раздел');
		&cf.set_column('TUNING'		, 10, 'C', null	, 'Подраздел');
		&cf.set_column('PRODUCT'	, 30, 'C', null	, 'Продукт');
		&cf.set_column('DATE'		, 15, 'C', null	, 'Дата операции');
		&cf.set_column('ID_DEAL'	, 30, 'C', null	, 'ID сделки');
		&cf.set_column('DEAL_CODE'	, 30, 'C', null	, 'Код сделки');
		&cf.set_column('ID_SUPPLY'	, 30, 'C', null	, 'ID поставки');
		&cf.set_column('COAGENT'	, 30, 'C', null	, 'Контрагент');
		&cf.set_column('RZ_COAGENT'	, 30, 'C', null	, 'Резидентность контрагента');
		&cf.set_column('INVESTOR'	, 30, 'C', null	, 'Инвестор');
		&cf.set_column('RZ_INVESTOR', 30, 'C', null	, 'Резидентность инвестора');
		&cf.set_column('EMITENT'	, 30, 'C', null	, 'Эмитент');
		&cf.set_column('RZ_EMITENT'	, 30, 'C', null	, 'Резидентность эмитента');
		&cf.set_column('BUYER'		, 30, 'C', null	, 'Покупатель');
		&cf.set_column('SELLER'		, 30, 'C', null	, 'Продавец');
		&cf.set_column('KIND_DEAL'	, 30, 'C', null	, 'Вид сделки');
		&cf.set_column('TYPE_DEAL'	, 30, 'C', null	, 'Тип сделки');
		&cf.set_column('SUM_TOTAL'	, 22, 'N', 2	, 'Сумма платежа');
		&cf.set_column('SUM_PRC'	, 22, 'N', 2	, 'Сумма процентов');
		&cf.set_column('CLASS_CB'	, 30, 'C', null	, 'Класс ЭЦБ');
		&cf.set_column('KOD_CB'		, 15, 'C', null	, 'Код инструмента');
		&cf.set_column('KOD_OPER'	, 17, 'C', null	, 'Код вида операции');
		&cf.set_column('MARKET'		, 30, 'C', null	, 'Торговая площадка');
		&cf.set_column('CB'			, 30, 'C', null	, 'ЦБ');
		&cf.set_column('CURRENCY'	, 30, 'C', null	, 'Валюта платежа');
		&cf.set_column('REG_NUM'	, 30, 'C', null	, 'Рег. № ЦБ');
		&cf.set_column('ISIN'		, 30, 'C', null	, 'ISIN ЦБ');
		&cf.set_column('REG_NUM_REP', 30, 'C', null	, 'Рег. № ЦБ в отчет');
		&cf.set_column('DATE_REG'	, 15, 'C', null	, 'Дата регистрации ЦБ');
		&cf.set_column('DATE_RG_RP'	, 15, 'C', null	, 'Дата регистрации ЦБ отчет');
		&cf.set_column('FILIAL_NUM'	, 15, 'C', null	, 'Номер филиала');
		&cf.set_column('BAL2ACC'	, 10, 'C', null	, 'Балансовый счет 2-го порядка');
		
		vTmp := &cf.fcreate
					( p_file_name	== grecParam.vProtocolName
