class AC_FIN;

@name('[ПСБ] Библиотека для кураторов')
library PSH_L_LOAN_INSP is
public v_d_start date;
public v_d_stop  date;
public v_period  number;

--pragma restrict_references(GetDocAllSum,wnds,wnps,trust);

dp number:=null;	--управление debug_pipe
fmt string:='dd/mm/yyyy';
ft_usd ref [FT_MONEY];

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

-- используется в представлении для коклонки "Среднедневной остаток Валюта"
public function get_avg_saldo_v(acc ref [ac_fin]) return number is 
	ret number;
	d_cur date;
	cntr number;
	accu number;
begin
	if v_d_start is null then
		pragma error('Пустая дата начала');
	end if;
	if v_d_start is null then
		pragma error('Пустая дата конца');
	end if;
	if v_d_start > v_d_stop then
		pragma error('Дата начала не может быть больше даты конца');
	end if;

	d_cur := v_d_start;
	cntr := 0;
	accu := 0;
	while d_cur <= v_d_stop loop
		if cntr = 0 then
			--accu := (accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur+1),0))/2;
		--	accu := (accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur+1),0));
		accu := (accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur),0));
		else
		--	accu := accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur+1),0);
		accu := accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur),0);
		end if;	
		cntr := cntr + 1;		
		d_cur := d_cur + 1;	
	end loop;

	ret := accu / v_period;
	
	return ret;
end;
pragma restrict_references(get_avg_saldo_v,wnds,wnps,trust);

public function get_avg_saldo_d(acc ref [ac_fin]) return number is 
	ret number;
	d_cur date;
	cntr number;
	accu number;
	ft_acc ref [FT_MONEY];
begin
	if v_d_start is null then
		pragma error('Пустая дата начала');
	end if;
	if v_d_start is null then
		pragma error('Пустая дата конца');
	end if;
	if v_d_start > v_d_stop then
		pragma error('Дата начала не может быть больше даты конца');
	end if;

	ft_acc := acc.[FINTOOL];
	
	d_cur := v_d_start;
	cntr := 0;
	accu := 0;
	while d_cur <= v_d_stop loop
		accu := accu +
		::[DOCUMENT].[LIB_CUR].Cur2Cur(
			nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur+1),0),
			ft_acc,
			ft_usd,
			d_cur	);
		cntr := cntr + 1;		
		d_cur := d_cur + 1;	
	end loop;

	ret := accu / v_period;
	
	return ret;
end;
pragma restrict_references(get_avg_saldo_d,wnds,wnps,trust);

