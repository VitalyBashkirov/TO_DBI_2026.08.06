class CL_CORP;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Отчет аудиторам (Word)')
method PSH_AUD_REP is
pragma macro(wd,'[OOXML]::[API_DOC_SAX]');
pragma include (::[PROPERTY_FT].[FT_DEF]);


-- Процедура вывода в отчёт данных по депозиту
procedure dep_prn(dep ref [DEPN]
				, P_DATE_DEP_BEG date		-- Дата начала депозита/пролонгации
				, P_DATE_DEP_END date		-- Дата окончания депозита/пролонгации
				, P_SUMMA_DOG	[SUMMA]		-- Сумма договора/пролонгации
				, P_SUMMA_PRC	[SUMMA]		-- Сумма процентов подлежащих выплате/уже выплаченных
				, P_DATA in out [MEMO_32767]
				, P_DATE_END date			-- Дата окончания в отчёте
				)
is
	PrcSch		[REF_PRC_SCH];
	Prc			[PERCENT];
	acc		ref	[AC_FIN];
begin
	acc	:= dep.[GET_ACC]('D_ACCOUNT', P_DATE_DEP_BEG);
	PrcSch := dep.[PRC_DOG];
	Prc := null;
	-- Находим значение процентной ставки на дату окончания отчёта из процентной схемы
	if PrcSch is not null then
		Prc := ::[PRC_SCHEME].[LIB].GetPrcRate(PrcSch, P_DATE_DEP_END);
	end if;
						
	P_DATA := 'Номер счета: ' || acc.[MAIN_V_ID] || LF$ ;
	P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Валюта счета: '|| dep.[ACCOUNT].[FINTOOL].[NAME] || LF$;
	--P_DATA := P_DATA ||| CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Сумма ' || trim(to_char(P_SUMMA_DOG,'999,999,999,999,990.00')) || LF$;
	P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Остаток средств на счете: ' || trim(to_char(abs(F.A('И' ||dep.[ACCOUNT]|| 'с', P_DATE_END + 1)),'999,999,999,990.00')) || LF$;	
	P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Дата размещения: ' || to_char(P_DATE_DEP_BEG,'dd.mm.yyyy') || LF$;
	P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Дата возврата: ' || to_char(P_DATE_DEP_END,'dd.mm.yyyy') || LF$;
	P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Процентная ставка: ' || trim(to_char(coalesce(Prc, 0) ,'990.00')) || '%' || LF$;
	P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Проценты, подлежащие выплате Компании на ' || to_char(P_DATE_END,'dd.mm.yyyy') || CHR(9) || trim(to_char(P_SUMMA_PRC,'999,999,999,999,990.00')) || LF$;
	P_DATA := P_DATA || LF$;
end;


procedure PutData (P_ORG ref [CL_CORP], P_DATE_BEG date, P_DATE_END date, P_USER ref [USER])
is
	 v_tf_field constant.MEMO_TABLE_S;
	 v_fld_name varchar2(4000);	
	 temp 		varchar2(1000);
	 flag		number;
	 s 			[MEMO_32767] := 'Расчетные счет в рублях (включая счета с нулевыми остатками):';
	 P_DATA		[MEMO_32767] := '';
	 P_SUMMA	[SUMMA];
	 P_SUMMA_PRC	[SUMMA];
	 prol_first		boolean;
	 date_prol		date;
	 Date_dep		[DATE];
	 last_id		number	:= 0;
	 P_PRC			[PERCENT];
	 rScheme 		ref [PRC_SCHEME];
begin
	-- проход по полям типа TextFields
	v_tf_field.delete;
	v_tf_field := &wd.GetTextFields;
	v_fld_name := v_tf_field.First;
	loop
		exit when v_fld_name is null;

		if v_fld_name = 'ДАТА_В_ШАПКЕ' then
            v_tf_field(v_fld_name) := ::[RUNTIME].[FDP].pdat_(P_DATE_END);
		elsif v_fld_name = 'ДАТА' then
            v_tf_field(v_fld_name) := to_char(sysdate, 'DD.MM.YYYY');
        elsif v_fld_name = 'НА_ДАТУ' then
			v_tf_field(v_fld_name) := ::[RUNTIME].[FDP].pdat_(P_DATE_END);

        elsif v_fld_name in ('BANK', 'BANK1') then
            v_tf_field(v_fld_name) :=  ::[SYSTEM].[VARIABLES].OurBank.[NAME];
        elsif v_fld_name = 'ФИО_РУК' then
			v_tf_field(v_fld_name) := P_USER.[CL_PRIV_REF].[FAMILY_CL] || ' ' || substr(P_USER.[CL_PRIV_REF].[NAME_CL],1,1) || '. ' || substr(P_USER.[CL_PRIV_REF].[SNAME_CL],1,1) || '.';
        elsif v_fld_name = 'ДОЛЖ_РУК' then
			v_tf_field(v_fld_name) := P_USER.[CASTA].[VALUE];

        elsif v_fld_name = 'ИНН' then
            v_tf_field(v_fld_name) :=  P_ORG.[INN];
        elsif v_fld_name in ('НАИМ_КЛИЕНТА', 'НАИМ_КЛИЕНТА1') then
			v_tf_field(v_fld_name) := P_ORG.[NAME];

	 	elsif v_fld_name = 'ОРГ_РУК' then
			flag := 0;
			for (select p(p obj)  
				in P_ORG.[ALL_BOSS]
				where p.[CHIEF] = true
						and (p.[WORK_BEGIN] <= P_DATE_END) 
						and (p.[WORK_END] is null or p.[WORK_END] >= P_DATE_BEG)
					order by case when coalesce(upper(p.[RANGE].[VALUE]), '1') like '%ГЕНЕР%' or coalesce(upper(p.[RANGE].[VALUE]), '1') like '%ДИРЕК%' then 1
							 	  else 2
					     	 end
					fetch 1
		     	)
			loop
					P_DATA := p.obj.[FASE].[NAME] || '      ' || p.obj.[RANGE].[VALUE];
					flag := 1;
			end loop;
			if flag = 0 then
				P_DATA := 'Отстутствует действующий руководитель';
			end if;
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

		-- РКО -------------------------------------------------------------------------------------------------------------------------------
		elsif v_fld_name = 'РКО' then
			P_DATA := '';
			flag := 0;
			for a in ::[AC_FIN]
			where (a.[CLIENT_R] = P_ORG or a.[CLIENT_V] = P_ORG)
				and substr(a.[MAIN_V_ID],1,3) in ('407','408')
				and (a.[DATE_OP]    <= P_DATE_END or a.[DATE_OP] is null)
				and (a.[DATE_CLOSE] > P_DATE_END or a.[DATE_CLOSE] is null)
				order by a.[TARGET].[CODE], a%id
			loop
					if a.[TARGET].[CODE]='RKO' then
						s := 'Расчетный счет в рублях:';
					elsif a.[TARGET].[CODE]='RKO_CUR' then
						s := 'Текущий счет в иностранных валютах:';
					elsif a.[TARGET].[CODE]='RKO_CUR_LOCK' then
						s := 'Транзитный счет в иностранных валютах:';
					end if;
					P_DATA := P_DATA || s || LF$;
					P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Номер счета: ' || a.[MAIN_V_ID] || LF$;
					P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Валюта счета: '|| a.[FINTOOL].[NAME] || LF$;
					P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Остаток средств на счете: ' || trim(to_char(abs(F.A('И' ||a|| 'с', P_DATE_END + 1)),'999,999,999,990.00')) || LF$ || LF$;
					flag := 1;
			end loop;
			if flag = 0 then
				P_DATA := P_DATA || 'За период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' открытые счета РКО отсутствуют' || LF$;			end if;
            v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

        -- Проценты по РКО ---------------------------------------------------------------------------------------------------------------------
        elsif v_fld_name = 'RKO_PRC' then
 	
			P_DATA := '';

			flag := 0;
			for rko in ::[RKO]
			where rko.[CLIENT] = P_ORG
				and coalesce(rko.[DATE_BEGIN],rko.[DATE_BEGINING]) <= P_DATE_END
				and (coalesce(rko.[DATE_CLOSE],rko.[DATE_ENDING])  > P_DATE_BEG or rko.[DATE_CLOSE] is null)
			loop
				P_DATA := P_DATA || 'Номер счета: ' || rko.[ACCOUNT].[MAIN_V_ID] || LF$;
				P_SUMMA_PRC := 0;

				-- По журналу начисленных %%
				select jour (sum(coalesce(jour.[SUMMA_PRC_ROUND], 0))) in rko.[JOUR_CALC_PRC]
					  where jour.[DATE_BEG] >= P_DATE_BEG and jour.[DATE_END] <= P_DATE_END
							into P_SUMMA_PRC;

				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9)|| 'Валюта счета: '|| rko.[ACCOUNT].[FINTOOL].[NAME] || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9)|| 'Сумма: ' || to_char(coalesce(round(P_SUMMA_PRC, 2), 0),'999,999,999,990.00') || LF$ || LF$;
				flag := 1;
			end loop;

			if flag = 0 then
				P_DATA := 'Счетов нет.' || LF$;
			end if;
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

        -- Депозиты ----------------------------------------------------------------------------------------------------------------------------
        elsif v_fld_name = 'DEPN' then
			P_DATA := '';
			flag := 0;
			-- Ищем действующие депозиты юр.лиц
			for dep in ::[DEPOSIT_ORG]
			where dep.[CLIENT] = P_ORG
				and (   (dep.[DATE_BEGIN] <= P_DATE_END and (dep.[DATE_ENDING] > P_DATE_BEG or dep.[DATE_ENDING] is null)) 
					 or (dep.[DATE_BEGIN] < P_DATE_END  and (dep.[DATE_ENDING] >= P_DATE_BEG or dep.[DATE_ENDING] is null))
					)
				/*and (
						   (P_DATE_BEG is null and (dep.[DATE_CLOSE] is null or dep.[DATE_CLOSE] > P_DATE_END))
						or (P_DATE_BEG is not null and dep.[DATE_BEGIN] >= P_DATE_BEG)
					)*/
				and dep.[LIST_PAY]%size(1) > 0
				and dep > last_id
			order by dep
			loop
				date_prol := null;
				prol_first := true;
				P_SUMMA_PRC := 0;
				
				if CALENDAR.Check_Date('HOLIDAYS', P_DATE_END) = '1' then
					Date_dep := CALENDAR.Next_Date('HOLIDAYS','0',P_DATE_END,-1);
				else
					Date_dep := P_DATE_END;
				end if;
				
				if dep.[LIST_PROL]%size(1) > 0 then
				-- Пролонгации есть, идём по ним	
					for prol in dep.[LIST_PROL]
						where prol.[PROL_END] <> prol.[LAST_DATE_ENDING]
						order by prol.[PROL_BEGIN]
					loop
						-- Для первой пролонгации
						if prol_first then
							if (dep.[DATE_BEGIN] <= P_DATE_END and prol.[LAST_DATE_ENDING] > P_DATE_BEG) or (dep.[DATE_BEGIN] < P_DATE_END and prol.[LAST_DATE_ENDING] >= P_DATE_BEG) then
								P_SUMMA_PRC := ::[DEPN].[LIB_01].GetSummDebt(dep, ::[VID_DEBT](CODE = 'LAST_PRC'), least(prol.[LAST_DATE_ENDING], Date_dep));											
								dep_prn(dep, dep.[DATE_BEGIN], prol.[LAST_DATE_ENDING], prol.[PREV_SUMMA], P_SUMMA_PRC, P_DATA, least(prol.[LAST_DATE_ENDING], Date_dep));
							end if;
						else
						-- Для остальных пролонгаций	
							if (date_prol <= P_DATE_END and prol.[LAST_DATE_ENDING] > P_DATE_BEG) or (date_prol < P_DATE_END and prol.[LAST_DATE_ENDING] >= P_DATE_BEG) then
								P_SUMMA_PRC := ::[DEPN].[LIB_01].GetSummDebt(dep, ::[VID_DEBT](CODE = 'LAST_PRC'), least(prol.[LAST_DATE_ENDING], Date_dep)) -
											   	   ::[DEPN].[LIB_01].GetSummDebt(dep, ::[VID_DEBT](CODE = 'LAST_PRC'), date_prol);
								dep_prn(dep, date_prol, prol.[LAST_DATE_ENDING], prol.[PREV_SUMMA], P_SUMMA_PRC, P_DATA, least(prol.[LAST_DATE_ENDING], Date_dep));						
							end if;
						end if;
						date_prol := prol.[LAST_DATE_ENDING];
						prol_first := false;						
					end loop;
					-- Для последней пролонгации
					if (date_prol <= P_DATE_END and dep.[DATE_ENDING] > P_DATE_BEG) or (date_prol < P_DATE_END and dep.[DATE_ENDING] >= P_DATE_BEG) then
						P_SUMMA_PRC := ::[DEPN].[LIB_01].GetSummDebt(dep, ::[VID_DEBT](CODE = 'LAST_PRC'), least(dep.[DATE_ENDING], Date_dep)) -
									   	   ::[DEPN].[LIB_01].GetSummDebt(dep, ::[VID_DEBT](CODE = 'LAST_PRC'), date_prol);
						dep_prn(dep, date_prol, dep.[DATE_ENDING], dep.[SUMMA_DOG], P_SUMMA_PRC, P_DATA, least(dep.[DATE_ENDING], Date_dep));
					end if;
					
				-- Массив пролонгаций пустой поэтому выводим одну строку по всему депозиту
				else
					P_SUMMA_PRC := ::[DEPN].[LIB_01].GetSummDebt(dep, ::[VID_DEBT](CODE = 'LAST_PRC'), least(dep.[DATE_ENDING], Date_dep));				
					dep_prn(dep, dep.[DATE_BEGIN], dep.[DATE_ENDING], dep.[SUMMA_DOG], P_SUMMA_PRC, P_DATA, least(dep.[DATE_ENDING], Date_dep));
				end if;

				last_id := dep;
				
				if length(P_DATA) > 30000 then
					exit;
				end if;
			end loop;
			
			-- Если депозитов нет
			if last_id = 0 and P_DATE_BEG is null then
				P_DATA := P_DATA || 'На ' || to_char(P_DATE_END,'dd.mm.yyyy') || ' действующие депозиты отсутствуют' || LF$;
			elsif last_id = 0 and P_DATE_BEG is not null then
				P_DATA := P_DATA || 'За период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' действующие депозиты отсутствуют' || LF$;
			end if;
			
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');
		
		-- Кредиты ---------------------------------------------------------------------
        elsif v_fld_name = 'CRED' then

			P_DATA := '';
			flag := 0;

			for cred in ::[KRED_CORP]
			where cred.[CLIENT] = P_ORG
				and (  (cred.[DATE_BEGIN] <= P_DATE_END and cred.[DATE_ENDING] > P_DATE_BEG) 
					or (cred.[DATE_BEGIN] < P_DATE_END and cred.[DATE_ENDING] >= P_DATE_BEG))
				and cred.[LIST_PAY]%size(1) > 0
			loop
				P_PRC := 0;
				P_SUMMA := 0;
				P_SUMMA_PRC := 0;
				
				-- Находим общую сумму погашенных процентов
				for (select fo (SUM(fo.[SUMMA]) summ) in cred.[LIST_PAY]
						where 	fo.[DATE] >= P_DATE_BEG
								and fo.[DATE] <= P_DATE_END
								and fo.[OPER].[CODE] in ('ГАШЕН_ЗАДОЛЖ_ПР', 'ГАШЕН_ЗАДОЛЖ_ПР_112', 'ГАШЕН_ЗАДОЛЖ_ПР_112_ВБ', 'ГАШЕН_ПРОСР_ВНЕБ', 'ГАШЕНИЕ_ПРОЦ',
								                         'ГАШ_ПРЦ_КР_112','ГАШ_ВНВ_ПРЦ_112', 'ГАШЕН_ВНЕБ_ПРОЦ', 'ГАШЕН_УЧТЕН_ПРОЦ', 'ГАШ_УЧТ_ПРЦ_112')
					)
				loop
					P_SUMMA_PRC := coalesce(fo.summ, 0);
				end loop;

				-- Общая сумма задолженности по процентам на окончание периода
				P_SUMMA := coalesce(::[PR_CRED].[L].GetAmount(cred, 'ИТОГО_ПРОЦЕНТЫ', P_DATE_END) +
									::[PR_CRED].[L].GetAmount(cred, 'ИТОГО_ПРОЦЕНТЫ_112', P_DATE_END), 0);
				
				-- Процентная ставка
				rScheme := cred->[NEW_DOG_LIB].Find_Scheme(cred.[COMISS_ARR], ::[VID_DEBT](CODE = 'НЕУЧТЕН_ПРОЦЕНТЫ'));
				if not rScheme is null then
					P_PRC := coalesce(::[PRC_SCHEME].[LIB].GetPrcRate(rScheme, P_DATE_END), 0);
				end if;

				P_DATA := P_DATA || 'Номер счета: ' || cred.[ACCOUNT].[MAIN_V_ID] || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Валюта счета: ' || cred.[ACCOUNT].[FINTOOL].[NAME] || LF$;
				s := 'на ' || to_char(P_DATE_END,'dd.mm.yyyy');
				--P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Сумма к оплате ' || rpad(s,36)|| CHR(9) || CHR(9) || trim(to_char(cred->[L].GetAmount(cred, 'ОСТАТОК_ФАКТ', P_DATE_END, null, P_DATE_END),'999,999,999,990.00')) || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Остаток средств на счете: ' || trim(to_char(abs(F.A('И' ||cred.[ACCOUNT]|| 'с', P_DATE_END + 1)),'999,999,999,990.00')) || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Процентная ставка: ' || trim(to_char(coalesce(P_PRC, 0) ,'990.00')) || '%' || LF$;
				--P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Дата выдачи кредита: '|| to_char(cred.[DATE_BEGIN],'dd.mm.yyyy') || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Срок погашения ссуды: ' || to_char(cred.[DATE_ENDING],'dd.mm.yyyy') || LF$ || LF$;				
				/*P_DATA := P_DATA || 'Проценты, уплаченные'|| LF$;
				if P_DATE_BEG is null then
					P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'на '||to_char(P_DATE_END,'dd.mm.yyyy') || CHR(9) || trim(to_char(P_SUMMA_PRC ,'999,999,999,999,990.00')) || LF$ || LF$;
				else
					P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || ' за период с ' || to_char(greatest(P_DATE_BEG, cred.[DATE_BEGIN]),'dd.mm.yyyy') || ' по ' || to_char(least(cred.[DATE_ENDING], P_DATE_END),'dd.mm.yyyy')|| CHR(9) || trim(to_char(P_SUMMA_PRC ,'999,999,999,999,990.00')) || LF$ || LF$;
				end if;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Проценты, подлежащие выплате на '||to_char(P_DATE_END,'dd.mm.yyyy')  || CHR(9) || trim(to_char(P_SUMMA ,'999,999,999,999,990.00')) || LF$ || LF$;*/

				flag := 1;
				--
			end loop;

			if flag = 0 and P_DATE_BEG is null then
				P_DATA := P_DATA || 'На ' || to_char(P_DATE_END,'dd.mm.yyyy') || ' действующие кредиты отсутствуют' || LF$;
			elsif flag = 0 and P_DATE_BEG is not null then
				P_DATA := P_DATA || 'За период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' действующие кредиты отсутствуют' || LF$;
			end if;
	
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

		-- Векселя ---------------------------------------------------------------------	
	    elsif v_fld_name = 'VEKS' then
			P_DATA := '';
			last_id := 0;
			if last_id = 0 and P_DATE_BEG is null then
				P_DATA := P_DATA || 'На ' || to_char(P_DATE_END,'dd.mm.yyyy') || ' векселя отсутствуют' || LF$;
			elsif last_id = 0 and P_DATE_BEG is not null then
				P_DATA := P_DATA || 'За период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' векселя отсутствуют' || LF$;
			end if;
            
            v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

		-- Аккредитивы ---------------------------------------------------------------------			
	    elsif v_fld_name = 'AKKR' then
			P_DATA := '';
			last_id := 0;
			if last_id = 0 and P_DATE_BEG is null then
				P_DATA := P_DATA || 'На ' || to_char(P_DATE_END,'dd.mm.yyyy') || ' аккредитивы отсутствуют' || LF$;
			elsif last_id = 0 and P_DATE_BEG is not null then
				P_DATA := P_DATA || 'За период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' аккредитивы отсутствуют' || LF$ || LF$;
			end if;
            
            v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

			-- Банковские гарантии ---------------------------------------------------------------------
			flag := 0;

			for gar in ::[GUARANTIES]
			where gar.[PRINCIPAL] = P_ORG
				and (  (gar.[DATE_BEGIN] <= P_DATE_END and gar.[DATE_ENDING] > P_DATE_BEG) 
					or (gar.[DATE_BEGIN] < P_DATE_END and gar.[DATE_ENDING] >= P_DATE_BEG))
				and gar.[LIST_FACT]%size(1) > 0
			loop
				P_DATA := P_DATA || 'Наименование счета: Банковская гарантия' || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Номер счета: ' || gar.[VNB_ACCOUNT].[MAIN_V_ID] || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Валюта: ' || gar.[VNB_ACCOUNT].[FINTOOL].[NAME] || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Остаток средств на счете: ' || trim(to_char(abs(F.A('И' ||gar.[VNB_ACCOUNT]|| 'с', P_DATE_END + 1)),'999,999,999,990.00')) || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Срок истечения/исполнения обязательства: ' || to_char(gar.[DATE_ENDING],'dd.mm.yyyy') || LF$ || LF$;				
				flag := 1;
				--
			end loop;

			if flag = 0 and P_DATE_BEG is null then
				P_DATA := P_DATA || 'На ' || to_char(P_DATE_END,'dd.mm.yyyy') || ' действующие банковские гарантии отсутствуют' || LF$;
			elsif flag = 0 and P_DATE_BEG is not null then
				P_DATA := P_DATA || 'За период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' действующие банковские гарантии отсутствуют' || LF$;
			end if;
	
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');
            
		-- Закрытые счета ---------------------------------------------------------------------------------------------------------------------------
	 	elsif v_fld_name = 'CLOSE' then
			P_DATA := ' за период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' :' || LF$;
			flag := 0;
			s := '';

			for a in ::[AC_FIN]
			where (a.[CLIENT_R] = P_ORG or a.[CLIENT_V] = P_ORG)
				and (a.[DATE_CLOSE] >= P_DATE_BEG and a.[DATE_CLOSE] <= P_DATE_END)				
				and substr(a.[MAIN_V_ID],1,3) in  ('407', '408')
			loop
				if a.[TARGET].[CODE]='RKO' then
					s := 'Расчетный счет в рублях:';
				elsif a.[TARGET].[CODE]='RKO_CUR' then
					s := 'Текущий счет в иностранных валютах:';
				elsif a.[TARGET].[CODE]='RKO_CUR_LOCK' then
					s := 'Транзитный счет в иностранных валютах:';
				end if;
				P_DATA := P_DATA || 'Наименование счета: ' || s || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Номер счета: ' || a.[MAIN_V_ID] || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Валюта счета: '|| a.[FINTOOL].[NAME] || LF$;
				P_DATA := P_DATA || CHR(9) || CHR(9) || CHR(9) || CHR(9)|| CHR(9) || CHR(9) || 'Дата закрытия счета: '|| to_char(a.[DATE_CLOSE], 'DD.MM.YYYY') || LF$;

				flag := 1;
			end loop;

			if flag = 0 then
				P_DATA := P_DATA || 'Закрытых счетов нет.' || LF$;
			end if;
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

       -- Комиссии ---------------------------------------------------------------------------------------------------------------------------
       elsif v_fld_name = 'COMIS' then
			P_DATA := '';
			P_DATA := P_DATA || ' за период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' : ';
			flag := 0;
			P_SUMMA := 0;

			select d(
				sum( coalesce(d.[SUM_NT], 0) ))
			in ::[MAIN_DOCUM]
			where d%state = 'PROV'
				and (d.[DATE_PROV] >= P_DATE_BEG
					and d.[DATE_PROV] < (P_DATE_END + 1))
				and substr(d.[ACC_DT].[MAIN_V_ID], 1, 3) in ('407', '408')
				and (d.[ACC_DT].[CLIENT_V] = P_ORG or d.[ACC_DT].[CLIENT_R] = P_ORG)
				and (d.[NUM_KT] = '47422810707710000001' or d.[NUM_KT] like '70601%' or d.[NUM_KT] like '47423810%' or d.[NUM_KT] like '613%')
				and d.[SUM] <> 0
				and d.[SUM_PO] <> 0
			into P_SUMMA;
			
			P_DATA := P_DATA || trim(to_char(abs(coalesce(P_SUMMA, 0)),'999,999,999,999,990.00'))|| CHR(9) || ' руб.' || LF$;
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

        -- Сумма процентов, кроме ссудных счетов ---------------------------------------------------------------------------------------------------------------------------
        elsif v_fld_name = 'ПРОЦ' then
        	P_DATA := '';
        	P_SUMMA := 0;
			P_DATA := P_DATA || ' за период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' по всем указанным выше счетам (кроме ссудных счетов): '
					  || trim(to_char(abs(coalesce(P_SUMMA, 0)),'999,999,999,999,990.00'))|| CHR(9) || ' руб.' || LF$;
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

        -- Сумма процентов по ссудным счетам ---------------------------------------------------------------------------------------------------------------------------
        elsif v_fld_name = 'ПРОЦ1' then
        	P_DATA := '';
        	P_SUMMA := 0;
			P_DATA := P_DATA || ' за период с '|| to_char(P_DATE_BEG,'dd.mm.yyyy') ||' по '|| to_char(P_DATE_END,'dd.mm.yyyy') || ' по всем указанным выше ссудным счетам: '
					  || trim(to_char(abs(coalesce(P_SUMMA, 0)),'999,999,999,999,990.00'))|| CHR(9) || ' руб.' || LF$;
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

        -- Задолженность по ссудным счетам ---------------------------------------------------------------------------------------------------------------------------
        elsif v_fld_name = 'ЗАДОЛЖ' then
        	P_DATA := '';
        	P_SUMMA := 0;
			P_DATA := P_DATA || ' на '|| ::[RUNTIME].[FDP].pdat_(P_DATE_END) || ' по всем указанным выше ссудным счетам: '
					  || trim(to_char(abs(coalesce(P_SUMMA, 0)),'999,999,999,999,990.00'))|| CHR(9) || ' руб.' || LF$;
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');

        -- 13.	Суммы по незакрытым срочным контрактам (форварды, опционы) -----------------------------------------------------------------------------------------------
        elsif v_fld_name = 'КОНТР' then
        	P_DATA := '';
        	P_SUMMA := 0;
			P_DATA := P_DATA || ' на '|| ::[RUNTIME].[FDP].pdat_(P_DATE_END) || ' срочным контрактам (форварды, опционы): '
					  || trim(to_char(abs(coalesce(P_SUMMA, 0)),'999,999,999,999,990.00'))|| CHR(9) || ' руб.' || LF$;
			v_tf_field(v_fld_name) := nvl(P_DATA, ' ');


	 	/*elsif p_info like 'DM_SDELKA' then
			P_DATA := '';
			d1:=null;
			d2:=null;

			for dep in ::[DM_SDELKA]
			where (dep.[FILIAL] = p_filial or p_filial is null)
				and dep.[COAGENT] = P_ORG
				and dep.[CATEGORY] = ::[DM_CATEGORY]([CODE] = 'OPTION_VNEB_VAL')
				and dep.[DEAL_DATE_TIME] < (P_DATE_END + 1)
			--	and dep.[DATE_PLAN_SUP]  >= P_DATE_BEG
				and dep.[DATE_PLAN_SUP]  >= DateBegin				
				and dep > last_id
			order by dep
			loop
				select pe(MIN(pe.[DATE_BEGIN]))
						in ::[PER_EXPIRATION] all
						where pe%COLLECTION=dep.[PER_EXPIRATION]	
							 and pe.[DATE_BEGIN] = pe.[DATE_END]
							 into d1;				

				P_DATA := P_DATA || 'Дата заключения                     ' || CHR(9) || CHR(9) || to_char(dep.[DEAL_DATE_TIME],'dd-mm-yyyy') || LF$;
				P_DATA := P_DATA || 'Дата истечения                      ' || CHR(9) || CHR(9) || to_char(d1,'dd-mm-yyyy') || LF$;
				P_DATA := P_DATA || 'Дата плановой поставки              ' || CHR(9) || CHR(9) || to_char(dep.[DATE_PLAN_SUP],'dd-mm-yyyy') || LF$;
				P_DATA := P_DATA || 'Базовый актив кол-во/сумма          ' || CHR(9) || CHR(9) || trim(to_char(dep.[AM_SUM],'999,999,999,999,990.00')) || LF$;
				P_DATA := P_DATA || 'Базовый актив                       ' || CHR(9) || CHR(9) || CHR(9) || dep.[BA_FT].[NAME] || LF$;
				P_DATA := P_DATA || 'Цена. Сумма                         ' || CHR(9) || CHR(9) || CHR(9) || trim(to_char(dep.[PRICE_SUM],'999,999,999,999,990.00')) || LF$;
				P_DATA := P_DATA || 'Цена. Валюта                        ' || CHR(9) || CHR(9) || CHR(9) || dep.[PRICE_CUR].[NAME] || LF$;
				P_DATA := P_DATA || 'Сумма сделки                        ' || CHR(9) || CHR(9) || CHR(9) || trim(to_char(dep.[SUM_DEAL],'999,999,999,999,990.00')) || LF$;
				P_DATA := P_DATA || 'Валюта платежа                      ' || CHR(9) || CHR(9) || CHR(9) || dep.[CUR_PAY].[NAME] || LF$;
				P_DATA := P_DATA || 'Базовый актив. Контрвалюта          ' || CHR(9) || CHR(9) || dep.[COUNTER_VAL].[NAME] || LF$;
			end loop;*/

        end if;

		v_fld_name	:= v_tf_field.next(v_fld_name);
	end loop;

	&wd.PutTextFields(v_tf_field);
end;	
		
PSH_AUD_REP (
	@name('Начальная дата')     P_DATE_BEG  in [DATE],
	@name('Вывод в файл')       P_TO_FILE   in [BOOLEAN],
	@name('Имя файла')          P_FILE_NAME in [STRING_2000],
	@name('Конечная дата')      P_DATE      in [DATE],
	@name('Руководитель банка') P_USER      in [USER_REF]
) is

validate is
begin
	if p_message='DEFAULT' then
		P_TO_FILE := false;
		P_DATE := trunc([System].[Op_date],'yyyy') - 1;
		P_USER := ::[BRANCH].[SLIB].GetBoss(StdLib.UserId.[FILIAL]);
	end if;
end;	

execute is
wd_out	blob	:= empty_blob();
begin
	if not nvl(&wd.open_file(::[SHABLON_DOC]([CODE]= 'PSB_AUD_REP').[RPT_TMPL]), False) then
		pragma error('Не могу открыть шаблон с кодом PSB_AUD_REP');
	end if;

	P_DATE_BEG := trunc(P_DATE, 'YYYY');
		
	PutData(this,P_DATE_BEG, P_DATE, P_USER);
	
	&wd.finish(wd_out);
	if P_TO_FILE then
		--Вывод в файл
		::[STOCK].[LIB_WRITE].blob2list(wd_out, P_FILE_NAME, '0');	
	else
		--Вывод на экран
		[OOXML]::[API_ORSA].putReport2Run(wd_out,'docx','['||&METHOD$CLASS||'] "'||&METHOD$NAME||'"');		
	end if;	
end;	
end;
end;
