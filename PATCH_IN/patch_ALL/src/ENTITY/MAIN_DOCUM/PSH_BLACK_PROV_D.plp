class MAIN_DOCUM;

@optimize(false)
@archive(value:='archive',package:=true)
@this(create_on_start:=true)
@name('[ПСБ] БЛЭК Проверить по списку')
@tag('COPIED')
batch method PSH_BLACK_PROV_D is
PSH_BLACK_PROV_D is

validate is
begin
	if p_message = 'DEFAULT' then
		null;
	end if;
end;

execute is
temp varchar2(32000):=null;
begin
		for i in this.first..this.last loop
		if this(i).[ACC_DT].[CLIENT_V]%CLASS='CL_ORG' or this(i).[ACC_KT].[CLIENT_V]%CLASS='CL_ORG'
		then

			for fail in ::[PSH_BLACK_UL] where (nvl(this(i).[KL_DT].[1].[1].[INN],this(i).[KL_DT].[2].[INN])= fail.[INN]
										or nvl(this(i).[KL_KT].[1].[1].[INN],this(i).[KL_KT].[2].[INN])= fail.[INN]
										or this(i).[ACC_DT].[CLIENT_V].[INN]=fail.[INN]
										or this(i).[ACC_KT].[CLIENT_V].[INN]=fail.[INN])
										and this(i).[ACC_KT].[MAIN_V_ID] not like ('706%')
										and this(i).[ACC_DT].[MAIN_V_ID] not like ('706%')
			loop
			temp:=temp||'ИНН '||fail.[INN]||' в документе № '||this(i).[DOCUMENT_NUM]||' входит в Чёрный список с типом '||fail.[IN_FAIL].[LIST_TYPE]||'- сообщите об этом ответственному лицу;'||CHR(13);
			end loop;
		end if;	
		end loop;
		
if temp is not null
then stdio.put_line_buf(temp);
else stdio.put_line_buf('В списке из документов не обнаруженны по спискам');
end if;

end;
end;
end;
