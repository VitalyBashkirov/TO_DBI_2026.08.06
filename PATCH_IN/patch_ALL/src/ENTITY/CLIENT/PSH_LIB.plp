	smdt := nvl(::[RUNTIME].[F_5].A('И'||p_acc||'ДВ', p_d_beg, p_d_end),0);	
	if smdt >0 then	
		sm := 0;	
		sm := nvl ( GetDTPayContragent_noNDS(p_acc, p_INN, p_d_beg, p_d_end), 0);
		return sm/smdt*100;
	else
		return 0;
	end if;	
end;

-- Для подсветки обозначения при дате регистрации менее 1 года по отношению к текущей дате
public function RegDateIn365 (p_cl ref [CL_CORP]) return varchar2(1) is  -- KAS 21/05/2020 по задаче Шмидт для представления
begin
	if (sysdate - p_cl.[REGISTER].[DATE_REG]) < 366 then
		return 1;
	else
		return 0;
	end if;
end;

