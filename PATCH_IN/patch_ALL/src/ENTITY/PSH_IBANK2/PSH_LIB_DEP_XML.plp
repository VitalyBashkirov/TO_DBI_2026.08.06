	,null		--Числовое значение
	,null		--Значение Даты
	,null		--Разрешать пустые значения
	,null		--Логическое значение
	,null		--Значение. Ссылка
	,null		--Значение Даты и времени
	);
		
	end; 
	 


end loop;	
		
end;
end;
