class PSH_EXP_TRANS;

@generate_ansi_joins(true)
@name('[ПСБ] Добавить')
@tag('EXP_SWIFT')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('Адрес. Объект. ID')                         P_TR_ID            in [REFERENCE],
	@name('GUID записи (изменения)')                   P_TR_AOID          in [STRING_40],
	@name('GUID объекта')                              P_TR_AOGUID        in [STRING_40],
	@name('Адресный объект. Код')                      P_TR_KIND_KLADR    in [INTEGER],
	@name('Адресный объект. Сокращенное наименование') P_TR_KIND_KLADR_SN in [STRING_20],
	@name('Адресный объект. Наименование')             P_TR_KIND_KLADR_NA in [NAME],
	@name('Адрес. Элемент. Наименование')              P_TR_NAME          in [STRING_200],
	@name('Адрес. Элемент. Сокращенное наименование')  P_TR_SNAME         in [STRING_200],
	@name('Адрес. Класс')                              P_TR_CLASS         in [STRING_16],
	@name('Файл')                                      P_FILE             in [FILE$PATH]
) return ref [PSH_EXP_TRANS] is

validate is
oExpTrans [PSH_EXP_TRANS]; -- updated CHANGE_QUALIFIER EXP_TRANS->PSH_EXP_TRANS 08/10/25
begin
	if p_message = 'DEFAULT' then
		oExpTrans := this;
		P_TR_ID := oExpTrans.[TR_ID];
		P_TR_AOID := oExpTrans.[TR_AOID];
		P_TR_AOGUID := oExpTrans.[TR_AOGUID];
		P_TR_KIND_KLADR := oExpTrans.[TR_KIND_KLADR];
		P_TR_KIND_KLADR_SN := oExpTrans.[TR_KIND_KLADR_SN];
		P_TR_KIND_KLADR_NA := oExpTrans.[TR_KIND_KLADR_NA];
		P_TR_NAME := oExpTrans.[TR_NAME];
		P_TR_SNAME := oExpTrans.[TR_SNAME];
		P_TR_CLASS := oExpTrans.[TR_CLASS];
		P_FILE := oExpTrans.[FILE];
	end if;
end;

execute is
begin
	[TR_ID] := P_TR_ID;
	[TR_AOID] := P_TR_AOID;
	[TR_AOGUID] := P_TR_AOGUID;
	[TR_KIND_KLADR] := P_TR_KIND_KLADR;
	[TR_KIND_KLADR_SN] := P_TR_KIND_KLADR_SN;
	[TR_KIND_KLADR_NA] := P_TR_KIND_KLADR_NA;
	[TR_NAME] := P_TR_NAME;
	[TR_SNAME] := P_TR_SNAME;
	[TR_CLASS] := P_TR_CLASS;
	[FILE] := P_FILE;
end;
end;
end;
