/*-----------------------------------------------------------
Определение типа клиента по счету
------------------------------------------------------------*/
function type_cl_on_acc(acc [ACCNUM]) return string(40) is
	ps	[PS$];
	balance_account	varchar2(6);
	vl ref [FT_MONEY];
	result_priv string(20) default '';
	result_org 	string(20) default '';
	result_bank string(20) default '';
	
begin
	balance_account := substr(acc, 1, 5) || '%';
	begin
		--Физик?
		locate ps in ::[PS$] all
		where ps%parent([PL_US]::[B_PS]).[NUM] like balance_account
		and ps.[] in (	::[PS]([PS_CODE] = 'C_CL_PRIV')
						);
		result_priv := 'CL_PRIV';
		exception when others then
		null;
	end;
	begin --Юрик?
		locate ps in ::[PS$] all
		where ps%parent([PL_US]::[B_PS]).[NUM] like balance_account
		and ps.[] in (	::[PS]([PS_CODE] = 'C_CL_ORG'));
		result_org := 'CL_ORG';
		exception when others then
		null;
	end;
	begin
		--Банк?
		locate ps in ::[PS$] all
		where ps%parent([PL_US]::[B_PS]).[NUM] like balance_account
		and ps.[] in (	::[PS]([PS_CODE] = 'C_CL_BANK_F'),
						::[PS]([PS_CODE] = 'C_CL_BANK_N')
					);
		result_bank := 'CL_BANK';
		exception when others then
		null;
	end;
	return result_priv||';'||result_org||';'||result_bank;

end;
