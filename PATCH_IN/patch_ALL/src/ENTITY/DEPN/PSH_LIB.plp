				end if;
			end loop;
		end if;
	end if;
	&debug('<='||oAcc.[MAIN_V_ID],dp)
	return rAcc.[MAIN_V_ID];
end;

--Башкиров В.Г. 23.12.2022 Функции для контроля учета и капитализации %%
public function GetLastDocCPTL(Depn ref [DEPN], DateOn [DATE]) return ref [MAIN_DOCUM] is 
fp ref [FOLDER_PAY];
md ref [MAIN_DOCUM];
Acc47411 ref [AC_FIN]:=Depn.[TRM_INTS_LBS_ACC]; --Счет обязательств по уплате %%
begin
	for (select o (o.[DOC]:C_DOC) in Depn.[LIST_PAY] 
	where trunc(o.[DATE]) = DateOn 
	and o.[DOC]%class='FOLDER_PAY'
	and o.[OPER].[SYS_NAME]='Капитализация процентов')
	loop
		fp:=o.C_DOC;
		for (select d(d.[DOCUMENT]:C_DOC) in fp.[DOCS_IN_FOLD] 
		where d.[DOCUMENT]%class='MAIN_DOCUM')
		loop
			md:=d.C_DOC;
		  --if md.[ACC_DT]=Acc47411 then
		    if md.[ACC_DT].[MAIN_V_ID] like '47411%' then
				return md;
				exit;
			end if;
		end loop;
	end loop;
	return null;
end;

public function GetPrcJour(Depn ref [DEPN], DateOn [DATE], SysName string(100)) return [SUMMA] is 
dbeg [DATE];
dend [DATE];
sumPrcRound [SUMMA];
begin
	for (select o (o.[BEG_DATE] : C_BEG_DATE
				  ,o.[END_DATE] : C_END_DATE) in Depn.[LIST_PAY] 
	where trunc(o.[DATE]) = DateOn 
	and o.[OPER].[SYS_NAME]=SysName) --'Учет начисленных процентов')
	loop
		dbeg :=o.C_BEG_DATE;
		dend :=o.C_END_DATE;
	  
		for (select jcp(jcp.[SUMMA_PRC_ROUND]:C_SUMMA_PRC_ROUND) in Depn.[JOUR_CALC_PRC]
		where dbeg<=jcp.[DATE_BEG] and jcp.[DATE_END]<=dend)
		loop
			sumPrcRound:=nvl(sumPrcRound,0)+jcp.C_SUMMA_PRC_ROUND;
		end loop;
	end loop;
	
	return sumPrcRound;
end;

public function GetErrCalc(Depn ref [DEPN], DateOn [DATE]) return string(100) is 
Err string(100);
cont_date [DATE]:=to_date(sys_context(user_context,'VW_CRIT_PSH_DEPN_PERCENT'), 'dd/mm/yyyy');
C_RATE [NUM_16_8];
C_PRC_JOUR [SUMMA];
C_PRC_JOUR_CRTL [SUMMA];
C_DEBET_SUM_UCH [SUMMA];
C_DEBET_SUM_CPTL [SUMMA];

C_DOC_UCH ref [MAIN_DOCUM];
C_DOC_CPTL ref [MAIN_DOCUM];
begin

	C_RATE     		:=::[DEPN].[GET_NUM].PRC_RATE(Depn, cont_date, null);	--Ставка
	C_PRC_JOUR 		:=::[DEPN].[PSH_LIB].GetPrcJour(Depn, cont_date, 'Учет начисленных процентов');	--%% по журналу
	C_PRC_JOUR_CRTL :=::[DEPN].[PSH_LIB].GetPrcJour(Depn, cont_date, 'Капитализация процентов');	--%% по журналу

	--Сумма учета %%
	for (select o (  o.[DOC] : C_DOC, o.[DOC]->(MAIN_DOCUM)[SUM_PO] : C_SUM_UCH) in Depn.[LIST_PAY] 
	where trunc(o.[DATE]) = cont_date 
	and o.[OPER].[SYS_NAME]='Учет начисленных процентов')
	loop
		C_DOC_UCH:=o.C_DOC;
		C_DEBET_SUM_UCH:=o.C_SUM_UCH;
		exit;
	end loop;
	
	if C_PRC_JOUR is null 
	and C_PRC_JOUR_CRTL is not null 
	and Depn.[VID_DOG]=::[VID_DEPOSIT]([CODE]='PSB_DOVOSTR') -- До востребования
	then
		C_PRC_JOUR:=C_PRC_JOUR_CRTL;
	end if;
	
	C_DOC_CPTL:=::[DEPN].[PSH_LIB].GetLastDocCPTL(Depn,cont_date);
	C_DEBET_SUM_CPTL:=C_DOC_CPTL.[SUM_PO];	--Сумма капитализации
	
	if C_PRC_JOUR<>C_DEBET_SUM_UCH then
		Err:=Err||'%% по журналу <> Учтенным %%; ';
	end if;

	if C_PRC_JOUR_CRTL<>C_DEBET_SUM_CPTL then
		Err:=Err||'%% по журналу <> Капитализированным %%';
	end if;
	
	if DateOn=DATEFUN.eoy(DateOn)
		and Depn.[VID_DOG]=::[VID_DEPOSIT]([CODE]='PSB_DOVOSTR') -- До востребования
		and Depn.[VID_DOG].[PERIOD_CALC_PRC]=::[PERIODS_OPER]([CODE]='Y_WORK') -- В последний календарный день года
	then
		if C_DOC_UCH is not null and (C_DOC_CPTL is null and (nvl(Depn.[PAY_ADD_PRC],false) or nvl(Depn.[PRC_TO_ACCOUNT],false))
															 ) then --Выплачивать причисленные %% или Причислять проценты ко вкладу
			Err:=Err||'Есть учет, нет капитализации';
		end if;
	
		if C_DOC_UCH is null and C_DOC_CPTL is not null 
		and C_PRC_JOUR<>C_PRC_JOUR_CRTL
		then
			Err:=Err||'Нет учета, есть капитализации';
		end if;
	else
		if C_DOC_UCH is not null and (C_DOC_CPTL is null and (nvl(Depn.[PAY_ADD_PRC],false) or nvl(Depn.[PRC_TO_ACCOUNT],false))
															 ) then --Выплачивать причисленные %% или Причислять проценты ко вкладу
			Err:=Err||'Есть учет, нет капитализации';
		end if;
	
		if C_DOC_UCH is null and C_DOC_CPTL is not null then
			Err:=Err||'Нет учета, есть капитализации';
		end if;
	end if;
	return trim(trim(Err),';');
end;

--Башкиров В.Г. 30.06.2024
public function GetInfoIfrsGroup(p_DEPN ref [DEPN]) return ref [IFRS_FTOOL_GRP] is 
	ret_ifrs_group	ref [IFRS_FTOOL_GRP];	--	группа финансового инструмента для определения рыночных ставок
begin
	for (	select x(	x%class				:	C_CLASS
						,x.[DATE_BEGIN]		:	C_DATE_BEGIN
						,x.[DATE_ENDING]	:	C_DATE_ENDING
						,x.[SUMMA_DOG]		:	C_SUMMA_DOG
						,x.[FINTOOL]		:	C_FINTOOL)
			in ::[DEPN] all
			where	x = p_DEPN)
	loop
		ret_ifrs_group := ::[IFRS_FTOOL_GRP].[LIB].Get_Ftool_Grp(	p_Obj_Ref		== p_DEPN%id			 						-- Экземпляр финансового инструмента
																			, p_Obj_Class	== x.C_CLASS									-- Класс ТБП экземпляра финансового инструмента
																			, p_Date		== p_DEPN.[DATE_BEGIN]							-- Дата
																			, p_bAim		== 1											-- Для какого множества определяется группа финансовых инструментов
																			, p_Period		== (p_DEPN.[DATE_ENDING] - p_DEPN.[DATE_BEGIN])	-- Период финансового инструмента
																			, p_UN_Period 	== ::[UNITS_OF_TIME]([CODE] = 'D')				-- Единица измерения периода
																			, p_Summa		== p_DEPN.[SUMMA_DOG]							-- Сумма финансового инструмента
																			, p_Currency	== p_DEPN.[FINTOOL]								-- Валюта финансового инструмента
																			, p_dDatebeg	== p_DEPN.[DATE_BEGIN] -- Дата начала действия ФИ (передается при необходимости преобразования периода ФИ в дни с учетом високосности)
																			);
		exit;
	end loop;
	return ret_ifrs_group;
exception
	--	если при определении рыночной процентной ставки произошла ошибка, то считаем, что она не определена
	when others then
		return null;
end;


public function GetInfoIfrsRates(p_DEPN ref [DEPN], p_OnDate [DATE], p_L_or_R char default 'L') return [NUM_16_8] is 
	ifrs_group	ref [IFRS_FTOOL_GRP];	--	группа финансового инструмента для определения рыночных ставок
	ret_rate [NUM_16_8];
	val [NUM_16_8]; --Относительное значение (проц)
begin
	ifrs_group:=GetInfoIfrsGroup(p_DEPN);
	&debug('.GetInfoIfrsRates -- ifrs_group='||ifrs_group.[NAME]||' p_OnDate='||to_char(p_OnDate,fmt)||' p_L_or_R='||p_L_or_R,dp1)
	if ifrs_group is not null then
		for cnt in ::[IFRS_GRP_RATES] all where cnt.[FTOOL_GRP] = ifrs_group
		loop
			for r in cnt.[RATES]
			where r.[RATE_DATE]<=p_OnDate
			order by r.[RATE_DATE] desc
			loop
				for crt in ::[IFRS_GRP_CRIT] all where crt.[FTOOL_GRP] = ifrs_group
				loop
					for crtv in crt.[CRIT_VALUES]
					where crtv.[CRIT_KIND]=::[IFRS_CRIT_KIND]([CODE]='СУЩ_ЭПС_РЫНОК') --Существенность отклонения от рынка
					and crtv.[CRIT_DATE]<=p_OnDate
					order by crtv.[CRIT_DATE] desc
					loop
						val := crtv.[PRC_VALUE];	--Относительное значение (проц)
						if val>0 then
							if p_L_or_R='L' then
								ret_rate:=r.[BOUND_LEFT]-r.[BOUND_LEFT]*val/100;
							else
								ret_rate:=r.[BOUND_RIGHT]+r.[BOUND_RIGHT]*val/100;
							end if;
						else
							val := crtv.[VALUE];	--Абсолютное значение
							if p_L_or_R='L' then
								ret_rate:=r.[BOUND_LEFT]-val;
							else
								ret_rate:=r.[BOUND_RIGHT]+val;
							end if;
						end if;
						exit;
					end loop;
				end loop;
				exit;
			end loop;
		end loop;
	end if;
	&debug('.GetInfoIfrsRates -< ret_rate='||ret_rate,dp1)
	return ret_rate;
exception
	--	если при определении рыночной процентной ставки произошла ошибка, то считаем, что она не определена
	when others then
		&debug('.GetInfoIfrsRates -< ret_rate не определена',dp1)
		return null;
end;

-- Башкиров В.Г. 25.11.2024
-- 101.ФИАС.Адрес xxxxx REGISTRATION
-- 104.ФИАС.Город.Адрес xxxxx CITY
-- 105.ФИАС.Улица.Адрес xxxxx STREET
-- 106.ФИАС.Индекс.Адрес xxxxx INDEX
-- 109.ФИАС.Формат.Адрес xxxxx FORMAT
-- 114.ФИАС.Устаревший.Адрес xxxxx ARCHAIC
-- 116.ФИАС.Нас.пункт.Адрес xxxxx NAME_CITY
-- 117.ФИАС.Дом/Стр./Корп.Адрес xxxxx HOUSE
-- 118.ФИАС.Адресный объект.Адрес xxxxx ADDR_OBJ
function GetRefs(p_coll number
	, KodAddrType ::[ADDRESS_TYPE].[KOD]%type
	, p_add string(100) default null)
return varchar2(1024) is
	str_adr varchar2(1024);
	str_index varchar2(1024);
	ret_str varchar2(1024);
	p_id ref [PERSONAL_ADDRESS];
begin
	for pa in var oPA ::[PERSONAL_ADDRESS] all 
	where pa%collection=p_coll
	and pa.[TYPE].[KOD]=KodAddrType
	order by pa%id desc
	loop
		if    p_add='REGISTRATION' then -- 101.ФИАС.Адрес xxxxx                 REGISTRATION
			if    oPA.[ADDR_OBJ]%class='STREET'		 and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.АО.УлДорСеть';
			elsif oPA.[ADDR_OBJ]%class='NAMES_CITY'	 and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.АО.Населенный пункт';
			elsif oPA.[ADDR_OBJ]%class='REGION'		 and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.АО.Район НП';
			elsif oPA.[ADDR_OBJ]%class='REGION_AREA' and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.АО.Район региона';
			elsif oPA.[ADDR_OBJ]%class='CODE_REGION' and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.АО.Регион';
			elsif oPA.[HOUSE_REF] is not null	then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Дом по КЛАДР';
			elsif oPA.[STREET_REF] is not null	then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Улица по КЛАДР';
			elsif oPA.[CITY] is not null		then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Населенный пунк по КЛАДР';
			elsif oPA.[DISTRICT] is not null	then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Район НП по КЛАДР';
			elsif oPA.[OKTMO] is not null		then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.ОКТМО по КЛАДР';
			end if;

		elsif p_add='CITY'         then -- 104.ФИАС.Город.Адрес xxxxx           CITY
			if    oPA.[ADDR_OBJ]%class='STREET'		and oPA.[ADDR_OBJ] is not null
													and oPA.[CITY] is not null
													then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Город.АО.УлДорСеть';
			elsif oPA.[ADDR_OBJ]%class='NAMES_CITY'	and oPA.[ADDR_OBJ] is not null
													and oPA.[CITY] is not null
													then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Город.АО.Населенный пункт';
			elsif oPA.[HOUSE_REF] is not null		and oPA.[CITY] is not null
													then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Город.Дом по КЛАДР';
			elsif oPA.[STREET_REF] is not null		and oPA.[CITY] is not null
													then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Город.Улица по КЛАДР';
			elsif oPA.[CITY] is not null			then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Город.Населенный пунк по КЛАДР';
			end if;

		elsif p_add='STREET'       then -- 105.ФИАС.Улица.Адрес xxxxx           STREET
			if    oPA.[ADDR_OBJ]%class='STREET'	and oPA.[ADDR_OBJ] is not null 
												and oPA.[STREET_REF] is not null
												then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Улица.АО.УлДорСеть';
			elsif oPA.[STREET_REF] is not null	then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Улица.Улица по КЛАДР';
			end if;

		elsif p_add='INDEX'        then -- 106.ФИАС.Индекс.Адрес xxxxx          INDEX
			str_adr:=::[ASV_REESTR_FILES].[PSH_EXPORT].GetAddrByArr(p_coll,KodAddrType,p_id); -- updated CHANGE_SHORT_NAME PSB_EXPORT->PSH_EXPORT 15/10/25
			ret_str=str_index:=::[CL_PRIV].[PSH_DATE_DEATH].wbn(str_adr,',',2);
			if str_index is not null and length(str_index)=::[RUNTIME].[STR].kol_nums(str_index)
			then
				if    oPA.[ADDR_OBJ]%class='STREET' then		ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[ADDR_OBJ].[ZIP]  =str_index,'Ok','Другой')||')Индекс.АО.УлДорСеть по ФИАС';
				elsif oPA.[ADDR_OBJ]%class='NAMES_CITY' then	ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[ADDR_OBJ].[ZIP]  =str_index,'Ok','Другой')||')Индекс.АО.Населенный пункт по ФИАС';
				elsif oPA.[ADDR_OBJ]%class='REGION_AREA' then	ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[ADDR_OBJ].[ZIP]  =str_index,'Ok','Другой')||')Индекс.АО.Район региона';
				elsif oPA.[ADDR_OBJ]%class='CODE_REGION' then	ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[ADDR_OBJ].[ZIP]  =str_index,'Ok','Другой')||')Индекс.АО.Регион';
				elsif oPA.[HOUSE_REF] is not null then			ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[HOUSE_REF].[ZIP] =str_index,'Ok','Другой')||')Индекс дома по ФИАС';
				elsif oPA.[STREET_REF] is not null then			ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[STREET_REF].[ZIP]=str_index,'Ok','Другой')||')Индекс улицы по ФИАС';
				elsif oPA.[CITY] is not null then				ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[CITY].[ZIP]      =str_index,'Ok','Другой')||')Индекс Населенного пунка по ФИАС';
				elsif oPA.[DISTRICT] is not null then			ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[DISTRICT].[ZIP]  =str_index,'Ok','Другой')||')Индекс Района НП по ФИАС';
			  --elsif oPA.[OKTMO] is not null then 				ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[OKTMO].[ZIP]     =str_index,'Ok','Другой')||')Индекс ОКТМО по ФИАС';
				end if;
			end if;
		elsif p_add='FORMAT'       then null; -- 109.ФИАС.Формат.Адрес xxxxx          FORMAT

		elsif p_add='ARCHAIC'      then -- 114.ФИАС.Устаревший.Адрес xxxxx      ARCHAIC
			if    oPA.[ADDR_OBJ]%class='STREET'			then ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[ADDR_OBJ].[ARCHAIC],'Нет','Ok')||')Актуальность.АО.УлДорСеть';
			elsif oPA.[ADDR_OBJ]%class='NAMES_CITY'		then ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[ADDR_OBJ].[ARCHAIC],'Нет','Ok')||')Актуальность.АО.Населенный пункт';
			elsif oPA.[ADDR_OBJ]%class='REGION'			then ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[ADDR_OBJ].[ARCHAIC],'Нет','Ok')||')Актуальность.АО.Район НП';
			elsif oPA.[ADDR_OBJ]%class='REGION_AREA'	then ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[ADDR_OBJ].[ARCHAIC],'Нет','Ok')||')Актуальность.АО.Район региона';
			elsif oPA.[ADDR_OBJ]%class='CODE_REGION'	then ret_str:=ret_str||'id:'||pa||'('||iif(oPA.[ADDR_OBJ].[ARCHAIC],'Нет','Ok')||')Актуальность.АО.Регион';
			elsif oPA.[HOUSE_REF] is not null			then ret_str:=ret_str||'id:'||pa||'(Нет)Актуальность.Дом по КЛАДР';
			elsif oPA.[STREET_REF] is not null			then ret_str:=ret_str||'id:'||pa||'(Нет)Актуальность.Улица по КЛАДР';
			elsif oPA.[CITY] is not null				then ret_str:=ret_str||'id:'||pa||'(Нет)Актуальность.Населенный пунк по КЛАДР';
			elsif oPA.[DISTRICT] is not null			then ret_str:=ret_str||'id:'||pa||'(Нет)Актуальность.Район НП по КЛАДР';
			elsif oPA.[OKTMO] is not null				then ret_str:=ret_str||'id:'||pa||'(Нет)Актуальность.ОКТМО по КЛАДР';
			end if;

		elsif p_add='NAME_CITY'    then null; -- 116.ФИАС.Нас.пункт.Адрес xxxxx       NAME_CITY
			if    oPA.[ADDR_OBJ]%class='STREET'	and oPA.[ADDR_OBJ] is not null 
												and oPA.[CITY] is not null
												then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Нас.пункт.АО.УлДорСеть';
			elsif oPA.[ADDR_OBJ]%class='NAMES_CITY' and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Нас.пункт.АО.Населенный пункт';
			elsif oPA.[CITY] is not null		then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Нас.пункт.Населенный пунк по КЛАДР';
			end if;

		elsif p_add='HOUSE'        then null; -- 117.ФИАС.Дом/Стр./Корп.Адрес xxxxx   HOUSE
			if    oPA.[ADDR_OBJ]%class='STREET'	and oPA.[ADDR_OBJ] is not null
												and oPA.[HOUSE_REF] is not null
												then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Дом/Стр./Корп.АО.УлДорСеть';
			elsif oPA.[ADDR_OBJ]%class='NAMES_CITY'	and oPA.[ADDR_OBJ] is not null
												and oPA.[HOUSE_REF] is not null
												then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Дом/Стр./Корп.АО.Населенный пункт';
			elsif oPA.[HOUSE_REF] is not null	then ret_str:=ret_str||'id:'||pa||'(Ok)ФИАС.Дом/Стр./Корп.Дом по КЛАДР';
			end if;

		elsif p_add='ADDR_OBJ'     then null; -- 118.ФИАС.Адресный объект.Адрес xxxxx ADDR_OBJ

		else --101.Адрес по ФИАС
			if    oPA.[INPUT_STRUCT]=1 then ret_str:='Администротивный.';
			elsif oPA.[INPUT_STRUCT]=2 then ret_str:='Муниципальный.';
			else							ret_str:='Не определено.';
			end if;
			if    oPA.[ADDR_OBJ]%class='STREET'		 and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)АО.УлДорСеть по ФИАС';
			elsif oPA.[ADDR_OBJ]%class='NAMES_CITY'	 and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)АО.Населенный пункт по ФИАС';
			elsif oPA.[ADDR_OBJ]%class='REGION'		 and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)АО.Район НП по ФИАС';
			elsif oPA.[ADDR_OBJ]%class='REGION_AREA' and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)АО.Район региона по ФИАС';
			elsif oPA.[ADDR_OBJ]%class='CODE_REGION' and oPA.[ADDR_OBJ] is not null then ret_str:=ret_str||'id:'||pa||'(Ok)АО.Регион по ФИАС';
			elsif oPA.[HOUSE_REF] is not null	then ret_str:=ret_str||'id:'||pa||'(Ok)Дом по КЛАДР';
			elsif oPA.[STREET_REF] is not null	then ret_str:=ret_str||'id:'||pa||'(Ok)Улица по КЛАДР';
			elsif oPA.[CITY] is not null		then ret_str:=ret_str||'id:'||pa||'(Ok)Населенный пунк по КЛАДР';
			elsif oPA.[DISTRICT] is not null	then ret_str:=ret_str||'id:'||pa||'(Ok)Район НП по КЛАДР';
			elsif oPA.[OKTMO] is not null		then ret_str:=ret_str||'id:'||pa||'(Ok)ОКТМО по КЛАДР';
			end if;
		end if;
		exit;
	end loop;
	return ret_str;
end;

--Башкиров В.Г. 25.11.2024
public function GetInfoClient(p_DEPN in ref [DEPN], TypeInfo char(256)) return varchar2(1024) is 
rDepositPriv ref [DEPOSIT_PRIV];
oDepositPriv [DEPOSIT_PRIV];
rClPriv ref [CL_PRIV];
oClPriv [CL_PRIV];
ret_str varchar2(1024);
p_id ref [PERSONAL_ADDRESS];
rAcFin ref [AC_FIN];
oAcFin [AC_FIN];
begin
	if p_DEPN%class='DEPOSIT_PRIV' then
		rDepositPriv:=p_DEPN;
		oDepositPriv:=rDepositPriv;
		if oDepositPriv.[CLIENT]%class='CL_PRIV' then
			rClPriv:=oDepositPriv.[CLIENT]%id;
			oClPriv:=rClPriv;
			if    TypeInfo='23.Вид документа'	then	ret_str:=oClPriv.[DOC].[TYPE].[NAME];
			elsif TypeInfo='70.СНИЛС'			then	ret_str:=oClPriv.[SNILS];
			elsif TypeInfo='79.Количество цифр в номере телефона > 20 или <10'	then	ret_str:=::[RUNTIME].[STR].kol_nums(::[CL_PRIV].[PSH_LIB_CL].cl_phone(oClPriv.[CONTACTS])); -- updated CHANGE_SHORT_NAME PSB_LIB_CL->PSH_LIB_CL 14/10/25
			elsif TypeInfo='79.Номер телефона'	then	ret_str:=replace(replace(::[CL_PRIV].[PSH_LIB_CL].cl_phone(oClPriv.[CONTACTS]),chr(10),','),chr(13)); -- updated CHANGE_SHORT_NAME PSB_LIB_CL->PSH_LIB_CL 14/10/25

			elsif TypeInfo like 'ПС%' then --'Последний счет клиента'
				for af in var oAF ::[AC_FIN] 
				where af.[CLIENT_V]=rClPriv
				and af.[FILIAL]=::[BRANCH]([CODE]='001')
				order by af.[DATE_OP] desc
				loop
					if    TypeInfo = 'ПС.Счет' then --'Последний счет клиента'
						ret_str:=oAF.[MAIN_V_ID]||'-'||oAF.[NAME]||' '||oAF.[DEPART].[CODE];
					elsif TypeInfo = 'ПС.ДПД.Счет' then
						ret_str:=to_char(nvl(oAF.[DATE_LAST],oAF.[DATE_OP]),fmt);
					end if;
				end loop;
				
			elsif TypeInfo='101.Адрес регистрации' then			ret_str:=::[ASV_REESTR_FILES].[PSH_EXPORT].GetAddrByArr(oClPriv.[ADDRESSES],'REGISTRATION',p_id); -- updated CHANGE_SHORT_NAME PSB_EXPORT->PSH_EXPORT 15/10/25
			elsif TypeInfo='101.ФИАС.Адрес регистрации' then	ret_str:=GetRefs(oClPriv.[ADDRESSES],'REGISTRATION',p_id);
			elsif TypeInfo='102.Адрес регистрации' then			ret_str:=::[ASV_REESTR_FILES].[PSH_EXPORT].GetAddrByArr(oClPriv.[ADDRESSES],'REGISTRATION',p_id); -- updated CHANGE_SHORT_NAME PSB_EXPORT->PSH_EXPORT 15/10/25
			elsif TypeInfo='102.Индекс.Адрес регистрации' then	ret_str:=::[ASV_REESTR_FILES].[PSH_EXPORT].GetAddrByArr(oClPriv.[ADDRESSES],'REGISTRATION',p_id); ret_str:=::[CL_PRIV].[PSH_DATE_DEATH].wbn(ret_str,',',2); -- updated CHANGE_SHORT_NAME PSB_EXPORT->PSH_EXPORT 15/10/25
			elsif TypeInfo='104.ФИАС.Город.Адрес регистрации' then				ret_str:=GetRefs(oClPriv.[ADDRESSES],'REGISTRATION','CITY');
			elsif TypeInfo='105.ФИАС.Улица.Адрес регистрации' then				ret_str:=GetRefs(oClPriv.[ADDRESSES],'REGISTRATION','STREET');
			elsif TypeInfo='106.ФИАС.Индекс.Адрес регистрации' then				ret_str:=GetRefs(oClPriv.[ADDRESSES],'REGISTRATION','INDEX');
			elsif TypeInfo='109.ФИАС.Формат.Адрес регистрации' then				ret_str:=GetRefs(oClPriv.[ADDRESSES],'REGISTRATION','FORMAT');
			elsif TypeInfo='114.ФИАС.Устаревший.Адрес регистрации' then			ret_str:=GetRefs(oClPriv.[ADDRESSES],'REGISTRATION','ARCHAIC');
			elsif TypeInfo='116.ФИАС.Нас.пункт.Адрес регистрации' then			ret_str:=GetRefs(oClPriv.[ADDRESSES],'REGISTRATION','NAME_CITY');
			elsif TypeInfo='117.ФИАС.Дом/Стр./Корп.Адрес регистрации' then		ret_str:=GetRefs(oClPriv.[ADDRESSES],'REGISTRATION','HOUSE');
			elsif TypeInfo='118.ФИАС.Адресный объект.Адрес регистрации' then	ret_str:=GetRefs(oClPriv.[ADDRESSES],'REGISTRATION','ADDR_OBJ');

			elsif TypeInfo='101.Адрес для уведомлений' then			ret_str:=::[ASV_REESTR_FILES].[PSH_EXPORT].get_data_addr_post(oClPriv.[ADDRESSES],p_id); -- updated CHANGE_SHORT_NAME PSB_EXPORT->PSH_EXPORT 15/10/25
			elsif TypeInfo='101.ФИАС.Адрес для уведомлений' then	ret_str:=GetRefs(oClPriv.[ADDRESSES],'POST');
			elsif TypeInfo='102.Адрес для уведомлений' then			ret_str:=::[ASV_REESTR_FILES].[PSH_EXPORT].get_data_addr_post(oClPriv.[ADDRESSES],p_id); -- updated CHANGE_SHORT_NAME PSB_EXPORT->PSH_EXPORT 15/10/25
			elsif TypeInfo='102.Индекс.Адрес для уведомлений' then	ret_str:=::[ASV_REESTR_FILES].[PSH_EXPORT].get_data_addr_post(oClPriv.[ADDRESSES],p_id); ret_str:=::[CL_PRIV].[PSH_DATE_DEATH].wbn(ret_str,',',2); -- updated CHANGE_SHORT_NAME PSB_EXPORT->PSH_EXPORT 15/10/25
			elsif TypeInfo='104.ФИАС.Город.Адрес для уведомлений' then				ret_str:=GetRefs(oClPriv.[ADDRESSES],'POST','CITY');
			elsif TypeInfo='105.ФИАС.Улица.Адрес для уведомлений' then				ret_str:=GetRefs(oClPriv.[ADDRESSES],'POST','STREET');
			elsif TypeInfo='106.ФИАС.Индекс.Адрес для уведомлений' then				ret_str:=GetRefs(oClPriv.[ADDRESSES],'POST','INDEX');
			elsif TypeInfo='109.ФИАС.Формат.Адрес для уведомлений' then				ret_str:=GetRefs(oClPriv.[ADDRESSES],'POST','FORMAT');
			elsif TypeInfo='114.ФИАС.Устаревший.Адрес для уведомлений' then			ret_str:=GetRefs(oClPriv.[ADDRESSES],'POST','ARCHAIC');
			elsif TypeInfo='116.ФИАС.Нас.пункт.Адрес для уведомлений' then			ret_str:=GetRefs(oClPriv.[ADDRESSES],'POST','NAME_CITY');
			elsif TypeInfo='117.ФИАС.Дом/Стр./Корп.Адрес для уведомлений' then		ret_str:=GetRefs(oClPriv.[ADDRESSES],'POST','HOUSE');
			elsif TypeInfo='118.ФИАС.Адресный объект.Адрес для уведомлений' then	ret_str:=GetRefs(oClPriv.[ADDRESSES],'POST','ADDR_OBJ');

			elsif TypeInfo='Документ' then						ret_str:=GetUL(rClPriv);
			elsif TypeInfo='122.Серия.Документ' then			ret_str:=GetUL(rClPriv,'Серия');
			elsif TypeInfo='122.Номер.Документ' then			ret_str:=GetUL(rClPriv,'Номер');
			elsif TypeInfo='123.Дата выдачи.Документ' then		ret_str:=GetUL(rClPriv,'Дата выдачи');
			elsif TypeInfo='123.Дата окончания.Документ' then	ret_str:=GetUL(rClPriv,'Дата окончания');
			elsif TypeInfo='123.Дата акта смерти.Документ' then	ret_str:=GetUL(rClPriv,'Дата акта смерти');
			elsif TypeInfo='124.Кем выдан.Документ' then		ret_str:=GetUL(rClPriv,'Кем выдан');
			end if;
		end if;
		
		--Башкиров В.Г. 10.12.2024 Счет обязательств банка по уплате %% без нарушения сроков
		if TypeInfo like 'TRM_INTS_LBS_ACC%' then
			rAcFin:=p_DEPN.[TRM_INTS_LBS_ACC];
			if rAcFin is null then
				for ada in p_DEPN.[ARRAY_DOG_ACC]
				where ada.[NAME_ACCOUNT].[COD] = 'D_TRM_INTS_LBS_ACC'
				loop
					rAcFin:=ada.[ACCOUNT_DOG].[1].[2];
					exit;
				end loop;
			end if;
			if rAcFin is not null then
				oAcFin:=rAcFin;
				if    TypeInfo = 'TRM_INTS_LBS_ACC'     then ret_str:=oAcFin.[MAIN_V_ID];
				elsif TypeInfo = 'TRM_INTS_LBS_ACC_DC'  then ret_str:=iif(oAcFin.[DATE_CLOSE] is null,'',to_char(oAcFin.[DATE_CLOSE],fmt));
				elsif TypeInfo = 'TRM_INTS_LBS_ACC_S'   then ret_str:=oAcFin.[SALDO];
				elsif TypeInfo = 'TRM_INTS_LBS_ACC_SN'  then ret_str:=oAcFin.[SALDO_NT];
				elsif TypeInfo = 'TRM_INTS_LBS_ACC_DEP' then ret_str:=oAcFin.[DEPART].[CODE];
				end if;
			end if;
		end if;
	end if;
	return ret_str;
end;
end;
