class PSH_LOCAL_JOBS_F;

@name('[ПСБ] Изменить')
@tag('COPIED')
method PSH_CFB_EDIT is
PSH_CFB_EDIT (
	@name('Адресат')       P_CLIENT_REF in [CLIENT_REF],
	@name('Признак EMAIL') P_EMAIL      in [BOOLEAN],
	@name('Признак SMS')   P_SMS        in [BOOLEAN],
	@name('Дата')          P_DATE_OP    in [DATE_TIME],
	@name('Сообщение')     P_TEXT       in [MEMO_BIG]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_CLIENT_REF := this.[CLIENT_REF];
	P_EMAIL := this.[EMAIL];
	P_SMS := this.[SMS];
	P_DATE_OP := this.[DATE_OP];
	P_TEXT := this.[TEXT];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Адресат"
	[CLIENT_REF] := P_CLIENT_REF;
	-- Установка значения реквизита "Признак EMAIL"
	[EMAIL] := nvl(P_EMAIL,false);
	-- Установка значения реквизита "Признак SMS"
	[SMS] := nvl(P_SMS,false);
	-- Установка значения реквизита "Дата"
	[DATE_OP] := P_DATE_OP;
	-- Установка значения реквизита "Сообщение"
	[TEXT] := P_TEXT;
end;
end;
end;
