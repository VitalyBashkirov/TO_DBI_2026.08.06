class PSH_TAX_IC_ACC_L;

@name('[ПСБ] Изменить (служебная)')
@tag('COPIED')
method PSH_EDIT_AUTO is

@name('НО') public V_TAX [TAX_INSPECT_REF];
PSH_EDIT_AUTO (
	@name('Счет')                    P_ACCOUNT      in [AC_FIN_REF],
	@name('Дата')                    P_PROCESS_DATE in [DATE],
	@name('Состояние')               P_STATE        in [STRING_10]  default null,
	@name('Номер решения')           P_LIM_NUM      in [STRING_20],
	@name('Дата решения')            P_LIM_DATE     in [DATE],
	@name('Код НО')                  P_TAX_CODE     in [STRING_4]   default null,
	@name('Имя файла')               P_FILE_NAME    in [FILE$PATH]  default null,
	@name('Имя файла подтверждения') P_PB_FILE_NAME in [FILE$PATH]  default null,
	@name('365-П')                   P_TAX_LIM_FILE in [BOOLEAN]    default null
) is

validate is
	v_this ref [PSH_TAX_IC_ACC_L]; -- updated CHANGE_QUALIFIER TAX_IC_ACC_LIM_1->PSH_TAX_IC_ACC_L 09/10/25
begin
	if this is not null then
		v_this := this;
		&BASE$SETVARS;
		&BASE$VALIDATE(v_this);
		&BASE$GETVARS;
	end if;
end;

execute is
	v_this ref [PSH_TAX_IC_ACC_L]; -- updated CHANGE_QUALIFIER TAX_IC_ACC_LIM_1->PSH_TAX_IC_ACC_L 09/10/25
begin
	if this is not null then
		v_this := this;
		&BASE$SETVARS;
		v_this := &BASE$EXECUTE(v_this);
	end if;
end;
end;
end;
