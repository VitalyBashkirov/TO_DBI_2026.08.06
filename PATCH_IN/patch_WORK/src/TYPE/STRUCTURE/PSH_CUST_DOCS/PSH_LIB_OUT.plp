class PSH_CUST_DOCS;

@import_plsql(true)
@name('[ПСБ] Библиотека взаимодействия с информационными системами')
@tag('COPIED')
library PSH_LIB_OUT is
		
pragma include(::[PSH_CUST_DOCS].[PSH_LIB_TC]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);

public function Send(p_doc ref [PSH_CUST_DOCS_IN], p_ab ref [CIT_ABONENT], p_text in out nocopy clob) return ref [PSH_CUST_REQS] is  -- updated CHANGE_QUALIFIER PSB_CUST_DOCS_IN->PSH_CUST_DOCS_IN 08/10/25 -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
v_strOutReq		[PSH_CUST_REQS]; -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
v_refOutReq	ref [PSH_CUST_REQS]; -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
v_clob			clob;
v_doc			[PSH_CUST_DOCS_IN]; -- updated CHANGE_QUALIFIER PSB_CUST_DOCS_IN->PSH_CUST_DOCS_IN 08/10/25
begin
	&debug('>> Send' ,0)
	
	v_doc := p_doc;
	v_clob := &lib.convertMessage(p_text, p_doc.[DOC_TYPE]);
	&lib.filePack(p_doc, v_clob);
	
	&debug('v_clob = ' || v_clob, 0)

	v_strOutReq.[DOC]		:= p_doc;
	v_strOutReq.[STATE_REQ]	:= &libtc.stRSend;
	v_strOutReq.[TIME_REQ]	:= sysdate;
	v_strOutReq.[CONTENT]	:= v_clob;
	v_strOutReq.[IS_OUT]	:= true;
	v_strOutReq.[SYS_AB]	:= p_ab;
	v_strOutReq.[CODE_BO]	:= &libfun.getBP(p_doc);

	v_refOutReq := ::[PSH_CUST_REQS]%insert(v_strOutReq); -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
	
	v_refOutReq.[PSH_SEND];	

	&debug('v_refoutReq ' || v_refoutReq.[REQ] ,0)
	return v_refOutReq;
end;

public function parseAnswer(p_Req ref [PSH_CUST_REQS], p_data clob, p_msgId varchar2, p_code_bo	varchar2, p_ans boolean default true) return integer is  -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
v_strInReq 		[PSH_CUST_REQS]; -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
v_refInReq	ref [PSH_CUST_REQS]; -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
v_refDoc	ref [PSH_CUST_DOCS]; -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
v_xmltype		XMLType;
v_count_sends	pls_integer;
v_num_send 		::[PSH_CUST_ATTR].[PSH_LIB].t_item_tab;
v_idx			pls_integer;
v_num			pls_integer;
answState		::[PSH_CUST_DOCS].[DOC_STATE]%type; -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
begin
	&debug('>> parseAnswer' ,0)
	
	v_strInReq.[CONTENT] 		:= p_data;
	v_strInReq.[REQ] 			:= p_msgid;
	v_strInReq.[STATE_REQ]		:= &libtc.stNew;
	v_strInReq.[TIME_REQ] 		:= sysdate;
	v_strInReq.[IS_OUT] 		:= false;
	v_strInReq.[INITIAL_REQ] 	:= p_Req;
	v_strInReq.[SYS_AB] 		:= p_Req.[SYS_AB];
	v_strInReq.[CODE_BO] 		:= p_code_bo;	
	
	v_xmltype := XMLType(p_data);
	
	v_refInReq := ::[PSH_CUST_REQS]%insert(v_strInReq); -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
	&debug('v_refinReq = ' || v_refinReq ,0)
	
	v_refDoc := p_Req.[DOC];
	
	if v_xmltype.existsNode('/Ответ/@КодОшибки') = 1 then
		-- исключение при исполнении в ИК
		v_count_sends := nvl(::[FP_TUNE].[LIB].get_num_value('CUST_REQ_TRY_COUNT'), 1);
		v_num_send := ::[PSH_CUST_ATTR].[PSH_LIB].get_value_by_req(p_req, 'NUM_SEND');
		
		v_num := 1;
		
		v_idx := v_num_send.first;
		while v_idx is not null loop
			v_num := greatest(v_num, nvl(to_number(v_num_send(v_idx)), 1));
		
			v_idx := v_num_send.next(v_idx);
		end loop;

		if v_num < v_count_sends then
			-- отправляем снова
			p_req.[PSH_SEND];
			::[PSH_CUST_ATTR].[PSH_LIB].set_req_attr(p_req, 'NUM_SEND', v_num + 1);
		else
			p_Req.[STATE_REQ] := &libtc.stRExcept;
			
			::[PSH_CUST_ATTR].[PSH_LIB].set_req_attr(p_req, 'ERR', v_xmltype.extract('/Ответ/@ОписаниеОшибки').GetStringVal());
			
			&libfun.setState(v_refDoc, &libtc.stAnswExc);
		end if;
		
	elsif p_ans then
		p_Req.[STATE_REQ] := &libtc.stRAnswered;

		commit;

		-- нужно изменить состояние у исходного сообщения
		answState := &libfun.getAnswState(v_refDoc);
		
		if v_refDoc.[DOC_STATE] != answState then
			&libfun.setState(v_refDoc, answState);
		end if;
	end if;
	
end;
end;
