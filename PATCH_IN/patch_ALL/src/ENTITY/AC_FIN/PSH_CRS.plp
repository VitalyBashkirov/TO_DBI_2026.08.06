		--	end if;     
			end loop;
			--> БЕНЕФИЦИАР Бенефициарный владелец
						
			
		&xl.finish(xl_tmpl);
		[OOXML]::[API_ORSA].putReport2RunExtProc(xl_tmpl,'xlsx','CRS_ф5- '||to_char(P_DATE,'mm_yy')||' ');														

