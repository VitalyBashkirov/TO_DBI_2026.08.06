class HOOK_BANK;

@optimize(false)
@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Платежные документы. Анализ счета деб/кр при проводке пл. документа (точка вызова)')
@tag('COPIED')
static method MD_FOR_PROV_CP_1 is

--Башкиров В.Г. 18.06.2019 Добавлен вывод "Даты отказа" и "Кода основания отказа" для DENY_LIST
public gDENY_CODE [STRING_2];
public gDENY_DATE [DATE];

public V_MD_FOR_PROV	varchar(30);  -->> PSB VRI 24/03/2025 CFT-1248

public v_NoSystemDoc boolean;

pragma include ('APPAUX_CALLPOINT.COMPILE_LIB');
--&setcallpoint('MD_FR_PROV', 'Платежные документы. Анализ счета деб/кр при проводке пл. документа', 1)	

pragma include(::[RUNTIME].[DEBUG_MACRO]);
dp  number:=0;	--управление debug_pipe
dp2 number:=10;	--управление debug_pipe

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

fmt	   string(10):='dd/mm/yyyy';
fmtHMS string(22):='dd/mm/yyyy HH24:MI:SS';

function GetTimeInterval(tEnd number, tBeg number) return number is
tMax    number:= 2147483647;
tMin    number:=-2147483648;
nLength number:=tMax - tMin + 1;
Minhalf number:=tMin/2;
Maxhalf number:=(tMax+1)/2;
begin
	if    tBeg>Maxhalf and tEnd<Minhalf then return tEnd-tBeg+nLength;
	elsif tBeg<Minhalf and tEnd>Maxhalf then return tEnd-tBeg-nLength;
	end if;
	return tEnd-tBeg;
end;

-- доп. контроль документов плательщика(получателя?) 
public function Check_PSH_CL_UFMPAYOK(p_cl [REQ_CLIENT]) return boolean is 
 v_value string(100);
begin
    select pr(::[PROPERTIES].[Z7421716].GetTypeValue(
			                                        pr.[GROUP_PROP].[TYPE_VALUE]
			                                        ,pr.[PROP].[NAME]
			                                        ,pr.[NUM]
			                                        ,pr.[STR]
			                                        ,pr.[V_DATE]
			                                        ,pr.[BOOL]
			                                        ,pr.[OBJ]
			                                        ,pgrp.[TBP]
			                                        )
             )
	in ::[PROPERTIES]
	left outer join (::[PROPERTY_GRP] : pgrp) on pr.[GROUP_PROP]=pgrp%id  all
	where pr%collection=p_cl.[1].[1].[ADD_PROP]
	and pr.[GROUP_PROP]=::[PROPERTY_GRP]([CODE]='PSH_CL_UFMPAYOK')
	and sysdate<=COALESCE(pr.[DATE_END], to_date('31.12.9999', 'dd.mm.yyyy'))
	and sysdate>=COALESCE(pr.[DATE_BEG], sysdate)
	into v_value;
    if v_value = 'Да' then 
        return true;
    elsif v_value = 'Нет' then
        return false;
    else
        return null;
    end if;
exception
    when no_data_found then
        return null;    
end;

public function Get_AUXCTRL_OVER_SUM(p_cl [REQ_CLIENT]) return number is 
 v_value string(100);
begin
    select pr(::[PROPERTIES].[Z7421716].GetTypeValue(
                                                    pr.[GROUP_PROP].[TYPE_VALUE]
                                                    ,pr.[PROP].[NAME]
                                                    ,pr.[NUM]
                                                    ,pr.[STR]
                                                    ,pr.[V_DATE]
                                                    ,pr.[BOOL]
                                                    ,pr.[OBJ]
                                                    ,pgrp.[TBP]
                                                    )
             )
    in ::[PROPERTIES]
    left outer join (::[PROPERTY_GRP] : pgrp) on pr.[GROUP_PROP]=pgrp%id  all
    where pr%collection=p_cl.[1].[1].[ADD_PROP]
    and pr.[GROUP_PROP]=::[PROPERTY_GRP]([CODE]='PSH_CL_AUXCTRL_OVER_SUM')
    and sysdate<=COALESCE(pr.[DATE_END], to_date('31.12.9999', 'dd.mm.yyyy'))
    and sysdate>=COALESCE(pr.[DATE_BEG], sysdate)
    into v_value;
    return to_number(v_value,'999G999G999G999G990D0099');
exception
    when no_data_found then
        return null;
end;

-- проверка реквизитов плательщика\получателя платежного документа по спр. Реестр отказов. Случаи отказа в выполнении операции, отказа от заключения договора счета, расторжения договора счета
public function Check_Doc_550P(p_cl [REQ_CLIENT]) return boolean is 
ret boolean;
deny_cl ref [DENY_LIST];
tmpInn [STRING_16];
begin
	gDENY_CODE:=null;
	gDENY_DATE:=null;

	tmpInn:=trim(p_cl.[2].[INN]);
	&debug('.Check_Doc_550P -- Поиск по спр. Реестр отказов. Случаи отказа '||p_cl.[1].[1].[NAME]||' ИНН="'||tmpInn||'"',dp2)
  --&debug('.Check_Doc_550P -- по ИНН="'||p_cl.[2].[INN]||'"',dp2)
	if p_cl.[1].[1] is not null then -- если есть ссылка на клиента
		null;
		--Башкиров В.Г. 16.04.2019 Для поиска в "Реестр отказов. Случаи отказа ..." используем ИНН клиента, если ИНН не указан в реквизитах документа
		if tmpInn is null then
			tmpInn:=trim(p_cl.[1].[1].[INN]);
			&debug('.Check_Doc_550P -- ИНН у Клиента='||tmpInn,dp2)
		end if;
	end if;
	
	if nvl(trim(p_cl.[2].[INN]),trim(tmpInn)) is not null then
		--Башкиров В.Г. 21.06.2019 Убрал ошибку, возникающую при ИНН=' '
		if to_char(to_number(nvl(trim(p_cl.[2].[INN]),trim(tmpInn))))!='0' then
			--Башкиров В.Г. 26.07.2019 Встроен контроль состояния записи справочника "Реестр отказов. Случаи отказа в выполнении операции, отказа от заключения договора счета, расторжения договора счета"
			/** /
			begin
				locate deny_cl in ::[DENY_LIST] where trim(deny_cl.[MEMBER].[INN]) = nvl(trim(p_cl.[2].[INN]),trim(tmpInn));
					gDENY_CODE:=deny_cl.[DENY_CODE];
					gDENY_DATE:=deny_cl.[DENY_DATE];
					&debug('.Check_Doc_550P -- deny_cl='||deny_cl||' gDENY_CODE='||gDENY_CODE||' gDENY_DATE='||to_char(gDENY_DATE,fmt),dp2)
					ret := true;			
				exception
					when NO_DATA_FOUND then
						null; &debug('.Check_Doc_550P -- ИНН в спр. не найден.',dp2)
					when TOO_MANY_ROWS then ret := true;
				end;
			end;	
			/**/
			for
				(select deny_cl(deny_cl.[MEMBER].[INN] : C_MEMBER_INN, deny_cl.[DENY_CODE] : C_DENY_CODE, deny_cl.[DENY_DATE] : C_DENY_DATE) in ::[DENY_LIST]
				where trim(deny_cl.[MEMBER].[INN]) = nvl(trim(p_cl.[2].[INN]),trim(tmpInn))
					and deny_cl%statename='Действует')
			loop
				gDENY_CODE:=deny_cl.C_DENY_CODE;
				gDENY_DATE:=deny_cl.C_DENY_DATE;
				&debug('.Check_Doc_550P -- deny_cl.[MEMBER].[INN]='||deny_cl.C_MEMBER_INN||' gDENY_CODE='||gDENY_CODE||' gDENY_DATE='||to_char(gDENY_DATE,fmt),dp2)
				ret := true;
				exit;
			end loop;
		end if;
	end if;
	
	-- ФИЛИАЛ ООО "ПРОМСЕЛЬХОЗБАНК" В Г. ЭНГЕЛЬСЕ и ООО "ПРОМСЕЛЬХОЗБАНК"
	if nvl(trim(p_cl.[2].[INN]),trim(tmpInn)) = '0' and (p_cl.[1].[1]%id = '1104396883' or p_cl.[1].[1]%id = '280750011') then
		gDENY_CODE:=null;
		gDENY_DATE:=null;
		ret:= false;
	end if;
	
	&debug('.Check_Doc_550P -- ret='||ret,dp2)
	return nvl(ret,false);	
end;

procedure WarningSend(p_text in varchar2(2000), p_mdoc in ref [MAIN_DOCUM], p_cl in [REQ_CLIENT])
is
begin
	p_text:=Substr(
							'Документ № '||p_mdoc.[DOCUMENT_NUM]||' от '||to_char(p_mdoc.[DATE_DOC], 'DD.MM.YYYY')||' на сумму '||trim(to_char(p_mdoc.[SUM], '999999999999999990d00'))||' '||p_mdoc.[VALUTA].[CUR_SHORT]
		||chr(10)||chr(13)||'Плательщик: '||p_mdoc.[KL_DT].[2].[2]||', ИНН: "'||p_mdoc.[KL_DT].[2].[INN]||'"'
		||chr(10)||chr(13)||'Получатель: '||p_mdoc.[KL_KT].[2].[2]||', ИНН: "'||p_mdoc.[KL_KT].[2].[INN]||'"'
		||chr(10)||chr(13)||'Назн.плат.: '||p_mdoc.[NAZN]
		||chr(10)||chr(13)||'Филиал: '||p_mdoc.[DEPART].[FILIAL].[CODE]
		||chr(10)||chr(13)||p_text					-- Сообщение
	,1,1024);

	::[FP_INTERFACE].[PRX_PCORE].Send_Mail(  --Башкиров В.Г. 17.12.2023
		 ::[PSH_EMAIL_RASSIL]([PSH_EMAIL_COD] = 'LEGALIZ' and [PSH_EMAIL_FIL].[CODE] = p_mdoc.[DEPART].[FILIAL].[CODE]).[PSH_EMAIL_ADRES]--||'; kokorin@pshb.ru; kurganov@pshb.ru'	   -- Кому (E-Mail) Можно указать несколько адресов разделенных "точкой с запятой"
		, 'Документ по 764-П'				-- Тема	
		, p_text
		, 'IT@pshb.ru'					    -- от кого (E-Mail, если пусто, то используется значение DEFAULT_FROM_EMAIL)
		, false							    -- если TRUE, то вылетит ERROR_ON_SEND
		,null
		);

	&debug('.WarningSend -- p_text='||p_text,dp2)
	pragma error(p_text);
end;

-- Проверка ручного подтверждения документа
function Doc_is_Checked (p_mdoc in ref [MAIN_DOCUM]) return boolean
is
vHist [HISTORY_STATES];
ret boolean;
begin
	&debug('.Doc_is_Checked -- Проверка ручного подтверждения документа',dp2)
	begin
		locate vHist in p_mdoc.[HISTORY_STATE] where vHist.[STATE] = 'PSH_CHECK550P';
		ret := true;
		exception
			when NO_DATA_FOUND then ret :=false;
			when TOO_MANY_ROWS then ret := true;
	end;
	
	&debug('.Doc_is_Checked ret='||ret,dp2)
	return nvl(ret,false);	
end;

public function Check_550P_for_vw (p_mdoc ref [MAIN_DOCUM]) return integer is 
ret integer;
begin
	if Check_Doc_550P(p_mdoc.[KL_DT]) or Check_Doc_550P(p_mdoc.[KL_KT]) then
		ret := '1';
	end if;
	
	return nvl(ret, '0');
end;

public function Check_550P_DT_for_vw (p_mdoc ref [MAIN_DOCUM]) return integer is 
ret integer;
begin
	if Check_Doc_550P(p_mdoc.[KL_DT]) then
		ret := '1';
	end if;
	
	return nvl(ret, '0');
end;
public function Check_550P_KT_for_vw (p_mdoc ref [MAIN_DOCUM]) return integer is 
ret integer;
begin
	if Check_Doc_550P(p_mdoc.[KL_KT]) then
		ret := '1';
	end if;
	
	return nvl(ret, '0');
end;
--Кожухарь Светлана Саввична <kozhukhar@pshb.ru> письма 01.11.2018 % по оверу
--Башкиров В.Г. 02.11.2015 добавляем в факты "Учет процентов за кредит" и "Гашение учтенных процентов" для Пластиковых овердрафтов
function OverUnder47427 (af ref [AC_FIN]) return ref [OVERDRAFTS] is
begin
	for h in ::[HOZ_OP_ACC] all where h.[ACCOUNT_DOG].[1].[2]=af
	loop
		if h%parentclass='OVERDRAFTS' then
			return h%parent;
		end if;
	end loop;
end;
procedure AddListPayCardOver(
	DOCUMENT in out [MAIN_DOCUM_REF],
	ACCOUNT_DT in out [AC_FIN_REF],
	ACCOUNT_CT in out [AC_FIN_REF],
	IT_DT in out [BOOLEAN],
	ANALYSE_OK in out [BOOLEAN],
	P_ADDS in out [STRING_32000],
	P_MESS in out [STRING_100]) is
TmpOver ref [OVERDRAFTS];
flAddListOper boolean;
d_beg [DATE];
d_end [DATE];
fp ref [FOLDER_PAY];
begin
	&debug('.AddListPayCardOver -- DOCUMENT='||DOCUMENT%class||'.'||DOCUMENT%id||'.'||DOCUMENT%state||' ACCOUNT_DT='||ACCOUNT_DT.[MAIN_V_ID]||' ACCOUNT_CT='||ACCOUNT_CT.[MAIN_V_ID]||' IT_DT='||IT_DT||' ANALYSE_OK='||ANALYSE_OK||' P_ADDS='||P_ADDS||' P_MESS='||P_MESS,dp)
	TmpOver:=OverUnder47427(ACCOUNT_DT);
	if TmpOver is null then TmpOver:=OverUnder47427(ACCOUNT_CT); end if;
	
	if DOCUMENT.[DATE_VAL]=DATEFUN.Eom(DOCUMENT.[DATE_VAL]) or DOCUMENT.[DATE_DOC]=DATEFUN.Eom(DOCUMENT.[DATE_DOC]) or
	   DOCUMENT.[DATE_VAL]=TmpOver.[DATE_ENDING]            or DOCUMENT.[DATE_DOC]=TmpOver.[DATE_ENDING]
	then
		fp:=DOCUMENT.[IN_FOLDER];
		&debug('.AddListPayCardOver -- (1)'||fp%class||'.'||fp%id||'.'||fp%state||' {'||fp.[DOCS_IN_FOLD]%size(0)||'}'||' ФО{'||TmpOver.[LIST_PAY]%size(0)||'}',dp)
		if SubStr(ACCOUNT_DT.[MAIN_V_ID],1,5)='47427' and SubStr(ACCOUNT_CT.[MAIN_V_ID],1,5)='70601' and Upper(DOCUMENT.[NAZN]) like ('НАЧ%ПРОЦ%') then
			if TmpOver is not null then
				&debug('.AddListPayCardOver -- Наш случай "Учет процентов за кредит" P_MESS='||P_MESS||' ACCOUNT_DT.[TO_PRODUCT].[CODE]='||ACCOUNT_DT.[TO_PRODUCT].[CODE]||' DOCUMENT.[PRODUCT_DT].[ACC_PROD]='||DOCUMENT.[PRODUCT_DT].[ACC_PROD]%class||'.'||DOCUMENT.[PRODUCT_DT].[ACC_PROD]%id||'.'||DOCUMENT.[PRODUCT_DT].[ACC_PROD].[COM_STATUS].[CODE]||' DOCUMENT.[PRODUCT_DT].[FACT_OPER]='||DOCUMENT.[PRODUCT_DT].[FACT_OPER].[CODE]||'-'||DOCUMENT.[PRODUCT_DT].[FACT_OPER].[SYS_NAME],dp)
				if P_MESS='BEGIN' then
					if DOCUMENT.[IN_FOLDER]%state<>'FFORM' then DOCUMENT.[IN_FOLDER].[PSH_TO_FORM]; end if;
					if ACCOUNT_DT.[TO_PRODUCT] is not null then
						ACCOUNT_DT.[TO_PRODUCT]:=null;
						&debug('.AddListPayCardOver -- '||ACCOUNT_DT.[MAIN_V_ID]||' Отвязываем отношение счета к продукту',dp)	
					end if;
					if DOCUMENT.[PRODUCT_DT].[ACC_PROD] is not null then
						DOCUMENT.[PRODUCT_DT].[ACC_PROD]:=null;
						&debug('.AddListPayCardOver -- '||ACCOUNT_DT.[MAIN_V_ID]||' Убираем продукт по ДТ',dp)	
					end if;
					if DOCUMENT.[PRODUCT_DT].[FACT_OPER] is null then
						DOCUMENT.[PRODUCT_DT].[FACT_OPER]:=::[VID_OPER_DOG]([CODE]='УЧЕТ_ПРОЦ_ЗА_КР');
						&debug('.AddListPayCardOver -- '||ACCOUNT_DT.[MAIN_V_ID]||' Прописали ФО по ДТ '||DOCUMENT.[PRODUCT_DT].[FACT_OPER].[CODE]||'-'||DOCUMENT.[PRODUCT_DT].[FACT_OPER].[SYS_NAME],dp)	
					end if;
				elsif P_MESS='END' then
					if DOCUMENT%state='PROV' then
						flAddListOper:=true;
						&debug('.AddListPayCardOver -- Документ проведен. Проверяем, нужно ли его добавлять в ФО',dp)
						for lp in TmpOver.[LIST_PAY] where lp.[DOC]%id=DOCUMENT%id and lp.[OPER]=::[VID_OPER_DOG]([CODE]='УЧЕТ_ПРОЦ_ЗА_КР') loop flAddListOper:=false; exit; end loop;
						if flAddListOper then
							
							for lp in TmpOver.[LIST_PAY] where lp.[OPER]=::[VID_OPER_DOG]([CODE]='УЧЕТ_ПРОЦ_ЗА_КР') order by nvl(lp.[END_DATE],lp.[DATE]) desc
							loop
								d_beg:=nvl(lp.[END_DATE],lp.[DATE]);
								if d_beg is not null then d_beg:=d_beg+1; end if;
								exit;
							end loop;
							if d_beg is null then d_beg:=nvl(TmpOver.[DATE_BEGINING],TmpOver.[DATE_BEGIN]); end if;
							d_end:=DATEFUN.Eom(DOCUMENT.[DATE_PROV]);
							if d_end>TmpOver.[DATE_ENDING] then d_end:=TmpOver.[DATE_ENDING]; end if;
							&debug('.AddListPayCardOver -- Определили период '||to_char(d_beg,fmt)||'-'||to_char(d_end,fmt)||'. Пробуем добавить ФО с "Пресчитывать %" и "Перепланировать"',dp)
							
							TmpOver.[LIST_PAY].[NEW#AUTO](
							 DOCUMENT.[DATE_PROV]	--Дата
							,::[VID_OPER_DOG]([CODE]='УЧЕТ_ПРОЦ_ЗА_КР')	--Операция
							,DOCUMENT.[SUM]	--Сумма в валюте договора
							,null		--Валюта операции
							,DOCUMENT	--Документ
							,d_beg		--Дата начала периода
							,d_end		--Дата окончания периода
							,null		--Сумма в валюте учёта
							,true		--Пресчитывать %
							,true);		--Перепланировать
							::[CL_PRIV].[PSH_DATE_DEATH].UniLog(Substr('Документ ID:'||DOCUMENT%id||' Добавлен как УЧЕТ_ПРОЦ_ЗА_КР в ФО '||TmpOver%class||'.'||TmpOver%Id,1,350),
								Rpad('CardOver',10),'_'||&METHOD$SNAME||'.log');
								
							if DOCUMENT.[PRODUCT_DT].[ACC_PROD] is null then
								DOCUMENT.[PRODUCT_DT].[ACC_PROD]:=TmpOver;
								&debug('.AddListPayCardOver -- '||ACCOUNT_DT.[MAIN_V_ID]||' Пропишем продукт по ДТ',dp)	
							end if;
						else
							&debug('.AddListPayCardOver -- Добавлять не нужно. Уже есть в ФО',dp)
						end if;
						if ACCOUNT_DT.[TO_PRODUCT] is null then
							ACCOUNT_DT.[TO_PRODUCT]:=::[ACC_PRODUCT]([CODE]='PR_CRED');
							&debug('.AddListPayCardOver -- '||ACCOUNT_DT.[MAIN_V_ID]||' Прописываем отношение счета к продукту '||ACCOUNT_DT.[TO_PRODUCT].[CODE],dp)	
						end if;
					end if;
				end if;
			end if;
		elsif SubStr(ACCOUNT_DT.[MAIN_V_ID],1,5)='40817' and SubStr(ACCOUNT_CT.[MAIN_V_ID],1,5)='47427' and Upper(DOCUMENT.[NAZN]) like ('ГАШЕНИЕ НАЧ%ПРОЦ%') then
			if TmpOver is not null then
				&debug('.AddListPayCardOver -- Наш случай "Гашение учтенных процентов" P_MESS='||P_MESS||' ACCOUNT_CT.[TO_PRODUCT].[CODE]='||ACCOUNT_CT.[TO_PRODUCT].[CODE]||' DOCUMENT.[PRODUCT_CT].[ACC_PROD]='||DOCUMENT.[PRODUCT_CT].[ACC_PROD]%class||'.'||DOCUMENT.[PRODUCT_CT].[ACC_PROD]%id||'.'||DOCUMENT.[PRODUCT_CT].[ACC_PROD].[COM_STATUS].[CODE]||' DOCUMENT.[PRODUCT_CT].[FACT_OPER]='||DOCUMENT.[PRODUCT_CT].[FACT_OPER].[CODE]||'-'||DOCUMENT.[PRODUCT_CT].[FACT_OPER].[SYS_NAME],dp)
				if P_MESS='BEGIN' then --ГАШЕН_УЧТЕН_ПРОЦ
					if DOCUMENT.[IN_FOLDER]%state<>'FFORM' then DOCUMENT.[IN_FOLDER].[PSH_TO_FORM]; end if;
					if ACCOUNT_CT.[TO_PRODUCT] is not null then
						ACCOUNT_CT.[TO_PRODUCT]:=null;
						&debug('.AddListPayCardOver -- '||ACCOUNT_CT.[MAIN_V_ID]||' Сбрасываем отношение счета к продукту '||ACCOUNT_CT.[TO_PRODUCT].[CODE],dp)	
					end if;
					if DOCUMENT.[PRODUCT_CT].[ACC_PROD] is not null then
						DOCUMENT.[PRODUCT_CT].[ACC_PROD]:=null;
						&debug('.AddListPayCardOver -- '||ACCOUNT_CT.[MAIN_V_ID]||' Сбрасываем продукт по КТ '||ACCOUNT_CT.[TO_PRODUCT].[CODE]||' DOCUMENT.[PRODUCT_CT].[ACC_PROD]='||DOCUMENT.[PRODUCT_CT].[ACC_PROD]%class||'.'||DOCUMENT.[PRODUCT_CT].[ACC_PROD].[COM_STATUS].[CODE]||'.'||DOCUMENT.[PRODUCT_CT].[ACC_PROD]%state,dp)	
					end if;
					if DOCUMENT.[PRODUCT_CT].[FACT_OPER] is not null then
						DOCUMENT.[PRODUCT_CT].[FACT_OPER]:=null;
						&debug('.AddListPayCardOver -- '||ACCOUNT_CT.[MAIN_V_ID]||' Сбрасываем ФО по КТ '||DOCUMENT.[PRODUCT_CT].[FACT_OPER].[CODE]||'-'||DOCUMENT.[PRODUCT_CT].[FACT_OPER].[SYS_NAME],dp)	
					end if;
				elsif not IT_DT and P_MESS='END' then
					if DOCUMENT%state='PROV' then
						flAddListOper:=true;
						&debug('.AddListPayCardOver -- Документ проведен. Проверяем, нужно ли его добавлять в ФО',dp)
						for lp in TmpOver.[LIST_PAY] where lp.[DOC]%id=DOCUMENT%id and lp.[OPER]=::[VID_OPER_DOG]([CODE]='ГАШЕН_УЧТЕН_ПРОЦ') loop flAddListOper:=false; exit; end loop;
						if flAddListOper then
							
							for lp in TmpOver.[LIST_PAY] where lp.[OPER]=::[VID_OPER_DOG]([CODE]='ГАШЕН_УЧТЕН_ПРОЦ') order by nvl(lp.[END_DATE],lp.[DATE]) desc
							loop
								d_beg:=nvl(lp.[END_DATE],lp.[DATE]);
								if d_beg is not null then d_beg:=d_beg+1; end if;
								exit;
							end loop;
							if d_beg is null then d_beg:=nvl(TmpOver.[DATE_BEGINING],TmpOver.[DATE_BEGIN]); end if;
							d_end:=DATEFUN.Eom(DOCUMENT.[DATE_PROV]);
							if d_end>TmpOver.[DATE_ENDING] then d_end:=TmpOver.[DATE_ENDING]; end if;
							&debug('.AddListPayCardOver -- Определили период '||to_char(d_beg,fmt)||'-'||to_char(d_end,fmt)||'. Пробуем добавить ФО с "Пресчитывать %" и "Перепланировать"',dp)
							
							TmpOver.[LIST_PAY].[NEW#AUTO](
							 DOCUMENT.[DATE_PROV]	--Дата
							,::[VID_OPER_DOG]([CODE]='ГАШЕН_УЧТЕН_ПРОЦ')	--Операция
							,DOCUMENT.[SUM]	--Сумма в валюте договора
							,null		--Валюта операции
							,DOCUMENT	--Документ
							,d_beg		--Дата начала периода
							,d_end		--Дата окончания периода
							,null		--Сумма в валюте учёта
							,true		--Пресчитывать %
							,true);		--Перепланировать
							::[CL_PRIV].[PSH_DATE_DEATH].UniLog(Substr('Документ ID:'||DOCUMENT%id||' Добавлен как ГАШЕН_УЧТЕН_ПРОЦ в ФО '||TmpOver%class||'.'||TmpOver%Id,1,350),
								Rpad('CardOver',10),'_'||&METHOD$SNAME||'.log');
								
							if DOCUMENT.[PRODUCT_CT].[ACC_PROD] is null then
								DOCUMENT.[PRODUCT_CT].[ACC_PROD]:=TmpOver;
								&debug('.AddListPayCardOver -- '||ACCOUNT_CT.[MAIN_V_ID]||' Пропишем продукт по КТ',dp)	
							end if;
						else
							&debug('.AddListPayCardOver -- Добавлять не нужно. Уже есть в ФО',dp)
						end if;
					end if;
					if ACCOUNT_CT.[TO_PRODUCT] is null then
						ACCOUNT_CT.[TO_PRODUCT]:=::[ACC_PRODUCT]([CODE]='PR_CRED');
						&debug('.AddListPayCardOver -- '||ACCOUNT_CT.[MAIN_V_ID]||' Прописываем отношение счета к продукту '||ACCOUNT_CT.[TO_PRODUCT].[CODE],dp)	
					end if;
				end if;
			end if;
		end if;
		&debug('.AddListPayCardOver -- (2)'||fp%class||'.'||fp%id||'.'||fp%state||' {'||fp.[DOCS_IN_FOLD]%size(0)||'}'||' ФО{'||TmpOver.[LIST_PAY]%size(0)||'}',dp)
		if not IT_DT and P_MESS='END' and fp%state='FFORM' and DOCUMENT%state='PROV' then
			&debug('.AddListPayCardOver -- Откорректируем статус папки, если в ней все Ok',dp)
			var ID_FP string(1000);
			var Err boolean;
			::[FOLDER_PAY].[PSH_TO_FORM].ProvIfAllDocProv(fp,ID_FP,Err);
			&debug('.AddListPayCardOver -- (3)'||fp%class||'.'||fp%id||'.'||fp%state||' {'||fp.[DOCS_IN_FOLD]%size(0)||'}'||' ФО{'||TmpOver.[LIST_PAY]%size(0)||'}',dp)
		end if;
	end if;
end;

function Get2Inn (sNAME in [SBRF_NAME]) return string(100) is
n number;
sINN string(100);
begin
	sNAME:=UPPER(trim(sNAME));	--Попов Владимир Александрович ИНН 744713670722
	n:=InStr(sNAME,'ИНН');
	if n>0 then
		sINN:=SubStr(trim(Substr(sNAME,n+3)),1,sINN%size);
	end if;
	return sINN;
end;

function Get1Name(sNAME in [SBRF_NAME]) return [SBRF_NAME] is
n number;
sExt [SBRF_NAME];
begin
	sExt:=UPPER(trim(sNAME));		--Феткулова Мянсуровна Гульнара (Доверенное лицо: Андрейчук Марина Филипповна)
	if SubStr(sExt,Length(sExt))=')' then
		n:=InStr(sNAME,'(');
		if n>0 then
			sExt:=trim(Substr(sExt,1,n-1));
			sExt:=trim(sExt,'.');	--OSTUM SP.Z.O.O. (ООО "ОСТУМ", ранее - ООО "ДДС ПАУЭР")
		end if;
	end if;

	n:=nvl(InStr(sNAME,'ИНН '),0);				--Рогачева Ольга Алексеевна. ИНН 502209198102 не путать с Басс Инна Валерьевна
	if n=0 then n:=nvl(InStr(sNAME,'ИНН1'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН2'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН3'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН4'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН5'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН6'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН7'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН8'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН9'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН0'),0); end if;
	if n>0 then
		sExt:=trim(Substr(sExt,1,n-1));
		sExt:=trim(sExt,'.');
	end if;
	
	return trim(sExt);
end;

function Get2Name(sNAME in [SBRF_NAME]) return [SBRF_NAME] is
n number;
sExt [SBRF_NAME];
begin
	sExt:=UPPER(trim(sNAME));		
	if SubStr(sExt,Length(sExt))=')' then
		n:=InStr(sNAME,'(');
		if n>0 then
			sExt:=trim(Substr(sExt,n));
			sExt:=trim(trim(sExt,'('),')');
			sExt:=Replace(sExt,'ДОВЕРЕННОЕ ЛИЦО:');	--Феткулова Мянсуровна Гульнара (Доверенное лицо: Андрейчук Марина Филипповна)
			sExt:=Replace(sExt,'ДОВ-ОЕ ЛИЦО'); 		--Андрейчук Марина Филипповна (дов-ое лицо Феткулова Мянсуровна Гульнара)
			sExt:=trim(sExt,':');
		end if;
	end if;

	n:=nvl(InStr(sNAME,'ИНН '),0);				--Рогачева Ольга Алексеевна. ИНН 502209198102 не путать с Басс Инна Валерьевна
	if n=0 then n:=nvl(InStr(sNAME,'ИНН1'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН2'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН3'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН4'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН5'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН6'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН7'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН8'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН9'),0); end if;
	if n=0 then n:=nvl(InStr(sNAME,'ИНН0'),0); end if;
	if n>0 then
		sExt:=null;
	end if;
	
	return trim(sExt);
end;

public function CheckKPP(md ref [MAIN_DOCUM], p_date date default null, flPragmaError boolean default null) return boolean is 
tmpKPP string(100);
msg    string(100);
msgAdd string(2000);
v_date date:= nvl(p_date, [SYSTEM].[VARIABLES].OpDate);
begin
	for i in 1..2 loop
		if i=1 then	tmpKPP:=iif(md.[KL_DT].[0]=1,md.[KL_DT].[1].[1].[KPP],md.[KL_DT].[2].[KPP]); msg:='КПП Плательщика "'||tmpKPP||'"';
		else		tmpKPP:=iif(md.[KL_KT].[0]=1,md.[KL_KT].[1].[1].[KPP],md.[KL_KT].[2].[KPP]); msg:= 'КПП Получателя "'||tmpKPP||'"';
		end if;
		
		if tmpKPP is not null then
			if Length(tmpKPP)<>length(trim(tmpKPP)) then
				msgAdd:=msgAdd||msg||' содержит пробел(ы)'||LF$;
			end if;
			if tmpKPP<>'0' and Length(tmpKPP)<>9 then
				msgAdd:=msgAdd||'Длина '||msg||' не равна девяти символам!'||LF$;
			end if;
			/** /
			if not [MAIN_DOCUM]::[MD_FUN].Check_KPP(md.[KL_DT]) then
				msgAdd := msgAdd||'Не неправильно проставлен '||msg||LF$;
			end if;
			/**/
		end if;
	end loop;

	-- плательщик
	/** /
	if not [MAIN_DOCUM]::[MD_FUN].Check_KPP(md.[KL_DT]) then
		msgAdd := trim(msgAdd||' Не проставлен или неправильно проставлен КПП плательщика')||LF$;
	end if;
	-- получатель
	if not [MAIN_DOCUM]::[MD_FUN].Check_KPP(md.[KL_KT]) then
		msgAdd := trim(msgAdd||' Не проставлен или неправильно проставлен КПП получателя')||LF$;
	end if;
	-- бюджетные реквизиты
	msgAdd := trim(msgAdd||' '||[MAIN_DOCUM]::[FILL_BUD_REQ].Check_Req(md.[BUD_REQS], false, p_date == v_date));
	/**/
	
	if Length(msgAdd)>0 then
		--[ПСБ] Жесткость конроля КПП в платежном документе
		if flPragmaError is null then
			flPragmaError:=nvl(::[FP_TUNE].[LIB].get_bool_value('PSB_CHECK_KPP', null, false),false);
		end if;
		&debug('.flPragmaError -- flPragmaError='||flPragmaError||' '||msgAdd,dp2)
		if flPragmaError then
			pragma error (msgAdd);
			return false;
		else				
			stdio.put_line_buf(msgAdd);
			return false;
		end if;
	end if;
	return true;
end;

--Башкиров В.Г. 17.01.2020 Уточняем методику работы с PSH_BLACK_UL-[ПСБ] Блэк список ЮЛ PSH_BLACK_FL-[ПСБ] Блэк список ФЛ
public function CheckBlack(DOCUMENT ref [MAIN_DOCUM]) return varchar2(2000) is 
INN_KL_DT 			  string(100); NAME_KL_DT 		      [PAYER_NAME];
INN_KL_KT 			  string(100); NAME_KL_KT 		      [PAYER_NAME];
INN_ACC_DT_CLIENT_V   string(100); NAME_ACC_DT_CLIENT_V   [PAYER_NAME];
INN_ACC_KT_CLIENT_V   string(100); NAME_ACC_KT_CLIENT_V   [PAYER_NAME];
INN_ACC_DT_CLIENT_R   string(100); NAME_ACC_DT_CLIENT_R   [PAYER_NAME];
INN_ACC_KT_CLIENT_R   string(100); NAME_ACC_KT_CLIENT_R   [PAYER_NAME];
INN_2_KL_DT 		  string(100); NAME_2_KL_DT 		  [PAYER_NAME];
INN_2_KL_KT 		  string(100); NAME_2_KL_KT 		  [PAYER_NAME];
INN_2_ACC_DT_CLIENT_V string(100); NAME_2_ACC_DT_CLIENT_V [PAYER_NAME];
INN_2_ACC_KT_CLIENT_V string(100); NAME_2_ACC_KT_CLIENT_V [PAYER_NAME];
INN_2_ACC_DT_CLIENT_R string(100); NAME_2_ACC_DT_CLIENT_R [PAYER_NAME];
INN_2_ACC_KT_CLIENT_R string(100); NAME_2_ACC_KT_CLIENT_R [PAYER_NAME];
Tmp_Inn  string(100); Tmp1Name [PAYER_NAME];
Tmp2Inn  string(100); Tmp2Name [PAYER_NAME];
temp varchar2(2000);
timeStart number;	 --Башкиров В.Г. 17.01.2020 Для расчета времени выполнения HOOKa
UpNazn ::[MAIN_DOCUM].[NAZN]%type;

InnStr string(2000);
NameStr string(4000);
KeyStr string(200);
begin
	timeStart:=utils.get_time;
	
	temp:=null;
	INN_KL_DT            :=nvl(trim(DOCUMENT.[KL_DT].[1].[1].[INN]),trim(DOCUMENT.[KL_DT].[2].[INN]));
	INN_KL_KT            :=nvl(trim(DOCUMENT.[KL_KT].[1].[1].[INN]),trim(DOCUMENT.[KL_KT].[2].[INN]));
	INN_ACC_DT_CLIENT_V  :=trim(DOCUMENT.[ACC_DT].[CLIENT_V].[INN]);
	INN_ACC_KT_CLIENT_V  :=trim(DOCUMENT.[ACC_KT].[CLIENT_V].[INN]);
	INN_ACC_DT_CLIENT_R  :=trim(DOCUMENT.[ACC_DT].[CLIENT_R].[INN]);
	INN_ACC_KT_CLIENT_R  :=trim(DOCUMENT.[ACC_KT].[CLIENT_R].[INN]);

	NAME_KL_DT           :=Upper(nvl(trim(DOCUMENT.[KL_DT].[1].[1].[NAME]),trim(DOCUMENT.[KL_DT].[2].[2])));
	NAME_KL_KT           :=Upper(nvl(trim(DOCUMENT.[KL_KT].[1].[1].[NAME]),trim(DOCUMENT.[KL_KT].[2].[2])));
	NAME_ACC_DT_CLIENT_V :=Upper(trim(DOCUMENT.[ACC_DT].[CLIENT_V].[NAME]));
	NAME_ACC_KT_CLIENT_V :=Upper(trim(DOCUMENT.[ACC_KT].[CLIENT_V].[NAME]));
	NAME_ACC_DT_CLIENT_R :=Upper(trim(DOCUMENT.[ACC_DT].[CLIENT_R].[NAME]));
	NAME_ACC_KT_CLIENT_R :=Upper(trim(DOCUMENT.[ACC_KT].[CLIENT_R].[NAME]));

	&debug('.CheckBlack -- INN_KL_DT           ='||INN_KL_DT           ,dp2)			
	&debug('.CheckBlack -- INN_KL_KT           ='||INN_KL_KT           ,dp2)			
	&debug('.CheckBlack -- INN_ACC_DT_CLIENT_V ='||INN_ACC_DT_CLIENT_V ,dp2)			
	&debug('.CheckBlack -- INN_ACC_KT_CLIENT_V ='||INN_ACC_KT_CLIENT_V ,dp2)			
	&debug('.CheckBlack -- INN_ACC_DT_CLIENT_R ='||INN_ACC_DT_CLIENT_R ,dp2)			
	&debug('.CheckBlack -- INN_ACC_KT_CLIENT_R ='||INN_ACC_KT_CLIENT_R ,dp2)			

	&debug('.CheckBlack -- NAME_KL_DT          ='||NAME_KL_DT          ,dp2)			
	&debug('.CheckBlack -- NAME_KL_KT          ='||NAME_KL_KT          ,dp2)			
	&debug('.CheckBlack -- NAME_ACC_DT_CLIENT_V='||NAME_ACC_DT_CLIENT_V,dp2)			
	&debug('.CheckBlack -- NAME_ACC_KT_CLIENT_V='||NAME_ACC_KT_CLIENT_V,dp2)			
	&debug('.CheckBlack -- NAME_ACC_DT_CLIENT_R='||NAME_ACC_DT_CLIENT_R,dp2)			
	&debug('.CheckBlack -- NAME_ACC_KT_CLIENT_R='||NAME_ACC_KT_CLIENT_R,dp2)			

	&debug('.CheckBlack -- PSH_BLACK_UL',dp)
	for (select fail(fail%id:C_ID, fail.[ISKL]:C_ISKL, trim(fail.[INN]):C_INN, fail.[NAME]:C_NAME, fail.[IN_FAIL].[LIST_TYPE]:C_LT) in ::[PSH_BLACK_UL]) loop
		if fail.C_ISKL then null;
		else
			Tmp_Inn :=fail.C_INN; 	
			Tmp2Inn :=Get2Inn (fail.C_NAME);
			Tmp1Name:=Get1Name(fail.C_NAME);
			Tmp2Name:=Get2Name(fail.C_NAME);

		  --&debug('.CheckBlack -- ID='||fail||' Tmp_Inn ='||Tmp_Inn ||' Tmp2Inn ='||Tmp2Inn||' Tmp1Name='||Tmp1Name||' Tmp2Name='||Tmp2Name,dp2)
			InnStr:=null;
			NameStr:=null;
			if Tmp_Inn is not null or Tmp2Inn is not null then
	 			if INN_KL_DT            in (Tmp_Inn, Tmp2Inn)  then InnStr :=SUbStr(InnStr||'ИНН '||INN_KL_DT           ||' из Реквизитов по Дт;',       1,InnStr%size);end if;
				if INN_KL_KT            in (Tmp_Inn, Tmp2Inn)  then InnStr :=SUbStr(InnStr||'ИНН '||INN_KL_KT           ||' из Реквизитов по Кт;',       1,InnStr%size);end if;
				if INN_ACC_DT_CLIENT_V  in (Tmp_Inn, Tmp2Inn)  then InnStr :=SUbStr(InnStr||'ИНН '||INN_ACC_DT_CLIENT_V ||' Владельца счета по Дт;',     1,InnStr%size);end if;
				if INN_ACC_KT_CLIENT_V  in (Tmp_Inn, Tmp2Inn)  then InnStr :=SUbStr(InnStr||'ИНН '||INN_ACC_KT_CLIENT_V ||' Владельца счета по Кт;',     1,InnStr%size);end if;
				if INN_ACC_DT_CLIENT_R  in (Tmp_Inn, Tmp2Inn)  then InnStr :=SUbStr(InnStr||'ИНН '||INN_ACC_DT_CLIENT_R ||' Клиента для расчетов по Дт;',1,InnStr%size);end if;
				if INN_ACC_KT_CLIENT_R  in (Tmp_Inn, Tmp2Inn)  then InnStr :=SUbStr(InnStr||'ИНН '||INN_ACC_KT_CLIENT_R ||' Клиента для расчетов по Кт;',1,InnStr%size);end if;
			end if;
			if NAME_KL_DT           in (Tmp1Name,Tmp2Name) then NameStr:=SUbStr(NameStr||'НАИМЕНОВАНИЕ "'||NAME_KL_DT          ||'" Клиента по Дт;',             1,NameStr%size);end if;
			if NAME_KL_KT           in (Tmp1Name,Tmp2Name) then NameStr:=SUbStr(NameStr||'НАИМЕНОВАНИЕ "'||NAME_KL_KT          ||'" Клиента по Кт;',             1,NameStr%size);end if;
			if NAME_ACC_DT_CLIENT_V in (Tmp1Name,Tmp2Name) then NameStr:=SUbStr(NameStr||'НАИМЕНОВАНИЕ "'||NAME_ACC_DT_CLIENT_V||'" Владельца счета по Дт;',     1,NameStr%size);end if;
			if NAME_ACC_KT_CLIENT_V in (Tmp1Name,Tmp2Name) then NameStr:=SUbStr(NameStr||'НАИМЕНОВАНИЕ "'||NAME_ACC_KT_CLIENT_V||'" Владельца счета по Кт;',     1,NameStr%size);end if;
			if NAME_ACC_DT_CLIENT_R in (Tmp1Name,Tmp2Name) then NameStr:=SUbStr(NameStr||'НАИМЕНОВАНИЕ "'||NAME_ACC_DT_CLIENT_R||'" Клиента для расчетов по Дт;',1,NameStr%size);end if;
			if NAME_ACC_KT_CLIENT_R in (Tmp1Name,Tmp2Name) then NameStr:=SUbStr(NameStr||'НАИМЕНОВАНИЕ "'||NAME_ACC_KT_CLIENT_R||'" Клиента для расчетов по Кт;',1,NameStr%size);end if;
			if ((InnStr is not null and
			    (Tmp_Inn is not null or Tmp2Inn is not null) and
				(INN_KL_DT is not null or INN_KL_KT is not null or INN_ACC_DT_CLIENT_V is not null or INN_ACC_KT_CLIENT_V is not null or INN_ACC_DT_CLIENT_R is not null or INN_ACC_KT_CLIENT_R)
				)
	 			and
	 		   (NameStr is not null and
	 		    (Tmp1Name is not null or Tmp2Name is not null) and
                (NAME_KL_DT is not null or NAME_KL_KT is not null or NAME_ACC_DT_CLIENT_V is not null or NAME_ACC_KT_CLIENT_V is not null or NAME_ACC_DT_CLIENT_R is not null or NAME_ACC_KT_CLIENT_R)
				))
	 		   or
			   ((InnStr is null and
			    (Tmp_Inn is null and Tmp2Inn is null) --and
			  --(INN_KL_DT is null or INN_KL_KT is null or INN_ACC_DT_CLIENT_V is null or INN_ACC_KT_CLIENT_V is null or INN_ACC_DT_CLIENT_R is null or INN_ACC_KT_CLIENT_R)
				)
	 			and
	 		   (NameStr is not null and
	 		    (Tmp1Name is not null or Tmp2Name is not null) and
                (NAME_KL_DT is not null or NAME_KL_KT is not null or NAME_ACC_DT_CLIENT_V is not null or NAME_ACC_KT_CLIENT_V is not null or NAME_ACC_DT_CLIENT_R is not null or NAME_ACC_KT_CLIENT_R)
				))
	 		
	 		then
				--Башкиров В.Г. 03.02.2020 Уточнено проверка по назначению платежа для PSH_BLACK_UL-[ПСБ] Блэк список ЮЛ PSH_BLACK_FL-[ПСБ] Блэк список ФЛ
				UpNazn:=Upper(DOCUMENT.[NAZN]);
				KeyStr:=null;
				if UpNazn like '%ИСП%ЛИСТ%' then KeyStr:=KeyStr||'%ИСП%ЛИСТ%;'; end if;
				if UpNazn like '%РЕШ%СУД%'  then KeyStr:=KeyStr||'%РЕШ%СУД%;';  end if;
				if UpNazn like '%ПРИСТАВ%'  then KeyStr:=KeyStr||'%ПРИСТАВ%;';  end if;
				if UpNazn like '%ФССП%'     then KeyStr:=KeyStr||'%ФССП%;';     end if;
				if UpNazn like '%И/Л%'      then KeyStr:=KeyStr||'%И/Л%;';      end if;
				if UpNazn like '%ВЗЫСК%'    then KeyStr:=KeyStr||'%ВЗЫСК%;';    end if;
				if UpNazn like '%НОТАР%'    then KeyStr:=KeyStr||'%НОТАР%;';    end if;
				if UpNazn like '%ДОЛЖНИК%'  then KeyStr:=KeyStr||'%ДОЛЖНИК%;';  end if;
				if KeyStr is not null or NameStr is not null then
					KeyStr:=trim(KeyStr,';');
					NameStr:=trim(NameStr,';');		
					temp:=SubStr(temp||' '||NameStr||' '||InnStr||' в документе входит в чёрный список '||
					fail.C_LT||'(ID'||fail.C_ID||'). В назначении есть "'||KeyStr||'". Сообщите ответственному;'||CHR(13),1,temp%size);
					&debug(temp,dp)			
				end if;
			end if;
		end if;
	end loop;
	&debug('.CheckBlack -- Закончили проверку по PSH_BLACK_UL:'||to_char(sysdate,'hh24:mm:ss')||' ('||GetTimeInterval(utils.get_time,timeStart)||'сотыхСек.)',dp)
	
	&debug('.CheckBlack -- PSH_BLACK_FL',dp)
	for (select fail(fail.[ISKL]:C_ISKL, fail.[FIO]:C_FIO, fail.[IN_FAIL].[LIST_TYPE]:C_LT) in ::[PSH_BLACK_FL]) loop
		if fail.C_ISKL then null;
		else
			Tmp1Name:=Get1Name(fail.C_FIO);
			Tmp2Name:=Get2Name(fail.C_FIO);

			&debug(Tmp1Name,dp2)			
			&debug(Tmp2Name,dp2)			

			if NAME_KL_DT           in (Tmp1Name,Tmp2Name)
			or NAME_KL_KT           in (Tmp1Name,Tmp2Name)
			or NAME_ACC_DT_CLIENT_V in (Tmp1Name,Tmp2Name)
			or NAME_ACC_KT_CLIENT_V in (Tmp1Name,Tmp2Name)
			or NAME_ACC_DT_CLIENT_R in (Tmp1Name,Tmp2Name)
			or NAME_ACC_KT_CLIENT_R in (Tmp1Name,Tmp2Name)
			then			
				temp:=SubStr(temp||'ФИО "'||fail.C_FIO||'" в этом документе входит в Чёрный список с типом '||
				fail.C_LT||'- сообщите об этом ответственному лицу;'||CHR(13),1,temp%size);
				&debug(temp,dp)			
			end if;
		end if;
	end loop;
	
	&debug('.CheckBlack -- Закончили проверку по PSH_BLACK_FL:'||to_char(sysdate,'hh24:mm:ss')||' ('||GetTimeInterval(utils.get_time,timeStart)||'сотыхСек.)',dp)
	return temp;
end;

-- KAS 29/06/2020  по задаче Шмидт для отправки в письме всех случаев отказа
-- проверка реквизитов плательщика\получателя платежного документа по спр. Реестр отказов. Случаи отказа в выполнении операции, отказа от заключения договора счета, расторжения договора счета (+ формирование текста с перечнем случаев отказа)
function Check_Doc_550P_all_cases(p_cl [REQ_CLIENT], cases in out varchar2(1024)) return boolean
is
ret boolean;
deny_cl ref [DENY_LIST];
tmpInn [STRING_16];
cnt integer;
begin
	gDENY_CODE:=null;
	gDENY_DATE:=null;

	tmpInn:=trim(p_cl.[2].[INN]);
	&debug('.Check_Doc_550P -- Поиск по спр. Реестр отказов. Случаи отказа '||p_cl.[1].[1].[NAME]||' ИНН="'||tmpInn||'"',dp2)
	if p_cl.[1].[1] is not null then -- если есть ссылка на клиента
		null;
		if tmpInn is null then
			tmpInn:=trim(p_cl.[1].[1].[INN]);
			&debug('.Check_Doc_550P -- ИНН у Клиента='||tmpInn,dp2)
		end if;
	end if;
	
	cnt := 0;
	if nvl(trim(p_cl.[2].[INN]),trim(tmpInn)) is not null then
		if to_char(to_number(nvl(trim(p_cl.[2].[INN]),trim(tmpInn))))!='0' then
			for
				(select deny_cl(deny_cl.[MEMBER].[INN] : C_MEMBER_INN, deny_cl.[DENY_CODE] : C_DENY_CODE, deny_cl.[DENY_DATE] : C_DENY_DATE) in ::[DENY_LIST]
				where trim(deny_cl.[MEMBER].[INN]) = nvl(trim(p_cl.[2].[INN]),trim(tmpInn))
					and deny_cl%statename='Действует' order by deny_cl.[DENY_DATE] desc)
			loop
				gDENY_CODE:=deny_cl.C_DENY_CODE;
				gDENY_DATE:=deny_cl.C_DENY_DATE;
				&debug('.Check_Doc_550P -- deny_cl.[MEMBER].[INN]='||deny_cl.C_MEMBER_INN||' gDENY_CODE='||gDENY_CODE||' gDENY_DATE='||to_char(gDENY_DATE,fmt),dp2)
				cnt := cnt + 1;
				ret := true;
				if cnt=6 then
					cases := Substr(cases||NL$||' ...',1,cases%size);
					exit;
				end if;
				if cnt=1 then
					cases := Substr(            ' Дата отказа '||to_char(gDENY_DATE,fmt)||'. Код отказа "'||gDENY_CODE||'"',1,cases%size);
				else
					cases := Substr(cases||NL$||' Дата отказа '||to_char(gDENY_DATE,fmt)||'. Код отказа "'||gDENY_CODE||'"',1,cases%size);
				end if;
			end loop;
		end if;
	end if;
	
	if Length(cases)=cases%size then
		cases:=Substr(cases,1,cases%size-4)||'...';
	end if;
	
	cases := Substr(cases||NL$,1,cases%size);
	&debug('.Check_Doc_550P -- cases='||cases,dp2)
	&debug('.Check_Doc_550P -- ret='||ret,dp2)
	return nvl(ret,false);	
end;
MD_FOR_PROV_CP_1 (
	@name('Документ')                   DOCUMENT   in     [MAIN_DOCUM_REF],
	@name('Счет дебета')                ACCOUNT_DT in     [AC_FIN_REF],
	@name('Счет кредита')               ACCOUNT_CT in     [AC_FIN_REF],
	@name('Признак счета дебета')       IT_DT      in     [BOOLEAN],
	@name('Признак успешности анализа') ANALYSE_OK in out [BOOLEAN],
	@name('Дополнительные параметры')   P_ADDS     in out [STRING_32000],
	@name('Тип вызова')                 P_MESS     in     [STRING_100]
) is

execute is
first_sign number;
message_text varchar2(32000);
blizko boolean;
f1 number:=0;
nalichie number:=0;
pomen boolean;
usr ref [USER]:=STDLIB.USERID;
temp varchar2(2000);
adress_001 ref [PSH_EMAIL_RASSIL];
adress_101 ref [PSH_EMAIL_RASSIL];
p_text  varchar2(2000);

vPSB_ADD_LISTPAY_CARDOVER boolean;
vPSB_AUTO_PROCESS boolean;
timeStart number;	 --Башкиров В.Г. 17.01.2020 Для расчета времени выполнения HOOKa
v550p_cases varchar2(1024); --512 KAS 29/06/2020  по задаче Шмидт для отправки в письме всех случаев отказа

md 			ref [MAIN_DOCUM];
fp 			ref [FOLDER_PAY];
oDOCUMENT   [MAIN_DOCUM];
h_state     [HISTORY_STATES];
FlOk 		boolean;
v_date_doc	date;
v_cnt_days  integer;
v_cl_priv	ref [CL_PRIV]; 
rko_dt		ref [RKO];

aux_ctrl_accept ref [AUX_CTRL_ACCEPT];

begin

timeStart:=utils.get_time;
&debug(utils.call_stack, dp2)
&debug('Старт:'||to_char(sysdate,'hh24:mm:ss')||' DOCUMENT='||DOCUMENT%class||'.'||DOCUMENT%id||'.'||DOCUMENT%state||' ACCOUNT_DT='||ACCOUNT_DT.[MAIN_V_ID]||' ACCOUNT_CT='||ACCOUNT_CT.[MAIN_V_ID]||' IT_DT='||IT_DT||' ANALYSE_OK='||ANALYSE_OK||' P_ADDS='||P_ADDS||' P_MESS='||P_MESS,dp)

--Башкиров В.Г. 04.03.2026 CFT-3697 Стоп дебет ФЛ (исходящие)
--Башкиров В.Г. 14.04.2026 CFT-3896 Выплата % клиентам
if P_MESS='BEGIN' then
	::[HOOK_BANK].[MD_CHKREQ_CP_1].CFT_3697(DOCUMENT, P_ADDS);
end if;

&debug('Проверка КПП', dp)
--::[HOOK_BANK].[MD_FOR_PROV_CP_1].CheckKPP(DOCUMENT);
rko_dt := ::[RKO].[LIB_RKO].get_rko_on_acc(DOCUMENT.[ACC_DT]);
if P_MESS='END' then
	V_MD_FOR_PROV := null;	
end if;

	-- by smith 29/05/2025 via CFT-38
    v_NoSystemDoc := ::[DOCUMENT_INT].[PRX_END_OD].GET_EOD_DATE_OP is null;
/*
    if P_MESS='BEGIN'
    and DOCUMENT%state = 'FORM' 
    and ::[DOCUMENT].[DOC_LIB].check_history_state(DOCUMENT, 'FEEDS_CHECKED')
    and ::[DOCUMENT].[DOC_LIB].check_history_state(DOCUMENT, 'PROV')    
    then        

        ::[DOCUMENT].[DOC_LIB].del_history_state(DOCUMENT, 'FEEDS_CHECKED');
        --stdio.put_line_buf(message_text||' Сняли признак пройденной проверки на ФИДЫ');           
            
    end if;
*/
    if P_MESS='BEGIN' 
        and DOCUMENT%state = 'AUX_CTRL'
        and v_NoSystemDoc -- несистемный документ  - проверим права 
        and not (nvl(::[FP_TUNE].[LIB].get_bool_value('CB_CONTEXT_CONTROL'),false) and nvl(app_security.check_job,false)) -- и не (включена настройка и операция запущена джобом)
        and not nvl(::[DOCUMENT].[RIGHTS].[CHECKTRANLOW](DOCUMENT%class, DOCUMENT%state, 'PROV', stdlib.userid),true)
        and USER not in ('PAY_GATE', 'PAY_GATE2') then
        

        message_text:='У пользователя '||USER||' нет права на переход из "'||lib.state_name(DOCUMENT%state, DOCUMENT%class)||'" и на редактирование документа в этом статусе';
        DOCUMENT.[TEXT_VOZV] := message_text;
	    ANALYSE_OK := false;
	    
	    --stdio.put_line_buf(message_text);
	    pragma error(message_text);
        --WarningSend(message_text, DOCUMENT, DOCUMENT.[KL_KT]);
	    
    end if;

    /*end*/  

if [FP_TUNE]::[LIB].get_bool_value('PSH_CHECK_DOC_550P', [FP_TUNE]::[LIB].set_canons('BRANCH', DOCUMENT.[DEPART]->[FILIAL]) ) and DOCUMENT%class = 'MAIN_DOCUM' then
	&debug('PSH_CHECK_DOC_550P='||'1', dp2)
	if P_ADDS like ('%BANK_FOR_PROV%BEFORE%') and P_ADDS not like ('%NEXT_CALL%') and P_ADDS like ('%DT_KT_OUT%0%')  then
		
		if Doc_is_Checked(DOCUMENT) = false then --если не указан признак пройденной проверки
			if Check_Doc_550P_all_cases(DOCUMENT.[KL_DT], v550p_cases) -- KAS 29/06/2020  по задаче Шмидт для отправки в письме всех случаев отказа
			and (DOCUMENT.[KOD_NAZN_PAY] is null or DOCUMENT.[KOD_NAZN_PAY]<>::[KOD_N_PAY]([KOD_NAZN]='РКО_КОМИССИЯ')) --Башкиров В.Г. 28.10.2022 Комиссии пропускаем
			then 
				WarningSend('Клиент по ДТ фигурирует в справочнике случаев отказа по 764-П:'||v550p_cases||'Проводка документа приостановлена.', DOCUMENT, DOCUMENT.[KL_DT]);
			end if;
			if Check_Doc_550P_all_cases(DOCUMENT.[KL_KT], v550p_cases) -- KAS 29/06/2020  по задаче Шмидт для отправки в письме всех случаев отказа
			and (DOCUMENT.[KOD_NAZN_PAY] is null or DOCUMENT.[KOD_NAZN_PAY]<>::[KOD_N_PAY]([KOD_NAZN]='РКО_КОМИССИЯ')) --Башкиров В.Г. 28.10.2022 Комиссии пропускаем
			then 
				WarningSend('Контрагент по KТ фигурирует в справочнике случаев отказа по 764-П:'||v550p_cases||'Проводка документа приостановлена.', DOCUMENT, DOCUMENT.[KL_KT]);
			end if;
		end if;	
		&debug('Закончили проверку по DENY_LIST   :'||to_char(sysdate,'hh24:mm:ss')||' ('||GetTimeInterval(utils.get_time,timeStart)||'сотыхСек.)',dp)
	end if;
end if;

-- 'КАСС_ОБЪЯВ_ВЗНОС'
if ACCOUNT_DT.[CLIENT_V]%CLASS='CL_ORG' and DOCUMENT.[VID_DOC].[CODE] in ('БЕЗН_ПЛ_ПОРУЧ','КАСС_ЧЕК_ВЫДАЧА') and ACCOUNT_DT.[MAIN_V_ID] not like ('60312%')
	then 	
			if P_ADDS like ('%BANK_FOR_PROV%BEFORE%') and P_ADDS not like ('%NEXT_CALL%') then 
				f1 := 1; message_text := 'ВНИМАНИЕ.Срок подписей руководителя у клиента ' || ACCOUNT_DT.[CLIENT_V].[NAME] || ' подходит к концу!' || chr(10); -- Первая проверка по документу
			end if;
			
			&debug('ALL_BOSS',dp)			
			
			first_sign := 0;
			blizko := false;	
			v_date_doc := trunc(DOCUMENT.[DATE_DOC]); 
			v_cnt_days := ::[FP_TUNE].[LIB].GET_NUM_VALUE('CERT_DAYS_AFTER_END', null, '0');
			
			for (select x(x%id :C_ID, 
						  x    :OBJ,
						  nvl(x.[WORK_END], v_date_doc + 500) :C_END, 
						  x.[FASE].[NAME] :C_RUK, 
						  nvl(x.[FASE].[DOC].[DATE_END], v_date_doc + 500) :C_PASP_END,
						  x.[FASE].[DOC].[TYPE].[KOD]		:C_DOC_TYPE,
						  x.[FASE].[DOC].[TYPE].[NAME]		:C_DOC_NAME
						 ) 
				in ACCOUNT_DT.[CLIENT_V]->(CL_ORG)[ALL_BOSS]
				where 	x.[CHIEF]
						and x.[SIGN_TODAY]
						and x.[WORK_BEGIN] <= v_date_doc
						and (x.[WORK_END] >= v_date_doc or x.[WORK_END] is null) -- Кончилась должность
						and (  x.[FASE].[DOC].[DATE_END] >= v_date_doc 
							or x.[FASE].[DOC].[DATE_END] is null
							or (x.[FASE].[DOC].[TYPE] = ::[CERTIFIC_TYPE]([KOD] = '21') and (x.[FASE].[DOC].[DATE_END] + v_cnt_days) >= v_date_doc)
							) --Кончился паспорт
						and not coalesce(::[CL_CHECK_RESULT].[LIB].GET_SUSPECT(x.[FASE], ::[CLIENT_CHECKS]([CODE] = 'INVALID_CERT')), 0) -- Проверка на недействительные удостоверения
								    in (::[P207_TERROR_FLAG]([CODE] = 'CERT_AUTO'), ::[P207_TERROR_FLAG]([CODE] = 'CERT_MANUAL'))
				) 
			loop
				first_sign := first_sign + 1;
		
				if to_date(x.C_END) - v_date_doc < 31 and f1 = 1 then 
					blizko := true;
					message_text := message_text || ::[RUNTIME].[STDLIB].FIO(x.C_RUK) || ' срок полномочий до ' || to_char(x.C_END,'DD.MM.YYYY') || chr(10);
				end if;
				
				if  x.C_DOC_TYPE = '21' and to_date(x.C_PASP_END) + v_cnt_days - v_date_doc < 91 and f1 = 1 then
					blizko := true;
					message_text := message_text || ::[RUNTIME].[STDLIB].FIO(x.C_RUK) || ' паспорт РФ действителен до ' || to_char(x.C_PASP_END + v_cnt_days,'DD.MM.YYYY') || chr(10);
				elsif x.C_DOC_TYPE <> '21' and to_date(x.C_PASP_END) - v_date_doc < 91 and f1 = 1 then
					blizko := true;
					message_text := message_text || ::[RUNTIME].[STDLIB].FIO(x.C_RUK) || ' ' || x.C_DOC_NAME || ' действительно до ' || to_char(x.C_PASP_END,'DD.MM.YYYY') || chr(10);
				end if;
								
			end loop;
			
			if first_sign = 0 then 	
				ANALYSE_OK := false;
				DOCUMENT.[TEXT_VOZV] := 'Нет ни одной действующей подписи руководителя у клиента ' || ACCOUNT_DT.[CLIENT_V].[NAME];
				blizko := false;
			end if;
			
			if blizko then stdio.put_line_buf(message_text);
			end if;
			&debug('Закончили проверку Подписантов    :'||to_char(sysdate,'hh24:mm:ss')||' ('||GetTimeInterval(utils.get_time,timeStart)||'сотыхСек.)',dp)			
end if;

-->> PSB VRI 14/03/2025 CFT-1000 Проверка действительности паспортов в ЦФТ
-- Проверка удостоверения личности по физику

if ACCOUNT_DT.[CLIENT_V]%CLASS='CL_PRIV' and DOCUMENT.[VID_DOC].[CODE] in ('БЕЗН_ПЛ_ПОРУЧ','КАСС_ЧЕК_ВЫДАЧА') and ACCOUNT_DT.[MAIN_V_ID] not like ('60312%')
	then 	
		if P_ADDS like ('%BANK_FOR_PROV%BEFORE%') and P_ADDS not like ('%NEXT_CALL%') then 
			f1 := 1; message_text := 'ВНИМАНИЕ.Срок действия у клиента ' || ACCOUNT_DT.[CLIENT_V].[NAME] || ' подходит к концу!' || chr(10); -- Первая проверка по документу
		end if;
		
		&debug('CL_PRIV_CHECK',dp)			
		
		first_sign := 0;
		blizko := false;	
		v_date_doc := trunc(DOCUMENT.[DATE_DOC]); 
		v_cnt_days := ::[FP_TUNE].[LIB].GET_NUM_VALUE('CERT_DAYS_AFTER_END', null, '0');
		v_cl_priv := ACCOUNT_DT.[CLIENT_V];
		
		if (   v_cl_priv.[DOC].[DATE_END] >= v_date_doc 
			or v_cl_priv.[DOC].[DATE_END] is null
			or (v_cl_priv.[DOC].[TYPE] = ::[CERTIFIC_TYPE]([KOD] = '21') and (v_cl_priv.[DOC].[DATE_END] + v_cnt_days) >= v_date_doc)
		   ) --Кончился паспорт
		   and not coalesce(::[CL_CHECK_RESULT].[LIB].GET_SUSPECT(v_cl_priv, ::[CLIENT_CHECKS]([CODE] = 'INVALID_CERT')), 0) -- Проверка на недействительные удостоверения
							    in (::[P207_TERROR_FLAG]([CODE] = 'CERT_AUTO'), ::[P207_TERROR_FLAG]([CODE] = 'CERT_MANUAL'))
		then
			if  v_cl_priv.[DOC].[TYPE] = ::[CERTIFIC_TYPE]([KOD] = '21') and (v_cl_priv.[DOC].[DATE_END] + v_cnt_days - v_date_doc) < 91 and f1 = 1 then
				blizko := true;
				message_text := message_text || ::[RUNTIME].[STDLIB].FIO(v_cl_priv.[NAME]) || ' паспорт РФ действителен до ' || to_char(v_cl_priv.[DOC].[DATE_END] + v_cnt_days,'DD.MM.YYYY') || chr(10);
			elsif v_cl_priv.[DOC].[TYPE] <> ::[CERTIFIC_TYPE]([KOD] = '21') and (v_cl_priv.[DOC].[DATE_END] + v_cnt_days - v_date_doc) < 91 and f1 = 1 then
				blizko := true;
				message_text := message_text || ::[RUNTIME].[STDLIB].FIO(v_cl_priv.[NAME]) || ' ' || v_cl_priv.[DOC].[TYPE].[NAME] || ' действительно до ' || to_char(v_cl_priv.[DOC].[DATE_END],'DD.MM.YYYY') || chr(10);
			end if;
			first_sign := 1;
		end if;			
			
		if first_sign = 0 then 	
			ANALYSE_OK := false;
			DOCUMENT.[TEXT_VOZV] := 'Недействительно или просрочено удостоверение личности у клиента ' || ACCOUNT_DT.[CLIENT_V].[NAME];
			blizko := false;
		end if;
		
		if blizko then stdio.put_line_buf(message_text);
		end if;
		&debug('Закончили проверку удостоверения личности физ.лица    :'||to_char(sysdate,'hh24:mm:ss')||' ('||GetTimeInterval(utils.get_time,timeStart)||'сотыхСек.)',dp)			
end if;
--<< PSB VRI 14/03/2025 CFT-1000 Проверка действительности паспортов в ЦФТ

--Башкиров В.Г. 17.01.2020 Уточняем методику работы с PSH_BLACK_UL-[ПСБ] Блэк список ЮЛ PSH_BLACK_FL-[ПСБ] Блэк список ФЛ
/** /
if ACCOUNT_DT.[CLIENT_V]%CLASS='CL_ORG' or ACCOUNT_CT.[CLIENT_V]%CLASS='CL_ORG'
	then
			if (P_ADDS like ('%BANK_FOR_PROV%BEFORE%') or P_ADDS like ('%IS_INCOMING%')) and P_ADDS not like ('%NEXT_CALL%') then f1:=1;  -- Первая проверка по документу
			end if;

			temp:=null;
			for fail in ::[PSH_BLACK_UL] where (nvl(trim(DOCUMENT.[KL_DT].[1].[1].[INN]),trim(DOCUMENT.[KL_DT].[2].[INN]))= trim(fail.[INN])
										or nvl(trim(DOCUMENT.[KL_KT].[1].[1].[INN]),trim(DOCUMENT.[KL_KT].[2].[INN]))= trim(fail.[INN])
										or trim(DOCUMENT.[ACC_DT].[CLIENT_V].[INN])=trim(fail.[INN])
										or trim(DOCUMENT.[ACC_KT].[CLIENT_V].[INN])=trim(fail.[INN]))
										and DOCUMENT.[ACC_KT].[MAIN_V_ID] not like ('706%')
										and DOCUMENT.[ACC_DT].[MAIN_V_ID] not like ('706%')
			loop
			temp:=temp||'ИНН "'||fail.[INN]||'" в этом документе входит в Чёрный список с типом '||fail.[IN_FAIL].[LIST_TYPE]||'- сообщите об этом ответственному лицу;'||CHR(13);
			end loop;
			
			if temp is not null and f1=1
			then
				adress_001:=::[PSH_EMAIL_RASSIL]([PSH_EMAIL_COD] = 'LEGALIZ' and [PSH_EMAIL_FIL].[CODE]='001');
				adress_101:=::[PSH_EMAIL_RASSIL]([PSH_EMAIL_COD] = 'LEGALIZ' and [PSH_EMAIL_FIL].[CODE]='101');
				if DOCUMENT.[FILIAL].[CODE]='001' then	::[FP_INTERFACE].[PRX_PCORE].Send_Mail(  --Башкиров В.Г. 17.12.2023
																			 adress_001.[PSH_EMAIL_ADRES]	-- Кому (E-Mail) Можно указать несколько адресов разделенных "точкой с запятой"
																			, 'Документ по черным спискам МСК'	-- Тема	
																			, 'ID='||DOCUMENT%id||' ;'||temp	-- Сообщение
																			, 'IT@pshb.ru'					-- от кого (E-Mail, если пусто, то используется значение DEFAULT_FROM_EMAIL)
																			, false							-- если TRUE, то вылетит ERROR_ON_SEND
																			,null
																			);
				elsif DOCUMENT.[FILIAL].[CODE]='101' then	::[FP_INTERFACE].[PRX_PCORE].Send_Mail(  --Башкиров В.Г. 17.12.2023
																			 adress_101.[PSH_EMAIL_ADRES]	-- Кому (E-Mail) Можно указать несколько адресов разделенных "точкой с запятой"
																			, 'Документ по черным спискам ЭНГ'	-- Тема	
																			, 'ID='||DOCUMENT%id||' ;'||temp	-- Сообщение
																			, 'IT@pshb.ru'					-- от кого (E-Mail, если пусто, то используется значение DEFAULT_FROM_EMAIL)
																			, false							-- если TRUE, то вылетит ERROR_ON_SEND
																			,null
																			);					
				end if;	
				stdio.put_line_buf(temp);
			end if;
end if;	
/**/

/*if not (DOCUMENT.[ACC_KT].[MAIN_V_ID] like ('706%') or DOCUMENT.[ACC_DT].[MAIN_V_ID] like ('706%')) then
	if (P_ADDS like ('%BANK_FOR_PROV%BEFORE%') or P_ADDS like ('%IS_INCOMING%')) and P_ADDS not like ('%NEXT_CALL%') then f1:=1;  -- Первая проверка по документу
		
		temp:=::[HOOK_BANK].[MD_FOR_PROV_CP_1].CheckBlack(DOCUMENT);
		if temp is not null then

			::[CL_PRIV].[PSH_DATE_DEATH].UniLog(
			Substr(temp,1,350),
			Rpad('PSH_BLACK',10),			--тема
			'_'||&METHOD$SNAME||'.log');	--log

			stdio.put_line_buf(temp);
		end if;
	end if;
end if;
*/

if DOCUMENT.[KL_KT].[2].[3].[BANK_STATE].[SHORT_NAME] in ('ОТЗВ') --Справочник "Состояние банка"
  then
	if P_ADDS like ('%BANK_FOR_PROV%BEFORE%') and P_ADDS not like ('%NEXT_CALL%') then message_text:='Внимание караул!'||chr(10)||'Банк находится в состоянии:'||DOCUMENT.[KL_KT].[2].[3].[BANK_STATE].[STATE_NAME]||chr(10); -- Первая проверка по документу
	stdio.put_line_buf(message_text);
	end if;
end if;

if ACCOUNT_CT.[MAIN_V_ID] like ('91203%') then
pomen:=false;
select x (count (x) ) in ::[PSH_RAZR_VN_CEN]all where x.[ACC]=ACCOUNT_CT and x.[WHO_RAZR].[]=usr into nalichie;
	if nalichie>0 then
	
	DOCUMENT.[DOCUMENT_USER]:=usr;
	
		for cen in ::[RICHES_GUIDE] where cen.[CERT].[ACCOUNT]=ACCOUNT_CT loop
		if cen.[USER]=usr then cen.[PSH_KOL_OST_CENN]; pomen:=true;
		end if;
		end loop;
	
		if pomen=false then
			for cen in ::[RICHES_GUIDE] where cen.[CERT].[ACCOUNT]=ACCOUNT_CT loop
			cen.[USER]:=usr;
			cen.[PSH_KOL_OST_CENN];
			exit;
			end loop;
		end if;
		
	end if;
end if;

-->> PSB VRI 24/03/2025 CFT-1248 Контроль реквизитов получателя во внутренних платежах, полученных по ДБО 
if P_MESS='BEGIN'  
	and DOCUMENT%state = 'FORM' 
	and DOCUMENT.[DOCUMENT_USER] = ::[USER]([USERNAME] = 'IBANK')
	and upper(substr(DOCUMENT.[DOCUMENT_UNO], 1, 3)) = 'DBO'
	and (upper(nvl(DOCUMENT.[KL_KT].[2].[2], DOCUMENT.[KL_KT].[1].[1].[NAME])) <> upper(DOCUMENT.[ACC_KT].[CLIENT_V].[NAME]) 
		or nvl(DOCUMENT.[KL_KT].[2].[INN], DOCUMENT.[KL_KT].[1].[1].[INN]) <> DOCUMENT.[ACC_KT].[CLIENT_V].[INN])
	and coalesce(V_MD_FOR_PROV, '0') <> 'check_name_inn'||DOCUMENT%ID
	and substr(DOCUMENT.[ACC_KT].[MAIN_V_ID],1,5) in ('40701','40702','40703','40802','40807','40817','42301','30111','30109','30110')	
then
	V_MD_FOR_PROV := 'check_name_inn'||DOCUMENT%ID;
    message_text:='Неверные реквизиты получателя средств';
    DOCUMENT.[TEXT_VOZV] := message_text;
	ANALYSE_OK := false;
	stdio.put_line_buf(message_text);
end if;
--<< PSB VRI 24/03/2025 CFT-1248 Контроль реквизитов получателя во внутренних платежах, полученных по ДБО

-->> PSB VRI 22/05/2025 CFT-1660 Контроль неактивных клиентов
if P_MESS='BEGIN'  
	and DOCUMENT%state = 'FORM' 
	and rko_dt is not null
	and coalesce(V_MD_FOR_PROV, '0') not like 'check_null_tarifs%' --||DOCUMENT%ID
then
	for (select tp(tp : C_TAR_PLAN) 
		in rko_dt.[TARIF_PLAN] 
			where tp.[DATE_BEGIN] <= ::[SYSTEM].[OP_DATE]
		order by tp.[DATE_BEGIN] desc
		)
	loop
		if tp.C_TAR_PLAN.[TAR_PLAN].[TARIFS]%size(1) = 0 then
			V_MD_FOR_PROV := 'check_null_tarifs '||DOCUMENT%ID;
		    message_text := 'ВНИМАНИЕ! У клиента: ' || rko_dt.[CLIENT].[NAME] || ' по счету РКО ' || rko_dt.[ACCOUNT].[MAIN_V_ID] || ' установлен тарифный план без комиссий!';
		    DOCUMENT.[TEXT_VOZV] := message_text;
			ANALYSE_OK := false;
			stdio.put_line_buf(message_text);
		end if;
		exit;
	end loop;
end if;
--<< PSB VRI 22/05/2025 CFT-1660 Контроль неактивных клиентов

-->> PSB VRI 05/06/2025 CFT-1677 Справочник контрагентов для счета 40821 
if P_MESS='BEGIN' and DOCUMENT%state = 'FORM'
then
	/*debug_pipe('Счет Дт =' || DOCUMENT.[ACC_DT].[MAIN_V_ID],10);
	debug_pipe('Счет плательщика =' || DOCUMENT.[KL_DT].[2].[1],10);
	debug_pipe('ИНН плательщика =' || DOCUMENT.[KL_DT].[2].[INN],10);
	debug_pipe('Наименование плательщика =' || DOCUMENT.[KL_DT].[2].[2],10);

	debug_pipe('Счет Кт =' || DOCUMENT.[ACC_KT].[MAIN_V_ID],10);
	debug_pipe('Счет получателя =' || DOCUMENT.[KL_KT].[2].[1],10);
	debug_pipe('ИНН получателя =' || DOCUMENT.[KL_KT].[2].[INN],10);
	debug_pipe('Наименование получателя =' || DOCUMENT.[KL_KT].[2].[2],10);*/
	
	if DOCUMENT.[ACC_DT].[MAIN_V_ID] like '40821%' and coalesce(DOCUMENT.[KL_KT].[2].[1], DOCUMENT.[ACC_KT].[MAIN_V_ID]) like '40%' then
		if not ::[PSH_KONTR_40821].[PSH_EDIT_AUTO].contr_exists(DOCUMENT.[KL_KT], DOCUMENT.[ACC_DT]) then
	    	pragma error('Контроль счета 40821, получатель отсутствует в справочнике контрагентов!');
	    end if;
	elsif DOCUMENT.[ACC_KT].[MAIN_V_ID] like '40821%' and coalesce(DOCUMENT.[KL_DT].[2].[1], DOCUMENT.[ACC_DT].[MAIN_V_ID]) like '40%' then
		if not ::[PSH_KONTR_40821].[PSH_EDIT_AUTO].contr_exists(DOCUMENT.[KL_DT], DOCUMENT.[ACC_KT]) then
	    	pragma error('Контроль счета 40821, плательщик отсутствует в справочнике контрагентов!');
	    end if;
	end if; 
end if;
--<< PSB VRI 05/06/2025 CFT-1677 Справочник контрагентов для счета 40821

--Кожухарь Светлана Саввична <kozhukhar@pshb.ru> письма 01.11.2018 % по оверу
