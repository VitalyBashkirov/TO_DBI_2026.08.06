-- проверка первого движения по счету
function get_first_move_date(p_acc ref [AC_FIN]) return date is
date_first		date;		-- Дата первого движения по счету
begin
  date_first := null;
	if p_acc is not null then
		select arcm(min(arcm.[DATE])) in p_acc.[ARC_MOVE] into date_first;
  end if;
	return date_first;
end;


-------------------------------------------------------------------------
function GetEditDates(cl_ref [CLIENT_REF], on_date date, upd_date date) return varchar2(200) is
IdClHi	[CL_HIST];
tmp_str varchar2(200);
v_upd_date varchar2(20);

begin
	tmp_str := '';
	v_upd_date := nvl(::[RUNTIME].[FDP].pdat(upd_date,''), '*');
for (
	select distinct cht (cht.[DATE_EDIT] : DATE_EDIT) in ::[CL_HIST]
	where cht.[CLIENT_REF] = cl_ref
	and (trunc(cht.[DATE_EDIT]) <= trunc(on_date))
	order by cht.[DATE_EDIT]
		)
	loop
     tmp_str := tmp_str || '; ' || ::[RUNTIME].[FDP].pdat(cht.[DATE_EDIT],'');
	end loop;
	tmp_str := ltrim(tmp_str);
	tmp_str := ltrim(tmp_str, ';');
	if trunc(upd_date) < trunc(on_date) then
	if instr(tmp_str, v_upd_date) <= 0 then
		tmp_str := tmp_str || '; ' || v_upd_date;
	end if;
	end if;
	tmp_str := ltrim(tmp_str, '*');
	return tmp_str;
end;

-------------------------------------------------------------------------
/** /
function GetEditDates_(cl_ref [CLIENT_REF], on_date date, upd_date date) return varchar2(200) is
IdClHi	[CL_HIST];
tmp_str varchar2(200);
v_upd_date varchar2(20);

begin
	tmp_str := '';
	for dfu in cl_ref.[DATES_FORM_UPD] where dfu.[DATE_UPD] < on_date+1  loop
		tmp_str := tmp_str || '; ' || ::[RUNTIME].[FDP].pdat(dfu.[DATE_UPD],'');
	end loop;
	tmp_str := ltrim(tmp_str, ';');
	return tmp_str;
end;
