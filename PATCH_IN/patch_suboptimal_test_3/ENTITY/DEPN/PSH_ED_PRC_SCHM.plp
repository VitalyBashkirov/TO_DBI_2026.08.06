class DEPN;

@this(create_on_start:=true)
@name('[ПСБ] Редактирование схем начисления %%')
@tag('COPIED')
method PSH_ED_PRC_SCHM is

@name('Журнал начисленных процентов')      public V_JOUR_CALC_PRC [JOUR_CALC_PRC];
@name('Журнал %% по ставке ЦБ')            public V_JOUR_CB_PRC   [JOUR_CALC_PRC];
@name('Журнал рассчитанного налога на %%') public V_JOUR_PRC_TAX  [JOUR_CALC_PRC];
@name('Строка валидатора')                 public V_DEST_STR      [STRING_32000];
PRAGMA INCLUDE([RUNTIME]::[MACRO_LIB]);
PRAGMA INCLUDE([DEBUG_TRIGGER]::[MACRO_LIB]);

cn_ComStatusClose const	ref [COM_STATUS_PRD] := ::[COM_STATUS_PRD]([CODE] = 'CLOSE');
PSH_ED_PRC_SCHM (
	@name('Дата изменения')                                         P_DATE         in [DATE],
	@name('Процентная ставка по договору')                          P_PRC_DOG      in [REF_PRC_SCH],
	@name('Процентная ставка по истечении срока действия договора') P_LAST_PRC     in [REF_PRC_SCH] default null,
	@name('Штрафная процентная ставка')                             P_PENALTY_PRC  in [REF_PRC_SCH] default null,
	@name('Процентная ставка начисления по ставке ЦБ')              P_PRC_REG_RATE in [REF_PRC_SCH] default null,
	@name('Процентная ставка начисления налога на доходы')          P_PRC_NALOG    in [REF_PRC_SCH] default null,
	@name('Сохранить в историю изменение')                          P_SAVE_CHANGE  in [BOOLEAN]     default null,
	@name('Вызов с поднятием формы')                                P_CONSOL       in [BOOLEAN]     default null
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	V_JOUR_CALC_PRC := this.[JOUR_CALC_PRC];
	V_JOUR_CB_PRC := this.[JOUR_CB_PRC];
	V_JOUR_PRC_TAX := this.[JOUR_PRC_TAX];
end if;
-- End initialization of parameters and variables
begin
	if &Default_Mes then
		--P_PRC_DOG		:= this.[PRC_DOG];
		P_PRC_DOG		:= ::[PRC_SCHEME]([COD]='CARD_TP_VKLADCHICK');
		P_LAST_PRC		:= this.[LAST_PRC];
		P_PENALTY_PRC	:= this.[PENALTY_PRC];
		P_PRC_REG_RATE	:= this.[PRC_REG_RATE];
		P_PRC_NALOG		:= this.[PRC_NALOG];

		V_JOUR_CALC_PRC := this.[JOUR_CALC_PRC];
		V_JOUR_CB_PRC	:= this.[JOUR_CB_PRC];
		V_JOUR_PRC_TAX	:= this.[JOUR_PRC_TAX];

		P_SAVE_CHANGE	:= true;
		P_DATE			:= to_date('22122017','ddmmyyyy');
		--P_DATE			:= &sys_var.OpDate;
		P_CONSOL		:= true;
		
		if this.[COM_STATUS] = cn_ComStatusClose then
			pragma error ('Договор находится в состоянии "Закрыт", редактирование схем начисиления %% запрещено!');
		end if;	
	end if;
	
	if ::[DEPN].[LIB_APPLICATION].check_application('1B400215')
	 and nvl(P_PRC_DOG.[P_PRIVATE],false)
	 and this.[VID_DOG].[SCHEME_SEL_WAY] in (&L.sch_choice_recalc, &L.sch_choice_calc, &L.sch_choice_no_calc, &L.sch_choice_period) then
	 	[CSMD].Disable(V_DEST_STR,'P_PRC_DOG');
	end if;
end;
end;

execute is
/*
 * Дата	    Автор       BFS         Описание
 * -------- ----------- ----------- -----------------------------------------------------------------------------
 * 22.09.10 Azaikov     BS00147027  Переназначены представления
 * 24.02.14 ilina		BS00807023  Реализован запрет изменения %% ставки для договоров, подключенных к тарифной подсистеме,
 * 03.10.14 ikuzmina	RP0093752	Поставлена проверка на скрытие контрола P_PRC_DOG в зависимости от установленного приложения 1B400215
 * 20.10.14 mgavrilenko	RP0070196	При проверке подключения депозита к тарифной подсистеме (applToTarSys) удален анализ настройки значения USE_TARIF_SUBSYS, удалена переменная tune
 * 14.04.14 poljakova	RP0489808	Добавлен вывод ошибки, если договор находится в состоянии "Закрыт".
 */
res		number;
CP 		ref [DEPN_COMISS_PRC];

Begin
	&debug('P_PRC_DOG: '||P_PRC_DOG.[NAME], 1)
	&debug('P_LAST_PRC: '||P_LAST_PRC.[NAME], 1)
	&debug('P_PRC_REG_RATE: '||P_PRC_REG_RATE.[NAME], 1)
	&debug('P_PRC_NALOG: '||P_PRC_NALOG.[NAME], 1)
	&debug('P_SAVE_CHANGE: '||P_SAVE_CHANGE, 1)
	&debug('P_DATE: '||to_char(P_DATE, 'dd/mm/yyyy'), 1)
	&debug('P_CONSOL: '||P_CONSOL, 1)
	
	if P_DATE is null then
		pragma error('Не передана дата изменения схем начисления процентов');
	end if;
	
	if P_PRC_DOG is null then
		pragma error('Не заполнена Основная схема начисления процентов');
	end if;

	if this.[COM_STATUS] = cn_ComStatusClose then
		pragma error ('Договор находится в состоянии "Закрыт", редактирование схем начисиления %% запрещено!');
	end if;	
	
	if P_CONSOL then
		-- В случае консольного вызова не заполняем пустые схемы с депозита
		null;
	else
		&nvl(P_LAST_PRC,		this.[LAST_PRC])
		&nvl(P_PENALTY_PRC,		this.[PENALTY_PRC])
		&nvl(P_PRC_REG_RATE,	this.[PRC_REG_RATE])
		&nvl(P_PRC_NALOG,		this.[PRC_NALOG])
	end if;
	begin
		res := 0;
		for (
				select CP(CP) in ::[DEPN_COMISS_PRC]
				where CP.[DEPN_REF] = this
				and CP.[PRC_SCH] in (this.[PRC_DOG], this.[LAST_PRC], this.[PENALTY_PRC], this.[PRC_REG_RATE], this.[PRC_NALOG])
		) loop
			res := 1; exit;
		end loop;
		if nvl(::[DEPN].[LIB_TARIF_PLAN].applToTarSys(p_dep == this, p_date == p_date), false) and res = 1 then
				pragma error(' Операция не предусмотрена для договоров, подключенных к тарифной подсистеме!');
		end if;
	exception when NO_DATA_FOUND then
		null;
	end;
	
	&nvl(P_SAVE_CHANGE,		false)

	&debug('Текущая схема: '||this.[PRC_DOG].[NAME], 1)
	
	if P_SAVE_CHANGE then
		if this.[PRC_DOG] is null or this.[PRC_DOG] <> P_PRC_DOG then
			&debug('Основная схема изменена! Сохраним в историю!', 1)
			[DEPN]::[LIB_CALC_PRC].SaveChangePrcSch
				(p_Depn		== this
				,p_Date		== P_DATE
				,p_PrcSchem	== P_PRC_DOG);
		end if;
	else
		this.[PRC_DOG]		:= P_PRC_DOG;
	end if;
	
	this.[LAST_PRC]		:= P_LAST_PRC;
	this.[PENALTY_PRC]	:= P_PENALTY_PRC;
	this.[PRC_REG_RATE]	:= P_PRC_REG_RATE;
	this.[PRC_NALOG]	:= P_PRC_NALOG;
End;
end;
end;
