class F_405_DATA;

@generate_ansi_joins(true)
@name('Дельта (XML_405_2025-08-27 от 27.08.2025)')
library EXP_XML_004
is

pragma include (::[RUNTIME].[LIB_MACRO]	);
pragma include (::[REPS_DATA].[LIB_VIEW]);
pragma include (::[REPS_DEBUG].[LIB]	);
pragma macro (lf,			'::[F_405_DATA].[LIB_FUNC_005]'	);
pragma macro (lib_client,	'::[REPS_DATA].[LIB_CLIENT]'	);
pragma macro (lib_delta,	'::[REPS_DATA].[LIB_DELTA]'		);
pragma macro (lib_type,		'::[REPS_DATA].[LIB_TYPE]'		);
pragma macro (lib_exp,		'::[F_405_DATA].[LIB_EXP_002]'	);

--	Версия ядра
lcvCorever	const	varchar2(10)		:= '11:';


/**
 * Функция, возвращающая версию отчёта
 */
public function GetCoreVer
	return	varchar2(10)
is
begin
	return lcvCorever;
end;


/**
 * Функция, возвращающая информацию о приложении
 */
public function GetCoreInfo
	return	varchar2(4000)
is
	vStr	varchar2(4000);
begin
	::[RUNTIME].[STR].set_par(vStr,	'P_IS_EXT',		'1');
	::[RUNTIME].[STR].set_par(vStr,	'P_PRIL_NAME',	'Форма 0409405. Экспорт данных отчета в формате XML для ПП "Дельта"');

	return vStr;
end;

--	Код страны системы
lcvCountryCode			const	varchar2(10)	:=	::[SYSTEM].[COUNTRY].[CODE];

--	Константы для замены примечаний
lcvInstallmentPlan		const	varchar2(10)	:=	'РАССРОЧКА';
lcvPackage				const	varchar2(10)	:=	'ПАКЕТ';
lcvOwnSecurities		const	varchar2(20)	:=	'Собственные бумаги';

-- Шаблон для формата данных - РегНомерКОФилТип
-- '^[0-9]{1,4}([/][0-9]{1,4})?$'				-	от 1 до 4 цифр, затем необязательный блок - символ "/" и от 1 до 4 цифр
lcvRegNum				const	varchar2(128)	:= '^[0-9]{1,4}([/][0-9]{1,4})?$';
-- Шаблон для формата данных - Ном1строки
-- '^1[.]1[.][0-9]{1,11}$'						-	обязательная часть "1.1." и далее от 1 до 11 цифр
lcvRecordNumS1			const	varchar2(128)	:= '^1[.]1[.][0-9]{1,11}$';
-- Шаблон для формата данных - Ном2строки
-- '^1[.]2[.][0-9]{1,11}$'						-	обязательная часть "1.2." и далее от 1 до 11 цифр
lcvRecordNumS2			const	varchar2(128)	:= '^1[.]2[.][0-9]{1,11}$';
-- Шаблон для формата данных - Ном21строки
-- '^2[.]1[.][0-9]{1,11}$'						-	обязательная часть "2.1." и далее от 1 до 11 цифр
lcvRecordNumS21			const	varchar2(128)	:= '^2[.]1[.][0-9]{1,11}$';
-- Шаблон для формата данных - Ном22строки
-- '^2[.]2[.][0-9]{1,11}$'						-	обязательная часть "2.2." и далее от 1 до 11 цифр
lcvRecordNumS22			const	varchar2(128)	:= '^2[.]2[.][0-9]{1,11}$';
-- Шаблон для атрибутов "К1", "К4" и "К5"
-- '^(1|2|3|4)$'								-	допустимые значения: "1", "2", "3" и "4"
lcvK145					const	varchar2(128)	:= '^(1|2|3|4)$';
-- Шаблон для атрибута "К2"
-- '^(1|2)$'									-	допустимые значения: "1" и "2"
lcvK2					const	varchar2(128)	:= '^(1|2)$';
-- Шаблон для атрибута "К3"
-- '^(0|2|3)$'									-	допустимые значения: "0", "2" и "3"
lcvK3					const	varchar2(128)	:= '^(0|2|3)$';
-- Шаблон для формата данных - Строка5Числ
-- '^[0-9]{5}$'									-	цифровой, 5 знаков ровно
lcvNum5					const	varchar2(128)	:= '^[0-9]{5}$';
-- Шаблон для атрибута "КодНПл"
-- '^(INR|OUTR|OUTN|INN)$'						-	допустимые значения: "INR", "OUTR", "OUTN" и "INN"
lcvDirection			const	varchar2(128)	:= '^(INR|OUTR|OUTN|INN)$';
-- Шаблон для формата данных - десят19.4
-- '^-?[0-9]{1,23}([.][0-9]{1,4})?$'			-	цифровой, положительное или отрицательное
--													целая часть - до 15 знаков, дробная часть - до 4 знака
lcvNum27_4				const	varchar2(128)	:= '^-?[0-9]{1,23}([.][0-9]{1,4})?$';
-- Шаблон для формата данных - десят7.6
-- '^(0([.][0-9]{1,6})?|1([.]0{1,6})?)$'		-	цифровой, от 0 до 1, дробная часть - до 6 знаков
lcvNum7_6				const	varchar2(128)	:= '^(0([.][0-9]{1,6})?|1([.]0{1,6})?)$';
-- Шаблон для формата данных - десят17.2
-- '^-?[0-9]{1,15}[.][0-9]{2}$'					-	цифровой, положительное или отрицательное
--													целая часть - до 15 знаков, дробная часть - 2 знака
lcvNum17_2				const	varchar2(128)	:= '^-?[0-9]{1,15}[.][0-9]{2}$';
-- Шаблон для формата данных - Строка3Числ
-- '^[0-9]{3}$'									-	цифровой, 3 знаков ровно
lcvNum3					const	varchar2(128)	:= '^[0-9]{3}$';
-- Шаблон для формата данных - КодСтрИННтип
-- '^([0-9]{3}|[0-9]{10}|[0-9]{12})$'			-	цифровой, количество знаков: 3, 10 или 12
lcvCountyCodeINN		const	varchar2(128)	:= '^([0-9]{3}|[0-9]{10}|[0-9]{12})$';


--	Тип - структура с данными по ценной бумаге
type rec_SecurityData is record
	(
		vK3						varchar2(2)		--	Условный код, необходимый для контроля характеристик ценной бумаги (гр. 18 Разд. 1, гр. 14 Разд. 2)
	,	vIssuerName				varchar2(300)	--	Эмитент ценной бумаги – наименование (гр. 17 Разд.1, гр. 13 Разд. 2)
	,	vIssuerCode				varchar2(20)	--	Эмитент ценной бумаги – код (гр. 18 Разд. 1, гр. 14 Разд. 2)
	,	vSecurityRegNum			varchar2(300)	--	Регистрационный номер ценной бумаги (гр. 19 Разд. 1, гр. 15 Разд. 2)
	);
--	Тип - массив данных по ценным бумагам
type arr_Securities is table of rec_SecurityData index by binary_integer;
--	Тип - данные раздела 1
type rec_DataS1 is record
	(
		vRegNum					varchar2(128)	--	Регистрационный номер кредитной организации (ее филиала)
	,	vRecordNum				varchar2(20)	--	Гр. 1 - Номер строки раздела 1
	,	vK1						varchar2(2)		--	Условный код строки, необходимый для контроля информации о резиденте
	,	vK2						varchar2(2)		--	Условный код строки, необходимый для контроля информации о нерезиденте
	,	dOperDate				date			--	Гр. 2 - Дата операции
	,	vCurOperTypeCode		varchar2(20)	--	Гр. 3 - Код вида валютной операции
	,	vToolCode				varchar2(20)	--	Гр. 4 - Код инструмента
	,	vOperTypeCode			varchar2(20)	--	Гр. 5 - Код вида операции
	,	vDirectionCode			varchar2(20)	--	Гр. 6 - Код направления платежа
	,	nSecuritiesCount		number			--	Гр. 7 - Количество, штук (долей)
	,	nShareSize				number			--	Гр. 8 - Размер доли
	,	vCurrencyCode			varchar2(20)	--	Гр. 9 - Код валюты платежа
	,	nSumTotal				number			--	Гр. 10 - Сумма платежа по операции, валютных единиц
	,	nSumIncome				number			--	Гр. 11 - Выплаченные проценты (доходы)
	,	nSumTax					number			--	Гр. 12 - Удержано налога (справочно)
	,	vResidentName			varchar2(300)	--	Гр. 13 - Резидент – наименование
	,	vResidentCode			varchar2(20)	--	Гр. 14 - Резидент – код
	,	vNonResidentName		varchar2(300)	--	Гр. 15 - Нерезидент – наименование
	,	vCountryCode			varchar2(20)	--	Гр. 16 - Нерезидент – код страны
	,	dSecurityIssueRegDate	date			--	Гр. 20 - Дата регистрации выпуска ценной бумаги
	,	dSecurityMaturityDate	date			--	Гр. 21 - Дата погашения ценной бумаги
	,	vSecurityCurCode		varchar2(20)	--	Гр. 22 - Код валюты ценной бумаги
	,	bNoteInstallmentPlan	boolean			--	Гр. 23 - Признак "РАССРОЧКА"
	,	bNotePackage			boolean			--	Гр. 23 - Признак "ПАКЕТ"
	,	vNoteText				varchar2(1500)	--	Гр. 23 - Текст примечания к строке отчета
	,	vNotes6					varchar2(300)	--	Примечание 6 (Номер паспорта сделки)
	,	vNotes7					varchar2(300)	--	Примечание 7 (Балансовый счет 2-го порядка)
	,	vNoteNRBankName			varchar2(300)	--	Гр. 23 - Примечание "КОНТРАГЕНТ" - Наименование банка-нерезидента
	,	vNoteNRbankCountryCode	varchar2(20)	--	Гр. 23 - Примечание "КОНТРАГЕНТ" - Цифровой код страны банка-нерезидента
	,	vNoteNRName				varchar2(300)	--	Гр. 23 - Примечание "КОНТРАГЕНТ" - Наименование нерезидента
	,	vNoteNRCountryCode		varchar2(20)	--	Гр. 23 - Примечание "КОНТРАГЕНТ" - Цифровой код страны нерезидента
	,	dNoteRepoDealDate		date			--	Гр. 23 - Дата корреспондирующей сделки репо
	,	bNoteOwnSecurities		boolean			--	Гр. 23 - Признак собственных бумаг
	,	aSecurities				arr_Securities	--	Массив данных по ценным бумагам
	);
--	Тип - данные раздела 2
type rec_DataS2 is record
	(
		vRegNum					varchar2(128)	--	Регистрационный номер кредитной организации (ее филиала)
	,	vRecordNum				varchar2(20)	--	Гр. 1 - Номер строки раздела 2
	,	vK4						varchar2(2)		--	Условный код строки. необходимый для контроля информации о покупателе
	,	vK5						varchar2(2)		--	Условный код строки, необходимый для контроля информации о продавце
	,	dOperDate				date			--	Гр. 2 - Дата операции
	,	vToolCode				varchar2(20)	--	Гр. 3 - Код инструмента
	,	vOperTypeCode			varchar2(20)	--	Гр. 4 - Код вида операции
	,	nSecuritiesCount		number			--	Гр. 5 - Количество, штук
	,	nShareSize				number			--	Гр. 6 - Размер доли
	,	vCurrencyCode			varchar2(20)	--	Гр. 7 - Код валюты платежа
	,	nSumTotal				number			--	Гр. 8 - Сумма платежа по операции
	,	vBuyerName				varchar2(300)	--	Гр. 9 - Покупатель – наименование
	,	vBuyerCode				varchar2(20)	--	Гр. 10 - Покупатель – код
	,	vSellerName				varchar2(300)	--	Гр. 11 - Продавец – наименование
	,	vSellerCode				varchar2(20)	--	Гр. 12 - Продавец – код
	,	vSecurityCurCode		varchar2(20)	--	Гр. 16 - Код валюты ценной бумаги
	,	bNoteInstallmentPlan	boolean			--	Гр. 17 - Признак "РАССРОЧКА"
	,	bNotePackage			boolean			--	Гр. 17 - Признак "ПАКЕТ"
	,	vNoteText				varchar2(1500)	--	Гр. 17 - Текст примечания к строке отчета
	,	dNoteRepoDealDate		date			--	Гр. 17 - Дата корреспондирующей сделки репо
	,	bNoteOwnSecurities		boolean			--	Гр. 17 - Признак собственных бумаг
	,	aSecurities				arr_Securities	--	Массив данных по ценным бумагам
	);
--	Тип - массив данных раздела 1
type map_DataS1 is table of rec_DataS1 index by varchar2(32767);
--	Тип - массив данных раздела 2
type map_DataS2 is table of rec_DataS2 index by varchar2(32767);
--	Подтип - данные курсора по разделу 1
subtype rec_CurDataS1 is &lib_exp.rec_CurDataS1;
--	Подтип - данные курсора по разделу 2
subtype rec_CurDataS2 is &lib_exp.rec_CurDataS2;
--	Тип - массив данных по возвратным операциям раздела 1. Индекс - номер подраздела
type map_DataReturnS1 is table of map_DataS1 index by varchar2(128);
--	Тип - массив данных по возвратным операциям раздела 2. Индекс - номер подраздела
type map_DataReturnS2 is table of map_DataS2 index by varchar2(128);


--	Данные реализации
lrecParamInfo			&lib_exp.rec_ParamInfo;
--	Признак агрегирования данных в пределах дня
lbGrp					boolean;
--	Массив рег. номеров филиалов
lmBranchRegNum			&lib_type.map_str;
--	Массив с данными по возвратным операциям раздела 1
lmDataReturnS1			map_DataReturnS1;
--	Массив с данными по возвратным операциям раздела 2
lmDataReturnS2			map_DataReturnS2;


/**
 * Форматирование числа по маске "Два знака после запятой"
 *
 * @param	P_VALUE		- Форматируемое число
 * @return	Число, округленное до 2 символов и отформатированное по маске "Два знака после запятой"
 */
function FormatNumber
		(
			P_VALUE		number
		)
	return varchar2(128)
is
begin
	P_VALUE	:= round(P_VALUE, 2);

	return ltrim(to_char(P_VALUE, '99999999999999999990.99'));
end;


/**
 * Удаление лишних символов из строки
 *
 * @param	P_STR	- Строка для форматирования
 * @return	Корректная строка без лишних символов
 */
function GetGoodStr
		(
			P_STR		varchar2(32767)
		)
	return varchar2(32767)
is
begin
	if &is_empty(P_STR) then
		return P_STR;
	end if;

	--	Удаление лишних пробелов
	P_STR	:= replace(trim(P_STR), '  ', ' ');
	--	Удаление лишних символов "/"
	P_STR	:= replace(P_STR, '//', '/');
	P_STR	:= rtrim(ltrim(P_STR, '/'), '/');

	return P_STR;
end;


/**
 * Получение рег. номера филиала
 *
 * @param	P_BRANCH	- Ссылка на филиал
 * @return	Рег. номер филиала
 */
function GetRegNum
		(
			P_BRANCH	ref [BRANCH]
		)
	return varchar2(128)
is
	--	Индекс в массиве
	vIdx		varchar2(32767);
	--	Регистрационный номер
	vRegNum		varchar2(32767);
begin
	if P_BRANCH is null then
		return null;
	end if;

	vIdx	:= to_char(P_BRANCH%id);

	--	Если записей в кэше больше 1000, необходимо его очистить
	if lmBranchRegNum.count > 1000 then
		lmBranchRegNum.delete;
	end if;

	--	Добавление рег. номера в кэш, если данные по филиалу там отсутствуют
	if not lmBranchRegNum.exists(vIdx) then
		--	Получение рег. номера по ссылке на филиал
		vRegNum		:= &lib_client.GetBranchInfo(P_BRANCH, lrecParamInfo.dDateEnd + 1).F_REG_NUM;
		--	Удаление лишних символов. В рег. номере должны остаться только цифры и символ "/"
		vRegNum		:= regexp_replace(vRegNum, '[^/0-9]');

		--	Сохранение в массиве
		lmBranchRegNum(vIdx)	:= vRegNum;
	end if;

	return lmBranchRegNum(vIdx);
end;


/**
 * Формирование блока "строка" по записи раздела 1
 *
 * @param	P_SUBSECTION	- Номер подраздела
 * @param	P_IS_RETURN		- Признак операции возврата
 * @param	P_DATA			- Запись с данными
 * @param	P_PARENT_TAG	- Наименование родительского тега для вывода в лог
 */
procedure ExportRecordS1
		(
			P_SUBSECTION	varchar2(5)
		,	P_IS_RETURN		boolean
		,	P_DATA			rec_DataS1
		,	P_PARENT_TAG	varchar2(32767)
		)
is
begin
	--	Открытие блока "строка"
	&lib_delta.OpenTag	(
							P_TAG		==	'строка'
						,	P_MSG_TITLE	==	P_PARENT_TAG || '. Cтрока [' || P_DATA.vRecordNum || ']'
						);
	--	Регистрационный номер кредитной организации (ее филиала)
	--	Формат данных - РегНомерКОФилТип
	&lib_delta.SetAttribute	(
								P_ATTR			==	'РегнКОФил'
							,	P_VALUE			==	P_DATA.vRegNum
							,	P_PATTERN		==	lcvRegNum
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 1 - Номер строки
	--	Форматы данных - Ном1строки и Ном2строки
	&lib_delta.SetAttribute	(
								P_ATTR			==	'НомСтроки' || P_SUBSECTION
							,	P_VALUE			==	P_DATA.vRecordNum
							,	P_PATTERN		==	case
														when P_SUBSECTION = '1'
														then lcvRecordNumS1
														else lcvRecordNumS2
													end
							,	P_IS_REQUIRED	==	true
							);
	--	Условный код строки, необходимый для контроля информации о резиденте
	--	Допустимые значения:
	--	- "1" - юридическое лицо (за исключением кредитных организаций);
	--	- "2" - кредитная организация;
	--	- "3" - физическое лицо (за исключением индивидуального предпринимателя);
	--	- "4" - индивидуальный предприниматель
	&lib_delta.SetAttribute	(
								P_ATTR			==	'К1'
							,	P_VALUE			==	P_DATA.vK1
							,	P_PATTERN		==	lcvK145
							,	P_IS_REQUIRED	==	true
							);
	--	Условный код строки, необходимый для контроля информации о нерезиденте
	--	Допустимые значения:
	--	- "1" - юридическое лицо;
	--	- "2" - физическое лицо
	&lib_delta.SetAttribute	(
								P_ATTR			==	'К2'
							,	P_VALUE			==	P_DATA.vK2
							,	P_PATTERN		==	lcvK2
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 2 - Дата операции
	--	Формат данных - Дата
	&lib_delta.SetAttribute	(
								P_ATTR			==	'ДатаОпер'
							,	P_VALUE			==	to_char(P_DATA.dOperDate, 'YYYY-MM-DD')
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 3 - Код вида валютной операции
	--	Формат данных - Строка5Числ
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодВидВалОпер'
							,	P_VALUE			==	P_DATA.vCurOperTypeCode
							,	P_PATTERN		==	lcvNum5
							,	P_IS_REQUIRED	==	not P_IS_RETURN
							);
	--	Гр. 4 - Код инструмента
	--	Формат данных - Строка6Непустая
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодИнструмента'
							,	P_VALUE			==	P_DATA.vToolCode
							,	P_LEN_MAX		==	6
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 5 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – код вида операции
	--	Формат данных - Строка2
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодОп'
							,	P_VALUE			==	P_DATA.vOperTypeCode
							,	P_LEN_MAX		==	2
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 6 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – код направления платежа
	--	Допустимые значения:
	--	- "INR"		- поступления от нерезидентов;
	--	- "OUTR"	- платежи в пользу нерезидентов;
	--	- "OUTN"	- платежи в пользу резидентов;
	--	- "INN"		- поступления от резидентов
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодНПл'
							,	P_VALUE			==	P_DATA.vDirectionCode
							,	P_PATTERN		==	lcvDirection
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 7 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – количество, штук (долей)
	--	Формат данных - десят19.4
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КолЦб'
							,	P_VALUE			==	round(P_DATA.nSecuritiesCount, 4)
							,	P_PATTERN		==	lcvNum27_4
							);
	--	Гр. 8 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – размер доли
	--	Формат данных - десят7.6
	&lib_delta.SetAttribute	(
								P_ATTR			==	'РазмерДоли'
							,	P_VALUE			==	round(P_DATA.nShareSize, 6)
							,	P_PATTERN		==	lcvNum7_6
							);
	--	Гр. 9 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – код валюты платежа
	--	Формат данных - Строка3
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодВлПл'
							,	P_VALUE			==	P_DATA.vCurrencyCode
							,	P_LEN_MIN		==	3
							,	P_LEN_MAX		==	3
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 10 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе –
	--	сумма платежа по операции, валютных единиц – всего
	--	Формат данных - десят17.2
	&lib_delta.SetAttribute	(
								P_ATTR			==	'СуммаВсего'
							,	P_VALUE			==	FormatNumber(P_DATA.nSumTotal)
							,	P_PATTERN		==	lcvNum17_2
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 11 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе –
	--	сумма платежа по операции, валютных единиц – в том числе: выплаченные проценты (доходы)
	--	Формат данных - десят17.2
	&lib_delta.SetAttribute	(
								P_ATTR			==	'СуммаДоход'
							,	P_VALUE			==	FormatNumber(P_DATA.nSumIncome)
							,	P_PATTERN		==	lcvNum17_2
							);
	--	Гр. 12 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе –
	--	сумма платежа по операции, валютных единиц – удержано налога (справочно)
	--	Формат данных - десят17.2
	&lib_delta.SetAttribute	(
								P_ATTR			==	'Налог'
							,	P_VALUE			==	FormatNumber(P_DATA.nSumTax)
							,	P_PATTERN		==	lcvNum17_2
							);
	--	Гр. 13 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – резидент – наименование
	--	Формат данных - Строка255Непустая
	&lib_delta.SetAttribute	(
								P_ATTR			==	'НаимРезидент'
							,	P_VALUE			==	P_DATA.vResidentName
							,	P_LEN_MAX		==	255
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 14 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – резидент – код
	--	Формат данных - Строка10
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодРезидент'
							,	P_VALUE			==	regexp_replace(P_DATA.vResidentCode, '[^0-9]')
							,	P_LEN_MAX		==	10
							);
	--	Гр. 15 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – нерезидент – наименование
	--	Формат данных - Строка255Непустая
	&lib_delta.SetAttribute	(
								P_ATTR			==	'НаимНерезидент'
							,	P_VALUE			==	P_DATA.vNonResidentName
							,	P_LEN_MAX		==	255
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 16 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – нерезидент – код страны
	--	Формат данных - Строка3Числ
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодСтраны'
							,	P_VALUE			==	case
														when	&is_empty(P_DATA.vCountryCode)
														then	'999'
														else	P_DATA.vCountryCode
													end
							,	P_PATTERN		==	lcvNum3
							,	P_IS_REQUIRED	==	true
							);
	--	По операциям с пакетом не заполняются и не выводятся в файл экспорта графы 20-22
	if		&bool_not(P_DATA.bNotePackage)
		or	P_DATA.aSecurities.count <= 1
	then
		--	Гр. 20 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – дата регистрации выпуска ценной бумаги
		--	Формат данных - Дата
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ДатаРегВып'
								,	P_VALUE			==	to_char(P_DATA.dSecurityIssueRegDate, 'YYYY-MM-DD')
								);
		--	Гр. 21 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – дата погашения ценной бумаги
		--	Формат данных - Дата
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ДатаПогашЦб'
								,	P_VALUE			==	to_char(P_DATA.dSecurityMaturityDate, 'YYYY-MM-DD')
								);
		--	Гр. 22 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – Код валюты ценной бумаги
		--	Формат данных - Строка3
		&lib_delta.SetAttribute	(
									P_ATTR			==	'КодВлЦб'
								,	P_VALUE			==	P_DATA.vSecurityCurCode
								,	P_LEN_MIN		==	3
								,	P_LEN_MAX		==	3
								);
	end if;

	if P_DATA.bNoteInstallmentPlan then
		--	Гр. 23 - Признак рассрочки
		--	Формат данных - Строка10
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримРАССРОЧКА'
								,	P_VALUE			==	'РАССРОЧКА'
								,	P_LEN_MAX		==	10
								);
	end if;

	if P_DATA.bNotePackage then
		--	Гр. 23 - Признак пакета
		--	Формат данных - Строка10
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримПАКЕТ'
								,	P_VALUE			==	'ПАКЕТ'
								,	P_LEN_MAX		==	10
								);
	end if;

	if &is_not_empty(P_DATA.vNoteText) then
		--	Гр. 23 - Текст примечания к строке отчета
		--	Формат данных - Строка1000
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримТЕКСТ'
								,	P_VALUE			==	P_DATA.vNoteText
								,	P_LEN_MAX		==	1000
								);
	end if;

	if &is_not_empty(P_DATA.vNoteNRBankName) then
		--	Гр. 23 - Блок примечаний КОНТРАГЕНТ - Наименование банка-нерезидента
		--	Формат данных - Строка255
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримКАНаимИнБ'
								,	P_VALUE			==	P_DATA.vNoteNRBankName
								,	P_LEN_MAX		==	255
								);
	end if;

	if &is_not_empty(P_DATA.vNoteNRbankCountryCode) then
		--	Гр. 23 - Блок примечаний КОНТРАГЕНТ - Цифровой код страны банка-нерезидента
		--	Формат данных - Строка3Числ
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримКАКодСтраныИнБ'
								,	P_VALUE			==	P_DATA.vNoteNRbankCountryCode
								,	P_PATTERN		==	lcvNum3
								);
	end if;

	if &is_not_empty(P_DATA.vNoteNRName) then
		--	Гр. 23 - Блок примечаний КОНТРАГЕНТ - Наименование нерезидента
		--	Формат данных - Строка255
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримКАНаимНРзд'
								,	P_VALUE			==	P_DATA.vNoteNRName
								,	P_LEN_MAX		==	255
								);
	end if;

	if &is_not_empty(P_DATA.vNoteNRCountryCode) then
		--	Гр. 23 - Блок примечаний КОНТРАГЕНТ - Цифровой код страны нерезидента
		--	Формат данных - Строка3Числ
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримКАКодСтраныНРзд'
								,	P_VALUE			==	P_DATA.vNoteNRCountryCode
								,	P_PATTERN		==	lcvNum3
								);
	end if;

	if		P_SUBSECTION = '1'
		and P_DATA.dNoteRepoDealDate is not null
	then
		--	Гр. 23 - Дата корреспондирующей сделки репо
		--	Формат данных - Дата
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримДатаОпСделки'
								,	P_VALUE			==	to_char(P_DATA.dNoteRepoDealDate, 'YYYY-MM-DD')
								);
	end if;

	if P_DATA.bNoteOwnSecurities then
		--	Гр. 23 - Признак собственных бумаг
		--	Формат данных - Строка20
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримСобствБум'
								,	P_VALUE			==	'СобственныеБумаги'
								,	P_LEN_MAX		==	20
								);
	end if;

	--	Заполнение данных по ценным бумагам
	&fforeach_rec(recIssue, P_DATA.aSecurities, iIdx, null)
		--	Открытие блока "запись"
		&lib_delta.OpenTag	(
								P_TAG		==	'запись'
							,	P_MSG_TITLE	==	P_PARENT_TAG || '. Cтрока [' || P_DATA.vRecordNum || ']. Запись [' || to_char(iIdx) || ']'
							);

		--	Условный код, необходимый для контроля характеристик ценной бумаги
		--	Допустимые значения:
		--	- "0" - в КО отсутствует информация об эмитенте ценной бумаги;
		--	- "2" - эмитентом является резидент;
		--	- "3" - эмитентом является нерезидент
		&lib_delta.SetAttribute	(
									P_ATTR			==	'К3'
								,	P_VALUE			==	recIssue.vK3
								,	P_PATTERN		==	lcvK3
								,	P_IS_REQUIRED	==	true
								);

		if P_IS_RETURN then
			--	Гр. 2 - Дата операции
			--	Формат данных - Дата
			&lib_delta.SetAttribute	(
										P_ATTR			==	'ДатаОпер'
									,	P_VALUE			==	to_char(P_DATA.dOperDate, 'YYYY-MM-DD')
									);
		end if;

		--	Гр. 17 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – эмитент ценной бумаги
		--	(резидент (нерезидент), с долями, паями, вкладами в имуществе которых совершены операции) – наименование
		--	Формат данных - Строка255
		&lib_delta.SetAttribute	(
									P_ATTR			==	'НаимЭмЦб'
								,	P_VALUE			==	recIssue.vIssuerName
								,	P_LEN_MAX		==	255
								);
		--	Гр. 18 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – эмитент ценной бумаги
		--	(резидент (нерезидент), с долями, паями, вкладами в имуществе которых совершены операции) – код
		--	Формат данных - КодСтрИННтип
		&lib_delta.SetAttribute	(
									P_ATTR			==	'КодЭмЦб'
								,	P_VALUE			==	recIssue.vIssuerCode
								,	P_PATTERN		==	lcvCountyCodeINN
								);
		--	Гр. 19 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – регистрационный номер ценной бумаги
		--	Формат данных - Строка120
		&lib_delta.SetAttribute	(
									P_ATTR			==	'РегНомЦб'
								,	P_VALUE			==	recIssue.vSecurityRegNum
								,	P_LEN_MAX		==	120
								);

		--	Закрытие блока "запись"
		&lib_delta.CloseTag('запись');
	&end_foreach;

	--	Закрытие блока "строка"
	&lib_delta.CloseTag('строка');
end;


/**
 * Формирование блока "строка" по записи раздела 2
 *
 * @param	P_SUBSECTION	- Номер подраздела
 * @param	P_DATA			- Запись с данными
 * @param	P_PARENT_TAG	- Наименование родительского тега для вывода в лог
 */
procedure ExportRecordS2
		(
			P_SUBSECTION	varchar2(5)
		,	P_DATA			rec_DataS2
		,	P_PARENT_TAG	varchar2(32767)
		)
is
begin
	--	Открытие блока "строка"
	&lib_delta.OpenTag	(
							P_TAG		==	'строка'
						,	P_MSG_TITLE	==	P_PARENT_TAG || '. Cтрока [' || P_DATA.vRecordNum || ']'
						);
	--	Регистрационный номер кредитной организации (ее филиала)
	--	Формат данных - РегНомерКОФилТип
	&lib_delta.SetAttribute	(
								P_ATTR			==	'РегнКОФил'
							,	P_VALUE			==	P_DATA.vRegNum
							,	P_PATTERN		==	lcvRegNum
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 1 - Номер строки
	--	Форматы данных - Ном21строки и Ном22строки
	&lib_delta.SetAttribute	(
								P_ATTR			==	'НомСтроки2' || P_SUBSECTION
							,	P_VALUE			==	P_DATA.vRecordNum
							,	P_PATTERN		==	case
														when P_SUBSECTION = '1'
														then lcvRecordNumS21
														else lcvRecordNumS22
													end
							,	P_IS_REQUIRED	==	true
							);
	--	Условный код строки, необходимый для контроля информации о резиденте
	--	Допустимые значения:
	--	- "1" - юридическое лицо (за исключением кредитных организаций);
	--	- "2" - кредитная организация;
	--	- "3" - физическое лицо (за исключением индивидуального предпринимателя);
	--	- "4" - индивидуальный предприниматель
	&lib_delta.SetAttribute	(
								P_ATTR			==	'К4'
							,	P_VALUE			==	P_DATA.vK4
							,	P_PATTERN		==	lcvK145
							,	P_IS_REQUIRED	==	true
							);
	--	Условный код строки, необходимый для контроля информации о нерезиденте
	--	Допустимые значения:
	--	- "1" - юридическое лицо (за исключением кредитных организаций);
	--	- "2" - кредитная организация;
	--	- "3" - физическое лицо (за исключением индивидуального предпринимателя);
	--	- "4" - индивидуальный предприниматель
	&lib_delta.SetAttribute	(
								P_ATTR			==	'К5'
							,	P_VALUE			==	P_DATA.vK5
							,	P_PATTERN		==	lcvK145
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 2 - Дата операции
	--	Формат данных - Дата
	&lib_delta.SetAttribute	(
								P_ATTR			==	'ДатаОпер'
							,	P_VALUE			==	to_char(P_DATA.dOperDate, 'YYYY-MM-DD')
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 3 - Код инструмента
	--	Формат данных - Строка6Непустая
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодИнструмента'
							,	P_VALUE			==	P_DATA.vToolCode
							,	P_LEN_MAX		==	6
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 4 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – код вида операции
	--	Формат данных - Строка2
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодОпР2'
							,	P_VALUE			==	P_DATA.vOperTypeCode
							,	P_LEN_MAX		==	2
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 5 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – количество, штук (долей)
	--	Формат данных - десят19.4
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КолЦбР2'
							,	P_VALUE			==	round(P_DATA.nSecuritiesCount, 4)
							,	P_PATTERN		==	lcvNum27_4
							);
	--	Гр. 6 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – размер доли
	--	Формат данных - десят7.6
	&lib_delta.SetAttribute	(
								P_ATTR			==	'РазмерДоли2'
							,	P_VALUE			==	round(P_DATA.nShareSize, 6)
							,	P_PATTERN		==	lcvNum7_6
							);
	--	Гр. 7 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – код валюты платежа
	--	Формат данных - Строка3
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодВлПл'
							,	P_VALUE			==	P_DATA.vCurrencyCode
							,	P_LEN_MIN		==	3
							,	P_LEN_MAX		==	3
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 8 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе –
	--	сумма платежа по операции, валютных единиц – всего
	--	Формат данных - десят17.2
	&lib_delta.SetAttribute	(
								P_ATTR			==	'СуммаВсегоР2'
							,	P_VALUE			==	FormatNumber(P_DATA.nSumTotal)
							,	P_PATTERN		==	lcvNum17_2
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 9 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – Покупатель – наименование
	--	Формат данных - Строка255Непустая
	&lib_delta.SetAttribute	(
								P_ATTR			==	'НаимПокупатель'
							,	P_VALUE			==	P_DATA.vBuyerName
							,	P_LEN_MAX		==	255
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 10 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – Покупатель – код
	--	Формат данных - Строка10
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодПокупатель'
							,	P_VALUE			==	regexp_replace(P_DATA.vBuyerCode, '[^0-9]')
							,	P_LEN_MAX		==	10
							);
	--	Гр. 11 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – Продавец – наименование
	--	Формат данных - Строка255Непустая
	&lib_delta.SetAttribute	(
								P_ATTR			==	'НаимПродавец'
							,	P_VALUE			==	P_DATA.vSellerName
							,	P_LEN_MAX		==	255
							,	P_IS_REQUIRED	==	true
							);
	--	Гр. 12 - Параметры расчетов по операциям с ценными бумагами, долями, паями и вкладами в имуществе – Продавец – код
	--	Формат данных - Строка3Числ
	&lib_delta.SetAttribute	(
								P_ATTR			==	'КодПродавец'
							,	P_VALUE			==	regexp_replace(P_DATA.vSellerCode, '[^0-9]')
							,	P_LEN_MAX		==	10
							);

	--	По операциям с пакетом не заполняется и не выводится в файл экспорта графа 16
	if		&bool_not(P_DATA.bNotePackage)
		or	P_DATA.aSecurities.count <= 1
	then
		--	Гр. 16 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – Код валюты ценной бумаги
		--	Формат данных - Строка3
		&lib_delta.SetAttribute	(
									P_ATTR			==	'КодВлЦб'
								,	P_VALUE			==	P_DATA.vSecurityCurCode
								,	P_LEN_MIN		==	3
								,	P_LEN_MAX		==	3
								);
	end if;

	if P_DATA.bNoteInstallmentPlan then
		--	Гр. 17 - Признак рассрочки
		--	Формат данных - Строка10
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримРАССРОЧКА'
								,	P_VALUE			==	'РАССРОЧКА'
								,	P_LEN_MAX		==	10
								);
	end if;

	if P_DATA.bNotePackage then
		--	Гр. 17 - Признак пакета
		--	Формат данных - Строка10
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримПАКЕТ'
								,	P_VALUE			==	'ПАКЕТ'
								,	P_LEN_MAX		==	10
								);
	end if;

	if &is_not_empty(P_DATA.vNoteText) then
		--	Гр. 17 - Текст примечания к строке отчета
		--	Формат данных - Строка1000
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримТЕКСТ'
								,	P_VALUE			==	P_DATA.vNoteText
								,	P_LEN_MAX		==	1000
								);
	end if;

	if		P_SUBSECTION = '1'
		and	P_DATA.dNoteRepoDealDate is not null
	then
		--	Гр. 17 - Дата корреспондирующей сделки репо
		--	Формат данных - Дата
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримДатаОпСделки'
								,	P_VALUE			==	to_char(P_DATA.dNoteRepoDealDate, 'YYYY-MM-DD')
								);
	end if;

	if P_DATA.bNoteOwnSecurities then
		--	Гр. 17 - Признак собственных бумаг
		--	Формат данных - Строка20
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ПримСобствБум'
								,	P_VALUE			==	'СобственныеБумаги'
								,	P_LEN_MAX		==	20
								);
	end if;

	--	Заполнение данных по ценным бумагам
	&fforeach_rec(recIssue, P_DATA.aSecurities, iIdx, null)
		--	Открытие блока "запись"
		&lib_delta.OpenTag	(
								P_TAG		==	'запись'
							,	P_MSG_TITLE	==	P_PARENT_TAG || '. Cтрока [' || P_DATA.vRecordNum || ']. Запись [' || to_char(iIdx) || ']'
							);

		--	Условный код, необходимый для контроля характеристик ценной бумаги
		--	Допустимые значения:
		--	- "0" - в КО отсутствует информация об эмитенте ценной бумаги;
		--	- "2" - эмитентом является резидент;
		--	- "3" - эмитентом является нерезидент
		&lib_delta.SetAttribute	(
									P_ATTR			==	'К3'
								,	P_VALUE			==	recIssue.vK3
								,	P_PATTERN		==	lcvK3
								,	P_IS_REQUIRED	==	true
								);
		--	Гр. 13 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – эмитент ценной бумаги
		--	(резидент (нерезидент), с долями, паями, вкладами в имуществе которых совершены операции) – наименование
		--	Формат данных - Строка255
		&lib_delta.SetAttribute	(
									P_ATTR			==	'НаимЭмЦб'
								,	P_VALUE			==	recIssue.vIssuerName
								,	P_LEN_MAX		==	255
								);
		--	Гр. 14 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – эмитент ценной бумаги
		--	(резидент (нерезидент), с долями, паями, вкладами в имуществе которых совершены операции) – код
		--	Формат данных - КодСтрИННтип
		&lib_delta.SetAttribute	(
									P_ATTR			==	'КодЭмЦб'
								,	P_VALUE			==	recIssue.vIssuerCode
								,	P_PATTERN		==	lcvCountyCodeINN
								);
		--	Гр. 15 - Характеристика ценной бумаги, доли, пая, вклада в имуществе – регистрационный номер ценной бумаги
		--	Формат данных - Строка120
		&lib_delta.SetAttribute	(
									P_ATTR			==	'РегНомЦб'
								,	P_VALUE			==	recIssue.vSecurityRegNum
								,	P_LEN_MAX		==	120
								);

		--	Закрытие блока "запись"
		&lib_delta.CloseTag('запись');
	&end_foreach;

	--	Закрытие блока "строка"
	&lib_delta.CloseTag('строка');
end;


/**
 * Формирование данных по разделу 1
 */
procedure ExportSection1
is
	--	Формируемый тег
	vTag				varchar2(128);
	--	Ссылочный курсор по нерезидентам
	curData				::[RUNTIME].[UTILS].ref_cursor;
	--	Запись с данными по строке первого раздела
	recDataS1			rec_DataS1;
	--	Массив данных раздела 1
	mDataS1				map_DataS1;
	--	Индекс в массиве данных
	vIdx				varchar2(32767);
	--	Признак рассрочки
	bIsInstallmentPlan	boolean;
	--	Признак пакета
	bIsPackage			boolean;
	--	Запись с данными по эмитенту
	recSecurityData		rec_SecurityData;
	--	Количество записей в разделе
	iCount				integer;
	--	Номер предыдущего подраздела
	vSubsectionPrev		varchar2(128);
	--	Номер брабатываемого подраздела
	vSubsection			varchar2(128);
	--	Тип эмитента
	vEmitType			varchar2(128);
begin
	mDataS1.delete;

	--	Открытие курсора по данным подраздела
	curData		:= &lib_exp.OpenCursorS1(
											P_PARAM_INFO	== lrecParamInfo
										,	P_GRP			== lbGrp
										);

	&for_opened_cursor(recData, curData, rec_CurDataS1, 1000)
		bIsInstallmentPlan	:= false;
		bIsPackage			:= false;

		--	Если поле "Примечание" не пустое
		if recData.vNotes is not null then
			--	Если есть "РАССРОЧКА"
			if instr(recData.vNotes, lcvInstallmentPlan) > 0 then
				bIsInstallmentPlan	:= true;
			end if;

			--	Если есть "ПАКЕТ"
			if instr(recData.vNotes, lcvPackage) > 0 then
				bIsPackage			:= true;
			end if;
		end if;

		--Переопредяеляем имя в зависимости от резидентности и нахождении клиента в группах, указанных в настройке FOREIGN_ORG_BR_NAME
		recData.vEmitentName	:=	case	when	recData.rEMITENT%class = ::[CL_BANK_F]%class then &lf.GetNameClQual(recData.rEMITENT, 'NAME', lrecParamInfo.dDateEnd)
											else	nvl(&lf.GetNameClRes(recData.rEMITENT, &lf.isResident(recData.rEMITENT, lrecParamInfo.dDateEnd), lrecParamInfo.dDateEnd, lrecParamInfo.rProf), recData.vEmitentName)
									end;
		recData.vRezident		:= nvl(&lf.GetNameClRes(recData.rRezRef, &lf.isResident(recData.rRezRef, lrecParamInfo.dDateEnd), lrecParamInfo.dDateEnd, lrecParamInfo.rProf), recData.vRezident);
		recData.vNerezident		:= nvl(&lf.GetNameClRes(recData.rNRezRef, &lf.isResident(recData.rNRezRef, lrecParamInfo.dDateEnd), lrecParamInfo.dDateEnd, lrecParamInfo.rProf), recData.vNerezident);
		--	Уникальные поля для пакета: настройка (раздел), гр. 2 - 16 и филиал.
		--	Если признак пакета не указан, то добавляется порядковый номер записи в конец индекса,
		--	т.к. записи вне пакета группировать не требуется
		vIdx	:=	'#' ||	recData.vSection								||		--	Раздел
					'#' ||	nvl(to_char(recData.dDateOp, 'DD-MM-YYYY'), '')	||		--	Гр. 2 - Дата операции
					'#' ||	nvl(recData.vKodCB, '')							||		--	Гр. 4 - Код инструмента
					'#' ||	nvl(recData.vKodOper, '')						||		--	Гр. 5 - Код вида операции
					'#' ||	nvl(recData.vKodNPl, '')						||		--	Гр. 6 - Код направления платежа
					'#' ||	nvl(recData.vFullCode, '')						||		--	Гр. 3 - Код вида валютной операции
					'#' ||	nvl(to_char(recData.nQuantity), '')				||		--	Гр. 7 - Количество, штук (долей)
					'#' ||	nvl(to_char(recData.nPart), '')					||		--	Гр. 8 - Размер доли
					'#' ||	nvl(recData.vCurPl, '')							||		--	Гр. 9 - Код валюты платежа
					'#' ||	nvl(to_char(recData.nSumTotal), '')				||		--	Гр. 10 - Сумма платежа по операции
					'#' ||	nvl(to_char(recData.nSumPrc), '')				||		--	Гр. 11 - Выплаченные проценты (доходы)
					'#' ||	nvl(to_char(recData.nTaxPrc), '')				||		--	Гр. 12 - Удержано налога (справочно)
					'#' ||	nvl(to_char(recData.vRezident), '')				||		--	Гр. 13 - Резидент – наименование
					'#' ||	nvl(to_char(recData.vResCode), '')				||		--	Гр. 14 - Резидент – код
					'#' ||	nvl(to_char(recData.vNerezident), '')			||		--	Гр. 15 - Нерезидент – наименование
					'#' ||	nvl(to_char(recData.vNRezCountry), '')			||		--	Гр. 16 - Нерезидент – код страны
					'#' ||	nvl(to_char(recData.rFilial), '')				||		--	Филиал
					'#' ||	bool_char(bIsPackage, '1', '0', '0')			||		--	Признак пакета
					'#' ||	case
								when not bIsPackage
								then to_char(mDataS1.count + 1) || '#'				--	Порядковый номер записи (для НЕ пакетных операций)
							end
					;

		--	Если запись с индексом отсутствует (обрабатывается либо не пакетная операция, либо первая запись из пакета),
		--	то необходимо добавить её в массив
		if not mDataS1.exists(vIdx) then
			&set_zero(recDataS1);

			--	Условный код строки, необходимый для контроля информации о резиденте
			recDataS1.vK1			:= coalesce(recData.vTypeRez, &lf.GetTypeRes(recData.rRezRef));
			--	Гр. 14 - Резидент – код
			recDataS1.vResidentCode	:= recData.vResCode;
			case recDataS1.vK1 of
				:'ЮЛ':
					recDataS1.vK1 := '1';
				:'КО':
					recDataS1.vK1 := '2';
				:'ФЛ':
					recDataS1.vK1 := '3';
					recDataS1.vResidentCode := null;
				:'ИП':
					recDataS1.vK1 := '4';
					recDataS1.vResidentCode := null;
			end;

			--	Определение тип нерезидента
			recDataS1.vK2	:= coalesce(recData.vTypeNerez, &lf.GetTypeNRes(recData.rNRezRef));
			case recDataS1.vK2 of
				:'ЮЛ':
					recDataS1.vK2 := '1';
				:'ФЛ':
					recDataS1.vK2 := '2';
			end;

			--	Наименование резидента (гр. 13) в зависимости от К1
			recDataS1.vResidentName :=		case	recDataS1.vK1
												when	'3'		then	'ФЛ'
												when	'4'		then	'ИП'
												else					recData.vRezident
											end;

			--	Наименование нерезидента (гр. 15) в зависимости от К2
			recDataS1.vNonResidentName :=	case	when	recDataS1.vK2 = '2'								then	'ФЛ'
													when	recData.rNRezRef%class = ::[CL_BANK_F]%class	then	recData.rNRezRef.[NAME]
													else	recData.vNerezident
											end;

			--	Примечание 6 (Номер паспорта сделки)
			recDataS1.vNotes6	:= recData.vNotes6;

			--	Примечание 7 (Балансовый счет 2-го порядка)
			recDataS1.vNotes7	:= recData.vNotes6;

			--	Гр. 23 - Текст примечания к строке отчета
			recDataS1.vNoteText	:= recData.vNotes;

			--	Если указан признак рассрочки в примечании
			if bIsInstallmentPlan then
				--	Гр. 23 - Признак рассрочки
				recDataS1.bNoteInstallmentPlan	:= bIsInstallmentPlan;
				--	Удаление из текста примечания информации про рассрочку
				recDataS1.vNoteText				:= replace(recDataS1.vNoteText, lcvInstallmentPlan);
			end if;

			--	Если указан признак пакета в примечании
			if bIsPackage then
				--	Гр. 23 - Признак пакета
				recDataS1.bNotePackage	:= bIsPackage;
				--	Удаление из текста примечания информации про пакет
				recDataS1.vNoteText		:= replace(recDataS1.vNoteText, lcvPackage);
			end if;

			--	Данные примечания 6 выводятся в поле "Текст примечания к строке отчета" через '/'
			recDataS1.vNoteText		:= trim(recDataS1.vNoteText || '/' || recData.vNotes6, '/');

			--	Данные примечания 7 выводятся в поле "Текст примечания к строке отчета" через '/'
			recDataS1.vNoteText		:= trim(recDataS1.vNoteText || '/' || recData.vNotes7, '/');

			--	Удаление лишних символов из строки примечания
			recDataS1.vNoteText		:= GetGoodStr(recDataS1.vNoteText);

			--	Если заполнено одно из полей примечаний 1-4, то необходимо заполнить поля примечания про нерезидента
			if		trim(recData.vNotes1) is not null
				or	trim(recData.vNotes2) is not null
				or	trim(recData.vNotes3) is not null
				or	trim(recData.vNotes4) is not null
			then
				recDataS1.vNoteNRBankName			:=	recData.vNotes1;					--	Гр. 23 - Наименование банка-нерезидента
				recDataS1.vNoteNRbankCountryCode	:=	substr(recData.vNotes2, 1, 3);		--	Гр. 23 - Цифровой код страны банка-нерезидента
				recDataS1.vNoteNRName				:=	recData.vNotes3;					--	Гр. 23 - Наименование нерезидента
				recDataS1.vNoteNRCountryCode		:=	substr(recData.vNotes4, 1, 3);		--	Гр. 23 - Цифровой код страны нерезидента
			end if;

			recDataS1.vRegNum				:= GetRegNum(recData.rFilial);	--	Регистрационный номер КО
			recDataS1.vRecordNum			:= substr(vIdx, 2, 3) || '.';	--	Гр. 1 - Номер строки
			recDataS1.dOperDate				:= recData.dDateOp;				--	Гр. 2 - Дата операции
			recDataS1.vCurOperTypeCode		:= recData.vFullCode;			--	Гр. 3 - Код вида валютной операции
			recDataS1.vToolCode				:= recData.vKodCB;				--	Гр. 4 - Код инструмента
			recDataS1.vOperTypeCode			:= recData.vKodOper;			--	Гр. 5 - Код вида операции
			recDataS1.vDirectionCode		:= recData.vKodNPl;				--	Гр. 6 - Код направления платежа
			recDataS1.nSecuritiesCount		:= recData.nQuantity;			--	Гр. 7 - Количество, штук (долей)
			recDataS1.nShareSize			:= recData.nPart;				--	Гр. 8 - Размер доли
			recDataS1.vCurrencyCode			:= recData.vCurPl;				--	Гр. 9 - Код валюты платежа
			recDataS1.nSumTotal				:= recData.nSumTotal;			--	Гр. 10 - Сумма платежа по операции
			recDataS1.nSumIncome			:= recData.nSumPrc;				--	Гр. 11 - Выплаченные проценты (доходы)
			recDataS1.nSumTax				:= recData.nTaxPrc;				--	Гр. 12 - Удержано налога (справочно)
			recDataS1.vCountryCode			:= recData.vNRezCountry;		--	Гр. 16 - Нерезидент – код страны
			recDataS1.dSecurityIssueRegDate	:= recData.dDateReg;			--	Гр. 20 - Дата регистрации выпуска ценной бумаги
			recDataS1.dSecurityMaturityDate	:= recData.dDatePay;			--	Гр. 21 - Дата погашения ценной бумаги
			recDataS1.vSecurityCurCode		:= recData.vCurCB;				--	Гр. 22 - Код валюты ценной бумаги
			recDataS1.bNoteOwnSecurities	:= nvl(recData.bPSO, false);	--	Гр. 23 - Признак собственных бумаг

			if substr(vIdx, 4, 1) = '1' then
				recDataS1.dNoteRepoDealDate	:= recData.dNotes5;				--	Гр. 23 - Дата корреспондирующей сделки репо
			end if;

		--	Если запись по индексу существует (обрабатывается пакетная операция по уже обработанному пакету),
		--	необходимо обновить поля примечания
		else
			recDataS1	:= mDataS1(vIdx);

			--	Если хотя бы у одной операции из пакета указан признак собственных бумаг,
			--	то считается, что признак должен быть у всего пакета
			if recData.bPSO then
				recDataS1.bNoteOwnSecurities	:= recData.bPSO;
			end if;

			--	Если хотя бы у одной операции из пакета указан признак рассрочки,
			--	то считается, что признак должен быть у всего пакета
			if bIsInstallmentPlan then
				--	Гр. 23 - Признак рассрочки
				recDataS1.bNoteInstallmentPlan	:= bIsInstallmentPlan;
				--	Удаление из текста примечания информации про рассрочку
				recData.vNotes					:= replace(recData.vNotes, lcvInstallmentPlan);
			end if;

			--	Если указан признак пакета в примечании
			if bIsPackage then
				--	Гр. 23 - Признак пакета
				recDataS1.bNotePackage	:= bIsPackage;
				--	Удаление из текста примечания информации про пакет
				recData.vNotes			:= replace(recData.vNotes, lcvPackage);
			end if;

			--	Удаление лишних символов из строки примечания
			recData.vNotes		:= GetGoodStr(recData.vNotes);

			--	К существующему примечанию добавляется примечание текущей записи через "/"
			if &in_str(recDataS1.vNoteText, recData.vNotes, '/') = 0 then
				--	Гр. 23 - Текст примечания к строке отчета.
				recDataS1.vNoteText	:= trim(recDataS1.vNoteText || '/' || recData.vNotes, '/');
			end if;

			--	Добавление примечания 6 текущей записи в поле "Текст примечания к строке отчета", если ранее оно не было добавлено
			if		&is_not_empty(recData.vNotes6)
				and	&in_str(recDataS1.vNotes6, recData.vNotes6, '/') = 0
			then
				--	Примечание 6 (Номер паспорта сделки)
				recDataS1.vNotes6		:= recDataS1.vNotes6 || '/' || recData.vNotes6;
				--	Данные примечения 6 выводятся в поле "Текст примечания к строке отчета" через '/'
				recDataS1.vNoteText		:= trim(recDataS1.vNoteText || '/' || recData.vNotes6, '/');
			end if;

			--	Добавление примечания 7 текущей записи в поле "Текст примечания к строке отчета", если ранее оно не было добавлено
			if		&is_not_empty(recData.vNotes7)
				and	&in_str(recDataS1.vNotes7, recData.vNotes7, '/') = 0
			then
				--	Примечание 7 (Балансовый счет 2-го порядка)
				recDataS1.vNotes7		:= recDataS1.vNotes7 || '/' || recData.vNotes7;
				--	Данные примечения 7 выводятся в поле "Текст примечания к строке отчета" через '/'
				recDataS1.vNoteText		:= trim(recDataS1.vNoteText || '/' || recData.vNotes7, '/');
			end if;

			--	Если заполнено одно из примечаний 1-4, то необходимо обновить поля примечания про нерезидента
			if		trim(recData.vNotes1) is not null
				or	trim(recData.vNotes2) is not null
				or	trim(recData.vNotes3) is not null
				or	trim(recData.vNotes4) is not null
			then
				--	Добавление наименования банка-нерезидента текущей записи, если ранее оно не было добавлено
				if		&is_not_empty(recData.vNotes1)
					and	&in_str(recDataS1.vNoteNRBankName, recData.vNotes1, '/') = 0
				then
					recDataS1.vNoteNRBankName	:=	trim(recDataS1.vNoteNRBankName || '/' || recData.vNotes1, '/');
				end if;

				--	Добавление кода страны банка-нерезидента, если ранее он не был указан
				if		&is_empty(recDataS1.vNoteNRbankCountryCode)
					and	&is_not_empty(recData.vNotes2)
				then
					recDataS1.vNoteNRbankCountryCode	:=	substr(recData.vNotes2, 1, 3);
				end if;

				--	Добавление наименования нерезидента текущей записи, если ранее оно не было добавлено
				if		&is_not_empty(recData.vNotes3)
					and	&in_str(recDataS1.vNoteNRName, recData.vNotes3, '/') = 0
				then
					recDataS1.vNoteNRName	:=	trim(recDataS1.vNoteNRName || '/' || recData.vNotes3, '/');
				end if;

				--	Добавление кода страны нерезидента, если ранее он не был указан
				if		&is_empty(recDataS1.vNoteNRCountryCode)
					and	&is_not_empty(recData.vNotes4)
				then
					recDataS1.vNoteNRCountryCode	:=	substr(recData.vNotes4, 1, 3);
				end if;
			end if;

			--	Обновление даты корреспондирующей сделки репо для подраздела 1 в случае, если текущая дата меньше указанной ранее
			if		substr(vIdx, 4, 1)	=	'1'
				and	recData.dNotes5		<=	nvl(recDataS1.dNoteRepoDealDate, recData.dNotes5)
			then
				recDataS1.dNoteRepoDealDate	:= recData.dNotes5;
			end if;
		end if;

		mDataS1(vIdx)	:= recDataS1;

		--	Если данные по ценной бумаге/эмитенту указаны, то необходимо его добавить в массив ценных бумаг текущей записи
		if		recData.vEmitCountry	is not null
			or	recData.vEmitentName	is not null
			or	recData.vEmitCode		is not null
			or	recData.vRegNum			is not null
		then
			&set_zero(recSecurityData);
			vEmitType	:= null;

			recSecurityData.vIssuerName		:= recData.vEmitentName;		--	Гр. 17 - Эмитент ценной бумаги – наименование
			recSecurityData.vIssuerCode		:= recData.vEmitCode;			--	Гр. 18 - Эмитент ценной бумаги – код
			recSecurityData.vSecurityRegNum	:= recData.vRegNum;				--	Гр. 19 - Регистрационный номер ценной бумаги

			--	Определение условного кода, необходимого для контроля характеристик ценной бумаги:
			--	если код и наименование эмитента не определены, то считается, что информация об эмитенте отсутствует
			if		&is_empty(recSecurityData.vIssuerName)
				and	&is_empty(recSecurityData.vIssuerCode)
			then
				recSecurityData.vK3	:= '0';

			--	если код эмитента содержит строку в формате "3 цифры" и не равен коду страны системы ("643"), то считается, что эмитент - нерезидент
			elsif	regexp_instr(recSecurityData.vIssuerCode, lcvNum3) = 1
				and	recSecurityData.vIssuerCode	<> lcvCountryCode
			then
				recSecurityData.vK3	:= '3';
				--	Определение типа эмитента-нерезидента
				vEmitType			:= &lf.GetTypeNRes(recData.rEmitent);

			--	в остальных случаях считается, что эмитент - резидент
			else
				recSecurityData.vK3	:= '2';
				--	Определение типа эмитента-резидента
				vEmitType			:= &lf.GetTypeRes(recData.rEmitent);
			end if;

			--	Переопределение наименования эмитента для ФЛ и ИП
			recSecurityData.vIssuerName	:=	case nvl(vEmitType, '#')
												when	'ФЛ'	then	vEmitType
												when	'ИП'	then	vEmitType
												else					recSecurityData.vIssuerName
											end;

			mDataS1(vIdx).aSecurities(mDataS1(vIdx).aSecurities.count + 1)	:= recSecurityData;
		end if;

	&end_forcursor;

	--	Обработка массива данных
	vSubsectionPrev	:= null;
	vSubsection		:= null;
	&fforeach_rec(recRecord, mDataS1, vIndex, null)
		vSubsection	:= substr(vIndex, 4, 1);

		--	Записи с итоговой суммой меньше 0 считаются возвратными и исключается из блока по основным операциям
		if nvl(recRecord.nSumTotal, 0) < 0 then
			--	Добавление записи в массив возвратных операций
			lmDataReturnS1(vSubsection)(vIndex)	:= recRecord;

			continue;
		end if;

		--	Если обработка предыдущего подраздела завершилась, требуется закрыть блока
		if		vSubsectionPrev	is not null
			and	vSubsectionPrev	<> vSubsection
		then
			--	Закрытие тега
			&lib_delta.CloseTag(vTag);
		end if;

		--	Если проход первый или предыдущий блок завершён, открывается основной тег блока
		if		vSubsectionPrev	is null
			or	vSubsectionPrev	<> vSubsection
		then
			--	Обнуление счётчика записей в блоке
			iCount	:= 0;
			--	Определение наименования тега
			vTag		:= 'Раздел1Подраздел' || vSubsection;
			--	Открытие тега
			&lib_delta.OpenTag(vTag);
		end if;

		--	Сохранение текущего раздела для проверки при следующем проходе
		vSubsectionPrev	:= vSubsection;

		iCount := iCount + 1;

		--	Добавление порядкового номера записи к гр. 1
		recRecord.vRecordNum	:= recRecord.vRecordNum || to_char(iCount);

		--	Формирование данных по записи
		ExportRecordS1
				(
					P_SUBSECTION	== vSubsection
				,	P_IS_RETURN		== false
				,	P_DATA			== recRecord
				,	P_PARENT_TAG	== vTag
				);
	&end_foreach;

	--	Если были данные, требуется закрыть блок по подразделу
	if vSubsectionPrev is not null then
		&lib_delta.CloseTag(vTag);
	end if;

	mDataS1.delete;
end;


/**
 * Формирование данных по возвратным операциям раздела 1
 */
procedure ExportSection1Return
is
	--	Формируемый тег
	vTag				varchar2(128);
	--	Количество записей в разделе
	iCount				integer;
begin
	--	Обработка массива подразделов
	&fforeach(lmDataReturnS1, vIdx, null)
		vTag	:= 'Раздел1Подраздел' || vIdx || 'Возврат';

		--	Открытие тега
		&lib_delta.OpenTag(vTag);

		--	Обнуление счётчика записей в блоке
		iCount	:= 0;

		--	Обработка массива данных подраздела
		&fforeach_rec(recRecord, lmDataReturnS1(vIdx), vIndex, null)
			iCount := iCount + 1;

			--	Добавление порядкового номера записи к гр. 1
			recRecord.vRecordNum	:= recRecord.vRecordNum || to_char(iCount);

			--	Формирование данных по записи
			ExportRecordS1
					(
						P_SUBSECTION	== vIdx
					,	P_IS_RETURN		== true
					,	P_DATA			== recRecord
					,	P_PARENT_TAG	== vTag
					);
		&end_foreach;

		--	Закрытие тега
		&lib_delta.CloseTag(vTag);
	&end_foreach;

	--	Очистка массива с данными
	lmDataReturnS1.delete;
end;


/**
 * Формирование данных по разделу 2
 */
procedure ExportSection2
is
	--	Формируемый тег
	vTag				varchar2(128);
	--	Ссылочный курсор по нерезидентам
	curData				::[RUNTIME].[UTILS].ref_cursor;
	--	Запись с данными по строке первого раздела
	recDataS2			rec_DataS2;
	--	Массив данных раздела 1
	mDataS2				map_DataS2;
	--	Индекс в массиве данных
	vIdx				varchar2(32767);
	--	Признак рассрочки
	bIsInstallmentPlan	boolean;
	--	Признак пакета
	bIsPackage			boolean;
	--	Признак собственных бумаг
	bIsOwnSecurities	boolean;
	--	Запись с данными по ценным бумагам
	recSecurityData		rec_SecurityData;
	--	Количество записей в разделе
	iCount				integer;
	--	Номер предыдущего подраздела
	vSubsectionPrev		varchar2(128);
	--	Номер брабатываемого подраздела
	vSubsection			varchar2(128);
	--	Тип эмитента
	vEmitType			varchar2(128);
begin
	mDataS2.delete;

	--	Открытие курсора по данным подраздела
	curData		:= &lib_exp.OpenCursorS2(
											P_PARAM_INFO	== lrecParamInfo
										,	P_GRP			== lbGrp
										);

	&for_opened_cursor(recData, curData, rec_CurDataS2, 1000)
		bIsInstallmentPlan	:= false;
		bIsPackage			:= false;
		bIsOwnSecurities	:= false;

		--	Если поле "Примечание" не пустое
		if recData.vNotes is not null then
			--	Если есть "РАССРОЧКА"
			if instr(recData.vNotes, lcvInstallmentPlan) > 0 then
				bIsInstallmentPlan	:= true;
			end if;

			--	Если есть "ПАКЕТ"
			if instr(recData.vNotes, lcvPackage) > 0 then
				bIsPackage			:= true;
			end if;

			-- Если есть "СОБСТВЕННЫЕ БУМАГИ"
			if instr(recData.vNotes, lcvOwnSecurities) > 0 then
				bIsOwnSecurities	:= true;
			end if;
		end if;

		--	Уникальные поля для пакета: настройка (раздел), гр. 2 - 12 и филиал.
		--	Если признак пакета не указан, то добавляется порядковый номер записи в конец индекса,
		--	т.к. записи вне пакета группировать не требуется
		vIdx	:=	'#' ||	recData.vSection								||		--	Раздел
					'#' || nvl(to_char(recData.dDateOp, 'DD-MM-YYYY'), '')	||		--	Гр. 2 - Дата операции
					'#' || nvl(recData.vKodCB, '')							||		--	Гр. 3 - Код инструмента
					'#' || nvl(recData.vKodOper, '')						||		--	Гр. 4 - Код вида операции
					'#' || nvl(to_char(recData.nQuantity), '')				||		--	Гр. 5 - Количество, штук (долей)
					'#' || nvl(to_char(recData.nPart), '')					||		--	Гр. 6 - Размер доли
					'#' || nvl(recData.vISOPl, '')							||		--	Гр. 7 - Код валюты платежа
					'#' || nvl(to_char(recData.nSumTotal), '')				||		--	Гр. 8 - Сумма платежа по операции
					'#' || nvl(to_char(recData.vBuyerType), '')				||		--	Гр. 9 - Покупатель – наименование
					'#' || nvl(to_char(recData.vBuyerCode), '')				||		--	Гр. 10 - Покупатель – код
					'#' || nvl(to_char(recData.vSellerType), '')			||		--	Гр. 11 - Продавец – наименование
					'#' || nvl(to_char(recData.vSellerCode), '')			||		--	Гр. 12 - Продавец – код
					'#' || nvl(to_char(recData.rFilial), '')				||		--	Филиал
					'#' || bool_char(bIsPackage, '1', '0', '0')				||		--	Признак пакета
					'#' ||	case
								when not bIsPackage
								then to_char(mDataS2.count + 1) || '#'				--	Порядковый номер записи (для НЕ пакетных операций)
							end
					;

		--	Если запись с индексом отсутствует (обрабатывается либо не пакетная операция, либо первая запись из пакета),
		--	то необходимо добавить её в массив
		if not mDataS2.exists(vIdx) then
			&set_zero(recDataS2);

			--	Условный код строки, необходимый для контроля информации о покупателе
			recDataS2.vK4			:= coalesce(recData.vBuyerType, &lf.GetTypeRes(recData.rBuyerRef));
			--	Гр. 10 - Покупатель – код
			recDataS2.vBuyerCode	:= recData.vBuyerCode;
			case recDataS2.vK4 of
				:'ЮЛ':
					recDataS2.vK4			:= '1';
				:'КО':
					recDataS2.vK4			:= '2';
				:'ФЛ':
					recDataS2.vK4			:= '3';
					recDataS2.vBuyerCode	:= null;
				:'ИП':
					recDataS2.vK4			:= '4';
					recDataS2.vBuyerCode	:= null;
			end;

			--	Условный код строки, необходимый для контроля информации о продавце
			recDataS2.vK5			:= coalesce(recData.vSellerType, &lf.GetTypeRes(recData.rSellerRef));
			--	Гр. 12 - Продавец – код
			recDataS2.vSellerCode	:= recData.vSellerCode;
			case recDataS2.vK5 of
				:'ЮЛ':
					recDataS2.vK5			:= '1';
				:'КО':
					recDataS2.vK5			:= '2';
				:'ФЛ':
					recDataS2.vK5			:= '3';
					recDataS2.vSellerCode	:= null;
				:'ИП':
					recDataS2.vK5			:= '4';
					recDataS2.vSellerCode	:= null;
			end;

			--	Наименование покупателя (гр. 9) в зависимости от К4
			recDataS2.vBuyerName	:=	case	recDataS2.vK4
											when	'3'		then	'ФЛ'
											when	'4'		then	'ИП'
											else					recData.vBuyerName
										end;

			--	Наименование продавца (гр. 11) в зависимости от К5
			recDataS2.vSellerName	:=	case	recDataS2.vK5
											when	'3'		then	'ФЛ'
											when	'4'		then	'ИП'
											else					recData.vSellerName
										end;

			--	Гр. 17 - Текст примечания к строке отчета
			recDataS2.vNoteText	:= recData.vNotes;

			--	Если указан признак рассрочки в примечании
			if bIsInstallmentPlan then
				--	Гр. 17 - Признак рассрочки
				recDataS2.bNoteInstallmentPlan	:= bIsInstallmentPlan;
				--	Удаление из текста примечания информации про рассрочку
				recDataS2.vNoteText				:= replace(recDataS2.vNoteText, lcvInstallmentPlan);
			end if;

			--	Если указан признак пакета в примечании
			if bIsPackage then
				--	Гр. 17 - Признак пакета
				recDataS2.bNotePackage	:= bIsPackage;
				--	Удаление из текста примечания информации про пакет
				recDataS2.vNoteText		:= replace(recDataS2.vNoteText, lcvPackage);
			end if;

			--	Если указан признак собственных бумаг в примечании
			if bIsOwnSecurities then
				--	Гр. 17 - Признак собственных бумаг
				recDataS2.bNoteOwnSecurities	:= bIsOwnSecurities;
				--	Удаление из текста примечания информации про собственные бумаги
				recDataS2.vNoteText				:= replace(recDataS2.vNoteText, lcvOwnSecurities);
			end if;

			--	Удаление лишних символов из строки примечания
			recDataS2.vNoteText		:= GetGoodStr(recDataS2.vNoteText);

			recDataS2.vRegNum				:= GetRegNum(recData.rFilial);	--	Регистрационный номер КО
			recDataS2.vRecordNum			:= substr(vIdx, 2, 3) || '.';	--	Гр. 1 - Номер строки
			recDataS2.dOperDate				:= recData.dDateOp;				--	Гр. 2 - Дата операции
			recDataS2.vToolCode				:= recData.vKodCB;				--	Гр. 3 - Код инструмента
			recDataS2.vOperTypeCode			:= recData.vKodOper;			--	Гр. 4 - Код вида операции
			recDataS2.nSecuritiesCount		:= recData.nQuantity;			--	Гр. 5 - Количество, штук (долей)
			recDataS2.nShareSize			:= recData.nPart;				--	Гр. 6 - Размер доли
			recDataS2.vCurrencyCode			:= recData.vISOPl;				--	Гр. 7 - Код валюты платежа
			recDataS2.nSumTotal				:= recData.nSumTotal;			--	Гр. 8 - Сумма платежа по операции
			recDataS2.vSecurityCurCode		:= recData.vISOVek;				--	Гр. 16 - Код валюты ценной бумаги

			if substr(vIdx, 4, 1) = '1' then
				recDataS2.dNoteRepoDealDate	:= recData.dNotes5;				--	Гр. 17 - Дата корреспондирующей сделки репо
			end if;

		--	Если запись по индексу существует (обрабатывается пакетная операция по уже обработанному пакету),
		--	необходимо обновить поля примечания
		else
			recDataS2	:= mDataS2(vIdx);

			--	Если хотя бы у одной операции из пакета указан признак собственных бумаг,
			--	то считается, что признак должен быть у всего пакета
			if bIsOwnSecurities then
				--	Гр. 17 - Признак рассрочки
				recDataS2.bNoteOwnSecurities	:= bIsOwnSecurities;
				--	Удаление из текста примечания информации про собственные бумаги
				recData.vNotes					:= replace(recData.vNotes, lcvOwnSecurities);
			end if;

			--	Если хотя бы у одной операции из пакета указан признак рассрочки,
			--	то считается, что признак должен быть у всего пакета
			if bIsInstallmentPlan then
				--	Гр. 17 - Признак рассрочки
				recDataS2.bNoteInstallmentPlan	:= bIsInstallmentPlan;
				--	Удаление из текста примечания информации про рассрочку
				recData.vNotes					:= replace(recData.vNotes, lcvInstallmentPlan);
			end if;

			--	Если указан признак пакета в примечании
			if bIsPackage then
				--	Гр. 23 - Признак пакета
				recDataS2.bNotePackage	:= bIsPackage;
				--	Удаление из текста примечания информации про пакет
				recData.vNotes			:= replace(recData.vNotes, lcvPackage);
			end if;

			--	Удаление лишних символов из строки примечания
			recData.vNotes		:= GetGoodStr(recData.vNotes);

			--	К существующему примечанию добавляется примечание текущей записи через "/"
			if &in_str(recDataS2.vNoteText, recData.vNotes, '/') = 0 then
				--	Гр. 23 - Текст примечания к строке отчета.
				recDataS2.vNoteText	:= trim(recDataS2.vNoteText || '/' || recData.vNotes, '/');
			end if;

			--	Обновление даты корреспондирующей сделки репо для подраздела 1 в случае, если текущая дата меньше
			if		substr(vIdx, 4, 1) = '1'
				and	recData.dNotes5 < recDataS2.dNoteRepoDealDate
			then
				recDataS2.dNoteRepoDealDate	:= recData.dNotes5;
			end if;
		end if;

		mDataS2(vIdx)	:= recDataS2;

		--	Если данные по ценной бумаге/эмитенту указаны, то необходимо его добавить в массив ценных бумаг текущей записи
		if		recData.vEmitCountry	is not null
			or	recData.vEmitName		is not null
			or	recData.vEmitCode		is not null
			or	recData.vVekRegN		is not null
		then
			&set_zero(recSecurityData);
			vEmitType	:= null;

			recSecurityData.vIssuerName		:= recData.vEmitName;			--	Гр. 13 - Эмитент ценной бумаги – наименование
			recSecurityData.vIssuerCode		:= recData.vEmitCode;			--	Гр. 14 - Эмитент ценной бумаги – код
			recSecurityData.vSecurityRegNum	:= recData.vVekRegN;			--	Гр. 15 - Регистрационный номер ценной бумаги

			--	Определение условного кода, необходимого для контроля характеристик ценной бумаги:
			--	если код и наименование эмитента не определены, то считается, что информация об эмитенте отсутствует
			if		&is_empty(recSecurityData.vIssuerName)
				and	&is_empty(recSecurityData.vIssuerCode)
			then
				recSecurityData.vK3	:= '0';

			--	если код эмитента содержит строку в формате "3 цифры" и не равен коду страны системы ("643"), то считается, что эмитент - нерезидент
			elsif	regexp_instr(recSecurityData.vIssuerCode, lcvNum3) = 1
				and	recSecurityData.vIssuerCode	<> lcvCountryCode
			then
				recSecurityData.vK3	:= '3';
				--	Определение типа эмитента-нерезидента
				vEmitType			:= &lf.GetTypeNRes(recData.rEmitent);

			--	в остальных случаях считается, что эмитент - резидент
			else
				recSecurityData.vK3	:= '2';
				--	Определение типа эмитента-резидента
				vEmitType			:= &lf.GetTypeRes(recData.rEmitent);
			end if;

			--	Переопределение наименования эмитента для ФЛ и ИП
			recSecurityData.vIssuerName	:=	case nvl(vEmitType, '#')
												when	'ФЛ'	then	vEmitType
												when	'ИП'	then	vEmitType
												else					recSecurityData.vIssuerName
											end;

			mDataS2(vIdx).aSecurities(mDataS2(vIdx).aSecurities.count + 1)	:= recSecurityData;
		end if;
	&end_forcursor;

	--	Обработка массива данных
	vSubsectionPrev	:= null;
	vSubsection		:= null;
	&fforeach_rec(recRecord, mDataS2, vIndex, null)
		vSubsection	:= substr(vIndex, 4, 1);

		--	Записи с итоговой суммой меньше 0 считаются возвратными и исключается из блока по основным операциям
		if nvl(recRecord.nSumTotal, 0) < 0 then
			--	Добавление записи в массив возвратных операций
			lmDataReturnS2(vSubsection)(vIndex)	:= recRecord;

			continue;
		end if;

		--	Если обработка предыдущего подраздела завершилась, требуется закрыть блока
		if		vSubsectionPrev	is not null
			and	vSubsectionPrev	<> vSubsection
		then
			--	Закрытие тега
			&lib_delta.CloseTag(vTag);
		end if;

		--	Если проход первый или предыдущий блок завершён, открывается основной тег блока
		if		vSubsectionPrev	is null
			or	vSubsectionPrev	<> vSubsection
		then
			--	Обнуление счётчика записей в блоке
			iCount	:= 0;
			--	Определение наименования тега
			vTag		:= 'Раздел2Подраздел' || vSubsection;
			--	Открытие тега
			&lib_delta.OpenTag(vTag);
		end if;

		--	Сохранение текущего раздела для проверки при следующем проходе
		vSubsectionPrev	:= vSubsection;

		iCount := iCount + 1;

		--	Добавление порядкового номера записи к гр. 1
		recRecord.vRecordNum	:= recRecord.vRecordNum || to_char(iCount);

		--	Формирование данных по записи
		ExportRecordS2
				(
					P_SUBSECTION	== vSubsection
				,	P_DATA			== recRecord
				,	P_PARENT_TAG	== vTag
				);
	&end_foreach;

	--	Если были данные, требуется закрыть блок по подразделу
	if vSubsectionPrev is not null then
		&lib_delta.CloseTag(vTag);
	end if;

	mDataS2.delete;
end;


/**
 * Формирование данных по возвратным операциям раздела 2
 */
procedure ExportSection2Return
is
	--	Формируемый тег
	vTag				varchar2(128);
	--	Количество записей в разделе
	iCount				integer;
begin
	--	Обработка массива подразделов
	&fforeach(lmDataReturnS2, vIdx, null)
		vTag	:= 'Раздел2Подраздел' || vIdx || 'Возврат';

		--	Открытие тега
		&lib_delta.OpenTag(vTag);

		--	Обнуление счётчика записей в блоке
		iCount	:= 0;

		--	Обработка массива данных подраздела
		&fforeach_rec(recRecord, lmDataReturnS2(vIdx), vIndex, null)
			iCount := iCount + 1;

			--	Добавление порядкового номера записи к гр. 1
			recRecord.vRecordNum	:= recRecord.vRecordNum || to_char(iCount);

			--	Формирование данных по записи
			ExportRecordS2
					(
						P_SUBSECTION	== vIdx
					,	P_DATA			== recRecord
					,	P_PARENT_TAG	== vTag
					);
		&end_foreach;

		--	Закрытие тега
		&lib_delta.CloseTag(vTag);
	&end_foreach;

	--	Очистка массива с данными
	lmDataReturnS2.delete;
end;


/**
 * Формирование данных
 */
procedure Export
is
begin
	--	Открытие блока "Данные405"
	&lib_delta.OpenTag('Данные405');

	--	Установка атрибута "Идентификатор номера" блока "Данные"
	&lib_delta.SetAttribute	(
								P_ATTR			== 'Ид'
							,	P_VALUE			== '1'
							);

	--	Формирование данных по блокам "Раздел1Подраздел1" и "Раздел1Подраздел2"
	ExportSection1;
	--	Формирование данных по блокам "Раздел1Подраздел1Возврат" и "Раздел1Подраздел2Возврат"
	ExportSection1Return;

	--	Формирование данных по блоку "Раздел2Подраздел1" и "Раздел2Подраздел2"
	ExportSection2;
	--	Формирование данных по блоку "Раздел2Подраздел1Возврат" и "Раздел2Подраздел2Возврат"
	ExportSection2Return;

	--	Закрытие блока "Данные405"
	&lib_delta.CloseTag('Данные405');
end;


/**
 * Очистка кэша
 */
procedure ClearCache
is
begin
	&set_zero(lrecParamInfo);

	lbGrp	:= null;

	lmBranchRegNum.delete;
	lmDataReturnS1.delete;
	lmDataReturnS2.delete;
end;


/**
 * Инициализация параметров экспорта
 *
 * @param P_PARAM	- Параметры реализации
 * @param P_STR		- Строка параметров
 */
procedure InitParam
		(
			P_PARAM		ref	[REPS_PARAMS]
		,	P_STR		varchar2(32767)
		)
is
begin
	--	Очистка кэша
	ClearCache;

	for	(
			select	rp
				(
					rp.[PROF]		:	C_PROF
				,	rp.[BRANCH]		:	C_BRANCH
				,	rp.[DATE1]		:	C_DATE1
				,	rp.[DATE2]		:	C_DATE2
				,	rp.[BANK]		:	C_BANK
				)
			in		::[REPS_PARAMS] all
			where	rp = P_PARAM
			fetch	1
		)
	loop
		lrecParamInfo.rParam		:= P_PARAM;				--	Ссылка на реализацию
		lrecParamInfo.rProf			:= rp.C_PROF;			--	Ссылка на профиль
		lrecParamInfo.rBranch		:= rp.C_BRANCH;			--	Ссылка на филиал
		lrecParamInfo.dDateBegin	:= rp.C_DATE1;			--	Дата начала отчётного периода
		lrecParamInfo.dDateEnd		:= rp.C_DATE2;			--	Дата окончания отчётного периода
		lrecParamInfo.rBank			:= rp.C_BANK;			--	Ссылка на банк
	end loop;

	--	Признак агрегирования данных в пределах дня
	lbGrp	:=	nvl(::[RUNTIME].[STR].get_bool_par(P_STR, 'P_GR'), false);

	&lf.InitParamInfo(P_PARAM);
	--	Инициализация параметров экспорта
	&lib_delta.Init(P_PARAM, P_STR);
end;


/**
 * Запуск экспорта в формате XML
 *
 * @param P_PARAM	- Параметры реализации
 * @param P_STR		- Строка параметров
 */
public function Run
		(
			P_PARAM		ref	[REPS_PARAMS]
		,	P_STR		varchar2(32767)
		)
	return	integer
is
begin
	if P_PARAM is null then
		&debug_output('Реализация не выбрана. Экспорт данных отчета в формат Дельта невозможен.', 0);

		return -1;
	end if;

	&debug_output('Начат экспорт данных в формат Дельта', 0);

	--	Инициализация параметров экспорта
	InitParam(P_PARAM, P_STR);

	--	Если в конфигурации указания нет библиотеки экспорта в формате Дельта,
	--	то экспорт не предназначен для данного указания и может быть некорректен
	if not ::[REPS_CB_ACTS].[LIB].IsContainLibrary(lrecParamInfo.rProf.[CB_ACT], &METHOD$SNAME) then
		&debug_output('Для выбранного профиля экспорт может быть некорректен!', 0);
	end if;

	--	Заполнение "шапки" отчёта
	&lib_delta.AddHeader6406
				(
					P_XMLNS				==	'urn:cbr-ru:rep0409405:v5.0.4.5'
				,	P_OKATO_LEN			==	8
				,	P_VID_REP			== 'основной'
				,	P_OTCHET_DATE_TYPE	==	1
				);

	--	Заполнение данных реализации
	Export;

	--	Заполнение "подвала" отчёта
	&lib_delta.AddFooter;

	--	Сохранение файла
	&lib_delta.SaveFile;

	--	Очистка кэша
	ClearCache;

	&debug_output('Закончен экспорт данных в формат Дельта', 0);

	return 0;
end;

end;
