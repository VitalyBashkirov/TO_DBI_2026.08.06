class AC_FIN;

@import_plsql(true)
@this(plsql_lock:=false,assert_null:=false)
@name('[ПСБ] Выписка ежедневная со всеми документами v2')
@tag('KUP_P')
method PSH_MOVE_DOC_MSK is

@name('Номер бал.счета') public V_PL_US_NUM [BSNUM];
public text_doc	[MEMO_BIG]; --varchar2(32767);
public OutText		[MEMO_BIG]; --varchar2(32767);

dp	 integer:=null; --управление debug_pipe
dp2	 integer:=null; 	--управление debug_pipe
fmt	 string:='dd.mm.yyyy';
frm8  string:='dd.mm.yy'; --'dd.mm.yy hh24:mi';
frm13 string:='dd.mm.yy hh24:mi';
frm17 string:='dd.mm.yy';
fmt17 integer:=8;
fmt999 string:='9,999,999,999.99';
fmtNDoc integer:=8;

function iif(u boolean, v1 varchar2, v2 varchar2) return varchar2 is begin if u then return v1; end if; return v2; end;
public function Sort(AccNum [ACCNUM], d_prov [DATE_TIME], s [SUMMA], P_SORT integer,
vDt integer) --Башкиров В.Г. 13.09.2013 Добавлена сортировка по ДТ/Кт и Сумме
return string(100) is 
ExStr string(100);
begin
	if P_SORT=1 then
		ExStr:=substr(AccNum, 1, 8)||substr(AccNum, 10)||to_char(d_prov,'yyyymmdd hh24:mi:ss')||lPad(to_char(s,'9999999999.99'),14,'0');
	else
		ExStr:=substr(AccNum, 1, 8)||substr(AccNum, 10)||
			nvl(vDt,0)|| --Башкиров В.Г. 13.09.2013 Добавлена сортировка по ДТ/Кт и Сумме
			lPad(to_char(s,'9999999999.99'),14,'0')||to_char(d_prov,'yyyymmdd hh24:mi:ss');
	end if;
	return ExStr;
end;
pragma restrict_references(Sort, wnds, wnps);
function toChar(s [SUMMA], Frmt string) return string is
ExStr string;
LenStr integer;
begin
	ExStr :=to_char(s,Frmt);
	LenStr:=Length(ExStr);
	ExStr :=trim(ExStr);
	--if s=277.5 then	debug_pipe('VND_MOVE_DOC.toChar -- s='||s||' ExStr='||ExStr||' LenStr='||LenStr,dp2); end if;
	If SubStr(ExStr,1,1)='.' then ExStr:='0'||ExStr; end if; --LenStr:=LenStr+1; end if;
	If SubStr(ExStr,Length(ExStr)-1,1)='.' then ExStr:=ExStr||'0'; end if;
	--if s=277.5 then	debug_pipe('VND_MOVE_DOC.toChar -- Выводим:'||Lpad(ExStr,LenStr,' '),dp2); end if;
	return Lpad(ExStr,LenStr,' ');
end;

