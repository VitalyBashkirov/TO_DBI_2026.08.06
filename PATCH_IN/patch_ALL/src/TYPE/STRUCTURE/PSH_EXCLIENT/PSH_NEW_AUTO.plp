class PSH_EXCLIENT;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Добавить')
@tag('CREATED')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('Реорганизованный клиент')        P_FROM_CLIENT in [CLIENT_REF],
	@name('Счета')                          P_ACCS        in [ACC_REF_ARR],
	@name('Дата прекращения деятельности')  P_DATE_END    in [DATE],
	@name('Дата сообщения в формате 311-П') P_DATE_311P   in [DATE],
	@name('Передан клиенту')                P_TO_CLIENT   in [CLIENT_REF]
) return ref [PSH_EXCLIENT] is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_FROM_CLIENT := this.[FROM_CLIENT];
	P_ACCS := this.[ACCS];
	P_DATE_END := this.[DATE_END];
	P_DATE_311P := this.[DATE_311P];
	P_TO_CLIENT := this.[TO_CLIENT];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Реорганизованный клиент"
	[FROM_CLIENT] := P_FROM_CLIENT;
	-- Установка значения реквизита "Дата прекращения деятельности"
	[DATE_END] := P_DATE_END;
	-- Установка значения реквизита "Дата сообщения в формате 311-П"
	[DATE_311P] := P_DATE_311P;
	-- Установка значения реквизита "Передан клиенту"
	[TO_CLIENT] := P_TO_CLIENT;
end;
end;
end;
