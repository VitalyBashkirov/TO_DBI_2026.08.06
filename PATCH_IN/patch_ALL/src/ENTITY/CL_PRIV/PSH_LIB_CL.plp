class CL_PRIV;

@name('[ПСБ] Библиотека')
@tag('KUP_P')
library PSH_LIB_CL is
public function vid_prod(cl_id varchar2, dog_num varchar2, dog_id varchar2, class_id string, TypeCardInfo integer default null) return memo is  -- возвращает продукт
rez_vid memo;
begin
	--debug_pipe(cl_id||' '||nvl(dog_num,0)||' '||nvl(dog_id,0)||' '||class_id,0);
	if class_id = 'KRED_PERS' then
		 for dp in ::[PR_CRED] all where dp.[CLIENT]=cl_id AND dp.[NUM_DOG]=dog_num AND dp%Id=dog_id
			loop	
				rez_vid:= dp.[KIND_CREDIT].[NAME];
			end loop;
	elsif class_id = 'DEPOSIT_PRIV' then
		 for dp in ::[DEPN] all where dp.[CLIENT]=cl_id AND dp%id=dog_id
			loop	
			  rez_vid:=dp.[VID_DOG].[NAME];
			end loop;
	elsif class_id = 'IND_SAFE_LEASE' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[IND_SAFE_LEASE] all where dp.[WHO_PAY]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=dp.[TYPE_DOG].[NAME]||'(Аренда индивидуальных сейфовых ячеек)';
					end loop;		
			end loop;
	elsif class_id = 'ZALOG' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[ZALOG] all where dp.[USER_ZALOG]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=dp.[VID_GUARANTEE].[NAME]||'(Обеспечение)';
					end loop;		
			end loop;		
	end if;
	
	--Башкиров В.Г. 24.06.2015 Вытаскиеваем данные по пластику
	if TypeCardInfo=0 then
	 	rez_vid:=null;
	 	for vc in ::[VZ_CARDS] where vc.[CLIENT]=cl_id and vc.[IP_ACCOUNTS_REF].[PROD_REF]=dog_id order by vc.[DATE_BEGIN], vc loop
	 	  --Карта (PAN карты)-Вид продукта (карты)-Состояние
	 		  rez_vid:=rez_vid||vc.[PAN]||'   '||vc.[IP_PRODUCTS_REF].[NAME]||'   '||vc%statename||LF$;
	 	end loop;
	  --rez_vid:=trim(trim(rez_vid,';'));
	end if;

	return rez_vid;	
end;

public function vid_stat(cl_id varchar2, dog_num varchar2, dog_id varchar2, class_id string) return memo is  -- возвращает статус
rez_vid memo;	
begin
	if class_id = 'KRED_PERS' then
		 for dp in ::[PR_CRED] all where dp.[CLIENT]=cl_id AND dp.[NUM_DOG]=dog_num AND dp%Id=dog_id
			loop	
				rez_vid:= dp.[COM_STATUS].[NAME];
			end loop;
	elsif class_id = 'DEPOSIT_PRIV' then
		 for dp in ::[DEPN] all where dp.[CLIENT]=cl_id AND dp%id=dog_id
			loop	
			  rez_vid:=dp.[COM_STATUS].[NAME];
			end loop;
	elsif class_id = 'IND_SAFE_LEASE' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[IND_SAFE_LEASE] all where dp.[WHO_PAY]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=dp.[COM_STATUS].[NAME];
					end loop;		
			end loop;
	elsif class_id = 'ZALOG' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[ZALOG] all where dp.[USER_ZALOG]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=dp.[COM_STATUS].[NAME];
					end loop;		
			end loop;
	end if;
	return rez_vid;	
end;

public function vid_sum(cl_id varchar2, dog_num varchar2, dog_id varchar2, class_id string) return string is  -- возвращает сумма
rez_vid string;	
begin
	if class_id = 'KRED_PERS' then
		 for dp in ::[PR_CRED] all where dp.[CLIENT]=cl_id AND dp.[NUM_DOG]=dog_num AND dp%Id=dog_id
			loop	
				rez_vid:= dp.[SUMMA_DOG];
			end loop;
	elsif class_id = 'DEPOSIT_PRIV' then
		 for dp in ::[DEPN] all where dp.[CLIENT]=cl_id AND dp%id=dog_id
			loop	
			  rez_vid:=dp.[SUMMA_DOG];
			end loop;
	elsif class_id = 'IND_SAFE_LEASE' then
		rez_vid:=null;
	elsif class_id = 'ZALOG' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[ZALOG] all where dp.[USER_ZALOG]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=dp.[SUMMA];
					end loop;		
			end loop;
	end if;
	return rez_vid;	
end;

public function vid_val(cl_id varchar2, dog_num varchar2, dog_id varchar2, class_id string) return string is  -- возвращает валюту
rez_vid string;	
begin
	if class_id = 'KRED_PERS' then
		 for dp in ::[PR_CRED] all where dp.[CLIENT]=cl_id AND dp.[NUM_DOG]=dog_num AND dp%Id=dog_id
			loop	
				rez_vid:= dp.[FT_CREDIT].[CUR_SHORT];
			end loop;
	elsif class_id = 'DEPOSIT_PRIV' then
		 for dp in ::[DEPN] all where dp.[CLIENT]=cl_id AND dp%id=dog_id
			loop	
			  rez_vid:=dp.[FINTOOL].[CUR_SHORT];
			end loop;
	elsif class_id = 'IND_SAFE_LEASE' then
		rez_vid:=null;
	elsif class_id = 'ZALOG' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[ZALOG] all where dp.[USER_ZALOG]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=dp.[VALUTA].[CUR_SHORT];
					end loop;		
			end loop;
	end if;
	return rez_vid;	
end;

public function vid_sum_rub(cl_id varchar2, dog_num varchar2, dog_id varchar2, class_id string) return string is  -- возвращает сумму в н.п.
rez_vid string;	
begin
	if class_id = 'KRED_PERS' then
		for(	
			select x(rec.[SUMMA_NAT]  : sum_nat
					 ,rec.[SUMMA]	  : sum_prov
					 ,x.[SUMMA_DOG]	  : sum_dog)
					 --,rec.[DATE]	  : prov_date
					 --,x.[DATE_BEGIN]  : dog_date
					 --,x.[ACCOUNT].[MAIN_V_ID] : acc)
			in ::[PR_CRED], ([RECORDS] all:rec) all
			where 	x.[ACCOUNT].[MAIN_V_ID]=rec.[ACC_CORR].[MAIN_V_ID] AND
					rec.[DATE] >= nvl(x.[DATE_BEGIN],x.[DATE_BEGINING]) AND
					x.[CLIENT]=cl_id AND
					x.[NUM_DOG]=dog_num AND
					x%Id=dog_id
			order by rec.[DATE]
		) loop
			
			if x.sum_dog = 0 then rez_vid:=0;
			else rez_vid:=x.sum_nat;
			end if;
			
			--debug_pipe(x.acc||' '||x.sum_nat||' '||x.dog_date||' '||x.prov_date,0);
			exit;
		end loop;
	elsif class_id = 'DEPOSIT_PRIV' then
			for(	
			        select x(rec.[SUMMA_NAT]  : sum_nat
					 		,rec.[SUMMA]	  : sum_prov
					 		,x.[SUMMA_DOG]	  : sum_dog)
			        in ::[DEPN], ([RECORDS] all:rec) all
			        where 	x.[ACCOUNT].[MAIN_V_ID]=rec.[ACC_CORR].[MAIN_V_ID] AND
			        		rec.[DATE] >= nvl(x.[DATE_BEGINING],x.[DATE_BEGIN]) AND
			        		x.[CLIENT]=cl_id AND
			        		x%Id=dog_id
					order by rec.[DATE]
			) loop
			
				if x.sum_dog = 0 then rez_vid:=0;
				else rez_vid:=x.sum_nat;
				end if;
				exit;
			end loop;
	elsif class_id = 'IND_SAFE_LEASE' then
		rez_vid:=null;
	elsif class_id = 'ZALOG' then
			for(	
			        select x(rec.[SUMMA_NAT]  	: sum_nat
					 		,rec.[SUMMA]	  	: sum_prov
					 		,x.[ARRAY_SUM_DOG]	: sum_dog)
			        in ::[PRODUCT], ([ZALOG] all:zal),([RECORDS] all:rec) all
			        where 	x.[NUM_DOG]=dog_num AND
			        		zal.[USER_ZALOG]=cl_id AND
			        		zal%id=x%id AND
			        		zal.[ACC_ZALOG].[MAIN_V_ID]=rec.[ACC_CORR].[MAIN_V_ID] AND
			        		rec.[DATE] >= nvl(x.[DATE_BEGINING],x.[DATE_BEGIN])
					order by rec.[DATE]
			) loop
			
				if x.sum_dog = 0 then rez_vid:=0;
				else rez_vid:=x.sum_nat;
				end if;
				exit;
			end loop;
	end if;
	return rez_vid;	
end;

public function vid_date_st(cl_id varchar2, dog_num varchar2, dog_id varchar2, class_id string) return memo is  -- возвращает дату начала
rez_vid memo;	
begin
	if class_id = 'KRED_PERS' then
		 for dp in ::[PR_CRED] all where dp.[CLIENT]=cl_id AND dp.[NUM_DOG]=dog_num AND dp%Id=dog_id
			loop	
				rez_vid:= to_char(dp.[DATE_BEGIN],'dd/mm/yyyy');
			end loop;
	elsif class_id = 'DEPOSIT_PRIV' then
		 for dp in ::[DEPN] all where dp.[CLIENT]=cl_id AND dp%id=dog_id
			loop	
			  rez_vid:=to_char(dp.[DATE_BEGIN],'dd/mm/yyyy');
			end loop;
	elsif class_id = 'IND_SAFE_LEASE' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[IND_SAFE_LEASE] all where dp.[WHO_PAY]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=to_char(dp.[DATE_BEGIN],'dd/mm/yyyy');
					end loop;		
			end loop;
	elsif class_id = 'ZALOG' then
		for pr in ::[PRODUCT] all where pr.[NUM_DOG]=dog_num
			loop
		 		for dp in ::[ZALOG] all where dp.[USER_ZALOG]=cl_id AND dp%id=pr%id
					loop	
			  			rez_vid:=to_char(dp.[DATE_BEGIN],'dd/mm/yyyy');
					end loop;		
			end loop;
	end if;
	return rez_vid;	
end;

