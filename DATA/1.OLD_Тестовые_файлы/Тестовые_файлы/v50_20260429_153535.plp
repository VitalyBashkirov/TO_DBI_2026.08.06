-- Тестовый файл для проверки правил: v50
-- Дата генерации: 2026-04-29 15:35:35

--[1] v50.п.1.1|Теги:|outer join,oracle,ansi

begin --<добавлено при генерации теста>
  В Oracle используется оператор `(+)` для внешнего соединения. В PostgreSQL и ANSI SQL его нет. Заменить на явные `LEFT JOIN` или `RIGHT JOIN` с условием `ON`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[2] v50.п.1.2|Теги:|rownum,limit,offset

begin --<добавлено при генерации теста>
  Псевдоколонка `rownum` не поддерживается в PostgreSQL. Использовать `FETCH FIRST N ROWS ONLY`. Для сдвига выборки использовать `OFFSET ON`. Не использовать `fetch` в подзапросе `EXISTS`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[3] v50.п.1.3|Теги:|udf,function,performance

begin --<добавлено при генерации теста>
  Пользовательские функции нельзя в условиях фильтрации, группировки и сортировки. Только в SELECT-листе верхнего уровня. Не поддерживается в подзапросах, UNION, выражениях. В представлениях не работают сортировка и фильтрация по UDF-колонкам.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[4] v50.п.1.6.1|Теги:|decode,case,conditional

begin --<добавлено при генерации теста>
  Функция `DECODE` специфична для Oracle. Заменять на ANSI-конструкцию `CASE WHEN ... THEN ... ELSE ... END`. При ошибке компиляции case-конструкции требуется ручная замена.
  exit; --<добавлено при генерации теста>
end;

--============================================================

--[5] v50.п.1.8|Теги:|hierarchical,connect by,cte

begin --<добавлено при генерации теста>
  Иерархические запросы с `CONNECT BY` не поддерживаются. Использовать рекурсивные CTE: `WITH RECURSIVE`. Нет аналога NOCYCLE — ограничение от зацикливания указывать в WHERE. Иерархические запросы по метаданным запрещены.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[6] v50.п.1.9|Теги:|system view,oracle,session

begin --<добавлено при генерации теста>
  Системные представления Oracle недоступны. Использовать `VW_DB_SESSION` с полями SESSION_SID, STATUS, MODULE, ACTION. Представления `VW_SQL` не поддерживаются полностью.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[7] v50.п.1.23|Теги:|context,userenv,database

begin --<добавлено при генерации теста>
  Контекст `USERENV` не поддерживается. Использовать `::[RUNTIME].[ENVIRONMENT].ClassStorage('ТБП').dbName`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[8] v50.п.1.14|Теги:|functional,attributes

begin --<добавлено при генерации теста>
  Функциональные реквизиты можно использовать только в SELECT-листе запроса верхнего уровня. Во всех остальных местах недопустимо использование без секции «SQL значение».
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[9] v50.п.1.21|Теги:|view,simple

begin --<добавлено при генерации теста>
  Простые представления отсутствуют в dbi проекте. Их нужно сконвертировать/переписать в PlPlus представления с учетом ANSI синтаксиса.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[10] v50.п.1.13|Теги:|collection,array,table

begin --<добавлено при генерации теста>
  Синтаксис выборки из коллекций не формализован в ANSI SQL. Поддержана выборка из скалярных ассоциативных массивов и из массивов объектных типов.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[11] v50.п.1.17|Теги:|dml,join,update,delete

begin --<добавлено при генерации теста>
  Нет совместимости синтаксиса `update/delete from (join)` между Oracle и PostgreSQL. Требуется переписать код, например, на подзапросы.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[12] v50.п.1.18|Теги:|hints,optimizer

begin --<добавлено при генерации теста>
  В PostgreSQL нет возможности управлять логикой работы Planner/Optimizer. Подсказки (hints) не работают, рекомендуется их удалять.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[13] v50.п.2.2|Теги:|date,type,timestamp

begin --<добавлено при генерации теста>
  В PostgreSQL тип `DATE` не хранит время. Использовать тип `DATE_TIME` (timestamp(0)). Для арифметики применять `INTERVAL`. Для вычитания дат использовать `to_number(to_char(date1-date2))`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[14] v50.п.2.8|Теги:|temp table,varray

begin --<добавлено при генерации теста>
  Временные таблицы приводят к проблемам производительности (pg_catalog bloat). Заменять на `VARRAY` (до 10 000 записей) или использовать `init_temp_table()`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[15] v50.п.2.6.3|Теги:|index,btree,size,limit

begin --<добавлено при генерации теста>
  Размер строки BTREE индекса не более 2704 байт. При превышении переходить на GIST/GIN индексы с опциями `gist_trgm_ops` или `gin_trgm_ops`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[16] v50.п.3.1.2|Теги:|crypto,security,hash

begin --<добавлено при генерации теста>
  Пакет `dbms_crypto` недоступен. Использовать `::[PCORE_INTERFACE].[INT_EXT_CALL_001]`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[17] v50.п.3.1.3|Теги:|smtp,email,mail

begin --<добавлено при генерации теста>
  Пакет `utl_smtp` недоступен. Использовать `::[PCORE_INTERFACE].[INT_EMAIL_001]`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[18] v50.п.3.1.6|Теги:|http,web,request

begin --<добавлено при генерации теста>
  Пакет `utl_http` недоступен. Использовать `::[RUNTIME].[HTTP_MGR]`. Функции: `url_escape`, `url_unescape`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[19] v50.п.3.3|Теги:|dynamic sql,execute,escape

begin --<добавлено при генерации теста>
  В `execute immediate` имена таблиц экранировать двойными кавычками: `"Z#MY_TABLE"`. Не использовать Oracle-специфичный синтаксис.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[20] v50.п.3.5|Теги:|exception,rollback,raise

begin --<добавлено при генерации теста>
  В PostgreSQL после ошибки транзакция прерывается. В `WHEN OTHERS` обязательно делать `ROLLBACK` (до savepoint) или `RAISE`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[21] v50.п.1.28|Теги:|bulk,batch,performance

begin --<добавлено при генерации теста>
  Для массовых операций включить batch через `APPLICATION.DBI=1` или `pragma hint('jdbc_batch(true)')`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[22] v50.п.3.1.4|Теги:|json,api,library

begin --<добавлено при генерации теста>
  Для работы с JSON использовать только `::[RUNTIME].[LIB_JSON]`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[23] v50.п.3.8|Теги:|trigger,database,plsql

begin --<добавлено при генерации теста>
  Триггеры БД заменить на операции типа «Триггер» в PL+.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[24] v50.п.3.6|Теги:|xml,parser,dom

begin --<добавлено при генерации теста>
  Для работы с XML использовать только библиотеки `[RUNTIME].[XML_DB]`, `[RUNTIME].[XML_DOM]`, `[RUNTIME].[XT]`, `[RUNTIME].[XQ]`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[25] v50.п.1.25|Теги:|exception,bulk,loop

begin --<добавлено при генерации теста>
  Конструкция `exceptionloop` запрещена, так как в PostgreSQL при возникновении исключения в SQL портится вся транзакция.
end loop; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[26] v50.п.3.4|Теги:|macro,substitution

begin --<добавлено при генерации теста>
  Макросы `execute` и `process` не поддерживаются в DBI. Их необходимо исключить из кода.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[27] v50.п.3.3|Теги:|dynamic sql,dbms_sql

begin --<добавлено при генерации теста>
  Динамический SQL через `DBMS_SQL` заменить на `::[RUNTIME].[CALC]` или `::[RUNTIME].[PLP]`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[28] v50.п.4.2|Теги:|dblink,rest,soap

begin --<добавлено при генерации теста>
  Database Link не поддерживается. Использовать веб-сервисы: REST (`1B060230` — потребитель, `1B060220` — поставщик) или SOAP (`1B060250` — потребитель, `1B060240` — поставщик).
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[29] v50.п.4.4|Теги:|queue,aq,mq

begin --<добавлено при генерации теста>
  Для работы с очередями использовать библиотеку `::[RUNTIME].[AQ_LIB]`. Для PostgreSQL обязательно использование Apache ActiveMQ.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[30] v50.п.6.10|Теги:|cache,ref,dereference

begin --<добавлено при генерации теста>
  Разыменование ссылок в цикле вызывает точечные запросы. Получать нужные поля сразу в SELECT-листе курсора.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[31] v50.п.6.13|Теги:|cache,hibernate,performance

begin --<добавлено при генерации теста>
  Для часто используемых ТБП настроить кэш 2 уровня в `config_orm.xml` с параметрами `read-only` (неизменяемые данные), `read-write` (строгая синхронизация) или `nonstrict_read_write`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

