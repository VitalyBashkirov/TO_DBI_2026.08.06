		V_OUT_CONV := nvl(this.[SETTYPE] = '7', false);
		if V_OUT_CONV then
			V_AGR_OUT_CONV := P_GET_OUTPUT;
			[STR].get_par(ORI_DOC_RC.[BLOCK_DATA], 'rate_out_conv', V_RATE_OUT_CONV);
			[STR].get_par(ORI_DOC_RC.[BLOCK_DATA], 'p_rate', P_RATE);
			if P_BACK_RATE is null then
				P_BACK_RATE := nvl(::[RUNTIME].[STR].GET_BOOL_PAR(this.[BLOCK_DATA], 'p_back_rate'), true);
			end if;
		end if;
		V_CR_210 := [STR].get_bool_par(ORI_DOC_RC.[BLOCK_DATA], 'MT210');
		if V_TYPED_COD in ('200', '202') then
			csmd.ShowS(V_VB, 'mt210');
			csmd.DisableS(V_VB, 'mt210');
		else
			csmd.HideS(V_VB, 'mt210');
		end if;
		
		for x in ::[DOCUM_RC_MESS] where x.[DOC_RC]=this and x.[MESS_TYPE] = 'ExtInfo' loop
			csmd.command( V_VB, 'Var_Proc.Top = Var_Proc.Top - 50');
			csmd.command( V_VB, 'Text131.Width = Text131.Width - 460');
			csmd.command( V_VB, 'Info2.Top = Info2.Top - 310');
			csmd.ShowS( V_VB, 'Info2');
			exit;
		end loop;
		
		P_KL_BNK.[0] := to_number(::[RUNTIME].[STR].GET_STR_PAR(this.[BLOCK_DATA], 'KL_BNK_385'));
		
		if ::[TRC].[GET_FLAG]('UFEBS_COS_ED503') then
			V_TO_ED503 := ::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'USE_ED503') or ::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'USE_SPFS');
		end if;
		
-->> PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline
		begin
			select x(x) in ::[TRC] where x.[CLEARING_BANK] = '1' and x.[STATUS] = ::[STATUS_MB]([CODE] = 'WORK') and x.[FILIAL] = this.[FILIAL] fetch 1 into v_dog;
			Use_Clearing_Bank := true;
			v_RCCL_OLD	:= P_RCCL;
			if ::[TRC].[GET_FLAG]('CLEAR_BANK_AUTO_DEF') and Use_Clearing_Bank and P_SUMMA = 0 and V_TYPED_COD<>'200' then
				P_RCCL := NVL(find_clearing_part(P_ISO, this.[FILIAL]), v_RCCL_OLD);
			end if;
		exception when NO_DATA_FOUND then
			Use_Clearing_Bank := false;
		end;
		if P_RCCL is null then
			P_RCCL := v_out_trc;
		end if; 
--<< PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline		
		
	elsif P_MESSAGE = 'VALIDATE' then
-->> PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline
		if P_INFO =	'P_NAME_BANKREC.BANK' then
			P_NAME_BANKREC.[ACC] := null;
			&SDL.fill_bank( P_NAME_BANKREC, V_TYPED_COD, P_CODE_BANKREC, '57', V_VB);
			if ::[TRC].[GET_FLAG]('CLEAR_BANK_AUTO_DEF') and Use_Clearing_Bank and V_TYPED_COD<>'200' then
				if P_NAME_BANKINT.[OPTION].[OPT] is null and P_NAME_BANKREC.[OPTION].[OPT] = 'A' then
					P_RCCL := NVL(find_rccl(P_NAME_BANKREC.[BANK].[SWIFT_C], this.[FILIAL], P_ISO), v_RCCL_OLD);
					P_INFO := 'P_RCCL';
				elsif P_NAME_BANKINT.[OPTION].[OPT] = 'A' then
					P_RCCL := NVL(find_rccl(P_NAME_BANKINT.[BANK].[SWIFT_C], this.[FILIAL], P_ISO), v_RCCL_OLD);
					P_INFO := 'P_RCCL';
				elsif P_NAME_BANKINT.[OPTION].[OPT] is null and P_NAME_BANKREC.[OPTION].[OPT] is null then
					P_RCCL := NVL(find_clearing_part(P_ISO, this.[FILIAL]), v_RCCL_OLD);
					P_INFO := 'P_RCCL';
				elsif P_NAME_BANKINT.[OPTION].[OPT] <> 'A' or (P_NAME_BANKINT.[OPTION].[OPT] is null or P_NAME_BANKREC.[OPTION].[OPT] <> 'A') then
					P_RCCL := v_RCCL_OLD;
					P_INFO := 'P_RCCL';
				end if;
			end if;
		end if;
--<< PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline		

		if P_INFO = '%VAR%.V_PANEL.0' then
			if V_PANEL.[0] = 4 then
-->> PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline
				this.[DEST]		 			:= P_DEST;
				this.[VALDATE]	 			:= P_VALDATE;
				this.[RECEIVER]				:= &SDL.swift_bank_to_part(P_NAME_BANKREC);
				this.[RECEIVER].[ACC] 		:= P_RECEIVER.[ACC];
				this.[RECEIVER].[OPTION_CL] := P_RECEIVER.[OPTION].[OPT];
				this.[RECEIVER].[NAME] 		:= &SDL.swift2_to_str(P_RECEIVER);
				this.[RECEIVER].[BACC]		:= P_NAME_BANKREC.[ACC];
				this.[BEN]					:= null;
				this.[PAYER].[NAME]			:= P_PAYER.[NAME];
				this.[RECEIVER].[OPTION_BANK]	:= P_NAME_BANKREC.[OPTION].[OPT];
				-- Поле 53
				this.[MT103].[F_53].[NAME] 			:= &SDL.swift2_to_str(P_NAME_BANK_53);	--P_NAME_BANK_53.[NAME];
				this.[MT103].[F_53].[ACC]			:= P_NAME_BANK_53.[ACC];
				this.[MT103].[F_53].[BANK]			:= P_NAME_BANK_53.[BANK];
				this.[MT103].[F_53].[OPTION_BEN]	:= P_NAME_BANK_53.[OPTION].[OPT];
				-- Поле 20
				this.[ELDOCNUM] 					:= P_TRN;
				-- Сумма документа
				this.[SUMMA]						:= P_SUMMA;  -->> PSH VRI 05/11/2025 CFT-2795 [ПСБ] Переотправка документов от SberFinline в 10 статусе
				P_DOPINFO := 'При экспорте в SWIFT будет сформирован следующий текст::' ||NL$|| get_dopinfo(this);
				-- Удаление поля 33B
				if P_DOPINFO like '%:33B:%' then
					P_DOPINFO := ::[HOOK_BANK].[DOC_RC_SWIFT_RUR].del_field_from_swift(P_DOPINFO, ':33B:');
				end if;
				-- Удаление поля 36
				if P_DOPINFO like '%:36:%' then
					P_DOPINFO := ::[HOOK_BANK].[DOC_RC_SWIFT_RUR].del_field_from_swift(P_DOPINFO, ':36:');
				end if;
				
-->> PSH VRI 02/10/2025 CFT-2508 Закомментарил
				/*-- Покажем SWIFTовку
				if V_TYPED_COD = 'SWT' then --(kozlova)
					if P_DOPINFO is null then
						begin
							&sp(sp1)
							::[DOCUM_RC].[SWIFT_LIB].INIT_EXP_FORMAT;
							P_DOPINFO := 'При экспорте в SWIFT будет сформирован следующий текст:' || NL$
								|| ::[DOCUM_RC].[SWIFT_LIB_EXP].get_block_4(this, V_TYPED_COD, ::[TRC].[INI].TODAY, false, null, false,
																			::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'MT103COV'));
						exception when OTHERS then
							&rb(sp1)
						end;
						::[DOCUM_RC].[T_LIB].RESET_ERRS;
					end if;
--<<(kozlova)				
				else		
					if vTextFirstDoc is not null then
						P_DOPINFO := 'Текст входящего документа:'||NL$||vTextFirstDoc||NL$||NL$;
					else
						P_DOPINFO := null;	
					end if;	
					if ::[DOCUM_RC].[LIB_NEW].is_fin_doc(ORI_DOC_RC.[TYPE_DOC]) and ORI_DOC_RC.[FLAG_EXPORT_DOC] then -- если фин.док. уже экспортирован, в DOPINFO уже будет помещен текст экспртированного сообщения, поэтому просто выведем этот текст, а не будем вызывать его посторное переформирование
						P_DOPINFO := P_DOPINFO||'Текст экспортированного документа:'||NL$||ORI_DOC_RC.[DOPINFO];
					else
						P_DOPINFO := P_DOPINFO||bool_char(nvl(ORI_DOC_RC.[FLAG_EXPORT_DOC], false) = false, 'При экспорте в SWIFT будет сформирован следующий текст:' , 'Текст экспортированного документа:')||NL$||::[DOCUM_RC].[PROC#VD_3].get_dopinfo(this);
					end if;
				end if;
--(kozlova)>>*/
--<< PSH VRI 02/10/2025 CFT-2508 Закомментарил				
			end if;

			
			--Показываем кнопки "Дело" и "Инф. док." в зависимости от настроек и наличия объектов
			if V_PANEL.[0] in (1,4) then
				if ORI_DOC_RC.[TYPE_DOC] != '007' then
					--Для финансовых документов заполним информационные документы
					if V_STR_INF_DOCS is not null then
						csmd.Show( V_VB, 'V_INF_DOCS', 'V');
					end if;
				end if;
				
				--Дела по переписке
				if ::[INVESTIGATION].[LIB].check_swift_app then
					if V_INV is not null then
						csmd.Show( V_VB, 'V_INV', 'V', true );
					end if;			
				end if;			
			end if;
		end if;

		if P_INFO = 'SHOW_AUDIT' then
			stdio.put_line_buf('<% CALL DOCUM_RC AUDIT ' || this%id || '%>');
		end if;
		
		if P_INFO = 'CANCEL' then
-->> PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline
			-- Возвращаем первоначальные значения документов
			this.[DEST] := v_dest_prev;
			this.[VALDATE] := v_valdate_pr;
			this.[RECEIVER].[NAME] 		:= v_pol_name_pr;
			this.[RECEIVER].[ACC] 		:= v_pol_acc_pr;
			this.[RECEIVER].[BCODE] 	:= v_pol_bcode_pr;
			this.[RECEIVER].[BANK] 		:= v_pol_bname_pr;	
			this.[RECEIVER].[BANK_REF]  := v_pol_bank_pr;
			this.[RECEIVER].[BACC]		:= v_pol_bacc_pr;
			this.[DOPINFO]				:= v_dopinfo_pr;
			this.[DOC_TEXT]				:= v_doc_text_pr;
			this.[PAYER].[NAME]			:= v_pay_name;
			this.[RECEIVER].[OPTION_BANK]	:= v_pol_bank_opt;
			this.[MT103].[F_53].[NAME] 	:= v_name_bank_53;
			this.[MT103].[F_53].[ACC]	:= v_acc_bank_53;
			this.[MT103].[F_53].[BANK]	:= v_bank_53;
			this.[MT103].[F_53].[OPTION_BEN]	:= v_opt_bank_53;
			this.[ELDOCNUM]				:= v_trn;
			this.[SUMMA]				:= v_sum_doc;  -->> PSH VRI 05/11/2025 CFT-2795 [ПСБ] Переотправка документов от SberFinline в 10 статусе
--<< PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline			
			[CONTROL].[CONTROL] := null;	
		end if;
		
		if P_INFO = 'Инфо' then
			stdio.put_line_buf('<% PLPCALL %THIS%.[LOOK_EXT_INFO](%PARAM%.P_MESS_TYPE => ''ExtInfo'')%>');
		end if;
		
		if ::[RUNTIME].[LOB_UTILS].lob_check_validate_info(P_INFO) then			
			::[RUNTIME].[LOB_UTILS].lob_validate(P_INFO, V_LOB_BUFF, mx_blob);
			return;
		end if;
	end if;
end;

execute is
	main_doc ref [MAIN_DOCUM];
	aux_ctrl_obj reference;
	v_doc_temp	ref [DOCUM_RC];
BEGIN

	if [CONTROL].[CONTROL]
		 and ([FLAG_UPDATE] in ('4', '6')
			-- обработка документа РЦ ничем не заблокирована и документ отказан из РЦ - подтверждение разрешаем иначе застревает на доп. контроле при повторной обработке
			or ([FLAG_UPDATE] is null and this%state = 'S_16' and [GOROUTER] = 3))
	then
		main_doc := [DOCUM_RC].[LIB_VIEW].GetProv(this);
		main_doc.[USER_EXEC] := [TRC].[INI].CUR_USER;

		If V_VARIANT.[0] = 3 then	-- подтвердить
			if	main_doc%state in ('TO_RKO', 'PODTV', 'PRO', 'AUX_CTRL') then
				-- Подтверждение выполняется из операции "Получение документа SWIFT контролером"
				if ::[FP_TUNE].[LIB].get_bool_value('PODTV_MARK', ::[FP_TUNE].[LIB].set_canons('<PAY_RF_SWIFT>', 'PAY_SWIFT'), '0') then
					declare
						v_user [USER] := stdlib.userid;
					begin
						::[DOCUMENT].[DOC_LIB].add_history_state(
							main_doc
							, 'PODTV_MARK'
							, p_add_info == 'Подтверждено. Контролер ' || v_user.[NAME] ||' (' || v_user.[USERNAME] || ')'
							, p_check == true
							, p_date == sysdate
						);
					end;
				end if;
				
				if main_doc%state = 'AUX_CTRL' then
					aux_ctrl_obj%id := main_doc%id;
					if ::[AUX_CTRL_COND].[LIB_CHECK].get_object_ctrl_type(aux_ctrl_obj, main_doc%class) is not null then
						::[MAIN_DOCUM].[MD_FUN_ADD].accept_doc(main_doc, p_doc_rc == this);

					end if;
				else
					main_doc.[DOC_TO_PROV];
				end if;
			else
				begin
					-- Зачистим признак изменения только если документ уже в РЦ, иначе его потом ничем не снимешь
					-- в противном случае поставим признак "Валютный контроль пройден"
					if main_doc%state = 'TO_MBR' then
						[FLAG_UPDATE] :=  null;
					else
						[FLAG_UPDATE] :=  '6';
					end if;
					-- заполняем контролера
					[AUDIT].[EDIT] := ::[TRC].[INI].CUR_USER;
	
					if main_doc%state not in ('TO_MBR', 'PROV', 'PROV_IN_BANK') then
						ON_CONTROL := true; -- признак вызова проводки из контроля
						main_doc.[DOC_TO_PROV];
						ON_CONTROL := null;
					end if;
					begin
						&sp(sp2)
						if main_doc%state = 'PRO' then
							[FLAG_UPDATE] :=  '6';
						end if;
					exception when others then
						&rb(sp2)
					end;
					if this%state <> 'S_2' then
						[DOCUM_RC].[ADD_REC].COM := 'Валютный документ проконтролирован';
						this%state := 'S_2';
					end if;
				exception when others then
					--Причина перехвата others: необходимо перехватывать любые исключения при проводке
					-- возникла ситуация, когда проводка сломалась,
					-- а документ оказался проконтролирован и был подхвачен автоматом
					stdio.put_line_buf( [PRINTFUN].SQLERRM_inf);
					ON_CONTROL := null;
					rollback;
				end;
			end if;
		elsif V_VARIANT.[0] = 2 then	-- возвратить
			stdio.put_line_buf('<% CALL MAIN_DOCUM TO_RETURN '|| main_doc ||' %>');
		elsif V_VARIANT.[0] = 1 then	-- без обработки
			NULL;
		End if;
	end if;

-->> PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline
	-- Поле 20
	this.[ELDOCNUM]						:= P_TRN;
	
	/*-- Поле 50
	this.[PAYER].[ACC]  				:= P_PAYER.[ACC];

	-- Поле 50
	this.[PAYER].[OPTION_CL] 			:= P_PAYER.[OPTION].[OPT];
	this.[PAYER].[BANK_REF] 			:= P_NAME_BANKPAY.[BANK];
	this.[PAYER].[INN]					:= null;*/
	this.[PAYER].[NAME] 				:= &SDL.swift2_to_str(P_PAYER);

	-- Поле 53
	this.[MT103].[F_53].[NAME] 			:= P_NAME_BANK_53.[NAME];
	this.[MT103].[F_53].[ACC]			:= P_NAME_BANK_53.[ACC];
	this.[MT103].[F_53].[BANK]			:= P_NAME_BANK_53.[BANK];
	this.[MT103].[F_53].[OPTION_BEN]	:= P_NAME_BANK_53.[OPTION].[OPT];

	-- Поле 57
	this.[RECEIVER]						:= &SDL.swift_bank_to_part(P_NAME_BANKREC);
	this.[RECEIVER].[PART_REF] 			:= P_RCCL;
	this.[RECEIVER].[BACC]				:= P_NAME_BANKREC.[ACC];
	this.[RECEIVER].[OPTION_BANK]		:= P_NAME_BANKREC.[OPTION].[OPT];
	
	--if P_TYPE_DOC.[SFORM] like '103%' then
		-- Поле 59
		this.[RECEIVER].[ACC] 			:= P_RECEIVER.[ACC];
		this.[RECEIVER].[OPTION_CL] 	:= P_RECEIVER.[OPTION].[OPT];
		this.[RECEIVER].[NAME] 			:= &SDL.swift2_to_str(P_RECEIVER);
		this.[BEN]						:= null;
	-- Поле 70
	this.[DEST] 						:= &SDL.str_to_swt(P_DEST);
	-- Дата валютирования
	this.[VALDATE]						:= P_VALDATE;
	-- Сумма документа
	this.[SUMMA]						:= P_SUMMA;  -->> PSH VRI 05/11/2025 CFT-2795 [ПСБ] Переотправка документов от SberFinline в 10 статусе 

	-- Меняем код UETR в 121 блока 3 заголовка SWIFT
	v_doc_temp := ::[DOCUM_RC].[LIB_VIEW].GetFirst(::[DOCUM_RC].[MFIL_LIB_EXP].get_first_doc(this));
	for x in ::[DOC_UETR] 
	where x.[DOC_RC_REF] = v_doc_temp
	loop
		x.[UETR] := lower(::[RUNTIME].[LIB_UUID].gen_uuid_v4);
		exit;
	end loop;
	
	--if v_dopinfo_pr	is not null and nvl(v_doc_text_pr, 'NO_UPDATE')  = 'NO_UPDATE' then
		--this.[DOC_TEXT]	:= 'Текст экспортированного документа:' || NL$ || v_dopinfo_pr;
	--end if;
--<< PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline

	[CONTROL].[CONTROL] := null;
	if P_PRINT then
		stdio.put_line_buf('<% CALL DOCUM_RC PRINT_SWIFT ' || this%id || '%>' || NL$);
	end if;
END;
end;
end;
