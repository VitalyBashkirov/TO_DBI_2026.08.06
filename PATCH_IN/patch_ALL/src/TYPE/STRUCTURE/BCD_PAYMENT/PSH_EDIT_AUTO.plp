class BCD_PAYMENT;

@name('[ПСБ] Изменить (очень служебная)')
@tag('CREATED')
method PSH_EDIT_AUTO is
PSH_EDIT_AUTO (
	@name('Дата получения')                               P_DATE_RECEIVE    in [DATE_TIME],
	@name('Дата отправки')                                P_DATE_SEND       in [DATE_TIME],
	@name('Договор ДБО')                                  P_AGR_REF         in [BANK_CLIENT_REF],
	@name('Служебные отметки')                            P_ERR_DESC        in [MEMO_4000],
	@name('Входящий объект')                              P_IS_IN           in [BOOLEAN],
	@name('Подписи')                                      P_SIGNS           in [BC_SIGN_REF_ARR],
	@name('Идентификатор документа')                      P_SYS_ID          in [STRING_40],
	@name('Идентификатор связанного документа')           P_SYS_REF_ID      in [STRING_40],
	@name('Дата документа')                               P_DOC_DATE        in [DATE],
	@name('Тип документа')                                P_DOC_TYPE        in [STRING_40],
	@name('Вид документа банк-клиента')                   P_BCD_TYPE        in [BC_DOC_TYPES_REF],
	@name('Номер документа')                              P_DOC_NUM         in [NUMBER_DOC],
	@name('Приоритет')                                    P_QUEUE_PRIORITY  in [SHORT2],
	@name('Сумма')                                        P_SUMM            in [SUMMA],
	@name('Флаг обработки')                               P_DO_PROC_FLAG    in [BOOLEAN],
	@name('Вложенные файлы')                              P_FILES           in [BC_ATTACH_FI_ARR],
	@name('Вид пересылки документа')                      P_SEND_TYPE       in [STRING_1],
	@name('Очередность платежа')                          P_PRIORITY        in [SHORT1],
	@name('Приоритет обработки')                          P_SUB_PRIORITY    in [SHORT1],
	@name('Назначение платежа')                           P_PURPOSE         in [MEMO],
	@name('Бюджетный платеж')                             P_BUD_FLAG        in [BOOLEAN],
	@name('НДС')                                          P_NDS_INFO        in [STRING_50],
	@name('Дата валютирования')                           P_DATE_VAL        in [DATE],
	@name('Бюджетные реквизиты')                          P_BUD_REQS        in [BUD_REQ],
	@name('Описание рискового платежа')                   P_SUSPECT_HINT    in [MEMO],
	@name('Признак рискового платежа')                    P_SUSPECT_FLAG    in [BOOLEAN],
	@name('Плательщик')                                   P_PAYER           in [BC_PAY_REQS],
	@name('Получатель')                                   P_PAYEE           in [BC_PAY_REQS],
	@name('Исходный плательщик')                          P_ORIGINAL_PAYER  in [BC_PAY_REQS],
	@name('Служебная информация faktura.ru')              P_INTERNAL_DATA   in [BC_INTERNAL_DATA],
	@name('Идентификатор начисления ГИС ГМП')             P_CHARGE_ID       in [STRING_100],
	@name('Информация о способе подтверждения документа') P_AUTH_INFO       in [BC_AUTH_INFO],
	@name('Код платежа')                                  P_PAYMENT_CODE    in [STRING_40],
	@name('IP-адрес клиента')                             P_SYS_IP          in [STRING_40],
	@name('Инициатор бюджетного платежа')                 P_BUD_INITIATOR   in [BC_TAX_INITIATOR],
	@name('Информация о ДП ЗК')                           P_DP_ZK           in [BC_INFO_DP_ZK],
	@name('Информация об устройстве')                     P_DEVICE_INFO     in [BC_DEVICE_INFO],
	@name('Назначение платежа кодовое')                   P_PURPOSE_CODE    in [STRING_35],
	@name('Статус проверки антифродом')                   P_ANTIFRAUD_STATE in [STRING_64],
	@name('Информация о выставленном счете')              P_INVOICE_INFO    in [BC_INVOICE_INFO],
	@name('Сумма НДС')                                    P_SUMM_NDS        in [SUMMA]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE_RECEIVE := this.[DATE_RECEIVE];
	P_DATE_SEND := this.[DATE_SEND];
	P_AGR_REF := this.[AGR_REF];
	P_ERR_DESC := this.[ERR_DESC];
	P_IS_IN := this.[IS_IN];
	P_SIGNS := this.[SIGNS];
	P_SYS_ID := this.[SYS_ID];
	P_SYS_REF_ID := this.[SYS_REF_ID];
	P_DOC_DATE := this.[DOC_DATE];
	P_DOC_TYPE := this.[DOC_TYPE];
	P_BCD_TYPE := this.[BCD_TYPE];
	P_DOC_NUM := this.[DOC_NUM];
	P_QUEUE_PRIORITY := this.[QUEUE_PRIORITY];
	P_SUMM := this.[SUMM];
	P_DO_PROC_FLAG := this.[DO_PROC_FLAG];
	P_FILES := this.[FILES];
	P_SEND_TYPE := this.[SEND_TYPE];
	P_PRIORITY := this.[PRIORITY];
	P_SUB_PRIORITY := this.[SUB_PRIORITY];
	P_PURPOSE := this.[PURPOSE];
	P_BUD_FLAG := this.[BUD_FLAG];
	P_NDS_INFO := this.[NDS_INFO];
	P_DATE_VAL := this.[DATE_VAL];
	P_BUD_REQS := this.[BUD_REQS];
	P_SUSPECT_HINT := this.[SUSPECT_HINT];
	P_SUSPECT_FLAG := this.[SUSPECT_FLAG];
	P_PAYER := this.[PAYER];
	P_PAYEE := this.[PAYEE];
	P_ORIGINAL_PAYER := this.[ORIGINAL_PAYER];
	P_INTERNAL_DATA := this.[INTERNAL_DATA];
	P_CHARGE_ID := this.[CHARGE_ID];
	P_AUTH_INFO := this.[AUTH_INFO];
	P_PAYMENT_CODE := this.[PAYMENT_CODE];
	P_SYS_IP := this.[SYS_IP];
	P_BUD_INITIATOR := this.[BUD_INITIATOR];
	P_DP_ZK := this.[DP_ZK];
	P_DEVICE_INFO := this.[DEVICE_INFO];
	P_PURPOSE_CODE := this.[PURPOSE_CODE];
	P_ANTIFRAUD_STATE := this.[ANTIFRAUD_STATE];
	P_INVOICE_INFO := this.[INVOICE_INFO];
	P_SUMM_NDS := this.[SUMM_NDS];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Дата получения"
	[DATE_RECEIVE] := P_DATE_RECEIVE;
	-- Установка значения реквизита "Дата отправки"
	[DATE_SEND] := P_DATE_SEND;
	-- Установка значения реквизита "Договор ДБО"
	[AGR_REF] := P_AGR_REF;
	-- Установка значения реквизита "Служебные отметки"
	[ERR_DESC] := P_ERR_DESC;
	-- Установка значения реквизита "Входящий объект"
	[IS_IN] := P_IS_IN;
	-- Установка значения реквизита "Идентификатор документа"
	[SYS_ID] := P_SYS_ID;
	-- Установка значения реквизита "Идентификатор связанного документа"
	[SYS_REF_ID] := P_SYS_REF_ID;
	-- Установка значения реквизита "Дата документа"
	[DOC_DATE] := P_DOC_DATE;
	-- Установка значения реквизита "Тип документа"
	[DOC_TYPE] := P_DOC_TYPE;
	-- Установка значения реквизита "Вид документа банк-клиента"
	[BCD_TYPE] := P_BCD_TYPE;
	-- Установка значения реквизита "Номер документа"
	[DOC_NUM] := P_DOC_NUM;
	-- Установка значения реквизита "Приоритет"
	[QUEUE_PRIORITY] := P_QUEUE_PRIORITY;
	-- Установка значения реквизита "Сумма"
	[SUMM] := P_SUMM;
	-- Установка значения реквизита "Флаг обработки"
	[DO_PROC_FLAG] := P_DO_PROC_FLAG;
	-- Установка значения реквизита "Вид пересылки документа"
	[SEND_TYPE] := P_SEND_TYPE;
	-- Установка значения реквизита "Очередность платежа"
	[PRIORITY] := P_PRIORITY;
	-- Установка значения реквизита "Приоритет обработки"
	[SUB_PRIORITY] := P_SUB_PRIORITY;
	-- Установка значения реквизита "Назначение платежа"
	[PURPOSE] := P_PURPOSE;
	-- Установка значения реквизита "Бюджетный платеж"
	[BUD_FLAG] := P_BUD_FLAG;
	-- Установка значения реквизита "НДС"
	[NDS_INFO] := P_NDS_INFO;
	-- Установка значения реквизита "Дата валютирования"
	[DATE_VAL] := P_DATE_VAL;
	-- Установка значения реквизита "Бюджетные реквизиты"
	[BUD_REQS] := P_BUD_REQS;
	-- Установка значения реквизита "Описание рискового платежа"
	[SUSPECT_HINT] := P_SUSPECT_HINT;
	-- Установка значения реквизита "Признак рискового платежа"
	[SUSPECT_FLAG] := P_SUSPECT_FLAG;
	-- Установка значения реквизита "Плательщик"
	[PAYER] := P_PAYER;
	-- Установка значения реквизита "Получатель"
	[PAYEE] := P_PAYEE;
	-- Установка значения реквизита "Исходный плательщик"
	[ORIGINAL_PAYER] := P_ORIGINAL_PAYER;
	-- Установка значения реквизита "Служебная информация faktura.ru"
	[INTERNAL_DATA] := P_INTERNAL_DATA;
	-- Установка значения реквизита "Идентификатор начисления ГИС ГМП"
	[CHARGE_ID] := P_CHARGE_ID;
	-- Установка значения реквизита "Информация о способе подтверждения документа"
	[AUTH_INFO] := P_AUTH_INFO;
	-- Установка значения реквизита "Код платежа"
	[PAYMENT_CODE] := P_PAYMENT_CODE;
	-- Установка значения реквизита "IP-адрес клиента"
	[SYS_IP] := P_SYS_IP;
	-- Установка значения реквизита "Инициатор бюджетного платежа"
	[BUD_INITIATOR] := P_BUD_INITIATOR;
	-- Установка значения реквизита "Информация о ДП ЗК"
	[DP_ZK] := P_DP_ZK;
	-- Установка значения реквизита "Информация об устройстве"
	[DEVICE_INFO] := P_DEVICE_INFO;
	-- Установка значения реквизита "Назначение платежа кодовое"
	[PURPOSE_CODE] := P_PURPOSE_CODE;
	-- Установка значения реквизита "Статус проверки антифродом"
	[ANTIFRAUD_STATE] := P_ANTIFRAUD_STATE;
	-- Установка значения реквизита "Информация о выставленном счете"
	[INVOICE_INFO] := P_INVOICE_INFO;
	-- Установка значения реквизита "Сумма НДС"
	[SUMM_NDS] := P_SUMM_NDS;
end;
end;
end;
