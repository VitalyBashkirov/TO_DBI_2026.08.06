--Дианков А.В. 18.01.2016 Добавлена функция
--Дианков А.В. 18.01.2016 Вычисление реквизитов клиента
public function CL_REC(cl_ref ref [CLIENT],
				p_info varchar2,
				--client_org_ref ref [CL_ORG] default null,
				--cl_org_dolg_fase ref [PERSONS_POS] default null,
				P_HEADUSER ref [USER] default null,         --P_HEADUSER ref [USER], 12/07/2023 Башкиров В.Г.
				P_DATE_PRINT date default null,             --P_DATE_PRINT date,
				is_first	number  default 0) return memo is  --is_first	number := 0) return memo is --is_first	number := 0) return memo 
	
	--PRIV_BUSINES boolean;
	V_SIMPLE_IDENT boolean;
	ip			   boolean:=false;
	P_DATE_ANK 		date;	
	cl_org_dolg_fase ref [PERSONS_POS] default null;
	
	temp_str  varchar2(2000) := '';
    temp_str1 varchar2(2000) := '';
    temp_str2 varchar2(2000) := '';

    DATE_TMP_1 [DATE];			-- Башкиров В.Г. 15.09.2011
    DATE_TMP_2 [DATE];			-- Башкиров В.Г. 15.09.2011
    P_DATA_1   [MEMO];			-- Башкиров В.Г. 11.03.2012
    P_DATA_2   [MEMO];			-- Башкиров В.Г. 11.03.2012
    P_DATA_3   [MEMO];			-- Башкиров В.Г. 11.03.2012
    P_DATA_4   [MEMO];			-- Башкиров В.Г. 11.03.2012
    P_DATA_5   [MEMO];			-- Башкиров В.Г. 22.08.2012
    P_DATA_6   [MEMO];			-- Башкиров В.Г. 22.08.2012

    Client_ref REF [CLIENT];  -- NGA07082013
    v_cl_links	[LINKS_CL_ARR];
    recprop  [PROPERTIES];

    P_DATA [MEMO_32767];
begin	
		
		-- Инициализация переменных		
		op_dat := [System].[Op_date];
		
		if P_DATE_PRINT is null then P_DATE_PRINT:=op_dat; end if;
		
		V_SIMPLE_IDENT := false;
		rabota := null;
		account := null;
		
		account_tmp := null;  --NGA25092013
		
	if is_first = 0 then
		&debug('11111111111111++++%%%%++++',0)
		client_priv	:= null;
		client_corp	:= null;
		client_bank := null;

		--Получаем структуры клиентов на дату
		--Изменения анкеты, сделанные в дату P_DATE_PRINT, начинают действовать сразу же,
		--т.е. прежние реквизиты будут действительны до (P_DATE_PRINT-1) включительно.
		if cl_ref%class = 'CL_ORG' AND cl_ref->(CL_CORP)[FORMA].[SHORT_NAME] != 'ИП' then
			client_corp := [CL_HIST].[LIB].get_cl_corp(cl_ref,P_DATE_PRINT+1);

		elsif cl_ref%class = 'CL_ORG' AND cl_ref->(CL_CORP)[FORMA].[SHORT_NAME] = 'ИП' then
			declare
				dolg_fase [PERSONS_POS];
			begin
				locate exact dolg_fase in cl_ref->(CL_CORP)[ALL_BOSS] where dolg_fase.[FASE] is not null and dolg_fase.[CHIEF] = true; -- для ИП должностных лиц может быть несколько и надо учитывать "Признак руководителя"
				-- устанавливаем глоб. парам. - ссылку на должностное лицо
				cl_org_dolg_fase:=dolg_fase;
				client_priv := dolg_fase.[FASE];
			exception
					when NO_DATA_FOUND then
						pragma error ('Не найдено ни одной ссылки на физическое лицо с "Признаком руководителя" в массиве "Должностные лица" для данного индивидуального предпринимателя!');
					when TOO_MANY_ROWS then
						pragma error ('Найдено несколько ссылок на физическое лицо с "Признаком руководителя" в массиве "Должностные лица" для данного индивидуального предпринимателя!');
			end;
			client_corp := [CL_HIST].[LIB].get_cl_corp(cl_ref,P_DATE_PRINT+1);
			ip:=true;

		elsif cl_ref%class = 'CL_BANK_N' then
			client_bank%id := cl_ref%id;
		elsif cl_ref%class = 'CL_PRIV' then
			client_priv := [CL_HIST].[LIB].get_cl_priv(cl_ref,P_DATE_PRINT+1);
		end if;
		v_rec_prod_tbl.delete;
		v_rec_prod_tbl := [PRODUCT].[PSH_LIB].get_product_on_date(	cl_ref, -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
																	null,
																	null,
																	true);

--> ivanov.a.v. 17/04/2017 Анкета
		-- дата начала клиентства
		v_date_beg_cl := null;
		for i in 1..v_rec_prod_tbl.count loop
			if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
				exit;
			else
				if i = 1 then
					v_date_beg_cl := v_rec_prod_tbl(i).p_date_begin;
				end if;
				if nvl(v_rec_prod_tbl(i).split,'0') = '1' then
					v_date_beg_cl := v_rec_prod_tbl(i).p_date_begin;
				end if;
			end if;
		end loop;

		-- дата окончания клиентства
		v_date_end_cl := null;
		for i in 1..v_rec_prod_tbl.count loop
			if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
				exit;
			else
				if i = 1 then
					v_date_end_cl := v_rec_prod_tbl(i).p_date_close;
				end if;
				if v_rec_prod_tbl(i).p_date_close >= v_date_end_cl then
					v_date_end_cl := v_rec_prod_tbl(i).p_date_close;
					v_is_once := v_rec_prod_tbl(i).p_is_once;
				end if;
			end if;
		end loop;

		t_date_upd.delete;
		/** /
		for (	select x(	x.[DATE_UPD]	:c_date,
							x.[WHO_UPDATE]	:c_user)
					in	[CL_DATE_FORM_UPD],
						([CLIENT]	all :c) all
				where	x%collection = c.[DATES_FORM_UPD] and
						c%id = cl_ref%id and
						x.[DATE_UPD] >= v_date_beg_cl and
						x.[DATE_UPD] <= v_date_end_cl
				order by x.[DATE_UPD])
		loop
			v_idx_upd := to_char(x.c_date,'yyyymmdd');
			t_date_upd(v_idx_upd).date_upd := x.c_date;
			t_date_upd(v_idx_upd).user_upd := x.c_user;
		end loop;
		/**/
		
		for i in 1..v_rec_prod_tbl.count loop
			if v_rec_prod_tbl(i).p_date_begin >= v_date_beg_cl and v_rec_prod_tbl(i).p_date_begin <= v_date_end_cl then
				v_idx_upd := to_char(v_rec_prod_tbl(i).p_date_begin,'yyyymmdd');
				if not t_date_upd.exists(v_idx_upd) then
					t_date_upd(v_idx_upd).date_upd := v_rec_prod_tbl(i).p_date_begin;
					t_date_upd(v_idx_upd).user_upd := v_rec_prod_tbl(i).create_user;
				else
					if t_date_upd(v_idx_upd).user_upd is null then
						t_date_upd(v_idx_upd).user_upd := v_rec_prod_tbl(i).create_user;
					end if;
				end if;
			end if;
		end loop;

--< ivanov.a.v. 17/04/2017 Анкета

	end if;
		
				-- Башкиров В.Г. 15.09.2011
		::[CL_HIST].[PSH_LIB].GetLastEdit(cl_ref,false,P_DATE_ANK,DATE_TMP_2); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
		--NGA07082013 P_DATE_ANK := least(nvl(date_acc1,P_DATE_ANK), P_DATE_ANK);  --NGA
	
		begin

			for a in ::[AC_FIN]
			where a.[CLIENT_V] = cl_ref
			order by a.[DATE_OP] asc loop
				account := a;
				exit;
			end loop;

			/*Шипицын - отдельно ищем счет с непустой выпиской, чтобы по нему искать ДАТА_ОПЕРАЦИИ1*/
			for a in ::[AC_FIN]
			where a.[CLIENT_V] = cl_ref and a.[ARC_MOVE]%size(1)>0
			order by a.[DATE_OP] asc loop
				account_tmp := a;
				exit;
			end loop;

			P_DATE_ANK := cl_ref.[DATE_ANK];
			if account is not null then
				date_acc1 := trunc(account.[DATE_OP]);
			else
				date_acc1 := null;
			end if;
		end;

		--NGA07082013 ДЛЯ ИП если дата откр.1-ого счета после 01/05/2005,берем ее
	    if ip then
   		   /* NGA14032014 Отключено по замечанию С.Н.Морозовой
   		   if date_acc1 is NOT NULL AND date_acc1>= to_date('01.05.2005','dd.mm.yyyy') then
		      P_DATE_ANK := date_acc1;
   		   else
   		      P_DATE_ANK := client_org_ref.[DATE_ANK];   --NGA20082013 для ИП дату анкеты возьмем с ИП
		   end if;
		   */
		    P_DATE_ANK := cl_ref.[DATE_ANK]; -- NGA14032014
	    else
	        P_DATE_ANK := least(nvl(date_acc1,P_DATE_ANK), P_DATE_ANK); -- как было
	    end if;
		--NGA07082013 end
		DEBUG_PIPE('P_INFO='||P_INFO);
		if p_info = 'СЧЕТА' then   -- СЧЕТА КЛИЕНТА
	 		P_DATA := nvl(GetAccs(cl_ref, P_DATE_PRINT),'');
	 				
		elsif p_info = 'ПРЕДСТАВИТЕЛЬ' then   -- СЧЕТА КЛИЕНТА
			
			P_DATA:='';
			
			for c in cl_ref.[LINKS_OTHER] where c.[VID_LINK].[CODE] = 'ПРЕДСТАВИТЕЛЬ'
												AND (c.[DATE_BEG] <= P_DATE_PRINT AND (c.[DATE_END] is null OR c.[DATE_END] >= P_DATE_PRINT))
			loop
				if P_DATA is null then P_DATA:=c.[PARTNER].[NAME]|| ' Основание:'||c.[FOUND];
				else P_DATA:=P_DATA||chr(10)||c.[PARTNER].[NAME]|| ' Основание:'||c.[FOUND];
				end if;
			end loop;
		
	 	elsif p_info = 'КАТЕГОРИЯ' then   --КАТЕГОРИЯ
	 		if cl_ref%class = 'CL_ORG' AND ip = false then
	 			P_DATA := 'юридического лица';
	 		elsif ip AND ip then
	 			P_DATA := 'индивидуального предпринимателя';
	 		elsif cl_ref%class = 'CL_BANK' then
	 			P_DATA := 'кредитной организации';
	 		elsif cl_ref%class = 'CL_PRIV' then
	 			P_DATA := 'физического лица';
	 		end if;
	 	
	 	elsif p_info = 'ДОК_ИН_ФЛ' then
	 		if cl_ref%class = 'CL_PRIV' then
	 		  P_DATA:='';
	 			for vid in cl_ref->(CL_PRIV)[DOC_ARR] where vid.[TYPE].[RESIDENCE_RIGHT] = true
	 														and (vid.[DATE] is null OR vid.[DATE] <= P_DATE_PRINT)
	 														and (vid.[DATE_END] is null OR P_DATE_PRINT <= vid.[DATE_END])
	 			loop
	 				
	 				if P_DATA is null then P_DATA:= ' Наименование удостовения:'||vid.[TYPE].[NAME]||' '||' Номер:'||vid.[NUM]||' Серия:'||vid.[SER]||
	 												' Дата выдачи:'||to_char(vid.[DATE], 'dd.mm.yyyy')||' Дата окончания:'||to_char(vid.[DATE_END], 'dd.mm.yyyy');
	 				else P_DATA:=P_DATA||chr(10)||' Наименование удостовения:'||vid.[TYPE].[NAME]||' '||' Номер:'||vid.[NUM]||' Серия:'||vid.[SER]||
	 												' Дата выдачи:'||to_char(vid.[DATE], 'dd.mm.yyyy')||' Дата окончания:'||to_char(vid.[DATE_END], 'dd.mm.yyyy');
	 				end if;
	 			
	 			end loop;
	 			
	 			
	 		end if;
												
	 	elsif p_info = 'НАИМ_КЛИЕНТА' then   --НАИМ_КЛИЕНТА
	 		if client_corp%id is not null AND ip = false then
	 			temp_string := nvl(client_corp.[LONG_NAME], '');
	 			P_DATA := temp_string ||
	 				  rtl.bool_char(temp_string is null, nvl(client_corp.[NAME], ''), rtl.bool_char(client_corp.[NAME] is not null, ' ('||client_corp.[NAME]|| ')', '') );
	 			temp_string := nvl(client_corp.[I_NAME], '');
 				P_DATA := P_DATA||rtl.bool_char(temp_string is null, '', chr(13)||temp_string);
	 		elsif client_bank%id is not null then
	 			temp_string := nvl(client_bank.[LONG_NAME], '');
	 			P_DATA := temp_string ||
	 				  rtl.bool_char(temp_string is null, nvl(client_bank.[NAME], ''), rtl.bool_char(client_bank.[NAME] is not null, ' ('||client_bank.[NAME]|| ')', '') );
	 			temp_string := nvl(client_bank.[I_NAME], '');
 				P_DATA := P_DATA||rtl.bool_char(temp_string is null, '', chr(13)||temp_string);
			elsif client_priv%id is not null then
	 			P_DATA := nvl(client_priv.[NAME], '');
	 		end if;
	 		
		elsif p_info = 'ДАТА_РОЖД' then      --ДАТА_РОЖД
			if client_priv%id is not null then
	 			P_DATA := nvl(::[RUNTIME].[FDP].pdat(client_priv.[DATE_PERS]), '');
			end if;
	 		
		elsif p_info = 'МЕСТО_РОЖД' then     --МЕСТО_РОЖД
		 if client_priv%id is not null then
			--Башкиров В.Г. 26.06.2014 Удалена обработка полей для ОКАТО при переходе на 14.3
			--Башкиров В.Г. 26.06.2014 "Место рождения" скопировано с дистрибутивного
			temp_str := client_priv.[DOC].[BIRTH_PLACE];
			if temp_str is not null then -- BFS00023043 теперь есть реквизит
				P_DATA := temp_str;
			else
				temp_str := nvl(client_priv.[BORN].[COUNTRY].[VALUE], '');
				P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, temp_str||', ');
				
				temp_str := nvl(client_priv.[BORN].[OKATO].[NAME], '');
				P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, temp_str||', ');
		
				P_DATA := P_DATA||nvl(client_priv.[BORN].[KIND].[SHORT_NAME]||' '||client_priv.[BORN].[NAME], ', ');

				P_DATA := substr(rtrim(ltrim(P_DATA)),1,length(P_DATA)-1);
		 	end if;
		 end if;

		elsif p_info = 'ГРАЖД' then          --ГРАЖДАНСТВО
		 if client_priv%id is not null then
			P_DATA := nvl(client_corp.[COUNTRY].[NAME],client_priv.[COUNTRY].[NAME]);
		 end if;
		--29.12.2016 Картешкина Н.Н. добавила ЮРИСДИКЦИЮ если есть код иностранной организации и ДА_КИО и НЕТ_КИО
		elsif p_info = 'ДА_КИО' and client_corp%id is not null then
		      P_DATA := '_';
		      if client_corp.[KIO] is not null then
		      	P_DATA:= 'V';
		      end if;
		elsif p_info = 'НЕТ_КИО' and client_corp%id is not null then
		      P_DATA := '_';
		      if client_corp.[KIO] is null then
		    	  P_DATA:= 'V';		
		      end if;	
		elsif p_info = 'ЮРИСДИКЦИЯ' then --ЮРИСДИКЦИЯ
		 if client_corp%id is not null then
			P_DATA := ' ';
			if client_corp.[KIO] is not null then
				P_DATA := client_corp.[COUNTRY].[NAME];
			end if;
		 end if;
			
		elsif p_info = 'ДОКУМЕНТ' then       --ДОКУМЕНТ, удостоверяющий личность
		 if client_priv%id is not null then
			P_DATA := nvl(Get_passport(client_priv), '');
		 end if;

		elsif p_info = 'ВИЗА' then            --ВИЗА
		 if client_priv%id is not null then
			P_DATA := Get_Visa(client_priv,P_DATE_PRINT);
		 end if;

		elsif p_info = 'МИГР_КАРТА' then            --МИГР_КАРТА
		 if client_priv%id is not null then
			P_DATA := Get_Migration_Card(client_priv, P_DATE_PRINT);					
		 end if;

/*---- NGA 26/09/2014
		elsif p_info = 'МИГР_КАРТА_ВИЗА' then	--  МИГР_КАРТА_ВИЗА
			temp_str1 := Get_Migration_Card(client_priv, P_DATE_PRINT);
