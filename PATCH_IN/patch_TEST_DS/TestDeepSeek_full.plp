PROCEDURE v50_PROC_UTILS_p_3_1_1 IS
	v_session_id VARCHAR2(100);
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		v_session_id := utils.session_id;
		method_mgr.clear_object_refcing();
		stdio.zip('file.txt');
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		v_session_id := rtl.USERID;
		::[RUNTIME].[SYSLIB].clear_object_refcing();
		::[RUNTIME].[ZIP_LIB].zip('file.txt');
	-- end pl/sql
END;

-- ============================================================================
-- Правило 23: v50.PROC.EMPTY_STRING.п.3.2 - Пустая строка и NULL
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Пустая строка и NULL
--   Подробное описание: В PostgreSQL пустая строка '' is not null. В Oracle '' is null. Писать код без использования '' в текстовых полях.
--   Пример кода для корректировки: where name = ''
--   Пример исправленного кода: where name is null
--   Теги: empty string, null
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: В PostgreSQL пустая строка '' is not null. В Oracle '' is null. Писать код без использования '' в текстовых полях. При конкатенации в SQL явно приводить все слагаемые к строке.
--   plplus_materials_note: Различие может привести к логическим ошибкам.
--   search_prompt: Найти сравнения с пустой строкой (''), присваивания пустой строки, конкатенацию без явного приведения.
--   regex_patterns.for_search: =\s*''|''\s*=; :=\s*''
--   code_example_bad: where name = ''
--   fix_instruction: Заменить сравнение с '' на is null, либо переписать логику. При конкатенации использовать явное приведение типов.
--   fix_prompt: Выполни замену пустой строки на NULL.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.EMPTY_STRING.п.3.2'.
--   priority: high
--   category: PROC
--   subcategory: PROC.OTHER
--   source_files: v50.docx
--   source_sections: п.3.2
-- ============================================================================
PROCEDURE v50_PROC_EMPTY_STRING_p_3_2 IS
	v_name VARCHAR2(100);
	v_count NUMBER;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		select count(*) into v_count from clients where name = '';
		v_name := '';
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		select count(*) into v_count from clients where name is null;
		v_name := null;
	-- end pl/sql
END;

