class MAIN_DOCUM;

@name('[ПСБ] Редакировать Пользователей (служебная)')
method PSH_USERS is
PSH_USERS (
	@name('Создано пользователем')               P_DOCUMENT_USER in [USER_REF],
	@name('Проведено пользователем')             P_PROV_USER     in [USER_REF],
	@name('Исполнитель')                         P_USER_EXEC     in [USER_REF],
	@name('Добавить текст в Служебные отментки') P_ADD_NOTE      in [STRING_200]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DOCUMENT_USER := this.[DOCUMENT_USER];
	P_PROV_USER := this.[PROV_USER];
	P_USER_EXEC := this.[USER_EXEC];
end if;
-- End initialization of parameters and variables
begin
	if P_MESSAGE = 'DEFAULT' then
		P_ADD_NOTE:='Проведено совместно с '||this.[DOCUMENT_USER].[NAME];
	end if;
end;
end;

execute is
/*********************************************************************
Назначение:

bashkirov, последнее изменение 11 Январь 2019 г.
*********************************************************************/
begin
	if this.[DOCUMENT_USER] is null or this.[DOCUMENT_USER]<>P_DOCUMENT_USER then this.[DOCUMENT_USER]:=P_DOCUMENT_USER; end if;
	if this.[PROV_USER] 	is null or this.[PROV_USER]<>P_PROV_USER 		 then this.[PROV_USER]:=P_PROV_USER; end if;
	if this.[USER_EXEC] 	is null or this.[USER_EXEC]<>P_USER_EXEC 		 then this.[USER_EXEC]:=P_USER_EXEC; end if;
	if nvl(InStr(this.[TEXT_VOZV],P_ADD_NOTE),0)=0 then
		this.[TEXT_VOZV]:=trim(trim(this.[TEXT_VOZV],chr(10)),chr(13))||LF$||P_ADD_NOTE;
	end if;
end;
end;
end;
