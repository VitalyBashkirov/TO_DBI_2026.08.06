class AC_FIN;

@import_plsql(true)
@name('ПСБ. Библиотека 2021')
@tag('COPIED')
library PSH_LIB_2021 is
PRAGMA INCLUDE([RUNTIME]::[MACRO_LIB]);
PRAGMA INCLUDE([DEPN]::[LIB_MACRO]);
PRAGMA INCLUDE([DEPN]::[DEBUG_MACRO]);

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

fmt string(10):='dd.mm.yyyy';

function Calc_356_366(d [DATE]) return number is
begin
	if d is null then return null; end if;
	return DATEFUN.eoy(d)-DATEFUN.boy(d)+1;
end;

--Башкиров В.Г. 15.01.2019 Добавил вычисление Категории Клиента
public function GetClCategory(Cl ref [CLIENT], d1 [DATE], TypeInfo integer default 0) return string(1000) is 
ExVal string(1000);
begin
	if TypeInfo=0 then
		for (select v(v.[CATEGORY].[NAME] : C_CATEGORY_NAME) in cl.[VIDS_CL]
		where v.[CATEGORY] is not null and
			nvl(v.[DATE_BEGIN],d1)<=d1 and nvl(v.[DATE_END],d1)<=d1
		order by v.[DATE_BEGIN] desc)
		loop
			ExVal:=SubStr(ExVal||v.C_CATEGORY_NAME||';',1,1000);
		end loop;
		return trim(ExVal,';');
	elsif TypeInfo=1 then
		for (select v(v.[DATE_BEGIN] : C_DATE_BEGIN) in cl.[VIDS_CL]
		where v.[CATEGORY] is not null and
			nvl(v.[DATE_BEGIN],d1)<=d1 and nvl(v.[DATE_END],d1)<=d1
		order by v.[DATE_BEGIN] desc)
		loop
			ExVal:=to_char(v.C_DATE_BEGIN,fmt);
			exit;
		end loop;
		return trim(ExVal,';');
	elsif TypeInfo=2 then
		for (select v(v.[DATE_END] : C_DATE_END) in cl.[VIDS_CL]
		where v.[CATEGORY] is not null and
			nvl(v.[DATE_BEGIN],d1)<=d1 and nvl(v.[DATE_END],d1)<=d1
		order by v.[DATE_BEGIN] desc)
		loop
			ExVal:=to_char(v.C_DATE_END,fmt);
			exit;
		end loop;
		return trim(ExVal,';');
	end if;
end;

public function GetOKVED (cl ref [CL_ORG]) return string(1000) is 
ret string(1000);
begin
	for okved in cl.[OKVED_IN_PERIOD] where okved.[PRIMARY] = true
	loop
		ret := okved.[OKVED].[NAME];
	end loop;
	
	if ret is null then
		for okved in cl.[OKVED_IN_PERIOD] where okved.[MAIN] = true
		loop
			ret := okved.[OKVED].[NAME];
		end loop;		
	end if;
	
	return ret;
	
end;

public function GetClSumDTOwn (cl ref [CLIENT], date_beg [DATE], date_end [DATE]) return number is 
ret number;
begin
	ret := 0;


	for mdoc in ::[MAIN_DOCUM] where trunc(mdoc.[DATE_PROV]) >=trunc(date_beg) and trunc(mdoc.[DATE_PROV]) <=trunc(date_end) and mdoc%state = 'PROV'
				and mdoc.[ACC_DT].[CLIENT_V] = cl
				and
				(mdoc.[ACC_KT].[CLIENT_V] = cl
								or (mdoc.[ACC_KT].[CLIENT_R] = cl and mdoc.[ACC_KT].[MAIN_V_ID] not like '603%')
				 				or mdoc.[ACC_KT].[MAIN_V_ID] like '47408%'
				 )
				 and mdoc.[ACC_KT].[MAIN_V_ID] not like '603%'
		
	loop
		ret := ret + mdoc.[SUM_NT];
	end loop;
	
	--return round (res/1000, 2);
	return ret;
		
end;

public function GetClSumKTOwn (cl ref [CLIENT], date_beg [DATE], date_end [DATE]) return number is 
ret number;
begin
	ret := 0;
	for mdoc in ::[MAIN_DOCUM] where trunc(mdoc.[DATE_PROV]) >=trunc(date_beg) and trunc(mdoc.[DATE_PROV]) <=trunc(date_end) and mdoc%state = 'PROV'
				and mdoc.[ACC_KT].[CLIENT_V] = cl
				and
				(mdoc.[ACC_DT].[CLIENT_V] = cl
								or (mdoc.[ACC_DT].[CLIENT_R] = cl and mdoc.[ACC_DT].[MAIN_V_ID] not like '603%')
				 				or mdoc.[ACC_DT].[MAIN_V_ID] like '47407%'
				 )
				and mdoc.[ACC_DT].[MAIN_V_ID] not like '603%'
	loop
		ret := ret + mdoc.[SUM_NT];
		debug_pipe ( mdoc.[SUM_NT],0);
	end loop;
	
	--return round (res/1000, 2);
	return ret;
		
end;

--31/07/2021
public function GetData (ac ref [AC_FIN], date_beg [DATE], CodeInf string(20)) return string(1000) is 
ExStr string(200);
rClient ref [CLIENT];
rClOrg ref [CL_ORG];
rClPriv ref [CL_PRIV];
chp_type integer;
begin
	if CodeInf='ДПО' then	--Дата предыдущей операции по счету
		for am in ac.[ARC_MOVE] 
		where am.[DATE]<date_beg
		order by am.[DATE] desc
		loop
			ExStr:=to_char(am.[DATE],fmt);
			exit;
		end loop;
	elsif CodeInf='ПД'	then	--Паспортные данные
		rClient:=nvl(ac.[CLIENT_R],ac.[CLIENT_V]);
		if rClient%class='CL_ORG' then
			rClOrg:=rClient;
			if ::[DOCUMENT_INT].[PRX_CLIENT].isClientCHP(rClOrg) then -- Функция определения является ли организация индивидуальным предпринимателем
				rClPriv:=::[DOCUMENT_INT].[PRX_CLIENT].getCHPclPriv(rClOrg); --Функция возвращает ссылку на физ.лицо, которое является собственником(руководителем) заданного ИП
			end if;
		elsif rClient%class='CL_PRIV' then
			rClPriv:=rClient;
		end if;
		if rClPriv is not null then
			ExStr:=trim(rClPriv.[DOC].[TYPE].[NAME]||' '
			||iif(rClPriv.[DOC].[SER] is null,'',' серия '||rClPriv.[DOC].[SER])
			||iif(rClPriv.[DOC].[NUM] is null,'',' №'||rClPriv.[DOC].[NUM])
			||iif(rClPriv.[DOC].[WHO] is null,'',' выдан '|| rClPriv.[DOC].[WHO])
			||iif(rClPriv.[DOC].[DATE] is null,'',' '||to_char(rClPriv.[DOC].[DATE], 'dd.mm.yyyy')));
		end if;
	elsif CodeInf='ДР'	then	--Дата рождения
		rClient:=nvl(ac.[CLIENT_R],ac.[CLIENT_V]);
		if rClient%class='CL_ORG' then
			rClOrg:=rClient;
			if ::[DOCUMENT_INT].[PRX_CLIENT].isClientCHP(rClOrg) then -- Функция определения является ли организация индивидуальным предпринимателем
				rClPriv:=::[DOCUMENT_INT].[PRX_CLIENT].getCHPclPriv(rClOrg); --Функция возвращает ссылку на физ.лицо, которое является собственником(руководителем) заданного ИП
			end if;
		elsif rClient%class='CL_PRIV' then
			rClPriv:=rClient;
		end if;
		if rClPriv.[DATE_PERS] is not null then
			ExStr:=to_char(rClPriv.[DATE_PERS],fmt);
		end if;
	elsif CodeInf='ИНН' then	--ИНН клиента, 
		ExStr:=nvl(ac.[CLIENT_R],ac.[CLIENT_V]).[INN];
	elsif CodeInf='ОГРН' then	--ОГРН юридического лица.
		rClient:=nvl(ac.[CLIENT_R],ac.[CLIENT_V]);
		if rClient%class='CL_ORG' then
			ExStr:=nvl(rClient->(CL_CORP)[REGISTER].[GOS_REG_NUM_REC],rClient->(CL_CORP)[REGISTER].[NUM_REESTR]);
		end if;
	end if;
	return ExStr;
end;

--Башкиров В.Г. 09.01.2019 Пока только деподозиты. Работает криво!!!
public function GetNumDog(ac ref [AC_FIN]) return varchar2(32767) is 
ExStr varchar2(32767);
rProd ref [PRODUCT];
begin
	for p in ac.[PRODUCTS] where p.[PROD_REF] is not null loop
		ExStr:=SubStr(ExStr||p.[PROD_REF].[NUM_DOG],1,32767);
	end loop;
	if ExStr is null then
		if ac.[TO_PRODUCT].[CODE] in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then
			for (select d(d.[NUM_DOG] : C_NUM_DOG) in
			::[DEPN] all
			where
				d.[ACCOUNT]=ac or
				d.[ACC_EXP_PRC_CB]=ac or
				d.[ACC_FOR_TAX]=ac or
				d.[ACC_PROF_PENALT]=ac or
				d.[ACC_PROF_TRANSF]=ac or
				d.[ACC_PROF_CASH]=ac or
				d.[TRM_INTS_LBS_ACC]=ac or
				d.[OVD_INTS_LBS_ACC]=ac or
				d.[ACC_FUTURE_EXP]=ac or
				d.[ACC_EXPEND_PRC_F]=ac or
				d.[ACC_EXPEND_PRC]=ac or
				d.[ACC_EXPEND_CASH]=ac or
				d.[ACC_EXPEND_VAL]=ac or
				d.[ACC_RUR]=ac)
			loop
				ExStr:=SubStr(ExStr||d.C_NUM_DOG,1,32767);
			end loop;
		end if;
	end if;
	/** /
	if ExStr is null then
		for h in ::[HOZ_OP_ACC] all where
			h.[ACCOUNT_DOG].[1].[2]=ac
		loop
			begin
				rProd:=h%parent;
				ExStr:=SubStr(ExStr||rProd.[NUM_DOG],1,32767);
			exception when others then
				null; --pragma error( h%parent%classname );
			end;
		end loop;
	end if;
	/**/
	return trim(ExStr,';');
end;

--Башкиров В.Г. 23.08.2021
-- 1.ID ##########
-- 2.ФИО Иванов Иван Иванович
-- 3.ИНН вкладчика 111111111
-- 4.дата рождения ДД.ММ.ГГГГ
-- 5.адрес регистрации г. Москва
-- 6.адрес местожительства г. Москва
-- 7.вид документа, удостоверяющего личность
-- 8.серия/номер документа ## ## ######
-- 9.номер кредитного договора банковского счета (вклада)
--10.дата договора банковского счета (вклада) ДД.ММ.ГГГГ
--11.дата дополнительного соглашения к договору банковского счета (вклада) ДД.ММ.ГГГГ
--12.дата окончания договора банковского счета (вклада) ДД.ММ.ГГГГ
--13.дата открытия банковского счета (вклада) ДД.ММ.ГГГГ
--14.дата закрытия банковского счета (вклада) ДД.ММ.ГГГГ
--15.сумма вклада по договору 9 999 999,00
--16.вид вклада сберегательный
--17.неснижаемый остаток по вкладу 9 999,0
--18.минимальный остаток по вкладу за период его действия
--19.дата снижения остатка по вкладу до его минимальной величины ДД.ММ.ГГГГ
--20.максимальная остаток по вкладу за период его действия 
--21.дата увеличения остатка по вкладу до его максимальной величины ДД.ММ.ГГГГ
--22.процентная ставка 12%
--23.Изменение процентной ставки %
--24.Период изменения первоначально заявленной процентной ставки ДД.ММ.ГГГГ-ДД.ММ.ГГГГ
--25.Разница в сумме начисленных процентов RUR
--26.режим уплаты процентов До N числа каждого месяца: До N рабочего числа каждого месяца; В последний рабочий день месяца; В конце срока вклада;
--27.депозитный счет 42306810
--28.остаток  средств на счете на дату формирования реестра 8 800 000,00
--29.валюта вклада RUR
--30.остаток  средств на депозитном счете на отчетную дату в рублях по курсу Банка России на отчетную дату 8 800 000,00
--31.счет начисленных процентов 47411810
--32.начисленные проценты 54 253,2
--33.наличие капитализации да/нет
--34.текущий счет 40817810
--35.код подразделения кредитной организации ГОБ, Филиал, ОО, ДО

function InfoProdRef(ac ref [AC_FIN], typeInfo number, prd ref [PRODUCT]) return varchar2(32767) is
ExStr varchar2(32767);
rProd ref [PRODUCT];

AccDepn ref [AC_FIN];
dCalc [DATE];
vSumMin [SUMMA];
vSumMax [SUMMA];
vSumOst [SUMMA];
vMinSumDog [SUMMA];
vDateSumMax [DATE];
vDepn ref [DEPN];
vPrcSt [PERCENT];
tmpAcc ref [AC_FIN];

d1 [DATE]; p1 [NUM_16_8]; s1 [SUMMA_16_6];
d2 [DATE]; p2 [NUM_16_8]; s2 [SUMMA_16_6];

sDelta [SUMMA_16_6];
mStr string(512);
vUplPrc number;
bCap string(3);
dTmp [DATE];
begin
	if    typeInfo= 9 then-- 9.номер кредитного договора банковского счета (вклада)	
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  ExStr:=SubStr(ExStr||vDepn.[NUM_DOG],1,32767);

	elsif typeInfo=10 then	--10.дата договора банковского счета (вклада)	ДД.ММ.ГГГГ
		  ExStr:=SubStr(ExStr||to_char(prd.[DATE_BEGIN],fmt),1,32767);
	elsif typeInfo=11 then	--11.дата дополнительного соглашения к договору банковского счета (вклада)	ДД.ММ.ГГГГ
		  for aaa in prd.[ADD_AGR_ARR] loop
		  ExStr:=SubStr(ExStr||to_char(aaa.[DATE_BEGIN],fmt),1,32767);
		  end loop;
	elsif typeInfo=12 then	--12.дата окончания договора банковского счета (вклада)	ДД.ММ.ГГГГ
		  ExStr:=SubStr(ExStr||to_char(prd.[DATE_ENDING],fmt),1,32767);
	elsif typeInfo=13 then	--13.дата открытия банковского счета (вклада)	ДД.ММ.ГГГГ
		  ExStr:=SubStr(ExStr||to_char(ac.[DATE_OP],fmt),1,32767);
	elsif typeInfo=14 then	--14.дата закрытия банковского счета (вклада)	ДД.ММ.ГГГГ
		  ExStr:=SubStr(ExStr||to_char(ac.[DATE_CLOSE],fmt),1,32767);
	elsif typeInfo=15 then	--15.сумма вклада по договору	9 999 999,00
		  if    prd%class='RKO_CUR' then ExStr:=SubStr(ExStr||null,1,32767);
		  elsif prd%class='RKO'     then ExStr:=SubStr(ExStr||Null,1,32767);
		  else                           ExStr:=SubStr(ExStr||prd->(DEPN)[SUMMA_DOG],1,32767);
		  end if;
	elsif typeInfo=16 then	--16.вид вклада	сберегательный
		  if    prd%class='RKO_CUR' then ExStr:=SubStr(ExStr||prd->(RKO_CUR)[RKO_TYPE].[NAME],1,32767);
		  elsif prd%class='RKO'     then ExStr:=SubStr(ExStr||prd->(RKO)[RKO_TYPE].[NAME],1,32767);
		  else                           ExStr:=SubStr(ExStr||prd->(DEPN)[VID_DOG].[NAME],1,32767);
		  end if;
	elsif typeInfo=17 then	--17.неснижаемый остаток по вкладу	9 999,0
		  if prd%class in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then
		  ExStr:=SubStr(ExStr||prd->(DEPN)[VID_DOG].[NOT_USE_SUMM],1,32767);
		  end if;
	elsif typeInfo=18 then	--18.минимальный остаток по вкладу за период его действия
		  if    prd%class in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then AccDepn:=prd->(DEPN)[ACCOUNT];
		  elsif prd%class in ('RKO_CUR')                                   then AccDepn:=prd->(RKO_CUR)[ACCOUNT];
		  elsif prd%class in ('RKO')                                       then AccDepn:=prd->(RKO)[ACCOUNT];
		  end if;
		  dCalc:=nvl(AccDepn.[DATE_CLOSE],[SYSTEM].[OP_DATE]+1);
		  for (select am(am.[START_SUM]+Decode(am.[DT], '1',-am.[SUMMA], am.[SUMMA]) : C_ISH_OST) in AccDepn.[ARC_MOVE]
		  where am.[DATE]<dCalc
		  order by am.[START_SUM]+Decode(am.[DT], '1',-am.[SUMMA], am.[SUMMA]))
		  loop
		  	vSumMin:=am.C_ISH_OST;
		  	exit;
		  end loop;
		  ExStr:=SubStr(ExStr||vSumMin,1,32767);
	elsif typeInfo=19 then	--19.дата снижения остатка по вкладу до его минимальной величины	ДД.ММ.ГГГГ
		  if    prd%class in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then AccDepn:=prd->(DEPN)[ACCOUNT];
		  elsif prd%class in ('RKO_CUR')                                   then AccDepn:=prd->(RKO_CUR)[ACCOUNT];
		  elsif prd%class in ('RKO')                                       then AccDepn:=prd->(RKO)[ACCOUNT];
		  end if;
		  dCalc:=nvl(AccDepn.[DATE_CLOSE],[SYSTEM].[OP_DATE]+1);
		  for (select am(am.[DATE] :C_DATE, am.[START_SUM]+Decode(am.[DT], '1',-am.[SUMMA], am.[SUMMA]) : C_ISH_OST) in AccDepn.[ARC_MOVE]
		  where am.[DATE]<dCalc
		  order by am.[START_SUM]+Decode(am.[DT], '1',-am.[SUMMA], am.[SUMMA]))
		  loop
		  	dTmp:=am.C_DATE;
		  	exit;
		  end loop;
		  ExStr:=SubStr(ExStr||to_char(dTmp,fmt),1,32767);
	elsif typeInfo=20 then	--20.максимальная остаток по вкладу за период его действия
		  if    prd%class in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then AccDepn:=prd->(DEPN)[ACCOUNT];
		  elsif prd%class in ('RKO_CUR')                                   then AccDepn:=prd->(RKO_CUR)[ACCOUNT];
		  elsif prd%class in ('RKO')                                       then AccDepn:=prd->(RKO)[ACCOUNT];
		  end if;
		  dCalc:=nvl(AccDepn.[DATE_CLOSE],[SYSTEM].[OP_DATE]+1);
		  for (select am(am.[DATE]:C_DATE, am.[START_SUM]+Decode(am.[DT], '1',-am.[SUMMA], am.[SUMMA]) : C_ISH_OST) in AccDepn.[ARC_MOVE]
		  where am.[DATE]<dCalc
		  order by am.[START_SUM]+Decode(am.[DT], '1',-am.[SUMMA], am.[SUMMA]) desc)
		  loop
		  	vSumMax:=am.C_ISH_OST;
		  	exit;
		  end loop;
		  ExStr:=SubStr(ExStr||vSumMax,1,32767);

	elsif typeInfo=21 then	--21.дата увеличения остатка по вкладу до его максимальной величины	ДД.ММ.ГГГГ
		  if    prd%class in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then AccDepn:=prd->(DEPN)[ACCOUNT];
		  elsif prd%class in ('RKO_CUR')                                   then AccDepn:=prd->(RKO_CUR)[ACCOUNT];
		  elsif prd%class in ('RKO')                                       then AccDepn:=prd->(RKO)[ACCOUNT];
		  end if;
		  dCalc:=nvl(AccDepn.[DATE_CLOSE],[SYSTEM].[OP_DATE]+1);
		  for (select am(am.[DATE]:C_DATE, am.[START_SUM]+Decode(am.[DT], '1',-am.[SUMMA], am.[SUMMA]) : C_ISH_OST) in AccDepn.[ARC_MOVE]
		  where am.[DATE]<dCalc
		  order by am.[START_SUM]+Decode(am.[DT], '1',-am.[SUMMA], am.[SUMMA]) desc)
		  loop
		  	vDateSumMax:=am.C_DATE;
		  	exit;
		  end loop;
		  ExStr:=SubStr(ExStr||to_char(vDateSumMax,fmt),1,32767);

	elsif typeInfo=22 then	--22.процентная ставка	12%
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  if vDepn is not null then
			  dCalc:=coalesce(vDepn.[DATE_BEGINING],vDepn.[DATE_BEGIN],AccDepn.[DATE_OP]);
			  vPrcSt:=nvl(::[PRC_SCHEME].[LIB].GetPrcRate(vDepn.[PRC_DOG],dCalc),
			  	  		  ::[PRC_SCHEME].[LIB].GetPrcRate(vDepn.[PRC_DOG],dCalc,::[RUNTIME].[F_5].A('И'||vDepn.[ACCOUNT]%id||'СВ',dCalc)));
		  end if;
		  ExStr:=SubStr(ExStr||vPrcSt,1,32767);
	elsif typeInfo=23 then	--23.Изменение процентной ставки	%
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  if vDepn is not null then
			  dCalc:=coalesce(vDepn.[DATE_CLOSE],vDepn.[DATE_ENDING],AccDepn.[DATE_CLOSE],::[SYSTEM].[OP_DATE]);
			  vPrcSt:=nvl(::[PRC_SCHEME].[LIB].GetPrcRate(vDepn.[PRC_DOG],dCalc),
			  	  		  ::[PRC_SCHEME].[LIB].GetPrcRate(vDepn.[PRC_DOG],dCalc,::[RUNTIME].[F_5].A('И'||vDepn.[ACCOUNT]%id||'СВ',dCalc)));
		  end if;
		  ExStr:=SubStr(ExStr||vPrcSt,1,32767);
	elsif typeInfo=24 then	--24.Период изменения первоначально заявленной процентной ставки	ДД.ММ.ГГГГ-ДД.ММ.ГГГГ
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  if vDepn is not null then
			  for jcp in vDepn.[JOUR_CALC_PRC] order by jcp.[DATE_BEG] loop
			  	if d1 is null then d1:=jcp.[DATE_BEG]; p1:=jcp.[PRC]; end if;
			  	if p1<>jcp.[PRC] then
			  		d2:=jcp.[DATE_BEG];
			  	end if;
			  	if d2 is not null then
			  		exit;
			  	end if;
			  end loop;
		  end if;
		  if d1 is not null and d2 is not null then
		  	ExStr:=SubStr(ExStr||to_char(d1,fmt)||'-'||to_char(d2,fmt),1,32767);
		  end if;
	elsif typeInfo=25 then	--25.Разница в сумме начисленных процентов	RUR
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  if vDepn is not null then
			  s1=s2:=0;
			  for jcp in vDepn.[JOUR_CALC_PRC] order by jcp.[DATE_BEG] loop
			  	if d1 is null then d1:=jcp.[DATE_BEG]; p1:=jcp.[PRC]; end if;
			  	if p1<>jcp.[PRC] then
			  		d2:=jcp.[DATE_BEG];
			  		p2:=jcp.[PRC];
			  	end if;
			  	s1:=s1+jcp.[SUMMA_PRC];
			  	if d2 is not null then
			  		exit;
			  	end if;
			  end loop;
			  if d2 is not null then
				  for jcp in vDepn.[JOUR_CALC_PRC] order by jcp.[DATE_BEG] loop
				  	if d2=jcp.[DATE_BEG] then
				  		exit; 
				  	end if;
				  	s2:=s2+jcp.[SUMMA]*p2/100/Calc_356_366(jcp.[DATE_BEG])*(jcp.[DATE_END]-jcp.[DATE_BEG]+1);
				  end loop;
				  sDelta:=s1-s2;
			  end if;
		  end if;
		  ExStr:=SubStr(ExStr||round(sDelta,2),1,32767);
	elsif typeInfo=26 then	--26.режим уплаты процентов	До N числа каждого месяца: До N рабочего числа каждого месяца; В последний рабочий день месяца; В конце срока вклада;
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  if vDepn is not null then
				if vDepn.[VID_DOG].[PAY_ADD_PRC] then --Выплата причисленных процентов
					if vDepn.[VID_DOG].[PERIOD_PAY_PRC] is not null then
						mStr:=vDepn.[VID_DOG].[PERIOD_PAY_PRC].[NAME];
					end if;
				else
					mStr:='В конце срока вклада';
				end if;
		  end if;
		  ExStr:=SubStr(ExStr||mStr,1,32767);
	elsif typeInfo=27 then	--27.депозитный счет	42306810
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  ExStr:=SubStr(ExStr||vDepn.[ACCOUNT].[MAIN_V_ID],1,32767);
	elsif typeInfo=28 then	--28.остаток  средств на счете на дату формирования реестра	8 800 000,00
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  ExStr:=SubStr(ExStr||vDepn.[ACCOUNT].[SALDO],1,32767);
	elsif typeInfo=29 then	--29.валюта вклада	RUR
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  ExStr:=SubStr(ExStr||vDepn.[FINTOOL].[CUR_SHORT],1,32767);
	elsif typeInfo=30 then	--30.остаток  средств на депозитном счете на отчетную дату в рублях по курсу Банка России на отчетную дату	8 800 000,00 
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  ExStr:=SubStr(ExStr||vDepn.[ACCOUNT].[SALDO_NT],1,32767);
	elsif typeInfo=31 then	--31.счет начисленных процентов	47411810
		  if prd%class in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then 
			  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
			  tmpAcc:=vDepn.[TRM_INTS_LBS_ACC];
			  if tmpAcc is null then
			  	for ada in dep.[ARRAY_DOG_ACC] where ada.[NAME_ACCOUNT]=::[TIP_ACC]([COD]='D_TRM_INTS_LBS_ACC') loop --D_TRM_INTS_LBS_ACC - Счет обязательств банка по уплате %% без нарушения сроков
			  		tmpAcc:=ada.[ACCOUNT_DOG].[1].[2];
			  		exit;
			  	end loop;
			  end if;
			  ExStr:=SubStr(ExStr||tmpAcc.[MAIN_V_ID],1,32767);
		  end if;
	elsif typeInfo=32 then	--32.начисленные проценты	54 253,2
		  if prd%class in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then 
			  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=prd%id; exit; end loop;
			  dCalc:=trunc(::[SYSTEM].[OP_DATE]);
			  if vDepn is not null then
				  s1=s2:=0;
				  for jcp in vDepn.[JOUR_CALC_PRC] where jcp.[DATE_BEG]<=dCalc
				  order by jcp.[DATE_BEG] loop
				  	if jcp.[DATE_BEG]<dCalc and jcp.[DATE_BEG]<=dCalc then
				  		s1:=s1+jcp.[SUMMA_PRC];
				  	else
				  		s1:=s1+jcp.[SUMMA]*p1/100/Calc_356_366(dCalc)*(dCalc-jcp.[DATE_BEG]+1);
				  		exit;
				  	end if;
				  end loop;
			  end if;
			  ExStr:=SubStr(ExStr||round(s1,2),1,32767);
		  end if;
	elsif typeInfo=33 then	--33.наличие капитализации	да/нет
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  dCalc:=trunc(::[SYSTEM].[OP_DATE]);
		  bCap:='Нет';
		  for aod in vDepn.[LIST_PAY] where aod.[BEG_DATE]<=dCalc and aod.[OPER]=::[VID_OPER_DOG]([CODE]='КАПИТАЛИЗ_ПРОЦ') loop
		  	bCap:='Да';
		  end loop;
		  ExStr:=SubStr(ExStr||bCap,1,32767);
	elsif typeInfo=34 then	--34.текущий счет	40817810
		  for dep in ::[DEPN] all where dep%id=prd%id loop vDepn:=dep%id; exit; end loop;
		  tmpAcc:=coalesce(vDepn.[ACC_ENROL_PRC].[1].[2].[MAIN_V_ID],vDepn.[ACC_RETURN].[1].[2].[MAIN_V_ID]);
	elsif typeInfo=35 then	--35.код подразделения кредитной организации	ГОБ, Филиал, ОО, ДО
		  ExStr:=SubStr(ExStr||prd.[DEPART].[CODE],1,32767);
	end if;
	return ExStr;
end;

--Башкиров В.Г. 23.08.2021
public function GetInfoDog(ac ref [AC_FIN], typeInfo number) return varchar2(32767) is 
ExStr varchar2(32767);
rProd ref [PRODUCT];

AccDepn ref [AC_FIN];
dCalc [DATE];
vSumMin [SUMMA];
vSumMax [SUMMA];
vSumOst [SUMMA];
vMinSumDog [SUMMA];
vDateSumMax [DATE];
vDepn ref [DEPN];
vPrcSt [PERCENT];
tmpAcc ref [AC_FIN];

d1 [DATE]; p1 [NUM_16_8]; s1 [SUMMA_16_6];
d2 [DATE]; p2 [NUM_16_8]; s2 [SUMMA_16_6];

sDelta [SUMMA_16_6];
mStr string(512);
vUplPrc number;
bCap string(3);
dTmp [DATE];
begin
	for p in ac.[PRODUCTS] where p.[PROD_REF] is not null loop
		ExStr:=InfoProdRef(ac, typeInfo, p.[PROD_REF]%id);
	end loop;
	if ExStr is null then
		if ac.[TO_PRODUCT].[CODE] in ('DEPOSIT_PRIV','DEPOSIT_ORG','DEPOSIT_MULT') then
			var dpn ref [DEPN];
			for (select d(d%id : C_ID, d.[DATE_BEGIN] : C_DATE_BEGIN) in
			::[DEPN] all
			where
				d.[ACCOUNT]=ac or
				d.[ACC_EXP_PRC_CB]=ac or
				d.[ACC_FOR_TAX]=ac or
				d.[ACC_PROF_PENALT]=ac or
				d.[ACC_PROF_TRANSF]=ac or
				d.[ACC_PROF_CASH]=ac or
				d.[TRM_INTS_LBS_ACC]=ac or
				d.[OVD_INTS_LBS_ACC]=ac or
				d.[ACC_FUTURE_EXP]=ac or
				d.[ACC_EXPEND_PRC_F]=ac or
				d.[ACC_EXPEND_PRC]=ac or
				d.[ACC_EXPEND_CASH]=ac or
				d.[ACC_EXPEND_VAL]=ac or
				d.[ACC_RUR]=ac)
			loop
				dpn:=d.C_ID;
				ExStr:=InfoProdRef(ac, typeInfo, dpn%id);
			end loop;
		end if;
	end if;
	if ExStr is null then
		if ac.[TO_PRODUCT].[CODE] in ('RKO','RKO_CUR') then
			var rkoRef ref [RKO];
			for (select d(d%id : C_ID, d.[DATE_BEGIN] : C_DATE_BEGIN) in
			::[RKO] all
			where
				d.[ACCOUNT]=ac --or
				--d.[ACC_EXP_PRC_CB]=ac or
				--d.[ACC_FOR_TAX]=ac or
				--d.[ACC_PROF_PENALT]=ac or
				--d.[ACC_PROF_TRANSF]=ac or
				--d.[ACC_PROF_CASH]=ac or
				--d.[TRM_INTS_LBS_ACC]=ac or
				--d.[OVD_INTS_LBS_ACC]=ac or
				--d.[ACC_FUTURE_EXP]=ac or
				--d.[ACC_EXPEND_PRC_F]=ac or
				--d.[ACC_EXPEND_PRC]=ac or
				--d.[ACC_EXPEND_CASH]=ac or
				--d.[ACC_EXPEND_VAL]=ac or
				--d.[ACC_RUR]=ac
				)
			loop
				rkoRef:=d.C_ID;
				ExStr:=InfoProdRef(ac, typeInfo, rkoRef%id);
			end loop;
		end if;
	end if;
	return trim(ExStr,';');
end;

end;
