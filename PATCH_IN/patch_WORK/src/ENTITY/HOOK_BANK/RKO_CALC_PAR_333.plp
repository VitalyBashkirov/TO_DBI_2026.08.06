			   END IF;	
			
			    IF SUMA > 0 AND SUMA <= SUM_ZAYAV AND SUM_DEN > 0 THEN
			       ExMemo:= 0; goto nnn;
			    ELSIF SUMA > 0 AND SUMA > SUM_ZAYAV AND SUM_DEN > 0 THEN
			       ExMemo:= SUMA - SUM_ZAYAV;
			    END IF;				
			   		
			   if suma <= SUMA_FIL_SH3 then
				  ExMemo:= 0; goto nnn;
			   else
				  SUMA := suma - SUMA_FIL_SH3;
				  --ExMemo:= suma - SUMA_FIL_SH3;
		       end if;	
		
			    IF SUMA > 0 AND SUMA <= SUM_ZAYAV THEN
			       ExMemo:= 0; goto nnn;
			    ELSIF SUMA > 0 AND SUMA > SUM_ZAYAV THEN
			       ExMemo:= SUMA - SUM_ZAYAV;
			    END IF;		
		
		       ExMemo:= 0;		 goto nnn;
			end if;	
        -- end DOrlov										
	    ELSIF P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_СКП' THEN
			declare
				ksim ref [SUM_SYMKS];
			begin
				ksim := ::[RUNTIME].[STR].get_str_par(P_PATT, 'SUM_KS');
				if ksim.[1].[1] in ('40','41','42') then -- ,'54'
					suma := ksim.[2];
				end if;
			end;
			ExMemo:= suma;	
		ELSIF P_PAR like 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ%' THEN
			&OpDate;
			BEGIN
		         LOCATE MN_REF IN ::[MAIN_DOCUM] WHERE MN_REF%ID = RKO;
				 EXCEPTION WHEN NO_DATA_FOUND THEN
						MN_REF:=::[PATTERN_DOC].[BUSINESS_OP].DOC_REF;
			END;
			IF MN_REF.[VID_DOC].[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR MN_REF.[ACC_DT].[MAIN_USV].[NUM] = '20202' THEN
			   ExMemo:= 0; goto nnn;
			END IF;	
			SUM_DEN := GET_SUM_OBOR_DN(RKO, 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ');
			--SUM_COMIS := GET_SUM_COMIS_DN(RKO, 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ');	
	
			declare
				ksim ref [SUM_SYMKS];
			begin
				ksim := ::[RUNTIME].[STR].get_str_par(P_PATT, 'SUM_KS');
				if ksim.[1].[1] not in ('40','42','41','50') then --,'54'
					suma := ksim.[2];
				end if;
			end;
			if P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ' THEN
			    IF NVL(SUM_DEN,0) > 0 THEN
			      IF (SUM_DEN + SUMA) < SUMA_SH1 THEN
			         ExMemo:= SUMA;
			      ELSIF (SUM_DEN + SUMA) > SUMA_SH1 THEN
			         IF SUM_DEN < SUMA_SH1 THEN
			            ExMemo:= SUMA_SH1 - SUM_DEN; goto nnn;
   			         ELSIF SUM_DEN >= SUMA_SH1 THEN
			            ExMemo:= 0;
			         END IF;			
			      END IF;
			    END IF;				
				if suma <= SUMA_SH1 then
					ExMemo:= suma; goto nnn;
				else
					--ExMemo:= SUMA_SH1;
					ExMemo:= 0; goto nnn;
				end if;	
			elsif P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ12' THEN	       --- ВЫЧИСЛЯЕМ СУММУ ВЫДАЧИ 1 шкалы, ПО КОТОРОЙ ДОЛЖНА БЫТЬ ДОНАЧИСЛЕНА КОМИССИЯ ПО 2 ШКАЛЕ
			    IF NVL(SUM_DEN,0) > 0 THEN
			      IF (SUM_DEN + SUMA) > SUMA_SH1 AND (SUM_DEN + SUMA) <= SUMA_SH2 THEN
			         IF SUM_DEN < SUMA_SH1 THEN
			            ExMemo:= SUMA_SH1;
   			         ELSIF SUM_DEN >= SUMA_SH1 THEN
			            ExMemo:= 0; goto nnn;
			         END IF;
			      END IF;
			    END IF;
			    ExMemo:= 0;
			elsif P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ13' THEN			--- ВЫЧИСЛЯЕМ СУММУ ВЫДАЧИ 1 ШКАЛЫ, ПО КОТОРОЙ ДОЛЖНА БЫТЬ ДОНАЧИСЛЕНА КОМИССИЯ ПО 3 ШКАЛЕ	
			    IF NVL(SUM_DEN,0) > 0 THEN			
			      IF (SUM_DEN + SUMA) > SUMA_SH2 THEN
			         ExMemo:=	SUMA_SH1; goto nnn;
			      ELSE
			         ExMemo:= 0;
			      END IF;			
			    END IF;
			    ExMemo:= 0;	 goto nnn;
			elsif P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ23' THEN	       --- ВЫЧИСЛЯЕМ СУММУ ВЫДАЧИ 2 ШКАЛЫ, ПО КОТОРОЙ ДОЛЖНА БЫТЬ ДОНАЧИСЛЕНА КОМИССИЯ ПО 3 ШКАЛЕ
			    IF NVL(SUM_DEN,0) > 0 THEN
			      IF (SUM_DEN + SUMA) > SUMA_SH2 THEN
			         IF SUM_DEN < SUMA_SH2 THEN
			            ExMemo:= (SUMA_SH2 - SUMA_SH1);
			         ELSE
			            ExMemo:= 0; goto nnn;
			         END IF;			
			      END IF;			
			    END IF;
			    ExMemo:= 0;				    						
			elsif P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ2' THEN
			    IF NVL(SUM_DEN,0) > 0 THEN
			      IF (SUM_DEN + SUMA) > SUMA_SH1 AND (SUM_DEN + SUMA) <= SUMA_SH2 THEN
			         IF SUM_DEN > SUMA_SH1 THEN
			             ExMemo:= SUMA; goto nnn;
			         ELSE
			             ExMemo:= (SUM_DEN + SUMA - SUMA_SH1);
			         END IF;	
			      ELSIF (SUM_DEN + SUMA) < SUMA_SH1 THEN
			            ExMemo:= 0;	 goto nnn;
			      ELSIF (SUM_DEN + SUMA) > SUMA_SH2 THEN
			         IF SUM_DEN > SUMA_SH2 THEN
			            ExMemo:= 0;
			         ELSIF SUM_DEN < SUMA_SH1 THEN	
			            ExMemo:= (SUMA_SH2 - SUMA_SH1); goto nnn;
			         ELSIF SUM_DEN > SUMA_SH1 AND SUM_DEN < SUMA_SH2 THEN
			            ExMemo:= (SUMA_SH2 - SUM_DEN);
			         END IF;
			      END IF;
			    END IF;				
				if suma <= SUMA_SH1 then
					ExMemo:= 0; goto nnn;
				elsif suma > SUMA_SH1 and suma <= SUMA_SH2 then
					--ExMemo:= suma - SUMA_SH1;
					ExMemo:= SUMA; goto nnn;
				else
					--ExMemo:= SUMA_SH2 - SUMA_SH1;
					ExMemo:= 0; goto nnn;
				end if;	
			elsif P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ3' THEN
			   IF NVL(SUM_DEN,0) > 0 THEN
                 IF (SUM_DEN + SUMA) > SUMA_SH2 THEN
			       IF SUM_DEN < SUMA_SH2 THEN
			          ExMemo:= (SUM_DEN + SUMA - SUMA_SH2);
			       ELSIF SUM_DEN > SUMA_SH2 THEN
			          ExMemo:= SUMA; goto nnn;
			       END IF;
                 ELSIF (SUM_DEN + SUMA) < SUMA_SH2 THEN
                      ExMemo:= 0;
                 END IF;
			   END IF;			
				if suma <= SUMA_SH2 then
					ExMemo:= 0; goto nnn;
				else
					--ExMemo:= suma - SUMA_SH2;
					ExMemo:= SUMA; goto nnn;
				end if;					
			end if;				
	       -- end yach
		end if;
	
	end if;
	
	
	-- ************************************************************************************
	-- Параметры, вычисляемые исходя из документа       ***********************************
	
	
	--Возвращает "1", если есть ссылка на пл.документ	из справочника "ДБО: Подписи платежных документов", иначе "0"
	if P_PAR = 'ДОК_ИКБ' then		
		ExMemo:= EZP(md1);
	
	elsif P_PAR = 'ВР_ОТПРАВКИ' then
		declare dat_begin DATE_TIME;
				hor number;
		begin
			for d in ::[DOCUM_RC] where d.[MAIN_DOC] = md1 and d.[FLAG_EXPORT_DOC] and d.[OUT_DOC_1].[F_TIME] is not null
			loop
			  begin
				select b(min(b.[DATE]))
				in md1.[HISTORY_STATE]
				into dat_begin;
				debug_pipe('--------------dat_begin='||to_number(to_char(dat_begin, 'hh24'))||' F_TIME='||to_number(to_char(d.[OUT_DOC_1].[F_TIME], 'hh24')),0);
				debug_pipe(to_number(to_char(d.[OUT_DOC_1].[F_TIME], 'dd')) - to_number(to_char(dat_begin, 'dd')),0);
				hor := (to_number(to_char(d.[OUT_DOC_1].[F_TIME], 'dd')) - to_number(to_char(dat_begin, 'dd')))*24 + to_number(to_char(d.[OUT_DOC_1].[F_TIME], 'hh24')) - to_number(to_char(dat_begin, 'hh24'));
				debug_pipe('--------------dat_begin='||to_char(dat_begin)||' F_TIME='||to_char(d.[OUT_DOC_1].[F_TIME]),0);					
			  	exception when others then
			  		null;
			  end;	
				hor := nvl(hor, 0);
				ExMemo:= to_char(hor); goto nnn;
			end loop;
		end;
		ExMemo:= '0';	
	
	elsif P_PAR = 'САМ_СЕБЕ' then
		MN_REF := P_DOC;	
		if 	MN_REF.[ACC_DT].[CLIENT_V]=MN_REF.[ACC_KT].[CLIENT_V] or MN_REF.[ACC_DT].[CLIENT_V]=MN_REF.[ACC_KT].[CLIENT_R] then
			ExMemo:= '1'; goto nnn;
		else
			ExMemo:= '0';
		end if;				
	
	elsif P_PAR = 'ПАСПОРТ_СДЕЛКИ' then
		if 	md1.[DEAL_PASP] is null then
			ExMemo:= '0'; goto nnn;
		else
			ExMemo:= '1';
		end if;	
	elsif P_PAR = 'ВАЛ_КОНТРОЛЬ' then
			for b in md1.[HISTORY_STATE] where b.[STATE]='TO_RKO_CUR'
			loop
				ExMemo:= '1'; goto nnn;
			end loop;
			ExMemo:= '0';					
	Elsif P_PAR = 'НАИМ_ПОЛУЧ' Then
		ExMemo:= nvl(md2.[KL_KT].[1].[1].[NAME],md2.[KL_KT].[2].[2]); goto nnn;
	end if;
	
