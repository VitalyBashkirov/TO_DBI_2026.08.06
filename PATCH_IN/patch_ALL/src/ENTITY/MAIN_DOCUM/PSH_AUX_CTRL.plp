class MAIN_DOCUM;

@name('[ПСБ] Дополнительный контроль. Подтверждение документа')
method PSH_AUX_CTRL is
PSH_AUX_CTRL (
	@name('Комментарии')       P_COMMENT in [MEMO],
	@name('Вариант обработки') P_VAR     in [CASE_BETWEEN_TWO]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_COMMENT := this.[COMMENT];
end if;
-- End initialization of parameters and variables
begin
	if p_message = 'DEFAULT' then
		P_VAR.[0]:=1;
	end if;
end;
end;

execute is
begin
	if this%state<>'AUX_CTRL' then
		pragma error ('Опрерация предназначена только для документов в состоянии "AUX_CTRL"');
	end if;
	if P_VAR.[0]=2 then
		this%state:='VOZV';
	end if;
	if P_VAR.[0]=1 then
		this.DOC_TO_PROV(false);
	end if;
	if P_COMMENT is not null then
		if InStr(this.[COMMENT],P_COMMENT)>0 then
			null;
		else
			if this.[COMMENT] is null then 
				this.[COMMENT]:=P_COMMENT;
			else
				this.[COMMENT]:=Substr(P_COMMENT||LF$||this.[COMMENT],1,this.[COMMENT]%size);
			end if;
		end if;
	end if;
end;
end;
end;
