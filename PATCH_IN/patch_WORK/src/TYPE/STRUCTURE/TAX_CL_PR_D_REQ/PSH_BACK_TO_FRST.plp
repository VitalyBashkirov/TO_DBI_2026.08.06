class TAX_CL_PR_D_REQ;

@name('[ПСБ] Откатить состояние (служебная)')
@tag('COPIED')
method PSH_BACK_TO_FRST is

pragma include(::[TAX_CL_PROFIT].[LIB_TC]);
PSH_BACK_TO_FRST (
	@name('В начало') P_TO_FIRST in [BOOLEAN]
) is

validate is
begin
	if P_MESSAGE = 'DEFAULT' then
		null;
	end if;
end;

execute is
type TReqs is table of ref [TAX_CL_PR_D_REQ];
reqsList TReqs;
profList &tc.TProfits;

outMessRef ref [TAX_CL_PR_MESS];
infCount	integer;
begin
	
	if this.[STATUS] in (&tc.stRAnswered, &tc.stRSend) or P_TO_FIRST then
		-- удалить запросы в компоненты (только исходящие)
		for rr in ::[TAX_CL_PR_REQS] all where rr.[REQ_DATA] = this and rr.[IS_OUT] loop
			rr.[DELETE_AUTO];
		end loop;
	
		this.[STATUS] := &tc.stRNew;
	end if;				
	
	if this.[STATUS] = &tc.stRWorked or P_TO_FIRST then
		-- удалить доходы
		for d in ::[TAX_CL_PR_AC_INF] all where d.[DATA_REQ] = this loop
			d.[DELETE_AUTO];
		end loop;
	
		this.[STATUS] := &tc.stRAnswered;
	end if;
			
	if this.[STATUS] in (&tc.stRSendAnsw, &tc.stRErr, &tc.stRFinish) or P_TO_FIRST then
		-- проверка отправленных сообщений
		for (
				select	x(x : xid)
				in		::[GM_TAX_PROF_REQ] all
				where	x.[TAX_MESS] = this.[OUT_MESS]
					and x.[STATUS] in (
										::[GOV_MESSAGE].[LIB].v_status_sent
										, ::[GOV_MESSAGE].[LIB].v_status_wait
										, ::[GOV_MESSAGE].[LIB].v_status_proc
									)
		) loop
			-- если есть уже отправленные сообщения, то откатывать не даем
			--pragma error('Невозможно изменить состояние, т.к. уже есть отправленные сообщения!');
			debug_pipe('если есть уже отправленные сообщения ID:'||x.xid,0);
		end loop;
		
		-- будут удаляться сформированные сообщения
		-- надо пройтись по доходам и восстановить суммы и номер корректировки
		select d(d.[CL_PROFIT])
		in	::[TAX_CL_PR_AC_INF] all
		where	d.[DATA_REQ] = this
		into profList;
		
		-- удалить сообщения
		outMessRef := this.[OUT_MESS];
		
		reqsList.delete;
		for r in ::[TAX_CL_PR_D_REQ] all where r.[OUT_MESS] = outMessRef loop
			-- отвязка связанных запросов корректировок			
			r.[OUT_MESS] := null;
			
			-- запомним связанный запрос для отката
			reqsList(reqsList.count) := r;
		end loop;
		
		this.[OUT_MESS] := null;
		pragma set_this;
		outMessRef.[DELETE_AUTO];
		
		this.[ADD_INFO] := null;
		
		select	d(count(1))
		in		::[TAX_CL_PR_AC_INF] all
		where	d.[DATA_REQ] = this
		into	infCount;
		
		if infCount > 0 then		
			this.[STATUS] := &tc.stRWorked;
		else
			-- если не было информации о доходах, обработку пропускаем
			this.[STATUS] := &tc.stRAnswered;
		end if;
	end if;
	
	if P_TO_FIRST then
		this.[STATUS] := &tc.stRNew;
	end if;	
	
	::[TAX_CL_PROFIT].[LIB].reCalcParamsProfits(profList);
	
	-- откат связанных корректировок
	if reqsList.count > 0 then
		for i in 0..reqsList.count-1 loop
			reqsList(i).[BACK_TO_FIRST](P_TO_FIRST);
		end loop;
	end if;
end;
end;
end;
