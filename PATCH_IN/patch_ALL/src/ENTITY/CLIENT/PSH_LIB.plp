-- Даты открытия\закрытия расчетного счета
public function GetRKODate_for_vw (p_client ref [CL_ORG], p_par varchar2 ) return date is  -- KAS 16/04/2020 по задаче Шмидт для представления
ret_open  date;
ret_close date;
rko_dog ref [RKO];
ret date;
begin
	for rko in ::[RKO] where rko.[CLIENT] = p_client and rko.[CONTRACT_CUR].[CUR_SHORT]= 'RUB' -- для определения дат брем только рублевые р/с
		order by rko.[DATE_BEGINING]
	loop
		ret_open  := rko.[ACCOUNT].[DATE_OP];
		ret_close := rko.[ACCOUNT].[DATE_CLOSE];
		if rko.[ACCOUNT].[DATE_CLOSE] is null then			
			exit; -- если найден работающий договор, берем его и выходим из цикла
		end if;
	end loop;
	
	if p_par = 'OPEN' then return ret_open;
	elsif p_par = 'CLOSE' then return ret_close;
	end if;
	return null;
end;

-- Сумма платежей с расчетного счета в пользу ФЛ, кроме з/п и соц. выплат
public function GetRKOPayFIZ_for_vw (p_client ref [CL_ORG], p_d_beg [DATE], p_d_end [DATE]) return number(18,2) is  -- KAS 16/04/2020 по задаче Шмидт для представления
ret number(18,2);
begin
	ret := 0;
	for rko in ::[RKO] all where rko.[CLIENT] = p_client --and rko.[CONTRACT_CUR].[CUR_SHORT]= 'RUB' -- KAS 17/04/2020 добавил обработку валютных договоров РКО
	loop
		--debug_pipe ('GetRKOPayFIZ_for_vw	'||rko.[ACCOUNT].[MAIN_V_ID],0);
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and trunc(md.[DATE_PROV]) <= p_d_end
									and md.[ACC_DT] = rko.[ACCOUNT]
									and (
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,5) in ('40817','40820','30232') ))--,'40802') ))
											or
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,3) in ('423', '426')) )
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) in ('40817','40820','30232')) )--,'40802')) )
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,3) in ('423', '426') ))
										)
		loop
			if not checkNaznPlat_ZRP(md.[NAZN]) then
				ret := ret + md.[SUM_NT];
			end if;
		end loop;								
	end loop;
	
	return ret;
end;

-- Сумма платежей c расчетного счета
public function GetRKOPayDT_for_vw (p_client ref [CL_ORG], p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is  -- KAS 16/04/2020 по задаче Шмидт для представления
ret number(18,2);
begin
	ret := 0;
	for rko in ::[RKO] all where rko.[CLIENT] = p_client --and rko.[CONTRACT_CUR].[CUR_SHORT]= 'RUB' -- KAS 17/04/2020 добавил обработку валютных договоров РКО
	loop
		--debug_pipe ('GetRKOPayDT_for_vw	'||rko.[ACCOUNT].[MAIN_V_ID],0);
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and trunc(md.[DATE_PROV]) <= p_d_end
									and md.[ACC_DT] = rko.[ACCOUNT]
									and (
											(md.[KL_KT].[0] = 1 and md.[ACC_DT].[MAIN_V_ID] like '4%')
											or
											(md.[KL_KT].[0] = 2 and md.[KL_DT].[2].[1] like '4%')
										)
		loop
				ret := ret + md.[SUM_NT];
		end loop;						
	end loop;
	
	return ret;
end;

-- Сумма платежей на расчетный счет
public function GetRKOPayKT_for_vw (p_client ref [CL_ORG], p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is  -- KAS 16/04/2020 по задаче Шмидт для представления
ret number(18,2);
begin
	ret := 0;
	for rko in ::[RKO] all where rko.[CLIENT] = p_client --and rko.[CONTRACT_CUR].[CUR_SHORT]= 'RUB' -- KAS 17/04/2020 добавил обработку валютных договоров РКО
	loop
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and trunc(md.[DATE_PROV]) <= p_d_end
									and md.[ACC_KT] = rko.[ACCOUNT]
									and (
											(md.[KL_DT].[0] = 1 and md.[ACC_DT].[MAIN_V_ID] like '4%')
											or
											(md.[KL_DT].[0] = 2 and md.[KL_DT].[2].[1] like '4%')
										)
		loop
				ret := ret + md.[SUM_NT];
		end loop;									
	end loop;

	return ret;
end;

-- Проверка: Сумма платежей с расчетного счета в пользу ФЛ (кроме з/п и соц. выплат) > 100 000
public function CheckRKOPayFIZ_for_vw (p_client ref [CL_ORG], p_d_beg [DATE], p_d_end	[DATE]) return varchar(1) is  -- KAS 16/04/2020 по задаче Шмидт для представления
ret varchar(1);
begin
	ret := '0';
	if GetRKOPayFIZ_for_vw (p_client, p_d_beg, p_d_end) > 100000 then
		ret := '1';
	end if;
	return ret;
end;

-- Отношение суммы платежей с расчетного счета в пользу ФЛ (кроме з/п и соц. выплат) к сумме всех платежей
public function GetRKOPayFIZ_PRC_for_vw (p_client ref [CL_ORG], p_d_beg [DATE], p_d_end [DATE]) return number(18,2) is  -- KAS 16/04/2020 по задаче Шмидт для представления
ret number(18,2);
vPayFIZ number(18,2);
vPayDT number(18,2);
begin
	vPayFIZ := GetRKOPayFIZ_for_vw (p_client, p_d_beg, p_d_end);
	if vPayFIZ != 0	then
		vPayDT := GetRKOPayDT_for_vw (p_client, p_d_beg, p_d_end);
		if vPayDT != 0 then
			ret := vPayFIZ/vPayDT * 100;
		else
			ret := null;	
		end if;
	else
		ret := 0;
	end if;
	return ret;
end;

-- Сумма платежей на клиента-ФЛ
public function GetToFIZPayKT_for_vw (p_client ref [CL_ORG], p_d_beg [DATE], p_d_end [DATE]) return number(18,2) is  -- KAS 20/04/2020 по задаче Шмидт для представления
ret number(18,2);
begin
	ret := 0;
	for acc in ::[AC_FIN] where acc.[CLIENT_V] = p_client
	loop
		for md in ::[MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and trunc(md.[DATE_PROV]) <= p_d_end
									
									and md.[ACC_KT] = acc
									and (
											(md.[KL_DT].[0] = 1 and md.[ACC_DT].[MAIN_V_ID] like '4%')
											or
											(md.[KL_DT].[0] = 1 and (substr(md.[ACC_DT].[MAIN_V_ID],1,5) in ('30233') ))
											or
											(md.[KL_DT].[0] = 2 and md.[KL_DT].[2].[1] like '4%')
											or
											(md.[KL_DT].[0] = 2 and (substr(md.[KL_DT].[2].[1],1,5) in ('30233')) )
										)
		loop
			ret := ret + md.[SUM_NT];							
		end loop;
	end loop;
	return ret;
end;

-- Сумма платежей на клиента-ФЛ со счетов ЮЛ (кроме з/п и соц. выплат)
public function GetToFIZPayUR_for_vw (p_client ref [CL_ORG], p_d_beg [DATE], p_d_end [DATE]) return number(18,2) is  -- KAS 20/04/2020 по задаче Шмидт для представления
ret number(18,2);
begin
	ret := 0;
	for acc in ::[AC_FIN] where acc.[CLIENT_V] = p_client
	loop
		--debug_pipe ('GetRKOPayFIZ_for_vw	'||rko.[ACCOUNT].[MAIN_V_ID],0);
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and trunc(md.[DATE_PROV]) <= p_d_end
									
									and md.[ACC_KT] = acc
									and (
											(md.[KL_DT].[0] = 1 and (substr(md.[ACC_DT].[MAIN_V_ID],1,5) in ('40701','40702','40703','40804','40805','40806','40807','40802') )) -- расчетные счета ЮЛ и ИП (рез и не рез) в Банке
											or
											(md.[KL_DT].[0] = 1 and (substr(md.[ACC_DT].[MAIN_V_ID],1,3) in ('420', '421', '422', '425')) ) -- депозиты ЮЛ и ИП
											or
											(md.[KL_DT].[0] = 2 and (substr(md.[KL_DT].[2].[1],1,5) 	 in ('40701','40702','40703','40804','40805','40806','40807','40802') )) -- расчетные счета ЮЛ и ИП (рез и не рез) в другом банке
											or
											(md.[KL_DT].[0] = 2 and (substr(md.[KL_DT].[2].[1],1,3)		 in ('420', '421', '422', '425')) ) --  депозиты ЮЛ и ИП
										)
		loop
			if not checkNaznPlat_ZRP(md.[NAZN]) then
				ret := ret + md.[SUM_NT];
			end if;
		end loop;								
	end loop;
	
	return ret;
end;

-- Проверка: Сумма платежей на клиента-ФЛ со счетов ЮЛ (кроме з/п и соц. выплат) > 100 000
public function CheckToFIZPayUR_for_vw (p_client ref [CL_ORG], p_d_beg [DATE], p_d_end	[DATE]) return varchar(1) is  -- KAS 20/04/2020 по задаче Шмидт для представления
ret varchar(1);
begin
	ret := '0';
	if GetToFIZPayUR_for_vw (p_client, p_d_beg, p_d_end) > 100000 then
		ret := '1';
	end if;
	return ret;
end;

-- Отношение суммы платежей на клиента-ФЛ со счетов ЮЛ (кроме з/п и соц. выплат) к сумме всех платежей на клиента-ФЛ
public function GetToFIZPay_PRC_for_vw (p_client ref [CL_ORG], p_d_beg [DATE], p_d_end [DATE]) return number(18,2) is  -- KAS 20/04/2020 по задаче Шмидт для представления
ret number(18,2);
vPayUR number(18,2);
vPayKT number(18,2);
begin
	vPayUR := GetToFIZPayUR_for_vw (p_client, p_d_beg, p_d_end);
	if vPayUR != 0	then
		vPayKT := GetToFIZPayKT_for_vw (p_client, p_d_beg, p_d_end);
		if vPayKT != 0 then
			ret := vPayUR/vPayKT * 100;
		else
			ret := null;	
		end if;
	else
		ret := 0;
	end if;
	return ret;
end;

-- Сумма списаний на контрагента (за исключением налогов и ЗП)
public function GetDTPayContragent(p_acc ref [AC_FIN], p_INN string, p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is  -- KAS 21/05/2020 по задаче Шмидт для представления
sm number(18,2);
smdbt number(18,2);
begin
	smdbt := nvl(::[RUNTIME].[F_5].A('И'||p_acc||'ДВ', p_d_beg, p_d_end),0);	
	if smdbt >0 then	
		sm := 0;	
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_DT] = p_acc
									and not (
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,5) =	'40101' ))
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) 	 =	'40101' ))
									)

									and (
											(md.[KL_KT].[0] = 1 and (md.[KL_KT].[1].[1].[INN] =	p_inn ))
											or
											(md.[KL_KT].[0] = 2 and (md.[KL_KT].[2].[INN] 	 =	p_inn ))
									)
									and ((	md.[KL_KT].[0] = 1
										AND ( 	SUBSTR(md.[KL_KT].[1].[2].[MAIN_V_ID],1,5) IN ('40701', '40702', '40703', '40802', '40804', '40805', '40806', '40807', '30232', '40817', '40820')
											OR	SUBSTR(md.[KL_KT].[1].[2].[MAIN_V_ID],1,3) IN ('423', '426') 				
											)
										)
										OR
										( md.[KL_KT].[0] = 2
										AND ( 	SUBSTR(md.[KL_KT].[2].[1],1,5) IN ('40701', '40702', '40703', '40802', '40804', '40805', '40806', '40807', '30232', '40817', '40820')
											OR	SUBSTR(md.[KL_KT].[2].[1],1,3) IN ('423', '426') 				
				)			
			)
		)
									
		loop
			if	checkNaznPlat_ZRP(md.[NAZN])=false then
				sm := sm + md.[SUM_NT];
			end if;
		end loop;

		return sm;
		
	else
		return 0;
	end if;
end;

-- Сумма списаний на контрагента без НДС (за исключением налогов и ЗП)
public function GetDTPayContragent_noNDS(p_acc ref [AC_FIN], p_INN string, p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is  -- KAS 21/05/2020 по задаче Шмидт для представления
sm number(18,2);
smdbt number(18,2);
begin
	smdbt := nvl(::[RUNTIME].[F_5].A('И'||p_acc||'ДВ', p_d_beg, p_d_end),0);	
	if smdbt >0 then	
		sm := 0;	
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_DT] = p_acc
									and not (
											(md.[KL_KT].[0] = 1 and (substr(md.[ACC_KT].[MAIN_V_ID],1,5) =	'40101' ))
											or
											(md.[KL_KT].[0] = 2 and (substr(md.[KL_KT].[2].[1],1,5) 	 =	'40101' ))
									)
					--,	decode(md.[KL_KT].[0],1,md.[KL_KT].[1].[1].[INN],2,md.[KL_KT].[2].[INN]) : C_INN
									and (
											(md.[KL_KT].[0] = 1 and (md.[KL_KT].[1].[1].[INN] =	p_inn ))
											or
											(md.[KL_KT].[0] = 2 and (md.[KL_KT].[2].[INN] 	 =	p_inn ))
									)
									and ((	md.[KL_KT].[0] = 1
										AND ( 	SUBSTR(md.[KL_KT].[1].[2].[MAIN_V_ID],1,5) IN ('40701', '40702', '40703', '40802', '40804', '40805', '40806', '40807', '30232', '40817', '40820')
											OR	SUBSTR(md.[KL_KT].[1].[2].[MAIN_V_ID],1,3) IN ('423', '426') 				
											)
										)
										OR
										( md.[KL_KT].[0] = 2
										AND ( 	SUBSTR(md.[KL_KT].[2].[1],1,5) IN ('40701', '40702', '40703', '40802', '40804', '40805', '40806', '40807', '30232', '40817', '40820')
											OR	SUBSTR(md.[KL_KT].[2].[1],1,3) IN ('423', '426') 				
				)			
			)
		)
									
		loop
			if	checkNaznPlat_NONDS(md.[NAZN] ) and checkNaznPlat_ZRP(md.[NAZN])=false then
			--if	checkNaznPlat_NDS(md.[NAZN] ) then
				sm := sm + md.[SUM_NT];
			end if;
		end loop;
		--return sm/smdbt*100;
		return sm;
		
	else
		return 0;
	end if;
end;

