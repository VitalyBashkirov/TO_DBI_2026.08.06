-- ============================================================================
--  8: v50.SQL.OUTERJOIN.п.1.1 - Замена (+) на LEFT/RIGHT JOIN
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена (+) на LEFT/RIGHT JOIN
--   Подробное описание: Oracle оператор (+) в ANSI не поддерживается. Далее нельзя использовать PLPlus параметризацию типа соединения (true/false) в where. Вместо этого нужно использовать явные left/right join on.
--   Пример кода (плохой): select * from t1, t2 where t1.id = t2.id(+)
--   Пример кода 2 (плохой): where ac%id = gj.[ACCOUNT](true)
--   Пример кода 3 (плохой): where cr.[LIST_PAY] = fo&collection(true)
--   Пример кода (исправленный): select * from t1 left join t2 on t1.id = t2.id
--   Теги: v50, SQL, OUTERJOIN, п, 1, 1
-- 4.RUBRICATOR_PROMPTS.json (расширенный):
--   documentation_text: Oracle оператор (+) в ANSI не поддерживается. Далее нельзя использовать PLPlus параметризацию типа соединения (true/false) в where. Вместо этого нужно использовать явные left/right join on.
--   plplus_materials_note: Согласно учебному курсу (Глава 5.8), конструкция '&collection(true)' является упрощённым синтаксисом LOCATE для поиска в коллекции и используется для организации внешних соединений (outer joins). Аналогично, конструкция '[REF](true)' или '[REF](false)' применяется к реквизитам-ссылкам для указания типа соединения.
--   search_prompt: Найти в PLPlus коде использование устаревших синтаксисов внешних соединений:
1. Оператор Oracle '(+)' в условии WHERE.
2. Конструкцию '&collection(true)' в условии WHERE.
3. Конструкцию '[REF](true)' или '[REF](false)' в условии WHERE.
Игнорировать: строки с 'LEFT/RIGHT JOIN', закомментированные строки (--), строки внутри PL/SQL блоков (/* ... */).
--   regex_patterns.for_search: (1) Левая часть без (+), правая с (+); (2) Левая часть с (+), правая без (+); (3) Параметризованное внешнее соединение с коллекцией; (4) Внешнее соединение через реквизит-ссылку с параметром true; (5) Строгое соединение через реквизит-ссылку с параметром false; (6) Внешнее соединение через реквизит-ссылку (без квадратных скобок) с параметром true
--   code_example_bad: select * from t1, t2 where t1.id = t2.id(+)
--   code_example_bad2: where ac%id = gj.[ACCOUNT](true)
--   code_example_bad3: where cr.[LIST_PAY] = fo&collection(true)
--   fix_instruction: Преобразовать устаревший синтаксис в ANSI SQL:
1. a=b(+) -> LEFT JOIN b ON a=b
2. a(+)=b -> RIGHT JOIN b ON a=b
3. &collection(true) -> LEFT JOIN (::[TABLE] all : alias) ON условие
4. [REF](true) -> удалить (true) и преобразовать в LEFT JOIN
--   test_generation_prompt: Сгенерировать тестовый PLPlus файл для проверки правила 'v50.SQL.OUTERJOIN.п.1.1' с проблемными конструкциями.
--   examples.simple.bad: select * from t1, t2 where t1.id = t2.id(+)
--   examples.simple.good: select * from t1 left join t2 on t1.id = t2.id
--   examples.simple_case.bad: select * from t1, t2 where t1.id = t2.id(+)
--   examples.simple_case.good: select * from t1 left join t2 on t1.id = t2.id
--   examples.parametrized_collection.bad: where cr.[LIST_PAY] = fo&collection(true)
--   examples.parametrized_collection.good: left join (::[FACT_OPER] all : fo) on cr.[LIST_PAY] = fo&collection
--   examples.parametrized_ref.bad: where ac%id = gj.[ACCOUNT](true)
--   examples.parametrized_ref.good: left join [GNI_JOUR] gj on ac%id = gj.[ACCOUNT]
--   priority: HIGH
--   category: SQL
--   subcategory: SQL.DML.JOINS
--   source_files: v50.docx
--   source_sections: 1
-- ============================================================================
PROCEDURE v50_SQL_OUTERJOIN_p_1_1 IS
	-- Объявления переменных из примеров
BEGIN
	-- [-] Неправильный код
	-- begin pl/sql
		select * from t1, t2 where t1.id = t2.id(+)
		-- Дополнительный пример:
		where ac%id = gj.[ACCOUNT](true)
		-- Дополнительный пример:
		where cr.[LIST_PAY] = fo&collection(true)
	-- end pl/sql

	-- [+] Исправленный код
	-- begin pl/sql
		select * from t1 left join t2 on t1.id = t2.id
	-- end pl/sql
END;


