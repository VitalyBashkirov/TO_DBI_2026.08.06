class DEPOSIT_PRIV;

@import_plsql(true)
@name('!Отчетик')
method PSH_11111 is
PSH_11111 is

execute is
/*********************************************************************
Назначение:

kokorin, последнее изменение 10 Декабрь 2015 г.
*********************************************************************/
function chVid (vid_name in out string) return string
is
ret string;
begin
	if upper(vid_name) = 'ДО ВОСТРЕБОВАНИЯ' then
		ret := 'До востреб.';
	elsif upper(vid_name) like '%ЗИМНЯЯ СКАЗКА%' then
		ret := 'Зимняя сказка';
	elsif instr(UPPER(vid_name), 'АКЦИЯ') >0 then
		ret := replace(vid_name, 'АКЦИЯ. ', ''); 	
	else
		ret := substr(vid_name, 1, instr(vid_name, ' '));
	end if;
	return ret;
end;

begin

	for (select s (sum(s.C_SUMMA) :C_SUMMA
			,s.C_VID : C_VID
			,s.C_VAL : C_VAL
			,s.C_PRC_STAV :C_PRC_STAV)
			in
			(select dep(::[RUNTIME].[F_5].A('И'||dep.[ACCOUNT]%id||'СВ',to_date('01/12/2015','DD/MM/YYYY')) : C_SUMMA
				  ,
				  case when upper(dep.[VID_DOG].[NAME]) = 'ДО ВОСТРЕБОВАНИЯ' then 'До востреб.'
				  	   when upper(dep.[VID_DOG].[NAME]) like '%ЗИМНЯЯ СКАЗКА%' then 'Зимняя сказка'
				  	   when instr(UPPER(dep.[VID_DOG].[NAME]), 'АКЦИЯ') >0 then replace(dep.[VID_DOG].[NAME], 'АКЦИЯ. ', '') 	
				  else  substr(dep.[VID_DOG].[NAME], 1, instr(dep.[VID_DOG].[NAME], ' '))
				  end	
				  	
				  	: C_VID
				  ,dep.[FINTOOL].[CUR_SHORT] : C_VAL
				  ,nvl(::[PRC_SCHEME].[LIB].GetPrcRate(::[DEPN].[LIB_CALC_PRC].GetPrcSchem(dep,to_date('01/12/2015','DD/MM/YYYY')),to_date('01/12/2015','DD/MM/YYYY')),::[PRC_SCHEME].[LIB].GetPrcRate(::[DEPN].[LIB_CALC_PRC].GetPrcSchem(dep,to_date('01/12/2015','DD/MM/YYYY')),to_date('01/12/2015','DD/MM/YYYY'),::[RUNTIME].[F_5].A('И'||dep.[ACCOUNT]%id||'СВ',to_date('01/12/2015','DD/MM/YYYY')))) :C_PRC_STAV
			)
			in [DEPOSIT_PRIV] where substr(dep.[ACCOUNT].[MAIN_V_ID],1,5) not in ('40817', '40820' ))
			
		
		group by s.C_VAL, s.C_VID, s.C_PRC_STAV
		order by s.C_VAL, s.C_VID, s.C_PRC_STAV
		 )
	
	loop
		if s.C_SUMMA >0 then
		debug_pipe (s.C_VAL||'	'||s.C_VID||'	'||trim(to_char(s.C_PRC_STAV,'99999999999990d00'))||'	'||trim(to_char(s.C_SUMMA, '99999999999990d00')),0);
		end if;
	end loop;	

debug_pipe ('',0);
----------------------------------------------

	for (select s2 (sum(s2.C_SUMMA) :C_SUMMA

			,s2.C_VAL : C_VAL
			,s2.C_FILIAL :C_FILIAL)
			in
			(select dep(::[RUNTIME].[F_5].A('И'||dep.[ACCOUNT]%id||'СВ',to_date('01/12/2015','DD/MM/YYYY')) : C_SUMMA

				  ,dep.[FINTOOL].[CUR_SHORT] : C_VAL
				  ,decode(dep.[FILIAL].[CODE], '001', 'Москва', '101', 'Саратовская обл.'): C_FILIAL
				 -- ,nvl(::[PRC_SCHEME].[LIB].GetPrcRate(::[DEPN].[LIB_CALC_PRC].GetPrcSchem(dep,to_date('01/01/2015','DD/MM/YYYY')),to_date('01/01/2015','DD/MM/YYYY')),::[PRC_SCHEME].[LIB].GetPrcRate(::[DEPN].[LIB_CALC_PRC].GetPrcSchem(dep,to_date('01/01/2015','DD/MM/YYYY')),to_date('01/01/2015','DD/MM/YYYY'),::[RUNTIME].[F_5].A('И'||dep.[ACCOUNT]%id||'СВ',to_date('01/01/2015','DD/MM/YYYY')))) :C_PRC_STAV
			)
			in [DEPOSIT_PRIV] where substr(dep.[ACCOUNT].[MAIN_V_ID],1,5) not in ('40817', '40820' ))
			
		
		group by s2.C_FILIAL, s2.C_VAL
		order by s2.C_FILIAL, s2.C_VAL
		 )
	
	loop
		
		if s2.C_SUMMA >0 then
		
		debug_pipe (s2.C_FILIAL||'	'||s2.C_VAL||'	'||trim(to_char(s2.C_SUMMA, '99999999999990d00')),0);
		end if;
	end loop;
	

debug_pipe ('',0);

	for (select s3 (sum(s3.C_SUMMA) :C_SUMMA

			,s3.C_VAL : C_VAL
)
			in
			(--select dep(::[RUNTIME].[F_5].A('И'||dep.[ACCOUNT]%id||'СВ',to_date('01/01/2015','DD/MM/YYYY')) : C_SUMMA
select dep(::[RUNTIME].[F_5].A('И'||dep.[ACCOUNT]%id||'СВ',to_date('01/12/2015','DD/MM/YYYY')) : C_SUMMA
				  ,dep.[FINTOOL].[CUR_SHORT] : C_VAL

				 -- ,nvl(::[PRC_SCHEME].[LIB].GetPrcRate(::[DEPN].[LIB_CALC_PRC].GetPrcSchem(dep,to_date('01/01/2015','DD/MM/YYYY')),to_date('01/01/2015','DD/MM/YYYY')),::[PRC_SCHEME].[LIB].GetPrcRate(::[DEPN].[LIB_CALC_PRC].GetPrcSchem(dep,to_date('01/01/2015','DD/MM/YYYY')),to_date('01/01/2015','DD/MM/YYYY'),::[RUNTIME].[F_5].A('И'||dep.[ACCOUNT]%id||'СВ',to_date('01/01/2015','DD/MM/YYYY')))) :C_PRC_STAV
			)
			in [DEPOSIT_PRIV] where substr(dep.[ACCOUNT].[MAIN_V_ID],1,5) not in ('40817', '40820' ))
			
		
		group by s3.C_VAL
		order by s3.C_VAL
		 )
	
	loop
		
		if s3.C_SUMMA >0 then
		
		debug_pipe (s3.C_VAL||'	'||trim(to_char(s3.C_SUMMA, '99999999999990d00')),0);
		end if;
	end loop;		

end;
end;
end;
