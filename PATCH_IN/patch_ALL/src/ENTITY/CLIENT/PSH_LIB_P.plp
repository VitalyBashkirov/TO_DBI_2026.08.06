--Б ivanov a.v. 27/07/2017 почтовый перенесем в контакты
				P_DATA_6 := GetAddress(client_priv.[ADDRESSES],'ALL', 'ALIEN');		   if P_DATA_6 is not null then P_DATA_6:='Место пребывания для иностранцев: '||P_DATA_6||LF$; end if;
				P_DATA:=P_DATA_1||P_DATA_2||P_DATA_3||P_DATA_4||P_DATA_5||P_DATA_6;
				--if Length(P_DATA)>0 then P_DATA:=Substr(P_DATA,1,Length(P_DATA)-2); end if;
 			end if;
 		
		elsif (client_corp%id is not null) and (p_info = 'ПОЧТ_АДРЕС') then --ПОЧТ_АДРЕС (почтовый)
			P_DATA := nvl(GetAddress(client_corp.[ADDRESSES],'ALL', 'POST'), '');
		
		-- Дианков А.В. 15/01/16 ЮР. адрес		
