class PSH_FTC;

@name('[ПСБ] Найти, привязать Клиента АБС')
method PSH_ADD_REF_CL is
public DelChar string(100):='''"<>/\.,-_';
public SeparatorChar string(100):=DelChar;
public Separator char:='#';
public DelPref string(1000):='ИП'||Separator||'ИНДИВИДУАЛЬНЫЙ ПРЕДПРИНИМАТЕЛЬ'||Separator||
	                  'ООО'||Separator||'ОБЩЕСТВО С ОГРАНИЧЕННОЙ ОТВЕТСТВЕННОСТЬЮ'||Separator||
	                  'ОАО'||Separator||'ОТКРЫТОЕ АКЦИОНЕРНОЕ ОБЩЕСТВО'||Separator||
	                  'ЗАО'||Separator||'ЗАКРЫТОЕ АКЦИОНЕРНОЕ ОБЩЕСТВО'||Separator||
	                  'АО'||Separator||'АКЦИОНЕРНОЕ ОБЩЕСТВО'||Separator||
                      'КХ'||Separator||'КРЕСТЬЯНСКОЕ ХОЗЯЙСТВО'||Separator||
                      'НЧЗ'||Separator||'НОТАРИУС'||Separator||
                      'АУА'||Separator||'АДВОКАТ'||Separator||
	                  '';

pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma MACRO (LGW, '::[CL_PRIV].[PSB_EDIT_SEX]');
pragma MACRO (ARC, '::[PSH_FTC].[PSH_ADD_REF_CL]'); -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25 -- updated CHANGE_SHORT_NAME ADD_REF_CLIENT->PSH_ADD_REF_CL 15/10/25

dp	integer:=0;	--управление &debug
dp2	integer:=0;
dp3	integer:=0;
dp5	integer:=0;

fmt string:='dd/mm/yyyy';
fmt24 string:='dd/mm/yyyy hh24:mi:ss';

public function Trans(vName in [STRING_1000], DelChar in string(100)) return [STRING_1000] is 
ExStr [STRING_1000];
LenDelChar number;
Ch string(1);
begin
	ExStr:=vName;
	LenDelChar:=nvl(Length(DelChar),0);
	for i in 1..LenDelChar loop
		Ch:=SubStr(DelChar,i,1);
		ExStr:=Replace(ExStr,Ch);
	end loop;
	return ExStr;
end;

public function TransPref(vName in [STRING_1000], DelPref in [STRING_1000], dbg number default null) return [STRING_1000] is 
ExStr [STRING_1000];
LenDelChar number;
Ch string(1);

nnn number;
Pref [STRING_1000];
LenPref number;
begin
	--ООО <Ковчег>
	ExStr:=vName;
	DelPref:=trim(DelPref,Separator);
	nnn:=nvl(Length(DelPref),0)-nvl(Length(Replace(DelPref,Separator)),0)+1;
	for i in 1..nnn loop
		Pref:=::[CL_PRIV].[PSH_DATE_DEATH].wbn(DelPref,Separator,i);
		LenPref:=nvl(Length(Pref),0);
		&debug('.TransPref -- '||Pref||'('||LenPref||') '||vName,dbg)
		if LenPref>0 and Substr(vName,1,LenPref)=Pref then
			ExStr:=Substr(vName,LenPref+1); -- <Ковчег>
			ExStr:=Ltrim(ExStr);            --<Ковчег>
			exit;
		end if;
	end loop;
	&debug('.TransPref -> '||ExStr,dbg)
	return ExStr;
end;
PSH_ADD_REF_CL (
	@name('Только действующая запись') P_WORK in [BOOLEAN]
) return [CLIENT_REF] is

validate is
begin
	if p_message = 'DEFAULT' then
	   P_WORK:=true;
	end if;
end;

execute is
/*********************************************************************
Назначение:

BASHKIROV, последнее изменение 5 Июнь 2019 г.
*********************************************************************/
ClTmp ref [CLIENT];
begin
	P_WORK:=nvl(P_WORK,false);
	if P_WORK and this.[WORK] or not P_WORK then
		var vInn [STRING_12];
		vInn:=this.[FTC_INN];
		if vInn is not null then
			&debug('Поиск по ИНН:'||vInn,dp2)
			for (select cl(cl%id : C_ID, cl.[NAME] : C_NAME) in ::[CLIENT] all where cl.[INN]=vInn) loop
				this.[FTC_CLIENT]=ClTmp:=cl.C_ID;
				&debug('Нашли по ИНН '||ClTmp%class||'.'||cl.C_ID||'.'||cl.C_NAME||' для ID:'||this||' ИНН участника ВЭД:'||this.[FTC_INN]||' Наименование участника ВЭД:'||this.[FTC_NAME]||' Файл:'||this.[F_NAME]||' '||to_char(this.[DATE_IN],fmt),dp2)
				return ClTmp;
			end loop;
		end if;
		
		var vName [STRING_300];
		vName:=trim(this.[FTC_NAME]);
		
		var vNameUpper [STRING_300];
		vNameUpper:=Upper(vName);
		if vNameUpper is not null then
			&debug    ('Поиск по НАИМЕНОВАНИЮ <"ООО/ИП КЛИЕНТА">:'||vNameUpper,dp2)
			for (select cl(cl%id : C_ID, cl.[NAME] : C_NAME) in ::[CLIENT] all where Upper(cl.[NAME])=vNameUpper) loop
				this.[FTC_CLIENT]=ClTmp:=cl.C_ID;
				&debug('Нашли по НАИМЕНОВАНИЮ <"ООО/ИП КЛИЕНТА">:'||ClTmp%class||'.'||cl.C_ID||'.'||cl.C_NAME||' для ID:'||this||' ИНН участника ВЭД:'||this.[FTC_INN]||' Наименование участника ВЭД:'||this.[FTC_NAME]||' Файл:'||this.[F_NAME]||' '||to_char(this.[DATE_IN],fmt),dp2)
				return ClTmp;
			end loop;
		end if;
		
		var vNameOnlyChar [STRING_300];
		vNameOnlyChar:=Replace(vNameUpper,' ');
		if vNameOnlyChar is not null and vNameOnlyChar not in (vNameUpper) then
			&debug    ('Поиск по НАИМЕНОВАНИЮ<"ООО/ИПКЛИЕНТА">  :'||vNameOnlyChar,dp2)
			for (select cl(cl%id : C_ID, cl.[NAME] : C_NAME) in ::[CLIENT] all
			where Replace(Upper(cl.[NAME]),' ')=vNameOnlyChar) loop
				this.[FTC_CLIENT]=ClTmp:=cl.C_ID;
				&debug('Нашли по НАИМЕНОВАНИЮ<"ООО/ИПКЛИЕНТА">  :'||ClTmp%class||'.'||cl.C_ID||'.'||cl.C_NAME||' для ID:'||this||' ИНН участника ВЭД:'||this.[FTC_INN]||' Наименование участника ВЭД:'||this.[FTC_NAME]||' Файл:'||this.[F_NAME]||' '||to_char(this.[DATE_IN],fmt),dp2)
				return ClTmp;
			end loop;
		end if;
		
		var vNameOnlyLitter [STRING_300];
		vNameOnlyLitter:=&ARC.Trans(vNameOnlyChar,&ARC.DelChar);
		if vNameOnlyLitter is not null and vNameOnlyLitter not in (vNameUpper, vNameOnlyChar) then
			&debug    ('Поиск по НАИМЕНОВАНИЮОООИПКЛИЕНТА       :'||vNameOnlyLitter,dp2)
			for (select cl(cl%id : C_ID, cl.[NAME] : C_NAME) in ::[CLIENT] all
			where &ARC.Trans( Replace(Upper(cl.[NAME]),' '), &ARC.DelChar)=vNameOnlyLitter)
			loop
				this.[FTC_CLIENT]=ClTmp:=cl.C_ID;
				&debug('Нашли по НАИМЕНОВАНИЮОООИПКЛИЕНТА       :'||ClTmp%class||'.'||cl.C_ID||'.'||cl.C_NAME||' для ID:'||this||' ИНН участника ВЭД:'||this.[FTC_INN]||' Наименование участника ВЭД:'||this.[FTC_NAME]||' Файл:'||this.[F_NAME]||' '||to_char(this.[DATE_IN],fmt),dp2)
				return ClTmp;
			end loop;
		end if;

		var vNameOnlyName[STRING_300];
		vNameOnlyName:=&ARC.Trans(&ARC.TransPref(vNameUpper,&ARC.DelPref,dp),&ARC.DelChar);
		if vNameOnlyName is not null and vNameOnlyName not in (vNameUpper, vNameOnlyChar, vNameOnlyLitter) then
			&debug    ('Поиск по КЛИЕНТА                        :'||vNameOnlyName,dp2)
			for (select cl(cl%id : C_ID, cl.[NAME] : C_NAME) in ::[CLIENT] all where &ARC.Trans(&ARC.TransPref(Upper(cl.[NAME]),&ARC.DelPref),&ARC.DelChar)=vNameOnlyName) loop
				this.[FTC_CLIENT]=ClTmp:=cl.C_ID;
				&debug('Нашли по КЛИЕНТА                        :'||ClTmp%class||'.'||cl.C_ID||'.'||cl.C_NAME||' для ID:'||this||' ИНН участника ВЭД:'||this.[FTC_INN]||' Наименование участника ВЭД:'||this.[FTC_NAME]||' Файл:'||this.[F_NAME]||' '||to_char(this.[DATE_IN],fmt),dp2)
				return ClTmp;
			end loop;
		end if;
	else
		null;
		&debug('Не действующая. Пропускаем. ID:'||this||' ИНН участника ВЭД:'||this.[FTC_INN]||' Наименование участника ВЭД:'||this.[FTC_NAME]||' Файл:'||this.[F_NAME]||' '||to_char(this.[DATE_IN],fmt),dp2)
	end if;	
end;
end;
end;
