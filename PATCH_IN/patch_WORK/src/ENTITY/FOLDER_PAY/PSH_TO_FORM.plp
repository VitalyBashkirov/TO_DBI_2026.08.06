class FOLDER_PAY;

@name('[ПСБ] %->Не обработан (служебная)')
method PSH_TO_FORM is
pragma include(::[RUNTIME].[DEBUG_MACRO]);
dp  number:=0;	--управление debug_pipe
dp2 number:=10;	--управление debug_pipe

function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

fmt	   string(10):='dd/mm/yyyy';
fmtHMS string(22):='dd/mm/yyyy HH24:MI:SS';

public function ProdInfo(f ref [FOLDER_PAY]) return varchar2(100) is 
r ref [PRODUCT];
pId [STRING_16]:=f.[PROD_FOLD];
begin
	for p in ::[PRODUCT] all where p%id=pId loop
		return SubStr(p%class||'.'||p%id||'.'||p.[COM_STATUS].[CODE]||'.'||p.[DEPART].[CODE],1,100);
	end loop;
end;

public function FinishStateMD(md ref [MAIN_DOCUM]) return boolean is 
begin
	if md is null then
		&debug('.FinishStateMD -- Платежного документа нет',dp)
		return null;
	elsif md%state in (
		'PROV',			--Проведен
		'ISNULL', 		--Аннулирован
		'TO_RETURN',	--Возвратить клиенту
	    'PAY',			--Оплачен
	  	'PROV_IN_BANK')	--Проведен в банке
	  --'TO_KART',  	--В картотеке
	  --'DELETED',  	--Ликвидирован
	  --'VOZV',			--На возврат
	  --'WAIT_DVALUT', 	--Ожидает валютирования
	  --'SENDED',		--Отправлен
	  --'REGISTER')		--Реестр инкассо
	then
		&debug('.FinishStateMD ID:'||md||' Платежный документ в конечном статусе "'||md%state,dp)
		return true;
	else
		&debug('.FinishStateMD ID:'||md||' Платежный документ в промежуточном татусе "'||md%state,dp)
		return false;
	end if;
end;

public procedure ProvIfAllDocProv(f ref [FOLDER_PAY], ID_FP in out string(1000), Err in out boolean) is 
flEnd boolean:=true;
fp ref [FOLDER_PAY];
fo ref [FIN_ORDER];
tfp ref [TRUST_FOR_PROD];
fd ref [FACTURA_DOC];
TmpClass string(32);
begin
	if Err then return; end if;
	if ID_FP is null then
		&debug('.ProvIfAllDocProv -- Обрабатываем Папку ID:'||f%id||'.'||fd%state||' {'||f.[DOCS_IN_FOLD]%size(0)||'} №'||f.[DOCUMENT_NUM]||' от '||to_char(f.[DOCUMENT_DATE],fmt)||' Стек папок (IDs):'||ID_FP,dp)
		ID_FP:=';';
	end if;
	for d in f.[DOCS_IN_FOLD] loop
		TmpClass:=d.[DOCUMENT]%class;

		if TmpClass='MAIN_DOCUM' then
		    --Конечные статусы:	
			-- PROV			--Проведен
			-- ISNULL 		--Аннулирован
			-- TO_RETURN	--Возвратить клиенту
		    -- PAY			--Оплачен
		  	-- PROV_IN_BANK	--Проведен в банке
			if not FinishStateMD(d.[DOCUMENT]) then
				flEnd:=false;
				return;
			end if;
		elsif TmpClass='FOLDER_PAY' then
			fp:=d.[DOCUMENT];
			if InStr(ID_FP,';'||fp||';')=0 then
				begin
					ID_FP:=ID_FP||fp||';';
					ProvIfAllDocProv(fp,ID_FP,Err);
				exception when others then
					Err:=true;
					&debug('.ProvIfAllDocProv -- Либо много папок, либо циклит',dp)
					return;
				end;
			end if;
		elsif TmpClass='FIN_ORDER' then			--Финансовое рапоряжение
			fo:=d.[DOCUMENT];
			if fo%state<>'PROV' then			--PROV-Исполнено (FORM-Не обработано, DELETED-Ликвидировано, PODTV-На подтверждении)
				flEnd:=false;
				&debug('.ProvIfAllDocProv ID:'||fo||' Фин.распоряжение в промежуточном татусе "'||fo%state,dp)
				return;
			else
				&debug('.ProvIfAllDocProv ID:'||fo||' Фин.распоряжение в конечном статусе "'||fo%state,dp)
			end if;
		elsif TmpClass='TRUST_FOR_PROD'	then	--Доверенность на распоряжение продуктом
			tfp:=d.[DOCUMENT];
			if tfp%state = 'INP' then 			--INP-Предварительно введена (AN-Аннулирована, BLOCK-Блокирована, ENDED-Закончилась, REG-Зарегистрирована)
				flEnd:=false;
				&debug('.ProvIfAllDocProv ID:'||tfp||' Доверенность на распоряжение продуктом в промежуточном татусе "'||tfp%state,dp)
				return;
			else
				&debug('.ProvIfAllDocProv ID:'||tfp||' Доверенность на распоряжение продуктом в конечном статусе "'||tfp%state,dp)
			end if;
		elsif TmpClass in ('FACTURA_DOC') then
			/** /
			fd:=d.[DOCUMENT];
			if fd%state not in ('ACTIVE','CANCELED','RECALC') then --ACTIVE-Действующий, CANCELED-Аннулированый, RECALC-Отозванный
				Err:=true;
				&debug('.ProvIfAllDocProv ID:'||fd||' Счет-фактура в промежуточном татусе "'||fd%state,dp)
				return;
			else
				&debug('.ProvIfAllDocProv ID:'||fd||' Счет-фактура в конечном статусе "'||fd%state,dp)
			end if;
			/**/
			null;
		elsif TmpClass in ('DISCOUNT') then
			null;
		else
			pragma error('Нужна доработка для '||TmpClass);
			Err:=true;
			&debug('.ProvIfAllDocProv -- Для '||TmpClass||' нужна доработка для '||TmpClass,dp)
			exit;
		end if;
	end loop;
	
	if not flEnd then
		&debug('.ProvIfAllDocProv -- Папка ID:'||f||' Есть документы не в конечном статусе!',dp)
	else
		if f%state = 'FFORM' then
			f%state := 'PROV';
			f.[ASTR_DATE_PROV]:=sysdate; 			--Астрономическая дата проводки
			if f.[DATE_EXEC] is null then
				f.[DATE_EXEC]:=f.[ASTR_DATE_PROV];  --Дата исполнения
			end if;
			f.[COMMENT]:=Substr(trim(f%state||' откорректировано '||to_char(f.[ASTR_DATE_PROV],fmtHMS)||'. '||f.[COMMENT]),1,f.[COMMENT]%size);
			&debug('.ProvIfAllDocProv -- Папка '||f%id||'.'||f%state||' Дата Исполнения '||to_char(f.[DATE_EXEC],fmt)||' Астрономическая дата проводки:'||to_char(f.[ASTR_DATE_PROV],fmtHMS),dp)
		end if;
	end if;
end;
PSH_TO_FORM is

execute is
/*********************************************************************
Назначение:

bashkirov, последнее изменение 4 Ноябрь 2018 г.
*********************************************************************/
begin
	if    this%state = 'DELETED' then this%state := 'FFORM'; --Ликвидирован
	elsif this%state = 'COINS' 	 then this%state := 'FFORM'; --Ожидание
	elsif this%state = 'PROV' 	 then this%state := 'DELETED'; --В "Проведен" через "Ликвидирован"
		if this%state = 'DELETED'then this%state := 'FFORM'; --Проведен
		end if;
	end if;
	if this.[DATE_EXEC] 	 is not null then this.[DATE_EXEC]:=null; 	   end if;
	if this.[ASTR_DATE_PROV] is not null then this.[ASTR_DATE_PROV]:=null; end if;
end;
end;
end;
