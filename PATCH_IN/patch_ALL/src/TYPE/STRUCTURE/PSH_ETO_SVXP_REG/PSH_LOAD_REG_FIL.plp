class PSH_ETO_SVXP_REG;

@import_plsql(true)
@name('[ПСБ] Загрузить реестр из файла')
static method PSH_LOAD_REG_FIL is

@name('File') public V_FILE [FILE$LOAD];

pragma macro(lob, 'DBMS_LOB', substitute);

PSH_LOAD_REG_FIL
/* Секция параметров операции */
(
	@name('Кодировка файла') P_FILE_CP in [CASE_BETWEEN_TWO],
	@name('Канал загрузки') P_WAY_LOAD in [CASE_BETWEEN_TWO]
) 
/* Конец секции параметров операции */
is

validate is
begin
	if p_message = 'DEFAULT' then
		P_FILE_CP.[0] := 1;
		P_WAY_LOAD.[0] := 1;
		V_FILE.[SRC_TYPE] := false;
		V_FILE.[SRC_DELETE] := false;
		V_FILE.[SRC_MASK] := '*.xml';
		V_FILE.[DST_PATH] := ::[SYSTEM_PARAMS].GET('PATH', true) || '/TMP';
		V_FILE.[DST_TYPE] := true;
		V_FILE.[DST_DELETE] := false;
	elsif p_message = 'VALIDATE' then
		if p_info = 'OK' then
			V_FILE.[DST_NAME] := V_FILE.[SRC_NAME];
		end if;
	end if;
end;

execute is
	vClob		[CLOB];
	vCharSet	constant varchar2(32) := case
											when P_FILE_CP.[0] = 1 then [LOB_UTILS].C_CHARSET_WIN
											when P_FILE_CP.[0] = 2 then [LOB_UTILS].C_CHARSET_UTF8
										 end;
begin
	&lob.CreateTemporary(vClob, true);

	[LOB_UTILS].file2clob(vClob
						 ,V_FILE.[DST_PATH]
						 ,V_FILE.[DST_NAME]
						 ,vCharSet
						 );

	if P_WAY_LOAD.[0] = 1 then
		::[PSH_ETO_SVXP_REG].[PSH_LOAD_REG_CIT](vClob);
	elsif P_WAY_LOAD.[0] = 2 then
		::[PSH_ETO_SVXP_REG].[PSH_NEW_AUTO]( P_FILE_ID == null
											,P_FILE_TYPE == null
											,P_START_DATE == null
											,P_END_DATE == null
											,P_INST_ID == null
											,P_FILE_DATE == null
											,P_STATE == 1
											,P_RAW_XML == vClob
											,P_OPERATIONS == null);
	end if;
	
	&lob.FreeTemporary(vClob);
end;
end;
end;
