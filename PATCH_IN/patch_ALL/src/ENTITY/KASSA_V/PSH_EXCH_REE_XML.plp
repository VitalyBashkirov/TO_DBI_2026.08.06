class KASSA_V;

@import_plsql(true)
@name('[ПСБ] Реестр обмена валюты с указанной даты  XML')
@tag('COPIED')
static method PSH_EXCH_REE_XML is





PSH_EXCH_REE_XML (
	@name('Дата')              P_DATE in [DATE],
	@name('Прислать по почте') P_SAVE in [BOOLEAN],
	@name('Адрес')             P_POST in [STRING_250]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE := [SYSTEM]::[OP_DATE];
end if;
-- End initialization of parameters and variables
declare
pragma macro(xl,'[OOXML]::[API_XL]');
pragma macro(formula		, '&xl.Formula([1], [2], &xl.a1_r1c1([1], [2], [3]))', substitute);
xl_out		blob:= empty_blob();
vRepId		string;
font 		integer;
bord 		integer;
format_text integer;
format_num	integer;
i 			number;
vColCount 	number; -- колво колонок в отчете
vLineCount 	number; -- первая строка в Excel
vFileName 	varchar2(250); -- имя Excel-шаблона
i_USD_BUY 			number:=0; --покупка USD
i_USD_SEL 			number:=0; --продажа USD
i_EUR_BUY 			number:=0; --покупка EUR
i_EUR_SEL 			number:=0; --продажа EUR
i_EUR_USD 			number:=0; --конверсия
i_USD_EUR 			number:=0; --конверсия  обратная
i_KONV	 			number:=0; --конверсия другая
kass ref [NOTRADE]:=null;
kass_i_beg number;
rrr integer;
rrr_end integer;
fin_rez_plus varchar2(100):='=(RC[-1]-RC[-2])*RC[-4]';
fin_rez_minus varchar2(100):='=(RC[-2]-RC[-1])*RC[-4]';
kurs_USD number:=0;
kurs_EUR number:=0;


begin

  if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
		P_SAVE:=false; --true;
		--P_DATE:=to_date('01.01.2017','DD.MM.YYYY');
		for x in ::[PSH_EMAIL_RASSIL] where x.[PSH_EMAIL_COD] = 'VAL_OPERS'
			loop
			P_POST:=x.[PSH_EMAIL_ADRES];
		end loop;
							
  elsif P_MESSAGE = 'VALIDATE' then -- переход между полями

		if p_info = 'OK' then
		
  			if P_DATE is null then
  				pragma error('Дата обязательно для заполнения!');
  			end if;

  			vFileName := 'PSH_VAL_EXH';
  			
			[SHABLON_DOC]::[LIB_OOXML].load_blob(vFileName,xl_out);
 			If not [OOXML]::[API_XL].open_file(xl_out) Then				
				pragma error('Ошибка преобразования шаблона !');
			End If;  			  			  	

-->>>>>>> Работаем с Ексель
				font:=&xl.get_font(	p_name		== 'Times New Roman',p_fontsize	== 10);
				bord:=&xl.get_border( p_top		== &xl.xl_b_thin, p_bottom	== &xl.xl_b_thin, p_left	== &xl.xl_b_thin, p_right	== &xl.xl_b_thin);
				format_text:=&xl.get_numFmt('@');
				format_num:=&xl.get_numFmt('###,###,###,###,##0.00');	

				vColCount := 37; -- всего колонок в отчете
				vLineCount := 4; -- первая строка в Excel
				i:=vLineCount;
				-- обнуляем переменные

--				&xl.set_column(1,p_fontId==font,p_horizontal==&xl.xl_ah_right,p_vertical==&xl.xl_av_top);
--				&xl.set_column(2,p_fontId==font,p_horizontal==&xl.xl_ah_right,p_vertical==&xl.xl_av_top);
				
--				&xl.set_column(8,p_numFmtId==format_num,p_fontId==font,p_horizontal==&xl.xl_ah_right,p_vertical==&xl.xl_av_top);
--				&xl.set_column_width(120,11,11);

				-- цикл по договорам
rrr:=0;				
rrr_end:=trunc(sysdate)-trunc(P_DATE)+1;			
while rrr<rrr_end loop

				&xl.Put(i, 1, to_char(P_DATE,'DD.MM.YYYY'));
				for arh_val in ::[KASSA_V] where trunc(arh_val.[DATE])=P_DATE and arh_val.[KOD_OPER].[KOD_OPER] in ('SEL_OP','BUY_OP','CON_OP')
												and arh_val%state!='DELETED'
											order by arh_val.[DEPART],arh_val.[NUM_POINT],arh_val.[DATE]
				loop
				&xl.Set_Format_Range(i,2,i,vColCount,p_numFmtId==format_num,p_horizontal==&xl.xl_ah_right);

				-- вывод в Ексель
				&xl.Put(i, 1, to_char(P_DATE,'DD.MM.YYYY'));
				--&xl.Put(i, 1, to_char(arh_val.[DATE],'DD.MM.YYYY HH24:MI:SS'));
								
				if arh_val.[NUM_POINT]=kass then null;
				else --&xl.Put(i, 2, arh_val.[NUM_POINT].[ADDRESS],false,false,11,'Times New Roman','LT');
					 --[EXCEL].merge(kass_i_beg,2,i-1,2);
					 kass_i_beg=i_USD_BUY=i_USD_SEL=i_EUR_BUY=i_EUR_SEL=i_EUR_USD=i_USD_EUR=i_KONV:=i;
				end if;
				
				&xl.Put(i, 2, arh_val.[NUM_POINT].[ADDRESS]);
				&xl.Set_Format_Range(i,3,i,vColCount,p_numFmtId==format_num,p_horizontal==&xl.xl_ah_right);
				kurs_USD:=::[DOCUMENT].[LIB_CUR].get_rate(43379,P_DATE);
				kurs_EUR:=::[DOCUMENT].[LIB_CUR].get_rate(43387,P_DATE);
				
				if arh_val.[KOD_OPER].[KOD_OPER]='BUY_OP' and arh_val.[REQ_INPUT].[CURRENCY].[CUR_SHORT]='USD'
						then 	&xl.Put(i_USD_BUY, 3, arh_val.[REQ_INPUT].[AMOUNT]);
								&xl.Put(i_USD_BUY, 4, arh_val.[REQ_OUTPUT].[AMOUNT]);
								&xl.Put(i_USD_BUY, 5, arh_val.[RATE]);

							  --Башкиров В.Г. 19.04.2019 По письму Черноусова Н.В. от 19.04.2019 "доработка отчета"
							  --&xl.Put(i_USD_BUY, 6,::[DOCUMENT].[LIB_CUR].get_rate(arh_val.[REQ_INPUT].[CURRENCY],P_DATE));
								&xl.Put(i_USD_BUY, 6,kurs_USD); --USD
								&xl.Put(i_USD_BUY,11,kurs_USD); --USD
								&xl.Put(i_USD_BUY,16,kurs_EUR); --EUR
								&xl.Put(i_USD_BUY,21,kurs_EUR); --EUR
								&xl.Put(i_USD_BUY,26,round(kurs_EUR/kurs_USD,4)); --EUR/USD
								&xl.Put(i_USD_BUY,31,round(kurs_USD/kurs_EUR,4)); --USD/EUR
								
								&formula(i_USD_BUY,7,fin_rez_plus);
								i_USD_BUY:=i_USD_BUY+1;
				elsif arh_val.[KOD_OPER].[KOD_OPER]='SEL_OP' and arh_val.[REQ_OUTPUT].[CURRENCY].[CUR_SHORT]='USD'
						then 	&xl.Put(i_USD_SEL, 8, arh_val.[REQ_OUTPUT].[AMOUNT]);
								&xl.Put(i_USD_SEL, 9, arh_val.[REQ_INPUT].[AMOUNT]);
								&xl.Put(i_USD_SEL, 10, arh_val.[RATE]);

							  --Башкиров В.Г. 19.04.2019 По письму Черноусова Н.В. от 19.04.2019 "доработка отчета"
							  --&xl.Put(i_USD_SEL, 11,::[DOCUMENT].[LIB_CUR].get_rate(arh_val.[REQ_OUTPUT].[CURRENCY],P_DATE));
								&xl.Put(i_USD_SEL, 6,kurs_USD); --USD
								&xl.Put(i_USD_SEL,11,kurs_USD); --USD
								&xl.Put(i_USD_SEL,16,kurs_EUR); --EUR
								&xl.Put(i_USD_SEL,21,kurs_EUR); --EUR
								&xl.Put(i_USD_SEL,26,round(kurs_EUR/kurs_USD,4)); --EUR/USD
								&xl.Put(i_USD_SEL,31,round(kurs_USD/kurs_EUR,4)); --USD/EUR
								
								&formula(i_USD_SEL,12,fin_rez_minus);
								i_USD_SEL:=i_USD_SEL+1;
				elsif arh_val.[KOD_OPER].[KOD_OPER]='BUY_OP' and arh_val.[REQ_INPUT].[CURRENCY].[CUR_SHORT]='EUR'
						then 	&xl.Put(i_EUR_BUY, 13, arh_val.[REQ_INPUT].[AMOUNT]);
								&xl.Put(i_EUR_BUY, 14, arh_val.[REQ_OUTPUT].[AMOUNT]);
								&xl.Put(i_EUR_BUY, 15, arh_val.[RATE]);

							  --Башкиров В.Г. 19.04.2019 По письму Черноусова Н.В. от 19.04.2019 "доработка отчета"
							  --&xl.Put(i_EUR_BUY, 16,::[DOCUMENT].[LIB_CUR].get_rate(arh_val.[REQ_INPUT].[CURRENCY],P_DATE));
								&xl.Put(i_EUR_BUY, 6,kurs_USD); --USD
								&xl.Put(i_EUR_BUY,11,kurs_USD); --USD
								&xl.Put(i_EUR_BUY,16,kurs_EUR); --EUR
								&xl.Put(i_EUR_BUY,21,kurs_EUR); --EUR
								&xl.Put(i_EUR_BUY,26,round(kurs_EUR/kurs_USD,4)); --EUR/USD
								&xl.Put(i_EUR_BUY,31,round(kurs_USD/kurs_EUR,4)); --USD/EUR
								
								&formula(i_EUR_BUY,17,fin_rez_plus);
								i_EUR_BUY:=i_EUR_BUY+1;
				elsif arh_val.[KOD_OPER].[KOD_OPER]='SEL_OP' and arh_val.[REQ_OUTPUT].[CURRENCY].[CUR_SHORT]='EUR'
						then 	&xl.Put(i_EUR_SEL, 18, arh_val.[REQ_OUTPUT].[AMOUNT]);
								&xl.Put(i_EUR_SEL, 19, arh_val.[REQ_INPUT].[AMOUNT]);
								&xl.Put(i_EUR_SEL, 20, arh_val.[RATE]);

							  --Башкиров В.Г. 19.04.2019 По письму Черноусова Н.В. от 19.04.2019 "доработка отчета"
							  --&xl.Put(i_EUR_SEL, 21,::[DOCUMENT].[LIB_CUR].get_rate(arh_val.[REQ_OUTPUT].[CURRENCY],P_DATE));
								&xl.Put(i_EUR_SEL, 6,kurs_USD); --USD
								&xl.Put(i_EUR_SEL,11,kurs_USD); --USD
								&xl.Put(i_EUR_SEL,16,kurs_EUR); --EUR
								&xl.Put(i_EUR_SEL,21,kurs_EUR); --EUR
								&xl.Put(i_EUR_SEL,26,round(kurs_EUR/kurs_USD,4)); --EUR/USD
								&xl.Put(i_EUR_SEL,31,round(kurs_USD/kurs_EUR,4)); --USD/EUR
								
								&formula(i_EUR_SEL,22,fin_rez_minus);
								i_EUR_SEL:=i_EUR_SEL+1;
				elsif arh_val.[KOD_OPER].[KOD_OPER]='CON_OP' and arh_val.[REQ_INPUT].[CURRENCY].[CUR_SHORT]='EUR' and arh_val.[REQ_OUTPUT].[CURRENCY].[CUR_SHORT]='USD'
						then 	&xl.Put(i_EUR_USD, 24, arh_val.[REQ_OUTPUT].[AMOUNT]);
								&xl.Put(i_EUR_USD, 23, arh_val.[REQ_INPUT].[AMOUNT]);
								&xl.Put(i_EUR_USD, 25, arh_val.[RATE]);

							  --Башкиров В.Г. 19.04.2019 По письму Черноусова Н.В. от 19.04.2019 "доработка отчета"
							  --&xl.Put(i_EUR_USD, 26,round(kurs_EUR/kurs_USD,4));
								&xl.Put(i_EUR_USD,  6,kurs_USD); --USD
								&xl.Put(i_EUR_USD, 11,kurs_USD); --USD
								&xl.Put(i_EUR_USD, 16,kurs_EUR); --EUR
								&xl.Put(i_EUR_USD, 21,kurs_EUR); --EUR
								&xl.Put(i_EUR_USD, 26,round(kurs_EUR/kurs_USD,4)); --EUR/USD
								&xl.Put(i_EUR_USD, 31,round(kurs_USD/kurs_EUR,4)); --USD/EUR
								
								--&formula(i_EUR_USD,27,fin_rez_plus*kurs_USD);
								&xl.Put(i_EUR_USD, 27,(kurs_EUR/kurs_USD - arh_val.[RATE])*arh_val.[REQ_INPUT].[AMOUNT]*kurs_USD );
								i_EUR_USD:=i_EUR_USD+1;	
				elsif arh_val.[KOD_OPER].[KOD_OPER]='CON_OP' and arh_val.[REQ_INPUT].[CURRENCY].[CUR_SHORT]='USD' and arh_val.[REQ_OUTPUT].[CURRENCY].[CUR_SHORT]='EUR'
						then 	&xl.Put(i_USD_EUR, 28, arh_val.[REQ_INPUT].[AMOUNT]);
								&xl.Put(i_USD_EUR, 29, arh_val.[REQ_OUTPUT].[AMOUNT]);
								&xl.Put(i_USD_EUR, 30, arh_val.[RATE]);

							  --Башкиров В.Г. 19.04.2019 По письму Черноусова Н.В. от 19.04.2019 "доработка отчета"
							  --&xl.Put(i_USD_EUR, 31,round(kurs_USD/kurs_EUR,4));
								&xl.Put(i_USD_EUR,  6,kurs_USD); --USD
								&xl.Put(i_USD_EUR, 11,kurs_USD); --USD
								&xl.Put(i_USD_EUR, 16,kurs_EUR); --EUR
								&xl.Put(i_USD_EUR, 21,kurs_EUR); --EUR
								&xl.Put(i_USD_EUR, 26,round(kurs_EUR/kurs_USD,4)); --EUR/USD
								&xl.Put(i_USD_EUR, 31,round(kurs_USD/kurs_EUR,4)); --USD/EUR
								
								--&formula(i_USD_EUR,32,fin_rez_plus*kurs_EUR);
								&xl.Put(i_USD_EUR, 32,(kurs_USD/kurs_EUR - arh_val.[RATE])*arh_val.[REQ_INPUT].[AMOUNT]*kurs_EUR);
								i_USD_EUR:=i_USD_EUR+1;
				elsif arh_val.[KOD_OPER].[KOD_OPER]='CON_OP' and 	(
																		(arh_val.[REQ_INPUT].[CURRENCY].[CUR_SHORT]!='EUR' and arh_val.[REQ_OUTPUT].[CURRENCY].[CUR_SHORT]!='USD')
																	or 	(arh_val.[REQ_INPUT].[CURRENCY].[CUR_SHORT]!='USD' and arh_val.[REQ_OUTPUT].[CURRENCY].[CUR_SHORT]!='EUR')
																	)
						then 	&xl.Put(i_KONV, 33, arh_val.[REQ_OUTPUT].[AMOUNT]);
								&xl.Put(i_KONV, 34, arh_val.[REQ_OUTPUT].[CURRENCY].[CUR_SHORT]);
								&xl.Put(i_KONV, 35, arh_val.[REQ_INPUT].[AMOUNT]);
								&xl.Put(i_KONV, 36, arh_val.[REQ_INPUT].[CURRENCY].[CUR_SHORT]);
								&xl.Put(i_KONV, 37, arh_val.[RATE]);
								i_KONV:=i_KONV+1;
				end if;
				
				kass:=arh_val.[NUM_POINT];
				i:=GREATEST(i_USD_BUY,i_USD_SEL,i_EUR_BUY,i_EUR_SEL,i_EUR_USD,i_USD_EUR,i_KONV);
				
				end loop;
				
P_DATE:=P_DATE+1;
rrr:=rrr+1;	
i:=i+1;
kass:=null;	
kass_i_beg:=i;	
vLineCount:=i;	
end loop;

--<<<<<<<
				
				font:=&xl.get_font(	p_name		== 'Times New Roman',p_fontsize	== 6);
				&xl.set_row(i+2,p_fontId==font,p_horizontal==&xl.xl_ah_right,p_vertical==&xl.xl_av_top);
				&xl.Put(i+2, 1,'дата создания отчёта '||to_char(sysdate,'DD.MM.YYYY HH24:MI:SS'));	
						&xl.set_orientation(p_orientation==1);	
						&xl.set_PaperSize(10);
						&xl.fit_in_page_width;
						&xl.finish(xl_out);	


				if P_SAVE then 	--[EXCEL].cmd('xls.Application.DisplayAlerts = False');
										[OOXML]::[API_ORSA].putReport2SaveAs
																			( p_blob		== xl_out
																			, p_extention	== 'xlsx'
																			, p_file_name	== to_char(P_DATE-1,'YYYYMMDD')
																			, p_file_path	== 'I:\PSH\exchange'
																			, p_description	== 'Валютообменные операции ПСБ'
																			);
				else
						vRepId	:= [OOXML]::[API_ORSA].putReport2Run(xl_out,'xlsx','Выписку сформировал:'||STDLIB.USERID.NAME);
				end if;
			
	
			-- Отправка файла отчёта пользователю на клиентскую машину
			

		end if;	
  end if;
end;
end;

execute is
begin
if P_SAVE then
[PSH_SMTP_MAIL].SendMail( -- updated CHANGE_SHORT_NAME SMTP_MAIL->PSH_SMTP_MAIL 15/10/25
					  P_POST		-- Кому (E-Mail) Можно указать несколько адресов разделенных "точкой с запятой"
					, 'Обмен наличной валюты'						-- Тема	
					, 'Обмен наличной валюты по '||to_char(P_DATE-1,'DD.MM.YYYY')||CHR(13)
						||'дата создания отчёта '||to_char(sysdate,'DD.MM.YYYY HH24:MI:SS')			 				-- Сообщение
					, 'IT@pshb.ru'					-- от кого (E-Mail, если пусто, то используется значение DEFAULT_FROM_EMAIL)
					, './PSH/exchange' --/* Путь до файла (в FIO). */
					, to_char(P_DATE-1,'YYYYMMDD')||'.xlsx' -- /* Имя файла. */
					, false							-- если TRUE, то вылетит ERROR_ON_SEND
					);
end if;
end;
end;
end;
