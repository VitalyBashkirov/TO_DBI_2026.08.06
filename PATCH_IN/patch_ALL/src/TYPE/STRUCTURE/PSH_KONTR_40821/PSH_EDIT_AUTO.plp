class PSH_KONTR_40821;

@import_plsql(true)
@name('[ПСБ] Изменить')
@tag('CREATED')
method PSH_EDIT_AUTO is

--Проверка на существование контрагента
public function contr_exists(
		P_RECEIVER 	[REQ_CLIENT],
		P_PAYER_ACC	ref [AC_FIN]
	)return boolean is 
	cnt number := 0;
begin
	if P_RECEIVER.[0] = 1 then
		select x(case when exists(
			select ob(1)
			in ::[PSH_KONTR_40821] -- updated CHANGE_QUALIFIER PSB_KONTR_40821->PSH_KONTR_40821 09/10/25
			where ob.[AC_40821] = P_PAYER_ACC
				and ob.[RECEIVER].[1].[2].[MAIN_V_ID] = P_RECEIVER.[1].[2].[MAIN_V_ID]
				and ob.[RECEIVER].[1].[1].[INN] =  P_RECEIVER.[1].[1].[INN]
			) then 1 else 0 end)
			in dual%rowtype
			into cnt;
	else
		select x(case when exists(
			select ob(1)
			in ::[PSH_KONTR_40821] -- updated CHANGE_QUALIFIER PSB_KONTR_40821->PSH_KONTR_40821 09/10/25
			where ob.[AC_40821] = P_PAYER_ACC
				and ob.[RECEIVER].[2].[1] = P_RECEIVER.[2].[1]
				and coalesce(ob.[RECEIVER].[2].[INN], '0') = coalesce(P_RECEIVER.[2].[INN], '0')
			) then 1 else 0 end)
			in dual%rowtype
			into cnt;
	end if;
	
	if cnt > 0 then
		return true;
	end if;
	
	return false;
end;
PSH_EDIT_AUTO (
	@name('Номер счета 40821') P_AC_40821 in [AC_FIN_REF],
	@name('Получатель')        P_RECEIVER in [REQ_CLIENT]
) is

validate is
begin
	if p_message = 'DEFAULT' then
		P_AC_40821 := this.[AC_40821];
		P_RECEIVER := this.[RECEIVER];
	elsif P_MESSAGE = 'VALIDATE' then
		if p_info = 'P_RECEIVER.0' then
			if P_RECEIVER.[0] = 1 then
				P_RECEIVER.[2].[1] := null;
				P_RECEIVER.[2].[INN] := null;
				P_RECEIVER.[2].[2] := null;
			elsif P_RECEIVER.[0] = 2 then
				P_RECEIVER.[1].[1] := null;
				P_RECEIVER.[1].[2] := null;
			end if;
		elsif p_info = 'P_RECEIVER.1.2' then
			P_RECEIVER.[1].[1] := P_RECEIVER.[1].[2].[CLIENT_V];
		elsif p_info = 'P_RECEIVER.2.1' and not(regexp_like(P_RECEIVER.[2].[1], '^\d{20}$')) then 
			pragma error('В поле "Счет" необходимо ввести только 20 цифр!');
		elsif p_info = 'P_RECEIVER.2.INN' and not(regexp_like(P_RECEIVER.[2].[INN], '^\d{10}$') or regexp_like(P_RECEIVER.[2].[INN], '^\d{12}$')) then 
			pragma error('В поле "ИНН" необходимо ввести только 10 или 12 цифр!');
		end if;
	end if;
end;

execute is
begin
	if P_AC_40821 is null
	 or (P_RECEIVER.[0] = 1 and P_RECEIVER.[1].[2] is null)
	 or (P_RECEIVER.[0] = 2 and (P_RECEIVER.[2].[1] is null or P_RECEIVER.[2].[2] is null))
	then
		pragma error('Необходимо заполнить все поля на форме!');
	end if;

	if contr_exists(P_RECEIVER, P_AC_40821) then
		pragma error('Запись с такими же реквизитами уже имеется в справочнике');
	end if;

	-- Установка значения реквизита "Номер счета 40821"
	[AC_40821] := P_AC_40821;
	-- Реквизиты получателя
	[RECEIVER] := P_RECEIVER;
	-- Пользователь
	[USER]	   := stdlib.user_id;
	-- Дата изменения
	[DATE_CH]  :=  sysdate;
end;
end;
end;
