							and (dd.[DATE] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or dd.[DATE] is null)
							and (dd.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or dd.[DATE_END] is null)
				loop
					P_DATA := dd.[TYPE].[NAME]||' '||dd.[SER]||' '||dd.[NUM]||' '||nvl(to_char(dd.[DATE],'dd.mm.yyyy'), '')||' '||dd.[WHO]||' '||dd.[DEPART_CODE]||NL$;
					
				end loop;			
							
			elsif p_info = 'БЕН_ВЛАД_2023'	then
