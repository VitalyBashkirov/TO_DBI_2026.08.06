--   plplus_materials_note: Это стандартный синтаксис PL+ для работы с реквизитами.
--   search_prompt: Найти обращения к реквизитам без [].
--   code_example_bad: v_ref.attribute;
--   fix_instruction: Добавить [] вокруг имени реквизита.
-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_WRONG_ATTR_p_4_13 IS
    v_ref REF [CLIENT];
    v_name VARCHAR2(100);
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.WRONG_ATTR_SYNTAX.п.4.13 Обращение к реквизиту должно быть в формате [ATTRIBUTE_NAME] =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- v_name := v_ref.name;
        
        -- [+] ПРАВИЛЬНО
        v_name := v_ref.[NAME];
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;

-- ============================================================================
-- Правило: v5.STYLE.WRONG_METHOD_SYNTAX.п.4.14
-- Описание: Обращение к методу должно быть в формате ::[CLASS_NAME].[METHOD_NAME]
-- Категория: STYLE
-- Приоритет: high
-- Теги: method, syntax
-- 3.RUBRICATOR_FIXES.md: Обращение к методу должно быть в формате ::[CLASS_NAME].[METHOD_NAME]
-- 4.RUBRICATOR_PROMPTS.json:
--   documentation_text: Все обращения к методам должны использовать синтаксис ::[CLASS_NAME].[METHOD_NAME].
--   plplus_materials_note: Это стандартный синтаксис PL+ для вызова методов.
--   search_prompt: Найти обращения к методам без ::[].[].
--   code_example_bad: method_name(params);
--   code_example_bad2: [CLASS].method_name(params);
--   fix_instruction: Использовать формат ::[CLASS_NAME].[METHOD_NAME](params).
-- ============================================================================
PUBLIC PROCEDURE v5_STYLE_WRONG_METHOD_p_4_14 IS
    v_result VARCHAR2(100);
BEGIN
    BEGIN
        savepoint sp1;
        debug_pipe('-= v5.STYLE.WRONG_METHOD_SYNTAX.п.4.14 Обращение к методу должно быть в формате ::[CLASS_NAME].[METHOD_NAME] =-', 0);
        
        -- [-] НЕПРАВИЛЬНО
        -- v_result := get_user_name(1);
        -- v_result := [CLIENT].get_name(1);
        
        -- [+] ПРАВИЛЬНО
        v_result := ::[CLIENT].[GET_NAME](1);
        
        RAISE; -- прерываем, чтобы случайно не внести изменения на схему
    EXCEPTION WHEN OTHERS THEN
        debug_pipe(substr(utils.error_stack, 1, 4000), 0);
        ROLLBACK TO sp1;
    END;
END;

