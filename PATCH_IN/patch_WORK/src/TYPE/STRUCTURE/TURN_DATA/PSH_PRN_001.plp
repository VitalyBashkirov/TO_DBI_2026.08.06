class TURN_DATA;

@name('[ПСБ] Печать с добавлением ИНН.ОГРН,ОКАТО')
@tag('COPIED')
library PSH_PRN_001 is
pragma include(::[REPS_DATA].[LIB_FIX]);
pragma include(::[REPS_DATA].[LIB_DEBUG]);
pragma include(::[FT_MONEY].[NAT_CUR]);
pragma macro(lp, '::[REPS_DATA].[LIB_PRINT]');
pragma macro(xl, '::[OOXML].[API_XL]');

type arr_int is table of integer index by binary_integer;
aStack	arr_int;

type map_str is table of varchar2(64) index by varchar2(64);

type rec_aggregate_data is record(
	f_active		::[TURN_DATA].[PSH_LIB_INN_REGN].rec_saldo -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
,	f_passive		::[TURN_DATA].[PSH_LIB_INN_REGN].rec_saldo -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
,	f_turn			::[TURN_DATA].[PSH_LIB_INN_REGN].rec_turn -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
,	f_curr			map_str
,	f_count			integer := 0
);
lrecAggrDataNull	rec_aggregate_data;	--	Используется для инициализации переменных этого же типа, так как выражение rec := null сбрасывает и умолчательные значения тоже

lrecAggrData0	rec_aggregate_data;
lrecAggrData1	rec_aggregate_data;
lrecAggrData2	rec_aggregate_data;
lrecAggrData3	rec_aggregate_data;
lrecAggrData4	rec_aggregate_data;
lrecAggrData5	rec_aggregate_data;
lrecAggrData6	rec_aggregate_data;
lvTotal			varchar2(10);


liBorderAll		integer;	--	Границы: все
liFontNorm		integer;	--	Шрифт нежирный
liFontBold		integer;	--	Шрифт жирный

liRow			integer;	--	счётчик выводимых строк
liTabCol		integer;	--	Кол-во колонок в таблице

liFmtSum		integer;	--	Формат числа
liFmtDate		integer;	--	Формат даты

lvPrevIdx_HeaderCache	varchar2(4000);
lrecPrevHeaderAccount	::[TURN_DATA].[PSH_LIB_INN_REGN].rec_account; -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25

lvPrevIdx_FooterCache	varchar2(4000);
lrecPrevFooterAccount	::[TURN_DATA].[PSH_LIB_INN_REGN].rec_account; -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25

lmCacheHeaderPos	map_str;

pragma macro( format_empty, '
		if not p_total_only then
			&xl.cell(liRow, 8, '''', p_borderId == liBorderAll);
			&xl.cell(liRow, 9, '''', p_borderId == liBorderAll);
			&xl.cell(liRow,10, '''', p_borderId == liBorderAll); --03.04.2019 ИНН
			&xl.cell(liRow,11, '''', p_borderId == liBorderAll); --03.04.2019 ОГРН
			&xl.cell(liRow,12, '''', p_borderId == liBorderAll); --28.03.2024 ОКАТО
		end if
	  '
);


/**	Процедура размещения числа
  */
procedure put_num(	p_row		integer
				,	p_col		integer
				,	p_num		number
				,	p_font		integer
) is
begin
	&xl.cell
		( P_ROW, P_COL, P_NUM
		, p_numFmtId	== liFmtSum
		, p_fontId		== p_font
		, p_borderId	== liBorderAll
		, p_horizontal	== &xl.xl_ah_right
		);
end;


/**	Функция возвращает сумму, если она отрицательна (активна)
  */
function GetActiveSum(p_sum number) return number is
begin
	if p_sum < 0 then
		return -p_sum;
	end if;

	return 0;
end;


/**	Функция возвращает сумму, если она положительна (пассивна)
  */
function GetPassiveSum(p_sum number) return number is
begin
	if p_sum > 0 then
		return p_sum;
	end if;

	return 0;
end;


/**	Процедура отображения очередной строки данных
  */
procedure ShowRow(	p_idx			varchar2
				,	p_res_type		integer
				,	p_total_only	boolean
				,	p_wrap_name		boolean		-- Переносить текст в столбце "Наименование"
				,	p_data			::[TURN_DATA].[PSH_LIB_INN_REGN].rec_account -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
) is
	isBold		boolean;
	bCur		boolean;
	bNat		boolean;

	bIsDrawCur	boolean;
	bIsDrawNat	boolean;

	iFont		integer;		-- Текущий шрифт
begin
	&debug_output('> Процедура ShowRow: текущий индекс p_idx = {'||p_idx||'}; p_total_only = '||bool_char(p_total_only), 10);
	if p_idx is null then
		return;
	elsif p_total_only then
		return;
	end if;
	&fix.beg('o3.1');
	bCur	:= p_res_type in (1, 3, 4);		-- выводить в валюте
	bNat	:= p_res_type in (2, 4);		-- выводить в нац. покрытии

	isBold		:= false;
	bIsDrawCur	:= bCur;

	if p_res_type = 2 then
		bIsDrawNat	:= true;
	else
		----Башкиров В.Г. 19.11.2023 После наката
		--bIsDrawNat	:= bNat and not &m_CodeIso_Is_Nat('substr(p_data.v_acc_num,6,3)');
		bIsDrawNat	:= bNat and not ::[FT_MONEY].[NAT_CUR].code_iso_is_nat(p_data.f_bs.f_cur_iso);
	end if;

	liRow	:= liRow + 1;
	&debug_output('> Процедура ShowRow: счётчик строк liRow = '||liRow||' p_data.f_inn='||p_data.f_inn||' p_data.f_reg_num='||p_data.f_reg_num, 4);
	&fix.fin('o3.1');

	&fix.beg('o3.2');
	&xl.cell
		( liRow, 1, p_data.v_acc_num
		, p_fontId		== liFontNorm
		, p_borderId	== liBorderAll
		);
	&xl.cell
		( liRow, 8, to_char(p_data.d_date, 'dd/mm/yy')
		, p_numFmtId	== liFmtDate
		, p_fontId		== liFontNorm
		, p_borderId	== liBorderAll
		, p_horizontal	== &xl.xl_ah_right
		);
	&xl.cell
		( liRow, 9, p_data.v_acc_name
		, p_fontId		== liFontNorm
		, p_borderId	== liBorderAll
		, p_wrapText	== p_wrap_name
		, p_shrinkToFit	== bool_num(p_wrap_name, 1, null)
		);
	&xl.cell							--03.04.2019 ИНН	
		( liRow,10, p_data.f_inn
		, p_fontId		== liFontNorm
		, p_borderId	== liBorderAll
		);
	&xl.cell							--03.04.2019 ОГРН
		( liRow,11, p_data.f_reg_num
		, p_fontId		== liFontNorm
		, p_borderId	== liBorderAll
		);

	&xl.cell							--28.03.2024 ОКАТО
		( liRow,12, p_data.f_okato_code
		, p_fontId		== liFontNorm
		, p_borderId	== liBorderAll
		);
	&fix.fin('o3.2');


	&fix.beg('o3.1');
	if isBold then
		iFont	:= liFontBold;
	else
		iFont	:= liFontNorm;
	end if;

	&debug_output('> Процедура ShowRow: признак вывода ин.валюты isDrawCur = {'||bool_char(bIsDrawCur)||'}; признак вывода нац.валюты isDrawNat = {'||bool_char(bIsDrawNat)||'}' ,10);
	&fix.fin('o3.1');

	------------------------------------------------------------------------------[Вывод сумм]--
	&fix.beg('o3.3');
	if bIsDrawCur then
		put_num(liRow, 2, GetActiveSum(p_data.f_saldo.f_in.f_cur), iFont);
		put_num(liRow, 3, GetPassiveSum(p_data.f_saldo.f_in.f_cur), iFont);
		put_num(liRow, 4, p_data.f_turn.f_dt.f_cur, iFont);
		put_num(liRow, 5, p_data.f_turn.f_kt.f_cur, iFont);
		put_num(liRow, 6, GetActiveSum(p_data.f_saldo.f_out.f_cur), iFont);
		put_num(liRow, 7, GetPassiveSum(p_data.f_saldo.f_out.f_cur), iFont);

		if bIsDrawNat then
			liRow	:= liRow + 1;
			&xl.cell
				( liRow, 1, lpad('нац.', 25)
				, p_borderId	== liBorderAll
				, p_fontId		== iFont
				);
			&format_empty;
		end if;
	end if;
	&fix.fin('o3.3');

	&fix.beg('o3.4');
	if bIsDrawNat then
		put_num(liRow, 2, GetActiveSum(p_data.f_saldo.f_in.f_nat), iFont);
		put_num(liRow, 3, GetPassiveSum(p_data.f_saldo.f_in.f_nat), iFont);
		put_num(liRow, 4, p_data.f_turn.f_dt.f_nat, iFont);
		put_num(liRow, 5, p_data.f_turn.f_kt.f_nat, iFont);
		put_num(liRow, 6, GetActiveSum(p_data.f_saldo.f_out.f_nat), iFont);
		put_num(liRow, 7, GetPassiveSum(p_data.f_saldo.f_out.f_nat), iFont);
	end if;
	&fix.fin('o3.4');
end;


/**	Вспомогательная процедура для вывода итога по группе
  */
procedure PutFooter(	p_aggr		in out nocopy	rec_aggregate_data
					,	p_res_type					integer
					,	p_total_only				boolean
					,	p_total						varchar2
					,	p_currency					ref [FT_MONEY]
					,	p_show_every_group			boolean

) is
	bIsBold		boolean;
	bIsDrawCur	boolean;
	bIsDrawNat	boolean;
	bDrawEmpty	boolean;

	bNat		boolean;
	bCur		boolean;

	iFont		integer;		-- Текущий шрифт
	iDelRow		integer;
	vIdx		varchar2(64);
begin
	&debug_output('> Процедура PutFooter: параметр p_total = {'||p_total||'}' ,5);

	iFont	:= liFontBold;
	if p_aggr.f_count = 1 and not p_show_every_group and not p_total_only then
		&debug_output('> Процедура PutFooter: в группе 1 л/с, итог не выводится' ,5);
		return;
	end if;

	-------------------------------------------------------------------------------[итоги]--
	bDrawEmpty := false;
	bIsBold := not p_total_only;
	bCur	:= p_res_type in (1, 3, 4);		-- выводить в валюте
	bNat	:= p_res_type in (2, 4);		-- выводить в нац. покрытии

	if p_res_type = 3 then		--	выводить в указанной валюте
		liRow	:= liRow + 1;
		&debug_output('> Процедура PutFooter: вывод в указанной валюте; счётчик строк liRow = '||liRow, 4);

		bIsDrawCur	:= true;
		bIsDrawNat	:= false;
		&xl.cell
			( liRow, 1, p_total
			, p_fontId		== iFont
			, p_borderId	== liBorderAll
			);
		&format_empty;
		aStack.delete;

	elsif p_res_type = 2 then	--	в нац.покрытии
		liRow	:= liRow + 1;
		&debug_output('> Процедура PutFooter: вывод в нац.валюте; счётчик строк liRow = '||liRow, 4);
		bIsDrawCur	:= false;
		bIsDrawNat	:= true;
		&xl.cell
			( liRow, 1, p_total || ' в н.п.'
			, p_fontId		== iFont
			, p_borderId	== liBorderAll
			);
		&format_empty;
		aStack.delete;


	elsif p_aggr.f_curr.count < 2 then		-- Была только одна валюта
	--	вывод для выбора "в валюте счёта", либо "в валюте счёта и нац.покрытии"
		liRow	:= liRow + 1;
		&debug_output('> Процедура PutFooter: только одна валюта; счётчик строк liRow = '||liRow, 4);
		bIsDrawCur	:= bCur;

		&xl.cell
			( liRow, 1, p_total
			, p_fontId		== iFont
			, p_borderId	== liBorderAll
			);
		&format_empty;

		bIsDrawNat	:= (bNat and p_currency <> ::[SYSTEM].[VARIABLES].NatCur);	-- не нац.
		if bIsDrawNat then
			&xl.cell
				( liRow + 1, 1, p_total || ' в н.п.'
				, p_fontId		== iFont
				, p_borderId	== liBorderAll
				);
			&format_empty;
		end if;
		aStack.delete;

	else
	--	вывод для выбора "в валюте счёта", либо "в валюте счёта и нац.покрытии"
	--	если выводим в валюте счёта, и кол-во валют в группе больше одной, итоги по группе в валюте не выводим
		bIsDrawCur	:= false;
		bIsDrawNat	:= bNat;

		if bIsDrawNat then
			liRow	:= liRow + 1;
			&debug_output('> Процедура PutFooter: нац.покрытие; счётчик строк liRow = '||liRow, 4);
			&xl.cell
				( liRow, 1, p_total || ' в н.п.'
				, p_fontId		== iFont
				, p_borderId	== liBorderAll
				);		-- по группе
			&format_empty;
			aStack.delete;

		else
			liRow	:= liRow + 1;
			&xl.cell
				( liRow, 1, p_total
				, p_fontId		== iFont
				, p_borderId	== liBorderAll
				);		-- по группе
			&format_empty;
			bDrawEmpty := true;
			
			--	Валют - несколько (в валюте выводить не надо), вывод в нац.покрытии - не указан.
			&debug_output('> Процедура PutFooter: итоги не выводятся; счётчик строк liRow = '||liRow, 4);
			if not p_total_only then
				aStack.delete;
			end if;

			if aStack.count > 0 then
				--	смысл использования стека следующий:
  				--	если по группе был заголовок, номер строки помещается в стек.
  				--	если по этой или по дочерним группам был вывод итога, стек чистится,
  				--	так как в этом случае заголовок необходим для всех уровней.
  				--	Если вывода не было, то чистим заголовок текущей группы, удаляя из стека только запись о текущей группе.
  				--	Группа более высокого уровня будет очищена при выводе итога по группе более высокого уровня.
				iDelRow := aStack(aStack.count) + 1;
				&xl.Delete_Row(iDelRow, liRow - iDelRow + 1 );
  				&debug_output('> удаление строк от '||iDelRow||' до '|| (liRow - iDelRow + 1), 4);

				vIdx := lmCacheHeaderPos.first;
				while vIdx is not null loop
					if lmCacheHeaderPos(vIdx) >= iDelRow then
						lmCacheHeaderPos.delete(vIdx);
					end if;
					vIdx := lmCacheHeaderPos.next(vIdx);
				end loop;

				aStack.delete(aStack.count);
				liRow := iDelRow-1;
			end if;
		end if;
	end if;

	if bIsBold then
		iFont	:= liFontBold;
	else
		iFont	:= liFontNorm;
	end if;
	------------------------------------------------------------------------------[Вывод сумм]--
	if bIsDrawCur or bDrawEmpty then
		if bDrawEmpty then
			put_num(liRow, 2, ''	, iFont);
			put_num(liRow, 3, ''	, iFont);
			put_num(liRow, 4, ''	, iFont);
			put_num(liRow, 5, ''	, iFont);
			put_num(liRow, 6, ''	, iFont);
			put_num(liRow, 7, ''	, iFont);
		else
			put_num(liRow, 2, p_aggr.f_active.f_in.f_cur	, iFont);
			put_num(liRow, 3, p_aggr.f_passive.f_in.f_cur	, iFont);
			put_num(liRow, 4, p_aggr.f_turn.f_dt.f_cur		, iFont);
			put_num(liRow, 5, p_aggr.f_turn.f_kt.f_cur		, iFont);
			put_num(liRow, 6, p_aggr.f_active.f_out.f_cur	, iFont);
			put_num(liRow, 7, p_aggr.f_passive.f_out.f_cur	, iFont);
		end if;
		
		if bIsDrawNat then
			liRow	:= liRow + 1;
			&debug_output('> Процедура PutFooter: произведено увеличение счётчика выведенных строк, новое значение liRow = {'||liRow||'}' ,5);
			&xl.cell(
						liRow
					,	1
					,	p_total || ' в н.п.'
					,	p_borderId	== liBorderAll
					,	p_fontId		== iFont
			);			-- по группе
			&format_empty;
		end if;
	end if;

	if bIsDrawNat then
		put_num(liRow, 2, p_aggr.f_active.f_in.f_nat	, iFont);
		put_num(liRow, 3, p_aggr.f_passive.f_in.f_nat	, iFont);
		put_num(liRow, 4, p_aggr.f_turn.f_dt.f_nat		, iFont);
		put_num(liRow, 5, p_aggr.f_turn.f_kt.f_nat		, iFont);
		put_num(liRow, 6, p_aggr.f_active.f_out.f_nat	, iFont);
		put_num(liRow, 7, p_aggr.f_passive.f_out.f_nat	, iFont);
	end if;
end;


/**	Возвращает переформатированную строку для итоговой подписи в зависимости от выводимого итога
  */
function GrFtr( p_gr		integer
			,	p_gr_str	varchar2
) return varchar2 is
begin
	if p_gr in (2, 10) then -- Балансовый счет, Подразделение
		return lvTotal || '(' || substr(p_gr_str, 1, instr(p_gr_str, ' ') - 1) || ')';
	end if;

	if p_gr = 5 then --  Валюта
		return lvTotal || 'по (' || substr(p_gr_str, 1, instr(p_gr_str, '(') - 1) || ')';
	end if;

	return lvTotal || p_gr_str;
end;


/**	Процедура агрегации остатков по счёту в данные по итогам
  */
procedure AggrSaldo	( p_rec		in out nocopy	rec_aggregate_data
					, p_saldo 	in out nocopy	::[TURN_DATA].[PSH_LIB_INN_REGN].rec_saldo -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
					)
is
begin
	p_rec.f_active.f_in.f_cur	:=	nvl(p_rec.f_active.f_in.f_cur	, 0);
	p_rec.f_passive.f_in.f_cur	:=	nvl(p_rec.f_passive.f_in.f_cur	, 0);
	p_rec.f_active.f_out.f_cur	:=	nvl(p_rec.f_active.f_out.f_cur	, 0);
	p_rec.f_passive.f_out.f_cur	:=	nvl(p_rec.f_passive.f_out.f_cur	, 0);
	p_rec.f_active.f_in.f_nat	:=	nvl(p_rec.f_active.f_in.f_nat	, 0);
	p_rec.f_passive.f_in.f_nat	:=	nvl(p_rec.f_passive.f_in.f_nat	, 0);
	p_rec.f_active.f_out.f_nat	:=	nvl(p_rec.f_active.f_out.f_nat	, 0);
	p_rec.f_passive.f_out.f_nat	:=	nvl(p_rec.f_passive.f_out.f_nat	, 0);

	if p_saldo.f_in.f_cur < 0 then
		p_rec.f_active.f_in.f_cur	:= p_rec.f_active.f_in.f_cur	+ abs(nvl(p_saldo.f_in.f_cur, 0));
	else
		p_rec.f_passive.f_in.f_cur	:= p_rec.f_passive.f_in.f_cur	+ abs(nvl(p_saldo.f_in.f_cur, 0));
	end if;

	if p_saldo.f_in.f_nat < 0 then
		p_rec.f_active.f_in.f_nat	:= p_rec.f_active.f_in.f_nat	+ abs(nvl(p_saldo.f_in.f_nat, 0));
	else
		p_rec.f_passive.f_in.f_nat	:= p_rec.f_passive.f_in.f_nat	+ abs(nvl(p_saldo.f_in.f_nat, 0));
	end if;

	if p_saldo.f_out.f_cur < 0 then
		p_rec.f_active.f_out.f_cur	:= p_rec.f_active.f_out.f_cur	+ abs(nvl(p_saldo.f_out.f_cur, 0));
	else
		p_rec.f_passive.f_out.f_cur	:= p_rec.f_passive.f_out.f_cur	+ abs(nvl(p_saldo.f_out.f_cur, 0));
	end if;

	if p_saldo.f_out.f_nat < 0 then
		p_rec.f_active.f_out.f_nat	:= p_rec.f_active.f_out.f_nat	+ abs(nvl(p_saldo.f_out.f_nat, 0));
	else
		p_rec.f_passive.f_out.f_nat	:= p_rec.f_passive.f_out.f_nat	+ abs(nvl(p_saldo.f_out.f_nat, 0));
	end if;
end;


/**	Процедура агрегации оборотов по счёту в данные по итогам
  */
procedure AggrTurn(	p_rec	in out nocopy	rec_aggregate_data
				,	p_turn	in out nocopy	::[TURN_DATA].[PSH_LIB_INN_REGN].rec_turn ---- -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
) is
begin
	p_rec.f_turn.f_dt.f_cur := nvl(p_rec.f_turn.f_dt.f_cur,0) + nvl(p_turn.f_dt.f_cur, 0);
	p_rec.f_turn.f_dt.f_nat := nvl(p_rec.f_turn.f_dt.f_nat,0) + nvl(p_turn.f_dt.f_nat, 0);

	p_rec.f_turn.f_kt.f_cur := nvl(p_rec.f_turn.f_kt.f_cur,0) + nvl(p_turn.f_kt.f_cur, 0);
	p_rec.f_turn.f_kt.f_nat := nvl(p_rec.f_turn.f_kt.f_nat,0) + nvl(p_turn.f_kt.f_nat, 0);
end;


/**	Процедура агрегации данных по счёту в данные по итогам
  */
procedure Aggregate(	p_data	::[TURN_DATA].[PSH_LIB_INN_REGN].rec_account -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
) is
begin
	AggrSaldo(lrecAggrData0, p_data.f_saldo);
	AggrTurn(lrecAggrData0, p_data.f_turn);
	lrecAggrData0.f_curr(p_data.f_bs.f_cur%id) := p_data.f_bs.f_cur%id;
	lrecAggrData0.f_count := lrecAggrData0.f_count + 1;

	AggrSaldo(lrecAggrData1, p_data.f_saldo);
	AggrTurn(lrecAggrData1, p_data.f_turn);
	lrecAggrData1.f_curr(p_data.f_bs.f_cur%id) := p_data.f_bs.f_cur%id;
	lrecAggrData1.f_count := lrecAggrData1.f_count + 1;

	AggrSaldo(lrecAggrData2, p_data.f_saldo);
	AggrTurn(lrecAggrData2, p_data.f_turn);
	lrecAggrData2.f_curr(p_data.f_bs.f_cur%id) := p_data.f_bs.f_cur%id;
	lrecAggrData2.f_count := lrecAggrData2.f_count + 1;

	AggrSaldo(lrecAggrData3, p_data.f_saldo);
	AggrTurn(lrecAggrData3, p_data.f_turn);
	lrecAggrData3.f_curr(p_data.f_bs.f_cur%id) := p_data.f_bs.f_cur%id;
	lrecAggrData3.f_count := lrecAggrData3.f_count + 1;

	AggrSaldo(lrecAggrData4, p_data.f_saldo);
	AggrTurn(lrecAggrData4, p_data.f_turn);
	lrecAggrData4.f_curr(p_data.f_bs.f_cur%id) := p_data.f_bs.f_cur%id;
	lrecAggrData4.f_count := lrecAggrData4.f_count + 1;

	AggrSaldo(lrecAggrData5, p_data.f_saldo);
	AggrTurn(lrecAggrData5, p_data.f_turn);
	lrecAggrData5.f_curr(p_data.f_bs.f_cur%id) := p_data.f_bs.f_cur%id;
	lrecAggrData5.f_count := lrecAggrData5.f_count + 1;

	AggrSaldo(lrecAggrData6, p_data.f_saldo);
	AggrTurn(lrecAggrData6, p_data.f_turn);
	lrecAggrData6.f_curr(p_data.f_bs.f_cur%id) := p_data.f_bs.f_cur%id;
	lrecAggrData6.f_count := lrecAggrData6.f_count + 1;
end;


/**	Процедура вывода итога по группе
  */
procedure ShowFooter(	p_idx					varchar2
					,	p_res_type				integer
					,	p_total_only			boolean
					,	p_group1				integer
					,	p_group2				integer
					,	p_group_val				boolean
					,	p_cl_group				boolean
					,	p_show_every_group		boolean
					,	p_data	in out nocopy	::[TURN_DATA].[PSH_LIB_INN_REGN].rec_account -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
) is
	bIsDrawCur			boolean;
	bIsDrawNat			boolean;

	bNat				boolean;
	bCur				boolean;

	vIdx				varchar2(4000);

	bChaperChanged		boolean;
	bClientTypeChanged	boolean;
	bSectionChanged		boolean;
	bGroup1Changed		boolean;
	bGroup2Changed		boolean;
	bGroupVal			boolean;
	bShowTotal			boolean;

	bNeedShowChapter	boolean;
	bNeedShowClientType	boolean;
	bNeedShowSection	boolean;
	bNeedShowGroup1		boolean;
begin
	&debug_output('> Процедура ShowFooter: значение праметра индекса ассоциативного массива p_idx = {'||p_idx||'}' ,4);
	if lvPrevIdx_FooterCache is null then
		&debug_output('> Процедура ShowFooter: итоги ещё не подготовлены' ,4);
		--	Зашли в первый раз, итоги ещё не подготовлены
		lvPrevIdx_FooterCache	:= p_idx;
		lrecPrevFooterAccount	:= p_data;
		return;
	end if;

	vIdx := lvPrevIdx_FooterCache;

	bCur	:= p_res_type in (1, 3, 4);		-- выводить в валюте
	bNat	:= p_res_type in (2, 4);		-- выводить в нац. покрытии

	bIsDrawCur	:= bCur;

	if p_res_type = 2 then
		bIsDrawNat	:= true;
	else
		--Башкиров В.Г. 19.11.2023 После наката
		--bIsDrawNat	:= bNat and not &m_CodeIso_Is_Nat('substr(lrecPrevFooterAccount.v_acc_num,6,3)');
		bIsDrawNat	:= bNat and not ::[FT_MONEY].[NAT_CUR].code_iso_is_nat(lrecPrevFooterAccount.f_bs.f_cur_iso);
	end if;

	if p_idx is null then
		--	выводить все итоги
		bChaperChanged		:= true;
		bClientTypeChanged	:= true;
		bSectionChanged		:= true;
		bGroup1Changed		:= true;
		bGroup2Changed		:= true;
		bGroupVal			:= true;
		bShowTotal			:= true;

	else
		bChaperChanged		:= nvl(lrecPrevFooterAccount.f_bs.f_chapter_num, '#')			<>	nvl(p_data.f_bs.f_chapter_num, '#');
		bClientTypeChanged	:= nvl(bool_char(lrecPrevFooterAccount.b_cl_corp), '#')			<>	nvl(bool_char(p_data.b_cl_corp),	'#');
		bSectionChanged		:= nvl(lrecPrevFooterAccount.f_bs.f_part_name, '#')				<>	nvl(p_data.f_bs.f_part_name, '#');
		bGroup1Changed		:= nvl(lrecPrevFooterAccount.f_group1 ,'#')						<>	nvl(p_data.f_group1,	'#');
		bGroup2Changed		:= nvl(lrecPrevFooterAccount.f_group2, '#')						<>	nvl(p_data.f_group2,	'#');
		bGroupVal			:= nvl(lrecPrevFooterAccount.f_group_val, '#')					<>	nvl(p_data.f_group_val,	'#');
		bShowTotal			:= false;
	end if;

	&debug_output('> обрабатываемый индекс ассоциативного массива vIdx: {'||vIdx||'}' ,4);
	Aggregate(lrecPrevFooterAccount);

	bNeedShowChapter	:=	bChaperChanged		--	сменилась глава.
	;
	bNeedShowClientType	:=	(	bNeedShowChapter	--	будем выводить итог по главе
							or	bClientTypeChanged)	--	сменился тип клиента
						and	p_cl_group				--	отмечена группировка по физ/юр.лицам
	;
	bNeedShowSection	:=	(	bNeedShowChapter	--	будем выводить итог по главе
							or	bNeedShowClientType	--	будем выводить итог по типу клиента
							or	bSectionChanged)	--	сменился раздел
						and not p_total_only		--	вывод итогов по разделу не проводится, если выводятся только итоги
	;
	bNeedShowGroup1		:=	(	bNeedShowChapter	--	будем выводить итог по главе
							or	bNeedShowClientType	--	будем выводить итог по типу клиента
							or	bNeedShowSection	--	будем выводить итог по разделу
							or	bGroup1Changed)		--	сменилась группа 1
						and	p_group1 <> 1			--	группировка по 1-й группе проводится
	;
	-----------------------------------------------------------[Формирование итоговых надписей]--
	if p_group_val
		and (	bNeedShowChapter	--	будем выводить итог по главе
			or	bNeedShowClientType	--	будем выводить итог по типу клиента
			or	bNeedShowSection	--	будем выводить итог по разделу
			or	bNeedShowGroup1		--	будем выводить итог по группе 1
			or	bGroup1Changed
			or	bGroup2Changed
			or	bGroupVal)
	then
		&debug_output('> Вывод итога по валюте' ,4);
		PutFooter(lrecAggrData6, p_res_type, p_total_only, GrFtr( 5, lrecPrevFooterAccount.f_group_val), lrecPrevFooterAccount.f_bs.f_cur, p_show_every_group);
		--	По группе 6 заголовков не выводится.
		lrecAggrData6 := lrecAggrDataNull;
	end if;

	if		(	bNeedShowChapter	--	будем выводить итог по главе
			or	bNeedShowClientType	--	будем выводить итог по типу клиента
			or	bNeedShowSection	--	будем выводить итог по разделу
			or	bNeedShowGroup1		--	будем выводить итог по группе 1
			or	bGroup2Changed)		--	сменилась группа 2
		and	p_group2 <> 1			--	группировка по 2-й группе проводится
	then
		&debug_output('> Вывод итога по группе 2' ,4);
		PutFooter(lrecAggrData5, p_res_type, p_total_only, GrFtr( p_group2, lrecPrevFooterAccount.f_group2), lrecPrevFooterAccount.f_bs.f_cur, p_show_every_group);
		lrecAggrData5 := lrecAggrDataNull;
	end if;

	if	bNeedShowGroup1	then
		&debug_output('> Вывод итога по группе 1' ,4);
		PutFooter(lrecAggrData4, p_res_type, p_total_only, GrFtr( p_group1, lrecPrevFooterAccount.f_group1), lrecPrevFooterAccount.f_bs.f_cur, p_show_every_group);
		lrecAggrData4 := lrecAggrDataNull;
	end if;

	if	bNeedShowSection then
		&debug_output('> Вывод итога по разделу '|| lrecPrevFooterAccount.f_bs.f_part_num ,4);
		PutFooter(lrecAggrData3, p_res_type, p_total_only, GrFtr( 1, ' раздел ' || lrecPrevFooterAccount.f_bs.f_part_num), lrecPrevFooterAccount.f_bs.f_cur, p_show_every_group);
		lrecAggrData3 := lrecAggrDataNull;
	end if;

	if	bNeedShowClientType	then
		--	сменился признак юр/физ лица
		&debug_output('> Вывод итога по лицу' ,4);
		PutFooter(lrecAggrData2, p_res_type, p_total_only, GrFtr( 1, bool_char(lrecPrevFooterAccount.b_cl_corp, ' юр. лица', ' физ. лица') ), lrecPrevFooterAccount.f_bs.f_cur, p_show_every_group);
		lrecAggrData2 := lrecAggrDataNull;
	end if;

	if	bNeedShowChapter then
		&debug_output('> Вывод итога по главе' ,4);
		PutFooter(lrecAggrData1, p_res_type, p_total_only, GrFtr( 1, ' глава ' || lrecPrevFooterAccount.f_bs.f_chapter_num), lrecPrevFooterAccount.f_bs.f_cur, p_show_every_group);
		lrecAggrData1 := lrecAggrDataNull;
	end if;

	if bShowTotal then
		&debug_output('> Вывод тотального итога' ,4);
		PutFooter(lrecAggrData0, p_res_type, p_total_only, 'ВСЕГО', lrecPrevFooterAccount.f_bs.f_cur, p_show_every_group);
		lrecAggrData0 := lrecAggrDataNull;
	end if;

	lvPrevIdx_FooterCache := p_idx;
	lrecPrevFooterAccount := p_data;
end;


/**	Вспомогательная процедура для отображения заголовка группы
  */
procedure PutHeader	(	p_str		varchar2(512)
					,	p_center	boolean
) is
	vStr	varchar2(4000);
	iTmp	integer;
begin
	aStack(aStack.count + 1) := liRow;
	liRow		:= liRow + 1;
	&debug_output('> Процедура PutHeader. Счётчик строк iRow = {'||liRow||'}; параметр p_str = {'||p_str||'}'||'; p_center = {'||bool_char(p_center)||'}' ,5);
	vStr := replace(replace(P_STR,'(',' ( '),')',' ) ');

	if lmCacheHeaderPos.exists(bool_char(p_center)) then
		&fix.beg('o2.3');
		iTmp := lmCacheHeaderPos(bool_char(p_center));
		&xl.PasteSpecial(
				iTmp
			,	1
			,	iTmp
			,	liTabCol
			,	liRow
			,	1
		);
		&fix.fin('o2.3');

		&fix.beg('o2.4');
		&xl.Put(liRow, 1, vStr);
		&fix.fin('o2.4');

	else
		lmCacheHeaderPos(bool_char(p_center)) := liRow;
		&fix.beg('o2.1');
		&xl.cell(
					liRow
				,	1
				,	p_value			== vStr
				,	p_fontId		== liFontBold
				,	p_borderId		== liBorderAll
				,	p_vertical		== bool_char(P_CENTER, &xl.xl_av_center, null)
				,	p_horizontal	== bool_char(P_CENTER, &xl.xl_ah_center, null)
				,	p_wrapText		== true
				,	p_shrinkToFit	== 1
		);
		&fix.fin('o2.1');

		&fix.beg('o2.2');
		&xl.merge(
				liRow
			,	1
			,	liRow
			,	liTabCol
			,	p_top		== &xl.xl_b_thin
			,	p_bottom	== &xl.xl_b_thin
			,	p_left		== &xl.xl_b_thin
			,	p_right		== &xl.xl_b_thin
			,	p_allign	== bool_char(P_CENTER, 'CM', null)
		);
		&fix.fin('o2.2');
	end if;
end;


/**	Процедура отображения заголовка группы
  */
procedure ShowHeader(	p_idx					varchar2
					,	p_total_only			boolean
					,	p_cl_group				boolean
					,	p_name_g1 				boolean
					,	p_name_g2 				boolean
					,	p_group1				integer
					,	p_group2				integer
					,	p_data	in out nocopy	::[TURN_DATA].[PSH_LIB_INN_REGN].rec_account -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
) is
	bChaperChanged		boolean;
	bClientTypeChanged	boolean;
	bSectionChanged		boolean;
	bGroup1Changed		boolean;
	bGroup2Changed		boolean;

	bShowedChapter		boolean;
	bShowedClientType	boolean;
	bShowedSection		boolean;
	bShowedGroup1		boolean;
begin
	&debug_output('> -----------' ,5);
	&debug_output('> Процедура ShowHeader: параметр p_idx = {'||p_idx||'}' ,4);
	if p_idx is null then
		&debug_output('> Новых заголовков нет' ,4);
		return;

	elsif p_total_only and not p_name_g1 and not p_name_g2 then
		&debug_output('> выводить ничего не нужно' ,4);
		return;
	end if;

	if lvPrevIdx_HeaderCache is null then
		--	Зашли в процедуру первый раз, нужно вывести все заголовки
		bChaperChanged		:= true;
		bClientTypeChanged	:= true;
		bSectionChanged		:= true;
		bGroup1Changed		:= true;
		bGroup2Changed		:= true;
	else
		--	определяем изменившийся заголовок
		bChaperChanged		:= nvl(lrecPrevHeaderAccount.f_bs.f_chapter_num,'#')			<>	nvl(p_data.f_bs.f_chapter_num,'#');
		bClientTypeChanged	:= nvl(bool_char(lrecPrevHeaderAccount.b_cl_corp), '#')			<>	nvl(bool_char(p_data.b_cl_corp),	'#');
		bSectionChanged		:= nvl(lrecPrevHeaderAccount.f_bs.f_part_name,'#')				<>	nvl(p_data.f_bs.f_part_name,'#');
		bGroup1Changed		:= nvl(lrecPrevHeaderAccount.f_group1,'#')						<>	nvl(p_data.f_group1,	'#');
		bGroup2Changed		:= nvl(lrecPrevHeaderAccount.f_group2,'#')						<>	nvl(p_data.f_group2,	'#');
	end if;

	bShowedChapter := false;
	if		bChaperChanged		--	сменилась глава
		and not p_total_only	--	если нужно выводить только итоги, заголовок по главам не выводим
	then
		&debug_output('> сменилась глава' ,4);
		PutHeader(	'Глава ' || p_data.f_bs.f_chapter_num||'. '||p_data.f_bs.f_chapter_name
				,	true
		);
		bShowedChapter := true;
	end if;

	bShowedClientType := false;
	if		(	bShowedChapter		--	выводили заголовок по главе
			or	bClientTypeChanged)	--	сменился признак юр/физ лица
		and	p_cl_group				--	отмечена группировка по физ/юр.лицам
		and not p_total_only		--	заголовок по признакам не выводим, если нужно выводить только итоги
	then
		&debug_output('> сменился признак юр/физ лица' ,4);
		PutHeader(	bool_char(p_data.b_cl_corp, 'Юридические лица', 'Физические лица')
				,	true
		);
		bShowedClientType := true;
	end if;

	bShowedSection := false;
	if		(	bShowedChapter		--	выводили заголовок по главе
			or	bShowedClientType	--	выводили заголовок по признаку юр/физ лица
			or	bSectionChanged)	--	сменился раздел
		and not p_total_only		--	заголовок по разделам не выводим, если нужно выводить только итоги
	then
		&debug_output('> сменился раздел '||p_data.f_bs.f_part_num ,4);
		PutHeader(	'Раздел ' || p_data.f_bs.f_part_num||'. '||p_data.f_bs.f_part_name
				,	true
		);
		bShowedSection := true;
	end if;

	bShowedGroup1 := false;
	if		(	bShowedChapter		--	выводили заголовок по главе
			or	bShowedClientType	--	выводили заголовок по признаку юр/физ лица
			or	bShowedSection		--	выводили заголовок по разделу
			or	bGroup1Changed)		--	сменилась группа 1
		and p_group1 <> 1			--	группировка по 1-й группе проводится
		and (	not p_total_only	--	заголовок по группе 1 не выводим, если нужно выводить только итоги,
			or	p_name_g1)			--	если только это отдельно не отмечено
	then
		&debug_output('> сменилась группа 1' ,4);
		PutHeader(	p_data.f_group1
				,	not p_total_only
		);
		bShowedGroup1 := true;
	end if;

	if		(	bShowedChapter		--	выводили заголовок по главе
			or	bShowedClientType	--	выводили заголовок по признаку юр/физ лица
			or	bShowedSection		--	выводили заголовок по разделу
			or	bShowedGroup1		--	выводили заголовок по группе 1
			or	bGroup2Changed)		--	сменилась группа 2
		and p_group2 <> 1			--	группировка по 2-й группе проводится
		and (	not p_total_only	--	заголовок по группе 2 не выводим, если нужно выводить только итоги,
			or	p_name_g2)			--	если только это отдельно не отмечено
	then
		&debug_output('> сменилась группа 2' ,4);
		PutHeader(	p_data.f_group2
				,	not p_total_only
		);
	end if;
	
	lvPrevIdx_HeaderCache := p_idx;
	lrecPrevHeaderAccount := p_data;
end;


procedure InitData is
begin
	::[TURN_DATA].[PSH_LIB_INN_REGN].InitData; -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
	::[REPS_DATA].[LIB_DEBUG].debug_deinit;

	lmCacheHeaderPos.delete;

	liRow			:= null;
	liTabCol		:= null;
	liFontNorm		:= null;
	liFontBold		:= null;
	liBorderAll		:= null;

	lvTotal			:= null;
	liFmtSum		:= null;
	liFmtDate		:= null;
	lrecAggrData0	:= lrecAggrDataNull;
	lrecAggrData1	:= lrecAggrDataNull;
	lrecAggrData2	:= lrecAggrDataNull;
	lrecAggrData3	:= lrecAggrDataNull;
	lrecAggrData4	:= lrecAggrDataNull;
	lrecAggrData5	:= lrecAggrDataNull;
	lrecAggrData6	:= lrecAggrDataNull;

	lvPrevIdx_HeaderCache	:= null;
	lvPrevIdx_FooterCache	:= null;
	lrecPrevFooterAccount	:= null;
	lrecPrevHeaderAccount	:= null;
end;


/**	Процедура вывода данных
  */
public procedure run(	p_beg					date			--	дата начала периода расчёта
			,	p_end					date			--	дата конца периода расчёта
			,	p_branch				ref [BRANCH]	--	филиал
			,	p_bank					ref [CL_BANK]	-- 	Банк
			,	p_total_only			boolean			--	Выводить только итоги

			,	p_group1				integer			--	пользовательская группировка №1
			,	p_group2				integer			--	пользовательская группировка №2

			,	p_res_type				integer			--	Тип результата (Выбор из 4-х)
			,	p_show_thousand			boolean			--	Разделители тысяч
			,	p_wrap_name				boolean			--	Переносить текст в столбце "Наименование"
			,	p_cl_group				boolean			--	Группировать по физ/юр лицам
			,	p_name_g1				boolean			--	выводить наименование пользовательской группировки №1
			,	p_name_g2				boolean			--	выводить наименование пользовательской группировки №2
			,	p_show_every_group		boolean		--	выводить итоги по каждой группе, даже если в ней один счёт
			,	p_show_prn_date			boolean
			,	p_data	in out nocopy	::[TURN_DATA].[PSH_LIB_INN_REGN].map_accounts -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
			,	P_OUT_CUR			ref [FT_MONEY]		--	Валюта эквивалента
			,	P_ACC_GR			ref	[ANALYTIC_CODE]
			,	P_PATTERN				varchar2(4000)
			,	P_BALACC				varchar2
			,	P_GROUP_VAL				boolean
			,	P_DEPART_LIST			varchar2(4000)	-- список подразделений
			,	P_OKATO					STRING_1000		--28.03.2024 ОКАТО
			) is
	iRowHd		integer;		-- № строки Header'a таблицы
	vPageHead	varchar2(128);

	bCur		boolean;
	bNat		boolean;
	
	vIdx		varchar2(4000);

	iCol		integer;

	procedure Fmt(	p_num	number
				,	p_name	varchar2
	) is
	begin
		-- поправка OOXML
		&xl.Set_Column_Width(p_num + 0.7109375, iCol);
		&xl.cell
			( iRowHd, iCol, p_name
			, p_fontId		== liFontBold
			, p_borderId	== liBorderAll
			, p_vertical	== &xl.xl_av_center
			, p_horizontal	== &xl.xl_ah_center
			, p_wrapText	== true
			, p_shrinkToFit	== 1
			);
		iCol := iCol+1;
	end;

	procedure WriteSignature(	p_user		ref	[USER]
							,	p_parallax	integer
	) is
		vFio	varchar2(4000);
		vCasta	varchar2(4000);
	begin
		if p_user is not null then
			select u(	u.[NAME]
					,	u.[CASTA].[VALUE]
			) in	::[USER]
			where	u = p_user
			into	vFio, vCasta;
			vFio := stdlib.fio(vFio, 'Ф И.О.');
		end if;

		&xl.cell(p_parallax, 1, vCasta||' ________________ /'||vFio||'/', p_fontId == liFontNorm);
	end;

	recTmp	::[TURN_DATA].[PSH_LIB_INN_REGN].rec_account; -- updated CHANGE_SHORT_NAME SLIB_INN_REG_NUM->PSH_LIB_INN_REGN 15/10/25
begin	--	ShowData
	InitData;
	&debug_output('> стартовал вывод', 0);

	--	Инициализация OOXML
	&fix.clear(p_level == 1);
	&fix.set_name('o1', 'Инициализация');
	&fix.set_name('o2', 'вывод заголовка');
	&fix.set_name('o2.1', 'вывод заголовка. время работы функции cell');
	&fix.set_name('o2.2', 'вывод заголовка. время работы функции merge');
	&fix.set_name('o2.3', 'вывод заголовка. время работы функции paste');
	&fix.set_name('o2.4', 'вывод заголовка. время работы функции put');
	&fix.set_name('o3', 'вывод данных');
	&fix.set_name('o3.1', 'вывод данных. манипуляции');
	&fix.set_name('o3.2', 'вывод данных. общая часть');
	&fix.set_name('o3.3', 'вывод данных. валютные данные');
	&fix.set_name('o3.4', 'вывод данных. нац.валютные данные');
	&fix.set_name('o4', 'вывод итогов');
	&fix.set_name('o5', 'финал');

	&fix.beg('o1');
	&lp.xl_init;

	if p_show_thousand then
		liFmtSum := &xl.get_numFmt('#,##0.00');
	else
		liFmtSum := &xl.get_numFmt('0.00');
	end if;

	liBorderAll		:= &xl.get_border(	p_top		== &xl.xl_b_thin
									,	p_bottom	== &xl.xl_b_thin
									,	p_left		== &xl.xl_b_thin
									,	p_right		== &xl.xl_b_thin
	);
	liFontNorm		:= &xl.get_font(	p_name		== 'Calibri'
									,	p_bold		== false
	);
	liFontBold		:= &xl.get_font(	p_name		== 'Calibri'
									,	p_bold		== true
	);
	liFmtDate := &xl.get_numFmt( &xl.OraFmt2Excel('dd/mm/yy') );

	if p_total_only then
		lvTotal	:= ' ';
		liTabCol	:= 7;
	else
		liTabCol	:= 9;
		lvTotal	:= 'Итого ';
	end if;
	
	liTabCol:=liTabCol+2+1;	--03.04.2019 ИНН и ОГРН + --28.03.2024 ОКАТО
	
------------------------------------------------------------------------------------------------------------
	-- Заголовок отчета
------------------------------------------------------------------------------------------------------------
	&xl.set_orientation( p_orientation	== 1 );	-- Альбомная ориентация
	
	liRow	:= 0;
	
	if p_show_prn_date then
		liRow := liRow + 1;
		&xl.cell	-- Дата и время формирования отчета
			( liRow, 1, to_char(sysdate, 'DD-MM-RR HH24:MI')
			, p_fontId		== liFontNorm
			, p_vertical	== &xl.xl_av_center
			, p_horizontal	== &xl.xl_ah_center
			);
	end if;
	
	liRow := liRow + 1;
	&xl.cell	-- Наименование банка/филиала
		( liRow, 1, ::[REPS_DATA].[LIB_CLIENT].GetBranchInfo(p_branch, p_end + 1, P_BANK == P_BANK).f_BANK_NAME
		, p_fontId		== liFontNorm
		, p_vertical	== &xl.xl_av_center
		, p_horizontal	== &xl.xl_ah_left
		);
	
	liRow := liRow + 1;
	-- если список подразделений не пуст
	if P_DEPART_LIST is not null then
		&xl.cell	-- список подраздедений
			( liRow, 1, 'Расчет по подразделениям: '||P_DEPART_LIST
			, p_fontId		== liFontNorm
			, p_vertical	== &xl.xl_av_center
			, p_horizontal	== &xl.xl_ah_left
			);
	end if;
	
	liRow := liRow + 1;
	&xl.cell
		( liRow, 1, 'Оборотная ведомость по лицевым счетам'
		, p_fontId		== liFontBold
		, p_vertical	== &xl.xl_av_center
		, p_horizontal	== &xl.xl_ah_center
		);
	&xl.merge(	liRow
			,	1
			,	liRow
			,	liTabCol
			,	p_allign	== 'CM'
	);
	
	liRow := liRow + 1;
	if p_beg != p_end then
		&xl.cell
			( liRow, 1,  'с ' || to_char(p_beg, 'DD/MM/YYYY') || ' по ' || to_char(p_end, 'DD/MM/YYYY')
			, p_fontId		== liFontBold
			, p_vertical	== &xl.xl_av_center
			, p_horizontal	== &xl.xl_ah_center
			);
	else
		&xl.cell
			( liRow, 1, 'за ' || to_char(p_beg, 'DD/MM/YYYY')
			, p_fontId		== liFontBold
			, p_vertical	== &xl.xl_av_center
			, p_horizontal	== &xl.xl_ah_center
			);
	end if;
	&xl.merge(	liRow
			,	1
			,	liRow
			,	liTabCol
			,	p_allign	== 'CM'
	);

	case p_res_type of
		:1:	vPageHead	:= 'в валюте счета';
		:2: vPageHead	:= 'в национальном покрытии';
		:3: vPageHead	:= 'в валюте "' || P_OUT_CUR.[NAME] || '" (' || P_OUT_CUR.[CUR_SHORT] || ')';
		:4:	vPageHead	:= 'в валюте счета и в национальном покрытии';
	end;

	liRow := liRow + 1;
	&xl.cell
		( liRow, 1, vPageHead
		, p_fontId		== liFontBold
		, p_vertical	== &xl.xl_av_center
		, p_horizontal	== &xl.xl_ah_center
		);

	&xl.merge(	liRow
			,	1
			,	liRow
			,	liTabCol
			,	p_allign	== 'CM'
	);

	liRow	:= liRow + 2;
	iRowHd	:= liRow;		-- Строка заголовков столбцов

	bCur	:= p_res_type in (1, 3, 4);		-- выводить в валюте
	bNat	:= p_res_type in (2, 4);		-- выводить в нац. покрытии

	&fix.fin('o1');

	aStack.delete;
	vIdx := p_data.first;
	loop
		--	сначала выводим итоги
		&fix.beg('o4');
		if vIdx is null then
			recTmp := null;
		else
			recTmp := p_data(vIdx);
		end if;
		ShowFooter(vIdx, p_res_type, p_total_only, p_group1, p_group2, P_GROUP_VAL, p_cl_group, p_show_every_group, recTmp);
		&fix.fin('o4');
		exit when vIdx is null;
		--	выводим заголовки, если нужно
		&fix.beg('o2');
		ShowHeader(vIdx, p_total_only, p_cl_group, p_name_g1, p_name_g2, p_group1, p_group2, recTmp);
		&fix.fin('o2');
		--	выводим данные
		&fix.beg('o3');
		ShowRow(vIdx, p_res_type, p_total_only, p_wrap_name, recTmp);
		&fix.fin('o3');

		vIdx := p_data.next(vIdx);
	end loop;

	&debug_output('> ... вывод завершён.',0);
	&debug_output('> Текущее количество строк: {'||liRow||'}' ,10);

	-- вывод подписи
	&fix.beg('o5');
	WriteSignature(	::[BRANCH].[SLIB].GetBoss( nvl(P_BRANCH, ::[REPS_DATA].[LIB_CLIENT].GetHeadBranchByBank(P_BANK)) )
				,	liRow + 2
	);

	WriteSignature(	::[BRANCH].[SLIB].GetGeneralAcc( nvl(P_BRANCH, ::[REPS_DATA].[LIB_CLIENT].GetHeadBranchByBank(P_BANK)) )
				,	liRow + 4
	);

	liRow	:= liRow + 6;	-- Подписи
	-- если выбрана какая либо групировка, но не по балансовым счетам
	if (p_group1 > 2 or p_group2 > 2) and p_group1 <> 2 and p_group2 <> 2 then
		&xl.Put(liRow, 1, 'Справочно :');
		if P_BALACC is not null then
			liRow := liRow + 1;
			&xl.Put(liRow, 1, 'отчет рассчитан по балансовым счетам: ' || P_BALACC);
		end if;
		if P_PATTERN is not null then
			liRow := liRow + 1;
			&xl.Put(liRow, 1, 'отчет рассчитан по шаблону: ' || P_PATTERN);
		end if;
		if P_ACC_GR is not null then
			liRow := liRow + 1;
			&xl.Put(liRow, 1, 'отчет рассчитан по группе счетов с кодом: ' || P_ACC_GR.[CODE]);
		end if;
	end if;
--------------------------------------------------------------------------[Форматирование колонок]--

	iCol	:= 1;
	if p_total_only then
		Fmt( 14, 'Группировка');
	else
		Fmt( 20, 'Номер счета');
	end if;

	Fmt( 19, 'Вх. сальдо (Актив)'	);
	Fmt( 19, 'Вх. сальдо (Пассив)'	);
	Fmt( 19, 'Оборот по Дт'			);
	Fmt( 19, 'Оборот по Кт'			);
	Fmt( 19, 'Исх. сальдо (Актив)'	);
	Fmt( 19, 'Исх. сальдо (Пассив)'	);

	if not p_total_only then
		Fmt( 8, 'ДПД'					);
		Fmt( 25, 'Наименование счета'	);
	end if;
	
	--Башкиров В.Г. 03.04.2019 добавил ИНН и ОГРН
	Fmt( 12, 'ИНН/КИО');
	Fmt( 15, 'ОГРН');
	Fmt( 11, 'ОКАТО'); --Башкиров В.Г. 28.03.2024 добавил ОКАТО

	&xl.set_row_height(30, iRowHd);

	&debug_output('> подписи. счётчик строк liRow = '||liRow, 4);

	&xl.fit_in_page_width;

-----------------------------------------------------------------[Форматирование заголовка таблицы]--
	&debug_output('> Формирование отчета завершено. Отчет содержит строк: ' || &xl.getSheetRowCount, 0);
	
	&lp.xl_finish;
	&fix.fin('o5');
	&fix.show;
	&fix.clear;
end;

public procedure init is
begin
	null;
end;
end;
