class PSH_IBANK2;

@import_plsql(true)
@name('[ПСБ] Добавить договор')
@tag('COPIED')
constructor PSH_NEW_AUTO is

@name('constructor')                 public V_IS_NEW [BOOLEAN];
@name('Командная строка валидатора') public DEST_STR [STRING_32000];
pragma include(::[BANK_CLIENT].[LIB_MACRO]);
v_bc_type_ref ref [BC_BANK_CLIENTS];

cALLOW_DT ref [BC_RIGHTS]	:= ::[BC_RIGHTS](CODE='ALLOW_DT');
cALLOW_KT ref [BC_RIGHTS]	:= ::[BC_RIGHTS](CODE='ALLOW_KT');
cALLOW_ST ref [BC_RIGHTS]	:= ::[BC_RIGHTS](CODE='ALLOW_STATEMENT');
cALLOW_MA ref [BC_RIGHTS]	:= ::[BC_RIGHTS](CODE='ALLOW_MAIL');
cSEND_MAI ref [BC_RIGHTS]	:= ::[BC_RIGHTS](CODE='SEND_MAIL');
cCREATE_M ref [BC_RIGHTS]	:= ::[BC_RIGHTS](CODE='CREATE_MAIL');
today date;

public procedure check_rights(dbo ref [BANK_CLIENT], acc ref [AC_FIN]) is 

		procedure ch_right(oper ref [BC_RIGHTS]) is
			trg ref [BC_SIGN_RIGHTS];
		begin
			locate trg in dbo.[RIGHTS] where trg.[ACC_PROPS].[ACCOUNT] = acc and trg.[OPERATION] = oper;
		exception when no_data_found then
			trg := dbo.[RIGHTS].[NEW#AUTO](oper,&SIGN_NULL,acc,null,1);
		end;

		procedure ch_noacc(oper ref [BC_RIGHTS]) is
			trg ref [BC_SIGN_RIGHTS];
		begin
			locate trg in dbo.[RIGHTS] where trg.[OPERATION] = oper;
		exception when no_data_found then
			trg := dbo.[RIGHTS].[NEW#AUTO](oper,&SIGN_NULL,null,null,1);
		end;

begin
		ch_right(cALLOW_DT);
		ch_right(cALLOW_KT);
		ch_right(cALLOW_ST);
		ch_noacc(cALLOW_MA);
		ch_noacc(cSEND_MAI);
		ch_noacc(cCREATE_M);
end;


public procedure norm_accounts(arg ref [PSH_IBANK2]) is 
begin
	today := ::[system].[op_date];
	for rko in ::[RKO] where rko.[CLIENT] = arg.[CLIENT] and rko.[ACCOUNT].[DATE_OP] <= today and rko.[ACCOUNT].[DATE_CLOSE] is null loop
		check_rights(arg,rko.[ACCOUNT]);
		if rko%class = 'RKO_CUR' then
			if rko->(RKO_CUR)[ACC_TRANS] is not null then
				check_rights(arg,rko->(RKO_CUR)[ACC_TRANS]);
			end if;
		end if;
	end loop;
-- 14.08.14 Кокорин АС для автоматического добавления депозитных счетов ФЛ	
	if arg.[CLIENT]%class = 'CL_PRIV' then
		for depn in [DEPOSIT_PRIV] where depn.[CLIENT] = arg.[CLIENT] and depn.[ACCOUNT].[DATE_OP] <= today and depn.[ACCOUNT].[DATE_CLOSE] is null loop
			check_rights(arg,depn.[ACCOUNT]);
		end loop;
	end if;
-- Кокорин АС end-----------------	
end;
PSH_NEW_AUTO (
	@name('Клиент')                           P_CLIENT_REF in [CLIENT_REF],
	@name('Филиал')                           P_FILIAL     in [BRANCH_REF],
	@name('Номер договора')                   P_NUM_DOG    in [PRODUCT_NUM],
	@name('Идентификатор во внешней системе') P_REG_NUMBER in [STRING_40],
	@name('Дата открытия договора')           P_DATE_OPEN  in [DATE],
	@name('Блокировочное слово')              P_PASSWORD   in [NAME],
	@name('Ответственное лицо')               P_FIO_STR    in [NAME],
	@name('Телефон')                          P_PHONE_STR  in [NAME]
) return ref [PSH_IBANK2] is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_FILIAL := this.[FILIAL];
	P_NUM_DOG := this.[NUM_DOG];
	P_REG_NUMBER := this.[REG_NUMBER];
	P_DATE_OPEN := this.[DATE_OPEN];
	P_PASSWORD := this.[PASSWORD];
	P_FIO_STR := this.[FIO_STR];
	P_PHONE_STR := this.[PHONE_STR];

end if;
-- End initialization of parameters and variables
declare
	nd P_NUM_DOG%type;
	rn P_REG_NUMBER%type;
begin
	if P_MESSAGE = 'DEFAULT' then
		V_IS_NEW := this.[BC_TYPE] is NULL;
		v_bc_type_ref := ::[BC_BANK_CLIENTS]%locate(x where x.[CLASS_ID] = this%class);
		
		if P_FILIAL is NULL then
			P_FILIAL := stdlib.user_id.[FILIAL];
		end if;
		
		if V_IS_NEW then
			-- Генерация номеров
			nd := P_NUM_DOG;
			rn := this%id;--P_REG_NUMBER;
			P_NUM_DOG := nd;
			P_REG_NUMBER := nvl(P_REG_NUMBER, rn);
		end if;
	elsif P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'OK' then
			if P_CLIENT_REF is NULL then
				pragma error('Не указан клиент');
			elsif P_FILIAL is NULL then
				pragma error('Не указан филиал');
			end if;
		elsif P_INFO = 'CANCEL' then
			V_IS_NEW := NULL;
		end if;
	end if;
end;
end;

execute is
	tmp_mode [ONE_FROM_4];
begin
	if v_bc_type_ref is NULL then
		v_bc_type_ref := ::[BC_BANK_CLIENTS]([CLASS_ID] = this%class);
	end if;
	[BC_TYPE] := v_bc_type_ref;
	v_bc_type_ref := NULL;

	if P_CLIENT_REF is Null then
		pragma error('Не указан клиент!');
	end if;
	
	-- Установка значения реквизита "Клиент"
	[CLIENT] := P_CLIENT_REF;
	-- Установка значения реквизита "Филиал"
	[FILIAL] := P_FILIAL;
	-- Установка значения реквизита "Номер договора"
	if V_IS_NEW and P_NUM_DOG is NULL then
		pragma error ('Не задан номер договора!');
	end if;
	[NUM_DOG] := P_NUM_DOG;
		
	-- Установка значения реквизита "Идентификатор во внешней системе"
	[REG_NUMBER] := P_REG_NUMBER;
	
	[DATE_OPEN] := P_DATE_OPEN;
	[PASSWORD]	:= P_PASSWORD;
	[FIO_STR]	:= P_FIO_STR;
	[PHONE_STR]	:= P_PHONE_STR;
	--открытие договора
	if nvl(V_IS_NEW, false) then
		tmp_mode.[0] := 2;
		[AGR_OPEN](tmp_mode, P_DATE_OPEN, P_NUM_DOG);
	end if;
	V_IS_NEW := NULL;

	norm_accounts(this);
end;
end;
end;
