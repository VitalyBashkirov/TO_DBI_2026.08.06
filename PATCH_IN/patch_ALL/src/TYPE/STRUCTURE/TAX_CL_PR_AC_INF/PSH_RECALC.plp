class TAX_CL_PR_AC_INF;

@name('[ПСБ] Пересчитать сумму выплаченных процентов')
method PSH_RECALC is
dp number:=0;	--управление debug_pipe;
fmt string(10):='dd/mm/yyyy';
fmt24 string(22):='dd/mm/yyyy HH24:MI:SS';
PSH_RECALC is

execute is
/*********************************************************************
Назначение:

bashkirov, последнее изменение 31 Январь 2022 г.
*********************************************************************/
rDepn ref [DEPN];
sPs [SUMMA];
AccDepn ref [AC_FIN];

sPsNew [SUMMA]:=0;
oMD [MAIN_DOCUM];
oAccFinDt [AC_FIN];
oAccFinKt [AC_FIN];
AccDtrm ref [AC_FIN];	--D_TRM_INTS_LBS_ACC - Счет обязательств банка по уплате %% без нарушения сроков
dB [DATE]; --:=to_date('01/01/2022',fmt);
dE [DATE]; --:=to_date('31/12/2022',fmt)+1;

oTc             [TAX_CL_PR_AC_INF]; --Электронный обмен с налоговыми органами. Доходы по счетам
rTcpD_REQ   ref [TAX_CL_PR_D_REQ];  --Электронный обмен с налоговыми органами. Проценты. Запросы
rTcpMESS    ref [TAX_CL_PR_MESS];   --Электронный обмен с налоговыми органами. Проценты. Сообщения
rGtpr       ref [GM_TAX_PROF_REQ];  --Электронный обмен с налоговыми органами. Проценты. Сообщения о выплаченных суммах
--rTcpLink  ref [TAX_CL_PR_LINK];   --Электронный обмен с налоговыми органами. Проценты. Связь с сообщениями
rClient   ref [CLIENT];
prc_client [SUMMA];
begin
	oTc:=this;
	dB:=oTc.[DATA_REQ].[PERIOD_BEG];
	dE:=oTc.[DATA_REQ].[PERIOD_END];
	if oTc.[PROD_CODE]<>'DEPN' then
		pragma error('Операция только для [DEPN]');
	end if;
	
	/** /
	rDepn:=oTc.[PROD_ID];
	sPs:=oTc.[PROF_SUMM];
	AccDepn:=rDepn.[ACCOUNT];
	debug_pipe(Rpad(to_char(dB,fmt)||'-'||to_char(dE,fmt)||' '||oTc.[PROD_NUM],70)||AccDepn.[MAIN_V_ID]||' СуммаВП:'||Rpad(sPs,17)||' '||rDepn.[CLIENT].[NAME],dp);
	
	for am in AccDepn.[ARC_MOVE] where dB<=am.[DATE] and am.[DATE]<dE
	loop
		oMD:=am.[DOC];
		oAccFinDt:=oMD.[ACC_DT];
		oAccFinKt:=oMD.[ACC_KT];
		if oMD.[SUM_NT] is null then
			pragma error(am.[DOC]%class||'.'||am.[DOC]%id||' нет SUM_NT');
		end if;
		debug_pipe(TB$||am.[DOC]%class||'.'||am.[DOC]%id||' Проведен:'||to_char(oMd.[DATE_PROV],fmt)||' '||oAccFinDt.[MAIN_V_ID]||'-'||oAccFinKt.[MAIN_V_ID]||' '||lpad(oMD.[SUM_NT],16)||' '||oMD.[NAZN],dp);

		--- --Все проводки ДБ 47411 КТ 423, 426, 40817, 40820 необходимо просуммировать
		--- if   oAccFinDt.[MAIN_V_ID] like '47411%' and 
		--- (    oAccFinKt.[MAIN_V_ID] like '423%'
		---   or oAccFinKt.[MAIN_V_ID] like '426%'
		---   or oAccFinKt.[MAIN_V_ID] like '40817%'
		---   or oAccFinKt.[MAIN_V_ID] like '40820%')
		--- then
		--- 	sPsNew:=sPsNew+oMD.[SUM_NT];
		--- 	debug_pipe(TB$||'+'||oMD.[SUM_NT]||'='||sPsNew,dp);
		--- end if;

		--ДБ 423, 426, 47411, 40817,  40820 КТ 70601810300012440101 надо отнять
		if   oAccFinKt.[MAIN_V_ID]='70601810300012440101' and
		(    oAccFinDt.[MAIN_V_ID] like '423%'
		  or oAccFinDt.[MAIN_V_ID] like '426%'
		  or oAccFinDt.[MAIN_V_ID] like '47411%'
		  or oAccFinDt.[MAIN_V_ID] like '40817%'
		  or oAccFinDt.[MAIN_V_ID] like '40820%')
		then
			sPsNew:=sPsNew-oMD.[SUM_NT];
			debug_pipe(TB$||'-'||oMD.[SUM_NT]||'='||sPsNew,dp);
		end if;
	end loop;
	
	for ada in rDepn.[ARRAY_DOG_ACC] where ada.[NAME_ACCOUNT]=::[TIP_ACC]([COD]='D_TRM_INTS_LBS_ACC') --Счет обязательств банка по уплате %% без нарушения сроков
	loop
		AccDtrm:=ada.[ACCOUNT_DOG].[1].[2];
		exit;
	end loop;
	
	if AccDtrm is not null then
		debug_pipe(LF$||Rpad(oTc.[PROD_NUM],70)||AccDtrm.[MAIN_V_ID],dp);
		for am in AccDtrm.[ARC_MOVE] where dB<=am.[DATE] and am.[DATE]<dE
		loop
			oMD:=am.[DOC];
			oAccFinDt:=oMD.[ACC_DT];
			oAccFinKt:=oMD.[ACC_KT];
			if oMD.[SUM_NT] is null then
				pragma error(am.[DOC]%class||'.'||am.[DOC]%id||' нет SUM_NT');
			end if;
		  --debug_pipe(TB$||am.[DOC]%class||'.'||am.[DOC]%id||' '||oAccFinDt.[MAIN_V_ID]||'-'||oAccFinKt.[MAIN_V_ID],dp);
			debug_pipe(TB$||am.[DOC]%class||'.'||am.[DOC]%id||' Проведен:'||to_char(oMd.[DATE_PROV],fmt)||' '||oAccFinDt.[MAIN_V_ID]||'-'||oAccFinKt.[MAIN_V_ID]||' '||lpad(oMD.[SUM_NT],16)||' '||oMD.[NAZN],dp);
			
			--Все проводки ДБ 47411 КТ 423, 426, 40817, 40820 необходимо просуммировать
			if   oAccFinDt.[MAIN_V_ID] like '47411%' and 
			(    oAccFinKt.[MAIN_V_ID] like '423%'
			  or oAccFinKt.[MAIN_V_ID] like '426%'
			  or oAccFinKt.[MAIN_V_ID] like '40817%'
			  or oAccFinKt.[MAIN_V_ID] like '40820%')
			then
				sPsNew:=sPsNew+oMD.[SUM_NT];
				debug_pipe(TB$||'+'||oMD.[SUM_NT]||'='||sPsNew,dp);
			end if;
	
			--ДБ 423, 426, 47411, 40817,  40820 КТ 70601810300012440101 надо отнять
			if   oAccFinKt.[MAIN_V_ID]='70601810300012440101' and
			(    oAccFinDt.[MAIN_V_ID] like '423%'
			  or oAccFinDt.[MAIN_V_ID] like '426%'
			  or oAccFinDt.[MAIN_V_ID] like '47411%'
			  or oAccFinDt.[MAIN_V_ID] like '40817%'
			  or oAccFinDt.[MAIN_V_ID] like '40820%')
			then
				sPsNew:=sPsNew-oMD.[SUM_NT];
				debug_pipe(TB$||'-'||oMD.[SUM_NT]||'='||sPsNew,dp);
			end if;
		end loop;
	end if;
	/**/
	
	sPs:=oTc.[PROF_SUMM];
	sPsNew:=::[TAX_CL_PR_AC_INF].[PSH_L].PayProc(this,0); -- updated CHANGE_SHORT_NAME PSB_L->PSH_L 15/10/25
	if sPsNew is null then 
		debug_pipe('Не удалось вычислить СуммаВП(!)',dp);
	end if;
	
	if sPs<>sPsNew then
		--Электронный обмен с налоговыми органами. Доходы по счетам
		debug_pipe(TB$||TB$||'Обновляем СуммаВП:'||Rpad(sPsNew,17)||' в "Электронный обмен с налоговыми органами. Доходы по счетам"',dp);
		this.[PROF_SUMM]:=sPsNew;
	end if;	
		
	--Электронный обмен с налоговыми органами. Проценты. Запросы
	rTcpD_REQ:=oTc.[DATA_REQ]; 
	
	--Электронный обмен с налоговыми органами. Проценты. Сообщения
	rTcpMESS :=oTc.[DATA_REQ].[OUT_MESS]; --Исходящее сообщение
	
	--Считаем общую сумму Доходы по счетам Клиента
	rClient:=nvl(oTc.[CL_PROFIT].[CLIENT].[CLIENT],rDepn.[CLIENT]); --Клиент
	select f( sum(f.[PROF_SUMM]): sm)
	in ::[TAX_CL_PR_AC_INF] all
	where f.[DATA_REQ] = rTcpD_REQ and --Электронный обмен с налоговыми органами. Проценты. Запросы
		f.[CL_PROFIT].[CLIENT].[CLIENT]=rClient --Клиент
		into prc_client;	
	debug_pipe(TB$||TB$||'Общая сумма "Доходы по счетам Клиента" '||prc_client||' "Проценты. Выплаченные суммы" '|| oTc.[CL_PROFIT].[PROF_SUMM],dp);

	--Электронный обмен с налоговыми органами. Проценты. Сообщения о выплаченных суммах
	/** /
	for (select z(z%id : C_ID) in ::[GM_TAX_PROF_REQ] all 
	where z.[TAX_MESS] = rTcpMESS)
	loop
	end looр;
	/**/
	
	--Электронный обмен с налоговыми органами. Проценты. Выплаченные суммы TAX_CL_PROFIT
	if oTc.[CL_PROFIT].[PROF_SUMM]<>prc_client then
		this.[CL_PROFIT].[PROF_SUMM]:=prc_client;
		debug_pipe(TB$||TB$||'Обновляем ОбщуююСуммаВПКлиенту:'||Rpad(prc_client,17)||' в "Электронный обмен с налоговыми органами. Проценты. Выплаченные суммы"',dp);
	end if;
	
	--Электронный обмен с налоговыми органами. Проценты. Связь с сообщениями
	for tLink in ::[TAX_CL_PR_LINK] all where tLink.[TAX_PROFIT]=oTc.[CL_PROFIT] loop
		tLink.[PROF_SUMM]:=prc_client;
		debug_pipe(TB$||TB$||'Обновляем ОбщуююСуммаВПКлиенту:'||Rpad(prc_client,17)||' в "Электронный обмен с налоговыми органами. Проценты. Связь с сообщениями"',dp);
	end loop;
end;
end;
end;
