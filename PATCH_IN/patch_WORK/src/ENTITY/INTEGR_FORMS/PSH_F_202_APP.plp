class INTEGR_FORMS;

@import_plsql(true)
@this(plsql_lock:=false,assert_null:=false)
@name('[ПСБ] Ф-202 Отчет о наличном денежном обороте')
@tag('COPIED')
method PSH_F_202_APP is

@name('Филиал')                                                                            public P_BRANCH           [BRANCH_REF];
@name('Подразделение (ссылка)')                                                            public P_DEPART           [DEPART_REF];
@name('Показать все забалансовые символы')                                                 public P_ZAB_SYMB_FL      [BOOLEAN];
@name('1-я подпись')                                                                       public P_BOSS             [USER_REF];
@name('Исполнитель')                                                                       public P_USER             [USER_REF];
@name('Вид отчета')                                                                        public T_KIND             [F_202_TUNING_REF];
@name('V_DEST')                                                                            public V_DEST             [STRING_32000];
@name('Исключить нулевые строки')                                                          public P_HIDE_ZERO        [BOOLEAN];
@name('Скрыть подписи')                                                                    public P_HIDE_PODP        [BOOLEAN];
@name('Создать трэйс-файл')                                                                public V_TRACE            [BOOLEAN];
@name('Расчет по подразделению')                                                           public V_DEP_CALC         [BOOLEAN];
@name('Свод')                                                                              public V_SVOD             [BOOLEAN];
@name('Расчет свода по')                                                                   public V_SVOD_TYPE        [CASE_BETWEEN_TWO];
@name('Формировать протокол')                                                              public V_PROTOCOL         [BOOLEAN];
@name('Дата проверки для вывода')                                                          public V_DATE_CHECK       [DATE];
@name('тип экспорта')                                                                      public V_EXP_KIND         [ONE_FROM_4];
@name('Дата 1 из реализации')                                                              public V_D1               [DATE];
@name('Дата 2 из реализации')                                                              public V_D2               [DATE];
@name('Филиал из реализации')                                                              public V_BR               [BRANCH_REF];
@name('Выводить наименования символов кассы')                                              public V_KASS_NAME        [BOOLEAN];
@name('Наименование календаря')                                                            public V_CALENDAR         [NAME];
@name('Использовать журнал опердней')                                                      public V_USE_OPERDAY_JOUR [CASE_BETWEEN_TWO];
@name('Расчет 89 символа по данным первого рабочего дня, следующего за отчетным периодом') public V_89_CALC          [BOOLEAN];
@name('Отражать данные по Москве и Московской области по ОКАТО Москвы')                    public V_AGR_MO           [BOOLEAN];
@name('Файл экспорта')                                                                     public V_EXP_FILE         [FILE$LOAD];
@name('Информация о файлах расчета')                                                       public V_CALC_FILES_INFO  [NAME];
@name('Экспорт в ДЕЛЬТА')                                                                  public V_IS_XML           [BOOLEAN];

pragma include(::[REPS_DEBUG].[LIB]);
pragma macro(slib,		'::[F_202_DATA].[SLIB]'		);
pragma macro(lib_delta,	'::[REPS_DATA].[PSH_LIB_DELTA]'	); -- updated CHANGE_SHORT_NAME PSB_LIB_DELTA->PSH_LIB_DELTA 14/10/25
pragma macro(md,		'::[REPS_DATA].[MD]'		);

-- Признак регистрации приложения экспорта в ПП Дельта
lbRegXMLApp						boolean;
-- Периодичность отчета для выгрузки в ПП Дельта
lvRepPeriod						varchar2(5);
-- Вид отчета для выгрузки в ПП Дельта
lvRepKind						varchar2(128);

procedure SaveJourInfo is
begin
	::[DEFVALS].[SLIB].SaveNum(::[RUNTIME].[STDLIB].userid, &METHOD$CLASS, &METHOD$SNAME, 'V_USE_OPERDAY_JOUR', V_USE_OPERDAY_JOUR.[0]);
	::[DEFVALS].[SLIB].SaveStr(null, &METHOD$CLASS, &METHOD$SNAME, 'V_CALENDAR', V_CALENDAR);
end;

procedure GetInfo
			(
				P_PARAM	ref [REPS_PARAMS]
			)
is
begin
	if P_PARAM is not null Then
		select x
				(	x.[DATE1]
				,	x.[DATE2]
				,	x.[BRANCH]
				)
		in		::[REPS_PARAMS] all
		Where x=P_PARAM
		into V_D1, V_D2, V_BR;
	end if;
exception
	when NO_DATA_FOUND Then
		null;
end;

function getTun(v_date	date) return ref [F_202_TUNING] is
	res	ref [F_202_TUNING];
begin
	locate res in ::[F_202_TUNING] all
	where
		res.[CODE] = '0409202'
		and res.[BEG_DATE] <= v_date
		and (res.[END_DATE] is null or res.[END_DATE] >= v_date)
	order by res.[BEG_DATE] desc;
	return res;
exception
	when NO_DATA_FOUND then
		return null;
end;


-- расчет сводного отчета по уже рассчитанным реализациям
procedure calc_svod
			(
				P_PARAM	ref	[REPS_PARAMS]
			)
is
	rData ref [F_202_DATA];
begin
 	&debug_output('Очистка...' || lpad( '( id: '||to_char(P_PARAM)||' )', 41), 0);
    ::[REPS_DATA].[DELETE_DATA](P_PARAM);
	&debug_output('Очистка завершена...' || lpad( '( id: '||to_char(P_PARAM) || ' )', 31) || LF$
		||LF$||'   >>> Начало конкатенации данных...', 0);

	for (
		select x
				(
					sum(x.[SUMMA])	: C_SUMMA
				,	x.[SYMBOL_NUM]	: C_SYMBOL_NUM
				,	x.[OKATO]		: C_OKATO
				,	x.[REG_NUM]		: C_REG_NUM
				)
		in		::[F_202_DATA] all
		where
				x.[PARAM].[DATE1] = P_PARAM.[DATE1]
			and	x.[PARAM].[DATE2] = P_PARAM.[DATE2]
		group by	x.[SYMBOL_NUM]
				,	x.[U_SYMB]
				,	x.[OKATO]
				,	x.[REG_NUM]
	) loop
		rData := ::[F_202_DATA].[NEW#AUTO]
						( P_PARAM
						, x.C_SYMBOL_NUM
						, x.C_SUMMA
						, x.C_OKATO
						, x.C_REG_NUM
						);
	end loop;
	&debug_output('   <<< Завершена конкатенация данных...', 0);
end;


/**
 * Инициализация параметров экспорта
 *
 * @param	P_PARAM			-	Ссылка на реализацию
 * @param	P_INIT			-	Признак первичной инициализации
 * @param	P_CHANGE_PARAM	-	Признак смены реализации
 */
procedure InitExportParams
		(
			P_PARAM			ref	[REPS_PARAMS]
		,	P_INIT			boolean
		,	P_CHANGE_PARAM	boolean
		)
is
begin
	-- Первичная инициализация
	if P_INIT then
		V_EXP_FILE.[DST_PATH]	:= ::[REPS_DATA].[LIB_FILE].default_local_path;
		V_EXP_FILE.[DST_MASK]	:= 'Все файлы (*.*)|*.*|';
		V_EXP_KIND.[0]			:= 1;
	end if;

	-- При смене реализации необходимо обновить доступность экспорта в ПП "Дельта".
	-- Экспорт в ПП "Дельта" должен быть доступен только для указаний, начиная с 5736
	if P_CHANGE_PARAM then
		V_IS_XML	:= (lbRegXMLApp and P_PARAM.[DATE1] >= &slib.cdBeg5736U);

		-- Если экспорт в Дельта должен быть недоступен, но выбран на ЭФ, необходимо поменять вариант экспорта
		if not V_IS_XML and V_EXP_KIND.[0] = 4 then
			V_EXP_KIND.[0]	:= 1;
		end if;
	end if;

	-- Вид отчета
	lvRepKind	:= 'Основной отчет КО';

	-- Определение периодичности отчёта в зависимости от даты реализации:
	-- месячная периодичность
	if		P_PARAM.[DATE1]	= trunc(P_PARAM.[DATE2],'MM')
		and	P_PARAM.[DATE2]	= add_months(P_PARAM.[DATE1], 1) - 1
	then
		lvRepPeriod	:= 'M';

	--	в остальных случаях периодичность отчета не заполняется
	else
		lvRepPeriod	:= 'EMPTY';
	end if;

	V_EXP_FILE.[DST_NAME]	:= &lib_delta.GetExpFileNames
										(
											P_REP			==	P_PARAM.[REPORT]
										,	P_PARAM			==	P_PARAM
										,	P_EXP_METH		==	case V_EXP_KIND.[0]
																	when	1	then	'DBF'		--	DBF
																	when	2	then	'PSD'		--	ПТК ПСД
																	when	3	then	'KLIKO'		--	КЛИКО
																	when	4	then	'XML'		--	ДЕЛЬТА
																end
										,	P_PERIOD_CODE	==	lvRepPeriod
										,	P_DATE_REP		==	P_PARAM.[DATE2]
										).vOutputFileName;
end;


/**
 * Функция производит поиск реализации и возвращает ссылку на нее
 * 	если таких реализаций нет, то при необходимости создается новая реализация
 * @param	P_DATE1			- Дата с
 * @param	P_DATE2			- Дата по
 * @param	P_BRANCH		- Филиал
 * @param	P_DEPART		- Подразделение
 * @param	P_PROTOCOL		- Формировать протокол
 * @param	P_89_CALC		- Расчет 89 символа по данным первого рабочего дня, следующего за отчетным периодом
 * @param	P_USE_CALENDAR	- Использовать календарь
 * @param	P_CALENDAR		- Календарь
 * @param	P_SVOD_IMP		- Расчет свода по импорту
 * 
 * @return					- Возвращает ссылку на созданную реализацию
 */
public function GetParam
		( P_DATE1			date
		, P_DATE2			date
		, P_BRANCH		ref [BRANCH]
		, P_DEPART		ref [DEPART]
		, P_PROTOCOL		boolean
		, P_89_CALC			boolean
		, P_USE_CALENDAR	boolean
		, P_CALENDAR		varchar2(32767)
		, P_SVOD_IMP		boolean
		)
	return ref [REPS_PARAMS]
is
	vInfo			varchar2(4000);
	rParam		ref	[REPS_PARAMS];
begin
	::[RUNTIME].[STR].Set_Par(vInfo,	'P_PROTOCOL',			bool_char(nvl(P_PROTOCOL, false)));
	::[RUNTIME].[STR].Set_Par(vInfo,	'P_89_CALC',			bool_char(P_89_CALC));
	::[RUNTIME].[STR].Set_Par(vInfo,	'P_USE_CALENDAR',		bool_char(P_USE_CALENDAR));
	::[RUNTIME].[STR].Set_Par(vInfo,	'P_CALENDAR',			P_CALENDAR);
	::[RUNTIME].[STR].Set_Par(vInfo,	'P_SVOD_IMP',			bool_char(P_SVOD_IMP));

	rParam	:= ::[REPS_PARAMS].[SLIB].GetRefParam
										(	P_REPORT	== ::[REPS].[SLIB].RP('F_202')
										,	P_DATE1		== P_DATE1
										,	P_DATE2		== P_DATE2
										,	P_BRANCH	== P_BRANCH
										,	P_STROKE	== null
										,	P_DEPART	== P_DEPART
										,	P_INFO		== vInfo
										);
	-- очистка файлов и перезапись в INFO времени и пользователя расчета
	::[REPS_PARAMS].[SLIB].ClearFiles(rParam);

	return rParam;
end;


/**
 * Расчет
 * В теле процедуры недопустимо использовать переменные и параметры процедуры,
 * локальные переменные без инициализации
 * @param	P_PARAM		- ссылка на подготовленную реализацию
 */
public procedure RunCalc (P_PARAM		ref	[REPS_PARAMS])
is
	vInfo			varchar2(4000);
	dDate1			date;
	dDate2			date;
	rBranch		ref	[BRANCH];
	rDepart		ref	[DEPART];
	bProtocol		boolean;
begin
	if P_PARAM is null then
		return;
	end if;
	
	for	(	select p
				(	p.[INFO]	: C_INFO
				,	p.[DATE1]	: C_DATE1
				,	p.[DATE2]	: C_DATE2
				,	p.[BRANCH]	: C_BRANCH
				,	p.[DEPART]	: C_DEPART
				)
			in ::[REPS_PARAMS] all
			where p = P_PARAM
		)
	loop
		vInfo	:= p.C_INFO;
		dDate1	:= p.C_DATE1;
		dDate2	:= p.C_DATE2;
		rBranch	:= p.C_BRANCH;
		rDepart	:= p.C_DEPART;
	end loop;
	
	&debug_output	(	'<<< Запуск расчета...' || LF$
					||	'	Реализация id: '		||	P_PARAM%id || LF$
					||	'		филиал:'			||	case
																	when rBranch is null
																	then '(пусто)'
																	else rBranch.[CODE]
																end || LF$
					||	'		подразделение:'		||	case
																	when rDepart is null
																	then '(пусто)'
																	else rDepart.[CODE]
																end || LF$
					||	'		банк:' || LF$
					||	'		дата(1):'			|| to_char(dDate1, 'dd/mm/yyyy') || LF$
					||	'		дата(2):'			|| to_char(dDate2, 'dd/mm/yyyy') || LF$
					||	'		переменные:'		|| vInfo || LF$
					||	'		показатели:' || LF$
					||	'	Код отчета: '			|| 'F_202'
					,	0
					);

	bProtocol:= ::[RUNTIME].[STR].get_bool_par(vInfo, 'P_PROTOCOL');

	-- так как форма не поддерживает УИ, то фиксация начала расчета по 202 форме
	::[REPS_METH_USE].[LIB].AddData('F_202_CLC', P_PARAM%id);

	-- расчет свода из рассчитанных реализаций по филиалам
	if ::[RUNTIME].[STR].get_bool_par(vInfo, 'P_SVOD_IMP') then
		calc_svod(P_PARAM);
	else
		-- Инициализация debug_output, для вывода лога в файл
		::[REPS_DATA].[LIB_DEBUG].debug_init_param(P_PARAM);
		::[REPS_DATA].[LIB_DEBUG].debug_output('Вывод лога ведётся в файл '||::[REPS_DATA].[LIB_DEBUG].get_debug_file, 0);

		::[F_202_DATA].[SLIB].CALC2	(	-- реализация
										P_PARAM			== P_PARAM
									,	-- признак формирования протокола
										P_LOG			== bProtocol
									,	-- признак расчета 89 символа по данным первого рабочего дня, следующего за отчетным периодом
										P_89_CALC		== ::[RUNTIME].[STR].get_bool_par(vInfo, 'P_89_CALC')
									,	-- признак что при установленном признаке P_89_CALC используется выбранный календарь
										P_USE_CALENDAR	== ::[RUNTIME].[STR].get_bool_par(vInfo, 'P_USE_CALENDAR')
									, 	-- наименование выбранного календаря
										P_CALENDAR		== ::[RUNTIME].[STR].get_str_par(vInfo, 'P_CALENDAR')
									);
		::[RUNTIME].[UTILS].FREE_MEMORY;
	end if;

	if bProtocol then
		-- Сохранение протокола в реализацию
		debug_pipe('Сохранение протокола в реализацию.', 10);
		::[REPS_PARAMS].[SLIB].SaveProtocol(P_PARAM);
	end if;

	-- Сохранение лога в реализацию
	debug_pipe('Сохранение лога расчёта в реализацию.', 10);
	::[REPS_PARAMS].[SLIB].SaveLog(P_PARAM);

	::[RUNTIME].[STR].set_par(P_PARAM.[INFO], 'TS_CALC_STOP', to_char(sysdate, 'DD.MM.YYYY HH24:MI:SS'));
	commit;

end;
PSH_F_202_APP (
	@name('Отчет. Параметры')      P_PARAM     in [REPS_PARAMS_REF],
	@name('Телефон')               P_PHONE     in [STRING_20],
	@name('Начало периода')        P_SDATE     in [DATE],
	@name('Конец периода')         P_EDATE     in [DATE],
	@name('В тысячах')             P_THS       in [BOOLEAN],
	@name('Путь экспорта')         P_PATH      in [STRING],
	@name('Наименование операции') P_METH_NAME in [STRING]          default null
) is

validate is
	vParamStr			varchar2(2000);
	vRepCode			varchar2 := 'F_202';
	vPath				varchar2(4000);
	dDateBegin			date;
	vSourceName			varchar2;
	vInfo				::[REPS_PARAMS].[INFO]%type;
	-- процедура валидации чек-боксов на экранной форме
	procedure ValidateCheckBox
	is
	begin
		-- активация чекбокса "Отражать данные по Москве и Московской области по ОКАТО Москвы"
		-- если выбран филиал с кодом ОКАТО Москвы или Московской области.
		if	substr(::[REPS_SUBJRF].[SLIB].GetSubjectBranch(P_PARAM.[BRANCH], P_PARAM.[DATE2] + 1, P_UPPER == true).[CODE],1,2) in ('45','46')
		and	P_PARAM.[DATE1] < &slib.cdBeg5736U
		then
			V_DEST		:= V_DEST || ': AgrMO.Enabled = True';
			V_AGR_MO	:= True;
		else
			V_DEST		:= V_DEST || ': AgrMO.Enabled = False';
			V_AGR_MO	:= False;
		end if;
	end;


begin
	if P_MESSAGE = 'DEFAULT' then
		pragma include(::[REPS].[INFO]);
		P_METH_NAME				:= &mName(&METHOD$SNAME);
		P_USER					:= ::[RUNTIME].[STDLIB].userid;
		P_HIDE_ZERO				:= ::[DEFVALS].[SLIB].RestoreBool(P_USER, &METHOD$CLASS, &METHOD$SNAME, 'P_HIDE_ZERO');
		V_USE_OPERDAY_JOUR.[0]	:= nvl(::[DEFVALS].[SLIB].RestoreNum(P_USER, &METHOD$CLASS, &METHOD$SNAME, 'V_USE_OPERDAY_JOUR'),'1');
		V_CALENDAR				:= nvl(::[DEFVALS].[SLIB].RestoreStr(null, &METHOD$CLASS, &METHOD$SNAME, 'V_CALENDAR'), 'HOLIDAYS');
		V_89_CALC				:= true;
		P_THS					:= true;
		V_DEP_CALC				:= false;
		V_KASS_NAME				:= false;

		-- видимость параметра "Создать трэйс-файл", только для пользователей включенных в группу ADMIN_GRP
		if ::[REPS_DATA].[MD].CheckEqual(P_USER.[USERNAME], 'ADMIN_GRP')	= '1' then
			V_DEST		:= 'Trace.Visible = true';
		else
			V_DEST		:= 'Trace.Visible = False';
		end if;

		V_TRACE			:= false;
		V_PROTOCOL		:= false;
		V_SVOD			:= false;

		P_EDATE			:= trunc(::[SYSTEM].[OP_DATE], 'mm') - 1;
		P_SDATE			:= trunc(P_EDATE, 'mm');
		P_BRANCH		:= ::[SYSTEM].[VARIABLES].GetOurBranch;
		P_PARAM			:= ::[REPS].[SLIB].lr('F_202');

		GetInfo(P_PARAM);
		V_DATE_CHECK	:= V_D2;

		ValidateCheckBox;

		P_BOSS			:= ::[BRANCH].[SLIB].GetBoss(V_BR);

		P_PHONE			:= ::[DEFVALS].[SLIB].RestoreStr(P_USER, &METHOD$CLASS, &METHOD$SNAME, 'P_PHONE');

		T_KIND			:= getTun(V_DATE_CHECK);

		-- Определение признака регистрации приложения экспорта в ПП Дельта
		lbRegXMLApp		:= true; --::[REPS_DATA].[LIB_REG_DOP_PRIL].CheckRegPril('1B700220');

		-- Инициализация параметров экспорта
		InitExportParams
			(
				P_PARAM			== P_PARAM
			,	P_INIT			== true
			,	P_CHANGE_PARAM	== true
			);

		-- наличие файлов расчета
		V_CALC_FILES_INFO := ::[REPS_PARAMS].[SLIB].GetCalcFilesInfo(P_PARAM);

		P_INFO			:= '%VAR%.V_DEST, OK, %VAR%.P_BRANCH, %VAR%.T_KIND, %VAR%.P_DEPART, P_SDATE, %VAR%.V_DEP_CALC, %VAR%.V_TRACE';

	elsif P_MESSAGE = 'VALIDATE' then
		if P_INFO = '%VAR%.T_KIND' then
			P_EDATE	:= trunc(add_months(P_SDATE, 1), 'mm')-1;

		elsif P_INFO = '%VAR%.V_SVOD' then
			if V_SVOD then
				P_BRANCH := null;
				P_DEPART := null;
			else
				if V_DEP_CALC then
					P_DEPART := P_USER.[DEPART];
					P_BRANCH := P_DEPART.[FILIAL];
				else
					P_BRANCH := ::[SYSTEM].[VARIABLES].GetOurBranch;
				end if;
			end if;

		elsif P_INFO = '%VAR%.P_DEPART' then
			P_BRANCH := P_DEPART.[FILIAL];

		elsif P_INFO = 'P_SDATE' then
			P_EDATE := add_months(P_SDATE, 1)-1;

		elsif P_INFO = 'P_PARAM' then
			GetInfo(P_PARAM);
			V_DATE_CHECK	:= V_D2;
			T_KIND			:= getTun(V_DATE_CHECK);
			ValidateCheckBox;
			-- наличие файлов расчета
			V_CALC_FILES_INFO := ::[REPS_PARAMS].[SLIB].GetCalcFilesInfo(P_PARAM);
			-- Инициализация параметров экспорта
			InitExportParams
				(
					P_PARAM			== P_PARAM
				,	P_INIT			== false
				,	P_CHANGE_PARAM	== true
				);

		elsif P_INFO like '%V_DEP_CALC%' then
			if V_DEP_CALC then
				P_DEPART := P_USER.[DEPART];
				P_BRANCH := P_DEPART.[FILIAL];
			else
				P_DEPART := null;
				P_BRANCH := ::[SYSTEM].[VARIABLES].GetOurBranch;
			end if;

		-- Поднятие формы копирования протоколов на локальный компьютер
		elsif P_INFO = 'Выгрузить протокол' then
			&md.AsynchCall('<% PLPCALL P_PARAM.[COPY_FILES_PARAM](P_PARAM => ''' || P_PARAM%id || ''') %>');

		elsif P_INFO = 'Расчет' then
			if V_TRACE then
				::[RUNTIME].[TRACE].START_TRACE;
			end if;

			-- добавление реализации
			P_PARAM	:= GetParam
						(	P_DATE1			== P_SDATE
						,	P_DATE2			== P_EDATE
						,	P_BRANCH		== P_BRANCH
						,	P_DEPART		== P_DEPART
						,	P_PROTOCOL		== V_PROTOCOL
						,	P_89_CALC		== V_89_CALC
						,	P_USE_CALENDAR	== V_USE_OPERDAY_JOUR.[0]='2' and V_89_CALC
						,	P_CALENDAR		== V_CALENDAR
						,	P_SVOD_IMP		== V_SVOD and V_SVOD_TYPE.[0] = 2
						);

			RunCalc(P_PARAM);

			V_DATE_CHECK	:= P_EDATE;
			T_KIND			:= getTun(V_DATE_CHECK);
			if V_TRACE then
				::[RUNTIME].[TRACE].STOP_TRACE;
			end if;
			GetInfo(P_PARAM);
			SaveJourInfo;
			ValidateCheckBox;

			-- Инициализация параметров экспорта
			InitExportParams
				(
					P_PARAM			== P_PARAM
				,	P_INIT			== false
				,	P_CHANGE_PARAM	== true
				);

			-- наличие файлов расчета
			V_CALC_FILES_INFO := ::[REPS_PARAMS].[SLIB].GetCalcFilesInfo(P_PARAM);
			V_DEST := V_DEST ||  ': CheckParam';


		elsif P_INFO = 'OK' then
			::[DEFVALS].[SLIB].SaveStr(::[RUNTIME].[STDLIB].userid, &METHOD$CLASS, &METHOD$SNAME, 'P_PHONE', P_PHONE);

			if T_KIND is null then
				pragma error('Пожалуйста, выберите вид отчета.');
			end if;
			::[F_202_DATA].[SLIB2].[ClearSeans];

			dDateBegin	:= P_PARAM.[DATE1];

			-- так как форма не поддерживает УИ, то фиксация начала операции печати по 202 форме
			::[REPS_METH_USE].[LIB].AddData(vRepCode||'_PRN', P_PARAM%id);

			-- установка параметров для печати
			vInfo	:= '';
			::[RUNTIME].[STR].set_par(vInfo, 'P_FORM'	, T_KIND%id);
			::[RUNTIME].[STR].set_par(vInfo, 'P_THS'	, P_THS);
			::[RUNTIME].[STR].set_par(vInfo, 'V_PARAM'	, P_PARAM%id);	-- Реализация
			::[RUNTIME].[STR].set_par(vInfo, 'P_BOSS'	, P_BOSS%id);	-- Руководитель
			::[RUNTIME].[STR].set_par(vInfo, 'P_USER'	, P_USER%id);	-- Исполнитель
			::[RUNTIME].[STR].set_par(vInfo, 'P_PHONE'	, P_PHONE);		-- Телефон
			::[RUNTIME].[STR].set_par(vInfo, 'V_AGR_MO'	, V_AGR_MO);	-- Отражать данные по Москве и Московской области по ОКАТО Москвы
			::[RUNTIME].[STR].set_par(vInfo, 'V_KASS_NAME'	, V_KASS_NAME);	-- Выводить наименования символов кассы
			::[RUNTIME].[STR].set_par(vInfo, 'P_HIDE_ZERO'	, P_HIDE_ZERO);	-- Исключить нулевые строки
			::[RUNTIME].[STR].set_par(vInfo, 'P_HIDE_PODP'	, P_HIDE_PODP);	-- Скрыть подписи

			-- вызов операции печати
			if dDateBegin < &slib.cdBeg5736U then
				::[F_202_DATA].[PRN_001].Run(P_PARAM, vInfo);
			else
				::[F_202_DATA].[PRN_002].Run(P_PARAM, vInfo);
			end if;
		elsif P_INFO like '%V_EXP_KIND%' then
			-- Инициализация параметров экспорта
			InitExportParams
				(
					P_PARAM			== P_PARAM
				,	P_INIT			== false
				,	P_CHANGE_PARAM	== false
				);
		elsif P_INFO = 'Экспорт' then
			::[RUNTIME].[STR].set_par(vParamStr, 'P_PARAM'		, P_PARAM%id	);		-- Ссылка на реализацию
			::[RUNTIME].[STR].set_par(vParamStr, 'P_FORM'		, T_KIND%id		);		-- Вид отчета
			::[RUNTIME].[STR].set_par(vParamStr, 'P_HIDE_ZERO'	, P_HIDE_ZERO	);		-- Флаг с ЭФ "Исключить нулевые строки"
			::[RUNTIME].[STR].set_par(vParamStr, 'P_EXP_KIND'	, V_EXP_KIND.[0]);		-- Тип экспорта
			::[RUNTIME].[STR].set_par(vParamStr, 'P_BOSS'		, P_BOSS%id		);		-- Руководитель
			::[RUNTIME].[STR].set_par(vParamStr, 'P_EXECUTOR'	, P_USER%id		);		-- Исполнитель
			::[RUNTIME].[STR].set_par(vParamStr, 'P_PHONE'		, P_PHONE		);		-- Телефон исполнителя
			::[RUNTIME].[STR].set_par(vParamStr, 'P_AGR_MO'		, V_AGR_MO		);		-- Флаг с ЭФ "Отражать данные по Москве и Московской области по ОКАТО Москвы"
			::[DEFVALS].[SLIB].SaveStr(::[RUNTIME].[STDLIB].userid, &METHOD$CLASS, &METHOD$SNAME, 'P_PHONE', P_PHONE);

			-- Доп. параметры для выгрузки в ПП "Дельта"
			if V_EXP_KIND.[0] = 4 then
				::[RUNTIME].[STR].Set_Par(vParamStr, 'P_PATH',		V_EXP_FILE.[DST_PATH]);	-- Путь до файла экспорта
				::[RUNTIME].[STR].Set_Par(vParamStr, 'P_FILENAME',	V_EXP_FILE.[DST_NAME]);	-- Наименование файла экспорта
				::[RUNTIME].[STR].Set_Par
									(
										vParamStr
									,	'P_XMLNAME'
									,	&lib_delta.GetExpFileNames	(
																		P_REP			==	P_PARAM.[REPORT]
																	,	P_PARAM			==	P_PARAM
																	,	P_EXP_METH		==	'XML'
																	,	P_PERIOD_CODE	==	lvRepPeriod
																	,	P_DATE_REP		==	P_PARAM.[DATE2]
																	).vXmlFileName
									);														-- Наименование XML файла
				::[RUNTIME].[STR].Set_Par(vParamStr, 'P_OKUD',		'0409202'			);	-- ОКУД формы
				::[RUNTIME].[STR].Set_Par(vParamStr, 'P_PERIOD',	lvRepPeriod			);	-- Периодичность отчета
				::[RUNTIME].[STR].Set_Par(vParamStr, 'P_REP_KIND',	lvRepKind			);	-- Вид отчёта
			end if;

			If V_EXP_FILE.[DST_NAME] is null Then
				pragma error('Не определено имя файла!');
			Else

				vSourceName := null;
				-- Сохранение информации об экспорте для всех форматов кроме ПП "Дельта"
				if V_EXP_KIND.[0] <> 4 then
					::[REPS_METH_USE].[LIB].AddData(vRepCode||'_EXP', P_PARAM%id);
				end if;

				vPath := ::[REPS_DATA].[LIB_FILE].CorrectPath(V_EXP_FILE.[DST_PATH]||'/'||V_EXP_FILE.[DST_NAME], true);
				if not ::[HOOK].[VARS].ref_hook.[REPS_EXP_202](vParamStr, vPath, vSourceName) then
					-- хук не был прекрыт, вызываем дистрибутивный вариант экспорта
					debug_pipe('+ Выполняется дистрибутивная версия экспорта данных ОП Ф-202 в файл '||vPath,0);
					if not ::[F_202_DATA].[EXPORT].EXPORT(vParamStr, vPath, vSourceName) then
						debug_pipe('- Во время экспорта произошла ошибка.', 0);
					end if;
				end if;
			End If;
		end if;
	end if;
end;

execute is
begin
	::[DEFVALS].[SLIB].SaveBool(::[RUNTIME].[STDLIB].userid, &METHOD$CLASS, &METHOD$SNAME, 'P_HIDE_ZERO', P_HIDE_ZERO);
	::[RUNTIME].[UTILS].FREE_MEMORY;
end;
end;
end;
