-- ============================================================================
-- Правило 1: v50.SQL.OUTERJOIN.п.1.1 - Замена (+) на LEFT/RIGHT JOIN
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена (+) на LEFT/RIGHT JOIN
--   Подробное описание: В Oracle используется оператор (+) для внешнего соединения. В PostgreSQL и ANSI SQL его нет. Заменить на явные LEFT JOIN или RIGHT JOIN с условием ON.
--   Пример кода для корректировки: select * from t1, t2 where t1.id = t2.id(+)
--   Пример исправленного кода: select * from t1 left join t2 on t1.id = t2.id
--   Теги: outer join, oracle, ansi
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Oracle оператор (+) в ANSI не поддерживается. Далее нельзя использовать PLPlus параметризацию типа соединения (true/false) в where. Вместо этого нужно использовать явные left/right join on.
--   plplus_materials_note: Согласно учебному курсу (Глава 5.8), конструкция '&collection(true)' является упрощённым синтаксисом LOCATE для поиска в коллекции и используется для организации внешних соединений (outer joins). Аналогично, конструкция '[REF](true)' или '[REF](false)' применяется к реквизитам-ссылкам для указания типа соединения.
--   search_prompt: Найти в PLPlus коде использование устаревших синтаксисов внешних соединений: 1. Оператор Oracle '(+)' в условии WHERE; 2. Конструкцию '&collection(true)' в условии WHERE; 3. Конструкцию '[REF](true)' или '[REF](false)' в условии WHERE. Игнорировать: строки с 'LEFT/RIGHT JOIN', закомментированные строки (--), строки внутри PL/SQL блоков (/* ... */).
--   regex_patterns.for_search: (1) (\w+)\.(\w+)\s*=\s*(\w+)\.(\w+)\(\+\); (2) (\w+)\.(\w+)\(\+\)\s*=\s*(\w+)\.(\w+); (3) &collection\(true\); (4) (\w+)\.\[(\w+)\]\(true\); (5) (\w+)\.\[(\w+)\]\(false\); (6) (\w+)\.(\w+)\(true\)
--   code_example_bad: select * from t1, t2 where t1.id = t2.id(+)
--   code_example_bad2: where ac%id = gj.[ACCOUNT](true)
--   code_example_bad3: where cr.[LIST_PAY] = fo&collection(true)
--   fix_instruction: Преобразовать устаревший синтаксис в ANSI SQL: 1. a=b(+) -> LEFT JOIN b ON a=b; 2. a(+)=b -> RIGHT JOIN b ON a=b; 3. &collection(true) -> LEFT JOIN (::[TABLE] all : alias) ON условие; 4. [REF](true) -> удалить (true) и преобразовать в LEFT JOIN
--   fix_prompt: Выполни исправление согласно fix_instruction. Определи тип проблемы и примени соответствующее преобразование.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.OUTERJOIN.п.1.1'. Файл должен содержать все типы проблемных конструкций: (+), &collection(true), [REF](true), REF(true).
--   examples.simple_case.bad: select * from t1, t2 where t1.id = t2.id(+)
--   examples.simple_case.good: select * from t1 left join t2 on t1.id = t2.id
--   examples.parametrized_collection.bad: where cr.[LIST_PAY] = fo&collection(true)
--   examples.parametrized_collection.good: left join (::[FACT_OPER] all : fo) on cr.[LIST_PAY] = fo&collection
--   examples.parametrized_ref.bad: where ac%id = gj.[ACCOUNT](true)
--   examples.parametrized_ref.good: left join [GNI_JOUR] gj on ac%id = gj.[ACCOUNT]
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.JOINS
--   source_files: v50.docx, spr_plplus.doc
--   source_sections: п.1.1, Глава 5.8
--   plplus_references: Глава 5.8: &collection(true), Раздел 19.2.3: параметры соединения
-- ============================================================================
PUBLIC PROCEDURE v50_SQL_OUTERJOIN_p_1_1 IS
	v_ref REF [PRICE_LIST];
	v_result VARCHAR2(4000);
BEGIN
	debug_pipe('-= v50.SQL.OUTERJOIN.п.1.1 Замена (+) на LEFT/RIGHT JOIN =-', 0);
	
	-- [-] НЕПРАВИЛЬНО
	-- Пример 1: простой outer join (+)
	-- begin pl/sql
	select * from t1, t2 where t1.id = t2.id(+);
	-- end pl/sql
	
	-- Пример 2: ссылка с параметром true
	-- Пример 3: коллекция с параметром true
	for (
		select  ac (	ac%id 					: id
					,	gj.[WORKING_DATETIME]	: WORKING_DATETIME
					,	gj.[FILENAME]			: FILENAME
					,	ac.[MAIN_V_ID] 			: MAIN_V_ID
					,	st.tm					: tm
					,	st.val					: val
					)
		in ::[AC_FIN]
		,(select gj(  gj.[WORKING_DATETIME] : WORKING_DATETIME
					, gj.[FILENAME] 		: FILENAME
					, gj.[ACCOUNT]			: ACCOUNT
					, gj.[IN_FILE_HISTORY]	: IN_FILE_HISTORY
					)
					 in [GNI_JOUR]
			)
		,(select distinct st(	  st%collection : collection_id
					, analytic(first_value(substr(st.[TO_FILENAME], 3, 1)), 'over (partition by [1] order by [2] desc)', st%collection, st.[IN_FILE_DATETIME]) : val
					, analytic(first_value(st.[IN_FILE_DATETIME]), 'over (partition by [1] order by [2] desc)', st%collection, st.[IN_FILE_DATETIME]) : tm
			)
			in	::[GNI_JOUR_HISTORY] collections
			where st.[IN_FILE_DATETIME] < sysdate
		)
		where
			ac%id = gj.[ACCOUNT](true)
			and gj.[IN_FILE_HISTORY] = st.collection_id(true)
		)
	LOOP
		EXIT;
	END LOOP;

	-- [+] ПРАВИЛЬНО
	-- Исправление для примера 1
	-- begin pl/sql
	select * from t1 left join t2 on t1.id = t2.id;
	-- end pl/sql
	
	-- Исправление для примера 2
	-- Исправление для примера 3
	for (
		with gj(WORKING_DATETIME,FILENAME,ACCOUNT,IN_FILE_HISTORY)
		as (select gj(gj.[WORKING_DATETIME] : WORKING_DATETIME
					, gj.[FILENAME] 		: FILENAME
					, gj.[ACCOUNT]			: ACCOUNT
					, gj.[IN_FILE_HISTORY]	: IN_FILE_HISTORY
						)
					 in [GNI_JOUR]
			)
		, st(collection_id,val,tm)
		as (select distinct st(	  st%collection : collection_id
					, analytic(first_value(substr(st.[TO_FILENAME], 3, 1)), 'over (partition by [1] order by [2] desc)', st%collection, st.[IN_FILE_DATETIME]) : val
					, analytic(first_value(st.[IN_FILE_DATETIME]), 'over (partition by [1] order by [2] desc)', st%collection, st.[IN_FILE_DATETIME]) : tm
			)
			in	::[GNI_JOUR_HISTORY] collections
			where st.[IN_FILE_DATETIME] < sysdate
		)
		select  ac (	ac%id 					: id
					,	gj.[WORKING_DATETIME]	: WORKING_DATETIME
					,	gj.[FILENAME]			: FILENAME
					,	ac.[MAIN_V_ID] 			: MAIN_V_ID
					,	st.tm					: tm
					,	st.val					: val
					)
		in ::[AC_FIN]
		left join (gj :gj) on ac%id =gj.[ACCOUNT]
		left join (st :st) on gj.[IN_FILE_HISTORY]=st.collection_id
		)
	LOOP
		EXIT;
	END LOOP;
END;

-- ============================================================================
-- Правило 2: v50.SQL.ROWNUM.п.1.2 - Замена rownum на FETCH FIRST
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена rownum на FETCH FIRST
--   Подробное описание: Псевдоколонка rownum не поддерживается в PostgreSQL. Использовать FETCH FIRST N ROWS ONLY.
--   Пример кода для корректировки: select * from t where rownum = 1
--   Пример исправленного кода: select * from t fetch first 1 rows only
--   Теги: rownum, limit, offset
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Псевдоколонка rownum не поддерживается в PostgreSQL. Использовать FETCH FIRST N ROWS ONLY. Для сдвига выборки использовать OFFSET ON. Не использовать fetch в подзапросе EXISTS.
--   plplus_materials_note: В PL+ rownum используется в WHERE для ограничения выборки. В DBI его нет. order by применяется ко всей выборке, потом ограничивается количество строк.
--   search_prompt: Найти использование псевдоколонки rownum в WHERE, ORDER BY или SELECT. Игнорировать комментарии и строковые литералы.
--   regex_patterns.for_search: (1) \bROWNUM\s*[<>=]\s*\d+; (2) \bROWNUM\b
--   regex_patterns.for_ignore: ^\s*--.*ROWNUM; '.*ROWNUM.*'
--   code_example_bad: select * from t where rownum = 1
--   code_example_bad2: select * from t where rownum <= 10
--   fix_instruction: Заменить ROWNUM на FETCH FIRST: - rownum = 1 -> fetch first 1 rows only; - rownum <= N -> fetch first N rows only; - rownum между значениями -> использовать offset on
--   fix_prompt: Выполни замену ROWNUM на FETCH FIRST. Удали условие с ROWNUM из WHERE и добавь FETCH FIRST в конец запроса.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.ROWNUM.п.1.2' с различными вариантами использования ROWNUM.
--   examples.simple.bad: select * from t where rownum = 1
--   examples.simple.good: select * from t fetch first 1 rows only
--   examples.with_order.bad: select * from t where rownum <= 10 order by id
--   examples.with_order.good: select * from t order by id fetch first 10 rows only
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.LIMIT
--   source_files: v50.docx
--   source_sections: п.1.2
-- ============================================================================
PROCEDURE v50_SQL_ROWNUM_p_1_2 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: rownum = 1
		select * from t where rownum = 1;

		-- Вариант 2: rownum <= N
		select * from t where rownum <= 10;

		-- Вариант 3: rownum between
		select * from t where rownum between 5 and 10;

		-- Вариант 4: rownum с сортировкой
		select id, name from clients where rownum < 100 order by name;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: fetch first 1 rows only
		select * from t fetch first 1 rows only;

		-- Вариант 2: fetch first N rows only
		select * from t fetch first 10 rows only;

		-- Вариант 3: offset on + fetch first
		select * from t offset on 4 fetch first 6 rows only;

		-- Вариант 4: order by + fetch first
		select id, name from clients order by name fetch first 100 rows only;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 3: v50.SQL.UDF.п.1.3 - Запрет UDF в WHERE/GROUP BY/ORDER BY
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Запрет UDF в WHERE/GROUP BY/ORDER BY
--   Подробное описание: Пользовательские функции нельзя в условиях фильтрации, группировки и сортировки. Только в SELECT-листе верхнего уровня.
--   Пример кода для корректировки: where my_func(id) > 0
--   Пример исправленного кода: select id, my_func(id) as val from t where val > 0
--   Теги: udf, function, performance
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Пользовательские функции нельзя в условиях фильтрации, группировки и сортировки. Только в SELECT-листе верхнего уровня. Для представлений: не работает сортировка и фильтрация по UDF-колонкам.
--   plplus_materials_note: UDF в PL+ могут вызываться в SELECT, но не в WHERE/GROUP BY/ORDER BY для DBI.
--   search_prompt: Найти вызовы пользовательских функций (UDF) в WHERE, GROUP BY, ORDER BY, HAVING. Игнорировать системные функции.
--   regex_patterns.for_search: (1) WHERE\s+.*\b(\w+)\s*\(; (2) GROUP\s+BY\s+.*\b(\w+)\s*\(; (3) ORDER\s+BY\s+.*\b(\w+)\s*\(
--   regex_patterns.for_ignore: \b(NVL|DECODE|CASE|COALESCE|TO_CHAR|TO_DATE|TO_NUMBER|SUBSTR|INSTR|LENGTH|TRIM|UPPER|LOWER|COUNT|SUM|AVG|MIN|MAX)\s*\(
--   code_example_bad: where my_func(id) > 0
--   code_example_bad2: order by my_func(name)
--   fix_instruction: Переписать запрос: вычислить значение UDF до запроса или использовать в SELECT-листе.
--   fix_prompt: Вынеси вызов UDF из условия в SELECT-лист или в подзапрос.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.UDF.п.1.3' с UDF в WHERE, GROUP BY, ORDER BY.
--   examples.where.bad: select * from t where my_func(id) > 0
--   examples.where.good: select id, my_func(id) as val from t where val > 0
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.FUNCTIONS
--   source_files: v50.docx
--   source_sections: п.1.3
-- ============================================================================
PROCEDURE v50_SQL_UDF_p_1_3 IS
	FUNCTION my_func(p_id NUMBER) RETURN NUMBER IS
	BEGIN
		RETURN p_id * 2;
	END;
	
	FUNCTION calc_amount(p_doc_id NUMBER) RETURN NUMBER IS
	BEGIN
		RETURN p_doc_id * 100;
	END;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: UDF в WHERE
		select * from t where my_func(id) > 0;

		-- Вариант 2: UDF в GROUP BY
		select my_func(id) from t group by my_func(id);

		-- Вариант 3: UDF в ORDER BY
		select * from t order by my_func(name);

		-- Вариант 4: UDF в WHERE (другой пример)
		select * from documents where calc_amount(doc_id) > 1000;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: UDF в SELECT-листе с фильтром по алиасу
		select id, my_func(id) as val from t where val > 0;

		-- Вариант 2: UDF только в SELECT-листе
		select id, my_func(id) from t;

		-- Вариант 3: ORDER BY без UDF
		select * from t;

		-- Вариант 4: UDF в SELECT-листе с фильтром по алиасу
		select doc_id, calc_amount(doc_id) as amount from documents where amount > 1000;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 4: v50.SQL.CAST.п.1.5 - Явное приведение типов
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Явное приведение типов
--   Подробное описание: У Oracle и PostgreSQL разные правила неявного приведения типов данных. Необходимо писать код с совместимыми типами или явным преобразованием. LIKE применим только к строкам.
--   Пример кода для корректировки: select c_code + 1 from "Z#DEPART"
--   Пример исправленного кода: select to_number(c_code) + 1 from "Z#DEPART"
--   Теги: cast, type conversion
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: У Oracle и PostgreSQL разные правила неявного приведения типов данных. Необходимо писать код с совместимыми типами или явным преобразованием. LIKE применим только к строкам.
--   plplus_materials_note: В PostgreSQL оператор + не работает между строкой и числом. LIKE не работает с числовыми типами.
--   search_prompt: Найти операции сложения/вычитания между разными типами (строка + число), а также LIKE с числовыми полями.
--   regex_patterns.for_search: (1) \w+\s*\+\s*\d+|\d+\s*\+\s*\w+; (2) \bLIKE\s+['"].*['"]\s*(?!WHERE)
--   regex_patterns.for_ignore: '.*\+.*'
--   code_example_bad: select c_code + 1 from "Z#DEPART"
--   code_example_bad2: select * from t where numeric_column like '123%'
--   fix_instruction: Использовать явное приведение типов: - строка + число -> to_number(строка) + число; - LIKE с числом -> to_char(число) like 'pattern'
--   fix_prompt: Выполни явное приведение типов: оберни строковые поля в to_number() при сложении с числом, и числовые поля в to_char() при использовании LIKE.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.CAST.п.1.5' с операциями сложения строки и числа, а также LIKE с числовыми полями.
--   examples.string_plus_number.bad: select c_code + 1 from "Z#DEPART"
--   examples.string_plus_number.good: select to_number(c_code) + 1 from "Z#DEPART"
--   examples.like_on_number.bad: select * from t where id like '123%'
--   examples.like_on_number.good: select * from t where to_char(id) like '123%'
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.OTHER
--   source_files: v50.docx
--   source_sections: п.1.5
-- ============================================================================
PROCEDURE v50_SQL_CAST_p_1_5 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: строка + число
		select c_code + 1 from "Z#DEPART";

		-- Вариант 2: число LIKE строка
		select * from t where numeric_column like '123%';

		-- Вариант 3: конкатенация строки с числом
		select 'Total: ' || amount from payments;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: to_number(строка) + число
		select to_number(c_code) + 1 from "Z#DEPART";

		-- Вариант 2: to_char(число) like 'pattern'
		select * from t where to_char(numeric_column) like '123%';

		-- Вариант 3: to_char(число) для конкатенации
		select 'Total: ' || to_char(amount) from payments;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 5: v50.SQL.DECODE.п.1.6.1 - Замена DECODE на CASE
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена DECODE на CASE
--   Подробное описание: Функция DECODE специфична для Oracle. Заменять на ANSI-конструкцию CASE WHEN.
--   Пример кода для корректировки: select decode(status,1,'A',2,'B','?') from t
--   Пример исправленного кода: select case status when 1 then 'A' when 2 then 'B' else '?' end from t
--   Теги: decode, case, conditional
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Функция DECODE специфична для Oracle. Заменять на ANSI-конструкцию CASE WHEN. В ТЯ 7.6.10.10 при APPLICATION.DBI = 1 реализована компиляция decode в case, но при ошибке требуется ручная замена.
--   plplus_materials_note: DECODE не рекомендуется использовать в новом коде из-за неявного приведения типов.
--   search_prompt: Найти вызовы функции DECODE в SQL-запросах. Игнорировать комментарии.
--   regex_patterns.for_search: \bDECODE\s*\([^)]+\)
--   regex_patterns.for_ignore: ^\s*--.*DECODE
--   code_example_bad: select decode(status,1,'A',2,'B','?') from t
--   fix_instruction: Заменить DECODE на CASE WHEN: DECODE(expr, v1, r1, v2, r2, default) -> CASE expr WHEN v1 THEN r1 WHEN v2 THEN r2 ELSE default END
--   fix_prompt: Выполни замену DECODE на CASE WHEN.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.DECODE.п.1.6.1' с различными вариантами DECODE.
--   examples.simple.bad: select decode(status,1,'A',2,'B','?') from t
--   examples.simple.good: select case status when 1 then 'A' when 2 then 'B' else '?' end from t
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.FUNCTIONS
--   source_files: v50.docx
--   source_sections: п.1.6.1
-- ============================================================================
PROCEDURE v50_SQL_DECODE_p_1_6_1 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: DECODE с двумя условиями
		select decode(status,1,'A',2,'B','?') from t;

		-- Вариант 2: DECODE с тремя условиями
		select decode(flag, 1, 'One', 2, 'Two', 3, 'Three', 'Unknown') from config;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: CASE с двумя условиями
		select case status when 1 then 'A' when 2 then 'B' else '?' end from t;

		-- Вариант 2: CASE с тремя условиями
		select case flag when 1 then 'One' when 2 then 'Two' when 3 then 'Three' else 'Unknown' end from config;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 6: v50.SQL.CONNECTBY.п.1.8 - Замена CONNECT BY на WITH RECURSIVE
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена CONNECT BY на WITH RECURSIVE
--   Подробное описание: Иерархические запросы с CONNECT BY не поддерживаются. Использовать рекурсивные CTE: WITH RECURSIVE.
--   Пример кода для корректировки: select * from t connect by prior id = parent_id start with parent_id is null
--   Пример исправленного кода: with recursive t as (select * from t where parent_id is null union all select t2.* from t t1 join t t2 on t1.id = t2.parent_id) select * from t
--   Теги: hierarchical, connect by, cte
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Иерархические запросы с CONNECT BY не поддерживаются. Использовать рекурсивные CTE: WITH RECURSIVE. Нет аналога NOCYCLE. Иерархические запросы по метаданным запрещены.
--   plplus_materials_note: CONNECT BY — Oracle синтаксис, в PostgreSQL нет.
--   search_prompt: Найти использование CONNECT BY в запросах. Игнорировать комментарии.
--   regex_patterns.for_search: \bCONNECT\s+BY\b
--   regex_patterns.for_ignore: ^\s*--.*CONNECT\s+BY
--   code_example_bad: select * from t connect by prior id = parent_id start with parent_id is null
--   fix_instruction: Преобразовать CONNECT BY в WITH RECURSIVE: WITH RECURSIVE cte AS ( SELECT * FROM t WHERE start_condition UNION ALL SELECT t2.* FROM t t2 JOIN cte ON t2.parent_id = cte.id ) SELECT * FROM cte
--   fix_prompt: Выполни преобразование CONNECT BY в WITH RECURSIVE.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.CONNECTBY.п.1.8' с иерархическими запросами.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.HIERARCHICAL
--   source_files: v50.docx
--   source_sections: п.1.8
-- ============================================================================
PROCEDURE v50_SQL_CONNECTBY_p_1_8 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: простой CONNECT BY
		select * from t connect by prior id = parent_id start with parent_id is null;

		-- Вариант 2: CONNECT BY с LEVEL
		select level, id, name from employees connect by prior id = manager_id start with manager_id is null;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: WITH RECURSIVE
		with recursive cte as (
			select * from t where parent_id is null
			union all
			select t2.* from t t2 join cte on t2.parent_id = cte.id
		) select * from cte;

		-- Вариант 2: WITH RECURSIVE с LEVEL
		with recursive emp_cte as (
			select 1 as level, id, name from employees where manager_id is null
			union all
			select e2.level + 1, e.id, e.name from employees e join emp_cte e2 on e.manager_id = e2.id
		) select * from emp_cte;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 7: v50.SQL.SYSVIEW.п.1.9 - Замена v$session на VW_DB_SESSION
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена v$session на VW_DB_SESSION
--   Подробное описание: Системные представления Oracle недоступны. Использовать VW_DB_SESSION.
--   Пример кода для корректировки: select * from v$session
--   Пример исправленного кода: select * from VW_DB_SESSION
--   Теги: system view, oracle, session
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Системные представления Oracle недоступны. Использовать VW_DB_SESSION с полями SESSION_SID, SESSION_SERIAL, INST_ID, STATUS, SESSION_TYPE, MODULE, ACTION.
--   plplus_materials_note: V$SESSION и другие системные представления Oracle не работают в DBI. GV$SESSION также заменяется на VW_DB_SESSION.
--   search_prompt: Найти обращения к системным представлениям Oracle: v$session, gv$session, user_tables, all_objects и др.
--   regex_patterns.for_search: (1) \bV\$\w+\b; (2) \bGV\$\w+\b; (3) \bUSER_\w+\b; (4) \bALL_\w+\b; (5) \bDBA_\w+\b
--   code_example_bad: select * from v$session
--   code_example_bad2: select * from gv$session
--   fix_instruction: Заменить v$session, gv$session на VW_DB_SESSION. Другие системные представления заменить на альтернативы из документации.
--   fix_prompt: Выполни замену системных представлений Oracle на DBI-совместимые.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.SYSVIEW.п.1.9' с обращениями к v$session, user_tables и др.
--   examples.v_session.bad: select * from v$session
--   examples.v_session.good: select * from VW_DB_SESSION
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.SYS_OBJECTS
--   source_files: v50.docx
--   source_sections: п.1.9
-- ============================================================================
PROCEDURE v50_SQL_SYSVIEW_p_1_9 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: v$session
		select * from v$session;

		-- Вариант 2: gv$session
		select sid, serial# from gv$session where username = 'APP_USER';

		-- Вариант 3: user_tables
		select * from user_tables where table_name like 'Z#%';

		-- Вариант 4: all_objects
		select * from all_objects where owner = 'IBS';
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: VW_DB_SESSION
		select * from VW_DB_SESSION;

		-- Вариант 2: VW_DB_SESSION с фильтром
		select SESSION_SID, SESSION_SERIAL from VW_DB_SESSION where SESSION_TYPE = 'APP_USER';
	-- end pl/sql
END;

-- ============================================================================
-- Правило 8: v50.SQL.SYSTABLES.п.1.10 - Запрет SELECT из системных таблиц ТЯ
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Запрет SELECT из системных таблиц ТЯ
--   Подробное описание: Все таблицы метаданных ТЯ перенесены в другой data source. Список: CLASSES, CLASS_ATTRIBUTES, METHODS, CRITERIA, RTL_ENTRIES, SOURCES, DEPENDENCIES, ERRORS.
--   Пример кода для корректировки: select * from classes
--   Пример исправленного кода: PL+ представление
--   Теги: metadata, system tables
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Все таблицы метаданных ТЯ перенесены в другой data source. Список: CLASSES, CLASS_ATTRIBUTES, CLASS_CONSTRAINTS, CLASS_IND_COLUMNS, CLASS_PARTITIONS, CLASS_REC_FIELDS, CLASS_RELATIONS, CLASS_TAB_COLUMNS, CLASS_TABLES, CONTROLS, CRITERIA, CRITERIA_COLUMNS, CRITERIA_METHODS, CRITERIA_TRIES, CURSORS, CURSORS_BINDS, CURSORS_VIEW, DBA_COLL_TYPES, DBA_OBJECTS, DBA_TAB_COLUMNS, DBA_TYPE_METHODS, DBA_TYPES, DEPENDENCIES, DEPLOYMENT_SUPPLY, ENTITIES, ERRORS, FAVORITES, GUIDE_GROUPS, HOST2PLP, LRAW, MESSAGES, METHOD_GROUP_MEMBERS, METHOD_GROUPS, METHOD_PARAMETERS, METHOD_VARIABLES, METHODS, OBJ_STATIC, PART_SUBPROF_CONDS, PART_SUBPROFS, PARTITIONING_CONDITIONS, PARTITIONING_PROFILES, REPORT_OBJECTS, REPORT_PARAM_RELATIONS, RTL_ENTRIES, RTL_PARAMETERS, SEQUENCE, SETTINGS, SOURCES, STATES, STORAGE_PARAMETERS, TRANSITION_METHODS, TRANSITIONS, VW_CRITERIA_COLUMNS.
--   plplus_materials_note: Обращаться к метаданным только через метаклассы или системные модификаторы (%statename, %classname).
--   search_prompt: Найти SELECT запросы к системным таблицам ТЯ из списка выше.
--   regex_patterns.for_search: \b(FROM|INTO|JOIN)\s+(CLASSES|CLASS_ATTRIBUTES|METHODS|CRITERIA|RTL_ENTRIES|SOURCES|DEPENDENCIES|ERRORS)\b
--   code_example_bad: select * from classes
--   code_example_bad2: select * from methods where id = 123
--   fix_instruction: Заменить прямые запросы к системным таблицам на обращение к метаклассам: ::[METACLASS], ::[CLASS], ::[METHOD] и т.д.
--   fix_prompt: Выполни замену системных таблиц на метаклассы.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.SYSTABLES.п.1.10'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.SYS_OBJECTS
--   source_files: v50.docx
--   source_sections: п.1.10
-- ============================================================================
PROCEDURE v50_SQL_SYSTABLES_p_1_10 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: SELECT из CLASSES
		select * from classes;

		-- Вариант 2: SELECT из METHODS
		select id, name from methods where class_id = 100;

		-- Вариант 3: SELECT из CRITERIA
		select * from criteria where name like '%FILTER%';

		-- Вариант 4: SELECT из RTL_ENTRIES
		select * from rtl_entries where entry_name = 'TEST';
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: через метакласс METACLASS
		select * from ::[METACLASS];

		-- Вариант 2: через метакласс METHOD
		select * from ::[METHOD] where class = ::[CLASS](name = 'CLIENT');

		-- Вариант 3: через метакласс CRITERIA
		select * from ::[CRITERIA];
	-- end pl/sql
END;

-- ============================================================================
-- Правило 9: v50.SQL.ORACLE_PKG.п.1.11 - Запрет Oracle supplied PL/SQL пакетов
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Запрет Oracle supplied PL/SQL пакетов
--   Подробное описание: Oracle пакетов нет, поэтому не должно быть зависимостей. Исключить: UTL_FILE, DBMS_OUTPUT, DBMS_ALERT, DBMS_PIPE.
--   Пример кода для корректировки: utl_file.put_line(...)
--   Пример исправленного кода: -- исключить
--   Теги: oracle, plsql, packages
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Oracle пакетов нет в PostgreSQL, поэтому не должно быть зависимостей. Исключить: UTL_FILE, DBMS_OUTPUT, DBMS_ALERT, DBMS_PIPE, DBMS_LOB, DBMS_RANDOM, UTL_RAW, UTL_COMPRESS, DBMS_XMLGEN.
--   plplus_materials_note: Некоторые функции поддержаны через Java-пакеты: dbms_lob, dbms_random, utl_raw, utl_compress.
--   search_prompt: Найти вызовы Oracle supplied PL/SQL пакетов в коде.
--   regex_patterns.for_search: \b(UTL_FILE|DBMS_OUTPUT|DBMS_ALERT|DBMS_PIPE|DBMS_LOB|DBMS_RANDOM|UTL_RAW|UTL_COMPRESS|DBMS_XMLGEN)\.
--   code_example_bad: utl_file.put_line(fhandle, 'text');
--   code_example_bad2: dbms_output.put_line('message');
--   fix_instruction: Удалить вызовы Oracle пакетов или обернуть в UDF с условной компиляцией.
--   fix_prompt: Выполни удаление или замену Oracle пакетов.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.ORACLE_PKG.п.1.11'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.SYS_OBJECTS
--   source_files: v50.docx
--   source_sections: п.1.11
-- ============================================================================
PROCEDURE v50_SQL_ORACLE_PKG_p_1_11 IS
	v_file UTL_FILE.FILE_TYPE;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: UTL_FILE
		utl_file.put_line(v_file, 'text');

		-- Вариант 2: DBMS_OUTPUT
		dbms_output.put_line('message');

		-- Вариант 3: DBMS_ALERT
		dbms_alert.signal('event', 'data');

		-- Вариант 4: DBMS_PIPE
		dbms_pipe.send_message('pipe', 'data');

		-- Вариант 5: DBMS_RANDOM
		dbms_random.value();

		-- Вариант 6: UTL_RAW
		utl_raw.cast_to_raw('text');
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		null;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 10: v50.SQL.DML_JOIN.п.1.17 - Переписывание DML с JOIN на подзапросы
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Переписывание DML на подзапросы
--   Подробное описание: Нет совместимости синтаксиса update/delete from (join) между Oracle и PostgreSQL. Требуется переписать код, например, на подзапросы.
--   Пример кода для корректировки: delete from (select ... from t1 join t2)
--   Пример исправленного кода: delete from t1 where exists (select 1 from t2 ...)
--   Теги: dml, join, update, delete
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Нет совместимости синтаксиса UPDATE/DELETE FROM (JOIN) между Oracle и PostgreSQL. Требуется переписать код на подзапросы или явные условия.
--   plplus_materials_note: Реализовано в СП 2MCA DBI версии 3.1.5 и IDE версии 2.36.193.
--   search_prompt: Найти UPDATE или DELETE с JOIN в FROM клаузе.
--   regex_patterns.for_search: \b(UPDATE|DELETE)\s+.*\bFROM\b.*\bJOIN\b
--   code_example_bad: delete from (select * from t1 join t2 on t1.id = t2.id)
--   fix_instruction: DELETE FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.id = t1.id)
--   fix_prompt: Выполни замену DML с JOIN на подзапрос.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.DML_JOIN.п.1.17'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.JOINS
--   source_files: v50.docx
--   source_sections: п.1.17
-- ============================================================================
PROCEDURE v50_SQL_DML_JOIN_p_1_17 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: DELETE с JOIN
		delete from (select * from t1 join t2 on t1.id = t2.id);

		-- Вариант 2: UPDATE с JOIN
		update (select t1.status, t2.code from t1 join t2 on t1.id = t2.id) set status = 'CLOSED';
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: DELETE с подзапросом EXISTS
		delete from t1 where exists (select 1 from t2 where t2.id = t1.id);

		-- Вариант 2: UPDATE с подзапросом EXISTS
		update t1 set status = 'CLOSED' where exists (select 1 from t2 where t2.id = t1.id);
	-- end pl/sql
END;

-- ============================================================================
-- Правило 11: v50.SQL.VW_CRIT_RPT.п.1.19 - Ограничения при SELECT из VW_CRIT, VW_RPT, VW_SQL
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Запрет простых представлений
--   Подробное описание: Простые представления отсутствуют в dbi проекте. Их нужно сконвертировать/переписать в PlPlus представления.
--   Пример кода для корректировки: create view v as select ...
--   Пример исправленного кода: PL+ представление
--   Теги: view, simple
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: VW_SQL не поддерживаются. VW_RPT с ограничениями: не должно содержать вычисляемых колонок. Не рекомендуется выбирать из VW_CRIT. Представления VW_RPT, разворачиваемые в БД, не должны содержать вычисляемых колонок.
--   plplus_materials_note: Поддержаны обращения к представлениям из процедурного кода через %rowtype без разворачивания в БД.
--   search_prompt: Найти SELECT запросы к VW_CRIT, VW_RPT, VW_SQL.
--   regex_patterns.for_search: \bFROM\s+(VW_CRIT|VW_RPT|VW_SQL)\b
--   code_example_bad: select * from VW_SQL
--   code_example_bad2: select * from VW_CRIT where id = 123
--   fix_instruction: VW_SQL заменить на VW_RPT или прямые запросы. VW_RPT использовать только если нет вычисляемых колонок.
--   fix_prompt: Выполни замену SELECT из VW_* на прямые запросы.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.VW_CRIT_RPT.п.1.19'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.VIEWS
--   source_files: v50.docx
--   source_sections: п.1.19
-- ============================================================================
PROCEDURE v50_SQL_VW_CRIT_RPT_p_1_19 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: SELECT из VW_SQL
		select * from VW_SQL where id = 100;

		-- Вариант 2: SELECT из VW_CRIT
		select * from VW_CRIT where status = 'ACTIVE';

		-- Вариант 3: SELECT из VW_RPT
		select name, code from VW_RPT where date_begin > sysdate;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: использовать VW_RPT
		select * from VW_RPT where date_begin > sysdate;

		-- Вариант 2: прямой запрос к таблицам
		select * from ::[MAIN_DOCUM] where status = 'ACTIVE';
	-- end pl/sql
END;

-- ============================================================================
-- Правило 12: v50.SQL.CONTEXT.п.1.23 - Замена sys_context('USERENV','DB_NAME')
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена sys_context('USERENV','DB_NAME')
--   Подробное описание: Контекст USERENV не поддерживается. Использовать альтернативы.
--   Пример кода для корректировки: sys_context('USERENV','DB_NAME')
--   Пример исправленного кода: ::[RUNTIME].[ENVIRONMENT].ClassStorage('ТБП').dbName
--   Теги: context, userenv, database
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Контекст USERENV не поддерживается. Использовать альтернативы: DB_NAME -> ::[RUNTIME].[ENVIRONMENT].ClassStorage('ТБП').dbName; SESSIONID -> rtl.session_id или rtl.USERID; CURRENT_USER -> rtl.usr$; ACTION -> nav.current_form_method_id; OS_USER -> rtl.get_user_info().OS_USER
--   plplus_materials_note: SYS_CONTEXT с USERENV — Oracle специфика. Контекст <OWNER>_SYSTEM не рекомендуется.
--   search_prompt: Найти вызовы SYS_CONTEXT с контекстом USERENV или <OWNER>_SYSTEM.
--   regex_patterns.for_search: (1) SYS_CONTEXT\s*\(\s*['"]USERENV['"]\s*,\s*['"](\w+)['"]\s*\); (2) SYS_CONTEXT\s*\(\s*['"][A-Z_]+_SYSTEM['"]
--   code_example_bad: sys_context('USERENV','DB_NAME')
--   code_example_bad2: sys_context('USERENV','SESSIONID')
--   fix_instruction: Заменить SYS_CONTEXT('USERENV', ...) на DBI-альтернативы согласно таблице из документации.
--   fix_prompt: Выполни замену SYS_CONTEXT на DBI-альтернативы.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.CONTEXT.п.1.23' с различными атрибутами USERENV.
--   examples.db_name.bad: sys_context('USERENV','DB_NAME')
--   examples.db_name.good: ::[RUNTIME].[ENVIRONMENT].ClassStorage('ТБП').dbName
--   examples.session_id.bad: sys_context('USERENV','SESSIONID')
--   examples.session_id.good: rtl.session_id
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.OTHER
--   source_files: v50.docx
--   source_sections: п.1.23
-- ============================================================================
PROCEDURE v50_SQL_CONTEXT_p_1_23 IS
	v_dbname VARCHAR2(100);
	v_sessionid VARCHAR2(100);
	v_current_user VARCHAR2(100);
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: DB_NAME
		v_dbname := sys_context('USERENV','DB_NAME');

		-- Вариант 2: SESSIONID
		v_sessionid := sys_context('USERENV','SESSIONID');

		-- Вариант 3: CURRENT_USER
		v_current_user := sys_context('USERENV','CURRENT_USER');

		-- Вариант 4: контекст <OWNER>_SYSTEM
		v_current_user := sys_context('IBS_SYSTEM', 'USER');
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: DB_NAME -> ClassStorage
		v_dbname := ::[RUNTIME].[ENVIRONMENT].ClassStorage('ТБП').dbName;

		-- Вариант 2: SESSIONID -> rtl.session_id
		v_sessionid := rtl.session_id;

		-- Вариант 3: CURRENT_USER -> rtl.usr$
		v_current_user := rtl.usr$;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 13: v50.SQL.BIND_GROUP.п.1.26 - Запрет bind переменных в GROUP BY, DISTINCT, ORDER BY
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Запрет bind переменных в GROUP BY, DISTINCT, ORDER BY
--   Подробное описание: Запросы с bind переменными в выражениях GROUP BY, DISTINCT, ORDER BY на PostgreSQL не работают.
--   Пример кода для корректировки: group by :bind_var
--   Пример исправленного кода: group by column_name
--   Теги: bind, group by, distinct
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Запросы с bind переменными в выражениях GROUP BY, DISTINCT, ORDER BY на PostgreSQL не работают.
--   plplus_materials_note: Bind переменные — это :var или &var в PL+.
--   search_prompt: Найти bind переменные в GROUP BY, DISTINCT, ORDER BY.
--   regex_patterns.for_search: (1) GROUP\s+BY\s+.*:[a-z_]+; (2) ORDER\s+BY\s+.*:[a-z_]+; (3) DISTINCT\s+.*:[a-z_]+
--   code_example_bad: group by :bind_var
--   code_example_bad2: order by case when column = :var then 1 else 0 end
--   fix_instruction: Переписать запрос, исключив bind переменные из GROUP BY/DISTINCT/ORDER BY. Использовать реальные значения или подзапросы.
--   fix_prompt: Выполни замену bind переменных на реальные значения.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.BIND_GROUP.п.1.26'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.OTHER
--   source_files: v50.docx
--   source_sections: п.1.26
-- ============================================================================
PROCEDURE v50_SQL_BIND_GROUP_p_1_26 IS
	v_status VARCHAR2(10) := 'ACTIVE';
	v_order_col VARCHAR2(30) := 'name';
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: bind в GROUP BY
		select count(*) from t group by :bind_var;

		-- Вариант 2: bind в ORDER BY
		select distinct status from orders order by :order_col;

		-- Вариант 3: bind в CASE в GROUP BY
		select count(*) from t group by case when status = :v_status then 1 else 0 end;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: GROUP BY с реальным столбцом
		select count(*) from t group by status;

		-- Вариант 2: ORDER BY с реальным столбцом
		select distinct status from orders order by status;

		-- Вариант 3: GROUP BY с константой
		select count(*) from t group by case when status = 'ACTIVE' then 1 else 0 end;
	-- end pl/sql
END;

