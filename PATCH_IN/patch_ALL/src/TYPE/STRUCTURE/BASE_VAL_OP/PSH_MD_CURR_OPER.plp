class BASE_VAL_OP;

@name('[ПСБ] !Служебная. Добавить КВВО')
method PSH_MD_CURR_OPER is
PSH_MD_CURR_OPER (
	@name('КВВО') P_CURR_OPER in [CURR_OPERATI_REF]
) is

validate is
begin	
	if p_message = 'DEFAULT' then
		P_CURR_OPER:=::[CURR_OPERATION]([HIGH].[CODE]='99' and [CODE]='090');
	end if;
end;

execute is
begin
	this.[DOC].[CURR_OPER]:=P_CURR_OPER;
end;
end;
end;
