-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Запрет макросов execute и process
--   Подробное описание: Макросы execute и process не поддерживаются в DBI.
--   Пример кода для корректировки: pragma macro(xxx,'[1]+[2]',execute)
--   Пример исправленного кода: исключить
--   Теги: macro, substitution
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Макросы execute и process не поддерживаются в DBI.
--   plplus_materials_note: Макросы с execute и process не работают в DBI.
--   search_prompt: Найти макросы с опциями EXECUTE или PROCESS.
--   regex_patterns.for_search: pragma\s+macro\([^,]+,[^,]+,(EXECUTE|PROCESS)
--   code_example_bad: pragma macro(xxx,'[1]+[2]',execute)
--   fix_instruction: Удалить макрос или переписать без EXECUTE/PROCESS.
--   fix_prompt: Удали или перепиши макрос с EXECUTE/PROCESS.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.MACROS.п.3.4'.
--   examples.remove.bad: pragma macro(xxx,'text',execute)
--   examples.remove.good: -- макрос удалён
--   priority: medium
--   category: PROC
--   subcategory: PROC.MACROS
--   source_files: v50.docx
--   source_sections: п.3.4
-- ============================================================================
PROCEDURE v50_PROC_MACROS_p_3_4 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		pragma macro(CALC_SUM, '[1]+[2]', execute);
		pragma macro(PROC_DATA, 'process_data([1])', process);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		null;
	-- end pl/sql
END;

