class BASE_VAL_OP;

@name('[ПСБ] Изменить (служебная)')
@tag('CREATED')
method PSH_EDIT_AUTO is
PSH_EDIT_AUTO (
	@name('Документ')                                           P_DOC            in [MAIN_DOCUM_REF],
	@name('Сумма')                                              P_SUMMA          in [SUMMA],
	@name('Контракты')                                          P_CONTRACTS      in [I117_CONTRAC_ARR],
	@name('Страна банка отправителя (получателя)')              P_BANK_COUNTRY   in [COUNTRY_REF],
	@name('Направление платежа (1 - зачисление, 2 - списание)') P_PAYMENT_TYPE   in [NUMBER],
	@name('Код страны места жительства владельца счета')        P_COUNTRY_CODE   in [STRING_3],
	@name('Адрес владельца счета')                              P_ADDRESS        in [STRING_250],
	@name('БИК/SWIFT')                                          P_BIC            in [STRING_16],
	@name('Наименование банка')                                 P_BANK_NAME      in [SBRF_NAME],
	@name('Наименование получателя/плательщика')                P_CONTR_NAME     in [PAYER_NAME],
	@name('ИНН получателя/плательщика')                         P_CONTR_INN      in [STRING_12],
	@name('Выгружено')                                          P_IS_EXP         in [BOOLEAN],
	@name('Дата выгрузки')                                      P_DATE_INFO      in [DATE_TIME],
	@name('Файл')                                               P_FILE_EXP       in [FILE$PATH],
	@name('Номер счета клиента')                                P_CL_ACC_NUM     in [ACCNUM],
	@name('Дата открытия банковского счета')                    P_ACC_OPEN_DATE  in [DATE],
	@name('Наименование клиента')                               P_CL_NAME        in [PAYER_NAME],
	@name('ИНН клиента')                                        P_CL_INN         in [STRING_12],
	@name('Дата государственной регистрации')                   P_DATE_REG       in [DATE],
	@name('Номер счета получателя/плательщика')                 P_PL_POL_ACC_NUM in [STRING_35],
	@name('Страна получателя/плательщика')                      P_CONTR_COUNTRY  in [COUNTRY_REF],
	@name('КПП клиента')                                        P_CL_KPP         in [STRING_9],
	@name('Дата совершения операции')                           P_DATE_CREATE    in [DATE],
	@name('Дата предоставления документов')                     P_DATE_DOC       in [DATE],
	@name('Дата принятия документов')                           P_DATE_ACCEPT    in [DATE]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DOC := this.[DOC];
	P_SUMMA := this.[SUMMA];
	P_CONTRACTS := this.[CONTRACTS];
	P_BANK_COUNTRY := this.[BANK_COUNTRY];
	P_PAYMENT_TYPE := this.[PAYMENT_TYPE];
	P_COUNTRY_CODE := this.[COUNTRY_CODE];
	P_ADDRESS := this.[ADDRESS];
	P_BIC := this.[BIC];
	P_BANK_NAME := this.[BANK_NAME];
	P_CONTR_NAME := this.[CONTR_NAME];
	P_CONTR_INN := this.[CONTR_INN];
	P_IS_EXP := this.[IS_EXP];
	P_DATE_INFO := this.[DATE_INFO];
	P_FILE_EXP := this.[FILE_EXP];
	P_CL_ACC_NUM := this.[CL_ACC_NUM];
	P_ACC_OPEN_DATE := this.[ACC_OPEN_DATE];
	P_CL_NAME := this.[CL_NAME];
	P_CL_INN := this.[CL_INN];
	P_DATE_REG := this.[DATE_REG];
	P_PL_POL_ACC_NUM := this.[PL_POL_ACC_NUM];
	P_CONTR_COUNTRY := this.[CONTR_COUNTRY];
	P_CL_KPP := this.[CL_KPP];
	P_DATE_CREATE := this.[DATE_CREATE];
	P_DATE_DOC := this.[DATE_DOC];
	P_DATE_ACCEPT := this.[DATE_ACCEPT];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Документ"
	[DOC] := P_DOC;
	-- Установка значения реквизита "Сумма"
	[SUMMA] := P_SUMMA;
	-- Установка значения реквизита "Страна банка отправителя (получателя)"
	[BANK_COUNTRY] := P_BANK_COUNTRY;
	-- Установка значения реквизита "Направление платежа (1 - зачисление, 2 - списание)"
	[PAYMENT_TYPE] := P_PAYMENT_TYPE;
	-- Установка значения реквизита "Код страны места жительства владельца счета"
	[COUNTRY_CODE] := P_COUNTRY_CODE;
	-- Установка значения реквизита "Адрес владельца счета"
	[ADDRESS] := P_ADDRESS;
	-- Установка значения реквизита "БИК/SWIFT"
	[BIC] := P_BIC;
	-- Установка значения реквизита "Наименование банка"
	[BANK_NAME] := P_BANK_NAME;
	-- Установка значения реквизита "Наименование получателя/плательщика"
	[CONTR_NAME] := P_CONTR_NAME;
	-- Установка значения реквизита "ИНН получателя/плательщика"
	[CONTR_INN] := P_CONTR_INN;
	-- Установка значения реквизита "Выгружено"
	[IS_EXP] := P_IS_EXP;
	-- Установка значения реквизита "Дата выгрузки"
	[DATE_INFO] := P_DATE_INFO;
	-- Установка значения реквизита "Файл"
	[FILE_EXP] := P_FILE_EXP;
	-- Установка значения реквизита "Номер счета клиента"
	[CL_ACC_NUM] := P_CL_ACC_NUM;
	-- Установка значения реквизита "Дата открытия банковского счета"
	[ACC_OPEN_DATE] := P_ACC_OPEN_DATE;
	-- Установка значения реквизита "Наименование клиента"
	[CL_NAME] := P_CL_NAME;
	-- Установка значения реквизита "ИНН клиента"
	[CL_INN] := P_CL_INN;
	-- Установка значения реквизита "Дата государственной регистрации"
	[DATE_REG] := P_DATE_REG;
	-- Установка значения реквизита "Номер счета получателя/плательщика"
	[PL_POL_ACC_NUM] := P_PL_POL_ACC_NUM;
	-- Установка значения реквизита "Страна получателя/плательщика"
	[CONTR_COUNTRY] := P_CONTR_COUNTRY;
	-- Установка значения реквизита "КПП клиента"
	[CL_KPP] := P_CL_KPP;
	-- Установка значения реквизита "Дата совершения операции"
	[DATE_CREATE] := P_DATE_CREATE;
	-- Установка значения реквизита "Дата предоставления документов"
	[DATE_DOC] := P_DATE_DOC;
	-- Установка значения реквизита "Дата принятия документов"
	[DATE_ACCEPT] := P_DATE_ACCEPT;
end;
end;
end;
