class PSH_CUST_DOCS;

@import_plsql(true)
@name('[ПСБ] CMC')
@tag('COPIED')
library PSH_DOC_CMC is
/*Решение об отзыве инкассового поручения (Поручения на перевод электронных денежных средств)*/

pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma include(::[PSH_CUST_DOCS].[PSH_LIB_TC]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25

public function processAnswer(p_doc ref [PSH_CUST_DOCS_IN], p_requests &libtc.T_reqs) return integer is -- updated CHANGE_QUALIFIER PSB_CUST_DOCS_IN->PSH_CUST_DOCS_IN 08/10/25

    procedure getErr
    (
    	  p_errCode		string(2)
    	, p_errText		string(512)
    	, p_minPrior	in out integer
    	, p_minCode		in out string(2)
    	, p_minText		in out string(512)
    )
    is
    pr integer;
    begin
    	pr := &libfun.get_err_prior(p_errCode);
		
		if p_minPrior >= pr or p_minPrior is null then
			if p_errText <> nvl(p_minText, ' ') and p_minPrior is not null and p_errCode = p_minCode then
				p_minText := null;
			else
				p_minText := p_errText;
			end if;

			p_minPrior := pr;
			p_minCode := p_errCode;
		end if;
    end;

-- для обработки CLOB ответа от ИК
type TClob is table of clob;
type TReqs is table of ref [PSH_CUST_REQS]; -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25

-- филиал запроса НО
branch			ref [BRANCH];
contentsList		TClob;
n					integer;
xDoc				XMLType;
xRes				XMLType;

-- для накопления ошибок полученных от ИК
errObj				[TAX_ERROR];
errorsList			&libtc.t_errors;
resCode				string(50);
resText				string(512);
posRes				boolean;

-- для возврата структруного ответа
outDocObj			&libtc.R_docOut;
minPrior			integer;
minErrCode			string(2);
minErrText			string(512);
docId				string(1000);

srcReqsList			TReqs;
appCode				string(50) := '1B028050';
outDocRef		ref [PSH_CUST_DOCS_OU]; -- updated CHANGE_QUALIFIER PSB_CUST_DOCS_OU->PSH_CUST_DOCS_OU 08/10/25
version				string(16);
begin
	&debug('>> processAnswer', 0)
	
	&debug(&libfun.checkApp(appCode), 0)
	if &libfun.checkApp(appCode) is not null then
		&debug('Приложение '|| appCode ||' не включено', 0)
		return null;
	end if;

	-- собираем в табличку содержимое всех ответов
	select	x(x.[CONTENT], x.[INITIAL_REQ])
	in		::[PSH_CUST_REQS] all -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
	where	x in (select y(y.column_value) in p_requests)
	into	contentsList, srcReqsList;
		
	&debug('contentsList.count = ' || contentsList.count, 0)

	-- если есть - работаем
	if contentsList.count > 0 then
		begin
			-- выдернем из запроса нужные реквизиты
			select	d(d.[BRANCH])
			in		::[PSH_CUST_DOCS] all -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
			where	d = p_doc
			into	branch;
			
			&debug('branch = ' || branch%id, 0)
		exception
			when NO_DATA_FOUND then
				null;
				&debug('Не нашли файл НО', 0)
		end;	

		-- обрабатываем ответы
		n := contentsList.first;	
		while n is not null loop		
			xDoc := XMLType(contentsList(n)); -- делаем xml
			resCode := null;
			if xDoc is not null then 	
				if xDoc.existsNode('/Ответ/РезПроверки') = 1 then -- ошибка
					xRes := xDoc.extract('/Ответ/РезПроверки');

					resCode := xRes.extract('/РезПроверки/@КодРезПроверки').getStringVal();
					resText := &libfun.getErrorNote(xRes, '/РезПроверки');
					&debug('01 resCode = ' || resCode, 0)

				elsif xDoc.existsNode('/Ответ/Документ') = 1 then -- положительный результат
					docId := xDoc.extract('/Ответ/Документ/@ИдДок').getStringVal();
					&debug('docId = '||docId || ', srcReqsList(n) = ' || srcReqsList(n)%id, 0)

					if docId is not null and srcReqsList(n) is not null then -- если id и исходный запрос указаны - делаем связь
						::[PSH_CUST_ATTR].[PSH_LIB].set_req_attr(srcReqsList(n), 'docId', docId);
						&debug('Создана связь экземпляра компоненты и исходного запроса в компоненту', 0)
					end if;

					posRes := true;
					&debug('02 положительный результат', 0)
					exit; -- если есть положительный результат, можно дальше не искать.

				end if;
			end if;

			-- обрабатываем ошибку, выбираем из уже обработанных ранее самую приоритетную
			if resCode is not null then
				getErr(resCode, resText, minPrior, minErrCode, minErrText);
			end if;

			n := contentsList.next(n);
		end loop;

		-- если положительного ответа нет, возвращаем ошибки
		if not nvl(posRes, false) then
			-- формируем PB2
			-- проставляем итоговую ошибку от всех компонент
			if minErrCode is not null then
				errObj := null;
				errObj.[ERR_TYPE] := minErrCode;
				errObj.[ERR_TEXT] := minErrText;
				errorsList(1) := errObj;
				outDocObj := &libfun.formPT2(p_doc, branch, errorsList);

				if outDocObj.r_fileName is not null then
					outDocRef := ::[PSH_CUST_DOCS_OU].[PSH_NEW_AUTO]( -- updated CHANGE_QUALIFIER PSB_CUST_DOCS_OU->PSH_CUST_DOCS_OU 08/10/25
																  P_FILE_NAME 		== outDocObj.r_fileName	-- Имя файла
																, P_FILE_CONTENT	== outDocObj.r_clob		-- Содержимое файла
																, P_FILE_CR_DATE 	== null					-- Дата создания файла
																, P_DOC_CR_DATE		== sysdate				-- Дата создания документа
																, P_VERSION			== version				-- Версия формата
																, P_DOC_TYPE		== outDocObj.r_docType	-- Тип документа
																, P_BRANCH			== outDocObj.r_branch	-- Филиал
															);
					-- добавляем связи
					&lib.linkDoc(p_doc, outDocRef, outDocObj.r_link);
				end if;

				&debug('	Подтверждение: ' || outDocObj.r_clob, 0)
			end if;
		else
			null; -- сохранить идентификатор docId

		end if;

		errorsList.delete;
	end if;

	return bool_num(outDocRef is not null, 1, 0);
end;


public procedure checkDoc(
	  p_doc &xml.DOMNode
	, p_error in out &libtc.T_Errors
	, p_typeDoc in ::[PSH_CUST_DOCS].[DOC_TYPE]%type -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
	, p_branch out ref [BRANCH]
) is
begin
	::[PSH_CUST_DOCS].[PSH_DOC_UCO].checkDoc(p_doc, p_error, p_typeDoc, p_branch); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
end;

public function convertMessage(p_inDoc in clob) return clob is
cl clob;
begin
	dbms_lob.createtemporary(cl, true);
	cl := p_inDoc;
	return cl;
end;
end;
