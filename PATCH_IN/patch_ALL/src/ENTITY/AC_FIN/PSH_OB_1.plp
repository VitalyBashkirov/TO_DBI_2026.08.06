class AC_FIN;

@import_plsql(true)
@name('[ПСБ] Клиенты с оборотами')
@tag('COPIED')
method PSH_OB_1 is
PSH_OB_1 (
	@name('Дата') P_DATE in [DATE] default null
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE := [SYSTEM]::[OP_DATE];
end if;
-- End initialization of parameters and variables
declare
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma macro (xl,'::[OOXML].[API_XL]');
iFmt1		integer;
iFmt2		integer;
iRow		number;
nRow		number;
sum_turn_deb      number;
sum_turn_kred      number;
sum_kass      number;
iBorder		integer;
cl_info		[CL_INFO_REQ];
xl_tmpl 		blob := empty_blob();

begin
	
	if P_MESSAGE = 'DEFAULT' then
		P_DATE := ::[SYSTEM].[OP_DATE];
	end if; --*/

	if P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'OK' then
	   --::[SHABLON_DOC].[LIB_OOXML].xl_init;
     	::[SHABLON_DOC].[LIB_OOXML].load_blob('PSB_OB', xl_tmpl, null, null, null, null);
		 if xl_tmpl is null then pragma error('Не найден шаблон отчета'); end if;		
	 	 if not &xl.open_file(xl_tmpl) then pragma error('Ошибка при открытии печатной формы шаблона');	end if;	
	 	 --*/
		 &xl.Open_Sheet(1);			
		 --&xl.RenameSheet(1,to_char(P_DATE,'dd.mm.yy')); 	 						

			
			
	iRow := 2;
	nRow := 0;
	
	iFmt1 := &xl.Get_numFmt ('###0');
	iFmt2 := &xl.Get_numFmt ('#,##0.00');
	iBorder := &xl.get_border(p_top==&xl.xl_b_thin, p_bottom==&xl.xl_b_thin, p_left==&xl.xl_b_thin, p_right==&xl.xl_b_thin);
	
	select a( sum(a.[TURN_DT]) : sum_dt
	          ,sum(a.[TURN_CT]) : sum_kt 
             )
          in ::[PL_ARC_USV] all where 
          substr(a.[PLAN_ACC].[NUM],1,3)in ('407','408')
          and a.[DATE]>=to_date('01.01.2022','dd.mm.yyyy')
          and a.[DATE]<=P_DATE          
	into sum_turn_deb,sum_turn_kred;
	&xl.put(50,5, sum_turn_deb);  
	&xl.put(50,14, sum_turn_kred);  
	for (
	        select d(
				      d  						: c_id			
				    , d.[CLIENT_V]%id  		    : c_cl_id	    
			        , d.[CLIENT_V].[NAME]		: c_client	      
			        , d.[MAIN_V_ID]				: c_main_v_id
					, d.[DATE_OP]  : c_date_op
					, d.[DATE_CLOSE]  : c_date_end
			        
			        , F.a_turn_short(to_date('01.01.2022','dd.mm.yyyy'),P_DATE,d%id,true,true)	: c_turn_deb
			         , F.a_turn_short(to_date('01.01.2022','dd.mm.yyyy'),P_DATE,d%id,false,true)	: c_turn_kred
			       -- , d.[CLIENT]->(CL_PRIV)[DATE_PERS]: c_doc_dp	      
			       -- , d.[CLIENT]->(CL_PRIV)[DOC].[SER]||d.[CLIENT]->(CL_PRIV)[DOC].[NUM]: c_doc_sernum	      
					--, d.[VID_DOG].[NAME]	    : c_vid_dog
					--, d.[NUM_DOG]		    : c_num_dog
					/*, d.[CREATE_USER].[NAME]	    : c_create_user
					, d.[DEPART].[CODE]		    : c_depart_code
					, d.[DEPART].[NAME]		    : c_depart_name
					, d.[FILIAL].[CODE]      : c_filial
					, d.[DATE_BEGIN]		    : c_date_begin
					, d.[DATE_ENDING]        : c_date_ending
					, d.[DATE_BEGINING]		    : c_date_begining
					, d.[DATE_CLOSE] 		    : c_date_close
					, d.[ACCOUNT] : c_account_id
					, d.[ACCOUNT].[ARC_MOVE] : c_account_ARC_MOVE
					, d.[ACCOUNT].[MAIN_V_ID]: c_account
					, d.[COM_STATUS].[NAME]	: c_com_status
					, d.[FINTOOL].[CUR_SHORT]	: c_fintool
					, d.[ARRAY_DOG_ACC]     :  c_ARRAY_DOG_ACC
					, F_5.A('И'||d.[ACCOUNT]||'СВ', d.[DATE_CLOSE])	: c_saldo
					,d.[ACCOUNT].[DATE_OP]  : c_date_op
					,d.[ACCOUNT].[DATE_CLOSE]  : c_date_end
					,d.[LIST_PAY]   : c_list_pay
					--*/
	        ) in ::[AC_FIN]  all  --join (::[RECORDS] all :rec ) on     rec%collection = d.[ARC_MOVE] all
						where
						substr(d.[MAIN_V_ID],1,3) in ('407','408')
						and (d.[DATE_CLOSE] is null or d.[DATE_CLOSE]> to_date('01.01.2022','dd.mm.yyyy'))
						and F.a_turn_short(to_date('01.01.2022','dd.mm.yyyy'),P_DATE,d%id,true,true)>0.05*sum_turn_deb
				--	 and ( F.a_turn_short(to_date('01.01.2022','dd.mm.yyyy'),P_DATE,d%id,true,true)>1000000
				--	 or  F.a_turn_short(to_date('01.01.2022','dd.mm.yyyy'),P_DATE,d%id,false,true)>1000000)
				
					
	)loop
	
		iRow :=	iRow + 1;
		nRow := nRow + 1;
        
        &xl.put(iRow,1, nRow);      
        &xl.put(iRow,2, d.c_cl_id);      
        &xl.put(iRow,3, d.c_client);
        &xl.put(iRow,4, d.c_main_v_id);	
        --&xl.put(iRow,5, F.a('И'||d.c_id||'Н',P_DATE),F.a('И'||d.c_id||'Н',to_date('01.01.2022','dd.mm.yyyy')));      
        &xl.put(iRow,5, d.c_turn_deb );      
        
         sum_kass:=0;
        for(
        		select md(
			sum(md.SUM) : c_SUM
	
		) in ::[MAIN_DOCUM]
	--	all
		where md.[DATE_EXEC]>= to_date('01.01.2022','dd.mm.yyyy')
		  and md.[VID_DOC] =::[NAME_PAYDOC](CODE='КАСС_РАСХОД_ОРД')
		  and substr(md.[ACC_DT].[MAIN_V_ID],1,3 )not in ('202','474','603') 
		  --and md.[VALUTA].[CODE_ISO]='840'
		  and md.[ACC_DT].[CLIENT_V]%id=d.c_cl_id
		  and md.[ACC_DT].[FINTOOL]!= ::[FT_MONEY](CUR_SHORT='RUB')
	--	  and a.[FINTOOL] != ::[SYSTEM].[VARIABLES].NatCur
		 -- and (md.[ACC_KT].[DATE_CLOSE] is null or md.[ACC_KT].[DATE_CLOSE] >= P_DATE)
		group by md.[ACC_DT]
		)loop
       sum_kass:=md.c_SUM;
       
        end loop; 
        &xl.put(iRow,6, sum_kass );      
        

         sum_kass:=0;
        for(
        		select md(
			sum(md.SUM) : c_SUM
	
		) in ::[MAIN_DOCUM]
	--	all
		where md.[DATE_EXEC]>= to_date('01.01.2022','dd.mm.yyyy')
		  and md.[VID_DOC] =::[NAME_PAYDOC](CODE='БЕЗН_ПЛ_ПОРУЧ')
		  and md.[ACC_DT].[MAIN_V_ID]= d.c_main_v_id
		  and instr(md.[NAZN],'алог')>0
		group by md.[ACC_DT]
		)loop
       sum_kass:=md.c_SUM;
       
        end loop; 
        &xl.put(iRow,11, sum_kass );      


--===================================================================
        &xl.put(iRow,14, d.c_turn_kred );        
         sum_kass:=0;
        for(
        		select md(
			sum(md.SUM) : c_SUM
	
		) in ::[MAIN_DOCUM]
	--	all
		where md.[DATE_EXEC]>= to_date('01.01.2022','dd.mm.yyyy')
		  and md.[VID_DOC] =::[NAME_PAYDOC](CODE='КАСС_ПРИХОД_ОРД')
		  and substr(md.[ACC_KT].[MAIN_V_ID],1,3 )not in ('202','474','603') 
		  --and md.[VALUTA].[CODE_ISO]='840'
		  and md.[ACC_KT].[CLIENT_V]%id=d.c_cl_id
		  and md.[ACC_KT].[FINTOOL]!= ::[FT_MONEY](CUR_SHORT='RUB')
	--	  and a.[FINTOOL] != ::[SYSTEM].[VARIABLES].NatCur
		 -- and (md.[ACC_KT].[DATE_CLOSE] is null or md.[ACC_KT].[DATE_CLOSE] >= P_DATE)
		group by md.[ACC_KT]
		)loop
       sum_kass:=md.c_SUM;
       
        end loop; 
        &xl.put(iRow,15, sum_kass );      
        
      &xl.put(iRow,22, to_char(d.c_date_op,'dd/mm/yyyy' ));      
        &xl.put(iRow,23, to_char(d.c_date_end,'dd/mm/yyyy' ));      
  
  
  

       /* 
        &xl.put(iRow,5, F.a('И'||d||'Н',P_DATE));      
        &xl.put(iRow,6, d.c_num_dog);
        &xl.put(iRow,7, to_char(d.c_date_op, 'dd.mm.yyyy'));        
        &xl.put(iRow,8, to_char(d.c_date_ending, 'dd.mm.yyyy'));        
        &xl.put(iRow,9, d.c_account);        
        
	   for (  select n(n.[ACCOUNT_DOG].[1].[2] : id , n.[ACCOUNT_DOG].[1].[2].[MAIN_V_ID] : m ) in d.c_ARRAY_DOG_ACC
	        where n.[NAME_ACCOUNT]=::[TIP_ACC]([COD]='D_TRM_INTS_LBS_ACC')
			     )     
			   loop 			   
    				&xl.put(iRow,10, n.m);
					&xl.put(iRow,13, F.a('И'||n.id||'В',P_DATE));-- to_date('09.03.2022','dd.mm.yyyy')));
					&xl.put(iRow,14, F.a('И'||n.id||'Н',P_DATE));-- to_date('09.03.2022','dd.mm.yyyy')));
    			  
			   end loop;
		&xl.put(iRow,11, F.a('И'||d.c_account_id||'В',P_DATE)); --to_date('09.03.2022','dd.mm.yyyy')));
		&xl.put(iRow,12, F.a('И'||d.c_account_id||'Н',P_DATE));-- to_date('09.03.2022','dd.mm.yyyy')));
		&xl.put(iRow,15, d.c_vid_dog);        
--*/
        
		
	end loop;
	

	
	
	
	
	-- Границы таблицы
	&xl.Set_Format_Range(2, 1, iRow, 23, p_borderId == iBorder);

			--Формируем результат
			&xl.finish(xl_tmpl);
	
			[OOXML]::[API_ORSA].putReport2RunExtProc(xl_tmpl,'xlsx','Список клиентов '||to_char(P_DATE,'dd.mm.yy')||' ');														

		end if; -- p_info
	end if; -- p_messge
End;
end;

execute is

begin
 null;							
end;
end;
end;
