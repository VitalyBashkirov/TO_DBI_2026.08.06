type countries_tabtype is table of &api.country_rectype index by varchar2(50);
v_cache_countries countries_tabtype; -- Кэш с информацией о странах
type addr_obj_kinds_tabtype is table of &api.addr_obj_kind_rectype index by varchar2(50);
v_cache_addr_obj_kinds addr_obj_kinds_tabtype; -- Кэш с информацией о типах адресных объектов
type int_tabtype is table of integer index by varchar2(50);
v_cache_levels int_tabtype; -- Кэш с информацией об уровнях адресных объектов для типа объекта
type houses_types_tabtype is table of [EST_STRUC_STATUS] index by varchar2(50);
v_cache_houses_types houses_types_tabtype; -- Кэш с информацией о типах домов

v_system_country const ref [COUNTRY] := ::[SYSTEM].[COUNTRY];
r_system_country &api.country_rectype;

procedure fill_country -- Получение информации о стране
	( p_country in out &api.country_rectype -- Запись с информацией о стране
		-- Если в поле id указан идентификатор, то заполняются все остальные поля.
		-- Если идентификатор отсутствует, то выполняется его поиск по тем полям, которые указаны, и если страна найдена, то выполняется заполнение всех полей актуальными значениями из справочника 
	)
is
begin
	if p_country.id is not null then
		if v_cache_countries.exists(p_country.id%id) then
			p_country := v_cache_countries(p_country.id%id);
		else
			v_cache_countries(p_country.id%id) := null;
			for	(select r (r.[CODE] : nn, r.[ALFA_2] : a2, r.[ALFA_3] : a3, r.[VALUE] : name, r.[NAME] : fname) in ::[COUNTRY] where r = p_country.id) loop
				p_country.code_nn := r.nn;
				p_country.code_a2 := r.a2;
				p_country.code_a3 := r.a3;
				p_country.name := r.name;
				p_country.full_name := r.fname;
				v_cache_countries(p_country.id%id) := p_country;
			end loop;
		end if;
	elsif	p_country.code_nn is not null
		or	p_country.code_a2 is not null
		or	p_country.code_a3 is not null
		or	p_country.name is not null
		or	p_country.full_name is not null
	then -- Ищем ссылку по реквизитам, если они есть
		if r_system_country.id is null and v_system_country is not null then
			r_system_country.id := v_system_country;
			fill_country(r_system_country);
		end if;
		if		p_country.code_nn = r_system_country.code_nn
			or	p_country.code_a2 = r_system_country.code_a2
			or	p_country.code_a3 = r_system_country.code_a3
			or	upper(p_country.name) = upper(r_system_country.name)
			or	upper(p_country.full_name) = upper(r_system_country.full_name)
		then
			p_country := r_system_country;
			return;
		end if;
		if p_country.id is null and p_country.code_nn is not null then
			for	(select r (r : id) in ::[COUNTRY] where r.[CODE] = p_country.code_nn) loop
				if p_country.id is not null then
					pragma error('Найдено несколько стран с кодом "'||p_country.code_nn||'".');
				end if;
				p_country.id := r.id;
			end loop;
		end if;
		if p_country.id is null and p_country.code_a2 is not null then
			for	(select r (r : id) in ::[COUNTRY] where r.[ALFA_2] = p_country.code_a2) loop
				if p_country.id is not null then
					pragma error('Найдено несколько стран с кодом "'||p_country.code_a2||'".');
				end if;
				p_country.id := r.id;
			end loop;
		end if;
		if p_country.id is null and p_country.code_a3 is not null then
			for	(select r (r : id) in ::[COUNTRY] where r.[ALFA_3] = p_country.code_a3) loop
				if p_country.id is not null then
					pragma error('Найдено несколько стран с кодом "'||p_country.code_a3||'".');
				end if;
				p_country.id := r.id;
			end loop;
		end if;
		if p_country.id is null and p_country.name is not null then
			for	(select r (r : id) in ::[COUNTRY] where upper(r.[VALUE]) = upper(p_country.name)) loop
				if p_country.id is not null then
					pragma error('Найдено несколько стран с наименованием "'||p_country.name||'".');
				end if;
				p_country.id := r.id;
			end loop;
		end if;
		if p_country.id is null and p_country.full_name is not null then
			for	(select r (r : id) in ::[COUNTRY] where upper(r.[NAME]) = upper(p_country.full_name)) loop
				if p_country.id is not null then
					pragma error('Найдено несколько стран с полным наименованием "'||p_country.full_name||'".');
				end if;
				p_country.id := r.id;
			end loop;
		end if;
		if p_country.id is null then
			pragma error
				(	'Не найдена страна с реквизитами "'
				||	rtrim
					(	ltrim(p_country.code_nn||', ',', ')
					||	ltrim(p_country.code_a2||', ',', ')
					||	ltrim(p_country.code_a3||', ',', ')
					||	ltrim(p_country.name||', ',', ')
					||	ltrim(p_country.full_name||', ',', ')
					, ', '
					)
				||	'".'
				);
		end if;
		fill_country(p_country);
	end if;
end;

type address_types_tabtype is table of [ADDRESS_TYPE] index by varchar2(50);
v_cache_address_types_by_id address_types_tabtype; -- Кэш с информацией о типах адресов по идентификатору
v_cache_address_types_by_code address_types_tabtype; -- Кэш с информацией о типах адресов по коду
function get_address_type(p_id ref [ADDRESS_TYPE], p_code varchar2(50)) return [ADDRESS_TYPE] is
begin
	if p_id is not null then
		if not v_cache_address_types_by_id.exists(p_id%id) then
			v_cache_address_types_by_id(p_id%id) := null;
			for (select r(r:id, r.[KOD]:code) in ::[ADDRESS_TYPE] where r = p_id) loop
				v_cache_address_types_by_id(r.id%id) := r.id;
				if r.code is not null and not v_cache_address_types_by_code.exists(r.code) then
					v_cache_address_types_by_code(r.code) := v_cache_address_types_by_id(r.id%id);
				end if;
			end loop;
		end if;
		return v_cache_address_types_by_id(p_id%id);
	elsif p_code is not null then
		if not v_cache_address_types_by_code.exists(p_code) then
			v_cache_address_types_by_code(p_code) := null;
			for (select r(r:id) in ::[ADDRESS_TYPE] where r.[KOD] = p_code) loop
				v_cache_address_types_by_code(p_code) := r.id;
				if not v_cache_address_types_by_id.exists(r.id%id) then
					v_cache_address_types_by_id(r.id%id) := v_cache_address_types_by_code(p_code);
				end if;
			end loop;
		end if;
		return v_cache_address_types_by_code(p_code);
	end if;
	return null;
end;

procedure fill_addr_obj_kind -- Получение информации о типе адресного объекта
	( p_kind in out &api.addr_obj_kind_rectype -- Запись с информацией о типе адресного объекта, идентификатор которого должен быть указан в поле id
	, p_obj_level in out integer -- Уровень объекта
	)
is
	v_to_end [BOOLSTRING];
begin
	if p_kind.id is not null then
		if v_cache_addr_obj_kinds.exists(p_kind.id%id) and v_cache_levels.exists(p_kind.id%id) then
			p_kind := v_cache_addr_obj_kinds(p_kind.id%id);
			p_obj_level := v_cache_levels(p_kind.id%id); 
		else
			select r (r.[NAME], r.[SHORT_NAME], r.[FOR_ADDRESS], r.[TO_END], r.[OBJ_LEVEL])
				in ::[PEOPLE_PLACE]
				where r = p_kind.id
			into p_kind.name, p_kind.sname, p_kind.name_for_addr, v_to_end, p_obj_level;
			p_kind.to_end := char_bool(v_to_end);
			v_cache_addr_obj_kinds(p_kind.id%id) := p_kind;
			v_cache_levels(p_kind.id%id) := p_obj_level; 
		end if;
	end if;
exception
	when no_data_found then
		v_cache_addr_obj_kinds(p_kind.id%id) := null;
		v_cache_levels(p_kind.id%id) := null; 
end;

procedure fill_house_type -- Получение информации о типе дома
	( p_type in out [EST_STRUC_STATUS] -- Запись с информацией о типе дома, идентификатор которого должен быть указан в поле %id
	)
is
	v_bs [BOOLSTRING];
begin
	if p_type%id is not null then
		if v_cache_houses_types.exists(p_type%id) then
			p_type := v_cache_houses_types(p_type%id);
		else
			select r (r.[NAME], r.[SHORT_NAME], r.[CODE], r.[EST_STR_STAT])
				in ::[EST_STRUC_STATUS]
				where r%id = p_type%id
			into p_type.[NAME], p_type.[SHORT_NAME], p_type.[CODE], v_bs;
			p_type.[EST_STR_STAT] := char_bool(v_bs);
			v_cache_houses_types(p_type%id) := p_type;
		end if;
	end if;
exception
	when no_data_found then
		v_cache_houses_types(p_type%id) := null;
end;

function get_oktmo(p_addr_obj ref [ADDRESS_OBJ], p_oktmo ref [OKTMO] default null)
return ref [OKTMO]
is
	v_cnt	integer;
	v_oktmo	ref [OKTMO] := null;
begin
	if p_addr_obj is not null then
		select c(count(1))
		in ::[ADDR_OBJ_HIERAR]
		where c.[ADDR_OBJ] = p_addr_obj
		into v_cnt;
	
		if v_cnt = 1 then
			select c(c.[OKTMO])
			in ::[ADDR_OBJ_HIERAR]
			where c.[ADDR_OBJ] = p_addr_obj
			into v_oktmo;
		elsif v_cnt > 1 then
			if p_oktmo is not null then
				for
				(
					select c(c.[OKTMO]:c_oktmo)
					in ::[ADDR_OBJ_HIERAR]
					where c.[ADDR_OBJ] = p_addr_obj and c.[OKTMO] = p_oktmo
					order by c%id
					fetch 1
				) loop
					v_oktmo := c.c_oktmo;
				end loop;
			end if;
			if p_oktmo is null or v_oktmo is null then
				select c(c.[OKTMO])
				in ::[ADDR_OBJ_HIERAR]
				where c.[ADDR_OBJ] = p_addr_obj
				order by c%id
				fetch 1
				into v_oktmo;
			end if;
		end if;
	end if;
	return v_oktmo;
end;

public function get_addr_obj
/* Получение информации об адресном объекте. */
	( p_obj ref [ADDRESS_OBJ]
		/* Ссылка на адресный объект */
	)
	/* Информация об адресном объекте. */
	return &api.addr_obj_rectype
is
	r_obj &api.addr_obj_rectype;
	v_obj_level integer;
begin
	for	(select r
			( r : id
			, r%class : class_id
			, r.[NAME] : name
			, r.[KIND] : kind_id
			, r.[FIAS] : fias_code
			, r.[OBJECTID] : fias_objectid
			, r.[AOGUID] : fias_objectguid
			, r.[ZIP] : zip
			, r.[OKATO] : okato
			, r.[KLADR] : kladr_code
			, r.[ARCHAIC] : archaic
			)
			in ::[ADDRESS_OBJ]
			where r = p_obj
		)
	loop
		r_obj.id := r.id;
		r_obj.name := r.name;
		r_obj.kind.id := r.kind_id;
		fill_addr_obj_kind(r_obj.kind,v_obj_level);
		r_obj.short_name := trim(case when r_obj.kind.to_end then r_obj.name||' '||r_obj.kind.sname else r_obj.kind.sname||' '||r_obj.name end);
		r_obj.full_name := trim(case when r_obj.kind.to_end then r_obj.name||' '||r_obj.kind.name else r_obj.kind.name||' '||r_obj.name end);
		r_obj.is_actual := not nvl(char_bool(r.archaic),false);
		r_obj.ids.objectid := r.fias_objectid;
		r_obj.ids.objectguid := r.fias_objectguid;
		r_obj.ids.fias_code := r.fias_code;
		r_obj.ids.kladr_code := r.kladr_code;
		r_obj.ids.zip := r.zip;
		r_obj.ids.oktmo := get_oktmo(p_obj);
		r_obj.ids.okato := r.okato;
	end loop;
	return r_obj;
end;

public function get_addr_obj_expanded
/* Получение развёрнутой информации об адресном объекте. */
	( p_obj ref [ADDRESS_OBJ]
		/* Ссылка на адресный объект */
	, p_struct number default 1
          /* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное */
	, p_oktmo ref [OKTMO] default null
          /* Ссылка на ОКТМО, используется для муниципального деления (p_struct=2). Если значение не передано - берется с p_obj */
	)
	/* Информация об адресном объекте. */
	return &api.addr_obj_expanded_rectype
is
	r_addr &api.addr_obj_expanded_rectype;
	r_obj &api.addr_obj_rectype;
	v_obj_level integer;
	procedure put_obj_to_addr_field
		( p_obj &api.addr_obj_rectype
		, p_obj_class varchar2(16)
		, p_obj_level integer
		)
	is
		function is_obj_equal(p_obj1 &api.addr_obj_rectype, p_obj2 &api.addr_obj_rectype) return boolean is
		begin
			if p_obj1.id is null or p_obj2.id is null then
				return false;
			end if;
			return nvl((p_obj1.name = p_obj2.name and nvl(p_obj1.kind.id%id,0) = nvl(p_obj2.kind.id%id,0)), false);
		end;
	begin
		if p_obj_class = ::[CODE_REGION]%class then
			if r_addr.region.id is null then
				r_addr.region := p_obj;
				if is_obj_equal(p_obj,r_addr.city) then
					r_addr.city := null;
				end if;
			end if;
		elsif p_obj_class = ::[REGION_AREA]%class then
			if p_obj_level = v_level_settlement and p_struct = 2 then -- уровень поселений только в муниципальном делении
				r_addr.settlement := p_obj;
			else
				if r_addr.district.id is null then
					r_addr.district := p_obj;
					if is_obj_equal(p_obj,r_addr.city) then
						r_addr.city := null;
					end if;
				end if;
			end if;
		elsif p_obj_class = ::[NAMES_CITY]%class then

			p_obj_level := nvl(p_obj_level,v_level_town);
			if p_obj_level <= v_level_city and is_obj_equal(p_obj,r_addr.region) then
				r_addr.region_city := p_obj.id;-- Пропускаем город, который уже есть в регионе, сохраняя ссылку на него
			elsif p_obj_level <= v_level_city and is_obj_equal(p_obj,r_addr.district) then
				r_addr.district_city := p_obj.id;-- Пропускаем город, который уже есть в районе, сохраняя ссылку на него
			elsif p_obj_level <= v_level_city and r_addr.city.id is null then
				r_addr.city := p_obj;
			elsif p_obj_level >= v_level_city then
				if r_addr.town.id is null then
					r_addr.town := p_obj;
				elsif r_addr.city.id is null then
					r_addr.city := r_addr.town;
					r_addr.town := p_obj;
				else
					r_addr.town := p_obj;
				end if;
			end if;				
		elsif p_obj_class = ::[STREET]%class then
			if p_obj_level = v_level_subarea then
				r_addr.subarea := p_obj;
			else
				r_addr.street := p_obj;
			end if;
		end if;
	end;
begin
	if p_struct = 1 then
		for (with recursive rc(id, parent, lvl, nocyc) as (
				select x(x, x.[PARENT], 1, ','||x||',') in ::[ADDRESS_OBJ] where x = p_obj
				union all
				select x(x, x.[PARENT], rr.lvl+1, rr.nocyc||x||',')
				in ::[ADDRESS_OBJ]
				join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
			 select r(rr.lvl : lvl
					, r : id
					, r%class : class_id
					, case r%class
						when ::[CODE_REGION]%class then (select c(c.[COUNTRY]) in ::[CODE_REGION] where c%id = r%id)
						when ::[NAMES_CITY]%class then (select c(c.[COUNTRY]) in ::[NAMES_CITY] where c%id = r%id)
					  end : country
					, case r%class
						when ::[CODE_REGION]%class then (select rg(rg.[CODE]) in ::[CODE_REGION] where rg%id = r%id)
					  end : region_code
					, r.[NAME] : name
					, r.[KIND] : kind_id
					, r.[FIAS] : fias_code
					, r.[OBJECTID] : fias_objectid
					, r.[AOGUID] : fias_objectguid
					, r.[ZIP] : zip
					, r.[OKATO] : okato
					, r.[OKTMO] : oktmo
					, r.[KLADR] : kladr_code
					, r.[ARCHAIC] : archaic)
			 in ::[ADDRESS_OBJ]
			 join (rc : rr) on rr.id = r
			 order by rr.lvl desc)
		loop
		 	if r.country is not null and r_addr.country.id is null then
				r_addr.country.id := r.country;
				fill_country(r_addr.country);
			end if;
			if r.region_code is not null and r_addr.region_code is null then
				r_addr.region_code := r.region_code;
			end if;
			r_obj := null;
			r_obj.id := r.id;
			r_obj.name := r.name;
			r_obj.kind.id := r.kind_id;
			fill_addr_obj_kind(r_obj.kind,v_obj_level);
			r_obj.short_name := trim(case when r_obj.kind.to_end then r_obj.name||' '||r_obj.kind.sname else r_obj.kind.sname||' '||r_obj.name end);
			r_obj.full_name := trim(case when r_obj.kind.to_end then r_obj.name||' '||r_obj.kind.name else r_obj.kind.name||' '||r_obj.name end);
			r_obj.ids.objectid := r.fias_objectid;
			r_obj.ids.objectguid := r.fias_objectguid;
			r_obj.is_actual := not nvl(char_bool(r.archaic),false);
			r_obj.ids.fias_code := r.fias_code;
			r_obj.ids.kladr_code := r.kladr_code;
			r_obj.ids.zip := r.zip;
			r_obj.ids.oktmo := r.oktmo;
			r_obj.ids.okato := r.okato;
			put_obj_to_addr_field(r_obj,r.class_id,v_obj_level);
		end loop;
	elsif p_struct = 2 then
		if p_oktmo is null then
			p_oktmo := get_oktmo(p_obj);
		end if;
		
		for (with recursive rc(id, parent, oktmo, lvl, nocyc) as (
				select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
				in ::[ADDRESS_OBJ]
				join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
				where x = p_obj and (h.[OKTMO] = p_oktmo or p_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = p_oktmo))
				union all
				select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
				in ::[ADDRESS_OBJ]
				join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
				join (rc : rr) on rr.parent = x
								  and instr(rr.nocyc, ','||x||',') = 0
								  and (p_oktmo is null or (h.[OKTMO] = p_oktmo or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ]) and h1.[OKTMO] = p_oktmo)))
								  )
			 select r(rr.lvl : lvl
					, r : id
					, r%class : class_id
					, case r%class
						when ::[CODE_REGION]%class then (select c(c.[COUNTRY]) in ::[CODE_REGION] where c%id = r%id)
						when ::[NAMES_CITY]%class then (select c(c.[COUNTRY]) in ::[NAMES_CITY] where c%id = r%id)
					  end : country
					, case r%class
						when ::[CODE_REGION]%class then (select rg(rg.[CODE]) in ::[CODE_REGION] where rg%id = r%id)
					  end : region_code
					, r.[NAME] : name
					, r.[KIND] : kind_id
					, r.[FIAS] : fias_code
					, r.[OBJECTID] : fias_objectid
					, r.[AOGUID] : fias_objectguid
					, r.[ZIP] : zip
					, r.[OKATO] : okato
					, rr.oktmo : oktmo
					, r.[KLADR] : kladr_code
					, r.[ARCHAIC] : archaic)
			 in ::[ADDRESS_OBJ]
			 join (rc : rr) on rr.id = r
			 order by rr.lvl desc)
		loop
		 	if r.country is not null and r_addr.country.id is null then
				r_addr.country.id := r.country;
				fill_country(r_addr.country);
			end if;
			if r.region_code is not null and r_addr.region_code is null then
				r_addr.region_code := r.region_code;
			end if;
			r_obj := null;
			r_obj.id := r.id;
			r_obj.name := r.name;
			r_obj.kind.id := r.kind_id;
			fill_addr_obj_kind(r_obj.kind,v_obj_level);
			r_obj.short_name := trim(case when r_obj.kind.to_end then r_obj.name||' '||r_obj.kind.sname else r_obj.kind.sname||' '||r_obj.name end);
			r_obj.full_name := trim(case when r_obj.kind.to_end then r_obj.name||' '||r_obj.kind.name else r_obj.kind.name||' '||r_obj.name end);
			r_obj.ids.objectid := r.fias_objectid;
			r_obj.ids.objectguid := r.fias_objectguid;
			r_obj.is_actual := not nvl(char_bool(r.archaic),false);
			r_obj.ids.fias_code := r.fias_code;
			r_obj.ids.kladr_code := r.kladr_code;
			r_obj.ids.zip := r.zip;
			r_obj.ids.oktmo := r.oktmo;
			r_obj.ids.okato := r.okato;
			put_obj_to_addr_field(r_obj,r.class_id,v_obj_level);
		end loop;
	end if;

	return r_addr;
end;

procedure fill_house_type_by_kladr_prefix
	( p_num_rec in out nocopy &api.house_num_rectype
	, p_kladr_prefix varchar2(128)
	)
is
begin
	if p_num_rec.type_id is not null then
		return;
	elsif nvl(p_kladr_prefix,'дом') = 'дом' then
		p_num_rec.type_name := 'Дом';
		p_num_rec.type_sname := 'д.';
	elsif p_kladr_prefix like 'двлд%' then
		p_num_rec.type_name := 'Домовладение';
		p_num_rec.type_sname := 'двлд.';
	elsif p_kladr_prefix like 'влд%' then
		p_num_rec.type_name := 'Владение';
		p_num_rec.type_sname := 'влд.';
	elsif p_kladr_prefix like 'к%' then
		p_num_rec.type_name := 'Корпус';
		p_num_rec.type_sname := 'к.';
	elsif p_kladr_prefix like 'стр%' then
		p_num_rec.type_name := 'Строение';
		p_num_rec.type_sname := 'стр.';
	elsif p_kladr_prefix like 'соор%' then
		p_num_rec.type_name := 'Сооружение';
		p_num_rec.type_sname := 'соор.';
	elsif p_kladr_prefix like 'литер%' then
		p_num_rec.type_name := 'Литера';
		p_num_rec.type_sname := 'литера';
	end if;
end;

function has_kladr_prefix(p_num varchar2(128)) return boolean is
begin
	return regexp_like(p_num,'двлд|влд|к|стр|соор|литер');
end;

procedure clear_kladr_house_prefix(p_num_rec in out nocopy &api.house_num_rectype) is
	v_kladr_prefix varchar2(50);
	v_num varchar2(100);
begin
	v_num := regexp_replace(p_num_rec.num,'\s+');
	if v_num is not null then
		v_kladr_prefix := regexp_substr(v_num,'^(двлд|влд|к|стр|соор|литер)');
		if v_kladr_prefix is not null then
			v_num := regexp_replace(v_num,'^(двлд|влд|к|стр|соор(ужение)?|литер)');
			fill_house_type_by_kladr_prefix(p_num_rec,v_kladr_prefix);
		end if;
		if p_num_rec.type_name is not null then
			p_num_rec.num := v_num;
		end if;
	end if;
end;

procedure parse_kladr_house_num
	( p_num varchar2(128)
	, p_num_rec1 in out nocopy &api.house_num_rectype
	, p_num_rec2 in out nocopy &api.house_num_rectype
	, p_num_rec3 in out nocopy &api.house_num_rectype
	, p_last_num integer := 3
	, p_first_prefix varchar2(128) := 'дом'
	)
is
	v_num varchar2(100);
	v_next_kladr_prefix varchar2(50) := nvl(p_first_prefix,'дом');
	procedure get_num(p_num_rec in out nocopy &api.house_num_rectype, p_last boolean := false) is
		v_pos pls_integer;
		v_kladr_prefix varchar2(50) := v_next_kladr_prefix;
	begin
		if v_num is null then
			return;
		end if;
		v_pos := regexp_instr(v_num,'двлд|влд|к|стр|соор|литер(а)?');
		if v_pos = 0 or p_last then
			p_num_rec.num := v_num;
			v_num := null;
		else
			if v_pos >= 1 then
				p_num_rec.num := substr(v_num,1,v_pos-1);
				v_num := substr(v_num,v_pos);
			end if;
			v_next_kladr_prefix := regexp_substr(v_num,'^(двлд|влд|к|стр(оение)?|соор|литер(а)?)');
			v_num := regexp_replace(v_num,'^(двлд|влд|к|стр(оение)?|соор(ужение)?|литер(а)?)');
			if v_num is null and v_next_kladr_prefix is not null then
				p_num_rec.num := v_next_kladr_prefix;
			end if;
		end if;
		if p_num_rec.num is not null then
			fill_house_type_by_kladr_prefix(p_num_rec,v_kladr_prefix);
		end if;
		p_num_rec.num := ltrim(p_num_rec.num,' .');
	end;
	
begin
	v_num := regexp_replace(p_num,'\s+');
	p_last_num := case p_last_num when 1 then 1 when 2 then 2 else 3 end;
	get_num(p_num_rec1,(p_last_num=1));
	if p_num_rec1.num is null then
		get_num(p_num_rec1,(p_last_num=1));
	end if;
	if p_last_num >= 2 then
		get_num(p_num_rec2,(p_last_num=2));
		if p_last_num >= 3 then
			get_num(p_num_rec3,true);
		end if;
	end if;
end;

public function get_house_obj
/* Заполнение развёрнутой информации о доме по ссылке. */
	( p_house ref [HOUSES]
		/* Ссылка на дом. */
	)
	/* Запись с информацией о доме. */
	return &api.house_obj_rectype
is
	v_tmp_num &api.house_num_rectype%type;
	r_house &api.house_obj_rectype;
	procedure fill_num
		( p_num_rec in out &api.house_num_rectype
		, p_num &api.house_num_rectype.num%type
		, p_type ref [EST_STRUC_STATUS]
		)
	is
		v_htype [EST_STRUC_STATUS];
	begin
		p_num_rec.num := p_num;
		p_num_rec.type_id := p_type;
		v_htype%id := p_num_rec.type_id%id;
		fill_house_type(v_htype);
		if v_htype.[CODE] != '0' then
			p_num_rec.type_name := v_htype.[NAME];
			p_num_rec.type_sname := v_htype.[SHORT_NAME];
		end if;
		if p_type is null then
			null;
		end if;
	end;
begin
	if p_house is null then
		return null;
	end if;
	for	(select r
			( r : id
			, r.[AOGUID] : addr_obj
			, r.[OBJECTID] : objectid
			, r.[HOUSEGUID] : objectguid
			, r.[NAME] : num
			, r.[ESTSTATUS] : num_type_id
			, r.[KORP] : korp
			, r.[KORP_TYPE] : korp_type_id
			, r.[STRUCNUM] : build
			, r.[STRSTATUS] : build_type_id
			, r.[ZIP] : zip
			, r.[OKATO] : okato
			, r.[OKTMO] : oktmo
			)
			in ::[HOUSES]
			where r = p_house
		)
	loop
		r_house.id := r.id;
		r_house.addr_obj := r.addr_obj;
		r_house.ids.objectid := r.objectid;
		r_house.ids.objectguid := r.objectguid;
		fill_num(r_house.num,r.num,r.num_type_id);
		r_house.kladr_list := 
			( r.objectguid is null and r.num_type_id is null and r.build_type_id is null -- Считаем, что запись может относиться к КЛАДР, если у неё отсутствует guid (т.е. это не ФИАС) и отсутствуют типы дома и строения, которые записям КЛАДР не проставлялись
				and regexp_like(r.num,',|[ЧН]\(|\d-\d') -- Номера/интервалы разделены запятыми. В интервале номера разделяются знаком "-". Номера могут ограничиваться только чётными "Ч(2-8)" или нечётными "Н(1-9)".
			);
		fill_num(r_house.num_add1,r.korp,r.korp_type_id);
		if r.korp is not null and r.korp_type_id is null then
			r_house.num_add1.type_name := 'Корпус';
			r_house.num_add1.type_sname := 'к.';
		end if;
		fill_num(r_house.num_add2,r.build,r.build_type_id);
		r_house.ids.zip := r.zip;
		r_house.ids.okato := r.okato;
		r_house.ids.oktmo := r.oktmo;
		if r.objectguid is null and not r_house.kladr_list and r_house.num.num is not null then
			if r_house.num_add1.num is null and r_house.num_add2.num is null then
				parse_kladr_house_num
					( p_num  == r_house.num.num
					, p_num_rec1 == r_house.num
					, p_num_rec2 == r_house.num_add1
					, p_num_rec3 == r_house.num_add2
					, p_last_num == 3
					);
			else
				clear_kladr_house_prefix(r_house.num);
				clear_kladr_house_prefix(r_house.num_add1);
				clear_kladr_house_prefix(r_house.num_add2);
			end if;
		end if;
		if r_house.num_add1.type_sname != 'к.' and r_house.num_add2.num is null then
			r_house.num_add2 := r_house.num_add1;
			r_house.num_add1 := null;
		elsif r_house.num_add1.type_sname != 'к.' and r_house.num_add2.type_sname = 'к.' then
			v_tmp_num := r_house.num_add2;
			r_house.num_add2 := r_house.num_add1;
			r_house.num_add1 := v_tmp_num;
		end if;
	end loop;
	return r_house;
end;

public function get_house_str
/* Получение информации о номере дома из текстовых полей адреса. */
	( p_house_num varchar2(100) := null
		/* Основной номер дома. */
	, p_house_korp varchar2(100) := null
		/* Номер корпуса. */
	)
	/* Запись с информацией о номере дома. */
	return &api.house_str_rectype
is
	r_house &api.house_str_rectype;
	v_build_pos integer;
	v_tmp_num &api.house_num_rectype;
	function check_type
		( p_num in out &api.house_num_rectype
		, p_start_regexp varchar2(250)
		, p_type_name varchar2(250)
		, p_type_sname varchar2(250)
		)
		return boolean
	is
		v_prefix varchar2(250);
	begin
		v_prefix := regexp_substr(upper(p_num.num),p_start_regexp||'[. ]*');
		if v_prefix is null then
			return false;
		end if;
		p_num.num := substr(p_num.num,length(v_prefix)+1);
		p_num.type_name := p_type_name;
		p_num.type_sname := p_type_sname;
		return true;
	end;
	procedure parse_type
		( p_num in out &api.house_num_rectype
		, p_type_name varchar2(128) := null
		, p_type_sname varchar2(128) := null
		) is
	begin
		if p_num.num is null then
			return;
		end if;
		if regexp_like(p_num.num,'^\d') then null;
		elsif check_type(p_num,'^(ДВЛД|ДОМОВЛАДЕНИЕ)','Домовладение','двлд.') then null; -- Это условие должно быть до "Дом"
		elsif check_type(p_num,'^Д(ОМ)?','Дом','д.') then null;
		elsif check_type(p_num,'^(ВЛД|ВЛАДЕНИЕ)','Владение','влд.') then null;
		elsif check_type(p_num,'^СТР(ОЕНИЕ)?','Строение','стр.') then null;
		elsif check_type(p_num,'^СООР(УЖЕНИЕ)?','Сооружение','соор.') then null;
		elsif check_type(p_num,'^ЛИТЕР(А)?','Литера','литера') then null;
		elsif check_type(p_num,'^К(ОРП(УС)?)?','Корпус','к.') then null;
		end if;
		if p_num.type_name is null then
			p_num.type_name := p_type_name;
			p_num.type_sname := p_type_sname;
		end if;
	end;
begin
	r_house.house.num := trim(regexp_replace(p_house_num,'\s+',' '));
	if r_house.house.num is not null then
		if has_kladr_prefix(r_house.house.num) then
			clear_kladr_house_prefix(r_house.house);
		end if;
		if r_house.house.type_name is null then
			parse_type(r_house.house,'Дом','д.'); -- Определяем тип дома
		end if;
	end if;
	r_house.korp.num := trim(regexp_replace(p_house_korp,'\s+',' '));
	if has_kladr_prefix(r_house.korp.num) then
		parse_kladr_house_num(r_house.korp.num, r_house.korp, r_house.build, v_tmp_num, 2, 'к');
	end if;
	if r_house.korp.type_name is null and r_house.build.type_name is null then
		v_build_pos := regexp_instr(upper(r_house.korp.num),'СТР|СООР|ЛИТЕР');
		if v_build_pos > 0 then-- Отделяем от корпуса строение (сооружение, литер)
			r_house.build.num := trim(substr(r_house.korp.num,v_build_pos));
			r_house.korp.num := trim(substr(r_house.korp.num,1,(v_build_pos-1)));
			if check_type(r_house.build,'^СТР(ОЕНИЕ)?','Строение','стр.') then null;
			elsif check_type(r_house.build,'^СООР(УЖЕНИЕ)?','Сооружение','соор.') then null;
			elsif check_type(r_house.build,'^ЛИТ(ЕР(А?)?)?','Литера','литера') then null;
			end if;
			if regexp_like(r_house.build.num,'^\d') and r_house.build.type_name is null then
				r_house.build.type_name := 'Строение';
				r_house.build.type_sname := 'стр.';
			end if;
		end if;
		parse_type(r_house.korp); -- Определяем тип корпуса
			if regexp_like(r_house.korp.num,'^\d') and r_house.korp.type_name is null then
				r_house.korp.type_name := 'Корпус';
				r_house.korp.type_sname := 'к.';
			end if;
	end if;
	if r_house.korp.type_sname != 'к.' and r_house.build.num is null then
		r_house.build := r_house.korp;
		r_house.korp := null;
	elsif r_house.korp.type_sname != 'к.' and r_house.build.type_sname = 'к.' then
		v_tmp_num := r_house.build;
		r_house.build := r_house.korp;
		r_house.korp := v_tmp_num;
	end if;
	return r_house;
end;

public function get_flat_str
/* Получение информации о номере помещения из текстовых полей адреса. */
	( p_num varchar2(50) := null
		/* Номер помещения. */
	, p_type_sname_dft varchar2(50) := null
	)
	/* Запись с информацией о номере дома. */
	return &api.flat_str_rectype
is
	r_flat &api.flat_str_rectype;
begin
	r_flat.num := trim(regexp_replace(p_num,'\s+',' '));
	if r_flat.num is not null then
		r_flat.type_sname := trim(regexp_substr(r_flat.num,'^\D[^ 0-9]*')); -- Типом квартиры считаем текст вначале строки, который начинается не с цифры до первого пробела или цифры (и не совпадает целиком со строкой)
		if r_flat.type_sname is not null and trim(r_flat.type_sname) <> trim(r_flat.num) then
			r_flat.num := trim(substr(r_flat.num,length(r_flat.type_sname)+1));
		else
			r_flat.type_sname := p_type_sname_dft;
		end if;
	end if;
	return r_flat;
end;

public function get_address_expanded
/* Получение развёрнутой информации об адресе. */
	( p_address [PERSONAL_ADDRESS]
		/* Адрес. */
	, p_struct number default 1
          /* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное */
	)
	/* Запись с развёрнутой информацией об адресе. */
	return &api.address_expanded_rectype
is
	r_address &api.address_expanded_rectype;
	v_obj ref [ADDRESS_OBJ];
begin
	--TODO: удалить после удаления реквизитов
	v_obj%id := coalesce(p_address.[ADDR_OBJ]%id,p_address.[STREET_REF]%id,p_address.[CITY]%id);
	r_address.address := p_address;
	r_address.address.[ADDR_OBJ] := v_obj;
	r_address.addr_obj_expanded := get_addr_obj_expanded(v_obj, p_struct, p_address.[OKTMO]);
	r_address.house_obj := get_house_obj(p_address.[HOUSE_REF]);
	r_address.house_str := get_house_str(p_address.[HOUSE],p_address.[KORPUS]);
	r_address.flat_str := get_flat_str(p_address.[FLAT],get_address_type(p_address.[TYPE],null).[FLAT_PREFIX]);
	r_address.best_ids.objectid := coalesce
		( r_address.house_obj.ids.objectid
		, r_address.addr_obj_expanded.street.ids.objectid
		, r_address.addr_obj_expanded.subarea.ids.objectid
		, r_address.addr_obj_expanded.town.ids.objectid
		, r_address.addr_obj_expanded.city.ids.objectid
		, r_address.addr_obj_expanded.settlement.ids.objectid
		, r_address.addr_obj_expanded.district.ids.objectid
		, r_address.addr_obj_expanded.region.ids.objectid
		);
	r_address.best_ids.objectguid := coalesce
		( r_address.house_obj.ids.objectguid
		, r_address.addr_obj_expanded.street.ids.objectguid
		, r_address.addr_obj_expanded.subarea.ids.objectguid
		, r_address.addr_obj_expanded.town.ids.objectguid
		, r_address.addr_obj_expanded.city.ids.objectguid
		, r_address.addr_obj_expanded.settlement.ids.objectguid
		, r_address.addr_obj_expanded.district.ids.objectguid
		, r_address.addr_obj_expanded.region.ids.objectguid
		);
	r_address.best_ids.kladr_code := coalesce
		( r_address.house_obj.ids.kladr_code
		, r_address.addr_obj_expanded.street.ids.kladr_code
		, r_address.addr_obj_expanded.subarea.ids.kladr_code
		, r_address.addr_obj_expanded.town.ids.kladr_code
		, r_address.addr_obj_expanded.city.ids.kladr_code
		, r_address.addr_obj_expanded.settlement.ids.kladr_code
		, r_address.addr_obj_expanded.district.ids.kladr_code
		, r_address.addr_obj_expanded.region.ids.kladr_code
		);
	r_address.best_ids.zip := coalesce
		( r_address.address.[POST_CODE]
		, r_address.house_obj.ids.zip
		, r_address.addr_obj_expanded.street.ids.zip
		, r_address.addr_obj_expanded.subarea.ids.zip
		, r_address.addr_obj_expanded.town.ids.zip
		, r_address.addr_obj_expanded.city.ids.zip
		, r_address.addr_obj_expanded.settlement.ids.zip
		, r_address.addr_obj_expanded.district.ids.zip
		, r_address.addr_obj_expanded.region.ids.zip
		);
	r_address.best_ids.okato := coalesce
		( r_address.house_obj.ids.okato
		, r_address.addr_obj_expanded.street.ids.okato
		, r_address.addr_obj_expanded.subarea.ids.okato
		, r_address.addr_obj_expanded.town.ids.okato
		, r_address.addr_obj_expanded.city.ids.okato
		, r_address.addr_obj_expanded.settlement.ids.okato
		, r_address.addr_obj_expanded.district.ids.okato
		, r_address.addr_obj_expanded.region.ids.okato
		);
	r_address.best_ids.oktmo := coalesce
		( r_address.house_obj.ids.oktmo
		, r_address.addr_obj_expanded.street.ids.oktmo
		, r_address.addr_obj_expanded.subarea.ids.oktmo
		, r_address.addr_obj_expanded.town.ids.oktmo
		, r_address.addr_obj_expanded.city.ids.oktmo
		, r_address.addr_obj_expanded.settlement.ids.oktmo
		, r_address.addr_obj_expanded.district.ids.oktmo
		, r_address.addr_obj_expanded.region.ids.oktmo
		);
	return r_address;
end;

public function get_address_expanded
/* Получение развёрнутой информации об адресе по ссылке. */
	( p_addr ref [PERSONAL_ADDRESS]
		/* Ссылка на адрес. */
	)
	/* Запись с развёрнутой информацией об адресе. */
	return &api.address_expanded_rectype
is
	v_addr [PERSONAL_ADDRESS];
begin
	v_addr := p_addr;
	return get_address_expanded(v_addr);
end;

function str2arr
	(p_str varchar2(32767)
	,p_delimiter varchar2(128) := ','
	)
	return rtl.string_table
is
	v_arr rtl.string_table;
	v_pos1 pls_integer := 1;
	v_pos2 pls_integer;
	v_one varchar2(32767);
	v_str_size constant integer := length(p_str);
	v_dlm_size constant integer := length(p_delimiter);
begin
	if p_str is null or p_delimiter is null then
		return v_arr;
	end if;
	loop
		v_pos2 := instr(p_str,p_delimiter,v_pos1);
		v_one := trim(substr(p_str, v_pos1, case when v_pos2 > 0 then v_pos2 else v_str_size + 1 end - v_pos1));
		if v_one is not null then
			v_arr(v_arr.count+1) := v_one;
		end if;
		exit when v_pos2 = 0 or v_pos2 is null;
		v_pos1 := v_pos2 + v_dlm_size;
	end loop;
	return v_arr;
end;

procedure set_format_parameters
	( p_format in out varchar2(1000)
	, p_delimiter in out varchar2(10)
	, p_add_empty in out [BOOLSTRING]
	)
is
begin
	if p_format is null then
		p_format := 'ALL';
	end if;
	case upper(substr(p_format, 1, 50)) of
	: 'FMT_NINE_COMMAS' :
		p_format		:= 'COUNTRY_CODE,ZIP,REGION_CODE,DISTRICT_TE,MAIN_CITY_TE,CITY_TE,STREET_TE,HOUSE_NT,KORPUS_NT,FLAT_NT';
		p_delimiter		:= nvl(p_delimiter, ';');
	: 'FMT_TEN_COMMAS' :
		p_format		:= 'COUNTRY_CODE,ZIP,REGION_CODE,DISTRICT_TE,MAIN_CITY_TE,CITY_TE,STREET_TE,HOUSE_NT,KORPUS_NT,FLAT_NT,ADDR_TYPE';
		p_delimiter		:= nvl(p_delimiter, ';');
	: 'FMT_SIMPLE', 'ALL' :
		p_format		:= 'ZIP,REGION,DISTRICT,CITY,STREET,HOUSE,BUILD,KORPUS_ONLY,FLAT';
		p_delimiter		:= nvl(p_delimiter, ',');
	: 'FMT_IBSO_TO_RBO' :
		p_format		:= 'COUNTRY_ALFA3,KLADR_CODE,ZIP,DISTRICT,CITY,STREET,HOUSE_NT,KORPUS_NT,FLAT_NT,ADDR_TYPE';
		p_delimiter		:= nvl(p_delimiter, ';');
	: 'FMT_RBO_TO_IBSO' :
		p_format		:= 'COUNTRY_ALFA3,KLADR_CODE,ZIP,DISTRICT_NT,CITY,STREET,HOUSE_NT,KORPUS_NT,FLAT_NT,ADDR_TYPE';
		p_delimiter		:= nvl(p_delimiter, ';');
	end;
	p_add_empty := nvl(p_add_empty, '1');
	p_delimiter := nvl(p_delimiter, ',');
end;

v_format varchar2(1000); 
v_format_fields rtl.string_table; -- Массив с полями формата
v_fmt_contains_main_city boolean := false;
v_fmt_contains_subarea boolean := false;
v_fmt_contains_region boolean := false;
v_fmt_contains_district boolean := false;
procedure parse_format(p_format varchar2(1000)) is
begin
	p_format := upper(translate(p_format,';$',',,'));
	if nvl(v_format,'$') != nvl(p_format,'$') then
		v_format_fields.delete;
		v_format_fields := str2arr(p_format,',');
		v_format := p_format; 
		v_fmt_contains_main_city := nvl((v_format like '%MAIN_CITY%'),false);
		v_fmt_contains_subarea := nvl((v_format like '%SUBAREA%'),false);
		v_fmt_contains_region := nvl((v_format like '%REGION%'),false);
		v_fmt_contains_district := nvl((v_format like '%DISTRICT%'),false);
	end if;
end;

function get_name_with_type(p_name varchar2(250), p_type varchar2(50), p_to_end boolean := false, p_delimiter varchar2(10) := ' ') return varchar2 is
begin
	if trim(p_name) is not null then
		if trim(p_type) is not null then
			if p_to_end then
				return trim(p_name)||p_delimiter||trim(p_type);
			else
				return trim(p_type)||p_delimiter||trim(p_name);
			end if;
		else
			return trim(p_name);
		end if;
	end if;
	return null;
end;

function get_name_with_kind(p_name varchar2(250), p_kind &api.addr_obj_kind_rectype, p_to_end boolean := null, p_delimiter varchar2(10) := ' ') return varchar2 is
begin
	return get_name_with_type(p_name,nvl(p_kind.name_for_addr,p_kind.sname),nvl(p_to_end,p_kind.to_end),p_delimiter);
end;

public function addr_to_str
/* Получение адреса в виде строки определённого формата */
	( p_addr [PERSONAL_ADDRESS]
		/* Адрес */
	, p_format varchar2(1000) default null
		/* Формат адресной строки */
	, p_delimiter varchar2(10) default null
		/* Символ-разделитель */
	, p_add_empty [BOOLSTRING] default '1'
		/* Добавлять пустые поля */
	, p_struct number default 1
    	/* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное */
	)
	/* Строка с адресом */
	return varchar2(4000)
is
	r_addr &api.address_expanded_rectype;
	v_str varchar2(4000);
	v_idx integer;
	v_fld varchar2(50);
	v_fld_value varchar2(1000);
	function get_obj_str(p_obj &api.addr_obj_rectype, p_fmt_suffix varchar2(128)) return varchar2 is
	begin
		return
			case 
				when p_fmt_suffix is null then get_name_with_kind(p_obj.name,p_obj.kind)
				when p_fmt_suffix = '_NT' then p_obj.name
				when p_fmt_suffix = '_TE' then get_name_with_kind(p_obj.name,p_obj.kind,true)
				when p_fmt_suffix = '_CODE' then p_obj.ids.kladr_code
			end;
	end;

	--Башкиров В.Г. 09.04.2025
	function addEmptyForAsv (p_addr [PERSONAL_ADDRESS]) return [BOOLSTRING] is
		/* Добавлять пустые поля для адресов типа АСВ */
	begin
		if p_addr.[TYPE].[KOD] like '%ASV%' then
			&debug(TB$||'.addEmptyForAsv -- Добавлять пустые поля для адресов типа АСВ',0)
			return '1';
		end if;
	end;
begin
	&debug(TB$||'.addr_to_str -- Передана структура',0)
	::[HOOK_BANK].[GET_PRINT_ADDR_1].GetInfoPersonalAddress(r_addr.address,TB$||TB$);

	p_add_empty:=nvl(addEmptyForAsv(p_addr),p_add_empty); --Башкиров В.Г. 09.04.2025 Добавлять пустые поля для адресов типа АСВ

	&debug(TB$||'p_format         ='||p_format,0)
	&debug(TB$||'(1)p_struct      ='||p_struct,0)

	--Башкиров В.Г. 10.02.2025
	if p_struct=2 then
		null;
	else
		&debug(TB$||'p_addr.[INPUT_STRUCT]='||p_addr.[INPUT_STRUCT],0)
		if p_addr.[INPUT_STRUCT]=2 then
			p_struct:=2;
			&debug(TB$||'(2)p_struct      ='||p_struct,0)

			if p_format is not null and instr(p_format,',')>0 then
				p_struct:=::[HOOK_BANK].[GET_PRINT_ADDR_1].Get_ADM_or_MUN(p_addr);
				p_format:=::[HOOK_BANK].[GET_PRINT_ADDR_1].GetFmtAddrO(p_addr);
				&debug(TB$||'(2.1)p_struct                    ='||p_struct,0)
				&debug(TB$||'(2.1)p_format(из PSB_MUN_SH_ADDR)='||p_format,0)
			end if;
		end if;
	end if;

	set_format_parameters(p_format,p_delimiter,p_add_empty);
	parse_format(p_format);
	&debug(TB$||'p_format      ='||p_format,0)
	&debug(TB$||'p_delimiter   ='||p_delimiter,0)
	&debug(TB$||'p_add_empty   ='||p_add_empty,0)
	&debug(TB$||'(3)p_struct   ='||p_struct,0)
	&debug(TB$||'p_addr.[OKTMO]='||p_addr.[OKTMO].[CODE]||'-'||p_addr.[OKTMO].[NAME],0)
	if v_format_fields.count = 0 then
		return null;
	end if;
	r_addr := get_address_expanded(p_addr, p_struct);
	if v_format_fields.count > 1 and 
		((r_addr.address.[ADDR_OBJ] is null and upper(p_format) like '%CITY%')
			or	(r_addr.address.[FIX_PRINT]))
		then
		return r_addr.address.[IMP_STR];
	end if;
	
	-- города-регионы (города федерального значения) не хранятся в структуре addr_obj_expanded.city, ссылка на такой город лежит в addr_obj_expanded.region_city
	-- если формат не содержит регион и в адресе город федерального значения, то переложим его в структуру города для корректного вывода
	-- аналогично для городов-районов
	if not v_fmt_contains_region and r_addr.addr_obj_expanded.city.id is null and r_addr.addr_obj_expanded.region_city is not null then
		r_addr.addr_obj_expanded.city := get_addr_obj(r_addr.addr_obj_expanded.region_city);
	elsif not v_fmt_contains_district and r_addr.addr_obj_expanded.city.id is null and r_addr.addr_obj_expanded.district_city is not null then
		r_addr.addr_obj_expanded.city := get_addr_obj(r_addr.addr_obj_expanded.district_city);
	end if;
	
	v_idx := v_format_fields.first;
	while v_idx is not null loop
		v_fld := v_format_fields(v_idx);
		&debug(TB$||'v_fld='||v_fld,0)
		v_fld_value := '';
		if v_fld in ('ZIP','POST_CODE') then
			v_fld_value := r_addr.best_ids.zip;
		elsif v_fld like 'COUNTRY%' then
			v_fld_value :=
				case v_fld
				when 'COUNTRY' then r_addr.addr_obj_expanded.country.name
				when 'COUNTRY_NO' then case when r_addr.addr_obj_expanded.country.id != v_system_country then r_addr.addr_obj_expanded.country.name end
				when 'COUNTRY_CODE' then r_addr.addr_obj_expanded.country.code_nn
				when 'COUNTRY_ALFA2' then r_addr.addr_obj_expanded.country.code_a2
				when 'COUNTRY_ALFA3' then r_addr.addr_obj_expanded.country.code_a3
				when 'COUNTRY_FULL' then r_addr.addr_obj_expanded.country.full_name
				when 'COUNTRY_NO_FULL' then case when r_addr.addr_obj_expanded.country.id != v_system_country then r_addr.addr_obj_expanded.country.full_name end
				end;
		elsif v_fld like 'REGION%' then
			if v_fld like 'REGION_NCT%' then -- Надо вывести регион только в том случае, если уровень города отличается от региона (т.е. в city не город-регион)
				-- Оставлено для обратной совместимости!
				-- Сейчас структура addr_obj_expanded заполняется таким образом, что город-регион в поле city не попадает, если он оказался в поле region.
				-- Но, на всякии случай, убедимся, что region и city различаются
				-- Тут ошибка, по данному коду регион будет выведен даже для городов-регионов, но т.к. у нас город-регион не выводится если есть регион в формате
				-- то оставлено как есть, иначе не будет выведен ни город, ни регион
				if r_addr.addr_obj_expanded.region.name != r_addr.addr_obj_expanded.city.name or r_addr.addr_obj_expanded.city.name is null then
					v_fld := replace(v_fld,'_NCT'); -- Если не убрать "_NCT", то регион не будет выведен, т.к. далее проверяется строкоге равенство суффиксов формата
				end if;
			elsif v_fld like 'REGION_NCC%' then -- Надо вывести регион только в том случае, если город в адресе не является центром региона
				-- В новом ФИАС нет информации о региональных центрах! Эти сведения могут заполняться вручную или переноситься из ОКАТО.
				if r_addr.addr_obj_expanded.city.id is null or nvl(r_addr.addr_obj_expanded.city.id.[STATUS],0) not in (2,3) then -- 2 - центр региона, 3 - центр региона и района
					v_fld := replace(v_fld,'_NCC'); -- Если не убрать "_NCC", то регион не будет выведен, т.к. далее проверяется строкоге равенство суффиксов формата
				end if;
			end if;
			if v_fld = 'REGION_CODE' then
				v_fld_value := r_addr.addr_obj_expanded.region_code;
			else
				v_fld_value := get_obj_str(r_addr.addr_obj_expanded.region,replace(replace(v_fld,'REGION'),'_LCODE','_CODE'));
			end if;
		elsif v_fld like 'DISTRICT%' then
			if v_fld like 'DISTRICT_NCC%' then -- Надо вывести район только в том случае, если город в адресе не является центром района.
				-- В новом ФИАС нет информации о региональных центрах! Эти сведения могут заполняться вручную или переноситься из ОКАТО.
				if	nvl	(	case
								when r_addr.addr_obj_expanded.city.id is not null then r_addr.addr_obj_expanded.city.id.[STATUS]
								when r_addr.addr_obj_expanded.town.id is not null then r_addr.addr_obj_expanded.town.id.[STATUS]
							end
						,	0
						) not in (1,3) -- 1 - центр района, 3 - центр региона и района
				then
					v_fld := replace(v_fld,'_NCC'); -- Если не убрать "_NCC", то район не будет выведен, т.к. далее проверяется строкоге равенство суффиксов формата
				end if;
			end if;
			v_fld_value := get_obj_str(r_addr.addr_obj_expanded.district,replace(v_fld,'DISTRICT'));

			--Башкиров В.Г. 28.01.2025
			&debug('v_fld_value=(1)'||v_fld_value,dp)
			var nStruct number;
			nStruct := ::[HOOK_BANK].[GET_PRINT_ADDR_1].Get_ADM_or_MUN(p_addr);
			&debug('nStruct='||nStruct||iif(nStruct=2,' 2-Муниципал',' 1-Адм')
				||' p_addr.[ADDR_OBJ]='||p_addr.[ADDR_OBJ]%class||'.'||p_addr.[ADDR_OBJ]%id||' '||p_addr.[ADDR_OBJ].[NAME]
				||' p_addr.[OKTMO]=['||p_addr.[OKTMO].[CODE]||']-'||p_addr.[OKTMO].[NAME]
				,dp)
			if nStruct=2 and p_addr.[ADDR_OBJ]%class='STREET' and p_addr.[OKTMO] is not null then
				for aoh in ::[ADDR_OBJ_HIERAR] 
				where aoh.[ADDR_OBJ]=p_addr.[ADDR_OBJ] and aoh.[OKTMO]=p_addr.[OKTMO]
				loop
					&debug('aoh.[PARENTID]='||aoh.[PARENTID]%class||'.'||aoh.[PARENTID]%id||' '||aoh.[PARENTID].[NAME],dp)
					v_fld_value:=aoh.[PARENTID].[SHORT_NAME];
					&debug('v_fld_value(2)='||v_fld_value,dp)
					exit;
				end loop;
			end if;

		elsif v_fld like 'SETTLEMENT%' then
			v_fld_value := get_obj_str(r_addr.addr_obj_expanded.settlement,replace(v_fld,'SETTLEMENT'));
		elsif v_fld like 'MAIN_CITY%' then
			v_fld_value := get_obj_str(r_addr.addr_obj_expanded.city,replace(v_fld,'MAIN_CITY'));
		elsif v_fld like 'CITY%' then
			v_fld_value := get_obj_str(r_addr.addr_obj_expanded.town,replace(v_fld,'CITY'));
			if v_fld_value is null and not v_fmt_contains_main_city then
				v_fld_value := get_obj_str(r_addr.addr_obj_expanded.city,replace(v_fld,'CITY'));
			end if;
		elsif v_fld like 'CITY_DISTRICT%' then -- Это устаревший уровень, который нами ошибочно интерпретировался как район города (это внутригородская территория, не имеющая отношения к общепринятым городским районам) 
			v_fld_value := r_addr.address.[DISTRICT].[NAME]; -- Нужно ли далее поддерживать это поле? В приложениях дистрибутива оно не использовалось.
		elsif v_fld like 'SUBAREA%' then
			v_fld_value := get_obj_str(r_addr.addr_obj_expanded.subarea,replace(v_fld,'SUBAREA'));
		elsif v_fld like 'STREET%' then
			v_fld_value := get_obj_str(r_addr.addr_obj_expanded.street,replace(v_fld,'STREET'));
			if v_fld_value is null and not v_fmt_contains_subarea then
				v_fld_value := get_obj_str(r_addr.addr_obj_expanded.subarea,replace(v_fld,'STREET'));
			end if;
			if v_fld_value is null and v_fld in ('STREET','STREET_NT') and r_addr.addr_obj_expanded.subarea.name is null then
				v_fld_value := trim(r_addr.address.[STREET_STR]);
			end if;
		elsif v_fld like 'HOUSE%' then
			if r_addr.house_obj.kladr_list then
				v_fld_value := r_addr.house_str.house.num;
			else
				v_fld_value := coalesce(r_addr.house_obj.num.num,r_addr.house_str.house.num);
			end if;
			if v_fld_value is not null and v_fld not like '%NT%' then
				v_fld_value := get_name_with_type(v_fld_value, coalesce(r_addr.house_obj.num.type_sname,r_addr.house_obj.num.type_name,r_addr.house_str.house.type_sname,r_addr.house_str.house.type_name,'дом'));
			end if;
		elsif v_fld like 'KORPUS%' then -- Корпус
			v_fld_value := coalesce(r_addr.house_obj.num_add1.num,r_addr.house_str.korp.num);
			if v_fld_value is not null and v_fld not like '%NT%' then
				v_fld_value := get_name_with_type(v_fld_value, coalesce(r_addr.house_obj.num_add1.type_sname,r_addr.house_obj.num_add1.type_name,r_addr.house_str.korp.type_sname,r_addr.house_str.korp.type_name,'корпус'));
			end if;
			if v_fld not like '%ONLY%' then -- Корпус со строением
				v_fld_value := trim
					(	v_fld_value || ' ' ||
						get_name_with_type
							( coalesce(r_addr.house_obj.num_add2.num,r_addr.house_str.build.num)
							, coalesce(r_addr.house_obj.num_add2.type_sname,r_addr.house_obj.num_add2.type_name,r_addr.house_str.build.type_sname,r_addr.house_str.build.type_name,'строение')
							)
					);
			end if;
		elsif v_fld like 'BUILD%' or v_fld like 'STRUCTURE%' then -- Строение
			v_fld_value := coalesce(r_addr.house_obj.num_add2.num,r_addr.house_str.build.num);
			if v_fld_value is not null and v_fld not like '%NT%' then
				v_fld_value := get_name_with_type(v_fld_value, coalesce(r_addr.house_obj.num_add2.type_sname,r_addr.house_obj.num_add2.type_name,r_addr.house_str.build.type_sname,r_addr.house_str.build.type_name,'строение'));
			end if;
		elsif v_fld in ('FLAT','FLAT_NT') then -- Квартира/офис
			v_fld_value := r_addr.flat_str.num;
			if v_fld = 'FLAT' then
				v_fld_value := get_name_with_type(v_fld_value,r_addr.flat_str.type_sname);
			end if;
		elsif v_fld = 'IMP_STR' then
			v_fld_value := r_addr.address.[IMP_STR];
		elsif v_fld = 'ADDR_TYPE' then
			v_fld_value := get_address_type(r_addr.address.[TYPE],null).[KOD];
		elsif v_fld = 'KLADR_CODE' then
			v_fld_value := coalesce
				( r_addr.addr_obj_expanded.street.ids.kladr_code
				, r_addr.addr_obj_expanded.subarea.ids.kladr_code
				, r_addr.addr_obj_expanded.town.ids.kladr_code
				, r_addr.addr_obj_expanded.city.ids.kladr_code
				, r_addr.addr_obj_expanded.settlement.ids.kladr_code
				, r_addr.addr_obj_expanded.district.ids.kladr_code
				, r_addr.addr_obj_expanded.region.ids.kladr_code
				);
		end if;
		&debug(TB$||'v_fld_value='||v_fld_value, 0)
		v_str := v_str||v_fld_value;
		&debug(TB$||'v_str='||v_str, 0)
		v_idx := v_format_fields.next(v_idx);
		if v_idx is not null and (v_fld_value is not null or char_bool(p_add_empty)) then
			v_str := v_str||p_delimiter;
		end if;
	end loop;
	if coalesce(::[FP_TUNE].[LIB].get_bool_value('PSB_MUN_DEL_SPACE', stdlib.userid, 0), false)
	or p_addr.[TYPE].[KOD] like 'ASV%' --Башкиров В.Г. 09.04.2025
	then
		v_str:=replace(v_str,p_delimiter||' ',p_delimiter);
		v_str:=replace(v_str,', ', ',');
		v_str:=replace(v_str,'. ', '.');
	end if;
	return v_str;
end;

public function addr_to_str
/* Получение адреса в виде строки определённого формата */
	( p_addr ref [PERSONAL_ADDRESS]
		/* Ссылка на адрес */
	, p_format varchar2(1000) default null
		/* Формат адресной строки */
	, p_delimiter varchar2(10) default null
		/* Символ-разделитель */
	, p_add_empty [BOOLSTRING] default '1'
		/* Добавлять пустые поля */
	, p_struct number default 1
          /* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное */
	)
	/* Строка с адресом */
	return varchar2(4000)
is
	v_address [PERSONAL_ADDRESS];
begin
	&debug('.addr_to_str -- Ссылка p_addr='||p_addr,dp)
	if p_addr is null then
		&debug('.addr_to_str -- Пусто. Выходим',dp)
		return null;
	end if;
	v_address := p_addr;
	return addr_to_str(v_address, p_format, p_delimiter, p_add_empty, p_struct);
end;

public function addr_obj_to_str
/* Получение адреса для адресного объекта в виде строки определённого формата */
	( p_addr_obj ref [ADDRESS_OBJ]
		/* Ссылка на адресный объект */
	, p_format varchar2(1000) default null
		/* Формат адресной строки */
	, p_delimiter varchar2(10) default null
		/* Символ-разделитель */
	, p_add_empty [BOOLSTRING] default '1'
		/* Добавлять пустые поля */
	, p_struct number default 1
        /* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное */
    , p_oktmo ref [OKTMO] default null
    	/* ОКТМО объекта в муниципальном делении. Только для p_struct=2 */
	)
	/* Строка с адресом */
	return varchar2(4000)
is
	v_address [PERSONAL_ADDRESS];
begin
	if p_addr_obj is null then
		return null;
	end if;
	v_address.[ADDR_OBJ]%id := p_addr_obj%id;
	v_address.[OKTMO] := p_oktmo;
	return addr_to_str(v_address, p_format, p_delimiter, p_add_empty, p_struct);
end;

public function get_kladr_house_list_nums (p_intervals varchar2(128)) return rtl.string_table is
-- Функция возвращает массив номеров по списку с интервалами номеров в формате КЛАДР.
-- Номера/интервалы разделены запятыми. В интервале номера разделяются знаком "-". Номера могут ограничиваться только чётными "Ч(2-8)" или нечётными "Н(1-9)".
	v_result rtl.string_table;
	v_tokens rtl.string_table;
	procedure parse_interval(p_interval varchar2(1000)) is
		v_min integer;
		v_max integer;
		v_step integer := 1;
		v_interval varchar2(1000) := p_interval;
		v_odd boolean; 
	begin
		v_odd := case substr(v_interval,1,1) when 'Ч' then true when 'Н' then false end; -- Определяем признак четных/нечетных номеров
		if v_odd is not null then -- Если есть признак чётности/нечетности
			v_interval := regexp_substr(v_interval,'[^()]+',2); -- убираем его из строки вместе со скобками, оставляя только интервал 
			v_step := 2;
		end if;
		v_min := to_number(regexp_substr(v_interval,'^\d+'));
		v_max := to_number(regexp_substr(v_interval,'\d+$'));
		if mod(v_min,2) != (case when v_odd then 0 when not v_odd then 1 end) then
			v_min := v_min + 1; -- Приводим минимальный номер к нужной чётности
		end if;
		while v_min <= v_max loop -- Получаем номера из интервала
			v_result(v_result.count+1) := v_min;
			v_min := v_min + v_step;
		end loop;
	end;
begin
	v_tokens := str2arr(regexp_replace(p_intervals,'\s+'));-- Номера/интервалы разделены запятыми
	for i in 1..v_tokens.count loop
		if regexp_like(v_tokens(i),'^[ЧН]\(.*\)$') or regexp_like(v_tokens(i),'^\d+-\d+$') then -- Это интервал
			parse_interval(v_tokens(i));
		else -- Отдельный номер
			v_result(v_result.count+1) := v_tokens(i);
		end if;
	end loop;
	return v_result;
end;

public procedure str_to_struct
/* Преобразование строки с адресом в структуру, содержащую строковые данные адреса */
	( p_str string(1000)
		/* Строка с данными адреса */
	, p_format string(500)
		/* Формат строки адреса */
	, p_delim string(1)
		/* Разделитель */
	, p_str_rec in out nocopy &api.address_str_rectype
		/* Структура с данными адреса */
	, p_struct in out number
		/* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное, null - автоматическое определение по наличию уровня поселений */
	)
is
	v_value_tbl &clib.Value_Tbl_Type%type;
	v_add_empty [BOOLSTRING];
begin
	&debug('str_to_struct', 0)
	&debug('p_str = '|| p_str, 0)
	&debug('p_format = '|| p_format, 0)
	-- Получение строки формата и разделителя по коду формата
	set_format_parameters(p_format, p_delim, v_add_empty);
	
	&clib.Fill_Values(v_value_tbl, p_format, p_delim, p_str);
	
	-- если тип деления не найден, то определим его
	if p_struct is null then
		if v_value_tbl.exists('SETTLEMENT')
		   or v_value_tbl.exists('SETTLEMENT_TE')
		   or v_value_tbl.exists('SETTLEMENT_NT')
		then
			p_struct := 2;
		else
	   		p_struct := 1;
		end if;
	end if;
	
	p_str_rec.post_code := &clib.Get_Value(v_value_tbl, 'ZIP', 'POST_CODE');
	
	p_str_rec.country.code_nn 	:= &clib.Get_Value(v_value_tbl, 'COUNTRY_CODE');
	p_str_rec.country.code_a2 	:= &clib.Get_Value(v_value_tbl, 'COUNTRY_ALFA2');
	p_str_rec.country.code_a3	:= &clib.Get_Value(v_value_tbl, 'COUNTRY_ALFA3');
	p_str_rec.country.name 		:= &clib.Get_Value(v_value_tbl, 'COUNTRY','COUNTRY_NO');
	p_str_rec.country.full_name := &clib.Get_Value(v_value_tbl, 'COUNTRY_FULL','COUNTRY_NO_FULL');
	
	p_str_rec.kladr_code := &clib.Get_Value(v_value_tbl, 'KLADR_CODE');
	
	p_str_rec.addr_type := &clib.Get_Value(v_value_tbl, 'ADDR_TYPE');
	
	&debug('p_str_rec.region.ids.code='||&clib.Get_Value(v_value_tbl, 'REGION_CODE', 'REGION_NCT_CODE', 'REGION_NCC_CODE'), 0)
	
	p_str_rec.region.ids.code 		:= &clib.Get_Value(v_value_tbl, 'REGION_CODE', 'REGION_NCT_CODE', 'REGION_NCC_CODE');
	p_str_rec.region.ids.kladr_code := &clib.Get_Value(v_value_tbl, 'REGION_LCODE', 'REGION_NCT_LCODE', 'REGION_NCT_LCODE');
	p_str_rec.region.name 			:= &clib.Get_Value(v_value_tbl, 'REGION', 'REGION_NCT', 'REGION_NCC');
	p_str_rec.region.name_te 		:= &clib.Get_Value(v_value_tbl, 'REGION_TE', 'REGION_NCT_TE', 'REGION_NCC_TE');
	p_str_rec.region.name_nt 		:= &clib.Get_Value(v_value_tbl, 'REGION_NT', 'REGION_NCT_NT', 'REGION_NCC_NT');
	
	p_str_rec.district.ids.kladr_code := &clib.Get_Value(v_value_tbl, 'DISTRICT_CODE', 'DISTRICT_NCC_CODE');
	p_str_rec.district.name 	:= &clib.Get_Value(v_value_tbl, 'DISTRICT', 'DISTRICT_NCC');
	p_str_rec.district.name_te 	:= &clib.Get_Value(v_value_tbl, 'DISTRICT_TE', 'DISTRICT_NCC_TE');
	p_str_rec.district.name_nt 	:= &clib.Get_Value(v_value_tbl, 'DISTRICT_NT', 'DISTRICT_NCC_NT');
	
	p_str_rec.settlement.name 		:= &clib.Get_Value(v_value_tbl, 'SETTLEMENT');
	p_str_rec.settlement.name_te	:= &clib.Get_Value(v_value_tbl, 'SETTLEMENT_TE');
	p_str_rec.settlement.name_nt	:= &clib.Get_Value(v_value_tbl, 'SETTLEMENT_NT');
	
	p_str_rec.city.ids.kladr_code	:= &clib.Get_Value(v_value_tbl, 'MAIN_CITY_CODE');
	p_str_rec.city.name 			:= &clib.Get_Value(v_value_tbl, 'MAIN_CITY');
	p_str_rec.city.name_te			:= &clib.Get_Value(v_value_tbl, 'MAIN_CITY_TE');
	p_str_rec.city.name_nt			:= &clib.Get_Value(v_value_tbl, 'MAIN_CITY_NT');
	
	p_str_rec.town.ids.kladr_code	:= &clib.Get_Value(v_value_tbl, 'CITY_CODE');
	p_str_rec.town.name 			:= &clib.Get_Value(v_value_tbl, 'CITY');
	p_str_rec.town.name_te			:= &clib.Get_Value(v_value_tbl, 'CITY_TE');
	p_str_rec.town.name_nt			:= &clib.Get_Value(v_value_tbl, 'CITY_NT');
	
	p_str_rec.city_district := &clib.Get_Value(v_value_tbl, 'CITY_DISTRICT'); -- не используется
	
	p_str_rec.street.ids.kladr_code	:= &clib.Get_Value(v_value_tbl, 'STREET_CODE');
	p_str_rec.street.name			:= &clib.Get_Value(v_value_tbl, 'STREET');
	p_str_rec.street.name_te		:= &clib.Get_Value(v_value_tbl, 'STREET_TE');
	p_str_rec.street.name_nt		:= &clib.Get_Value(v_value_tbl, 'STREET_NT');
	
	p_str_rec.house.num		:= &clib.Get_Value(v_value_tbl, 'HOUSE');
	p_str_rec.house.num_nt	:= &clib.Get_Value(v_value_tbl, 'HOUSE_NT');
	
	p_str_rec.korpus.num	:= &clib.Get_Value(v_value_tbl, 'KORPUS','KORPUS_ONLY');
	p_str_rec.korpus.num_nt := &clib.Get_Value(v_value_tbl, 'KORPUS_NT', 'KORPUS_ONLY_NT');
	
	p_str_rec.building.num := &clib.Get_Value(v_value_tbl, 'BUILD', 'STRUCTURE');
	p_str_rec.building.num_nt := &clib.Get_Value(v_value_tbl, 'BUILD_NT', 'STRUCTURE_NT');
	
	p_str_rec.flat.num		:= replace(&clib.Get_Value(v_value_tbl, 'FLAT'), '&', p_delim); -- в номере квартиры могут встречаться разделители строки формата
	p_str_rec.flat.num_nt	:= replace(&clib.Get_Value(v_value_tbl, 'FLAT_NT'), '&', p_delim); -- такие разделители заменяем на & перед передачей строки адреса в обработку
	
	p_str_rec.addr_str := p_str;
end;

public procedure struct_to_addr
/* Получение адреса из структуры со строковыми данными адреса */
(
	  p_addr in out nocopy [PERSONAL_ADDRESS]
		/* Адрес */
	, p_country	in out ref [COUNTRY]
		/* Страна адреса */
	, p_str_struct in &api.address_str_rectype
		/* Структура адреса */
	, p_struct in number
		/* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное */
	, p_Alt_Names boolean default true
		/* Использовать альтернативные наименования */
	, p_Cache boolean default true
		/* Использовать кэширование типов */
	, p_Add_City boolean default false
		/* Создавать город, если не найден */
	, p_Add_Street	boolean default false
		/* Создавать улицу, если не найдена */
	, p_Gen_Except	boolean default false
		/* Генерировать исключения */
	, p_Kladr number default null
		/* Использовать КЛАДР */
)
is
	kladr_flag		number;
	Region_Ref		ref [CODE_REGION];
	Area_Ref		ref [REGION_AREA];
	Settl_Ref		ref [REGION_AREA];
	City_1_Ref		ref [NAMES_CITY];
	City_2_Ref		ref [NAMES_CITY];
	street_ref		ref [STREET];
	city_ref		ref [NAMES_CITY];
	oktmo			ref [OKTMO];
	p_typeValue		varchar2(50);
begin
	&debug('struct_to_addr', 0)
	-- Кэширование типов
	if p_Cache then
		::[PERSONAL_ADDRESS].[CACHE_LIB].Cache_Kinds_Fill;
		::[PERSONAL_ADDRESS].[CACHE_LIB].Cache_Types_Fill;
	end if;
	&debug('Altnames_Init', 0)
	-- Инициализация альтернативных наименований
	::[PERSONAL_ADDRESS].[CACHE_LIB].Altnames_Init(p_Alt_Names);

	if p_struct is null then
		pragma Error('Не указан тип адресного деления.');
	end if;

	-- Почтовый индекс
	p_Addr.[POST_CODE] := p_str_struct.post_code;

	-- Тип адреса
	Find_Type(p_Str		== p_str_struct.addr_type,
			  p_Type	== p_addr.[TYPE],
			  p_kladr	== kladr_flag);
	
	kladr_flag := nvl(p_Kladr, kladr_flag);
	&debug_var2(kladr_flag, 0)
	
	-- Получаем ссылку на страну
	Find_Country(p_Code		== p_str_struct.country.code_nn,
				 p_Alfa_3	== p_str_struct.country.code_a3,
				 p_Alfa_2	== p_str_struct.country.code_a2,
				 p_Name		== p_str_struct.country.name,
				 p_Full_Name == p_str_struct.country.full_name,
				 p_Kladr	 == kladr_flag,
				 p_Country	== p_country);
				 
	-- Получение района, региона, города, улицы по коду
	Find_By_Code(p_Code		== coalesce(p_str_struct.objectguid, p_str_struct.kladr_code),
				 p_Country	== p_Country,
				 p_Region	== Region_Ref,
				 p_Area		== Area_Ref,
				 p_Settl	== Settl_Ref,
				 p_Main_City == City_1_Ref,
				 p_City		== City_2_Ref,
				 p_Street	== street_ref,
				 p_struct	== p_struct,
				 p_oktmo	== oktmo);
				 
	-- Получение ссылки на регион
	Find_Region(p_Code 		== p_str_struct.region.ids.code,
				p_LCode		== p_str_struct.region.ids.kladr_code,
				p_Name		== p_str_struct.region.name,
				p_Name_TE	== p_str_struct.region.name_te,
				p_Name_NT	== p_str_struct.region.name_nt,
				p_Kladr		== kladr_flag,
				p_Country	== p_Country,
				p_Region	== Region_Ref);
				
	-- если указан индекс и есть данные по дому (GUID, номер дома или номер корпуса) - "разворачиваем" адрес от дома
	if p_str_struct.post_code is not null and Region_Ref is null and
		(p_str_struct.objectguid is not null or 
			p_str_struct.korpus.num is not null or p_str_struct.korpus.num_nt is not null or
			p_str_struct.house.num is not null or p_str_struct.house.num_nt is not null or
			p_str_struct.building.num is not null or p_str_struct.building.num_nt is not null
		)
	then
		-- Корпус
		Find_Value(	p_Str		== p_str_struct.korpus.num,
					p_NT_Str	== p_str_struct.korpus.num_nt,
					p_Level		== 10,
					p_Kladr		== kladr_flag,
					p_Value		== p_Addr.[KORPUS],
					p_typeValue	== p_typeValue);
		
		p_Addr.[ADDR_OBJ] := Find_By_ZIP_House(	p_str_struct	== p_str_struct
												, p_Kladr		== kladr_flag
												, p_struct		== p_struct
												, p_korpus		== p_Addr.[KORPUS]
												, p_korpType	== p_typeValue
												, p_houseRef	== p_Addr.[HOUSE_REF]
												, p_house		== p_Addr.[HOUSE]
												, p_oktmo		== oktmo
											  );
											
											
		if p_Addr.[ADDR_OBJ] is not null then
			street_ref=p_Addr.[STREET_REF] := get_street(p_Addr.[ADDR_OBJ]); -- TODO: удалить при удалении реквизитов
			city_ref=p_Addr.[CITY] := ::[PERSONAL_ADDRESS].[API_LIB].get_city(p_Addr.[ADDR_OBJ]);
			
			if p_Addr.[HOUSE] is null then
				-- Дом
				Find_House(	p_Str		== p_str_struct.house.num,
							p_NT_Str	== p_str_struct.house.num_nt,
							p_city		== city_ref,
							p_street	== street_ref,
							p_Kladr		== kladr_flag,
							p_houseguid == p_str_struct.objectguid,
							p_korpus    == p_Addr.[KORPUS],
							p_korpType	== p_typeValue,
							p_building	== p_str_struct.building.num,
							p_build_NT	== p_str_struct.building.num_nt,
							p_house_ref	== p_Addr.[HOUSE_REF],
							p_house		== p_Addr.[HOUSE]);
			end if;
						
			-- Квартира/офис 
			Find_Value(	p_Str		== p_str_struct.flat.num,
						p_NT_Str	== p_str_struct.flat.num_nt,
						p_Level		== 11,
						p_Kladr		== kladr_flag,
						p_Value		== p_Addr.[FLAT],
						p_typeValue	== p_typeValue);
			
			if p_Addr.[HOUSE_REF] is not null then
				p_Addr.[KORPUS] := p_Addr.[HOUSE_REF].[KORP];
			end if;
		end if;
	end if;	 
	&debug(' p_Addr.[ADDR_OBJ] = ' || p_Addr.[ADDR_OBJ], 0)
	
	if p_Addr.[ADDR_OBJ] is null then
		-- Получение ссылки на район региона
		Find_Area(p_Code 	== p_str_struct.district.ids.kladr_code,
				  p_Name	== p_str_struct.district.name,
				  p_Name_TE	== p_str_struct.district.name_te,
				  p_Name_NT	== p_str_struct.district.name_nt,
				  p_Kladr	== kladr_flag,
				  p_Region	== Region_Ref,
				  p_Area	== Area_Ref,
				  p_Struct	== p_struct,
				  p_oktmo	== oktmo);
		
		if p_struct = 2 then
			-- Получение ссылки на поселение
			Find_Settl(p_Name	== p_str_struct.settlement.name,
					   p_Name_TE == p_str_struct.settlement.name_te,
					   p_Name_NT == p_str_struct.settlement.name_nt,
					   p_Kladr	== kladr_flag,
					   p_Area	== Area_Ref,
					   p_Settl	== Settl_Ref,
					   p_oktmo	== oktmo);
		end if;
		
		-- Город
		begin
			Find_City(p_Code		== p_str_struct.city.ids.kladr_code,
					  p_Name		== p_str_struct.city.name,
					  p_Name_TE		== p_str_struct.city.name_te,
					  p_Name_NT		== p_str_struct.city.name_nt,
					  p_Level		== get_act_level(3),
					  p_Zip			== p_Addr.[POST_CODE],
					  p_Country		== p_Country,
					  p_Region		== Region_Ref,
					  p_Area		== Area_Ref,
					  p_Settl		== Settl_Ref,
					  p_Main_City	== null,
					  p_Create		== p_Add_City,
					  p_Kladr		== kladr_flag,
					  p_City		== City_1_Ref,
					  p_Struct		== p_struct,
					  p_oktmo		== oktmo);
		exception when message.app_exception then
			-- Если населенный пункт не найден, но в наименовании содержится пробел,
			-- то позовем поиск, и в качестве строки для поиска укажем, что это наименование без типа.
			-- Для поиска объектов у которых в наименовании указан текст сопадающий с типом адресного объекта
			-- Например "Снт Оргэнергострой" где снт - это часть наименования
			if City_1_Ref is null and p_str_struct.city.name is not null and instr(trim(p_str_struct.city.name), ' ') > 0 then
				-- Город
				begin
				Find_City(	p_Code		== null,
							p_Name		== null,
							p_Name_TE	== null,
							p_Name_NT	== p_str_struct.city.name,
							p_Level		== get_act_level(3),
							p_Zip		== p_Addr.[POST_CODE],
							p_Country	== p_Country,
							p_Region	== Region_Ref,
							p_Area		== Area_Ref,
							p_Settl		== Settl_Ref,
							p_Main_City	== null,
							p_Create	== p_Add_City,
							p_Kladr		== kladr_flag,
							p_City		== City_1_Ref,
							p_Struct	== p_struct,
							p_oktmo		== oktmo);
				exception when message.app_exception then -- города нет, дальше будем искать населенный пункт
					null;
				end;
			else
				null; -- города нет, дальше будем искать населенный пункт
			end if;
		end;
	
		-- Населенный пункт
		begin
			if City_1_Ref is null then
				Find_City(	p_Code		== p_str_struct.town.ids.kladr_code,
							p_Name		== coalesce(p_str_struct.town.name, p_str_struct.city.name, p_str_struct.region.name),
							p_Name_TE	== coalesce(p_str_struct.town.name_te, p_str_struct.city.name_te, p_str_struct.region.name_te),
							p_Name_NT	== coalesce(p_str_struct.town.name_nt, p_str_struct.city.name_nt, p_str_struct.region.name_nt),
							p_Level		== get_act_level(4),
							p_Zip		== p_Addr.[POST_CODE],
							p_Country	== p_Country,
							p_Region	== Region_Ref,
							p_Area		== Area_Ref,
							p_Settl		== Settl_Ref,
							p_Main_City	== City_1_Ref,
							p_Create	== p_Add_City,
							p_Kladr		== kladr_flag,
							p_City		== City_2_Ref,
							p_Struct	== p_struct,
							p_oktmo		== oktmo);
			else
				Find_City(	p_Code		== p_str_struct.town.ids.kladr_code,
							p_Name		== p_str_struct.town.name,
							p_Name_TE	== p_str_struct.town.name_te,
							p_Name_NT	== p_str_struct.town.name_nt,
							p_Level		== get_act_level(4),
							p_Zip		== p_Addr.[POST_CODE],
							p_Country	== p_Country,
							p_Region	== Region_Ref,
							p_Area		== Area_Ref,
							p_Settl		== Settl_Ref,
							p_Main_City	== City_1_Ref,
							p_Create	== p_Add_City,
							p_Kladr		== kladr_flag,
							p_City		== City_2_Ref,
							p_Struct	== p_struct,
							p_oktmo		== oktmo);
			end if;
		exception when message.app_exception then
			if City_1_Ref is null then
				Find_City(	p_Code		== p_str_struct.town.ids.kladr_code,
							p_Name		== coalesce(p_str_struct.town.name, p_str_struct.city.name, p_str_struct.district.name),
							p_Name_TE	== coalesce(p_str_struct.town.name_te, p_str_struct.city.name_te, p_str_struct.district.name_te),
							p_Name_NT	== coalesce(p_str_struct.town.name_nt, p_str_struct.city.name_nt, p_str_struct.district.name_nt),
							p_Level		== get_act_level(4),
							p_Zip		== p_Addr.[POST_CODE],
							p_Country	== p_Country,
							p_Region	== Region_Ref,
							p_Area		== Area_Ref,
							p_Settl		== Settl_Ref,
							p_Main_City	== City_1_Ref,
							p_Create	== p_Add_City,
							p_Kladr		== kladr_flag,
							p_City		== City_2_Ref,
							p_Struct	== p_struct,
							p_oktmo		== oktmo);
					
			-- Если населенный пункт не найден но в наименовании содержится пробел,
			-- то позовем поиск и в качестве строки для поиска укажем что это наименование без типа.
			-- Для поиска объектов у которых в наименовании указан текст сопадающий с типом адресного объекта
			-- Например "Снт Оргэнергострой" где снт - это часть наименования
			elsif City_2_Ref is null and p_str_struct.town.name is not null and instr(trim(p_str_struct.town.name), ' ') > 0 then
				Find_City(		p_Code		== null,
								p_Name		== null,
								p_Name_TE	== null,
								p_Name_NT	== p_str_struct.town.name,
								p_Level		== get_act_level(4),
								p_Zip		== p_Addr.[POST_CODE],
								p_Country	== p_Country,
								p_Region	== Region_Ref,
								p_Area		== Area_Ref,
								p_Settl		== Settl_Ref,
								p_Main_City	== City_1_Ref,
								p_Create	== p_Add_City,
								p_Kladr		== kladr_flag,
								p_City		== City_2_Ref,
								p_Struct	== p_struct,
								p_oktmo		== oktmo);
			
			elsif  p_str_struct.town.ids.kladr_code is null
				and p_str_struct.town.name  is null
				and p_str_struct.town.name_te is null
				and p_str_struct.town.name_nt is null
			then
				-- Если не нашелся населенный пункт и он не был указан то игнорируем
				null;
			else
				raise;
			end if;
		end;
	
		-- В адрес подставляем населенный пункт, либо если его нет город
		city_ref := nvl(City_2_Ref, City_1_Ref);
		
		-- Район населенного пункта
		Find_City_District( p_Name		== p_str_struct.city_district,
							p_City		== city_ref,
							p_District	== p_Addr.[DISTRICT],
							p_Struct	== p_struct);
	
		-- Улица
		Find_Street(p_Code		== p_str_struct.street.ids.kladr_code,
					p_Name		== p_str_struct.street.name,
					p_Name_TE	== p_str_struct.street.name_te,
					p_Name_NT	== p_str_struct.street.name_nt,
					p_Kladr		== kladr_flag,
					p_Zip		== p_Addr.[POST_CODE],
					p_City		== city_ref,
					p_Create	== p_Add_Street,
					p_Street	== street_ref,
					p_STREET_Str  == p_Addr.[STREET_STR],
					p_Settl		== Settl_Ref,
					p_Region_area == Area_Ref,
					p_Struct	== p_struct,
					p_oktmo		== oktmo);
	
		if street_ref is null and p_str_struct.street.name is not null and instr(trim(p_str_struct.street.name), ' ') > 0 then
			Find_Street(p_Code		== null,
						p_Name		== null,
						p_Name_TE	== null,
						p_Name_NT	== p_str_struct.street.name,
						p_Kladr		== kladr_flag,
						p_Zip		== p_Addr.[POST_CODE],
						p_City		== city_ref,
						p_Create	== p_Add_Street,
						p_Street	== street_ref,
						p_STREET_Str  == p_Addr.[STREET_STR],
						p_Settl		== Settl_Ref,
						p_region_area == Area_Ref,
						p_Struct	== p_struct,
						p_oktmo		== oktmo);
			p_Addr.[STREET_STR] := p_str_struct.street.name;
		end if;
	
		-- Если не определена ссылка на населенный пункт и улицу
		-- при этом строке адреса было указано хотябы одно из этих значений
		if 	city_ref is null
			and street_ref is null
			and (
					   p_str_struct.town.ids.kladr_code is not null
					or p_str_struct.town.name  is not null
					or p_str_struct.town.name_te is not null
					or p_str_struct.town.name_nt is not null
					or p_str_struct.city.ids.kladr_code is not null
					or p_str_struct.city.name  is not null
					or p_str_struct.city.name_te is not null
					or p_str_struct.city.name_nt is not null
					or p_str_struct.street.ids.kladr_code is not null
					or p_str_struct.street.name  is not null
					or p_str_struct.street.name_te is not null
					or p_str_struct.street.name_nt is not null
				)
		then
			p_Addr.[STREET_STR] := null;
			pragma Error('Не найден населенный пункт или элемент улично-дорожной сети.');				
		end if;
	
		-- Корпус
		Find_Value(	p_Str		== p_str_struct.korpus.num,
					p_NT_Str	== p_str_struct.korpus.num_nt,
					p_Level		== 10,
					p_Kladr		== kladr_flag,
					p_Value		== p_Addr.[KORPUS],
					p_typeValue	== p_typeValue);
						
		-- Дом
		Find_House(	p_Str		== p_str_struct.house.num,
					p_NT_Str	== p_str_struct.house.num_nt,
					p_city		== city_ref,
					p_street	== street_ref,
					p_Kladr		== kladr_flag,
					p_houseguid == p_str_struct.objectguid,
					p_korpus    == p_Addr.[KORPUS],
					p_korpType	== p_typeValue,
					p_building	== p_str_struct.building.num,
					p_build_NT	== p_str_struct.building.num_nt,
					p_house_ref	== p_Addr.[HOUSE_REF],
					p_house		== p_Addr.[HOUSE]);
		
		if p_Addr.[HOUSE_REF] is not null then
			p_Addr.[KORPUS] := p_Addr.[HOUSE_REF].[KORP];
		end if;
		
		-- Квартира/офис
		Find_Value(	p_Str		== p_str_struct.flat.num,
					p_NT_Str	== p_str_struct.flat.num_nt,
					p_Level		== 11,
					p_Kladr		== kladr_flag,
					p_Value		== p_Addr.[FLAT],
					p_typeValue	== p_typeValue);
	
		p_Addr.[ADDR_OBJ] := coalesce(street_ref%id, city_ref%id);
		p_Addr.[STREET_REF] := street_ref; -- TODO: удалить при удалении реквизитов
		p_Addr.[CITY] := city_ref;
	end if;
	p_Addr.[OKTMO] := oktmo;
exception
	when others then -- если параметром задано не генерировать исключения, то сохраняем адрес строкой и продолжаем работу
		&debug('Error: '||::[RUNTIME].[UTILS].error_stack, 0)
		if nvl(p_Gen_Except, false) then
			raise;
		else
			if p_str_struct.addr_str is null then
				-- если адрес строкой не задан, то сформируем его
				-- 'POST_CODE,REGION_NCT,DISTRICT,MAIN_CITY,CITY,STREET,HOUSE,KORPUS,FLAT'
				p_str_struct.addr_str := substr(p_str_struct.post_code||', '||
											coalesce(p_str_struct.region.name, p_str_struct.region.name_te, p_str_struct.region.name_nt)||', '||
											coalesce(p_str_struct.district.name, p_str_struct.district.name_te, p_str_struct.district.name_nt)||', '||
											coalesce(p_str_struct.city.name, p_str_struct.city.name_te, p_str_struct.city.name_nt)||', '||
											coalesce(p_str_struct.town.name, p_str_struct.town.name_te, p_str_struct.town.name_nt)||', '||
											coalesce(p_str_struct.street.name, p_str_struct.street.name_te, p_str_struct.street.name_nt)||', '||
											coalesce(p_str_struct.house.num, p_str_struct.house.num_nt)||', '||
											coalesce(p_str_struct.korpus.num, p_str_struct.korpus.num_nt)||', '||
											coalesce(p_str_struct.flat.num, p_str_struct.flat.num_nt)
											, 1, p_str_struct.addr_str%size);
			end if; 
			p_Addr.[IMP_STR] := substr(p_str_struct.addr_str, 1, p_Addr.[IMP_STR]%size);
		end if;
end;

public procedure str_to_addr
/* Получение адреса из строки заданного формата */
(
	  p_addr in out nocopy [PERSONAL_ADDRESS]
		/* Адрес */
	, p_country	in out ref [COUNTRY]
		/* Страна адреса */
	, p_str in string(1000)
		/* Строка адреса */
	, p_format in string(500)
		/* Строка формата */
	, p_struct in out number
		/* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное, null - автоматическое определение по наличию уровня поселений */
	, p_delim in string(1) default null
		/* Разделитель для строки формата */
	, p_Alt_Names boolean default true
		/* Использовать альтернативные наименования */
	, p_Cache boolean default true
		/* Использовать кэширование типов */
	, p_Add_City boolean default false
		/* Создавать город, если не найден */
	, p_Add_Street	boolean default false
		/* Создавать улицу, если не найдена */
	, p_Gen_Except	boolean default false
		/* Генерировать исключения */
	, p_Kladr number default null
		/* Использовать КЛАДР */
)
is
	v_str_rec &api.address_str_rectype;
begin
	&debug('str_to_addr', 0)
	-- разобрать строку в структуру
	str_to_struct(p_str, p_format, p_delim, v_str_rec, p_struct);
	
	-- вызвать struct_to_addr
	struct_to_addr(p_addr
				 , p_country
				 , v_str_rec
				 , p_struct
				 , p_Alt_Names
				 , p_Cache
				 , p_Add_City
				 , p_Add_Street
				 , p_Gen_Except
				 , p_Kladr);
exception
	when others then -- если параметром задано не генерировать исключения, то сохраняем адрес строкой и продолжаем работу
		&debug('Error: '||::[RUNTIME].[UTILS].error_stack, 0)
		if nvl(p_Gen_Except, false) then
			raise;
		else
			p_Addr.[IMP_STR] := substr(p_str, 1, p_Addr.[IMP_STR]%size);
		end if;
end;

-- *** Подпрограммы, дублирующие функционал из PERSONAL_ADDRES.LIB ***

pragma macro ('REF_IS_NOT_NECESSARY', 			'[1] < 1', substitute);
pragma macro ('KLADR_IS_NOT_NECESSARY', 		'[1] < 2', substitute);
pragma macro ('STREET_REF_IS_NOT_NECESSARY', 	'[1] < 3', substitute);
pragma macro ('HOUSE_REF_IS_NOT_NECESSARY', 	'[1] < 4', substitute);

public function get_country -- Получения страны для адресного объекта.
	( p_obj ref [ADDRESS_OBJ] -- Ссылка на адресный объект.
	)
	return ref [COUNTRY] -- Ссылка на справочник "Общероссийский классификатор стран мира".
is
begin
	for (with recursive rc(id, parent, lvl, nocyc) as (
			select x(x, x.[PARENT], 1, ','||x||',') in ::[ADDRESS_OBJ] where x = p_obj
			union all
			select x(x, x.[PARENT], rr.lvl+1, rr.nocyc||x||',') in ::[ADDRESS_OBJ] join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
		 select r(case r%class
					when ::[CODE_REGION]%class then (select c(c.[COUNTRY]) in ::[CODE_REGION] where c%id = r%id)
					when ::[NAMES_CITY]%class then (select c(c.[COUNTRY]) in ::[NAMES_CITY] where c%id = r%id)
				  end : country)
		 in ::[ADDRESS_OBJ] join (rc : rr) on rr.id = r
		 where r%class in (::[CODE_REGION]%class,::[NAMES_CITY]%class) -- Убираем из иерархии объекты, у которых не может быть страны
		 order by rr.lvl asc nulls last -- Приоритет у города (меньший уровень иерархии)
		 fetch 1)
	loop
		return r.country;
	end loop;
	return null;
end;

function get_parent_addr_obj -- Получение для адресного объекта первого вышестоящего заданного типа(класса).
	( p_obj ref [ADDRESS_OBJ] -- Ссылка на адресный объект.
	, p_class varchar2(128) -- Требуемый тип(класс) адресного объекта
	, p_level integer := null -- Требуемый уровень адресного объекта
	)
	return ref [ADDRESS_OBJ] -- Ссылка на адресный объект
is
begin
	if p_level is null then
		for (with recursive rc(id, parent, cls, nocyc) as (
				select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = p_obj
				union all
				select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
				in ::[ADDRESS_OBJ]
				join (rc : rr) on rr.parent = x and rr.cls <> p_class and instr(rr.nocyc, ','||x||',') = 0)
			 select r(r.id : obj) in rc where r.cls = p_class)
		loop
			return r.obj;
		end loop;
	else
		for (with recursive rc(id, parent, lvl, nocyc) as (
				select x(x, x.[PARENT], 1, ','||x||',') in ::[ADDRESS_OBJ] where x = p_obj
				union all
				select x(x, x.[PARENT], rr.lvl+1, rr.nocyc||x||',')
				in ::[ADDRESS_OBJ]
				join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
			 select o(o : obj)
			 in ::[ADDRESS_OBJ]
			 join (rc : rr) on o = rr.id
			 join (::[PEOPLE_PLACE] : t) on o.[KIND] = t and t.[OBJ_LEVEL] = p_level
			 where o%class = p_class
			 order by rr.lvl)
		loop
			return o.obj;
		end loop;
	end if;
	return null;
end;

public function get_region -- Получение региона для адресного объекта.
	( p_obj ref [ADDRESS_OBJ] -- Ссылка на адресный объект.
	)
	return ref [CODE_REGION] -- Ссылка на справочник "Адрес. Регионы"
is
	v_obj ref [CODE_REGION];
begin
	v_obj%id := get_parent_addr_obj(p_obj,::[CODE_REGION]%class)%id;
	return v_obj;
end;

public function get_district -- Получение района региона для адресного объекта.
	( p_obj ref [ADDRESS_OBJ] -- Ссылка на адресный объект.
	)
	return ref [REGION_AREA] -- Ссылка на справочник "Адрес. Районы регионов"
is
	v_obj ref [REGION_AREA];
begin
	v_obj%id := get_parent_addr_obj(p_obj,::[REGION_AREA]%class)%id;
	return v_obj;
end;

public function get_city -- Получение населённого пункта для адресного объекта.
	( p_obj ref [ADDRESS_OBJ] -- Ссылка на адресный объект.
	, p_main [BOOLSTRING] := '1' -- Признак получения только адресного объекта уровня "город"
	)
	return ref [NAMES_CITY] -- Ссылка на справочник "Адрес. Населенные пункты"
is
	v_obj ref [NAMES_CITY];
begin
	if p_main = '1' then
		v_obj%id := get_parent_addr_obj(p_obj,::[NAMES_CITY]%class,v_level_city)%id; -- Вернёт только адресный объект уровня "город", если он есть.
	else
		v_obj%id := get_parent_addr_obj(p_obj,::[NAMES_CITY]%class)%id; -- Если объект уровня "населённый пункт" отсутствует в иерархии, то вернёт адресный объект уровня "город". 
	end if;
	return v_obj;
end;

public function get_main_city -- Получение адресного объекта уровня "город".
	( p_obj ref [ADDRESS_OBJ] -- Ссылка на адресный объект.
	)
	return ref [NAMES_CITY] -- Ссылка на справочник "Адрес. Населенные пункты"
is
begin
	return get_city(p_obj,'1');
end;

public function get_street -- Получение улицы адресного объекта.
	( p_obj ref [ADDRESS_OBJ] -- Ссылка на адресный объект.
	)
	return ref [STREET] -- Ссылка на справочник "Адрес. Улично-дорожная сеть"
is
	v_obj ref [STREET];
begin
	v_obj%id := get_parent_addr_obj(p_obj,::[STREET]%class)%id;
	return v_obj;
end;

public function get_str_for_personal_address
/* Получить текстовое представление адреса для заполнения реквизита "Импортировано/Адрес строкой". Может быть перекрыта точкой вызова с кодом "GET_PRINT_ADDR_1". */
	( p_addr [PERSONAL_ADDRESS]
		/* Адрес */
	, p_struct number default 1
          /* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное */
	)
	/* Адрес строкой */
	return ::[PERSONAL_ADDRESS].[IMP_STR]%type
is
	v_addr varchar2(4000);
begin
												   &debug('.get_str_for_personal_address > Стр.адр.деления   p_struct='||p_struct,dp)
	if p_addr.[INPUT_STRUCT] is not null then null;&debug('.get_str_for_personal_address > Тип деления(адм/муниципал)='||p_addr.[INPUT_STRUCT],dp)
	end if;
	if p_addr.[IMP_STR] is not null then null;     &debug('.get_str_for_personal_address > Адрес строкой             ='||p_addr.[IMP_STR],dp)
	end if;
	if p_addr.[HOUSE] is not null then null;       &debug('.get_str_for_personal_address > Дом                       ='||p_addr.[HOUSE],dp)
	end if;
	if p_addr.[KORPUS] is not null then null;      &debug('.get_str_for_personal_address > Корпус                    ='||p_addr.[KORPUS],dp)
	end if;
	if p_addr.[FLAT] is not null then null;        &debug('.get_str_for_personal_address > Квартира / комната        ='||p_addr.[FLAT],dp)
	end if;
	if p_addr.[DISTRICT] is not null then null;    &debug('.get_str_for_personal_address > Район нас.пункта (ref)    =['||p_addr.[DISTRICT].[OKTMO].[CODE]||']-'||p_addr.[DISTRICT].[OKTMO].[NAME]||' '||p_addr.[DISTRICT].[NAME],dp)
	end if;
	if p_addr.[HOUSE_REF] is not null then null;   &debug('.get_str_for_personal_address > Дом (ref)                 =['||p_addr.[HOUSE_REF].[OKTMO].[CODE]||']-'||p_addr.[HOUSE_REF].[OKTMO].[NAME]||' '||p_addr.[HOUSE_REF].[NAME],dp)
	end if;
	if p_addr.[STREET_STR] is not null then null;  &debug('.get_str_for_personal_address > Улица (строкой)           ='||p_addr.[STREET_STR],dp)
	end if;
	if p_addr.[FIX_PRINT] is not null then null;   &debug('.get_str_for_personal_address > Фиксировать               ='||p_addr.[FIX_PRINT],dp)
	end if;
	if p_addr.[REG_DATE] is not null then null;    &debug('.get_str_for_personal_address > Дата регистрации          ='||to_char(p_addr.[REG_DATE],fmt),dp)
	end if;
	if p_addr.[REG_END_DATE] is not null then null;&debug('.get_str_for_personal_address > Дата окончания регистрации='||to_char(p_addr.[REG_END_DATE],fmt),dp)
	end if;
	if p_addr.[ADDR_OBJ] is not null then null;    &debug('.get_str_for_personal_address > Адресный объект           ='||p_addr.[ADDR_OBJ]%class||'.'||p_addr.[ADDR_OBJ]%id||' '||p_addr.[ADDR_OBJ].[FULL_NAME]||' ['||p_addr.[ADDR_OBJ].[OKTMO].[CODE]||']-'||p_addr.[ADDR_OBJ].[OKTMO].[NAME],dp)
	end if;
	if p_addr.[OKTMO] is not null then null;       &debug('.get_str_for_personal_address > OKTMO                     =['||p_addr.[OKTMO].[CODE]||']-'||p_addr.[OKTMO].[NAME],dp)
	end if;

	&debug('.get_str_for_personal_address -- Вызываем HOOK.GET_PRINT_ADDR_1',dp)
	v_addr := ::[HOOK].[GET_PRINT_ADDR_1](p_addr);
	&debug('.get_str_for_personal_address -- v_addr='||v_addr,dp)
	if v_addr is null then
		if p_struct = 1 then
			v_addr := addr_to_str(p_addr, 'COUNTRY_NO,ZIP,REGION,DISTRICT,MAIN_CITY,CITY,SUBAREA,STREET,HOUSE,KORPUS_ONLY,BUILD,FLAT', ', ','0');
		elsif p_struct = 2 then
			v_addr := addr_to_str(p_addr, 'COUNTRY_NO,ZIP,REGION,DISTRICT,SETTLEMENT,MAIN_CITY,CITY,SUBAREA,STREET,HOUSE,KORPUS_ONLY,BUILD,FLAT', ', ','0');
		end if;
		v_addr := substr(v_addr, 1, ::[PERSONAL_ADDRESS].[IMP_STR]%size);
	end if;

	if p_addr.[IMP_STR] is not null then null;     &debug('.get_str_for_personal_address < Адрес строкой             ='||p_addr.[IMP_STR],dp)
	end if;
	if p_addr.[HOUSE] is not null then null;       &debug('.get_str_for_personal_address < Дом                       ='||p_addr.[HOUSE],dp)
	end if;
	if p_addr.[KORPUS] is not null then null;      &debug('.get_str_for_personal_address < Корпус                    ='||p_addr.[KORPUS],dp)
	end if;
	if p_addr.[FLAT] is not null then null;        &debug('.get_str_for_personal_address < Квартира / комната        ='||p_addr.[FLAT],dp)
	end if;
	if p_addr.[DISTRICT] is not null then null;    &debug('.get_str_for_personal_address < Район нас.пункта (ref)    =['||p_addr.[DISTRICT].[OKTMO].[CODE]||']-'||p_addr.[DISTRICT].[OKTMO].[NAME]||' '||p_addr.[DISTRICT].[NAME],dp)
	end if;
	if p_addr.[HOUSE_REF] is not null then null;   &debug('.get_str_for_personal_address < Дом (ref)                 =['||p_addr.[HOUSE_REF].[OKTMO].[CODE]||']-'||p_addr.[HOUSE_REF].[OKTMO].[NAME]||' '||p_addr.[HOUSE_REF].[NAME],dp)
	end if;
	if p_addr.[STREET_STR] is not null then null;  &debug('.get_str_for_personal_address < Улица (строкой)           ='||p_addr.[STREET_STR],dp)
	end if;
	if p_addr.[FIX_PRINT] is not null then null;   &debug('.get_str_for_personal_address < Фиксировать               ='||p_addr.[FIX_PRINT],dp)
	end if;
	if p_addr.[REG_DATE] is not null then null;    &debug('.get_str_for_personal_address < Дата регистрации          ='||to_char(p_addr.[REG_DATE],fmt),dp)
	end if;
	if p_addr.[REG_END_DATE] is not null then null;&debug('.get_str_for_personal_address < Дата окончания регистрации='||to_char(p_addr.[REG_END_DATE],fmt),dp)
	end if;
	if p_addr.[ADDR_OBJ] is not null then null;    &debug('.get_str_for_personal_address < Адресный объект           ='||p_addr.[ADDR_OBJ]%class||'.'||p_addr.[ADDR_OBJ]%id||' '||p_addr.[ADDR_OBJ].[FULL_NAME]||' ['||p_addr.[ADDR_OBJ].[OKTMO].[CODE]||']-'||p_addr.[ADDR_OBJ].[OKTMO].[NAME],dp)
	end if;
	if p_addr.[INPUT_STRUCT] is not null then null;&debug('.get_str_for_personal_address < Тип деления(адм/муниципал)='||p_addr.[INPUT_STRUCT],dp)
	end if;
	return v_addr;
end;

function get_act_level(p_level number) return number is
begin
	return nvl(get_level(p_level,0), p_level);
end;

public function Get_KLADR_MODE
/*Получение значения настройки. Установка пользовательского контекста.
Читаем настройку KLADR_MODE (критерий по Типу адреса) и устанавливаем ее в контекст пользователя,
так же в контекст устанавливаем город. Это нужно для кооректного отображения в представлении VW_CRIT_SPRAV_STREET_OPER.
Возвращаем прочитанное значение KLADR_MODE*/
(	
	P_TYPE ref [ADDRESS_TYPE]
		/*тип адреса*/
	, P_CITY ref [NAMES_CITY] default null
		/*населённый пункт*/
	, P_COUNTRY ref [COUNTRY] default null
		/*страна*/
)
/*значение настройки KLADR_MODE*/
return integer is
tune_kladr integer;
begin
	if p_country is null and p_city is not null then
		p_country := p_city.[COUNTRY];
	end if;
	
	if p_country is not null and p_country <> v_our_country_ref then 		
		return 0;
	end if;
	
	tune_kladr := nvl(::[FP_TUNE].[LIB].get_num_value('KLADR_MODE', ::[FP_TUNE].[LIB].set_canons('ADDRESS_TYPE', P_TYPE%id), '0'), 0);
	return tune_kladr;
end;

-- Получаем тип региона
procedure Extract_Name_Type(
						p_Str			::[PERSONAL_ADDRESS].[CACHE_LIB].Addr_Str_Type%type,
						p_Level			integer,
						p_Kladr			number,
						p_Name			in out ::[PERSONAL_ADDRESS].[CACHE_LIB].Addr_Str_Type%type,
						p_Type			in out ref [PEOPLE_PLACE],
						p_Type_Name		in out ::[PEOPLE_PLACE].[NAME]%type,
						p_Type_SName	in out ::[PEOPLE_PLACE].[SHORT_NAME]%type,
						p_type_end		boolean default null -- признак того, что тип объекта нужно искать в конце наименования
					)
is
	Tmp	::[PERSONAL_ADDRESS].[CACHE_LIB].Addr_Str_Type%type;
	county_ref ref [PEOPLE_PLACE];
	county_short ::[PEOPLE_PLACE].[SHORT_NAME]%type;
begin
	&debug('Extract_Name_Type',0)
	&debug_var2(p_Str,0)
	&debug_var2(p_type_end,0)
	p_Type := null;
	p_Name := null;
	
	Tmp := trim(p_Str);

	if Tmp is not null and instr(Tmp, ' ') > 0 then
		-- Убираем из строки лишние пробелы. После этого заменяем пробелы на знак '#'
		Tmp := regexp_replace(Tmp, ' +', ' ');
		Tmp := translate(Tmp, ' ', '#');
		Tmp := upper(Tmp);
		&debug_var2(Tmp, 0)
		&debug_var2(p_Level, 0)
		
		-- Если уровень объекта меньше шести или 8 по ФИАС, то ищем его тип по справочнику типов, иначе
		-- (корпус, строение, квартира) только среди альтернативных наименований
		if p_Level <= get_act_level(6) or p_Level in (get_level(65,2), get_level(90,2)) then
			if not nvl(::[PERSONAL_ADDRESS].[CACHE_LIB].get_Cache_Kinds_On, false) then
				&debug('ищем в БД по сокращенному наименованию',0)
				-- Поиск по сокращенному наименованию
				for (
					select t(t: T_REF, t.[SHORT_NAME]: T_NAME)
					in ::[PEOPLE_PLACE]
					where (
						Tmp like upper(t.[SHORT_NAME]) || '#%' and (not p_type_end or p_type_end is null)
						or Tmp like '%#' || upper(t.[SHORT_NAME]) and (p_type_end or p_type_end is null)
						)
						and t.[OBJ_LEVEL] = p_Level
					order by length(t.[SHORT_NAME]) desc
					)
				loop
					p_Type := t.T_REF;
					p_Type_Name := t.T_NAME;
					p_Type_SName := t.T_NAME;
					exit;
				end loop;

				-- исключение для "округа"
				if p_Type is not NULL and upper(p_Type_Name) = 'ОКРУГ' then
					county_ref := p_Type; -- запомним его, но поищем по наименованию, т.к. это мог быть АВТОНОМНЫЙ ОКРУГ
					county_short := p_Type_Name;
					p_Type := NULL;
				end if;
				
				if p_Type is null then
					-- Поиск по полному наименованию
					&debug('ищем в БД по полному наименованию',0)
					for (
						select t(t: T_REF, t.[NAME]: T_NAME, t.[SHORT_NAME]: T_SHORT_NAME)
						in ::[PEOPLE_PLACE]
						where (
							Tmp like translate(upper(t.[NAME]), ' ', '#') || '#%' escape '!' and (not p_type_end or p_type_end is null)
							or Tmp like '%#' || translate(upper(t.[NAME]), ' ', '#') and (p_type_end or p_type_end is null)
							)
							and t.[OBJ_LEVEL] = p_Level
						order by case instr(t.[NAME], ' ') when 0 then 1 else 2 end -- больше 1 слова в приоритете
							, length(t.[NAME]) desc
						)
					loop
						p_Type := t.T_REF;
						p_Type_Name := t.T_NAME;
						p_Type_SName := t.T_SHORT_NAME;
						exit;
					end loop;
				end if;
				-- возвращение "округа"
				if county_ref is not NULL and p_Type is NULL or p_Type = county_ref then
					p_Type := county_ref;
					p_Type_Name := county_short;
					p_Type_SName := p_Type_Name;
				end if;
			else
				&debug('ищем в кэше',0)
				-- Ищем тип в кэше
				::[PERSONAL_ADDRESS].[CACHE_LIB].Cache_Kind_Find(
					p_Str		== Tmp,
					p_Level		== p_Level,
					p_Kind_Ref	== p_Type,
					p_Kind_Name	== p_Type_Name,
					p_Kind_SName== p_Type_SName,
					p_type_end	== p_type_end);
			end if;
		end if;
		-- Если тип не определен, пробуем его определить по
		-- альтернативному наименованию
		if p_Type is null and (::[PERSONAL_ADDRESS].[CACHE_LIB].get_Altnames_On or p_Level >= get_act_level(6)) then
			&debug('ищем по альтернативным',0)
			::[PERSONAL_ADDRESS].[CACHE_LIB].Altnames_Find(
				p_Str		== Tmp,
				p_Level		== p_Level,
				p_Kind_Ref	== p_Type,
				p_Kind_Name	== p_Type_Name,
				p_Kind_SName== p_Type_SName,
				p_type_end	== p_type_end);
		end if;
	end if;
	
	if p_Type is null and p_Type_Name is null then
		-- Если тип адресного объекта не определен, считаем,
		-- что задано только наименование объекта
		p_Name := p_Str;
	else
		if instr(Tmp, upper(p_Type_Name)||'#') = 1 then
			-- Тип задан в начале строки
			p_Name := trim(substr(p_Str, length(p_Type_Name)+2));
		else
			-- Тип задан в конце строки
			p_Name := trim(substr(p_Str, 1, length(p_Str)-length(p_Type_Name)-1));
		end if;
	end if;
	
	&debug_var2(p_Name, 0)
	&debug_var2(p_Type.[NAME], 0)
	&debug_var2(p_Type_SName, 0)
	&debug_var2(p_Type%id, 0)
end;

-- Поиск типа адреса
procedure Find_Type(	p_Str		varchar2(200),
						p_Type		in out ::[PERSONAL_ADDRESS].[TYPE]%type,
						p_kladr		in out number) is
begin
	&debug('Find_Type', 0)

	if p_Type is null then
		if not nvl(::[PERSONAL_ADDRESS].[CACHE_LIB].get_Cache_Types_On, false) then
			-- Ищем тип в справочнике
			begin
				select z(z)
					in ::[ADDRESS_TYPE]
					where upper(z.[KOD]) = p_Str
					into p_Type;
			exception
				when NO_DATA_FOUND then
					pragma Error('Не найден тип адреса по коду "'||p_Str||'".');
				when TOO_MANY_ROWS then
					pragma Error('По коду "'||p_Str||'" найдено несколько типов адреса.');
			end;
		else
			-- Ищем тип в кэше
			p_Type := ::[PERSONAL_ADDRESS].[CACHE_LIB].Cache_Types_Find(p_Str);
		end if;
	end if;
	p_kladr := Get_Kladr_Mode(p_type == p_type);
	&debug_var2(p_Type.[KOD], 0)
	&debug_var2(p_kladr, 0)
end;

-- Возвращает ссылку на тип по наименованию
function Get_Type(	p_Level		integer,
					p_Name		varchar2(100)) return ref [PEOPLE_PLACE]
is
Type_Ref ref [PEOPLE_PLACE];
begin
	if not nvl(::[PERSONAL_ADDRESS].[CACHE_LIB].get_Cache_Kinds_On, false) then
		-- Поиск по сокращенному наименованию
		begin
			select t(t)
				in ::[PEOPLE_PLACE]
				where
					upper(t.[SHORT_NAME])	= upper(p_Name) or
					upper(t.[NAME])			= upper(p_Name)
				into Type_Ref;
		exception
			when NO_DATA_FOUND then null;
			when TOO_MANY_ROWS then null;
		end;
	else
		Type_Ref := ::[PERSONAL_ADDRESS].[CACHE_LIB].Cache_Get_Kind(p_Level == p_Level,	p_Name	== p_Name);
	end if;
	
	return Type_Ref;
end;

-- Поиск страны
procedure Find_Country(	p_Code		varchar2(200),
						p_Alfa_3	varchar2(200),
						p_Alfa_2	varchar2(200),
						p_Name		varchar2(200),
						p_Full_Name	varchar2(200),
						p_Kladr		in out number,
						p_Country	in out ref [COUNTRY])
is
Find boolean;
begin
	&debug('Find_Country', 0)

	if p_Country is null then
		-- Правильно ли заданы коды?
		if p_Code is not null and length(p_Code) <> 3 then
			pragma Error('Цифровой код страны должен состоять из трех цифр.');
		elsif p_Alfa_3 is not null and length(p_Alfa_3) > 3 then
			pragma Error('Буквенный код страны "ALFA_3" должен состоять из трех символов.');
		elsif p_Alfa_2 is not null and length(p_Alfa_2) > 2 then
			pragma Error('Буквенный код страны "ALFA_2" должен состоять из двух символов.');
		end if;
		
		if	p_Code = v_our_country.[CODE] or p_Alfa_3 = v_our_country.[ALFA_3] or p_Alfa_2 = v_our_country.[ALFA_2]
			or (p_Name is not null and upper(v_our_country.[VALUE]) = upper(p_Name))
			or (p_Full_Name is not null and upper(v_our_country.[NAME]) = upper(p_Full_Name))
			or (p_Code is null and p_Alfa_3 is null and p_Alfa_2 is null and p_Name is null and p_Full_Name is null)
		then
			p_Country	:= v_our_country_ref;
		else
			-- В чужой стране ищем без КЛАДР
			p_Kladr	:= 0;
			Find	:= false;

			-- Поиск по коду
			if p_Code is not null then
				Find := true;
				begin
					pragma hint('index(plp$hint(c) idx_z#country_code)');
					select c(c)
						in ::[COUNTRY]
						where c.[CODE] = p_Code
						into p_Country;
				exception
					when NO_DATA_FOUND then
						null;
					when TOO_MANY_ROWS then
						pragma Error('По числовому коду "'||p_Code||'" найдено несколько стран.');
				end;
			end if;

			-- Поиск по 3-х буквенному коду
			if p_Country is null and p_Alfa_3 is not null then
				Find := true;
				begin
					pragma hint('index(plp$hint(c) idx_z#country_alfa_3)');
					select c(c)
						in ::[COUNTRY]
						where c.[ALFA_3] = p_Alfa_3
						into p_Country;
				exception
					when NO_DATA_FOUND then
						null;
					when TOO_MANY_ROWS then
						pragma Error('По буквенному коду "'||p_Alfa_3||'" найдено несколько стран.');
				end;
			end if;

			-- Поиск по 2-х буквенному коду
			if p_Country is null and p_Alfa_2 is not null then
				Find := true;
				begin
					pragma hint('index(plp$hint(c) idx_z#country_alfa_2)');
					select c(c)
						in ::[COUNTRY]
						where c.[ALFA_2] = p_Alfa_2
						into p_Country;
				exception
					when NO_DATA_FOUND then
						null;
					when TOO_MANY_ROWS then
						pragma Error('По буквенному коду "'||p_Alfa_2||'" найдено несколько стран.');
				end;
			end if;

			-- Поиск по наименованию
			if p_Country is null and p_Name is not null then
				Find := true;
				begin
					select c(c)
						in ::[COUNTRY]
						where upper(c.[VALUE]) = upper(p_Name)
						into p_Country;
				exception
					when NO_DATA_FOUND then
						null;
					when TOO_MANY_ROWS then
						pragma Error('По наименованию "'||p_Name||'" найдено несколько стран.');
				end;
			end if;

			-- Поиск по полному наименованию
			if p_Country is null and p_Full_Name is not null then
				Find := true;
				begin
					select c(c)
						in ::[COUNTRY]
						where upper(c.[NAME]) = upper(p_Full_Name)
						into p_Country;
				exception
					when NO_DATA_FOUND then
						null;
					when TOO_MANY_ROWS then
						pragma Error('По полному наименованию "'||p_Full_Name||'" найдено несколько стран.');
				end;
			end if;

			if p_Country is null and Find then
				pragma Error('Не найдена страна по заданым реквизитам.');
			end if;
		end if;
	end if;
	&debug_var2(p_Country.[VALUE], 0)
end;

-- Получение района, региона, города, улицы по коду
procedure Find_By_Code(	p_Code		varchar2(200),
						p_Country	ref [COUNTRY],
						p_Region	in out ref [CODE_REGION],
						p_Area		in out ref [REGION_AREA],
						p_Settl		in out ref [REGION_AREA],
						p_Main_City	in out ref [NAMES_CITY],
						p_City		in out ref [NAMES_CITY],
						p_Street	in out ref [STREET],
						p_struct	number,
						p_oktmo		in out ref [OKTMO])
is
	L	integer;
	v_guid string(1) := '0';
	v_exp_obj &api.addr_obj_expanded_rectype;
begin
	&debug('Find_By_Code', 0)
	&debug_var2(p_Code, 0)
	
	if p_Code is not null then
		-- Переход от guid дома к guid объекта
		for (select x(x.[AOGUID] : aoguid) in ::[ADDRESS_OBJ] 
			 left join (::[HOUSES] : h) on x%id = h.[AOGUID]
			where h.[HOUSEGUID] = p_Code order by h.[ENDDATE] desc nulls first fetch 1) 
		loop			
			p_code := x.aoguid;
		end loop;
	end if;  
	
	if p_Code is not null and p_Country = v_our_country_ref then
		-- Получение полного кода объекта
		L := length(p_Code);
		if L = 2 then
			p_code := rPAD(p_code, 13, '0');
		elsif L in (11, 15) then
			p_Code := p_Code||'00';
		elsif L = 36 then
			v_guid := '1';
		end if;
		
		-- Определим уровень объекта
		for (select obj1(obj1 : obj_id, obj1.[OKTMO] : oktmo)
			 in ::[ADDRESS_OBJ]
			 where (v_guid = '0' and obj1.[KLADR] like substr(p_Code, 1, length(p_Code)-2)||'__')
					or
				   (v_guid = '1' and obj1.[AOGUID] = p_Code)
			 order by nvl(obj1.[ARCHAIC], false),  --desc иначе первой становится "неактуальная" запись
					  case v_guid when '0' 
					  	then case when obj1.[KLADR] = p_Code or obj1.[KLADR] is null and p_Code is null then 1 else 0 end 
					  	when '1' then 1 
					  end,
					  case v_guid when '0' then substr(obj1.[KLADR], -2) when '1' then '1' end,
					  obj1.[NEW_NAME] asc nulls first)
		loop
			-- определим ОКТМО объекта
			if p_struct = 2 then
				p_oktmo := get_oktmo(obj1.obj_id, p_oktmo);
			else
				p_oktmo := obj1.oktmo;
			end if;
			
			v_exp_obj := get_addr_obj_expanded(obj1.obj_id, p_struct, p_oktmo);
			
			p_Region := v_exp_obj.region.id;
			p_Area := v_exp_obj.district.id;
			p_Main_City := v_exp_obj.city.id;
			p_City := v_exp_obj.town.id;
			p_Street := coalesce(v_exp_obj.street.id, v_exp_obj.subarea.id);
			p_Settl := v_exp_obj.settlement.id;
			
			exit;
		end loop;
	end if;
	
	&debug('p_Region.[NAME]='||p_Region.[NAME], 0)
	&debug('p_Region.[CODE]='||p_Region.[CODE], 0)
	&debug('p_Area.[NAME]='||p_Area.[NAME], 0)
	&debug('p_Area.[KLADR]='||p_Area.[KLADR], 0)
	&debug('p_Main_City.[NAME]='||p_Main_City.[NAME], 0)
	&debug('p_Main_City.[KLADR]='||p_Main_City.[KLADR], 0)
	&debug('p_City.[NAME]='||p_City.[NAME], 0)
	&debug('p_City.[KLADR]='||p_City.[KLADR], 0)
	&debug('p_Settl.[NAME]='||p_Settl.[NAME], 0)
end;

-- Поиск региона
procedure Find_Region(	p_Code 		varchar2(200),
						p_LCode		varchar2(200),
						p_Name		varchar2(200),
						p_Name_TE	varchar2(200),
						p_Name_NT	varchar2(200),
						p_Country	ref [COUNTRY],
						p_Kladr		number,
						p_Region	in out ref [CODE_REGION])
is
	Type_Ref	ref [PEOPLE_PLACE];
	Type_Name	::[PEOPLE_PLACE].[NAME]%type;
	Type_SName	::[PEOPLE_PLACE].[SHORT_NAME]%type;
	Name		::[PERSONAL_ADDRESS].[CACHE_LIB].Addr_Str_Type%type;
begin
	&debug('Find_Region', 0)


	if p_Region is null then
		
		-- Правильно ли задан код региона?
		if p_Code is not null and length(p_Code) <> 2 then
			pragma Error('Двузначный код региона должен состоять из 2-х цифр.');
		end if;

		if	p_Code is not null or p_LCode is not null or
			p_Name is not null or p_Name_TE is not null or p_Name_NT is not null
		then
			p_Name := coalesce(p_Name, p_Name_TE);

			-- Задана ли страна
			if p_Country is null then
				pragma Error('Не задана страна региона.');
			end if;

			-- Ищем по коду
			if p_Code is not null then
				for (
					select r(r : R)
					in ::[CODE_REGION]
					where r.[CODE] = p_Code
						and r.[COUNTRY] = p_Country
					order by nvl(r.[ARCHAIC], false)
							, r.[AOGUID] -- выбираем записи с ГУИДом как приоритетные
					)
				loop
					p_Region := r.R;
					exit;
				end loop;
			end if;

			-- Ищем по длинному коду, если не нашли по короткому коду. Более приоритетной будет
			-- актуальная запись, затем запись с которой совпадает код, затем с меньшим
			-- признаком актуальности
			if p_Region is null and p_LCode is not null then
				for (
					select r(r : R)
					in ::[CODE_REGION]
					where r.[KLADR] like substr(p_LCode, 1, length(p_LCode) - 2) || '__'
						and r.[COUNTRY] = p_Country
					order by
						nvl(r.[ARCHAIC], false)
						, case when r.[KLADR] = p_LCode or r.[KLADR] is null and p_LCode is null then 1 else 0 end
						, substr(r.[KLADR], -2)
						, r.[AOGUID] -- выбираем записи с ГУИДом как приоритетные
					)
				loop
					p_Region := r.R;
					exit;
				end loop;
			end if;
			
			-- Ищем по наименованию, если ссылка найдена, но является устаревшей (только
			-- при поиске по длинному коду)
			if	p_Region is null
				and (p_Name is not null
					or p_Name_NT is not null)
				-- только если настройка KLADR_MODE < 2, т.е. необязательно указание код КЛАДР
				and &KLADR_IS_NOT_NECESSARY(p_kladr)
			then
				if p_Name is not null then
					-- Выделение из полного наименования наименования и типа
					Extract_Name_Type(	p_Str		== p_Name,
										p_Level		== get_act_level(1),
										p_Kladr		== p_Kladr,
										p_Name		== Name,
										p_Type		== Type_Ref,
										p_Type_Name	== Type_Name,
										p_Type_SName== Type_SName);
				else
					Name := p_Name_NT;
				end if;

				&debug_var2(p_Name, 0)
				&debug_var2(Type_Ref, 0)
				&debug_var2(Type_Ref.[SYNONYM_GRP], 0)
				&debug_var2(Type_Name, 0)

				pragma hint('index(plp$hint(r) idx_z#code_region_name)');
				for (
					select r(r : R)
					in ::[CODE_REGION] all
					where	upper(r.[NAME]) = upper(Name) --Сравнивать необходимо в одном регистре
							and r.[COUNTRY] = p_Country
							and (Type_Ref is null
								or r.[KIND].[SYNONYM_GRP] = Type_Ref.[SYNONYM_GRP]
								)
					order by
						nvl(r.[ARCHAIC], false)
						, substr(r.[KLADR], -2)
						, r.[AOGUID] -- выбираем записи с ГУИДом как приоритетные
					)
				loop
					p_Region := r.R;
					exit;
				end loop;
				
				if upper(p_Name) like '%ЧУВАШ%' then
					for (select r(r : R) in ::[CODE_REGION] all 
						 where r.[CODE] = '21'
						 and r.[COUNTRY] = p_Country
						 order by
						 nvl(r.[ARCHAIC], false)
						 , substr(r.[KLADR], -2)
						 , r.[AOGUID] -- выбираем записи с ГУИДом как приоритетные
					)	
					loop
						p_Region := r.R;
						exit;	
					end loop;
				end if;
			end if;

			if p_Region is null then
				pragma Error('Не найден регион по заданым реквизитам.');
			end if;
		end if;
	end if;
	
	&debug_var2(p_Region.[NAME], 0)
	&debug_var2(p_Region.[CODE], 0)
end;

-- Поиск района
procedure Find_Area(	p_Code		varchar2(200),
						p_Name		varchar2(200),
						p_Name_TE	varchar2(200),
						p_Name_NT	varchar2(200),
						p_Kladr		number,
						p_Region	in out ref [CODE_REGION],
						p_Area		in out ref [REGION_AREA],
						p_struct	number,
						p_oktmo		in out ref [OKTMO])
is
	Type_Ref	ref [PEOPLE_PLACE];
	Type_Name	::[PEOPLE_PLACE].[NAME]%type;
	Type_SName	::[PEOPLE_PLACE].[SHORT_NAME]%type;
	Name		::[PERSONAL_ADDRESS].[CACHE_LIB].Addr_Str_Type%type;
	v_te		boolean;
	v_match		integer;
begin
	&debug('Find_Area', 0)
	&debug('p_Code='||p_Code, 0)
	&debug('p_Kladr='||p_Kladr, 0)
	&debug('p_struct='||p_struct, 0)
	&debug('p_Region='||p_Region, 0)
	&debug('p_Name='||p_Name, 0)
	&debug('p_Name_TE='||p_Name_TE, 0)
	&debug('p_Name_NT='||p_Name_NT, 0)
	&debug('p_Area='||p_Area, 0)

	if	p_Area is null
		and (p_Code is not null
			or p_Name is not null
			or p_Name_TE is not null
			or p_Name_NT is not null
			)
	then
		v_te := p_Name is null and p_Name_TE is not null;
		p_Name := coalesce(p_Name, p_Name_TE);

		-- Задавать район можно только для региона
		if p_Region is null and not &REF_IS_NOT_NECESSARY(p_kladr) then
			pragma Error('Невозможно найти район без региона.');
		end if;

		-- Ищем по коду КЛАДР
		if p_struct = 1 and p_area is null and p_Code is not null then
			for (select a(a : AREA)
				 in ::[REGION_AREA]
				 where a.[KLADR] like substr(p_Code, 1, length(p_Code) - 2) || '__'
				 order by nvl(a.[ARCHAIC], false) --desc иначе первой становится "неактуальная" запись
						, case when a.[KLADR] = p_Code then 1 else 0 end
						, substr(a.[KLADR], -2))
			loop
				for (with recursive rc(id, parent, cls, nocyc) as (
						select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = a.AREA
						union all
						select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
						in ::[ADDRESS_OBJ]
						join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
					 select x(x.id : REGION) in rc where x.cls = ::[CODE_REGION]%class)
				loop
					p_Area := a.AREA;
					p_Region := coalesce(p_Region, x.REGION);
				end loop;
				exit;
			end loop;
		end if;

		-- Ищем по наименованию, только в том случае если по коду ничего не найдено
		if p_Area is null and (p_Name is not null or p_Name_NT is not null)
		then
			if p_Name is not null then
				-- Выделение из полного наименования наименования и типа
				Extract_Name_Type(	p_Str		== p_Name,
									p_Level		== case p_struct when 1 then v_level_district when 2 then v_level_district_m end, -- для муниципального деления районы на уровне 3
									p_Kladr		== p_Kladr,
									p_Name		== Name,
									p_Type		== Type_Ref,
									p_Type_Name	== Type_Name,
									p_Type_SName== Type_SName,
									p_type_end	== case p_struct when 2 then v_te end);
				if Type_Ref is null and v_te then -- если тип с признаком поиска в конце наименования не нашли, то поищем везде
					Extract_Name_Type(	p_Str		== p_Name,
										p_Level		== case p_struct when 1 then v_level_district when 2 then v_level_district_m end, -- для муниципального деления районы на уровне 3
										p_Kladr		== p_Kladr,
										p_Name		== Name,
										p_Type		== Type_Ref,
										p_Type_Name	== Type_Name,
										p_Type_SName== Type_SName);
				end if;
			else
				Name := p_Name_NT;
			end if;
			
			&debug('Type_Ref='||Type_Ref, 0)
			&debug('Type_Ref.[SYNONYM_GRP]='||Type_Ref.[SYNONYM_GRP], 0)
			&debug('Type_Name='||Type_Name, 0)
			&debug('p_Area='||p_Area,0)
			
			-- Поиск района по наименованию, типу и ссылке на регион. Из найденного списка
			-- выбираем наиболее актуальный
			v_match := 0;
			for (select a2(a2: AREA
						 , nvl(a2.[ARCHAIC], false) --иначе первой становится "неактуальная" запись
							-- Сначала будем смотреть с типом Type_Ref
							|| case when a2.[KIND] = Type_Ref or a2.[KIND] is null and Type_Ref is null then '1' else '2' end
							|| substr(a2.[KLADR], -2) : SORT)
				 in ::[REGION_AREA]
				 where upper(a2.[NAME]) = upper(Name)
					   and (p_struct = 2 and a2.[KIND].[OBJ_LEVEL] = v_level_district_m or p_struct = 1)
					   and (Type_Ref is null or a2.[KIND].[SYNONYM_GRP] = Type_Ref.[SYNONYM_GRP])
					   -- По справочнику кладр или по всем записям
					   and (a2.[KLADR] is not null or &KLADR_IS_NOT_NECESSARY(p_kladr))
				 order by 2)
			loop
				&debug('select a2.[AREA]='||a2.[AREA],0)
				for (select a1(a1.[REGION] : REGION, case when a1.[REGION] = p_Region or a1.[REGION] is null and p_Region is null or p_Region is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end : match)
					 in (select a(case p_struct
					 				when 1 then
							 			(with recursive rc(id, parent, cls, nocyc) as (
												select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = a2.AREA
												union all
												select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
												in ::[ADDRESS_OBJ]
												join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
										 select x(x.id) in rc where x.cls = ::[CODE_REGION]%class)
									when 2 then
										(with recursive rc(id, parent, cls, nocyc) as (
												select x(x, h.[PARENTID], x%class, ','||x||',')
												in ::[ADDRESS_OBJ]
												join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
												where x = a2.AREA
												union all
												select x(x, h.[PARENTID], x%class, rr.nocyc||x||',')
												in ::[ADDRESS_OBJ]
												join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
												join (rc : rr) on rr.parent = x
																  and instr(rr.nocyc, ','||x||',') = 0)
										 select x(x.id) in rc where x.cls = ::[CODE_REGION]%class)
									end : REGION
								   )
						 in ::[REGION_AREA]
						 where a = a2.AREA)
					 where a1.[REGION] = p_region
							or (p_region is null and a1.[REGION] is null)
							or (p_region is null and &REF_IS_NOT_NECESSARY(p_kladr)))
				loop
					if v_match < a1.match then
						v_match := a1.match;
						p_Area := a2.[AREA];
						p_Region := a1.[REGION];
						&debug('select p_Region='||p_Region,0)
					end if;
				end loop;
				exit when v_match = 1;
			end loop;
		end if;
			
		-- Если ничего не найдено выводим сообщение об ошибке
		if p_Area is null then
			pragma Error('Не найден район региона "'||p_Region.[CODE]||'" по наименованию "'||Name||'".');
		end if;
	end if;

	--если у Района стоит признак "устаревший", то найдем самый новый район по ссылкам
	if p_Area is not null and nvl(p_Area.[ARCHAIC],false) and p_Area.[NEW_NAME] is not null then
		declare
			p_NewArea ref [REGION_AREA];
			v_idx_new_name integer;
		begin
			v_idx_new_name := 0;
			p_NewArea := p_Area.[NEW_NAME];
			while (p_NewArea.[NEW_NAME] is not null) and nvl(p_NewArea.[ARCHAIC],false)
			loop
				p_NewArea := p_NewArea.[NEW_NAME];
				v_idx_new_name := v_idx_new_name + 1;
				if v_idx_new_name = 10000 then
					&debug('Устаревшее название Района '||p_Area.[NAME]||', id ('||p_Area%id||') вышли из поиска актуального, так как не нашли актуальный за большое количество попыток', 0)
					p_NewArea := p_Area;
					exit;
				end if;
			end loop;
			&debug('Устаревшее название Района '||p_Area.[NAME]||' => заменено на '||p_NewArea.[NAME], 0)
			p_Area := p_NewArea;
		end;
	end if;
	
	-- получим ОКТМО найденного района
	if p_struct = 2 then
		p_oktmo := get_oktmo(p_Area, p_oktmo);
	else
		p_oktmo := p_Area.[OKTMO];
	end if;
	&debug('p_oktmo='||p_oktmo%id, 0)
	
	&debug('p_Area='||p_Area%id, 0)
	&debug('p_Area.[NAME]='||p_Area.[NAME], 0)
	&debug('p_Area.[KLADR]='||p_Area.[KLADR], 0)
end;

-- Поиск поселения
procedure Find_Settl(	p_Name		varchar2(200),
						p_Name_TE	varchar2(200),
						p_Name_NT	varchar2(200),
						p_Kladr		number,
						p_Area		in out ref [REGION_AREA],
						p_Settl		in out ref [REGION_AREA],
						p_oktmo		in out ref [OKTMO]
						)
is
	Type_Ref	ref [PEOPLE_PLACE];
	Type_Name	::[PEOPLE_PLACE].[NAME]%type;
	Type_SName	::[PEOPLE_PLACE].[SHORT_NAME]%type;
	Name		::[PERSONAL_ADDRESS].[CACHE_LIB].Addr_Str_Type%type;
	v_match		integer;
begin
	&debug('Find_Settl', 0)
	&debug('p_Name='||p_Name, 0)
	&debug('p_Name_TE='||p_Name_TE, 0)
	&debug('p_Name_NT='||p_Name_NT, 0)
	&debug('p_Area='||p_Area, 0)
	&debug('p_Settl='||p_Settl, 0)

	if	p_Settl is null
		and (p_Name is not null
			 or p_Name_TE is not null
			 or p_Name_NT is not null
			)
	then
		p_Name := coalesce(p_Name, p_Name_TE);

		-- Задавать поселение можно только для района
		if p_Area is null and not &REF_IS_NOT_NECESSARY(p_kladr) then
			pragma Error('Невозможно найти поселение без района.');
		end if;

		-- Ищем по наименованию
		if p_Settl is null and (p_Name is not null or p_Name_NT is not null)
		then
			if p_Name is not null then
				-- Выделение из полного наименования наименования и типа
				Extract_Name_Type(	p_Str		== p_Name,
									p_Level		== v_level_settlement,
									p_Kladr		== p_Kladr,
									p_Name		== Name,
									p_Type		== Type_Ref,
									p_Type_Name	== Type_Name,
									p_Type_SName== Type_SName);
			else
				Name := p_Name_NT;
			end if;
			
			&debug_var2(p_Kladr, 0)
			&debug_var2(Type_Ref, 0)
			&debug_var2(Type_Ref.[SYNONYM_GRP], 0)
			&debug_var2(Type_Name, 0)
			&debug_var2(v_level_settlement, 0)			

			-- Поиск поселения по наименованию, типу и ссылке на район.
			-- Из найденного списка выбираем наиболее актуальный
			v_match := 0;
			for (select a2(a2: SETTL
						, nvl(a2.[ARCHAIC], false) --иначе первой становится "неактуальная" запись
							-- Сначала будем смотреть с типом Type_Ref
							|| case when a2.[KIND] = Type_Ref or a2.[KIND] is null and Type_Ref is null then '1' else '2' end
							|| substr(a2.[KLADR], -2) : SORT)
				in ::[REGION_AREA]
				where upper(a2.[NAME]) = upper(Name)
					  and (Type_Ref is null or a2.[KIND].[SYNONYM_GRP] = Type_Ref.[SYNONYM_GRP])
				order by 2)
			loop
				for (select a1(a1.[AREA]: AREA, case when a1.[AREA] = p_Area or a1.[AREA] is null and p_Area is null then 1 else 0 end : match)
					 in (select a((with recursive rc(id, parent, cls, nocyc) as (
											select x(x, h.[PARENTID], x%class, ','||x||',')
											in ::[ADDRESS_OBJ]
											join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
											where x = a2.SETTL
											union all
											select x(x, h.[PARENTID], x%class, rr.nocyc||x||',')
											in ::[ADDRESS_OBJ]
											join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
											join (rc : rr) on rr.parent = x
															  and instr(rr.nocyc, ','||x||',') = 0)
									 select x(x.id) in rc join (::[ADDRESS_OBJ] : a3) on a3 = x.id 
									 where x.cls = ::[REGION_AREA]%class and a3.[KIND].[OBJ_LEVEL] = v_level_district_m) : AREA)
						 in ::[REGION_AREA]
						 where a = a2.SETTL)
					where a1.[AREA] = p_Area
						or p_Area is null and a1.[AREA] is null
						or p_Area is null and &REF_IS_NOT_NECESSARY(p_kladr))
				loop
					if v_match < a1.match then
						v_match := a1.match;
						p_Settl := a2.[SETTL]; -- сохранится самый первый по сортировке
						p_Area := a1.[AREA];
					end if;
				end loop;
				exit when v_match = 1;
			end loop;
		end if;
			
		-- Если ничего не найдено выводим сообщение об ошибке
		if p_Settl is null then
			pragma Error('Не найдено поселение района "'||p_Area.[NAME]||'" по наименованию "'||Name||'".');
		end if;
	end if;

	--если у поселения стоит признак "устаревший", то найдем самое новое поселение по ссылкам
	if p_Settl is not null and nvl(p_Settl.[ARCHAIC],false) and p_Settl.[NEW_NAME] is not null then
		declare
			p_NewSettl ref [REGION_AREA];
			v_idx_new_name integer;
		begin
			v_idx_new_name := 0;
			p_NewSettl := p_Settl.[NEW_NAME];
			while (p_NewSettl.[NEW_NAME] is not null) and nvl(p_NewSettl.[ARCHAIC],false)
			loop
				p_NewSettl := p_NewSettl.[NEW_NAME];
				v_idx_new_name := v_idx_new_name + 1;
				if v_idx_new_name = 10000 then
					&debug('Устаревшее название поселения '||p_Settl.[NAME]||', id ('||p_Settl%id||') вышли из поиска актуального, так как не нашли актуальный за большое количество попыток', 0)
					p_NewSettl := p_Settl;
					exit;
				end if;
			end loop;
			&debug('Устаревшее название поселения '||p_Settl.[NAME]||' => заменено на '||p_NewSettl.[NAME], 0)
			p_Settl := p_NewSettl;
		end;
	end if;
	
	-- получим ОКТМО найденного поселения
	p_oktmo := get_oktmo(p_Settl, p_oktmo);
	&debug('p_oktmo='||p_oktmo%id, 0)
	
	&debug('p_Settl.[NAME]='||p_Settl.[NAME], 0)
end;

-- Поиск населенного пункта
procedure Find_City(	p_Code		varchar2(200),
						p_Name		varchar2(200),
						p_Name_TE	varchar2(200),
						p_Name_NT	varchar2(200),
						p_Level		integer,
						p_Zip		varchar2(20),
						p_Country	ref [COUNTRY],
						p_Region	in out ref [CODE_REGION],
						p_Area		in out ref [REGION_AREA],
						p_Settl		in out ref [REGION_AREA],
						p_Main_City	ref [NAMES_CITY],
						p_Create	boolean,
						p_Kladr		number,
						p_City		in out ref [NAMES_CITY],
						p_Struct	number,
						p_oktmo		in out ref [OKTMO])
is
	Type_1_Name	::[PEOPLE_PLACE].[NAME]%type;
	Type_SName	::[PEOPLE_PLACE].[SHORT_NAME]%type;
	Type_1_Ref	ref [PEOPLE_PLACE];
	Type_2_Ref	ref [PEOPLE_PLACE];
	Type_3_Ref	ref [PEOPLE_PLACE];
	Name		::[PERSONAL_ADDRESS].[CACHE_LIB].Addr_Str_Type%type;
	v_Name		varchar2(200) := p_Name;
	v_match		integer;
	v_oktmo		ref [OKTMO];
	
begin
	&debug('Find_City '||p_Level, 0)
	&debug('p_Code='||p_Code, 0)
	&debug('v_Name='||v_Name     , 0)
	&debug('p_Name_TE='||p_Name_TE  , 0)
	&debug('p_Name_NT'||p_Name_NT  , 0)
	&debug('p_Zip='||p_Zip      , 0)
	&debug('p_Country='||p_Country, 0)
	&debug('p_Region='||p_Region, 0)
	&debug('p_Area='||p_Area, 0)
	&debug('p_Settl='||p_Settl, 0)
	&debug('p_Main_City='||p_Main_City, 0)
	&debug('p_Create='||p_Create, 0)
	&debug('p_Kladr='||p_Kladr, 0)		
	&debug('p_City='||p_City, 0)		
	&debug('p_struct='||p_struct, 0)
	&debug('p_oktmo='||p_oktmo, 0)

	if p_City is null and (p_Code is not null or v_Name is not null or p_Name_TE is not null or p_Name_NT is not null) then
		-- Проверяем, все ли задано
		v_Name := coalesce(v_Name, p_Name_TE);
		-- найдём ОКТМО вышестоящего объекта для случая, если город в иерархии существует в нескольких экземплярах с разными ОКТМО
		if p_struct = 2 then
			select h(h.[OKTMO])
			in ::[ADDR_OBJ_HIERAR]
			where h.[ADDR_OBJ] = coalesce(p_Settl, p_Area)
			fetch 1
			into v_oktmo;
			v_oktmo := coalesce(p_oktmo, v_oktmo);
		end if;
		
		-- Ищем по коду
		if p_Code is not null and p_struct = 1 then -- КЛАДР не может быть в муниципальном делении
			&debug('Find_City CODE ', 0)
			for (select c(c : C)
				 in ::[NAMES_CITY]
					where c.[KLADR] like substr(p_Code, 1, length(p_Code)-2)||'__'
					order by nvl(c.[ARCHAIC], false),	--иначе первой становится "неактуальная" запись
							 substr(c.[KLADR], -2))
			loop
				p_City := coalesce(p_City, c.C);
				for (with recursive rc(id, parent, cls, nocyc) as (
						select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = c.C
						union all
						select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
						in ::[ADDRESS_OBJ]
						join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
					select x(x.id : id, x.cls : cls)
					in rc join (::[ADDRESS_OBJ] : ao) on x.id = ao
					where x.cls = ::[CODE_REGION]%class
						  or x.cls = ::[REGION_AREA]%class)
				loop
					if p_Region is null and x.cls = ::[CODE_REGION]%class then
						p_Region := x.id;
					elsif p_Area is null and x.cls = ::[REGION_AREA]%class then
						p_Area := x.id;
					end if;
				end loop;
				exit;
			end loop;
		
		-- Ищем по наименованию
		elsif p_City is null and (v_Name is not null or p_Name_NT is not null) then
			&debug('Find_City NAME ', 0)
			if v_Name is not null then
				-- Выделение из полного наименования наименования и типа
				Extract_Name_Type(	p_Str		== v_Name,
									p_Level		== p_Level,
									p_Kladr		== p_Kladr,
									p_Name		== Name,
									p_Type		== Type_1_Ref,
									p_Type_Name	== Type_1_Name,
									p_Type_SName== Type_SName);
			else
				Name := p_Name_NT;
			end if;
								
			-- Если уровень населенного пункта 4, попробуем его поискать в уровне 3
			if p_level = get_act_level(4) and Type_1_Ref is not null then
				Type_2_Ref := Get_Type(	p_Level	== get_act_level(3),
										p_Name	== Type_1_Name);
			-- Если по уровеню населенного пункта 4 не нашли тип адресного объекта, то пытаемся искать с уровнем 3
			elsif p_level = get_act_level(4) and Type_1_Ref is null and v_Name is not null then
				-- Выделение из полного наименования наименования и типа
				Extract_Name_Type(	p_Str		== v_Name,
									p_Level		== get_act_level(3),
									p_Kladr		== p_Kladr,
									p_Name		== Name,
									p_Type		== Type_1_Ref,
									p_Type_Name	== Type_1_Name,
									p_Type_SName== Type_SName);
			end if;
			-- Населенный пункт может иметь статус федерального, значит его тип
			-- будет 1-го уровня
			if Type_1_Ref is not null then
				Type_3_Ref := Get_Type(	p_Level	== get_act_level(1),
										p_Name	== Type_1_Name);
			end if;

			&debug('Type_1_Ref='||Type_1_Ref, 0)
			&debug('Type_2_Ref='||Type_2_Ref, 0)
			&debug('Type_3_Ref='||Type_3_Ref, 0)
			&debug('Type_1_Ref.[SYNONYM_GRP]='||Type_1_Ref.[SYNONYM_GRP], 0)
			&debug('Type_2_Ref.[SYNONYM_GRP]='||Type_2_Ref.[SYNONYM_GRP], 0)
			&debug('Type_3_Ref.[SYNONYM_GRP]='||Type_3_Ref.[SYNONYM_GRP], 0)
			&debug('Name='||Name, 0)
	

			-- Ищем населенный пункт, по наименованию, типу, стране, региону, району, городу
			-- по справочнику КЛАДР или по всему справочнику. Из списка выбирается наиболее
			-- актуальная запись с совпадающим с p_Zip почтовым индексом, затем наиболее
			-- актуальная запись с не совпадающим с p_Zip почтовым индексом.
			
			-- поиск по региону
			if p_Region is not null then
				&debug('Find_City REGION ', 0)
				v_match := 0;
				for (select c(c : CITY
							, nvl(c.[ARCHAIC], false) -- иначе первой становится "неактуальная" запись
								|| case when c.[OBJECTID] is not null then '1' else '2' end -- Записи с идентификатором объекта берем в первую очередь (значит, они пришли из ГАР БД ФИАС)
								|| case when c.[KIND] = Type_1_Ref or c.[KIND] is null and Type_1_Ref is null then '1' else '2' end -- Потом будем смотреть по записям с типом Type_1_Ref
								|| case when c.[KIND].[SYNONYM_GRP] = Type_1_Ref.[SYNONYM_GRP] or c.[KIND].[SYNONYM_GRP] is null and Type_1_Ref.[SYNONYM_GRP] is null then '1' else '2' end -- Затем, по записям с синонимом типу Type_1_Ref
								|| case when c.[ZIP] = p_Zip or c.[ZIP] is null and p_Zip is null then '1' else '2' end	-- Затем, по совпадению индекса
								|| substr(c.[KLADR], -2) -- Затем, по актуальности
								|| nvl(c.[STATUS], 0) -- Затем по статусу
								: SORT -- Для сортировки
							)
					 in ::[NAMES_CITY]
					 where upper(c.[NAME]) = upper(Name)
							and (p_struct = 1 and c.[PARENT] = p_region
								 or p_struct = 2 and exists (select h(h) in ::[ADDR_OBJ_HIERAR] where h.[ADDR_OBJ] = c and h.[PARENTID] = p_region)
							) 
							and c.[COUNTRY] = p_Country
							and c.[KIND].[SYNONYM_GRP] in (coalesce(Type_1_Ref.[SYNONYM_GRP], c.[KIND].[SYNONYM_GRP]), Type_2_Ref.[SYNONYM_GRP], Type_3_Ref.[SYNONYM_GRP])
							and (c.[KLADR] is not null or &KLADR_IS_NOT_NECESSARY(p_kladr))
					 order by 2)
				loop
					for	(select c1(c1.[AREA] : area
								, c1.[SETTL] : settl
								, c1.[CITY] : city
								, case when c1.[AREA] = p_Area or c1.[AREA] is null and p_Area is null or p_Area is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end 
									+ case when c1.[SETTL] = p_Settl or c1.[SETTL] is null and p_Settl is null or p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end : match
					)
						 in	(select c0(case p_struct
											when 1 then
								 				(with recursive rc(id, parent, nocyc) as (
								 					select x(x, x.[PARENT], ','||x||',') in ::[ADDRESS_OBJ] where x = c.CITY
								 					union all
								 					select x(x, x.[PARENT], rr.nocyc||x||',')
								 					in ::[ADDRESS_OBJ]
								 					join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
								 				 select x(x)
								 				 in ::[ADDRESS_OBJ]
								 				 join (rc : rr) on rr.id = x
								 				 where x%class = ::[REGION_AREA]%class
												)
											when 2 then
												(with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = c.CITY and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[REGION_AREA]%class
								 					   and x.[KIND].[OBJ_LEVEL] = v_level_district_m
												)
									  end : AREA -- Район региона
									, case p_struct 
											when 1 then
								 				(with recursive rc(id, parent, nocyc) as (
								 					select x(x, x.[PARENT], ','||x||',') in ::[ADDRESS_OBJ] where x = p_area
								 					union all
								 					select x(x, x.[PARENT], rr.nocyc||x||',')
								 					in ::[ADDRESS_OBJ]
								 					join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
								 				 select x(x)
								 				 in ::[ADDRESS_OBJ]
								 				 join (rc : rr) on rr.id = x
								 				 where x%class = ::[NAMES_CITY]%class
												)
											when 2 then
												(with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = p_area and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[NAMES_CITY]%class
												)
									  end : CITY -- Город, вышестоящий для района
									, case p_struct 
										when 2 then
											(with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = c.CITY and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[REGION_AREA]%class
								 					   and x.[KIND].[OBJ_LEVEL] = v_level_settlement)
									  end : SETTL) -- поселение
								in ::[NAMES_CITY]
								where c0 = c.CITY)
							where (c1.[AREA] = p_Area
								   or p_Area is null and c1.[AREA] is null
								   or p_Area is null and &REF_IS_NOT_NECESSARY(p_kladr)
								   or p_Area is not null and c1.[CITY] = c.[CITY]
								   )
								  or
								  (p_struct = 2 
								   and ((c1.[SETTL] = p_Settl or p_Settl is null and c1.[SETTL] is null)
								   		or
								   		(p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr)))))
					loop
						if v_match < c1.match then
							v_match := c1.match;
							p_City := c.[CITY];
							if p_Area is null or c1.[CITY] is null or c1.[CITY] <> c.[CITY] then
								p_Area := c1.[AREA];
								p_Settl := c1.[SETTL];
							end if;
						end if;
					end loop;
					exit when v_match = 2; -- все возможные параметры совпали, дальше искать нет смысла
				end loop;
			end if;
			
			-- поиск по району
			if p_City is null and p_Area is not null then
				&debug('Find_City DISTRICT ', 0)
				v_match := 0;
				for (select c2(c2 : CITY
							, nvl(c2.[ARCHAIC], false) -- иначе первой становится "неактуальная" запись
								|| case when c2.[OBJECTID] is not null then '1' else '2' end -- Записи с идентификатором объекта берем в первую очередь (значит, они пришли из ГАР БД ФИАС)
								|| case when c2.[KIND] = Type_1_Ref or c2.[KIND] is null and Type_1_Ref is null then '1' else '2' end -- Потом будем смотреть по записям с типом Type_1_Ref
								|| case when c2.[KIND].[SYNONYM_GRP] = Type_1_Ref.[SYNONYM_GRP] or c2.[KIND].[SYNONYM_GRP] is null and Type_1_Ref.[SYNONYM_GRP] is null then '1' else '2' end -- Затем, по записям с синонимом типу Type_1_Ref
								|| case when c2.[ZIP] = p_Zip or c2.[ZIP] is null and p_Zip is null then '1' else '2' end	-- Затем, по совпадению индекса
								|| substr(c2.[KLADR], -2) -- Затем, по актуальности
								|| nvl(c2.[STATUS], 0) -- Затем по статусу
								: SORT -- Для сортировки
							)
					in ::[NAMES_CITY]
					where upper(c2.[NAME]) = upper(Name)
						and (p_struct = 1 and c2.[PARENT] = p_Area 
							 or p_struct = 2 and exists (select h(h) in ::[ADDR_OBJ_HIERAR] where h.[ADDR_OBJ] = c2 and h.[PARENTID] = p_Area))
						and c2.[COUNTRY] = p_Country
						and c2.[KIND].[SYNONYM_GRP] in (coalesce(Type_1_Ref.[SYNONYM_GRP], c2.[KIND].[SYNONYM_GRP]), Type_2_Ref.[SYNONYM_GRP], Type_3_Ref.[SYNONYM_GRP])
						and (c2.[KLADR] is not null or &KLADR_IS_NOT_NECESSARY(p_kladr))
					order by 2)
				loop
					for	(select c1(c1.[REGION]: region
							, c1.[SETTL] : settl
							, case when c1.[REGION] = p_Region or c1.[REGION] is null and p_Region is null or p_Region is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end 
								+ case when c1.[SETTL] = p_Settl or c1.[SETTL] is null and p_Settl is null or p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end : match
					)
						 in (select c(case p_struct
						 				when 1 then
							 				(with recursive rc(id, parent, cls, nocyc) as (
												select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = c2.CITY
												union all
												select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
												in ::[ADDRESS_OBJ]
												join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
										   select x(x.id) in rc where x.cls = ::[CODE_REGION]%class)
									   	when 2 then
									   		(with recursive rc(id, parent, oktmo, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = c2.CITY and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[CODE_REGION]%class)
									  end : REGION -- Регион
									, case p_struct 
										when 2 then
											(with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = c2.CITY and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[REGION_AREA]%class
								 					   and x.[KIND].[OBJ_LEVEL] = v_level_settlement)
									  end : SETTL) -- поселение
							 in ::[NAMES_CITY]
							 where c = c2.CITY)
						 where (c1.[REGION] = p_Region or (p_Region is null and c1.[REGION] is null) or (p_Region is null and &REF_IS_NOT_NECESSARY(p_kladr)))
								and
								(p_struct = 2 and ((c1.[SETTL] = p_Settl or c1.[SETTL] is null and p_Settl is null) or (p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr)))
								 or p_struct = 1))
					loop
						if v_match < c1.match then
							v_match := c1.match;
							p_Region := c1.region;
							p_Settl := c1.settl;
							p_City := c2.CITY;
						end if;
					end loop;
					exit when v_match = 2;
				end loop;
			end if;
			
			-- поиск по поселению в муниципальном делении
			if p_City is null and p_Settl is not null and p_struct = 2 then
				&debug('Find_City SETTLEMENT ', 0)
				v_match := 0;
				for (select c2(c2 : CITY
							 , nvl(c2.[ARCHAIC], false) -- иначе первой становится "неактуальная" запись
								|| case when c2.[OBJECTID] is not null then '1' else '2' end -- Записи с идентификатором объекта берем в первую очередь (значит, они пришли из ГАР БД ФИАС)
								|| case when c2.[KIND] = Type_1_Ref or c2.[KIND] is null and Type_1_Ref is null then '1' else '2' end -- Потом будем смотреть по записям с типом Type_1_Ref
								|| case when c2.[KIND].[SYNONYM_GRP] = Type_1_Ref.[SYNONYM_GRP] or c2.[KIND].[SYNONYM_GRP] is null and Type_1_Ref.[SYNONYM_GRP] is null then '1' else '2' end -- Затем, по записям с синонимом типу Type_1_Ref
								|| case when c2.[ZIP] = p_Zip or c2.[ZIP] is null and p_Zip is null then '1' else '2' end	-- Затем, по совпадению индекса
								|| substr(c2.[KLADR], -2) -- Затем, по актуальности
								|| nvl(c2.[STATUS], 0) -- Затем по статусу
								: SORT) -- Для сортировки
					in ::[NAMES_CITY]
					where upper(c2.[NAME]) = upper(Name)
						and exists (select h(h) in ::[ADDR_OBJ_HIERAR] where h.[ADDR_OBJ] = c2 and h.[PARENTID] = p_Settl)
						and c2.[COUNTRY] = p_Country
						and c2.[KIND].[SYNONYM_GRP] in (coalesce(Type_1_Ref.[SYNONYM_GRP], c2.[KIND].[SYNONYM_GRP]), Type_2_Ref.[SYNONYM_GRP], Type_3_Ref.[SYNONYM_GRP])
						and (c2.[KLADR] is not null or &KLADR_IS_NOT_NECESSARY(p_kladr)))
				loop
					&debug('Finded '||c2.CITY, 0)
					for	(select c1(c1.[REGION]: region, case when c1.[REGION] = p_Region or c1.[REGION] is null and p_Region is null or p_Region is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end : match)
						 in (select c(case p_struct
						 				when 1 then
							 				(with recursive rc(id, parent, cls, nocyc) as (
												select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = c2.CITY
												union all
												select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
												in ::[ADDRESS_OBJ]
												join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
										   select x(x.id) in rc where x.cls = ::[CODE_REGION]%class)
									   	when 2 then
									   		(with recursive rc(id, parent, oktmo, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = c2.CITY and (h.[OKTMO] = v_oktmo
																			or v_oktmo is null
																			or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo)
													)
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[CODE_REGION]%class)
									  end : REGION) -- Регион
							 in ::[NAMES_CITY]
							 where c = c2.CITY)
						 where c1.[REGION] = p_Region or (p_Region is null and c1.[REGION] is null) or (p_Region is null and &REF_IS_NOT_NECESSARY(p_kladr)))
					loop
						if v_match < c1.match then
							v_match := c1.match;
							p_Region := c1.region;
							p_City := c2.CITY;
						end if;
					end loop;
					exit when v_match = 1;
				end loop;
			end if;
			if p_City is null then
				&debug('Find_City ALL ', 0)
				v_match := 0;
				for (select c2(c2 : city
							 -- Для сортировки
							 , nvl(c2.[ARCHAIC], false) -- иначе первой становится "неактуальная" запись
								|| case when c2.[OBJECTID] is not null then '1' else '2' end -- Записи с идентификатором объекта берем в первую очередь (значит, они пришли из ГАР БД ФИАС)
								|| case when c2.[KIND] = Type_1_Ref or c2.[KIND] is null and Type_1_Ref is null then '1' else '2' end -- Потом будем смотреть по записям с типом Type_1_Ref
								|| case when c2.[KIND].[SYNONYM_GRP] = Type_1_Ref.[SYNONYM_GRP] or c2.[KIND].[SYNONYM_GRP] is null and Type_1_Ref.[SYNONYM_GRP] is null then '1' else '2' end -- Затем, по записям с синонимом типу Type_1_Ref
								|| case when c2.[ZIP] = p_Zip or c2.[ZIP] is null and p_Zip is null then '1' else '2' end -- Затем, по совпадению индекса
								|| substr(c2.[KLADR], -2) -- Затем, по актуальности
								|| nvl(c2.[STATUS], 0) -- Затем по статусу
								: SORT)
					 in ::[NAMES_CITY]
					 where	upper(c2.[NAME]) = upper(Name)
							and c2.[COUNTRY] = p_Country
							and (c2.[KIND].[SYNONYM_GRP] in (coalesce(Type_1_Ref.[SYNONYM_GRP], c2.[KIND].[SYNONYM_GRP]), Type_2_Ref.[SYNONYM_GRP], Type_3_Ref.[SYNONYM_GRP]))
							and (c2.[KLADR] is not null or &KLADR_IS_NOT_NECESSARY(p_kladr))
					 order by 2)
				loop
					for	(select c1(c1.[REGION]: region, c1.[AREA]: area, c1.[SETTL] : settl
								 , case when c1.[REGION] = p_Region or c1.[REGION] is null and p_Region is null or p_Region is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end + 
								   case when c1.[AREA] = p_Area or c1.[AREA] is null and p_Area is null or p_Area is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end +
								   case when c1.[SETTL] = p_Settl or c1.[SETTL] is null and p_Settl is null or p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end +
								   case when c1.[MAIN_CITY] = p_main_city or c1.[MAIN_CITY] is null and p_main_city is null then 1 else 0 end : match)
						 in (select c(case p_struct
						 				when 1 then
							 				(with recursive rc(id, parent, cls, nocyc) as (
												select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = c2.CITY
												union all
												select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
												in ::[ADDRESS_OBJ]
												join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
										   select x(x.id) in rc where x.cls = ::[CODE_REGION]%class)
									   	when 2 then
									   		(with recursive rc(id, parent, oktmo, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = c2.CITY and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[CODE_REGION]%class)
									  end : REGION -- Регион
									   
									 , case p_struct
											when 1 then
								 				(with recursive rc(id, parent, nocyc) as (
								 					select x(x, x.[PARENT], ','||x||',') in ::[ADDRESS_OBJ] where x = c2.CITY
								 					union all
								 					select x(x, x.[PARENT], rr.nocyc||x||',')
								 					in ::[ADDRESS_OBJ]
								 					join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
								 				 select x(x)
								 				 in ::[ADDRESS_OBJ]
								 				 join (rc : rr) on rr.id = x
								 				 where x%class = ::[REGION_AREA]%class
												)
											when 2 then
												(with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = c2.CITY and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[REGION_AREA]%class
								 					   and x.[KIND].[OBJ_LEVEL] = v_level_district_m
												)
									  end : AREA -- Район региона
										
									 , case p_struct 
										when 2 then
											(with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = c2.CITY and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[REGION_AREA]%class
								 					   and x.[KIND].[OBJ_LEVEL] = v_level_settlement)
									  end : SETTL -- поселение
										
									  , case
											when p_struct = 1 then
												case when c.[PARENT]%class = ::[NAMES_CITY]%class then c.[PARENT] end
											when p_struct = 2 then
												(select p(p.[PARENTID])
												 in ::[ADDR_OBJ_HIERAR]
												 where p.[ADDR_OBJ] = c2.CITY 
												 		and p.[PARENTID]%class = ::[NAMES_CITY]%class
												 fetch 1
												)
										end : MAIN_CITY) -- Вышестоящий населённый пункт
							in ::[NAMES_CITY]
							where c = c2.CITY)
						where
							-- Ищем по региону
							(c1.[REGION] = p_Region or (p_Region is null and c1.[REGION] is null) or (p_Region is null and &REF_IS_NOT_NECESSARY(p_kladr)))
							-- Ищем по району
							and (c1.[AREA] = p_Area or (p_Area is null and c1.[AREA] is null) or (p_Area is null and &REF_IS_NOT_NECESSARY(p_kladr)))
							-- Ищем по поселению
							and (p_struct = 2 and (c1.[SETTL] = p_Settl or (p_Settl is null and c1.[SETTL] is null) or (p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr)))
								 or p_struct = 1)
							-- Ищем по вышестоящему городу
							and (c1.[MAIN_CITY] = p_Main_City or p_Main_City is null)
						)
					loop
						if v_match < c1.match then
							v_match := c1.match;
							p_Region := c1.[REGION];
							p_Area := c1.[AREA];
							p_Settl := c1.[SETTL];
							p_City := c2.[CITY];
						end if;
					end loop;
					exit when v_match = 4;
				end loop;
			end if;
				
			if p_struct = 2 then
				p_oktmo := v_oktmo;
			else
				p_oktmo := p_City.[OKTMO];
			end if;
				
			-- Если ничего не найдено выводим сообщение об ошибке
			if p_City is null and p_Create and &kladr_is_not_necessary(p_kladr) then
				p_City := ::[NAMES_CITY].[NEW#AUTO](
					coalesce(p_Main_City%id, p_Area%id, p_Settl%id, p_Region%id)	--Вышестоящий объект
					,name			--Наименование
					,null			--Официальное наименование
					,null			--Наименование латиницей
					,Type_1_Ref		--Тип населенного пункта
					,null			--Код ИФНС ЮЛ
					,null			--Код ИФНС ФЛ
					,null			--Статус
					,null			--Новое наименование
					,null			--Запись устарела
					,null			--Код по КЛАДР
					,null			--Код по ФИАС
					,p_Zip			--Почтовый индекс
					,null			--ОКАТО
					,null			--ОКТМО
					,p_Country		--Страна
					,null			--Часовой пояс
					,null			--Телефонный код города
					,null			--Код города в OWS
					);
			end if;
		end if;
		
		if p_City is null then
			pragma Error('Не найден населенный пункт.');
		end if;
	end if;
	
	&debug_var2(p_City.[NAME], 0)
	&debug_var2(p_City.[KLADR], 0)
end;

-- Поиск района населенного пункта
procedure Find_City_District(
						p_Name			varchar2(200),
						p_City			ref [NAMES_CITY],
						p_District		in out nocopy ref [REGION],
						p_Struct		number)
is
begin
	if  p_District is null and p_Name is not null then
		-- Район должна быть в каком-то населенном пункте
		if p_City is null then
			pragma Error('Поиск района населенного пункта без населенного пункта не возможен.');
		end if;
		&debug('Find City District',0)
		&debug_var2(p_Name,0)				
		for (select r1(r1 : REGION)
			 in ::[REGION]
			 where	upper(r1.[NAME]) = upper(p_Name)
					and r1%class = ::[REGION]%class)
		loop
			if p_struct = 1 then
				for (with recursive rc(id, parent, cls, nocyc) as (
						select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = r1.REGION
						union all
						select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
						in ::[ADDRESS_OBJ]
						join (rc : rr) on rr.parent = x and rr.cls != ::[NAMES_CITY]%class and instr(rr.nocyc, ','||x||',') = 0)
					 select x(x) in rc where x.id = p_city)
				loop
					&debug('r1.[NAME] ' || r1.REGION.[NAME],0)
					p_District := r1.REGION;
					return; -- район нашли, выходим из процедуры
				end loop;
			end if;
		end loop;
	end if;
end;

-- Поиск элемента улично-дорожной сети
procedure Find_Street(	p_Code			varchar2(200),
						p_Name 			varchar2(200),
						p_Name_TE		varchar2(200),
						p_Name_NT		varchar2(200),
						p_Zip			varchar2(20),
						p_City			in out ref [NAMES_CITY],
						p_Create		boolean,
						p_Kladr			number,
						p_Street		in out ref [STREET],
						p_street_Str	in out ::[PERSONAL_ADDRESS].[STREET_STR],
						p_Settl			ref [REGION_AREA],
						p_Region_area	ref [REGION_AREA],
						p_Struct		number,
						p_level			integer default null, -- уровень поиска: улицы или планировочные структуры
						p_oktmo			in out ref [OKTMO]
					)
is
	Type_Name	::[PEOPLE_PLACE].[NAME]%type;
	Type_SName	::[PEOPLE_PLACE].[SHORT_NAME]%type;
	Type_Ref	ref [PEOPLE_PLACE];
	Name		::[PERSONAL_ADDRESS].[CACHE_LIB].Addr_Str_Type%type;
	v_match		integer;
	v_oktmo		ref [OKTMO];
		
begin
	&debug(' ', 0)
	&debug('Find_Street', 0)
	&debug_var2(p_kladr, 0)
	&debug('p_Region_area = '||p_region_area||' ('||p_region_area.[NAME]||')', 0)
	&debug('p_Settl = '||p_Settl||' ('||p_Settl.[NAME]||')', 0)
	&debug('p_City = '||p_City||' ('||p_City.[NAME]||')', 0)
	&debug('p_Struct = '||p_Struct, 0)
	&debug('p_Zip = '||p_Zip, 0)
	&debug('p_Code = '||p_Code, 0)
	&debug('p_Name = '||p_Name, 0)
	&debug('p_Name_TE = '||p_Name_TE, 0)
	&debug('p_Name_NT = '||p_Name_NT, 0)
	&debug('p_Create = '||p_Create, 0)
	&debug('p_Kladr = '||p_Kladr, 0)
	&debug('p_Street = '||p_Street, 0)
	&debug('p_street_Str = '||p_street_Str, 0)
	&debug('p_oktmo = '||p_oktmo, 0)

	p_level := coalesce(p_level, v_level_street);
	&debug('p_level = '||p_level, 0)
	
	if p_struct = 2 then
		v_oktmo := coalesce(p_oktmo, get_oktmo(p_city, p_oktmo), get_oktmo(p_Settl, p_oktmo), get_oktmo(p_Region_area, p_oktmo));
		&debug('v_oktmo = '||v_oktmo, 0)
	end if;

	if p_Street is null then
		p_Name := coalesce(p_Name, p_Name_TE);
		-- Поиск по коду
		if p_Code is not null and p_struct = 1 then -- поиск по КЛАДР актуален только для административного деления
			for (select s(s: STREET)
				 in ::[STREET]
				 where s.[KLADR] like substr(p_Code, 1, length(p_Code) - 2) || '__'
				 order by nvl(s.[ARCHAIC], false) --иначе первой становится "неактуальная" запись
					 , substr(s.[KLADR], -2))
			loop
				for (with recursive rc(id, parent, cls, nocyc) as (
						select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = s.STREET
						union all
						select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
						in ::[ADDRESS_OBJ]
						join (rc : rr) on rr.parent = x and rr.cls != ::[NAMES_CITY]%class and instr(rr.nocyc, ','||x||',') = 0)
					 select x(x.id : CITY) in rc where x.cls = ::[NAMES_CITY]%class)
				loop
					p_Street := s.STREET;
					p_City := coalesce(p_City, x.CITY);
				end loop;
				exit when p_Street is not null;
			end loop;
		end if;
		
		-- Поиск по наименованию
		if	p_Street is null and (p_Name is not null or p_Name_NT is not null) then
			-- Выделение из полного наименования наименования и типа
			if p_Name is not null then
				Extract_Name_Type(	p_Str		== p_Name,
									p_Level		== p_level,
									p_Kladr		== p_Kladr,
									p_Name		== Name,
									p_Type		== Type_Ref,
									p_Type_Name	== Type_Name,
									p_Type_SName== Type_SName);
			else
				Name := p_Name_NT;
			end if;

			&debug_var2(p_Name, 0)
			&debug_var2(Name, 0)
			&debug_var2(Type_Ref, 0)
			&debug_var2(Type_Ref.[SYNONYM_GRP], 0)
			&debug_var2(Type_Name, 0)

			if p_city is not null then
				&debug('Поиск по городу', 0)
				v_match := 0;
				for (select s2(s2 : STREET
							, nvl(s2.[ARCHAIC], false)	--иначе первой становится "неактуальная" запись
								|| case when s2.[OBJECTID] is not null then '1' else '2' end -- Записи с идентификатором объекта берем в первую очередь (значит, они пришли из ГАР БД ФИАС)
								|| case when p_Zip is not null and s2.[ZIP] = p_Zip then 1 else 2 end
								|| substr(s2.[KLADR], -2) : SORT)
					 in ::[STREET]
					 where	upper(s2.[NAME]) = upper(Name)
							and (p_struct = 1 and s2.[PARENT] = p_city 
								 or p_struct = 2 and exists (select h(h) in ::[ADDR_OBJ_HIERAR] where h.[ADDR_OBJ] = s2 and h.[PARENTID] = p_city)) 
							-- В 98% случаев родительский адресный объект это город (NAMES_CITY).
							-- Тип родителя не проверяем т.к. id уникален, а p_city должен иметь правильный тип
							and (Type_Ref is null or s2.[KIND].[SYNONYM_GRP] = Type_Ref.[SYNONYM_GRP])
							and (s2.[KLADR] is not null or &KLADR_IS_NOT_NECESSARY(p_kladr))
					 order by 2)
				loop
					for (select s1(case when s1.[AREA] =p_region_area or s1.[AREA] is null and p_region_area is null or p_region_area is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end 
									+ case when s1.[SETTL] = p_Settl or s1.[SETTL] is null and p_Settl is null or p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end : match
						)
						 in (select s(case p_struct
											when 1 then
								 				(with recursive rc(id, parent, nocyc) as (
								 					select x(x, x.[PARENT], ','||x||',') in ::[ADDRESS_OBJ] where x = s2.[STREET]
								 					union all
								 					select x(x, x.[PARENT], rr.nocyc||x||',')
								 					in ::[ADDRESS_OBJ]
								 					join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
								 				 select x(x)
								 				 in ::[ADDRESS_OBJ]
								 				 join (rc : rr) on rr.id = x
								 				 where x%class = ::[REGION_AREA]%class
												)
											when 2 then
												(with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = s2.[STREET] and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[REGION_AREA]%class
								 					   and x.[KIND].[OBJ_LEVEL] = v_level_district_m
												)
									  end : AREA -- Район региона
										
									 , case p_struct 
										when 2 then
											(with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = s2.[STREET] and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
												select x(x)
								 				in ::[ADDRESS_OBJ]
								 				join (rc : rr) on rr.id = x
								 				where x%class = ::[REGION_AREA]%class
								 					   and x.[KIND].[OBJ_LEVEL] = v_level_settlement)
									  end : SETTL -- поселение
									)
								in ::[STREET]
								where s = s2.[STREET])
							where
								-- Ищем по району
								(s1.[AREA] = p_region_area
									or (p_region_area is null and s1.[AREA] is null)
									or (p_region_area is null and &REF_IS_NOT_NECESSARY(p_kladr))
									)
								and
								-- Ищем по поселению
								(s1.[SETTL] = p_Settl
									or (p_Settl is null and s1.[SETTL] is null)
									or (p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr))
									or p_struct = 1
									))
					loop
						if v_match < s1.match then
							v_match := s1.match;
							p_Street := s2.[STREET];
						end if;
					end loop;
					exit when v_match = 2;
				end loop;
			end if;

			if p_Street is null and p_struct = 2 then
				&debug('Поиск по городу и поселению для муниципального деления', 0)
				v_match := 0;
				for (select s2(s2 : STREET
							, nvl(s2.[ARCHAIC], false) --иначе первой становится "неактуальная" запись
							  || case when s2.[OBJECTID] is not null then '1' else '2' end -- Записи с идентификатором объекта берем в первую очередь (значит, они пришли из ГАР БД ФИАС)
							  || case when p_Zip is not null and s2.[ZIP] = p_Zip then 1 else 2 end
							  || substr(s2.[KLADR], -2) : SORT)
					 in ::[STREET]
					 where	upper(s2.[NAME]) = upper(Name)
							and (Type_Ref is null or s2.[KIND].[SYNONYM_GRP] = Type_Ref.[SYNONYM_GRP])
							and (s2.[KLADR] is not null or &KLADR_IS_NOT_NECESSARY(p_kladr))
					 order by 2)
				loop
					for (select s1( case when s1.[SETTL] = p_Settl or s1.[SETTL] is null and p_Settl is null or p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end 
									+ case when  s1.[CITY] = p_city or s1.[CITY] is null and p_city is null or p_City is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end : match
					)
						 in (select s((with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = s2.[STREET] and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
										select distinct x(x)
						 				in ::[ADDRESS_OBJ]
						 				join (rc : rr) on rr.id = x
						 				where x%class = ::[NAMES_CITY]%class) : CITY -- город
									   
								    , (with recursive rc(id, parent, oktmo, lvl, nocyc) as (
													select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													where x = s2.[STREET] and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
													union all
													select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
													in ::[ADDRESS_OBJ]
													join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
													join (rc : rr) on rr.parent = x
																	  and instr(rr.nocyc, ','||x||',') = 0
																	  and (v_oktmo is null 
																	  	   or h.[OKTMO] = v_oktmo
																	  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
										select distinct x(x)
						 				in ::[ADDRESS_OBJ]
						 				join (rc : rr) on rr.id = x
						 				where x%class = ::[REGION_AREA]%class
						 					   and x.[KIND].[OBJ_LEVEL] = v_level_settlement) : SETTL) -- поселение
							 in ::[STREET]
							 where s = s2.[STREET])
						 where	-- Ищем по поселению
								(s1.[SETTL] = p_Settl
									or (p_Settl is null and s1.[SETTL] is null)
									or (p_Settl is null and &REF_IS_NOT_NECESSARY(p_kladr))
									)
								-- Ищем по городу
								and (s1.[CITY] = p_City
									or (p_City is null and s1.[CITY] is null)
									or (p_City is null and &REF_IS_NOT_NECESSARY(p_kladr))))
					loop
						if v_match < s1.match then
							v_match := s1.match;
							p_Street := s2.[STREET];
						end if;
					end loop;
					exit when v_match = 2;
				end loop;
			end if;

			if p_Street is null then
				&debug('Поиск по городу и району', 0)
				declare 
					p_region_areaName varchar2(200);
					p_cityName varchar2(200);
				begin
					p_region_areaName := p_region_area.[NAME];
					p_cityName := p_city.[NAME];
					v_match := 0;
					for (select s2(s2 : STREET
								, nvl(s2.[ARCHAIC], false) --иначе первой становится "неактуальная" запись
									|| case when s2.[OBJECTID] is not null then '1' else '2' end -- Записи с идентификатором объекта берем в первую очередь (значит, они пришли из ГАР БД ФИАС)
									|| case when p_Zip is not null and s2.[ZIP] = p_Zip then 1 else 2 end
									|| substr(s2.[KLADR], -2) : SORT)
						 in ::[STREET]
						 where	upper(s2.[NAME]) = upper(Name)
								and (Type_Ref is null or s2.[KIND].[SYNONYM_GRP] = Type_Ref.[SYNONYM_GRP])
								and (s2.[KLADR] is not null or &KLADR_IS_NOT_NECESSARY(p_kladr))
						 order by 2)
					loop
						for (select s1(case when s1.[AREA] = p_region_area or s1.[AREA] is null and p_region_area is null or p_region_area is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end 
										+ case when s1.[CITY] = p_city or s1.[CITY] is null and p_city is null or p_city is null and &REF_IS_NOT_NECESSARY(p_kladr) then 1 else 0 end : match
						)
							 in (select s(case p_struct
												when 1 then
									 				(with recursive rc(id, parent, cls, nocyc) as (
									 					select x(x, x.[PARENT], x%class, ','||x||',') in ::[ADDRESS_OBJ] where x = s2.[STREET]
									 					union all
									 					select x(x, x.[PARENT], x%class, rr.nocyc||x||',')
									 					in ::[ADDRESS_OBJ]
									 					join (rc : rr) on rr.parent = x and rr.cls != ::[NAMES_CITY]%class and instr(rr.nocyc, ','||x||',') = 0)
									 				 select x(x)
									 				 in ::[ADDRESS_OBJ]
									 				 join (rc : rr) on rr.id = x
									 				 where x%class = ::[NAMES_CITY]%class
													)
												when 2 then
													(with recursive rc(id, parent, cls, oktmo, lvl, nocyc) as (
														select x(x, h.[PARENTID], x%class, h.[OKTMO], 1, ','||x||',')
														in ::[ADDRESS_OBJ]
														join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
														where x = s2.[STREET] and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
														union all
														select x(x, h.[PARENTID], x%class, h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
														in ::[ADDRESS_OBJ]
														join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
														join (rc : rr) on rr.parent = x
																		  and rr.cls != ::[NAMES_CITY]%class 
																		  and instr(rr.nocyc, ','||x||',') = 0
																		  and (v_oktmo is null 
																		  	   or h.[OKTMO] = v_oktmo
																		  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
													select x(x)
									 				in ::[ADDRESS_OBJ]
									 				join (rc : rr) on rr.id = x
									 				where x%class = ::[NAMES_CITY]%class)
										  end : CITY -- город
										, case p_struct
												when 1 then
									 				(with recursive rc(id, parent, nocyc) as (
									 					select x(x, x.[PARENT], ','||x||',') in ::[ADDRESS_OBJ] where x = s2.[STREET]
									 					union all
									 					select x(x, x.[PARENT], rr.nocyc||x||',')
									 					in ::[ADDRESS_OBJ]
									 					join (rc : rr) on rr.parent = x and instr(rr.nocyc, ','||x||',') = 0)
									 				 select x(x)
									 				 in ::[ADDRESS_OBJ]
									 				 join (rc : rr) on rr.id = x
									 				 where x%class = ::[REGION_AREA]%class
													)
												when 2 then
													(with recursive rc(id, parent, oktmo, lvl, nocyc) as (
														select x(x, h.[PARENTID], h.[OKTMO], 1, ','||x||',')
														in ::[ADDRESS_OBJ]
														join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
														where x = s2.[STREET] and (h.[OKTMO] = v_oktmo or v_oktmo is null or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where h1.[ADDR_OBJ] = h.[ADDR_OBJ] and h1.[OKTMO] = v_oktmo))
														union all
														select x(x, h.[PARENTID], h.[OKTMO], rr.lvl+1, rr.nocyc||x||',')
														in ::[ADDRESS_OBJ]
														join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
														join (rc : rr) on rr.parent = x
																		  and instr(rr.nocyc, ','||x||',') = 0
																		  and (v_oktmo is null 
																		  	   or h.[OKTMO] = v_oktmo
																		  	   or not exists (select h1(1) in ::[ADDR_OBJ_HIERAR] where (h1.[ADDR_OBJ] = h.[ADDR_OBJ] or h1.[PARENTID] = h.[PARENTID]) and h1.[OKTMO] = v_oktmo)))
													select x(x)
									 				in ::[ADDRESS_OBJ]
									 				join (rc : rr) on rr.id = x
									 				where x%class = ::[REGION_AREA]%class
									 					   and x.[KIND].[OBJ_LEVEL] = v_level_district_m
													)
										  end : AREA) -- Район региона
									in ::[STREET]
									where s = s2.[STREET])
								where
									-- Ищем по району
									(s1.[AREA] = p_region_area and s1.[AREA].[NAME] = p_region_areaName
										or (p_region_area is null and s1.[AREA] is null)
										or (p_region_area is null and &REF_IS_NOT_NECESSARY(p_kladr))
										)
									-- Ищем по городу
									and
									 (s1.[CITY] = p_City and s1.[CITY].[NAME] = p_CityName
										or (p_City is null and s1.[CITY] is null)
										or (p_City is null and &REF_IS_NOT_NECESSARY(p_kladr))))
						loop
							if v_match < s1.match then
								v_match := s1.match;
								p_Street := s2.[STREET];
							end if;
						end loop;
						exit when v_match = 2;
					end loop;
				end; 
			end if;
			
			-- Если ничего не найдено выводим сообщение об ошибке
			if p_Street is null and p_Create and &kladr_is_not_necessary(p_kladr)then
				p_Street := ::[STREET].[NEW#AUTO](
										Name		--Наименование без типа
										,null		--Официальное наименование
										,null		--Полное наименование
										,null		--Наименование латиницей
										,Type_Ref	--Тип адресного объекта
										,nvl(p_City%id, p_region_area%id)	--Вышестоящий объект
										,null		--Код по КЛАДР
										,null		--Код по ФИАС
										,null		--Код ИФНС ЮЛ
										,null		--Код ИФНС ФЛ
										,null		--ОКАТО
										,null		--ОКТМО
										,null		--Новое наименование
										,null		--Запись устарела
										,p_Zip		--Почтовый индекс
										,null		--Статус центра
										);
				
			end if;
		end if;
		if p_Street is null then
			if p_level = v_level_street and not p_Create then
				-- пробуем поискать улицу как планировочную структуру
				Find_Street(p_Code,
							p_Name,
							p_Name_TE,
							p_Name_NT,
							p_Zip,
							p_City,
							p_Create,
							p_Kladr,
							p_Street,
							p_street_Str,
							p_Settl,
							p_Region_area,
							p_Struct,
							v_level_subarea,
							v_oktmo);
			else
				if p_Name is null and p_Code is not null then
					pragma Error('Не найдена улица по коду "'||p_Code||'"');
				end if;
			end if;
		end if;		
	end if;
	
	P_STREET_str := p_name;
	if p_struct = 2 then
		p_oktmo := v_oktmo;
	else
		p_oktmo := p_Street.[OKTMO];
	end if;
	&debug_var2(p_Street.[NAME], 0)
	&debug_var2(p_Street.[KLADR], 0)
end;

-- Получение номера дома
procedure Find_House(	p_Str		varchar2(200),
						p_NT_Str	varchar2(200),
						p_city		ref [NAMES_CITY],
						p_street	ref [STREET],
						p_Kladr		number,
						p_houseguid varchar2(200),
						p_korpus    varchar2(200),
						p_korpType	varchar2(50),
						p_building	varchar2(200),
						p_build_NT	varchar2(200),
						p_house_ref	in out ref [HOUSES],
						p_house		in out ::[PERSONAL_ADDRESS].[HOUSE]%type)
is
Type_Name	::[PEOPLE_PLACE].[NAME]%type;
Type_SName	::[PEOPLE_PLACE].[SHORT_NAME]%type;
Type_Ref	ref [PEOPLE_PLACE];
V			p_Str%type;
v_build		p_building%type;
begin
	&debug('Find_house ', 0)
	&debug_var2(p_Str, 0)
	&debug_var2(p_NT_Str, 0)
	if p_house is null then
		if p_houseguid is not null then
			for (select x(x : house) in ::[HOUSES] where x.[HOUSEGUID] = p_houseguid order by x.[ENDDATE] desc nulls first fetch 1) loop			
				p_house_ref := x.house;
				p_house 	:= p_house_ref.[NAME];
			end loop;
		end if;
		
		if p_house_ref is null then
			if p_NT_Str is not null then
				V := p_NT_Str;
			else
				Extract_Name_Type(	p_Str		== p_Str,
									p_Level		== get_act_level(6),
									p_Kladr		== p_Kladr,
									p_Name		== V,
									p_Type		== Type_Ref,
									p_Type_Name	== Type_Name,
									p_Type_SName== Type_SName);
			end if;
			
			if V is not null then
				-- Правильно ли задано значение
				if length(V) > ::[PERSONAL_ADDRESS].[HOUSE]%size then
					pragma Error('Номер дома не может содержать более '||::[PERSONAL_ADDRESS].[HOUSE]%size||' символов.');
				end if;

				if p_build_NT is not null then
					v_build := p_build_NT;
				else
					Extract_Name_Type(	p_Str		== p_building,
										p_Level		== 10,
										p_Kladr		== p_Kladr,
										p_Name		== v_build,
										p_Type		== Type_Ref,
										p_Type_Name	== Type_Name,
										p_Type_SName== Type_SName);
				end if;
				
				p_house 	:= V;
				p_house_ref := ::[HOUSES].[LIB].Get_List_house(	 p_street == p_street
																,p_city == p_city
																,p_test == true
																,p_house == V
																,p_korpus == p_korpus
																,p_building == v_build
																,p_korpType == p_korpType);
			end if;
		end if;	
	end if;
	&debug_var2(p_house_ref, 0)
	&debug_var2(p_house, 0)
end;

-- Получение корпуса, квартиры
procedure Find_Value(	p_Str		varchar2(200),
						p_NT_Str	varchar2(200),
						p_Level		integer,
						p_Kladr		number,
						p_Value		in out varchar2(50),
						p_typeValue in out varchar2(50))
is
Type_Name	::[PEOPLE_PLACE].[NAME]%type;
Type_SName	::[PEOPLE_PLACE].[SHORT_NAME]%type;
Type_Ref	ref [PEOPLE_PLACE];
V			p_Str%type;
begin
	&debug('Find_Value '||p_Level, 0)
	&debug('p_Str = '||p_Str, 0)
	&debug('p_NT_Str = '||p_NT_Str, 0)

	if p_Value is null then
		
		if p_NT_Str is not null then
			V := p_NT_Str;
		else
			Extract_Name_Type(	p_Str		== p_Str,
								p_Level		== p_Level,
								p_Kladr		== p_Kladr,
								p_Name		== V,
								p_Type		== Type_Ref,
								p_Type_Name	== Type_Name,
								p_Type_SName== Type_SName);
		end if;
		
		if V is not null then
			-- Правильно ли задано значение
			if p_Level = get_act_level(6) and length(V) > ::[PERSONAL_ADDRESS].[HOUSE]%size then
				pragma Error('Номер дома не может содержать более '||::[PERSONAL_ADDRESS].[HOUSE]%size||' символов.');
			elsif p_Level = 10 and length(V) > ::[PERSONAL_ADDRESS].[KORPUS]%size then
				pragma Error('Номер корпуса не может содержать более '||::[PERSONAL_ADDRESS].[KORPUS]%size||' символов.');
			elsif p_Level = 11 and length(V) > ::[PERSONAL_ADDRESS].[FLAT]%size then
				pragma Error('Номер квартиры/офиса не может содержать более '||::[PERSONAL_ADDRESS].[FLAT]%size||' символов.');
			end if;
			
			p_Value := V;
			p_typeValue := Type_SName;
		end if;
	end if;
	
	&debug_var2(p_Value, 0)
	&debug_var2(p_typeValue, 0)
end;


-- Получение адресного объекта по почтовому индексу и данным дома (GUID/номер дома/номер корпуса)
function Find_By_ZIP_House
(
	p_str_struct	in &api.address_str_rectype --Структура со строковыми данными адреса
	, p_Kladr		number
	, p_struct		in number --Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное
	, p_korpus		varchar2(200)
	, p_korpType	varchar2(50)
	, p_houseRef	in out ref [HOUSES]
	, p_house		in out ::[PERSONAL_ADDRESS].[HOUSE]%type
	, p_oktmo		in out ref [OKTMO]
)
return ref [ADDRESS_OBJ] is
	vAddrObj	ref [ADDRESS_OBJ];
	vHouseRef	ref [HOUSES];
	vHouse		::[PERSONAL_ADDRESS].[HOUSE]%type;

	vKorpusNum		varchar2(100)	:= coalesce(upper(p_korpus), '~NULL~');
	vKorpusType		varchar2(100)	:= upper(p_korpType);
	vBuildingNum	varchar2(200)	:= null;
	vObjName		varchar2(300);


	vTypeName			::[PEOPLE_PLACE].[NAME]%type;
	vTypeSName			::[PEOPLE_PLACE].[SHORT_NAME]%type;
	vTypeRef			ref [PEOPLE_PLACE];
	vHouseNum			varchar2(200);
	vNameCity			varchar2(200);
	vTypeNameCity		::[PEOPLE_PLACE].[NAME]%type;
	vTypeSNameCity		::[PEOPLE_PLACE].[SHORT_NAME]%type;
	vTypeRefCity		ref [PEOPLE_PLACE];
	vNameStreet			varchar2(200);
	vTypeNameStreet		::[PEOPLE_PLACE].[NAME]%type;
	vTypeSNameStreet	::[PEOPLE_PLACE].[SHORT_NAME]%type;
	vTypeRefStreet		ref [PEOPLE_PLACE];
	vCityRef			ref [ADDRESS_OBJ];
	
begin
	&debug('Find_By_ZIP_House', 0)
	if p_house is null then
		if p_str_struct.objectguid is not null then
			for (select x(x : house) in ::[HOUSES] where x.[HOUSEGUID] = p_str_struct.objectguid order by x.[ENDDATE] desc nulls first fetch 1) loop			
				p_houseRef	:= x.house;
				p_house 	:= p_houseRef.[NAME];
				vAddrObj	:= p_houseRef.[AOGUID];
			end loop;
		end if;
		
		if p_houseRef is null then
			if p_str_struct.house.num_nt is not null then
				VHouseNum := p_str_struct.house.num_nt;
			else
				Extract_Name_Type(	p_Str		== p_str_struct.house.num,
									p_Level		== get_act_level(6),
									p_Kladr		== p_Kladr,
									p_Name		== VHouseNum,
									p_Type		== vTypeRef,
									p_Type_Name	== vTypeName,
									p_Type_SName== vTypeSName);
			end if;
			
			if VHouseNum is not null then
				-- Правильно ли задано значение
				if length(VHouseNum) > ::[PERSONAL_ADDRESS].[HOUSE]%size then
					pragma Error('Номер дома не может содержать более '||::[PERSONAL_ADDRESS].[HOUSE]%size||' символов.');
				end if;
				
				if p_str_struct.building.num_nt is not null then
					vBuildingNum := p_str_struct.building.num_nt;
				elsif p_str_struct.building.num then
					Extract_Name_Type(	p_Str		== p_str_struct.building.num,
										p_Level		== 10,
										p_Kladr		== p_Kladr,
										p_Name		== vBuildingNum,
										p_Type		== vTypeRef,
										p_Type_Name	== vTypeName,
										p_Type_SName== vTypeSName);
				end if;
				
				-- данные улицы: 
				if p_str_struct.street.name is not null or p_str_struct.street.name_nt is not null or p_str_struct.street.name_te is not null then
				
					vNameStreet := coalesce(p_str_struct.street.name, p_str_struct.street.name_te);
					
					if vNameStreet is not null then
						Extract_Name_Type(	p_Str		== vNameStreet,
											p_Level		== v_level_street,
											p_Kladr		== p_Kladr,
											p_Name		== vObjName,
											p_Type		== vTypeRefStreet,
											p_Type_Name	== vTypeNameStreet,
											p_Type_SName== vTypeSNameStreet);
					else
						vObjName := p_str_struct.street.name_nt;
					end if;
					&debug('vNameStreet(street) = '	|| vNameStreet, 0)
					&debug('vObjName(street) = '	|| vObjName, 0)
					
				elsif p_str_struct.subarea.name is not null or p_str_struct.subarea.name_nt is not null or p_str_struct.subarea.name_te is not null then
					vNameStreet := coalesce(p_str_struct.subarea.name, p_str_struct.subarea.name_te);
					if vNameStreet is not null then
						Extract_Name_Type(	p_Str		== vNameStreet,
											p_Level		== v_level_subarea,
											p_Kladr		== p_Kladr,
											p_Name		== vObjName,
											p_Type		== vTypeRefStreet,
											p_Type_Name	== vTypeNameStreet,
											p_Type_SName== vTypeSNameStreet);
					else
						vObjName := p_str_struct.subarea.name_nt;
					end if;
					&debug('vNameStreet(subarea) = '|| vNameStreet, 0)
					&debug('vObjName(subarea) = '	|| vObjName, 0)
				end if;
				vNameStreet := upper(vObjName);

				-- город: 
				if p_str_struct.town.name is not null or p_str_struct.town.name_nt is not null or p_str_struct.town.name_te is not null then
				
					vNameCity := coalesce(p_str_struct.town.name, p_str_struct.town.name_te);
					if vNameCity is not null then
						Extract_Name_Type(	p_Str		== vNameCity,
											p_Level		== get_act_level(4),
											p_Kladr		== p_Kladr,
											p_Name		== vObjName,
											p_Type		== vTypeRefCity,
											p_Type_Name	== vTypeNameCity,
											p_Type_SName== vTypeSNameCity);
					else
						vObjName := p_str_struct.town.name_nt;
					end if;
					vNameCity := upper(vObjName);
					&debug('vNameCity(town) = '	|| vNameCity, 0)
					&debug('vObjName(town) = '	|| vObjName, 0)
					
				elsif p_str_struct.city.name is not null or p_str_struct.city.name_nt is not null or p_str_struct.city.name_te is not null then
					vNameCity := coalesce(p_str_struct.city.name, p_str_struct.city.name_te);
					if vNameCity is not null then
						Extract_Name_Type(	p_Str		== vNameCity,
											p_Level		== get_act_level(3),
											p_Kladr		== p_Kladr,
											p_Name		== vObjName,
											p_Type		== vTypeRefCity,
											p_Type_Name	== vTypeNameCity,
											p_Type_SName== vTypeSNameCity);
					else
						vObjName := p_str_struct.city.name_nt;
					end if;
					vNameCity := upper(vObjName);
					&debug('vNameCity(city) = '	|| vNameCity, 0)
					&debug('vObjName(city) = '	|| vObjName, 0)
				end if;
				
				vObjName := coalesce(vNameStreet, vNameCity);
				&debug('vObjName = ' || vObjName, 0)
				
				if vObjName is not null then
					for (
						select u( u%id				: ID
								, u.[AOGUID].[NAME]	: AOGUID_NAME
								, u.[AOGUID]		: AOGUID
								, coalesce(upper(u.[KORP]),'~NULL~')					: KORP
								, coalesce(upper(u.[KORP_TYPE].[SHORT_NAME]),'~NULL~')	: KORPTYPE
								, coalesce(upper(u.[STRUCNUM]),'~NULL~')				: STRUCT
								, coalesce(upper(u.[STRSTATUS].[SHORT_NAME]),'~NULL~')	: STRSTATUS
								)
							in	::[HOUSES] all
						where	u.[ZIP] = p_str_struct.post_code
							and	coalesce(upper(u.[NAME]), '~NULL~') = vHouseNum
							and coalesce(upper(u.[AOGUID].[NAME]), '~NULL~') = vObjName
						order by
							case when u.[HOUSEGUID] is not NULL then 1 else 2 end
							, case when u.[ESTSTATUS] is not NULL then 1 else 2 end
						)
					loop
						if u.KORP = vKorpusNum and u.STRUCT = coalesce(upper(vBuildingNum), '~NULL~')
							and (vKorpusType is null or upper(coalesce(u.KORPTYPE,'~NULL~')) = vKorpusType)
							or
							vBuildingNum is null and u.KORP = '~NULL~' and replace(vKorpusNum, ' ') in (u.STRUCT, u.STRSTATUS || u.STRUCT)
						then
							vAddrObj := u.AOGUID;
							if vObjName = vNameStreet then -- проверим принадлежность правильному нас.пункту
								vCityRef := ::[PERSONAL_ADDRESS].[API_LIB].get_city(vAddrObj);
								if upper(vCityRef.[NAME]) = vNameCity then
									p_houseRef := u.id;
									p_house := VHouseNum;
									exit;
								else
									vAddrObj := null;
								end if;
							else
								p_houseRef := u.id;
								p_house := VHouseNum;
								exit;
							end if;
						end if;
					end loop;
				end if;
			end if;
		end if;	
	end if;
	if p_houseRef is not null and p_houseRef.[HOUSEGUID] is not null then
		p_house	:= case when p_houseRef.[ESTSTATUS].[CODE] = '1' and p_houseRef.[ESTSTATUS].[EST_STR_STAT] = true then nvl(p_houseRef.[ESTSTATUS].[SHORT_NAME],'влд')
							when p_houseRef.[ESTSTATUS].[CODE] = '3'and p_houseRef.[ESTSTATUS].[EST_STR_STAT] = true then nvl(p_houseRef.[ESTSTATUS].[SHORT_NAME],'двлд')
						end ||p_houseRef.[NAME];
	end if;
	&debug_var2(p_houseRef, 0)
	&debug_var2(p_house, 0)
	&debug('	vAddrObj = '|| vAddrObj, 0)
	return vAddrObj;
end;



public function getListAddr (p_addrObj ref [ADDRESS_OBJ], p_class varchar2(16) default 'AREA') return varchar2(1000) is
	v_name varchar2(1000);
begin
	v_name := ',';
	
	if p_class = 'REGION' then
		for (with recursive rc(id, parent, nocyc) as (
				select h(h, h.[PARENTID], ','||h||',') 
					in ::[ADDR_OBJ_HIERAR] where h.[ADDR_OBJ] = p_AddrObj
				union all
				select h(h, h.[PARENTID], rr.nocyc||h||',')
					in ::[ADDR_OBJ_HIERAR]
					join (rc : rr) on rr.parent = h.[ADDR_OBJ] and instr(rr.nocyc, ','||h||',') = 0)
			 select distinct r(r.[ADDR_OBJ].[NAME] : name)
			 in ::[ADDR_OBJ_HIERAR]
			 join (rc : rr) on rr.id = r
			 where r.[ADDR_OBJ]%class = ::[CODE_REGION]%class
			 )
		loop
			if instr(v_name, ','||r.name||',') = 0 then
				v_name := v_name || r.name || ',';
			end if;
		end loop;
	elsif p_class = 'CITY' then
		for (with recursive rc(id, parent, cls, nocyc) as (
				select x(x, h.[PARENTID], x%class, ','||x||',')
				in ::[ADDRESS_OBJ]
				join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
				where x = p_addrObj
				union all
				select x(x, h.[PARENTID], x%class, rr.nocyc||x||',')
				in ::[ADDRESS_OBJ]
				join (::[ADDR_OBJ_HIERAR] : h) on x = h.[ADDR_OBJ]
				join (rc : rr) on rr.parent = x
								  and rr.cls != ::[NAMES_CITY]%class 
								  and instr(rr.nocyc, ','||x||',') = 0)
			
			select distinct r(r.[NAME] : name, r.[KIND].[SHORT_NAME] : short_name)
			in ::[ADDRESS_OBJ]
			join (rc : rr) on rr.id = r
			where r%class = ::[NAMES_CITY]%class)
		loop
			if instr(v_name, ','||r.name || ' ' || r.short_name ||',') = 0 then
				v_name := v_name || r.name || ' ' || r.short_name || ',';
			end if;
		end loop;
	else
		for (with recursive rc(id, parent, oktmo, nocyc) as (
				select h(h, h.[PARENTID], h.[OKTMO], ','||h||',') 
					in ::[ADDR_OBJ_HIERAR] where h.[ADDR_OBJ] = p_AddrObj
				union all
				select h(h, h.[PARENTID], h.[OKTMO], rr.nocyc||h||',')
					in ::[ADDR_OBJ_HIERAR]
					join (rc : rr) on rr.parent = h.[ADDR_OBJ] and rr.oktmo = h.[OKTMO] and instr(rr.nocyc, ','||h||',') = 0)
			 select distinct r(r.[ADDR_OBJ].[NAME] : name)
			 in ::[ADDR_OBJ_HIERAR]
			 join (rc : rr) on rr.id = r
			 where r.[ADDR_OBJ]%class = ::[REGION_AREA]%class
			 )
		loop
			if instr(v_name, ','||r.name||',') = 0 then
				v_name := v_name || r.name || ',';
			end if;
		end loop;
	end if;
	v_name := trim(v_name,',');
	return v_name;
end; 

-- *** Инициализация работы с адресами ***

public procedure init_vars is
begin
	v_format_version := null;
	v_level_region := get_level(1);
	v_level_district := get_level(2);
	v_level_district_m := get_level(3);
	v_level_settlement := get_level(4);
	v_level_city := get_level(5);
	v_level_town := get_level(6);
	v_level_subarea := get_level(7);
	v_level_street := get_level(8);
	
	v_our_country := v_our_country_ref;
end;

begin -- Инициализация пакета
	init_vars;
end;
end;
