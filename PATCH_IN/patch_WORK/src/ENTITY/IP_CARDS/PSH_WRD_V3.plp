-- Разбивает строку ФИО на 3 строки Фамилия Имя Отчество
-- по 2-м встреченным пробелам
function Div_Name_FIO (full_n varchar2) return varchar2
is
	pos1 integer;
	pos2 integer;
	family varchar2(32);
	name varchar2(32);
	sname varchar2(32);
begin
	full_n :=trim(full_n);
	pos1 := instr(full_n, ' ');		
	pos2 := instr(full_n, ' ', 1, 2);
	if pos2 = 0 then -- нет отчества
		family := substr(full_n, 1, pos1-1);
		name := substr(full_n,pos1+1);
		sname := '';
	else			-- полное имя (Ф И О)
		family := substr(full_n, 1, pos1-1);
		name := substr(full_n,pos1+1,pos2-pos1-1);
		sname := substr(full_n,pos2+1);
	end if;

	if SName is null or SName = '' then
		return Family||' '||substr(Name,1,1)||'.' ;
	else
		return Family||' '||substr(Name,1,1)||'.'||substr(SName,1,1)||'.' ;
	end if;
end;

function GetOkatoCode
/* Функция для получения ОКАТО с клиента */
(
	p_CLIENT_REF	ref [CLIENT]
	/* Ссылка на клиента */
)
/* Возвращаемое значение - ОКАТО */
return varchar2(11) is
	v_okato	varchar2(11);
begin
	-- значение ОКАТО берем из реквизита "Код ОКАТО" на клиенте
	for (	select x(x.[OKATO_CODE]	:	OKATO_CODE)
			in ::[CLIENT] all
			where x = p_CLIENT_REF)
	loop
		v_okato := x.OKATO_CODE;
		exit;
	end loop;
	return v_okato;
end;

Procedure GetClientReq(IdClient ref [CLIENT], OnDate date) is	
Begin
	V_CASTA_1C		:= null;
	V_DEF_1C		:= null;
	V_CASTA_C1_RP	:= null;
	V_FIO_C1_RP		:= null;
	V_F_IO_1C		:= null;
	V_CASTA_2C		:= null;
	V_DEF_2C		:= null;
	V_CASTA_C2_RP	:= null;
	V_FIO_C2_RP		:= null;
	V_F_IO_2C		:= null;
	V_OKPO			:= null;
	V_OGRN			:= null;

	-- Адреса клиента
	::[DEPN_INTERFACE].[PRX_CLIENT].GetAddressClient(IdClient
												,V_ADR_MASK
												,V_CITY_C												
												,V_ADRESS_C
												,V_ADRESS_C_POST
												,V_OKATO_C);

	if IdClient%class in ('CL_ORG', 'CL_BANK', 'CL_BANK_N') then
		/*	Если на клиенте адрес задан строкой, то после вызова GetAddressClient значение переменной
			V_OKATO_C будет пустым, т.к. там ОКАТО берется с города */
		if V_OKATO_C is null then
			V_OKATO_C := GetOkatoCode(IdClient);
			&debug('После вызова GetAddressClient ОКАТО не определен. Значение ОКАТО с клиента: ' || V_OKATO_C, 0)
		end if;
		V_ALL_BOSS_C := IdClient->(CL_CORP)[ALL_BOSS];
		begin -- 1-ая подпись со стороны клиента
			V_CASTA_1C := V_ALL_BOSS_C([CHIEF] and [SIGN_TODAY]); --Директор
			::[DEPN_INTERFACE].[PRX_CLIENT].GetCastClient(IdClient
													,V_CASTA_1C
													,V_DEF_1C
													,V_CASTA_C1_RP
													,V_FIO_C1_RP
													,V_F_IO_1C
													,OnDate
													,V_CLASS);
		exception when others then
			null;
		end;
		begin -- 2-ая подпись со стороны клиента
			V_CASTA_2C := V_ALL_BOSS_C([GENERAL_ACC] and [SIGN_TODAY]); --Главный бухгалтер
			::[DEPN_INTERFACE].[PRX_CLIENT].GetCastClient(IdClient
													,V_CASTA_2C
													,V_DEF_2C
													,V_CASTA_C2_RP
													,V_FIO_C2_RP
													,V_F_IO_2C
													,OnDate
													,V_CLASS);
		exception when others then
			null;
		end;
		declare
			v_client_info	::[DEPN_INTERFACE].[PRX_CLIENT].ClCorpRegInfo%type;
		begin
			v_client_info := ::[DEPN_INTERFACE].[PRX_CLIENT].GetCorpRegInfo(IdClient);
			V_OKPO := v_client_info.[okpo_code];
			if ::[DEPN_INTERFACE].[PRX_CLIENT].RESIDENT(IdClient) then
				V_OGRN := coalesce(v_client_info.ogrn, v_client_info.reg_num);
			else
				V_OGRN := v_client_info.reg_num;
			end if;
		end;
	elsif IdClient%class = 'CL_PRIV' then
		V_ALL_BOSS_C := null;
		begin -- 1-ая подпись со стороны клиента
			::[DEPN_INTERFACE].[PRX_CLIENT].GetCastClient(IdClient
													,V_CASTA_1C
													,V_DEF_1C
													,V_CASTA_C1_RP
													,V_FIO_C1_RP
													,V_F_IO_1C
													,OnDate
													,V_CLASS);
		exception when others then
			null;
		end;
	end if;
	-- Телефоны клиента
	::[DEPN_INTERFACE].[PRX_CLIENT].GetPhoneClient(IdClient, V_PHONE_1C, V_PHONE_2C);
end;

Procedure GetBankReq(IdBank ref [CL_ORG], OnDate date) is
Begin
	V_ALL_BOSS_B := IdBank.[ALL_BOSS];
	V_CASTA_1B = V_CASTA_2B := null;

	::[DEPN_INTERFACE].[PRX_CLIENT].GetInfoBank(	IdBank
											,V_BIC_B
											,V_KS_B
											,V_OKONH_B
											,V_CONTACTS_B
											,V_CITY_B
											,V_ADR_MASK
											,V_ADRESS_B
											,V_ADRESS_B_POST
											,V_OKATO_B
											,V_CASTA_1B
											,V_DEF_1B
											,V_CASTA_B1_RP
											,V_FIO_B1_RP
											,V_F_IO_1B
											,V_CASTA_2B
											,V_DEF_2B
											,V_CASTA_B2_RP
											,V_FIO_B2_RP
											,V_F_IO_2B
											,OnDate
											,V_CLASS);
	
	
	-- Телефоны банка
	::[DEPN_INTERFACE].[PRX_CLIENT].GetPhoneClient(V_CASTA_1B.[FASE], V_PHONE_11B, V_PHONE_12B);
	::[DEPN_INTERFACE].[PRX_CLIENT].GetPhoneClient(V_CASTA_2B.[FASE], V_PHONE_21B, V_PHONE_22B);
End;
