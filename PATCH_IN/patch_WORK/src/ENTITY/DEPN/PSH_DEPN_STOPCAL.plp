class DEPN;

@name('[ПСБ] Редактировать "Прекратить начисление, Выплачивать, Причислять %%" (служебная)')
@tag('COPIED')
method PSH_DEPN_STOPCAL is
PSH_DEPN_STOPCAL (
	@name('Прекратить начисление %%') P_STOP_INT_CALC  in [BOOLEAN],
	@name('Выплачивать %%')           V_PAY_ADD_PRC    in [ONE_FROM_THREE],
	@name('Причислять %%')            V_PRC_TO_ACCOUNT in [ONE_FROM_THREE]
) is

validate is
begin
	if p_message = 'DEFAULT' then
		P_STOP_INT_CALC:=true;
		V_PAY_ADD_PRC.[0]:=3;
		V_PRC_TO_ACCOUNT.[0]:=3;
	end if;
end;

execute is
/*********************************************************************
Назначение:

BASHKIROV, последнее изменение 31 Май 2019 г.
*********************************************************************/
refProd reference;
msg string(200);

P_PAY_ADD_PRC		boolean;
P_PRC_TO_ACCOUNT	boolean;
begin
	refProd:=this%id;
	for d in ::[DEPN] all where d%id=refProd%id loop
		if (d.[STOP_INT_CALC] is null and P_STOP_INT_CALC is null)
			or
		   ((d.[STOP_INT_CALC] is not null and P_STOP_INT_CALC is not null) and d.[STOP_INT_CALC]=P_STOP_INT_CALC)
		then
			debug_pipe('Договор №'||this.[NUM_DOG_EXT]||' Не нужно редактировать <Прекратить начисление %%>',0);
			null;
		else
			msg:='Договор №'||this.[NUM_DOG_EXT]||' Меняем <Прекратить начисление %%> "'||d.[STOP_INT_CALC]||'"->"'||P_STOP_INT_CALC||'"';
			debug_pipe(msg,0);
			::[CL_PRIV].[PSH_DATE_DEATH].UniLog(
				Substr('ID:'||this%id||' '||msg,1,350),
				Rpad('StopIntCal',10),			--тема
				'_'||&METHOD$SNAME||'.log');	--log
			d.[STOP_INT_CALC]:=P_STOP_INT_CALC;
		end if;
		
		--Выплачивать %%
		if V_PAY_ADD_PRC.[0] is null or V_PAY_ADD_PRC.[0] = 1 then
			P_PAY_ADD_PRC := null;
		elsif V_PAY_ADD_PRC.[0] = 2 then
			P_PAY_ADD_PRC := true;
		else
			P_PAY_ADD_PRC := false;
		end if;
		if (d.[PAY_ADD_PRC] is null and P_PAY_ADD_PRC is null)
			or
		   ((d.[PAY_ADD_PRC] is not null and P_PAY_ADD_PRC is not null) and d.[PAY_ADD_PRC]=P_PAY_ADD_PRC)
		then
			debug_pipe('Договор №'||this.[NUM_DOG_EXT]||' Не нужно редактировать <Выплачивать %%>',0);
			null;
		else
			msg:='Договор №'||this.[NUM_DOG_EXT]||' Меняем <Выплачивать %%>           "'||d.[PAY_ADD_PRC]||'"->"'||P_PAY_ADD_PRC||'"';
			debug_pipe(msg,0);
			::[CL_PRIV].[PSH_DATE_DEATH].UniLog(
				Substr('ID:'||this%id||' '||msg,1,350),
				Rpad('StopIntCal',10),			--тема
				'_'||&METHOD$SNAME||'.log');	--log
			d.[PAY_ADD_PRC]:=P_PAY_ADD_PRC;
		end if;
		
		--Причислять %%
		if V_PRC_TO_ACCOUNT.[0] is null or V_PRC_TO_ACCOUNT.[0] = 1 then
			P_PRC_TO_ACCOUNT := null;
		elsif V_PRC_TO_ACCOUNT.[0] = 2 then
			P_PRC_TO_ACCOUNT := true;
		else
			P_PRC_TO_ACCOUNT := false;
		end if;
		if (d.[PRC_TO_ACCOUNT] is null and P_PRC_TO_ACCOUNT is null)
			or
		   ((d.[PRC_TO_ACCOUNT] is not null and P_PRC_TO_ACCOUNT is not null) and d.[PRC_TO_ACCOUNT]=P_PRC_TO_ACCOUNT)
		then
			debug_pipe('Договор №'||this.[NUM_DOG_EXT]||' Не нужно редактировать <Причислять %%>',0);
			null;
		else
			msg:='Договор №'||this.[NUM_DOG_EXT]||' Меняем <Причислять %%>            "'||d.[PRC_TO_ACCOUNT]||'"->"'||P_PRC_TO_ACCOUNT||'"';
			debug_pipe(msg,0);
			::[CL_PRIV].[PSH_DATE_DEATH].UniLog(
				Substr('ID:'||this%id||' '||msg,1,350),
				Rpad('StopIntCal',10),			--тема
				'_'||&METHOD$SNAME||'.log');	--log
			d.[PRC_TO_ACCOUNT]:=P_PRC_TO_ACCOUNT;
		end if;
		
		exit;
	end loop;
end;
end;
end;
