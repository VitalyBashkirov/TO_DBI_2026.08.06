					end loop;
				end loop;
			elsif p_info = 'ФИО_КЛИЕНТА' then   --ФИО_КЛИЕНТА
		 		P_DATA := client_priv.[NAME];
			elsif p_info = 'ДАТА_РЕГИСТРАЦИИ' then
				for (select x(x.[REGISTER].[DATE_REG] : date_reg)
					in client_org_ref
				)
				loop
					P_DATA := to_char(x.date_reg, 'dd.mm.yyyy');
				end loop;
			elsif p_info = 'ОГРНИП' then
				for (select x(x.[REGISTER].[GOS_REG_NUM_REC] : gos_reg_num_rec)
					in client_org_ref
				)
				loop
					P_DATA := x.gos_reg_num_rec;
				end loop;
			elsif p_info = 'МЕСТО_РЕГИСТРАЦИИ' then
				for (select x(x.[REGISTER].[REG_BODY].[NAME] : reg_body)
					in client_org_ref
				)
				loop
					P_DATA := x.reg_body;
				end loop;
--Лицензии
			elsif p_info = 'ЛИЦЕНЗИЯ_ВИД' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						P_DATA := lic.l_type;
						exit;
					end loop;				
				 	
			elsif p_info = 'ЛИЦЕНЗИЯ_НОМЕР' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						P_DATA := lic.l_num;
						exit;
					end loop;
					
			elsif p_info = 'ЛИЦЕНЗИЯ_ДАТА_ВЫДАЧИ' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						P_DATA := to_char(lic.l_date1, 'dd.mm.yyyy');
						exit;
					end loop;
			
			elsif p_info = 'ЛИЦЕНЗИЯ_КЕМ' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						P_DATA := lic.l_who;
						exit;
					end loop;
			
			elsif p_info = 'ЛИЦЕНЗИЯ_СРОК' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						P_DATA := to_char(lic.l_date2, 'dd.mm.yyyy');
						exit;
					end loop;
--Паспорт
			elsif p_info = 'ДОКУМЕНТ_ВИД' then      
				P_DATA := nvl(client_priv.[DOC].[TYPE].[NAME], '');
			elsif p_info = 'ДОКУМЕНТ_СЕРИЯ' then      
				P_DATA := nvl(client_priv.[DOC].[SER], '');
			elsif p_info = 'ДОКУМЕНТ_НОМЕР' then      
				P_DATA := nvl(client_priv.[DOC].[NUM], '');
			elsif p_info = 'ДОКУМЕНТ_Д_ВЫДАЧИ' then      
				P_DATA := nvl(to_char(client_priv.[DOC].[DATE],'dd.mm.yyyy'), '');
			elsif p_info = 'ДОКУМЕНТ_ВЫДАН' then      
				P_DATA := nvl(client_priv.[DOC].[WHO], '');
			elsif p_info = 'ДОКУМЕНТ_КОД_ПОДР' then      
				P_DATA := nvl(client_priv.[DOC].[DEPART_CODE], '');
--Доп. удостоверения
			elsif p_info = 'ДОП_ДОК_ВИД' then
				for (select x(x.[TYPE] : cert_type)
					in client_priv.[DOC_ARR]
				)
				loop
					P_DATA := x.cert_type;
				end loop;
			elsif p_info = 'ДОП_ДОК_СЕРИЯ' then
				for (select x(x.[SER] : ser)
					in client_priv.[DOC_ARR]
				)
				loop
					P_DATA := x.ser;
				end loop;
			elsif p_info = 'ДОП_ДОК_НОМЕР' then
				for (select x(x.[NUM] : num)
					in client_priv.[DOC_ARR]
				)
				loop
					P_DATA := x.num;
				end loop;
			elsif p_info = 'ДОП_ДОК_ДАТА_НАЧ' then
				for (select x(x.[DATE] : date_beg)
					in client_priv.[DOC_ARR]
				)
				loop
					P_DATA := to_char(x.date_beg, 'dd.mm.yyyy');
				end loop;
			elsif p_info = 'ДОП_ДОК_ДАТА_ОКОН' then
				for (select x(x.[DATE_END] : date_end)
					in client_priv.[DOC_ARR]
				)
				loop
					P_DATA := to_char(x.date_end, 'dd.mm.yyyy');
				end loop;
--Миграционная карта
			elsif p_info = 'МИГР_КАРТА_ВИД' then
				for (select x(x : migr_card)
					in client_priv.[MIGR_CARD]
				)
				loop
					P_DATA := 'Миграционная карта';
				end loop;
			elsif p_info = 'МИГР_КАРТА_СЕРИЯ' then
				for (select x(x.[CARD_SERIA] : card_seria)
					in client_priv.[MIGR_CARD]
				)
				loop
					P_DATA := x.card_seria;
				end loop;
			elsif p_info = 'МИГР_КАРТА_НОМЕР' then
				for (select x(x.[CARD_NUM] : card_num)
					in client_priv.[MIGR_CARD]
				)
				loop
					P_DATA := x.card_num;
				end loop;
			elsif p_info = 'МИГР_КАРТА_ДАТА_НАЧ' then
				for (select x(x.[DATE_BEG] : date_beg)
					in client_priv.[MIGR_CARD]
				)
				loop
					P_DATA := to_char(x.date_beg, 'dd.mm.yyyy');
				end loop;
			elsif p_info = 'МИГР_КАРТА_ДАТА_ОКОН' then
				for (select x(x.[DATE_END] : date_end)
					in client_priv.[MIGR_CARD]
				)
				loop
					P_DATA := to_char(x.date_end, 'dd.mm.yyyy');
				end loop;
			elsif p_info = 'ВОО' then
				if stdlib.userid.[CASTA].[CODE] in ('PSB_73', 'PSH_58', 'IBS') then
					P_DATA := 1;
				else
					P_DATA := 0;
				end if;
			elsif p_info = 'ПЕРЕЧЕНЬ_КОНТР_ДАТ' then
				P_DATA := to_char(cl_info.[FIRST_ACC_DATE], 'dd/mm/yyyy');
				for (select x(x.[CTRL_DATE] : ctrl_date)
					in ::[PSH_LEGAL_DATES]
					where x.[CTRL_DATE] > cl_info.[FIRST_ACC_DATE] and x.[CTRL_DATE] <= nvl(cl_info.[CLOSE_DATE], ::[SYSTEM].[OP_DATE])
					order by x.[CTRL_DATE] asc
				)
				loop
					P_DATA := P_DATA || ', ' || to_char(x.ctrl_date, 'dd/mm/yyyy');
				end loop;
--*/ Расширение анкеты IDA2506			   
			end if; --end P_info значимых полей

			--Воробей В.А. 29.05.2019 Прочие вычисляемые параметры клиента
			&debug('p_info='||p_info||' P_DATA="'||P_DATA||'"',dp2)	
			var Last_P_DATA varchar2(32767);
			Last_P_DATA:=P_DATA;
			if nvl(Length(trim(P_DATA)),0)=0 or Upper(trim(P_DATA))='НЕТ' then
			   P_DATA:=CalcParmClient(p_info, coalesce(::[CL_PRIV].PSH_WRD_IPCLANK.client_org_ref,this%id,cl_priv%id,rClOrg%id));
			   if P_DATA is not null then goto nnn; end if;
			   P_DATA:=nvl(P_DATA,Last_P_DATA);
			end if;
			
			--Башкиров В.Г. 21.05.2019 Добавлен поиск произвольного доп.свойства
			--Башкиров В.Г. 22.05.2019 Для РЕПУТАЦИЯ_PLUS и ФИНПОЛОЖЕНИЕ_PLUS null,Да - Положительная(ое) Нет - Отрицательная(ое) (Письмо от Лопухова С.Н., Карзановой Е.В. от 22.05.2019)
			if p_info='НЕ_ПРЕД_КЛ_ИЛИ_БЕНЕФ' then
				&debug('Ищем доп.свойство "ПРЕД_КЛ" P_DATE_PRINT='||to_char(P_DATE_PRINT,fmt),dp2)	
				if GetAddProps(P_DATE_PRINT, 'ПРЕД_КЛ') is null and
				   GetAddProps(P_DATE_PRINT, 'БЕНЕФ') is null then
				   P_DATA:= ' V '; --'Да' "Птица" для квадратика в анкете
				end if;
	 		elsif p_info = 'РЕПУТАЦИЯ_PLUS' then
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'РЕПУТАЦИЯ_PLUS');
                if    P_DATA is null or Upper(trim(P_DATA))='ДА'  then P_DATA := 'Положительная';
                elsif Upper(trim(P_DATA))='НЕТ' 				  then P_DATA := 'Отрицательная';
                end if;

	 		elsif p_info = 'ФИНПОЛОЖЕНИЕ_PLUS' then
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'ФИНПОЛОЖЕНИЕ_PLUS');
                if    P_DATA is null or Upper(trim(P_DATA))='ДА'  then P_DATA := 'Положительное';
                elsif Upper(trim(P_DATA))='НЕТ' 				  then P_DATA := 'Отрицательное';
                end if;

            -- KAS 20/05/2021 для анкет по 499-П
	 		elsif p_info = 'НАЛОГОВЫЙ_СТАТУС2' then
	 		--7.1.	Сведения о наличии статуса налогового резидента иностранного государства
                temp_str := GetAddPropVal(client_corp%id, 'НАЛОГОВЫЙ_СТАТУС2', P_DATE_PRINT);
                --debug_pipe('temp_str='||temp_str,0);
                if client_corp.[NU_REZIDENT] and temp_str is null then
		 			P_DATA := 'являюсь налоговым резидентом только РФ';
                elsif  temp_str is not null then
		 			P_DATA := 'являюсь налоговым резидентом иностранного государства ';
		 			P_DATA := P_DATA||temp_str;
                else
		 			P_DATA := 'являюсь налоговым резидентом иностранного государства ';
		 				if client_corp.[COUNTRY].[NAME] is not null then
					    	P_DATA :=P_DATA||client_corp.[COUNTRY].[NAME];
					    	
						end if;
		 		end if;	
           	
 	 		elsif p_info = 'SITIZEN_USA' then
 			-- 7.2. Если Вы указали страну рождения США, являетесь ли Вы гражданином США   	 		
		 		temp_str := GetAddPropVal(this, 'SITIZEN_USA', P_DATE_PRINT);
		 		--debug_pipe('temp_str='||temp_str,0);
		 		P_DATA :=temp_str;

			end if;
			if trim(P_DATA) is null and nvl(InStr(Upper(p_info),'_ЛОГИКА'),0)=0 then
				--Башкиров В.Г. 28.05.2019 Для кодов типа CL_ANK_PDL_INFO_ (последний символ "_") если значение пустое - выдавать " " вместо "нет"
				if Substr(p_info,Length(p_info))='_' then
					&debug('Обрезаем последний символ кода "_" (признак вывода " " вместо "Нет") '||p_info||'->'||Substr(p_info,1,Length(p_info)-1),dp2)
					p_info:=Substr(p_info,1,Length(p_info)-1); flSpace:=true;
				end if;
				--
				&debug('Ищем доп.свойство "'||p_info||'" P_DATE_PRINT='||to_char(P_DATE_PRINT,fmt),dp2)
				if this%class='CL_ORG' then rClOrg:=this%id;
				else						rClOrg:=::[CL_PRIV].PSH_WRD_IPCLANK.client_org_ref;
				end if;
				
				temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
				for dop in rClOrg.[ADD_PROP]
				where Upper(dop.[GROUP_PROP].[CODE])=Upper(p_info) and
					nvl(dop.[DATE_BEG],P_DATE_PRINT)<=P_DATE_PRINT and P_DATE_PRINT<=nvl(dop.[DATE_END],P_DATE_PRINT)
				loop
					/** /
					&debug('rClOrg.[ADD_PROP]  ='||rClOrg.[ADD_PROP]||' dop%collection='||dop%collection||' dop%id='||dop%id||' dop.[GROUP_PROP].[CODE]='||dop.[GROUP_PROP].[CODE]||' dop.[GROUP_PROP].[TYPE_VALUE]='||dop.[GROUP_PROP].[TYPE_VALUE],dp2)
					&debug('dop.[PROP].[NAME]='||dop.[PROP].[NAME],dp2)
					&debug('dop.[NUM]        ='||dop.[NUM],dp2)
					&debug('dop.[STR]('||length(dop.[STR])||')='||dop.[STR],dp2)
					&debug('dop.[V_DATE]     ='||dop.[V_DATE],dp2)
					&debug('dop.[BOOL]       ='||dop.[BOOL],dp2)
					&debug('dop.[REF]        ='||::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),dp2)
					/**/
					temp_str := trim(
						iif(dop.[GROUP_PROP].[TYPE_VALUE] is null ,dop.[PROP].[NAME],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='NUMBER',to_char(dop.[NUM],'999G999G999G999G990D0099'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='STRING',dop.[STR],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='DATE'  ,to_char(dop.[V_DATE],fmt),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='BOOL'  ,iif(dop.[BOOL],'Да','Нет'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='REF'   ,::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),'')
						           );
					&debug('Нашли группу '||dop.[GROUP_PROP].[CODE]||'-'||dop.[GROUP_PROP].[NAME]||' С типом значения:'||dop.[GROUP_PROP].[TYPE_VALUE]||' -> '||temp_str,dp2)
					exit;
				end loop;
				if temp_str is null or (InStr(Upper(p_info),'_ЛОГИКА')>0 and trim(temp_str)='') then
					var p_info2 varchar(100);
					if InStr(Upper(p_info),'_ЛОГИКА')>0 then p_info2:=SubStr(Upper(p_info),1,InStr(Upper(p_info),'_ЛОГИКА')-1);
						&debug('Ищем доп.свойство "'||p_info2||'" P_DATE_PRINT='||to_char(P_DATE_PRINT,fmt),dp2)
			
						temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
						for dop in rClOrg.[ADD_PROP]
						where Upper(dop.[GROUP_PROP].[CODE])=Upper(p_info2) and
							nvl(dop.[DATE_BEG],P_DATE_PRINT)<=P_DATE_PRINT and P_DATE_PRINT<=nvl(dop.[DATE_END],P_DATE_PRINT)
						loop
							temp_str := trim(
								iif(dop.[GROUP_PROP].[TYPE_VALUE] is null ,dop.[PROP].[NAME],'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='NUMBER',to_char(dop.[NUM],'999G999G999G999G990D0099'),'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='STRING',dop.[STR],'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='DATE'  ,to_char(dop.[V_DATE],fmt),'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='BOOL'  ,iif(dop.[BOOL],'Да','Нет'),'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='REF'   ,::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),'')
								           );
							&debug('temp_str='||temp_str,dp)
							if temp_str='Да' then temp_str:=' V ';   --dop.[PROP].[NAME]; типа 'Да' "Птица" для квадратика в анкете
							else				  temp_str:='     '; --пять пробелов для пустышки а квадратике
							end if;
							&debug('Для %_ЛОГИКА Нашли группу '||dop.[GROUP_PROP].[CODE]||'-'||dop.[GROUP_PROP].[NAME]||' С типом значения:'||dop.[GROUP_PROP].[TYPE_VALUE]||' -> "'||'"',dp2)
							exit;
						end loop;
						if temp_str is null then
							temp_str:='     '; --пять пробелов для пустышки а квадратике
						end if;
					end if;
				end if;
				if temp_str is not null then P_DATA:=temp_str;
				elsif p_info='CL_ANK_PROF_INC_TAX' then P_DATA:='нет, не нахожусь на специальном налоговом режиме "Налог на профессиональный доход"'; -- Vorobey 20190708 Значение по умолчанию для CL_ANK_PROF_INC_TAX
				else
					if flSpace then P_DATA:=' ';   &debug('flSpace='||flSpace,dp)--Башкиров В.Г. 28.05.2019 Для кодов типа CL_ANK_PDL_INFO_ (последний символ "_") если значение пустое - выдавать " " вместо "нет"
					else	  	    P_DATA:=empty_filler;-- Ильин Д.А. 'нет' изменено на '-'
					end if;
				end if;
			end if;

			if P_DATA is null then
				P_DATA := empty_filler;-- Ильин Д.А. 'нет' изменено на '-'
			end if;
		end if; --end P_info	
		<<nnn>>
		&debug('На '||to_char(P_DATE_PRINT,fmt)||' '||Rpad(p_info,22)||'->'||P_DATA,dp)
	end if; --end p_message
end;

execute is
/*********************************************************************
Назначение:

Maa, последнее изменение 4 Март 2003 г.
*********************************************************************/
begin
	/*
						ВНИМАНИЕ!
	В КЛИЕНТ-СКРИПТЕ ЕСТЬ УДАЛЕНИЕ СТРОК ТАБЛИЦЫ В ШАБЛОНЕ ПО НОМЕРУ СТРОКИ!
	ЕСЛИ ВЫ ДОБАВЛЯЕТЕ В ШАБЛОН НОВУЮ СТРОКУ В ТАБЛИЦЕ, УБЕДИТЕСЬ ЧТО ЭТО НЕ ПОВЛИЯЕТ НА УДАЛЕНИЕ
	МОЖЕТ ПОЛУЧИТЬСЯ ТАК, ЧТО СТАНЕТ УДАЛЯТЬСЯ НЕ ТА СТРОКА, СООТВЕТСТВЕННО ОПЕРАЦИЯ БУДЕТ РАБОТАТЬ НЕКОРРЕКТНО
	ТАКЖЕ ОБРАТИТЕ ВНИМАНИЕ ЧТО ЕСТЬ ЕЩЁ И УДАЛЕНИЕ ТАБЛИЦЫ ПО ЕЁ НОМЕРУ
						
						pikalov
	*/
	-- сброс значения глобальных переменных после отработки сервер- и клиент валидатора
   	if client_org_ref is not null then
   		client_org_ref.[DATE_ANK] := P_DATE_ANK;
		client_org_ref.[DATE_FORM_UPD_F] := P_DATE_FORM_UPD;
   	else
   		[DATE_ANK] := P_DATE_ANK;
		[DATE_FORM_UPD_F] := P_DATE_FORM_UPD;
   	end if;

	client_org_ref := null;
	cl_org_dolg_fase := null;
	executor.set_context( 'CL_INFO_COLLECTION', null);
	executor.set_context( 'CL_INFO_DATE', null);
end;
end;
end;
