public function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is 
begin if v1 then return v2; else return v3; end if; end;

--Башкиров В.Г. 25.05.2017 Для расчета времени выполнения HOOKa
--Функция возвращает интервал между tEnd-tBeg (в сотых долях секунды)
function GetTimeInterval(tEnd number, tBeg number) return number is
tMax    number:= 2147483647;
tMin    number:=-2147483648;
nLength number:=tMax - tMin + 1;
Minhalf number:=tMin/2;
Maxhalf number:=(tMax+1)/2;
begin
	if    tBeg>Maxhalf and tEnd<Minhalf then return tEnd-tBeg+nLength;
	elsif tBeg<Minhalf and tEnd>Maxhalf then return tEnd-tBeg-nLength;
	end if;
	return tEnd-tBeg;
end;
--^-- ----------------------------------------------------------------------------------------
--::[HOOK_BANK].[RKO_CALC_PAR_1].DbpBusinessOp(1,&EnableDebug(&METHOD$CLASS,&METHOD$SNAME)='1');
public procedure DbpBusinessOp(CntTB number default 0, DebugOnOff boolean default false) is 
begin
	if	coalesce(::[FP_TUNE].[LIB].get_bool_value('ABS_DEBUG_KOMISS_RKO', stdlib.userid, 0), false) then
		if DebugOnOff then
			begin
				if PATTERN_DOC.BUSINESS_OP.date_val_bo is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.date_val_bo='||to_char(PATTERN_DOC.BUSINESS_OP.date_val_bo,fmt24),dp1); end if;--DATE;
				if PATTERN_DOC.BUSINESS_OP.doc_ref     is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.doc_ref    ='||HOOK_BANK.RKO_CALC_PAR_1.InfoDoc(PATTERN_DOC.BUSINESS_OP.doc_ref),dp1); end if;--ref [DOCUMENT];
				if PATTERN_DOC.BUSINESS_OP.mdoc%id     is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.mdoc%id    ='||PATTERN_DOC.BUSINESS_OP.mdoc%id                   ,dp1); end if;--[MAIN_DOCUM];
				if PATTERN_DOC.BUSINESS_OP.fold_ref    is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.fold_ref   ='||HOOK_BANK.RKO_CALC_PAR_1.InfoDoc(PATTERN_DOC.BUSINESS_OP.fold_ref),dp1); end if;--[FOLDER_PAY_REF];
				if PATTERN_DOC.BUSINESS_OP.folder%id   is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.folder%id  ='||PATTERN_DOC.BUSINESS_OP.folder%id                 ,dp1); end if;--[FOLDER_PAY];
				if PATTERN_DOC.BUSINESS_OP.val_op      is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.val_op     ='||PATTERN_DOC.BUSINESS_OP.val_op.[CUR_SHORT]        ,dp1); end if;--[FT_MONEY_REF];
				if PATTERN_DOC.BUSINESS_OP.begin_num   is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.begin_num  ='||PATTERN_DOC.BUSINESS_OP.begin_num                 ,dp1); end if;--integer;
				if PATTERN_DOC.BUSINESS_OP.kol_doc     is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.kol_doc    ='||PATTERN_DOC.BUSINESS_OP.kol_doc                   ,dp1); end if;--number;
				if PATTERN_DOC.BUSINESS_OP.str_sim     is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.str_sim    ='||SubStr(PATTERN_DOC.BUSINESS_OP.str_sim,1,2000)    ,dp1); end if;--[MEMO];
				if PATTERN_DOC.BUSINESS_OP.CL_         is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.CL_        ='||PATTERN_DOC.BUSINESS_OP.CL_.[NAME]                ,dp1); end if;--ref [CL_PRIV]; -- вноситель/получатель средств (jack 07/05/2002) метка &&JACK
				if PATTERN_DOC.BUSINESS_OP.need_repeat is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.need_repeat='||PATTERN_DOC.BUSINESS_OP.need_repeat               ,dp1); end if;--[BOOLEAN];
				if PATTERN_DOC.BUSINESS_OP.tarif_bo    is not null then debug_pipe(lpad(TB$,CntTB)||'PATTERN_DOC.BUSINESS_OP.tarif_bo   ='||PATTERN_DOC.BUSINESS_OP.tarif_bo.[OPER].[PATTERN_CODE]||'-'||PATTERN_DOC.BUSINESS_OP.tarif_bo.[OPER].[PATTERN_NAME],dp1); end if;--ref [TARIF_BO];
			exception when others then debug_pipe('.DbpBusinessOp -- Ош.:'||LF$||sqlerrm,dp1);
			end;
		end if;
	end if;
end;

public function InfoDoc(doc ref [DOCUMENT]) return string(2000) is 
ExStr string(2000);
md ref [MAIN_DOCUM];
oMd [MAIN_DOCUM];
fp ref [FOLDER_PAY];
oFP [FOLDER_PAY];
fo ref [FIN_ORDER];
oFO [FIN_ORDER];
begin
	if doc%class='MAIN_DOCUM' then md:=doc; oMd:=md;
		ExStr:=oMd%class||'.'||oMd%id||'.'||oMd%state;
		ExStr:=Substr(ExStr||' №'||oMd.[DOCUMENT_NUM]
			||iif(oMd.[DOCUMENT_UNO] is null,'',' УНД:'||oMd.[DOCUMENT_UNO])
			||' от '||to_char(oMd.[DATE_DOC],fmt)
			||iif(oMd.[IN_FOLDER].[DOCS_IN_FOLD]%size(1)>0,' {'||oMd.[IN_FOLDER].[DOCS_IN_FOLD]%size(0)||'}','')
			||' '||nvl(oMd.[SUM],oMd.[SUM_PO])||' '||oMd.[VALUTA].[CUR_SHORT]
			||iif(oMd.[DATE_VAL] is null,'',' ДВал:'||to_char(oMd.[DATE_VAL],fmt))
			||' '||oMd.[ACC_DT].[MAIN_V_ID]||'-'||oMd.[ACC_KT].[MAIN_V_ID]
			||                               ' Созд:'||::[RUNTIME].[STDLIB].fio(oMd.[DOCUMENT_USER].[NAME], 'Ф И.О.')
			||iif(oMd.[PROV_USER] is null,'',' Првд:'||::[RUNTIME].[STDLIB].fio(oMd.[PROV_USER].[NAME], 'Ф И.О.')||' ДПрвд:'||to_char(oMd.[DATE_PROV],fmt24))
			||' '||oMd.[DEPART].[CODE]
			||' '||oMd.[NAZN]
			,1,2000);
	elsif doc%class='FOLDER_PAY' then fp:=doc; oFP:=fp;
		ExStr:=oFP%class||'.'||oFP%id||'.'||oFP%state;
		ExStr:=Substr(ExStr||' №'||oFP.[DOCUMENT_NUM]
			||iif(oFP.[DOCUMENT_UNO] is null,'',' УНД:'||oFP.[DOCUMENT_UNO])
			||' от '||to_char(oFP.[DOCUMENT_DATE],fmt)
			||iif(oFP.[DATE_EXEC] is null,'',' ДИсп:'||to_char(oFP.[DATE_EXEC],fmt))
			||                               ' Созд:'||::[RUNTIME].[STDLIB].fio(oFP.[DOCUMENT_USER].[NAME], 'Ф И.О.')
			||iif(oFP.[USER_EXEC] is null,'',' Исп:'||::[RUNTIME].[STDLIB].fio(oFP.[USER_EXEC].[NAME], 'Ф И.О.'))
			||' '||oFP.[DEPART].[CODE]
			||' {'||oFP.[DOCS_IN_FOLD]%size(0)||'}'
			||iif(oFP.[PROD_FOLD] is null,'',' Продукт:'||oFP.[PROD_FOLD])
			||iif(oFP.[BUSINESS_OP] is null,'',' БО:'||oFP.[BUSINESS_OP].[PATTERN_CODE]||'-'||oFP.[BUSINESS_OP].[PATTERN_NAME])
			,1,2000);
	else
		begin
		ExStr:=doc%class||'.'||doc%id||'.'||doc%state;
		ExStr:=Substr(ExStr||' №'||doc.[DOCUMENT_NUM]
			||' от '||to_char(doc.[DOCUMENT_DATE],fmt)
			||iif(doc.[DATE_EXEC] is null,'',' ДИсп:'||to_char(doc.[DATE_EXEC],fmt))
			||                               ' Созд:'||::[RUNTIME].[STDLIB].fio(doc.[DOCUMENT_USER].[NAME], 'Ф И.О.')
			||iif(doc.[USER_EXEC] is null,'',' Исп:'||::[RUNTIME].[STDLIB].fio(doc.[USER_EXEC].[NAME], 'Ф И.О.'))
			||' '||doc.[DEPART].[CODE]
			,1,2000);
		exception when others then
			ExStr:=substr(ExStr||LF$||sqlerrm,1,ExStr%size);
		end;
	end if;
	return ExStr;
end;

procedure wr_log (aPar string, a_msg string)
is
begin
		UNIMP.Reset;
		UNIMP.fMess := stdio.open(UNIMP.PathToFile, 'RKO_CALC_PAR_1' || '_msg_'||aPar||to_char(sysdate, '_YYYYMMDD_HH24_MI_SS'), 'w');
		--UNIMP.WriteMess(to_char(sysdate, 'DD/MM/YYYY   HH24:MI:SS'), 0);
		UNIMP.WriteMess(aPAR||'-'|| a_msg, 0);
		stdio.close(UNIMP.fMess);
end;


