class END_OD_OPERATION;

@name('[ПСБ] Депозиты. РКО. Завершение операционного дня (расчёт,учёт,капитализация %% в последние дни месяца)')
static method PSH_DEPN_ZOD is

@name('Филиал') public P_FILIAL [BRANCH_REF];
dp number := 0; --управление debug_pipe
fmt string(10):='dd/mm/yyyy';

--   Проверка даты на последний рабочий день месяца
public function LastWorkDay(
	  p_date [date]
	, sClass varchar2(100)
	, nCalendar	varchar2(100) default null
) return boolean is
	DateEnd		integer;
	DateBegin	integer;
	i_date		[date];
	inc			number;
	sADDS 		varchar2(32000);
	sCalendar	varchar2(200);
begin
	if p_date is null then
		p_date := coalesce(p_date, ::[SYSTEM].[VARIABLES].BR2OPDATE(stdlib.userid.[FILIAL]%id));
	end if;

	if nCalendar is null
	then
		if sClass is null then
			sCalendar := 'HOLIDAYS';
		else
			sADDS := ::[FP_TUNE].[LIB].set_canons('METACLASS', sClass);
			sCalendar := nvl(::[FP_TUNE].[LIB].get_str_value('CALENDAR_NAME', sADDS), 'HOLIDAYS');
		end if;
	else
		sCalendar := nCalendar;
	end if;

	DateBegin:= to_number(to_char( 		   p_date , 'DD'));
	DateEnd  := to_number(to_char(Last_day(p_date), 'DD'));

	debug_pipe('.LastWorkDay -- p_date='||to_char(p_date,fmt)||' sCalendar='||sCalendar||' DateBegin='||DateBegin||' DateEnd='||DateEnd,dp);

	inc	:= 0;
	for i in DateBegin..DateEnd
	loop
		i_date	:= p_date + inc;
		inc	:= inc + 1;
		if i_date = p_date then
			if ::[RUNTIME].[CALENDAR].Check_Date(sCalendar, i_date) = '1' then
				debug_pipe('.LastWorkDay < (1.'||to_char(i_date,fmt)||') false',dp);
				return false;
			end if;
		else
			if ::[RUNTIME].[CALENDAR].Check_Date(sCalendar, i_date) = '1' then
				debug_pipe('.LastWorkDay < (2.'||to_char(i_date,fmt)||') null',dp);
				null;
			else
				debug_pipe('.LastWorkDay < (3.'||to_char(i_date,fmt)||') false',dp);
				return false;
			end if;
		end if;
	end loop;
	debug_pipe('.LastWorkDay < (4.'||to_char(i_date,fmt)||') true',dp);
	return true;
end;
PSH_DEPN_ZOD (
	@name('Филиал')        P_FILIAL in [BRANCH_REF] default null,
	@name('Подразделение') P_DEPART in [DEPART_REF] default null
) is

validate is
begin
	if p_message = 'DEFAULT' then
		P_FILIAL:=nvl(P_FILIAL,::[BRANCH]([CODE]='001'));
	end if;
end;

execute is
/*********************************************************************
Назначение:

Bashkirov, последнее изменение 18 Июль 2022 г.
*********************************************************************/
vDATE_BEG [DATE];
vDATE_END [DATE];
v31_12 	  [DATE];
begin
	P_FILIAL:=nvl(P_FILIAL,::[BRANCH]([CODE]='001'));
	vDATE_BEG=vDATE_END:=P_FILIAL.[OP_DATE];
	
	-->> PSH VRI 29/01/2026 CFT-3510 Добавление в ЗОД процедуры по ЕЖЕДНЕВНОМУ начислению %%, корр-к по депозитам юр.л
	::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Старт "Депозиты ЮЛ. Групповая обработка договоров" в '||to_char(P_FILIAL.[OP_DATE],fmt));
	::[DEPN].[DEP_PRIV_OPER](
	 vDATE_END	/*P_DATE_BEG*/		--Дата начала периода
	,vDATE_END	/*P_DATE_END*/		--Дата окончания периода
	,P_FILIAL	/*P_FILIAL*/		--Филиал
	,P_DEPART	--::[DEPART]([CODE]='001-00-999')	/*P_DEPART*/		--Подразделение 001-00-999 - Подразделение для тестирования
	,null	/*P_USER*/			--Ответственный
	,null	/*P_CURRENCY*/		--Валюта
	,null	/*P_NOT_CURRENCY*/	--Исключить
	,null	/*P_VID_DEP*/		--Вид договора
	,true	/*P_CALC_PRC_END*/	--Расчет процентов
	,true	/*P_REG_PRC*/		--Учет процентов
	,false	/*P_CAP_PRC*/		--Капитализация процентов
	,null	/*P_CAP_DATES*/		--Даты капитализации
	,null	/*P_RESTART_DEP*/	--Переоформление договоров
	,null	/*P_PROL_DEP*/		--Пролонгация договоров
	,null	/*P_MOVE_SALDO*/	--Перенос остатка при пролонгации
	,null	/*P_PLAN*/			--Планировать
	,null	/*P_NEED_PLAN*/		--По признаку в фактических операциях
	,null	/*P_EXEC_L_ORDER*/	--Исполнение длительных поручений
	,null	/*P_AUTO_CONV*/		--Автоконвертация мультивалютных вкладов
	,null	/*P_CLOSE_47502*/	--Сводная проводка Дт 702 Кт 47502
	,null	/*P_HOLLIDAYS*/		--За выходные дни
	,false	/*P_DEPOSIT_PRIV*/	--Депозиты физ. лицам  
	,false	/*P_DEPOSIT_MULT*/	--Мультивалютные вклады
	,true	/*P_DEPOSIT_ORG*/	--Депозиты юр. лицам
	,null	/*P_FILE_PATH*/		--Путь до файла ошибок
	,null	/*P_FILE_NAME*/		--Имя файла ошибок
	,null	/*P_EXEC_FIN_ORD*/	--Исполнить фин.распоряжения на закрытие вал. счетов
	,null	/*P_TIMEOUT*/		--Время ожидания остановки заданий
	,null	/*P_STREAM_COUNT*/	--Количество потоков
	,null	/*P_STREAM_NUM*/	--Номер потока
	,null	/*P_NEED_DEBUG*/	--Необходима отладка (для запуска в джобах)
	,null	/*P_CALC_PRC_ALL*/	--Расчет процентов по всем договорам
	,null	/*P_CLOSE_DEP*/		--Закрытие договоров
	,null	/*P_DEPART_GROUP*/	--Группа подразделений
	,null	/*P_MODE*/			--Режим ЗОД (пусто или 1-старый, 2-новый, 3-не из ЗОД)
	,100	/*P_COMMIT*/		--Количество записей в порции между commit
	,null	/*P_DATE_VAL*/		--Дата валютирования
	,null	/*P_LONG_ORDER_TYPES*/		--Виды длительных поручений
	,null	/*P_EXEC_DOP*/		--Обработка доп.соглашений
	,null	/*P_VID_DEPS*/		--Виды депозитных договоров
	,null	/*P_EXEC_COMISS*/	--Удержать периодическую комиссию
	,null	/*P_COMISS_TYPES*/	--Виды комиссий
	,null	/*P_RECOGNISE_EXPENSES*/	--Признание затрат
	,true	/*P_IFRS_ADJ_AC*/	--Корректировка стоимости депозита до АС 
	,null	/*P_DEBIT_OVERDUE*/	--Перенос просроченной дебиторской задолженности
	);
	::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Завершена "Депозиты ЮЛ. Групповая обработка договоров" в '||to_char(P_FILIAL.[OP_DATE],fmt));
	--<< PSH VRI 29/01/2026 CFT-3510 Добавление в ЗОД процедуры по начислению %%, корр-к по депозитам юр.л

	v31_12:=DATEFUN.Eoy(P_FILIAL.[OP_DATE]);
	if P_FILIAL.[OP_DATE] = v31_12 then
		::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Наступил последний календарный день года. Проставляем Депозитам ФЛ "Дата следующей капитализации" '||to_char(v31_12,fmt));
		update dprv (dprv.[DATE_NEXT_CAP] = v31_12)
			in ::[DEPOSIT_PRIV];
		commit;
	end if;
	--if LastWorkDay(vDATE_BEG,'DEPOSIT_PRIV','HOLIDAYS_DEP')	--Башкиров В.Г. 28.11.2023
	--or vDATE_BEG=DATEFUN.Eom(vDATE_BEG) then
	if vDATE_BEG=DATEFUN.Eom(vDATE_BEG) then					--Башкиров В.Г. 27.06.2024
		::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Старт "Депозиты ФЛ. Групповая обработка договоров" в '||to_char(P_FILIAL.[OP_DATE],fmt));
		::[DEPN].[DEP_PRIV_OPER](
		 vDATE_END	/*P_DATE_BEG*/		--Дата начала периода
		,vDATE_END	/*P_DATE_END*/		--Дата окончания периода
		,P_FILIAL	/*P_FILIAL*/		--Филиал
		,P_DEPART	--::[DEPART]([CODE]='001-00-999')	/*P_DEPART*/		--Подразделение 001-00-999 - Подразделение для тестирования
		,null	/*P_USER*/			--Ответственный
		,null	/*P_CURRENCY*/		--Валюта
		,null	/*P_NOT_CURRENCY*/	--Исключить
		,null	/*P_VID_DEP*/		--Вид договора
		,true	/*P_CALC_PRC_END*/	--Расчет процентов
		,true	/*P_REG_PRC*/		--Учет процентов
		,true	/*P_CAP_PRC*/		--Капитализация процентов
		,null	/*P_CAP_DATES*/		--Даты капитализации
		,null	/*P_RESTART_DEP*/	--Переоформление договоров
		,null	/*P_PROL_DEP*/		--Пролонгация договоров
		,null	/*P_MOVE_SALDO*/	--Перенос остатка при пролонгации
		,null	/*P_PLAN*/			--Планировать
		,null	/*P_NEED_PLAN*/		--По признаку в фактических операциях
		,null	/*P_EXEC_L_ORDER*/	--Исполнение длительных поручений
		,null	/*P_AUTO_CONV*/		--Автоконвертация мультивалютных вкладов
		,null	/*P_CLOSE_47502*/	--Сводная проводка Дт 702 Кт 47502
		,null	/*P_HOLLIDAYS*/		--За выходные дни
		,true	/*P_DEPOSIT_PRIV*/	--Депозиты физ. лицам  -->> PSH VRI 01/12/2025 CFT-3023 Отключение групповых операций по депозитам юр.лиц при ЗОД.
		,false	/*P_DEPOSIT_MULT*/	--Мультивалютные вклады
		,false	/*P_DEPOSIT_ORG*/	--Депозиты юр. лицам
		,null	/*P_FILE_PATH*/		--Путь до файла ошибок
		,null	/*P_FILE_NAME*/		--Имя файла ошибок
		,null	/*P_EXEC_FIN_ORD*/	--Исполнить фин.распоряжения на закрытие вал. счетов
		,null	/*P_TIMEOUT*/		--Время ожидания остановки заданий
		,null	/*P_STREAM_COUNT*/	--Количество потоков
		,null	/*P_STREAM_NUM*/	--Номер потока
		,null	/*P_NEED_DEBUG*/	--Необходима отладка (для запуска в джобах)
		,null	/*P_CALC_PRC_ALL*/	--Расчет процентов по всем договорам
		,null	/*P_CLOSE_DEP*/		--Закрытие договоров
		,null	/*P_DEPART_GROUP*/	--Группа подразделений
		,null	/*P_MODE*/			--Режим ЗОД (пусто или 1-старый, 2-новый, 3-не из ЗОД)
		,100	/*P_COMMIT*/		--Количество записей в порции между commit
		,null	/*P_DATE_VAL*/		--Дата валютирования
		,null	/*P_LONG_ORDER_TYPES*/		--Виды длительных поручений
		,null	/*P_EXEC_DOP*/		--Обработка доп.соглашений
		,null	/*P_VID_DEPS*/		--Виды депозитных договоров
		,null	/*P_EXEC_COMISS*/	--Удержать периодическую комиссию
		,null	/*P_COMISS_TYPES*/	--Виды комиссий
		,null	/*P_RECOGNISE_EXPENSES*/	--Признание затрат
		,true	/*P_IFRS_ADJ_AC*/	--Корректировка стоимости депозита до АС -- Башкиров В.Г. 30.11.2023
		,null	/*P_DEBIT_OVERDUE*/	--Перенос просроченной дебиторской задолженности
		);
		::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Завершена "Депозиты ФЛ. Групповая обработка договоров" в '||to_char(P_FILIAL.[OP_DATE],fmt));
	else --Башкиров В.Г. 27.06.2024
		::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Не наступил последний календарный день месяца. Операцию ::[DEPN].[DEP_PRIV_OPER] не запускаем');
	end if;
		
	--РКО
	/* -->> PSB VRI 01/09/2025 Отключил по РКО согласно CFT-2327 "критичная ошибка по выплате процентов на остаток ЮЛ"
	if LastWorkDay(vDATE_BEG,'RKO','HOLIDAYS_RKO') then --Башкиров В.Г. 27.06.2024
		-- if to_char(vDATE_END,'mm')='12' then
			--08. Выплата учтенных процентов по всем договорам
			
			vDATE_END:=DATEFUN.Eom(vDATE_END); --Башкиров В.Г. 28.06.2024 %% начислять по последний день месяца
			
			::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Старт ::[RKO].[PSB_TERM_INT_ALL] "РКО. 08. Выплата учтенных процентов по всем договорам" в '||to_char(P_FILIAL.[OP_DATE],fmt)||' %% по '||to_char(vDATE_END,fmt));
		  --::[RKO].[PSB_TERM_INT_ALL](
			::[RKO].[PAY_TERM_INT_ALL](
				true			--На проводку
				,vDATE_END		--Дата начала
				,vDATE_END		--Дата окончания
				,true			--Выполнить учет процентов
				,true			--Рассчитать проценты
				,''			--Шаблон счета
				,P_FILIAL		--Филиал
				,P_DEPART		--Подразделение
				);
			::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Завершена "RKO. 08. Выплата учтенных процентов по всем договорам" в '||to_char(P_FILIAL.[OP_DATE],fmt));
		-- else
		-- 	::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Старт "07.2 Учет начисленных процентов для всех договоров" в '||to_char(P_FILIAL.[OP_DATE],fmt));
		-- 	::[RKO].[TERM_INT_ALL](
		-- 		true			--На проводку
		-- 		,vDATE_END		--Дата начала
		-- 		,vDATE_END		--Дата окончания
		-- 		,true			--Рассчитать проценты
		-- 		,true			--Для учета
		-- 		,P_FILIAL		--Филиал
		-- 		,P_DEPART		--Подразделение
		-- 		);
		-- 	::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Завершена "RKO. 08. Выплата учтенных процентов по всем договорам" в '||to_char(P_FILIAL.[OP_DATE],fmt));
		-- end if;
	else --Башкиров В.Г. 27.06.2024
		::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Не наступил последний рабочий день месяца. Операцию ::[RKO].[PAY_TERM_INT_ALL] не запускаем');
	end if;
	*/ --<< PSB VRI 01/09/2025

	if P_FILIAL.[OP_DATE] = v31_12 then
		::[END_OD_OPERATION].[LIB].WRMESS(lpad(to_char(SYSDATE, 'DD/MM/YYYY  HH24:MI:SS'),30)||' Сбрасываем Депозитам ФЛ "Дату следующей капитализации"');
		update dprv (dprv.[DATE_NEXT_CAP] = null)
			in ::[DEPOSIT_PRIV];
	end if;
end;
end;
end;
