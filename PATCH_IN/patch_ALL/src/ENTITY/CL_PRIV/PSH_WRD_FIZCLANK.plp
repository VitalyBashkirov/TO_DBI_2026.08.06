					where nvl(x.[DATE_END], ::[SYSTEM].op_date + 1) >= ::[SYSTEM].op_date
				)
				loop
					P_DATA := P_DATA || nvl(x.num, '-') || NL$;
				end loop;
				P_DATA := rtrim(ltrim(P_DATA), NL$);
			elsif p_info = 'ДОП_ДОК_ДАТА_НАЧ' then
				for (select x(x.[DATE] : date_beg)
					in client_priv.[DOC_ARR]
					where nvl(x.[DATE_END], ::[SYSTEM].op_date + 1) >= ::[SYSTEM].op_date
				)
				loop
