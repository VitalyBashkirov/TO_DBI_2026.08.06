public function clob2blob(AClob CLOB) return BLOB is
  Result BLOB;
  o1 integer;
  o2 integer;
  c integer;
  w integer;
begin
  o1 := 1;
  o2 := 1;
  c := 0;
  w := 0;
  DBMS_LOB.CreateTemporary(Result, true);
  DBMS_LOB.ConvertToBlob(Result, AClob, length(AClob), o1, o2, 0, c, w);
  return(Result);
end;	




public function get_num_dep(cl ref [CLIENT]) return varchar2 is
res varchar2(1000);
add_to_number   varchar2(50);
begin
	select x(to_char(count(1) + 1)) in ::[DEPN]
    where x.[CLIENT]  =  cl into add_to_number;  

	res:='ГСД/'||to_char(cl.[REGISTR_NUM])||'/'||to_char(trunc(sysdate),'YYYYMMDD')||'/'||add_to_number;
		
	return res;
	exception
	when others then return null;
end;	

------Загрузки информации о удаленных счетах корпоративных клиентов
public procedure del_XML_acc_info(
	 p_QUERY_ID number(19),
	 p_ROW_NUMBER number,
	p_LINE_NUMBER number(7)
	)
is
bik varchar2(30);
bank [CL_BANK_N];
strerr      memo; 
LINE_NUMBER  number;
b_cl		ref [PSH_IBANK2]; 
b_doc_type  ref [BC_DOC_TYPES];
bc			ref [BC_MAP_DOC];

type TdelAccInfo is record (
	ID        ref   [DEPOSIT_ORG],      
	BRANCH_BIC      varchar2(30),
    ACCOUNT			varchar2(30)
);

type rAccInfo  is table of TdelAccInfo index by integer;
delAccInfo	 rAccInfo;
begin
	bank := ::[SYSTEM].[VARIABLES].OurBank;
    bik := ltrim( rtrim( bank.[BIC]));
    delAccInfo.delete;
    
	select x(x%id, bik, x.[ACCOUNT].[MAIN_V_ID]) in ::[DEPOSIT_ORG] all where x.[ACCOUNT]=5303275382
	and not exists (select t(1) in ::[DEPOSIT_ORG] all where t%id=x%id
	and t.[PROPERTY_ARR].[PROPERTY_TYPE].[CODE] = 'DEL_ACC_LOADED_TO_DBO')   into delAccInfo;

	
	LINE_NUMBER:=p_LINE_NUMBER;
	for idx in 1..delAccInfo.count loop

	ins_result_row(p_QUERY_ID,LINE_NUMBER,'BRANCH_BIC',delAccInfo(idx).BRANCH_BIC);

	ins_result_row(p_QUERY_ID,LINE_NUMBER,'ACCOUNT',delAccInfo(idx).ACCOUNT);
	
	
	select x(x%id) in ::[PSH_IBANK2] where x.[CLIENT]=delAccInfo(idx).ID.[CLIENT] into b_cl;

	
	bc:=::[BANK_CLIENT].[LIB].insert_map_doc(b_cl, false, 'УдСчет', b_doc_type.[DOC_TYPE], null, null,'DEPOSIT_ORG', delAccInfo(idx).ID);
 	bc.[BCD_TYPE]:=b_doc_type;

	set_prop_takeatloaded ( delAccInfo(idx).ID, sysdate, true, 'del_acc');
	
	LINE_NUMBER:=LINE_NUMBER + 1;
	end loop;	 
	exception   when others then
       strerr:='Не удалось выгрузить удаление счета в iBank: '||sqlerrm;
	   bc:=::[BANK_CLIENT].[LIB].insert_map_doc(b_cl, false, 'Не выгр.сч', b_doc_type.[DOC_TYPE], null, null,'DEPOSIT_ORG', null);
	   bc.[ERR_DESC]:=strerr;
end;	

------Загрузка статусов документов
public procedure  get_status_doc(p_QUERY_ID number, vDoc_id number) is
LINE_NUMBER number:=0;
is_need_update number;
begin	
	is_need_update := check_need_update(vDoc_id);	
    if (is_need_update != 0) then   

		ins_result_row(p_QUERY_ID,LINE_NUMBER,'DOC_ID', vDoc_id );	
		ins_result_row(p_QUERY_ID,LINE_NUMBER,'STATE', is_need_update);	

	end if;	
end;	

