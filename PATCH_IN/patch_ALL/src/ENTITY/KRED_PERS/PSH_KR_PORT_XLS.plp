					[EXCEL].Write(i,21,''''||cr.ACC_OD);
					[EXCEL].Set_Number_Format(i,22,i,22,2);
					[EXCEL].Write(i,22,cr.BAL_OD,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,23,''''||cr.ACC_LIM);
					[EXCEL].Set_Number_Format(i,24,i,24,2);
					[EXCEL].Write(i,24,cr.BAL_LIM,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,25,''''||cr.ACC_PRC);
					[EXCEL].Set_Number_Format(i,26,i,26,2);
					[EXCEL].Write(i,26,cr.BAL_PRC,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,27,''''||cr.ACC_EXOD);
					[EXCEL].Set_Number_Format(i,28,i,28,2);
					[EXCEL].Write(i,28,cr.BAL_EXOD,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,29,''''||cr.ACC_EXPRC);
					[EXCEL].Set_Number_Format(i,30,i,30,2);
					[EXCEL].Write(i,30,cr.BAL_EXPRC,false,false,10,'Times New Roman','RT');
				  --Башкиров В.Г. 25.01.2019 21:50 Обновление 18.6.07
				  --[EXCEL].Write(i,31,cr.EXP_SROK);
					[EXCEL].Write(i,32,''''||cr.ACC_RESPRC);
					[EXCEL].Set_Number_Format(i,33,i,33,2);
					[EXCEL].Write(i,33,cr.BAL_RESPRC,false,false,10,'Times New Roman','RT');
					[EXCEL].Write(i,34,''''||cr.ACC_RESEXPRC);
					[EXCEL].Set_Number_Format(i,35,i,35,2);
