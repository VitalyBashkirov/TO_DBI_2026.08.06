class MAIN_DOCUM;

@name('[ПСБ]. Перевести документ из состояния "Не обработан" - > "Ликвидирован"')
@tag('COPIED')
method PSH_TO_DELETED is
PRAGMA INCLUDE([RUNTIME]::[DEBUG_MACRO]);

public gCalled_PSB_TO_DELETED boolean;

dp  number:=0; --управление debug_pipe
dp1 number:=0; --управление debug_pipe
PSH_TO_DELETED is

execute is
begin
	if this%state<>'FORM' then
		gCalled_PSB_TO_DELETED:=null;
		pragma error('Операция работает только с документами в состоянии "Не обработан"');
	end if;

	begin	
		savepoint nnn;
		
		gCalled_PSB_TO_DELETED:=true;
		
		for dr in ::[DOCUM_RC] where dr.[MAIN_DOC]=this loop
			&debug('[1] '||dr%class||'.'||dr%id||'.'||dr%state, dp1)
			if dr%state in ('S_8', 'S_13') then
				dr%state:='S_10';
			elsif dr%state = 'S_22' then
				dr%state:='S_2';
			end if;
			&debug('[2] '||dr%class||'.'||dr%id||'.'||dr%state, dp1)
			if dr%state != 'S_16' then
				dr%state := 'S_16';
			end if;
			&debug('[3] '||dr%class||'.'||dr%id||'.'||dr%state, dp1)
		end loop;

		if this%state='FORM' then
			this%state:='DELETED';
			if this%state='DELETED' then
				gCalled_PSB_TO_DELETED:=null;
				return;
			end if;
		end if;

		&debug('(1) '||this%class||'.'||this%id||'.'||this%state, dp)
		this%state('TO_PROV_IN_BANK'):='PROV_IN_BANK';
		&debug('(2) '||this%class||'.'||this%id||'.'||this%state, dp)
		
		if this%state<>'PROV_IN_BANK' then
			gCalled_PSB_TO_DELETED:=null;
			pragma error('Не удалось поменять статус у документа');
		end if;

		&debug('(3) '||this%class||'.'||this%id||'.'||this%state, dp)
		this%state('DEL_NOWORK'):='DELETED';
		&debug('(4) '||this%class||'.'||this%id||'.'||this%state, dp)

		if this%state<>'DELETED' then
			gCalled_PSB_TO_DELETED:=null;
			pragma error('Не удалось поменять статус у документа');
		end if;

	exception when others then
		&debug('(5) '||this%class||'.'||this%id||'.'||this%state, dp)

		gCalled_PSB_TO_DELETED:=null;
		rollback to nnn;
		&debug('Ошибка перевода статуса документа '|| sqlerrm, dp)
	end;

	&debug('(6) '||this%class||'.'||this%id||'.'||this%state, dp)

	gCalled_PSB_TO_DELETED:=null;
end;
end;
end;
