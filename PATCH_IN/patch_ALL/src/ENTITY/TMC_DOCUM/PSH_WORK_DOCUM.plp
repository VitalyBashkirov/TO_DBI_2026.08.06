/*
	Установка назначений для документов в папке
	p_fold - папка платежей с созданными документами
	p_doc_num - параметр отрезающий только документы созданные для конкретного экз. списка
	p_tmc_doc - текущий документ
	p_list - текущий экз. списка
*/
procedure set_nazn_in_folder(	p_fold [FOLDER_PAY_REF],
								p_doc_num in out number,
								p_tmc_doc in ref [TMC_DOCUM],
								p_list in ref [TMC_LIST]) is
V_MAIN_DOC ref [MAIN_DOCUM]; -- платежный документ
begin
	for (select doc(doc.[NUM] 				: NUM
					,doc.[DOCUMENT]			: DOCUMENT
					,doc.[DOCUMENT]%class	: DOCUMENT_CLASS)
			 in ::[DOC_IN_FOLD], (::[FOLDER_PAY] all : f) all
		  where f = p_fold
		  	and doc%collection = f.[DOCS_IN_FOLD]
		  	and doc.[NUM] > p_doc_num
		  order by doc.[NUM])
	Loop
    	p_doc_num:=doc.[NUM];
    	if DOC.DOCUMENT_CLASS = 'MAIN_DOCUM' then
			V_MAIN_DOC%Id := doc.[DOCUMENT];
--maxx Расширение
-- параметры:
-- p_doc(плат. документ), p_tmc_doc(мат. документ), p_list (список тмц)
-- Возвращаемое значение типа назначения платежа в плат. документе
-- Возвращаемое значение присваивается v_doc_nazn
-- По умолчанию производиться в формате:
-- "Наименование(сумма по документу)"
-- Расширение сделано в цикле с целью сократить кол-во расширений

			v_main_doc.[NAZN] := ::[HOOK].GET_M_NAZN_CP_1(v_main_doc,p_tmc_doc,p_list);--вызов хука через точку вызова
		end if;
	End Loop;
end;


/**
	@author A.Bezverhih

	расчет амортизации.
	Расчет амортизации вынесен для того, чтобы можно было получить
	сумму амортизации в отчетах на необработанных документах,
	производится расчет амортизации, движения не вставляются
	возвращает сумму начисленной амортизации
*/
public function calc_amo(	beg_date in date,
					end_date in date,
					acc_mat in ref [AC_MAT],
					arr in out ::[AC_MAT].[CALC_AMO_LIB].V_AMO_ARR%type) return [SUMMA] is
result [SUMMA];
begin
	-- Проверка и установка дат
	::[AC_MAT].[CALC_AMO_LIB].set_beg_end_dates(acc_mat, beg_date, end_date);
	-- Инициализация массива для расчета
	::[AC_MAT].[CALC_AMO_LIB].init_calc_moves(acc_mat, beg_date, end_date, arr);
	-- Инициализация переменных для расчета
	::[AC_MAT].[CALC_AMO_LIB].init_calc_vars(acc_mat, arr);
	-- Расчет амортизации
	::[AC_MAT].[CALC_AMO_LIB].calc_buh_amo(arr);
	-- Получение уже начисленных сумм амортизации
	::[AC_MAT].[CALC_AMO_LIB].set_amo_sums(acc_mat, arr);
	-- Вычисление разницы по каждому месяцу
	::[AC_MAT].[CALC_AMO_LIB].set_delta(acc_mat, arr);
	-- Вычисление общей суммы разницы
	result := ::[AC_MAT].[CALC_AMO_LIB].get_delta_sum(arr);
	return result;
end;

/**
	@author A.Bezverhih
	получение дат для расчета амортизации
*/
public procedure get_amo_dates(p_date in date, beg_date out date, end_date out date) is
begin
	beg_date := p_date - to_char(p_date,'DD') + 1;
	end_date := last_day(p_date);
end;
procedure recalc_nds_rates(	P_SUP in ref [AC_MAT],
							P_REC in ref [AC_MAT])
is
begin
	if ::[TMC_IMPORT].[TUNE_PRODUCT].get_use_average_nds then
		if P_SUP is not null and (P_REC is null or P_REC != P_SUP) then
			P_SUP.[NDS_RATE] := ::[AC_MAT].[LIB_ACC_MAT].get_average_nds(P_SUP);
		end if;
		if P_REC is not null then
			P_REC.[NDS_RATE] := ::[AC_MAT].[LIB_ACC_MAT].get_average_nds(P_REC);
		end if;
	end if;
end;

-- Установка суммы в валюте для экземпляра списка
procedure set_val_sum (v_list in ref [TMC_LIST], v_valuta in [TMC_DOCUM].[VALUTA]%type, v_date in [DATE])
is
v_course [TMC_DOCUM].[COURSE]%type;
begin
	v_course := ::[DOCUMENT].[LIB_CUR].GET_RATE(v_valuta, v_date);
	if v_course > 0 and v_list.[VAL_SUMMA] = 0 then
		v_list.[VAL_SUMMA] := v_list.[ALL_SUMMA]/v_course;
	end if;
end;


-- Создание закрытия по хоз.договору
procedure make_close_for_hoz_dog (  pArr	::[TMC_ADD_COST].[LIB].addCostArr%type,
									pDate	date,
									pFold	ref [FOLDER_PAY],
									pProve	boolean,
									pDoc	ref [TMC_DOCUM],
									pCourse	number
									)
is
V_HOZ_OPER	ref [HOZ_OPER];
vCalend	ref	[CALENDAR_CALC];
vSysMainVal ref [FT_MONEY]:=SYS_CONTEXT(user_context, 'NatCur');
begin

	if pArr.count > 0 then
		
		Begin
			Locate V_HOZ_OPER In ::[HOZ_OPER]
				Where V_HOZ_OPER.[CODE] = 'ЗАК_ДОП_РАСХОД';
		Exception
			When NO_DATA_FOUND Then
				Pragma Error('Хозяйственная операция с кодом ЗАК_ДОП_РАСХОД не найдена!');
		End;	
		
		for idx in pArr.first..pArr.last
		loop
			if pArr(idx).hoz_dog%state != 'WORK' then
				pragma error ('Обработка документа невозможна, так как хозяйственный договор по дополнительным расходам в состоянии '|| Lib.State_name(pArr(idx).hoz_dog%State,pArr(idx).hoz_dog%Class));
			end if;
			
			if pArr(idx).hoz_dog.[VALUTA] = vSysMainVal then
				pCourse := 1;
			else
				if pCourse <= 0 then
					pCourse := ::[DOCUMENT].[LIB_CUR].GET_RATE(pArr(idx).hoz_dog.[VALUTA], pDate);
				end if;
			end if;
				-- Операция [Добавить экземпляр] над типом [ТМЦ. Календарь расчетов]
			&debug('Создали закрытие в процедуре',0)
			vCalend := ::[VHO_INTERFACE].[PRX_TMC].New_calc(pArr(idx).hoz_dog.[CALEND_CLOSE],			--update PRX_TMC 13/10/11 (nmatveeva)
														V_HOZ_OPER,		 -- Хозяйственная операция
														pDate,			 -- Дата операции
														pArr(idx).cost,	 -- Сумма операции
														pArr(idx).cost / ( pCourse * ::[VHO_INTERFACE].[PRX_TMC].TMC_RATE_TYPE_GET_DEV_COEF(pArr(idx).hoz_dog.[RATE_TYPE])),	 -- Сумма операции в валюте договора
														0,	 -- Количество дней
														0,	 -- Сумма за день
														0,	 -- Сумма нормы
														pArr(idx).nds,			 -- Сумма НДС
														pArr(idx).nds_rate,		 -- Ставка НДС
														nvl(pArr(idx).nds_in_sum, false),	 -- В том числе НДС
														0,	 -- Сумма дополнительног налога
														0,	 -- Ставка дополнительного налога
														false,	 -- В том числе дополнительный налог
														null,	 -- Сумма расходов будущих периодов
														null,	 -- Сумма НДС по РБП
														vSysMainVal,	 -- Валюта операции
														1,	 -- Курс валюты операции
														pCourse,	 -- Курс валюты договора
														null,	 -- Признак расчета курса на дату
														pArr(idx).hoz_dog.[RATE_TYPE],	 -- Тип курса
														pDoc.[BASE_DOC],	 -- Назначение
														pArr(idx).cl_acc,	 -- Счет расчетов с дебиторами и кредиторами
														null,	 -- Клиент-получатель
														null,	 -- Счет клиента в своем банке
														null,	 -- Счет клиента в других банках
														pArr(idx).nds_acc,	 -- Счет учета НДС
														null,	 -- Счет капвложений
														pArr(idx).rash_acc,	 -- Счет расходов
														null,	 -- Счет расходов сверх нормы
														null,	 -- Счет дополнительных расходов
														null,	 -- Счет расходов/доходов будущих периодов
														null,	 -- Счет ОСБ в РЦ
														null,	 -- Код назначения платежа
														null,	 -- Вид документа
														null,	 -- Вид исполнения
														null,	 -- Дата исполнения
														null,	 -- Код типа сообщения
														null,	 -- Вид отправки
														null,	 -- Символ кассы
														null,	 -- Номер кассы
														null,	 -- Номер счет-фактуры
														null,	 -- Дата создания счет-фактуры
														null,	 -- Дата оплаты счет-фактуры
														null,	 -- Целевое назначение
														null,	 -- Номер связанного документа
														null	 -- Дата связанного документа
														);				

				vCalend.[TMC_DOCUM_REF] := pDoc;
				::[VHO_INTERFACE].[PRX_TMC].make_calc(vCalend, pProve, false, pDate);  -- Переводим Планируемое закрытие в Фактическое 	--update PRX_TMC 13/10/11 (nmatveeva)
				vCalend.[FOLDER] := pFold; -- Заносим информацию о папке платежей из материального документа
				
		end loop;
	end if;
	
end;


-- сохраняем с доп параметрах списка ТМЦ сумму переоценки, отнесенную на расходы
procedure save_sum_estim_rashod (p_list	ref [TMC_LIST])
is
	lv_sum_estim_rashod number;
begin
	lv_sum_estim_rashod := [TMC_DOCUM].[LIB].get_sum_estim_to_rashod;
	if lv_sum_estim_rashod > 0 then
		-- сохраним сумму
		::[TMC_PARAM].[LIB].set_(	p_list.[TAB_PARAM],
									::[TMC_ATTRIBUTES].[VARS].SUM_ESTIM_RASHOD,
									lv_sum_estim_rashod
								);
	end if;	
end;

-- сохраняем с доп параметрах списка ТМЦ сумму переоценки, отнесенную на доходы
procedure save_sum_estim_dohod (p_list	ref [TMC_LIST])
is
	lv_sum_estim_dohod number;
begin
	lv_sum_estim_dohod := [TMC_DOCUM].[LIB].get_sum_estim_to_dohod;
	
	if lv_sum_estim_dohod > 0 then	
		-- сохраним сумму
		::[TMC_PARAM].[LIB].set_(	p_list.[TAB_PARAM],
									::[TMC_ATTRIBUTES].[VARS].SUM_ESTIM_DOHOD,
									lv_sum_estim_dohod
									);
	end if;
end;


procedure WorkObMatAcc( pDoc	ref [TMC_DOCUM]
					)
is
acc ref [TMC_ACC_MAT];
HozDog ref [AUR_DOCUM];
rDoc [TMC_DOCUM];
vDocTypeBegOperArend ref [TMC_DOC_NAME];
begin
	rDoc := pDoc;
	-- если приход или выдача, то добавляем в массив кап вложений
	if rDoc.[HOZ_DOG_REF] is not null
		and rDoc.[DOC_NAME_REF].[SIGN_OB_MAT_ARR]
		and upper(rDoc.[DOC_NAME_REF].[OPER].[CODE]) in ('ПРИХОД', 'ВЫДАЧА') then
		
		for list in rDoc.[LIST_TMC]
		loop
			Begin
				Locate acc In rDoc.[HOZ_DOG_REF].[OB_MAT_ACC_ARR]
				 Where acc.[ACC_MAT] = list.[ACC_MAT_REC];
				
			Exception
				When NO_DATA_FOUND Then
					if list.[ACC_MAT_REC] is not null and rDoc.[HOZ_DOG_REF] is not null then
						vDocTypeBegOperArend := ::[FP_TUNE].[LIB].get_ref_value ('TMC_DOC_DEF', ::[FP_TUNE].[LIB].set_canons('TMC_GRUP', list.[GRUPPA_SUP] , '<BP_TMC_PROC>', 'BEG_OPER_AREND'));
						&debug('TMC_DOC_DEF(BEG_OPER_AREND) = '||vDocTypeBegOperArend.[CODE],0)
						if rDoc.[HOZ_DOG_REF]%state != 'WORK' and rDoc.[DOC_NAME_REF] != vDocTypeBegOperArend then
							pragma error ('Обработка документа невозможна, так как связанный хозяйственный договор в состоянии '|| Lib.State_name(rDoc.[HOZ_DOG_REF]%State,rDoc.[HOZ_DOG_REF]%Class));
						end if;	
						::[VHO_INTERFACE].[PRX_TMC].TMC_ACC_MAT_NEW_AUTO(list.[ACC_MAT_REC], rDoc.[HOZ_DOG_REF].[OB_MAT_ACC_ARR]);
					end if;	
			End;
			
				
		end loop;
	--если возврат, то наоборот удаляем	
	elsif rDoc.[HOZ_DOG_REF] is not null
		and rDoc.[DOC_NAME_REF].[SIGN_OB_MAT_ARR]
		and upper(rDoc.[DOC_NAME_REF].[OPER].[CODE]) = 'ВОЗВРАТ' then
		
		for list in rDoc.[LIST_TMC]
		loop
			begin
				locate acc in rDoc.[HOZ_DOG_REF].[OB_MAT_ACC_ARR]
				where acc.[ACC_MAT] = list.[ACC_MAT_SUP];	
				
				if rDoc.[HOZ_DOG_REF]%state != 'WORK' then
					pragma error ('Обработка документа невозможна, так как связанный хозяйственный договор в состоянии '|| Lib.State_name(rDoc.[HOZ_DOG_REF]%State,rDoc.[HOZ_DOG_REF]%Class));
				end if;					
				
				::[VHO_INTERFACE].[PRX_TMC].TMC_ACC_MAT_DELETE_AUTO(acc);
			exception
				when NO_DATA_FOUND then
					null;				
			end;				
		end loop;	
	-- если документ списания, то удаляем из объекта кап. вложений договора из первого движения	(т.к. нет ссылки на хоз. договор)			
	elsif rDoc.[DOC_NAME_REF].[SIGN_OB_MAT_ARR]
		and upper(rDoc.[DOC_NAME_REF].[OPER].[CODE]) = 'СПИСАНИЕ' then
		
		for list in rDoc.[LIST_TMC]
		loop
			begin
				HozDog := list.[ACC_MAT_SUP].[FIRST_MOVE].[TMC_DOCUM_REF].[HOZ_DOG_REF];
				locate acc in HozDog.[OB_MAT_ACC_ARR]
				where acc.[ACC_MAT] = list.[ACC_MAT_SUP];	
				
				if HozDog%state != 'WORK' then
					pragma error ('Обработка документа невозможна, так как хозяйственный договор из первого движения в состоянии '|| Lib.State_name(HozDog%State,HozDog%Class));
				end if;					
				
				::[VHO_INTERFACE].[PRX_TMC].TMC_ACC_MAT_DELETE_AUTO(acc);
			exception
				when NO_DATA_FOUND then
					null;
			end;				
		end loop;	
					
		
	end if;	
end;

-- если вставляем движение амортизации с увеличением налоговой премии в середину таблицы, то для всех след движений увеличим налоговую премию
procedure calc_nal_prem_middle (p_ac_mat ref [AC_MAT], p_doc ref [TMC_DOCUM])
is
last_doc_depr_move ref [TMC_MOVE]; -- последнее движение амортизации, порожденное данным документом
prev_move ref [TMC_MOVE]; -- движение перед движениями порожденными док-ом амортизацтт
delta_nal_prem [SUMMA];
tab_move ::[AC_MAT].[TAB_MOVE];
begin
	tab_move := p_ac_mat.[TAB_MOVE];
	-- для начала найдем последние порожденное движение данным документом
	locate last_doc_depr_move in tab_move
	where last_doc_depr_move.[TMC_DOCUM_REF] = p_doc
	and p_doc.[DOC_NAME_REF].[OPER].[CODE] = 'АМОРТИЗАЦИЯ_Н' -- только документ налоговой амортизации!
	order by last_doc_depr_move.[NUM_ORD] desc;
	
	begin				
		-- ищем разницу налоговой премии с последним движением до амортизации
		locate prev_move in tab_move
		where prev_move.[NUM_ORD] < last_doc_depr_move.[NUM_ORD]
		and prev_move.[TMC_DOCUM_REF] != p_doc
		order by prev_move.[NUM_ORD] desc;
		
		delta_nal_prem := last_doc_depr_move.[NAL_PREM] - prev_move.[NAL_PREM];
			
		-- для всех следующих движений добавим эту разницу в налоговую премию.
		-- Почему не присваиваем эту нал премию всем след движениям? на всякий случай, вдруг в след движениях тоже будет изменяться налоговая премия
		for v_move in tab_move
		where v_move.[NUM_ORD] > last_doc_depr_move.[NUM_ORD]
		and v_move.[TMC_DOCUM_REF] != p_doc  -- на всякий случай, это же амортизация
		order by v_move.[NUM_ORD]
		loop
			&debug('Для движения с ид = '||v_move%id||' увеличим нал премию на = '||delta_nal_prem,0)
			&debug('Старое значение = '||v_move.[NAL_PREM],0)
			v_move.[NAL_PREM] := v_move.[NAL_PREM] + delta_nal_prem;
			&debug('Установили значение = '||v_move.[NAL_PREM],0)
		end loop;
				
	exception
		when NO_DATA_FOUND then
			null;	
	end;
	
	----- костыль ----- BS00562496, BS00562529 akuzmin
	for v_move_move in tab_move
	where v_move_move.[NUM_ORD] > last_doc_depr_move.[NUM_ORD]
	and v_move_move.[TMC_DOCUM_REF].[DOC_NAME_REF].[OPER].[CODE] = 'ПЕРЕДАЧА'
	and nvl(v_move_move.[NAL_ALL_DEPR] + v_move_move.[NAL_PER_DEPR], 0) = 0
	and nvl(v_move_move.[NAL_BASE_SUMMA], 0) <> 0
	loop	
		v_move_move.[NAL_PER_DEPR] := 0;
		v_move_move.[NAL_ALL_DEPR] := 0;					
		v_move_move.[NAL_SUMMA] := 0;
		v_move_move.[NAL_BASE_SUMMA] := 0;					
	end loop;	
	----------------		
				
exception
	when NO_DATA_FOUND then
		null;	
end;	
/*Проверка записей в массиве КСЭ (Конструктивно-сочлененные эелементы).
			 * Документ выбытия/продажи не должен быть обработан,
			 * если в массиве КСЭ есть хотя бы одна запись с признаком "Исключен" = нет.
			 * Если данный мат. счет находится в массиве КСЭ другого мат. счета, то проставить на текущем признак "Исключен"= да.
*/ 			
Public procedure CheckCOMPOUND (p_oper 			[STRING_16]	--Код операции
	 							,p_currMatAcc	[AC_MAT]	--обрабатываемый мат счет
	 							,p_doc			[TMC_DOCUM]	--обрабатываемый документ
	 							,p_DateExclude	date		--дата исключения
	 							,p_undo_doc		boolean default false
								)
is		
	comp ref [TMC_COMPOUND];
begin	
	if p_oper in ('РАСХОД', 'РЕАЛИЗАЦИЯ', 'СПИСАНИЕ') then
					
		for (	select a(	 a%id 			: CompId
							,ac%id			: accId
							,ac.[ACC_MAT]	: accNum
							,a.[DATE_ADD]	: CompDate	
						)
				in ::[TMC_COMPOUND], (::[AC_MAT] all : ac) all
				where	nvl(a.[EXCLUDE], false) = p_undo_doc
					and a.[AC_MAT] = p_currMatAcc%id
					and ac.[COMPOUND] = a%collection					
			)
		loop
			
			if p_undo_doc then
				
				stdio.put_line_buf('Материальный счет "' || p_currMatAcc.[ACC_MAT] || '" включен в массив КСЭ материального счета "' ||a.accNum
									|| '" на основании отмены обработки документа № ' || p_doc.[DOCUMENT_NUM]
									|| ' от ' || to_char(p_doc.[DATE_DOC], 'DD/MM/YYYY')
									|| '!'
									);		
			else					
				stdio.put_line_buf('Материальный счет "' || p_currMatAcc.[ACC_MAT] || '" был исключен из массива КСЭ материального счета "' ||a.accNum
									|| '" на основании документа № ' || p_doc.[DOCUMENT_NUM]
									|| ' от ' || to_char(p_doc.[DATE_DOC], 'DD/MM/YYYY')
									|| '!'
									);
			end if;
			
			comp	:=	a.CompId;
			
			comp.[DO_EXCLUDE](	 P_AC_MAT 	==	a.accId
								,P_DATE_ADD ==	a.CompDate
								,P_EXCLUDE	==	not p_undo_doc
								,P_REASON	==	'Материальный документ № ' || p_doc.[DOCUMENT_NUM] || ' от ' || to_char(p_doc.[DATE_DOC], 'DD/MM/YYYY') || '.'
								,P_DATE_EX	==	p_DateExclude
			);
			
		end loop;
	end if;
end;


/* расчет налоговой премии*/
public procedure calc_prem (doc ref[TMC_DOCUM])  is
v_acc  ref [AC_MAT];
v_acc_sup ref [AC_MAT];
v_acc_rec ref [AC_MAT];
v_prem	[SUMMA];
plus_prem [SUMMA];
minus_prem [SUMMA];
v_num [TMC_MOVE].[NUM_ORD]%type;
doc_code [TMC_DOCUM].[DOC_NAME_REF].[OPER].[CODE]%type;
i integer;
v_count integer;
begin
	doc_code:=doc.[DOC_NAME_REF].[OPER].[CODE];
	select x(count(x)) in doc.[LIST_TMC] into v_count;
	
	if doc_code='АМОРТИЗАЦИЯ_Н' and v_count=0 then --начисляем  н.амортизацию с пустым списком ТМЦ
		for (select distinct ac(ac%id:ac_obj)
			 in [AC_MAT]
			 where
			 	exists(select x(1) in ac.TAB_MOVE
			 			where x.[TMC_DOCUM_REF]=doc
					)		
		)
		loop
			v_acc_rec:=ac.ac_obj;
			i:=0;
			for v_move in v_acc_rec.[TAB_MOVE]
			where v_move.[TMC_DOCUM_REF]=doc
			order by v_move.[NUM_ORD] asc
			loop
				if i=0 then
						v_prem:=v_move.[NAL_PREM];
				end if;
				if v_move.[MOVE_UP_NAL_SUM] is not null then
						v_prem:=v_prem+nvl(v_move.[NAL_PER_DEPR],0);
				end if;
				v_move.[NAL_PREM]:=v_prem;			
				i:=i+1;			
			end loop;
			
			calc_nal_prem_middle(v_acc_rec, doc);
			
		end loop;
		
		
	else
		for list in doc.[LIST_TMC]
		loop
			v_acc_sup:=list.[ACC_MAT_SUP];
			v_acc_rec:=list.[ACC_MAT_REC];
			if doc_code in ('МОНТАЖ','ДОНАЦЕНКА','ПРИХОД','ПЕРЕДАЧА') then
				v_acc:=v_acc_rec;
			else
				v_acc:=v_acc_sup;
			end if;		
			--При приходе из филиала налоговую премию  для первого движения берем из доп.параметров списка тмц
			if doc_code ='ПРИХОД' then
				v_acc.[FIRST_MOVE].[NAL_PREM]:=nvl([TMC_PARAM].[LIB].get_(list.[TAB_PARAM],[TMC_ATTRIBUTES](CODE = 'SUM_NAL_PREM'))	
													,0);
			end if;
			i:=0;
			if doc_code = 'МОНТАЖ' and list.[GRUPPA_SUP].[KIND_USER].[CODE]='ЭКСПЛ' then --в этом случае у комплектующей может доначислиться амортизация
				for v_move in v_acc_sup.[TAB_MOVE]
				where v_move.[TMC_DOCUM_REF]=doc
				order by v_move.[NUM_ORD] asc
				loop
					if i=0 then
						v_prem:=v_move.[NAL_PREM];
					end if;
					if v_move.[MOVE_UP_NAL_SUM] is not null then
						v_prem:=v_prem+nvl(v_move.[NAL_PER_DEPR],0);
					end if;
					v_move.[NAL_PREM]:=v_prem;			
					i:=i+1;
				end loop;			
				plus_prem:=v_acc_sup.[LAST_MOVE].[PREV_MOVE].[NAL_SUMMA]-v_acc_sup.[LAST_MOVE].[PREV_MOVE].[NAL_BASE_SUMMA]; --сумма премии, которая перейдет на счет-получатель				
				v_acc_sup.[LAST_MOVE].[NAL_PREM]:=0; --вся премия ушла на счет-получатель
			elsif doc_code = 'ДЕМОНТАЖ' then
				minus_prem:=v_acc_rec.[LAST_MOVE].[NAL_SUMMA]-v_acc_rec.[LAST_MOVE].[NAL_BASE_SUMMA];
				--Налоговая премия комплектующей:
				v_acc_rec.[LAST_MOVE].[NAL_PREM]:= minus_prem;-- премия вычисляется как "налоговая стоимость"-"базовая"
			end if;	
			--Проходим по таблице движений счета, начиная с движения(v_num), ссылка на список тмц которого = текущему (list)
			select n(min(n.num_ord))
			in  (select y(y.[NUM_ORD]:num_ord)
				 in v_acc.[TAB_MOVE]
				 where y.[TMC_LIST] =list
				 )
			into v_num;	
	
			i:=0;
			for v_move in v_acc.[TAB_MOVE]
			where v_move.[NUM_ORD]>=v_num
			order by v_move.[NUM_ORD] asc
			loop
				if i=0 then
					v_prem:=v_move.[NAL_PREM];
				end if;
	
				if v_move.[MOVE_UP_NAL_SUM] is not null then
					v_prem:=v_prem+nvl(v_move.[NAL_PER_DEPR],0);
				end if;
				if doc_code = 'ДЕМОНТАЖ'
				 and v_move.[TMC_LIST]=list
				 and v_move.[AMO_MONTH_DATE] is null then--это не движение доначисления бухг. или налог. амортизации			
					v_prem:=v_prem-v_acc_rec.[LAST_MOVE].[NAL_PREM];
				elsif doc_code = 'МОНТАЖ' and list.[GRUPPA_SUP].[KIND_USER].[CODE]='ЭКСПЛ'
					and v_move.[TMC_LIST]=list then --для того, чтобы премия при монтаже пришла только один раз(и не увеличивалась для след движений)
					v_prem:=v_prem+v_acc_sup.[LAST_MOVE].[PREV_MOVE].[NAL_PREM];
				end if;
				v_move.[NAL_PREM]:=v_prem;			
				i:=i+1;
			end loop;
			
		
			declare
				last_doc_depr_move ref [TMC_MOVE]; -- последнее движение амортизации, порожденное данным документом
				prev_move ref [TMC_MOVE]; -- движение перед движениями порожденными док-ом амортизацтт
				delta_nal_prem [SUMMA];
			begin
				-- для начала найдем последние порожденное движение данным документом
				locate last_doc_depr_move in v_acc.[TAB_MOVE]
				where last_doc_depr_move.[TMC_DOCUM_REF] = doc
				and doc.[DOC_NAME_REF].[OPER].[CODE] = 'АМОРТИЗАЦИЯ_Н' -- только документ налоговой амортизации!
				order by last_doc_depr_move.[NUM_ORD] desc;
				
				begin				
					-- ищем разницу налоговой премии с последним движением до амортизации
					locate prev_move in v_acc.[TAB_MOVE]
					where prev_move.[NUM_ORD] < last_doc_depr_move.[NUM_ORD]
					and prev_move.[TMC_DOCUM_REF] != doc
					order by prev_move.[NUM_ORD] desc;
					
					delta_nal_prem := last_doc_depr_move.[NAL_PREM] - prev_move.[NAL_PREM];
						
					-- для всех следующих движений добавим эту разницу в налоговую премию.
					-- Почему не присваиваем эту нал премию всем след движениям? на всякий случай, вдруг в след движениях тоже будет изменяться налоговая премия
					for v_move in v_acc.[TAB_MOVE]
					where v_move.[NUM_ORD] > last_doc_depr_move.[NUM_ORD]
					and v_move.[TMC_DOCUM_REF] != doc  -- на всякий случай, это же амортизация :-)
					and v_move.[MOVE_UP_NAL_SUM] is not null
					order by v_move.[NUM_ORD]
					loop
						&debug('Для движения с ид = '||v_move%id||' увеличим нал премию на = '||delta_nal_prem,0)
						&debug('Старое значение = '||v_move.[NAL_PREM],0)
						v_move.[NAL_PREM] := v_move.[NAL_PREM] + delta_nal_prem;
						&debug('Установили значение = '||v_move.[NAL_PREM],0)
					end loop;
							
				exception
					when NO_DATA_FOUND then
						null;	
				end;
				----- костыль ----- BS00562496, BS00562529 akuzmin
				for v_move_move in v_acc.[TAB_MOVE]
				where v_move_move.[NUM_ORD] > last_doc_depr_move.[NUM_ORD]
				and v_move_move.[TMC_DOCUM_REF].[DOC_NAME_REF].[OPER].[CODE] = 'ПЕРЕДАЧА'
				and nvl(v_move_move.[NAL_ALL_DEPR] + v_move_move.[NAL_PER_DEPR], 0) = 0
				and nvl(v_move_move.[NAL_BASE_SUMMA], 0) <> 0
				loop
					v_move_move.[NAL_PER_DEPR] := 0;
					v_move_move.[NAL_ALL_DEPR] := 0;					
					v_move_move.[NAL_SUMMA] := 0;
					v_move_move.[NAL_BASE_SUMMA] := 0;					
				end loop;			
				----------------							
			exception
				when NO_DATA_FOUND then
					null;	
			end;				
			--при обработке реализации в доп.атрибуты добавляем премию(она должна передаваться при передаче между филиалами)
			if doc_code = 'РЕАЛИЗАЦИЯ' then
				::[TMC_PARAM].[LIB].ins_(list.[TAB_PARAM],
										 [TMC_ATTRIBUTES](CODE = 'SUM_NAL_PREM'),
									 	 v_acc_sup.[LAST_MOVE].[NAL_PREM]
										 );
			end if;
			--при реализации и списании в последнем движении налоговая премия зануляется
			if doc_code = 'РЕАЛИЗАЦИЯ' or
				(doc_code = 'СПИСАНИЕ' and v_acc_sup.[LAST_MOVE].[NAL_SUMMA]=0 ) --исключаем случай, когда продолжаем амортизаировать списанные
			 then
			 	v_acc_sup.[LAST_MOVE].[NAL_PREM]:=0;
			
			end if;
		end loop;
	end if;
	
end;




procedure init_user_accs_from_sup(p_tmc_list ref [TMC_LIST])
is
gr_sup ref [TMC_GRUP];
gr_rec ref [TMC_GRUP];
acc_mat_sup ref [AC_MAT];
acc_mat_rec ref [AC_MAT];
gr_sup_tab_ballans ::[TMC_GRUP].[TAB_BALLANS]%type;
gr_rec_tab_ballans ::[TMC_GRUP].[TAB_BALLANS]%type;
acc_mat_sup_tab_account ::[AC_MAT].[TAB_ACCOUNT]%type;
acc_mat_rec_tab_account ::[AC_MAT].[TAB_ACCOUNT]%type;
tmc_list_tab_acc ::[TMC_LIST].[TAB_ACC]%type;
tab_gr_sup_r [TMC_BAL_ACC];
ac_fin ref [AC_FIN];
begin	
	for (select t(t.[GRUPPA_SUP]				: GRUPPA_SUP
				, t.[GRUPPA_REC]				: GRUPPA_REC
				, t.[ACC_MAT_SUP]				: ACC_MAT_SUP
				, t.[ACC_MAT_REC]				: ACC_MAT_REC
				, t.[GRUPPA_SUP].[TAB_BALLANS]	: GRUPPA_SUP_TAB_BALLANS
				, t.[GRUPPA_REC].[TAB_BALLANS]	: GRUPPA_REC_TAB_BALLANS
				, t.[ACC_MAT_SUP].[TAB_ACCOUNT]	: ACC_MAT_SUP_TAB_ACCOUNT
				, t.[ACC_MAT_REC].[TAB_ACCOUNT]	: ACC_MAT_REC_TAB_ACCOUNT
				, t.[TAB_ACC]					: TAB_ACC
				)
			 in ::[TMC_LIST] all
		  where t = p_tmc_list)
	loop
		gr_sup := t.GRUPPA_SUP;
		gr_rec := t.GRUPPA_REC;
		acc_mat_sup := t.ACC_MAT_SUP;
		acc_mat_rec := t.ACC_MAT_REC;
		gr_sup_tab_ballans := t.GRUPPA_SUP_TAB_BALLANS;
		gr_rec_tab_ballans := t.GRUPPA_REC_TAB_BALLANS;
		acc_mat_sup_tab_account := t.ACC_MAT_SUP_TAB_ACCOUNT;
		acc_mat_rec_tab_account := t.ACC_MAT_REC_TAB_ACCOUNT;
		tmc_list_tab_acc := t.[TAB_ACC];
		exit;
	end loop;
	--если у поставщика были лиц. счета и матсчет не поменялся, то проинициализируем их в получателе с новой группой
	if acc_mat_sup = acc_mat_rec and acc_mat_rec is not null and acc_mat_sup is not null and gr_rec != gr_sup then
		
		--ищем лицевые счета поставщика
		for tab_gr_sup in gr_sup_tab_ballans where tab_gr_sup.[SIGN_ACC] = true
		loop
			tab_gr_sup_r := tab_gr_sup;
			-- получили фин счет с постащика
			ac_fin := ::[TMC_USER_ACC].[LIB].get_acc_by_gr_tune(acc_mat_sup_tab_account, tab_gr_sup);
			
			if ac_fin is not null then
				-- если у получателя все тоже самое
				for tab_gr_rec in gr_rec_tab_ballans where tab_gr_rec.[SIGN_ACC] = true
					and tab_gr_sup_r.[BAL_ACC] 	= tab_gr_rec.[BAL_ACC]
					and (tab_gr_sup_r.[DEPART] = tab_gr_rec.[DEPART] or (tab_gr_sup_r.[DEPART] is null and tab_gr_rec.[DEPART] is null ))
					and (tab_gr_sup_r.[FILIAL]	= tab_gr_rec.[FILIAL] or (tab_gr_sup_r.[FILIAL] is null and tab_gr_rec.[FILIAL] is null ))
					and (tab_gr_sup_r.[INTEND]	=  tab_gr_rec.[INTEND]  or (tab_gr_sup_r.[INTEND] is null and tab_gr_rec.[INTEND] is null ))
					and (tab_gr_sup_r.[MOL]	= tab_gr_rec.[MOL] or (tab_gr_sup_r.[MOL] is null and tab_gr_rec.[MOL] is null ))
					and (tab_gr_sup_r.[PLACE]	= tab_gr_rec.[PLACE] or (tab_gr_sup_r.[PLACE] is null and tab_gr_rec.[PLACE] is null ))
					and nvl(tab_gr_sup_r.[SIGN_TMC], false) 	= nvl(tab_gr_rec.[SIGN_TMC], false)
					and tab_gr_sup_r.[TYPE_ACC]	= tab_gr_rec.[TYPE_ACC]
					and not exists (select x(x) in acc_mat_rec_tab_account where x.[GRUPPA] = gr_rec and (x.[PLACE] = tab_gr_sup_r.[PLACE] or (x.[PLACE] is null and tab_gr_sup_r.[PLACE] is null)) and (x.[MOL] = tab_gr_sup_r.[MOL] or (x.[MOL] is null and tab_gr_sup_r.[MOL] is null)) and (x.[DEPART] = tab_gr_sup_r.[DEPART] or (x.[DEPART] is null and tab_gr_sup_r.[DEPART] is null)) and x.[TYPE_ACC] = tab_gr_sup_r.[TYPE_ACC] and (x.[FILIAL] = tab_gr_sup_r.[FILIAL] or (x.[FILIAL] is null and tab_gr_sup_r.[FILIAL] is null)) and x.[FIN_ACC] = ac_fin)
					-- и данный счет не проставлен в таблице счетов списка ТМЦ
					and not exists (select t(t) in tmc_list_tab_acc where (t.[DEPART] = tab_gr_sup_r.[DEPART] or (t.[DEPART] is null and tab_gr_sup_r.[DEPART] is null))and t.[TYPE_ACC] = tab_gr_sup_r.[TYPE_ACC] and t.[FILIAL] = tab_gr_sup_r.[FILIAL])
				loop						
					acc_mat_rec_tab_account.[NEW#AUTO](
														tab_gr_sup_r.[TYPE_ACC]		--Тип счета
														,ac_fin						--Финансовый счет
														,gr_rec						--Группа
														,tab_gr_sup_r.[MOL]			--МОЛ
														,tab_gr_sup_r.[DEPART]		--Подразделение
														,tab_gr_sup_r.[PLACE]		--Местонахождение
														,tab_gr_sup_r.[FILIAL]		--Филиал
														);						
				end loop;
			end if;	
		end loop;			
	end if;
end;

-- Для создания документа переоценки после обработки документа типа АФПП_СКЛАД_ЭКСПЛ
procedure CreateAffpReval(p_main_doc ref [TMC_DOCUM], p_date date) is
	mat_acc 		ref [AC_MAT];
	tb_move			ref [TMC_MOVE];
	opr_doc			ref [TMC_DOCUM];
	opr_sum	[SUMMA];
	doc_ref			ref [TMC_DOCUM];
	list_ref		ref [TMC_LIST];
	lv_canon_val		varchar2(2000);
	doc_name		ref [TMC_DOC_NAME];
begin
	&debug('Создание документа переоценки для вводимого в эксплуатацию со склада АФПП',0)
	For SS In p_main_doc.[LIST_TMC] where SS.[GRUPPA_REC].[TYPE].[CODE] = 'АФПП' loop
		mat_acc := ss.[ACC_MAT_REC];
		/*По таблице движений материального счета получателя ТМЦ типа АФПП, вводимого в эксплуатацию,
		определяется материальный документ оприходования ТМЦ  с кодом операции ПРИХОД у вида материального документа*/
		begin
			locate tb_move in mat_acc.[TAB_MOVE] where tb_move.[TMC_DOCUM_REF].[DOC_NAME_REF].[OPER].[CODE] = 'ПРИХОД'
				order by tb_move.[NUM_ORD] desc;
			opr_doc := tb_move.[TMC_DOCUM_REF];
			&debug('Найден мат документ прихода (id ' ||opr_doc ||')',0)
		exception when no_data_found then
			pragma error ('По мат. счету ' || mat_acc.[ACC_MAT] || ' не найдено движение по приходу.');
		end;
		/*По записи из списка ТМЦ найденного материального документа, относящейся к анализируемому материальному счету, вычисляется сумма операции оприходования ТМЦ типа АФПП*/
		opr_sum := 0;
		for i in opr_doc.[LIST_TMC] where i.[GRUPPA_REC].[TYPE].[CODE] = 'АФПП' loop
			opr_sum := opr_sum + i.[ALL_SUMMA];
		end loop;
		&debug('Сумма операции оприходования: ' || opr_sum,0)
		/*Если текущий остаток на счете 60807 (тип HOZ_60807) отличается от суммы оприходования АФПП, стоимость АФПП должна быть переоценена до суммы остатка на счете 60807. */
		if p_main_doc.[HOZ_DOG_REF] is null then
			pragma error('В документе отсутствует ссылка на хоз. договор');
		end if;
		&debug('Текущий остаток на 60807: ' || nvl(V#OST_HOZ_60807,0),0)
		if V#OST_HOZ_60807 <> opr_sum then
			/*Переоценка производится через формирование материального документа вида "Указание на переоценку ОС" (ОС_ПЕРЕОЦЕНКА)
			и его обработкой без создания платежных документов и счетов-фактур*/
			lv_canon_val := ::[FP_TUNE].[LIB].set_canons('TMC_GRUP',  mat_acc.[GRUPPA], '<BP_TMC_PROC>', 'REVAL_TMC');
			doc_name := ::[FP_TUNE].[LIB].get_ref_value (code == 'TMC_DOC_DEF', canon_vals == lv_canon_val);
			if doc_name is null then
				pragma error ('Не указан вид материального документа в настройке "TMC_DOC_DEF" для доп. критерия ''REVAL_TMC'''
					|| ' и тмц группы ''' || mat_acc.[GRUPPA].[CODE] || '''');
			end if;
			doc_ref := ::[TMC_DOCUM].[NEW#DOCUM](
							p_main_doc.[DATE_DOC],	 					-- Дата документа
							nvl(::[TMC_DOC_NAME].[LIB].get_num_doc(doc_name, p_main_doc.[DATE_DOC], null, true),1), -- Номер документа
							doc_name,									-- Наименование документа
							null,	 									-- Основание создания документа
							null,	 									-- Поставщик(Контрагент)
							p_main_doc.[SUP_DEPART_REF],	 			-- Поставщик(Подразделение)
							p_main_doc.[SUP_MOL_REF],	 				-- Поставщик(МОЛ)
							null,	 									-- Получатель(Контрагент)
							p_main_doc.[REC_DEPART_REF],	 			-- Получатель(Подразделение)
							p_main_doc.[REC_MOL_REF],	 				-- Получатель(МОЛ)
							null,	 -- Счет расчетов с Дебиторами-Кредиторами
							null,	 -- Местонахождение
							null,	 -- Договор
							null,	 -- Номер договора
							null,	 -- Дата договора
							null,	 -- Доверенность
							null,	 -- Номер доверенности
							null,	 -- Дата доверенности
							p_main_doc,	 -- Материальный документ
							null,	 -- Декларация
							null,	 -- Материальный счет
							null,	 -- Номер счета-фактуры
							null,	 -- Дата счета-фактуры
							null,	 -- Дата оплаты счета-фактуры
							sys_context(user_context, 'NATCUR'),	 -- Валюта документа
							1,		 -- Курс валюты докумета
							null,	 -- Через кого
							null,	 -- У кого
							null,	 -- Состав комиссии
							null,	 -- Сумма накладных расходов
							null,	 -- Сумма таможенных расходов
							null,	 -- Характеристика доп/расходов
							null,	 -- Цель использования средств
							null,	 -- Содержание записи
							p_main_doc.[DATE_DOC],	 -- Дата переоценки
							null,	 -- Дата начала периода обработки
							null,	 -- Дата окончания периода обработки
							null	 -- Не использовать налоговую премию
						);
						
			stdio.PUT_LINE_BUF('Создан документ № ' ||doc_ref.[DOCUMENT_NUM] || ' (id ' ||doc_ref%id ||  '), дата док-та ' || to_char(doc_ref.[DATE_DOC],'dd.mm.yyyy') ||
				', дата переоценки: "' || to_char(doc_ref.[DATE_PRICE],'dd.mm.yyyy')||'"');
				
			-- добавляем тмц - экземпляр переоценки 448-П
			declare
				P_ACC_MAT		[TMC_ACC_MAT_REF];
				P_GRUPPA		[TMC_GRUP_REF];
				P_ALL_SUMMA		[SUMMA];
				P_KOEF			[SUPER_SUMMA];
				P_SUMMA_EST		[SUMMA];
				P_PRIM			[STRING_100];
				P_BASIS			[STRING_100];
				P_ACC_ESTIM		[AC_FIN_REF];
				P_ACC_DEPR		[AC_FIN_REF];
				P_ACC_MAIN		[AC_FIN_REF];
				P_CLEAR_PRICE_SUMMA [SUMMA];
				P_MES			varchar2(32000);
				P_VAL			varchar2(32000);

				pP_NEW_SPI		integer;
				pP_NEW_END_DEPR	date;
			begin
			/** /
				P_MES := 'DEFAULT';
				P_VAL := '';
				P_ACC_MAT := mat_acc;
				--P_ACC_MAT.[LAST_DEPR] := to_date('02/01/2019');
				::[TMC_LIST].[NEW_ESTIM_448_P].V_PARENT_MAT_DOC := doc_ref;
				list_ref => [NEW_ESTIM_448_P](P_MES,P_VAL,P_ACC_MAT,P_GRUPPA,P_ALL_SUMMA,P_KOEF,P_SUMMA_EST,P_PRIM,P_BASIS,P_ACC_ESTIM,P_ACC_DEPR,P_ACC_MAIN,P_CLEAR_PRICE_SUMMA);
				P_MES := 'VALIDATE';
				P_VAL := 'P_ACC_MAT';	
				P_ACC_MAT := mat_acc;
				list_ref => [NEW_ESTIM_448_P](P_MES,P_VAL,P_ACC_MAT,P_GRUPPA,P_ALL_SUMMA,P_KOEF,P_SUMMA_EST,P_PRIM,P_BASIS,P_ACC_ESTIM,P_ACC_DEPR,P_ACC_MAIN,P_CLEAR_PRICE_SUMMA);
				P_ALL_SUMMA := V#OST_HOZ_60807;
				P_ACC_MAT := mat_acc;
				&debug('V_NEED_REVAL_SUM = ' || (V#OST_HOZ_60807 - opr_sum),0)
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P].V_NEED_REVAL_SUM := (V#OST_HOZ_60807 - opr_sum) ;
				P_MES := 'VALIDATE';
				P_VAL := 'P_ALL_SUMMA';	
				list_ref => [NEW_ESTIM_448_P](P_MES,P_VAL,P_ACC_MAT,P_GRUPPA,P_ALL_SUMMA,P_KOEF,P_SUMMA_EST,P_PRIM,P_BASIS,P_ACC_ESTIM,P_ACC_DEPR,P_ACC_MAIN,P_CLEAR_PRICE_SUMMA);
				
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P](P_ACC_MAT,P_GRUPPA,P_ALL_SUMMA,P_KOEF,P_SUMMA_EST,P_PRIM,P_BASIS,P_ACC_ESTIM,P_ACC_DEPR,P_ACC_MAIN,P_CLEAR_PRICE_SUMMA);
				&debug('Добавлен экземпляр в список тмц документа переоценки',0)
			end;
			&debug('обработка документа переоценки',0)
			doc_ref.[WORK_DOCUM](p_date, false, null, false, false); -- обработка
			/**/
				P_MES := 'DEFAULT';
				P_VAL := '';
				P_ACC_MAT := mat_acc;
				--P_ACC_MAT.[LAST_DEPR] := to_date('02/01/2019');
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P].V_FROM_AUR := true;
				::[TMC_LIST].[NEW_ESTIM_448_P].V_PARENT_MAT_DOC := doc_ref;
				list_ref => [NEW_ESTIM_448_P](P_MES,P_VAL,P_ACC_MAT,P_GRUPPA,P_ALL_SUMMA,P_KOEF,P_SUMMA_EST,P_PRIM,P_BASIS,P_ACC_ESTIM,P_ACC_DEPR,P_ACC_MAIN,P_CLEAR_PRICE_SUMMA,pP_NEW_SPI,pP_NEW_END_DEPR);
				P_MES := 'VALIDATE';
				P_VAL := 'P_ACC_MAT';	
				P_ACC_MAT := mat_acc;
				list_ref => [NEW_ESTIM_448_P](P_MES,P_VAL,P_ACC_MAT,P_GRUPPA,P_ALL_SUMMA,P_KOEF,P_SUMMA_EST,P_PRIM,P_BASIS,P_ACC_ESTIM,P_ACC_DEPR,P_ACC_MAIN,P_CLEAR_PRICE_SUMMA,pP_NEW_SPI,pP_NEW_END_DEPR);
				P_ALL_SUMMA := V#OST_HOZ_60807;
				P_ACC_MAT := mat_acc;
				&debug('V_NEED_REVAL_SUM = ' || (V#OST_HOZ_60807 - opr_sum),0)
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P].V_NEED_REVAL_SUM := (V#OST_HOZ_60807 - opr_sum);
				P_SUMMA_EST := (V#OST_HOZ_60807 - opr_sum);
				
				P_MES := 'VALIDATE';
				P_VAL := 'P_SUMMA_EST';	
				list_ref => [NEW_ESTIM_448_P](P_MES,P_VAL,P_ACC_MAT,P_GRUPPA,P_ALL_SUMMA,P_KOEF,P_SUMMA_EST,P_PRIM,P_BASIS,P_ACC_ESTIM,P_ACC_DEPR,P_ACC_MAIN,P_CLEAR_PRICE_SUMMA,pP_NEW_SPI,pP_NEW_END_DEPR);
				
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P](P_ACC_MAT,P_GRUPPA,P_ALL_SUMMA,P_KOEF,P_SUMMA_EST,P_PRIM,P_BASIS,P_ACC_ESTIM,P_ACC_DEPR,P_ACC_MAIN,P_CLEAR_PRICE_SUMMA,pP_NEW_SPI,pP_NEW_END_DEPR);
				&debug('Добавлен экземпляр в список тмц документа переоценки',0)
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P].V_NEED_REVAL_SUM := null;
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P].V_PARENT_MAT_DOC := null;
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P].V_FROM_AUR := null;
			exception when others then -- перехват всех исключений, чтобы сбросить переменные и сгенерировать исключение повторно
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P].V_NEED_REVAL_SUM := null;
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P].V_PARENT_MAT_DOC := null;
				doc_ref.[LIST_TMC].[NEW_ESTIM_448_P].V_FROM_AUR := null;
				raise;	
			end;
			&debug('обработка документа переоценки',0)
		  --doc_ref.[WORK_DOCUM](p_date, false, null, false, false, null, p_set_date_val); -- обработка
		    doc_ref.[WORK_DOCUM](p_date, false, null, false, false, null); -- обработка
		end if;
		
		exit; -- предполагаем, что в родит. мат. док. только 1 тмц
	end loop;
	
end;


procedure CloseAccRealize(pDoc ref [TMC_DOCUM], business_oper ref [PATTERN_DOC]) is
	sCode_TMC_REAL_SPIS ::[TIP_ACC].[COD]%type := 'TMC_REAL_SPIS';
	sCode_TMC_REALIZE	::[TIP_ACC].[COD]%type := 'TMC_REALIZE';
	bUse_TMC_REAL_SPIS  boolean := false;
	bUse_TMC_REALIZE  	boolean := false;
	
	P#ACC_MAT_SUP ref [AC_MAT];
	V#SUP_DEPART ref [DEPART];
	V#FILIAL ref [BRANCH];
	P#KIND_BANK	boolean; --банковская деятельность
	P#ACC_REALIZE  [AC_FIN_REF];
	is_group_acc boolean; -- признак группового счета

	--проверим используется ли тип счета in_tip_acc в шаблонах бизнес операции in_business_oper
	function CheccAccInBO(in_tip_acc ref [TIP_ACC],	 in_business_oper ref [PATTERN_DOC]) return boolean is
		tmp number;
	begin
		select sel(1)
		in in_business_oper.[PATTERN_ARRAY] all
		where (sel.[DOC].[DOC].[KL_DT] = in_tip_acc	or sel.[DOC].[DOC].[KL_KT] = in_tip_acc)
			and rownum = 1
		into tmp;
		return true;
	exception when NO_DATA_FOUND then
		return false;
	end;

begin

	-- проверяем использование счета реализации в БО (в системе заведено два типа счета реализации)
	bUse_TMC_REAL_SPIS := CheccAccInBO(::[TIP_ACC]([COD]=sCode_TMC_REAL_SPIS), business_oper);
	bUse_TMC_REALIZE := CheccAccInBO(::[TIP_ACC]([COD]=sCode_TMC_REALIZE), business_oper);
	
	for list in pDoc.[LIST_TMC] loop
		P#ACC_MAT_SUP   := list.[ACC_MAT_SUP]; -- Счет-поставщик
		V#SUP_DEPART	:= pDoc.[SUP_DEPART_REF];    -- Поставщик (Подразделение)
		V#FILIAL		:= V#SUP_DEPART.[FILIAL];    -- филиал
		P#KIND_BANK		:= P#ACC_MAT_SUP.[LAST_MOVE].KIND_BANK;
		
		-- Счет реализации
		if bUse_TMC_REAL_SPIS then P#ACC_REALIZE := P#ACC_MAT_SUP.GET_FIN_ACC(sCode_TMC_REAL_SPIS, is_group_acc, P#KIND_BANK, V#FILIAL); end if;
		if bUse_TMC_REALIZE   then P#ACC_REALIZE := P#ACC_MAT_SUP.GET_FIN_ACC(sCode_TMC_REALIZE, is_group_acc, P#KIND_BANK, V#FILIAL); end  if;
		
		--помечаем счет к закрытию
		if P#ACC_REALIZE is not null then
			if is_group_acc then
				stdio.put_line_buf('Закрытие счета '||P#ACC_REALIZE.[MAIN_V_ID]||' невозможно. Счет содержится в таблице групповых счетов.');
			else
				::[VHO_INTERFACE].[PRX_TMC].AC_FIN_TO_CLOSE( P#ACC_REALIZE 	--Ссылка на помечаемый фин. счет
															,true			--Пометить к закрытию
															);
			end if;
		end if;
	end loop;
	
end;

