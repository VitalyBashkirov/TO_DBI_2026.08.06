class DAYDOCS;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] О. Документы дня. Сальдовые проводки (игнорировать отрицательное сальдо)')
@tag('COPIED')
method PSH_PROCESS_SLDO is
pragma include([STOCK].[MSG]);
PRAGMA include(::[DOG_BROCKER].[SLIB]);

bDoDu     	   boolean;
bDoDil		   boolean;
bDoBrok		   boolean;
bSaldoBuh	   boolean;
bSaldoSvu	   boolean;
bExistsSvu	   boolean;
bExistsSvuDeal boolean;
bExistsSvuBrok boolean;
bExistsSvuDu   boolean;
bDeal boolean;
bBrok boolean;
v_method_str string(250);	-- Башкиров В.Г. 009.12.2025 патч 25.6.01

procedure init_vars(p_this ref [DAYDOCS]) is
begin
	bSaldoBuh := p_this.[DO_SALDO_BUH];
	bSaldoSvu := p_this.[DO_SALDO_SVU];
	
	bDoDil 	:= nvl(p_this.[DO_DIL], false);
	bDoBrok := nvl(p_this.[DO_BROK], false);
	-- Для доверительного управления раздельное выполнение сальдовых проводок по бухгалтерии и СВУ не предусматривается
	bDoDu 	:= nvl(p_this.[DO_DU], false);		
	
	bExistsSvu 		:= ::[EMIS].[VARS_TUNE].b_exists_svu;
	bExistsSvuDu 	:= ::[EMIS].[VARS_TUNE].b_exists_svu_du;
	bExistsSvuDeal 	:= ::[EMIS].[VARS_TUNE].b_exists_svu_deal;
	bExistsSvuBrok 	:= ::[EMIS].[VARS_TUNE].b_exists_svu_brok;
end;

procedure add_bas_doc(	v_tbl 		in out	FP_BAS_DOC_TABLE,
						v_date_op			date,
						v_market		ref [MARKET_PLACE],
						v_mt_sec		ref [MT_SECTIONS],
						v_prefix			string,
						v_num_default	in	string default null
					) is
	is_found boolean;
	j pls_integer;
	i pls_integer;
begin
	is_found := false;
	j := v_tbl.first;
	while j is not null loop
		if 		v_tbl(j).[MARKET] = v_market
			and v_tbl(j).[MT_SEC] = v_mt_sec
		then
			is_found := true;
			j := null;
		else
			j := v_tbl.next(j);
		end if;				
	end loop;
	
	if not is_found then
		i := nvl(v_tbl.last, 0) + 1;
					
		v_tbl(i).[MARKET] 	:= v_market;
		v_tbl(i).[MT_SEC] 	:= v_mt_sec;
		v_tbl(i).[DATE_OP] 	:= v_date_op;
		v_tbl(i).[TEXT_NAZN]:= [FG_DOCUMENT].[LIB_BAS_DOC].get_base_doc(
														&METHOD$CLASS||'.'||&METHOD$SNAME||v_prefix,
														v_date_op
													);
		v_tbl(i).[NUM]		:= v_num_default;
	end if;
end;

public procedure fill_bas_docs(   p_prod_date 		date
								, p_prod 		ref [DAYDOCS]
								, P_BAS_DOC 	in out FP_BAS_DOC_TABLE
								, p_num_default	in	string default null
							)
is
k			pls_integer;
begin
		[DAYDOCS].[ALIB].clear();	
		if p_prod.[DO_DU] then
			::[DAYDOCS].[ALIB].calc_saldo_accs_du(p_prod_date);
			k := [DAYDOCS].[ALIB].du_sec.first;		
			while k is not null loop
				add_bas_doc(	P_BAS_DOC,
								p_prod_date,
								[DAYDOCS].[ALIB].du_sec(k).[MARKET],
								[DAYDOCS].[ALIB].du_sec(k).[MT_SEC],								
								'.DU'
							);
				k := [DAYDOCS].[ALIB].du_sec.next(k);
			end loop;						
			
			for (select l(	l.[MT].[DOG_MT].[MARKET]					: market,
							l.[MT].[MT_SEC].[MT_SEC]					: section
						)
				in ::[SVU_M_GROUND]
				where 	l.[DATE_OP] = p_prod_date
					and l.[MT].[DOG_MT].[MARKET] is not null
					and	l.[MT].[MT_SEC].[MT_SEC] is not null
					and &Is_DOG_DU(l.[DOG]) -- Договора ДУ
				group by	l.[MT].[DOG_MT].[MARKET],
							l.[MT].[MT_SEC].[MT_SEC]
			) loop
				add_bas_doc(	P_BAS_DOC,
								p_prod_date,
								l.market,
								l.section,
								'.DU'
							);				
			end loop;
		else			
			::[DAYDOCS].[ALIB].calc_saldo_accs( p_prod_date, p_prod, p_prod.[DO_DIL], p_prod.[DO_BROK]);

			k := [DAYDOCS].[ALIB].ac_sec.first;		
			while k is not null loop
				add_bas_doc(	P_BAS_DOC,
								p_prod_date,
								[DAYDOCS].[ALIB].ac_sec(k).[MARKET],
								[DAYDOCS].[ALIB].ac_sec(k).[MT_SEC],
								null,
								p_num_default
							);
				k := [DAYDOCS].[ALIB].ac_sec.next(k);
			end loop;			
		end if;
end;
PSH_PROCESS_SLDO (
	@name('Первичные учетные документы операции')         P_BAS_DOC     in table of [FP_BAS_DOC],
	@name('Остатки на биржевых секциях на начало торгов') P_MT_SEC_OSTS in          [SVU_MT_SEC_O_ARR]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_MT_SEC_OSTS := this.[MT_SEC_OSTS];
end if;
-- End initialization of parameters and variables	
begin
	if p_message = 'DEFAULT' then		
		init_vars(this);
		
		::[STOCK].[MSG].dmess('[Секция валидатора] Формировать бухгалтерские документы по расчетам с биржей = ' || case when bSaldoBuh then 'Да' else 'Нет' end);
		::[STOCK].[MSG].dmess('[Секция валидатора] Формировать документы СВУ по расчетам с биржей = ' || case when bSaldoSvu then 'Да' else 'Нет' end);
		::[STOCK].[MSG].dmess('[Секция валидатора] Формировать сальдовые проводки для доверительного управления = ' || case when bDoDu then 'Да' else 'Нет' end);
		::[STOCK].[MSG].dmess('[Секция валидатора] Включено СВУ по доверительному управлению = ' || case when bExistsSvuDu then 'Да' else 'Нет' end);
		::[STOCK].[MSG].dmess('[Секция валидатора] Включено СВУ по ЭЦБ = ' || case when bExistsSvu then 'Да' else 'Нет' end);
		::[STOCK].[MSG].dmess('[Секция валидатора] Включено СВУ по дилерским ЭЦБ = ' || case when bExistsSvuDeal then 'Да' else 'Нет' end);
		::[STOCK].[MSG].dmess('[Секция валидатора] Включено СВУ по брокерским ЭЦБ = ' || case when bExistsSvuBrok then 'Да' else 'Нет' end);
		
		if not bDoDu then
			--AND Первичную зачистку массива остатков делаю здесь, поскольку процедуры теперь эту зачистку не выполняют.
			--Выполнение зачистки не выполняется в процедурах по причине того, что вызовы процедур теперь могут выполняться последовательно.
			[MT_SEC_OSTS]%delete;						
			
			if (bDoDil and bExistsSvuDeal) or (bDoBrok and bExistsSvuBrok) then
				bDeal := bDoDil and bExistsSvuDeal;
				bBrok := bDoBrok and bExistsSvuBrok;
				
				[LIB_SALDO].svu_fill_ost_arrays_new(this, bDeal, bBrok);
			end if;
			
			if not (bDoDil and bExistsSvuDeal) or not (bDoBrok and bExistsSvuBrok) then
				bDeal := bDoDil and not bExistsSvuDeal;
				bBrok := bDoBrok and not bExistsSvuBrok;
				
				[LIB_SALDO].fill_ost_arrays_new(this, bDeal, bBrok);
			end if;									
		else
			--Остатки по секциям заполняются на основании справочника ПДС (SVU_M_GROUND)
			[LIB_SALDO].fill_ost_arrays_du(this);
		end if;

		--Заполнение данных для грида.
		fill_bas_docs(this.[DATE_BEGINING], this, P_BAS_DOC);
	end if;
end;
end;

execute is
prod_date			date;			-- дата продукта
oper			ref	[DOG_OPER];		-- операция, которая будет создана в продукте ДД
folder			ref	[FOLDER_PAY];
folder_svu		ref	[FOLDER_PAY];
V_OPER_TIME 		number;
V_DATE_TIME 		[DATE];
buh_svu_lock 		string;
is_oper_exist		boolean;

function get_new_folder_pay(p_date date, p_daydocs ref [DAYDOCS]) return ref [FOLDER_PAY] is
	result ref [FOLDER_PAY];
begin
	result := ::[FP_INTERFACE].[PRX_FOLDER_PAY].NEW#AUTO(null, p_date, null, null, null, null, p_daydocs, true);		
	result.[CAN_OUT_DT_KT] := true; -- Возможность выхода счетов в Дт/Кт при проводке
	
	return result;
end;

procedure set_nulls is
begin
	::[PAT_ISSUE_NS].[SLIB].set_nulls;
	::[REG_PATT_ACC].[SLIB_VAL].set_nulls;
	::[DAYDOCS].[ALIB].clear;
end;

begin
	-- При повторном запуске выходим из операции
	for (select x(1)
    		 in this.[OPER]
     	  where x.[OPER_TYPE] = ::[TYPE_OPER_NS]([CODE] = 'DD_SALDO')
     	    fetch 1
    ) loop
    	is_oper_exist := true;
    end loop;
	
	if is_oper_exist then
		return;
	end if;
	
	-- проверка возможности запуска этой операции
	::[DAYDOCS].[PROCESS_LIB].check_oper_start(this, 'DD_SALDO');

	init_vars(this);

	-- В мегакнопке не вызывается валидатор, поэтому нужно заполнить массив, если он пуст в теле операции
	if not bDoDu and [MT_SEC_OSTS]%size(1) = 0 then		
		if (bDoDil and bExistsSvuDeal) or (bDoBrok and bExistsSvuBrok) then
			bDeal := bDoDil and bExistsSvuDeal;
			bBrok := bDoBrok and bExistsSvuBrok;
			
			[LIB_SALDO].svu_fill_ost_arrays_new(this, bDeal, bBrok);
		end if;
		
		if not (bDoDil and bExistsSvuDeal) or not (bDoBrok and bExistsSvuBrok) then
			bDeal := bDoDil and not bExistsSvuDeal;
			bBrok := bDoBrok and not bExistsSvuBrok;
			
			[LIB_SALDO].fill_ost_arrays_new(this, bDeal, bBrok);
		end if;
	end if;

	--Попытка установить блокировку
	if bSaldoBuh then
		buh_svu_lock := buh_svu_lock || '_BUH';
	end if;
	
	if bSaldoSvu then
		buh_svu_lock := buh_svu_lock || '_SVU';
	end if;
	
	::[DAYDOCS].[TRY_LOCK](this.[DO_DIL], this.[DO_BROK], this.[DO_DU], 'DD_SALDO' || buh_svu_lock, true);

	prod_date := this.[DATE_BEGINING];
	oper := this.[OPER].[NEW#AUTO](::[TYPE_OPER_NS]([CODE] = 'DD_SALDO'), prod_date); -- вставляем новую запись в массив "Операция по договору ЦБ"	
	
	::[STOCK].[MSG].dmess('Обработка документов дня. Сальдовые проводки. За ' || to_char(prod_date, 'dd/mm/yyyy'));
	::[STOCK].[MSG].dmess('Формировать бухгалтерские документы по расчетам с биржей = ' || case when bSaldoBuh then 'Да' else 'Нет' end);
	::[STOCK].[MSG].dmess('Формировать документы СВУ по расчетам с биржей = ' || case when bSaldoSvu then 'Да' else 'Нет' end);
	::[STOCK].[MSG].dmess('Формировать сальдовые проводки для доверительного управления = ' || case when bDoDu then 'Да' else 'Нет' end);
	::[STOCK].[MSG].dmess('Включено СВУ по доверительному управлению = ' || case when bExistsSvuDu then 'Да' else 'Нет' end);
	::[STOCK].[MSG].dmess('Включено СВУ по ЭЦБ = ' || case when bExistsSvu then 'Да' else 'Нет' end);
	::[STOCK].[MSG].dmess('Включено СВУ по дилерским ЭЦБ = ' || case when bExistsSvuDeal then 'Да' else 'Нет' end);
	::[STOCK].[MSG].dmess('Включено СВУ по брокерским ЭЦБ = ' || case when bExistsSvuBrok then 'Да' else 'Нет' end);

	set_nulls;

	-- Время периода "Окончание торгов". Для СВУ эмиссионки и ДУ одинаково
	V_DATE_TIME := ::[SVU_DAY_PERIODS]([CODE] = 'STOP_TRADING').[BEG_TIME];
	V_OPER_TIME := V_DATE_TIME - trunc(V_DATE_TIME);		

	/*=============================================================================
	ОПРЕДЕЛЕНИЕ сальдовых счетов биржевых секций и площадок
	=============================================================================*/		
	if bDoDu then
		folder 		:= get_new_folder_pay(prod_date, this);
		folder_svu 	:= get_new_folder_pay(prod_date, this);
		
		::[DAYDOCS].[ALIB].calc_saldo_accs_du(prod_date);
		::[DAYDOCS].[ALIB].fill_bd_ac_sec_du(P_BAS_DOC);
		
		-- Обнуление расчетов по итогам операции
		::[DAYDOCS].[OBNUL_DU](	prod_date,
								this,
								oper,
								folder,
								folder_svu,
								V_OPER_TIME,
								P_BAS_DOC
								);

		if folder_svu is not null then
			if folder_svu.[DOCS_IN_FOLD]%size(1) > 0 then -- включенность СВУ_ДУ не проверяем, т.к. если оно выключено - папка должна быть пустой
				--Проставляет папку с документами в операцию, корректирует даты документов на дату prod_date
				--P_EXACT_DATE=true, значит время проводок не будет заменено на 23:59:59, а останется собственным!
				::[SDELKA].[ADD_DOCS_EXP](oper, folder_svu, null, prod_date, false, true/*P_EXACT_DATE*/);
				::[DAYDOCS].[DOCS_SUM_SVU](oper);
			else
				::[FP_INTERFACE].[PRX_FOLDER_PAY].DELETE#AUTO(folder_svu);
			end if;
		end if;
	else
		if bSaldoBuh then
			folder := get_new_folder_pay(prod_date, this);
			
			::[DAYDOCS].[ALIB].calc_saldo_accs(prod_date, this, bDoDil, bDoBrok);		
			-- Башкиров В.Г. 009.12.2025 патч 25.6.01
			--::[DAYDOCS].[ALIB].fill_bd_ac_sec_new(P_BAS_DOC);
			--Заполнить Первичные учетные документы операции		
			v_method_str:='DAYDOCS.PROCESS_SALDO';	--&METHOD$CLASS||'.'||&METHOD$SNAME;	
			::[DAYDOCS].[ALIB].fill_bd_ac_sec_new(prod_date, null, v_method_str, P_BAS_DOC);
	
			::[DAYDOCS].[PSH_OBNUL].bd_tbl := P_BAS_DOC; -- updated CHANGE_SHORT_NAME PSB_OBNUL->PSH_OBNUL 15/10/25
			--AND Новое решение. По аналогии с СВУ
			-- Обнуление расчетов по итогам операции
			::[DAYDOCS].[PSH_OBNUL](prod_date, -- updated CHANGE_SHORT_NAME PSB_OBNUL->PSH_OBNUL 15/10/25
								this,
								oper,
								folder
								);
			
			if folder.[DOCS_IN_FOLD]%size(1) > 0 then
				--Проставляет папку с документами в операцию, корректирует даты документов на дату prod_date
				::[SDELKA].[ADD_DOCS_EXP](oper, folder, null, prod_date);	
			else
				::[FP_INTERFACE].[PRX_FOLDER_PAY].DELETE#AUTO(folder);
			end if;					
		end if;
		
		-- если есть СВУ, то нужно сформировать проводки по СВУ счетам
		if bSaldoSvu and ((bDoDil and bExistsSvuDeal) or (bDoBrok and bExistsSvuBrok)) then
			folder_svu := get_new_folder_pay(prod_date, this);
			
			bDeal := bDoDil and bExistsSvuDeal;
			bBrok := bDoBrok and bExistsSvuBrok;
			::[DAYDOCS].[ALIB].calc_saldo_accs_svu(prod_date, bDeal, bBrok);
			
			---------
			if [STOCK].[MSG].is_debug then
				declare
					i pls_integer;
				begin		
					&dmess('Содержимое ::[DAYDOCS].[ALIB].svu_sec.first');
					
					i := ::[DAYDOCS].[ALIB].svu_sec.first;
					while i is not null loop
						&dmess_var1(i);
						&dmess_var1(::[DAYDOCS].[ALIB].svu_sec(i).MARKET);
						&dmess_var1(::[DAYDOCS].[ALIB].svu_sec(i).MT_SEC);
						&dmess_var1(::[DAYDOCS].[ALIB].svu_sec(i).DOG_SUBCL);
						
						&dmess_var1(::[DAYDOCS].[ALIB].svu_sec(i).SALDO);
						&dmess_var1(::[DAYDOCS].[ALIB].svu_sec(i).KOMIS);
						&dmess_var1(::[DAYDOCS].[ALIB].svu_sec(i).BUY);
						&dmess_var1(::[DAYDOCS].[ALIB].svu_sec(i).SELL);
						&dmess_var1(::[DAYDOCS].[ALIB].svu_sec(i).GASH_OBL_SUM);
						&dmess_var1(::[DAYDOCS].[ALIB].svu_sec(i).GASH_COUP_SUM);
						i := ::[DAYDOCS].[ALIB].svu_sec.next(i);
					end loop;
				end;
			end if;
			-----------		
			
			-- Обнуление расчетов по итогам операции для СВУ
			::[DAYDOCS].[OBNUL_SVU](	prod_date,
										this,
										oper,
										folder_svu,
										bDeal,
										bBrok,
										V_OPER_TIME
									);
									
			if folder_svu is not null then									
				if folder_svu.[DOCS_IN_FOLD]%size(1) > 0 then
					--Проставляет папку с документами в операцию, корректирует даты документов на дату prod_date
					--P_EXACT_DATE=true, значит время проводок не будет заменено на 23:59:59, а останется собственным!
					::[SDELKA].[ADD_DOCS_EXP](oper, folder_svu, null, prod_date, false, true);
					::[DAYDOCS].[DOCS_SUM_SVU](oper);
				else
					::[FP_INTERFACE].[PRX_FOLDER_PAY].DELETE#AUTO(folder_svu);
				end if;
			end if;
		end if;
	end if;									
				
	set_nulls;

	--Попытка снять блокировку
	::[DAYDOCS].[TRY_LOCK](this.[DO_DIL], this.[DO_BROK], this.[DO_DU], 'DD_SALDO' || buh_svu_lock, false);

	::[STOCK].[MSG].umess('Обработка документов дня. Сальдовые проводки. За ' || to_char(prod_date, 'dd/mm/yyyy') || '. Обработка завершена.');
exception
	when ::[RUNTIME].[MESSAGE].APP_EXCEPTION or NO_DATA_FOUND or TOO_MANY_ROWS then
		-- сброс переменных
		set_nulls;

		::[STOCK].[MSG].umess('ВЫПОЛНЕНИЕ ПРЕРВАНО. Ошибка:' || chr(10) || sqlerrm);
		::[STOCK].[MSG].umess(NL$ || '-----------------------------------' || NL$ || [UTILS].error_stack(true) || '-----------------------------------');
		--Попытка снять блокировку
		::[DAYDOCS].[TRY_LOCK](this.[DO_DIL], this.[DO_BROK], this.[DO_DU], 'DD_SALDO' || buh_svu_lock, false);
		raise;
end;
end;
end;
