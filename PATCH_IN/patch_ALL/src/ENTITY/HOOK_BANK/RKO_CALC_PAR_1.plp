		  	   AND MD.[SUM_KSPL].[1].[1] NOT IN ('40','41','42') --,'54'
		  	   AND SYSDATE > MD.[ASTR_DATE_PROV]+(60/86400)*5
		  	   and MD%state='PROV'
		)
     LOOP
         SUM_DEN := MD.SUM_KSPL;
 	 END LOOP;
   ELSIF P_PAR = 'СУММА_РАСЧ_ЗП_СТИП' THEN
  	FOR (SELECT MD(
                   SUM(MD.[SUM_KSPL].[2]) : SUM_KSPL
		  	      )
		 IN [MAIN_DOCUM]
		 WHERE TRUNC(MD.[DATE_PROV]) = TRUNC(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
		  	   AND MD.[ACC_KT].[MAIN_USV].[NUM] = '20202'
		  	   AND MD.[SUM_KSPL].[1].[1] IN ('40','41')
		  	   AND SYSDATE > MD.[ASTR_DATE_PROV]+(60/86400)*5
		  	   and MD%state='PROV'
		)
     LOOP
         SUM_DEN := MD.SUM_KSPL;
 	 END LOOP;   	 	
   END IF;
    RETURN NVL(SUM_DEN,0);
END;	


function GET_SUM_COMIS_DN(RKO ref [RKO], P_PAR VARCHAR2(100)) return [SUMMA] is
rk1 			ref [RKO];
today 			[DATE];
SUMA                [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_DOC            [SUMMA] := 0;            -- СУММА ДОКУМЕНТА
SUM_DEN             [SUMMA] := 0;            -- СУММА СНЯТИЙ ЗА ДЕНЬ ПО СЧЕТУ
SUM_COMIS           [SUMMA] := 0;            -- СУММА КОМИССИЙ ЗА ДЕНЬ ПО СЧЕТУ
mn_ref ref [MAIN_DOCUM];
begin
&OpDate;
    IF P_PAR = 'СУММА_РАСЧ_КОМИС_ЮР_ИНЫЕ' THEN
	  	FOR (SELECT MD(
	                    MD                  : ID
	                   ,MD.[DOCUMENT_NUM]   : DOCUMENT_NUM
			  	      )
			 IN [MAIN_DOCUM]
			 WHERE TRUNC(MD.[DATE_PROV]) = TRUNC(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
			  	   AND MD.[ACC_KT].[MAIN_USV].[NUM] = '20202'
			  	   AND MD.[SUM_KSPL].[1].[1] NOT IN ('40','41','42') --,'54'
			)
	     LOOP
	         FOR (SELECT D(
	                       D.[SUMMA]  :SUMA
	                      )
	              IN [DOC_COM_JOUR] ALL
	              WHERE RKO.[ARRAY_OPER_DOG] = D%COLLECTION AND D.[FIRST_DOC] = MD.ID
	             )
	         LOOP
	              SUM_COMIS := NVL(SUM_COMIS,0) + D.SUMA;
	         END LOOP;
	 	 END LOOP;
    END IF;
    RETURN NVL(SUM_COMIS,0);
END;

-->> PSB VRI 18/06/2025 CFT-1761 Получение суммы переводов физикам за текущий календарный месяц
public function get_sum_to_fl(v_acc ref [AC_FIN], my_acc varchar2(1) default '0') 
return [SUMMA] is
v_summ [SUMMA];
begin
	for (select am(sum(coalesce(am.[DOC].[SUM_NT], 0)) sm)
			in v_acc.[ARC_MOVE]
			where am.[DT]
				and am.[DATE] >= to_date(trunc(::[SYSTEM].[OP_DATE], 'MM'))
				and am.[DATE] < ::[SYSTEM].[OP_DATE] + 1
				and am.[SUMMA] > 0
				and am.[DOC]%STATE = 'PROV'
				and am.[DOC].[PRIORITET] = 5
				and not (upper(am.[DOC].[NAZN]) like '%ЗАДАТКА%' or upper(am.[DOC].[NAZN]) like '%ЗАДАТОК%')
				and (   substr(am.[DOC].[KL_KT].[2].[1],            1,5) in ('40817','40820','42301','42302','42303','42304','42305','42306','42601','42602','42603','42604','42605','42606') 
					 or substr(am.[DOC].[KL_KT].[1].[2].[MAIN_V_ID],1,5) in ('40817','40820','42301','42302','42303','42304','42305','42306','42601','42602','42603','42604','42605','42606')
					 or substr(am.[DOC].[ACC_KT].[MAIN_V_ID],       1,5) in ('40817','40820','42301','42302','42303','42304','42305','42306','42601','42602','42603','42604','42605','42606')
					) 
				and (
					   	 (my_acc = '0' 
					   	  and
						    (
						   	   v_acc.[CLIENT_V]->(CL_ORG)[PS_REF] not in (::[PS]([PS_CODE]='F_П'),::[PS]([PS_CODE]='F_Ч'))
							   or	
							   not (am.[DOC].[KL_KT].[1].[1] = ::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]) or
								    am.[DOC].[KL_KT].[1].[2].[CLIENT_V] = ::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]) or
							 	    am.[DOC].[KL_KT].[2].[INN] = ::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]).[INN] or
							  Upper(am.[DOC].[KL_KT].[2].[2]) = Upper(::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]).[NAME]) or
				   stdlib.FIO(Upper(am.[DOC].[KL_KT].[2].[2])) = stdlib.FIO(Upper(::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]).[NAME])))
							)
				    	  )
					   or 
					   	  (	   my_acc = '1' and
							   (am.[DOC].[KL_KT].[1].[1] = ::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]) or
							    am.[DOC].[KL_KT].[1].[2].[CLIENT_V] = ::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]) or
						 	    am.[DOC].[KL_KT].[2].[INN] = ::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]).[INN] or
						  Upper(am.[DOC].[KL_KT].[2].[2]) = Upper(::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]).[NAME]) or
			   stdlib.FIO(Upper(am.[DOC].[KL_KT].[2].[2])) = stdlib.FIO(Upper(::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(v_acc.[CLIENT_V]).[NAME])))
				    	  )
					)
		)
	loop
		v_summ := am.sm;
	end loop;
	return coalesce(v_summ, 0); 
end;
--<< PSB VRI 18/06/2025 CFT-1761 Комиссии по РКО по переводам физикам

-->> PSH VRI 24/11/2025 CFT-2894 Начисление %% на остаток по счету ЮЛ
public function get_st_nalog(v_cl ref [CLIENT]) 
return number is
v_prc_sh	ref [PRC_SCHEME];
v_prc_st	number;
begin
	v_prc_sh :=::[FP_TUNE].[LIB].get_ref_value('TAX_RATE', ::[FP_TUNE].[LIB].set_canons('<TAX_NAME>', 'НПО', '<TAX_OBJECT>', 'НПО_ИО_СЧ')); 
	if v_prc_sh is not null then
		v_prc_st := ::[PRC_SCHEME].[LIB].GetPrcRate(v_prc_sh, ::[SYSTEM].[OP_DATE]);
	end if;

	return coalesce( ::[PROPERTIES].[L].GetStr(v_cl.[ADD_PROP],::[PROPERTY_GRP]([CODE]='PSH_NALOG_ST_NEREZ')), v_prc_st, 0);
end;
--<< PSH VRI 24/11/2025 CFT-2894 Начисление %% на остаток по счету ЮЛ

RKO_CALC_PAR_1 (
	@name('Параметр') P_PAR  in [STRING_50],
	@name('Документ') P_DOC  in [DOCUMENT_REF],
	@name('Продукт')  P_PROD in [A_PROD_REF],
	@name('Шаблон')   P_PATT in [STRING_32000]
) return [MEMO] is

execute is
pragma INCLUDE( [SYSTEM]::[DEFINES] );

rk1 			ref [RKO];
md1 			ref [MAIN_DOCUM];
md2 			[MAIN_DOCUM];	
today 			[DATE];
tar_pl 			::[TARIF_PLAN].[CODE]%type default 'Нет';
FFPP			string(4);
VO		    	string(10);
col_dog			integer default 0;
val				ref [DIC_INT_CUR];
V_IS            boolean := FALSE;
SUMA_BP             [SUMMA] := 0;            -- СУММА БАЗНАЛИЧНЫХ ПОСТ УПЛЕНИЙ
SUMA_PRED           [SUMMA] := 0;            -- СУММА ПРЕДЫДУЩИХ СНЯТИЙ ЗА ПОСЛЕДНИЕ 30 ДНЕЙ
SUMA                [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_DOC            [SUMMA] := 0;            -- СУММА ДОКУМЕНТА
SUM_DEN             [SUMMA] := 0;            -- СУММА СНЯТИЙ ЗА ДЕНЬ ПО СЧЕТУ
SUM_MONTH           [SUMMA] := 0;            -- СУММА СНЯТИЙ ЗА месяц ПО СЧЕТУ
SUMA_SH1            [SUMMA] := 149999;       -- СУММА ПО ШКАЛЕ №1
SUMA_SH2            [SUMMA] := 599999;       -- СУММА ПО ШКАЛЕ №2
SALDO               [SUMMA] := 0;            -- ВХОДЯЩИЙ ОСТАТОК ПО СЧЕТУ КЛИЕНТА
SALDO_MID           [SUMMA] := 0;            -- СРЕДНЕДНЕВНОЙ ОСТАТОК
SUMA_IN_NAL_RUB     [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_IN_BN_RUB      [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_OUT_NAL_RUB    [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
SUMA_OUT_BN_RUB     [SUMMA] := 0;            -- РАСЧЕТНАЯ СУММА
OUR_SWIFT           INTEGER := 0;
----------------  филиал шкала по юрикам
SUMA_FIL_SH1        [SUMMA] := 1500000;       -- СУММА ПО ШКАЛЕ №1
SUMA_FIL_SH2        [SUMMA] := 3000000;       -- СУММА ПО ШКАЛЕ №2
SUMA_FIL_SH3        [SUMMA] := 5000000;       -- СУММА ПО ШКАЛЕ №3

SUMA_SH_FIL			[SUMMA] := 100000;

SUMA_SH_FILN        [SUMMA] := 149999.99;  -- для выдачи наличных физикам с 01.12.2015
SUMA_SH_FILN1       [SUMMA] := 599999.99;  -- для выдачи наличных физикам с 01.12.2015

SUMA_GOL_BEZ_COM    [SUMMA] := 10000;         -- СУММА ВЫДАЧ, НА КОТОРЫЕ НЕ РАССЧИТЫВАЕТСЯ КОМИССИЯ
SUM_ZAYAV_SAL       [SUMMA] := 0;            -- СУММА ЗАЯВКИ НА ЗП И СТИПЕНДИИ ПО СЧЕТУ НА ОПЕР. ДЕНЬ
SUM_ZAYAV           [SUMMA] := 0;            -- СУММА ЗАЯВКИ ПО СЧЕТУ НА ОПЕР. ДЕНЬ
SUMAKS              [SUMMA] := 0;            -- СУММА ПО КАС. СИМВ.

SUM_COMIS           [SUMMA] := 0;            -- СУММА КОМИССИЙ ЗА ДЕНЬ ПО СЧЕТУ
PSH_SUMA            [SUMMA] := 0;
PSH_RES            [SUMMA] := 0;

P_HOUR              [INTEGER] := 0;
P_MIN               [INTEGER] := 0;
P_SS                [INTEGER] := 0;

PSH_VID_MD     REF [NAME_PAYDOC];
PSH_ACC_DT_MD  REF  [AC_FIN];

mn_ref ref [MAIN_DOCUM];
doc_rc ref [DOCUM_RC];

vacc ref [AC_FIN];
cd	string;
dtt date;
dtt2 date;
dta date;
--knp ref [KOD_N_PAY];
knp1 ref [KOD_N_PAY];
knp2 ref [KOD_N_PAY];
DOC_REF REF [MAIN_DOCUM];
MD REF [MAIN_DOCUM];
sprav_podp ref [PSH_PODP_3352U]; -- Справочник подписантов 3352-У
KASSIR_OD ref [USER]; -- Кассир с ценностями

SUMA_IN             [SUMMA] := 0;            -- Входящий остаток
SUMA_DT             [SUMMA] := 0;            -- ДТ за день
SUMA_KT             [SUMMA] := 0;            -- КТ за день
ins number;
--dtx time;

type mndc_a is
	select dt(
		sum(DECODE(dt.[SUM], 0, 0, 1))	: COUNT_DOC,
		sum(dt.[SUM])					: SUMMA
	)
	in [MAIN_DOCUM] all
	where
	dt.[ACC_DT] = vacc
	and dt.[ACC_KT].[MAIN_V_ID] like '30102%'
	and dt.[DATE_PROV] >= dtt
	and dt.[DATE_PROV] < dtt+1
	and dt.[ASTR_DATE_PROV] <= dta
	and dt%state = 'PROV'
	order by dt.[ASTR_DATE_PROV]
;

type mndc_kas is
	select dc(
		dc			: dc,
		dc.[SUM]	: SM
	)
	in [MAIN_DOCUM] all
	where
	dc.[ACC_DT] = vacc
	and dc.[ACC_KT].[MAIN_V_ID] like '20202%'
	and dc.[DATE_PROV] >= dtt
	and dc.[DATE_PROV] < dtt+1
	and dc%state = 'PROV'
	order by dc.[ASTR_DATE_PROV]
;

type mndc_b is
	select dt(
		dt			: dt,
		dt.[SUM]	: SM
	)
	in [MAIN_DOCUM]
	where
	dt.[ACC_DT] = vacc
	and dt.[ACC_KT].[MAIN_V_ID] like '20202%'
	and dt.[DATE_PROV] >= dtt2
	and dt.[DATE_PROV] < dtt+1
	and dt.[ASTR_DATE_PROV] <= dta
	and dt%state = 'PROV'
	order by dt.[ASTR_DATE_PROV]
;

type mndc_c is
	select dt(
		sum(DECODE(dt.[SUM], 0, 0, 1))	: COUNT_DOC,
		sum(dt.[SUM])					: SUMMA
	)
	in [MAIN_DOCUM]
	where
	(dt.[ACC_DT] = vacc or dt.[ACC_KT] = vacc)
	and dt.[DATE_PROV] >= dtt
	and dt.[DATE_PROV] < dta+1
	and dt%state = 'PROV'
	--and dt.[KOD_NAZN_PAY] <> knp
	--and (dt.[KOD_NAZN_PAY] is null or dt.[KOD_NAZN_PAY] <> knp)
	and (dt.[KOD_NAZN_PAY] is null or (dt.[KOD_NAZN_PAY] <> knp1 and dt.[KOD_NAZN_PAY] <> knp2))
	order by dt.[ASTR_DATE_PROV]
;

RKO 		REF [RKO];
N           INTEGER;
CNT         NUMBER := 0;

--V-- Башкиров В.Г. 17.09.2019 Приводим функционал в порядок. Делаем так, чтобы была возможность включить отладку
varRet  [MEMO];
timeStart number;

mdTmp ref [MAIN_DOCUM];
FolderPay ref [FOLDER_PAY];
md_tmp ref [MAIN_DOCUM];
fl_not_kom boolean;
refTypeSumma ref [SUM_GUIDE];
AcTmpRef ref [AC_FIN];
AcDtRef ref [AC_FIN];
AcKtRef ref [AC_FIN];
AcDtNum [ACCNUM];
AcKtNum [ACCNUM];
AcS_Num [ACCNUM];
AcR_Num [ACCNUM];
AcR_NumTmp [ACCNUM];
ClRef ref [CLIENT];
ClOrgRef ref [CL_ORG];
ClPrivRef ref [CL_PRIV];

oMd [MAIN_DOCUM];	--Башкиров В.Г. 20.01.2023
md3 ref [MAIN_DOCUM];
oMd3 [MAIN_DOCUM];
md4 ref [MAIN_DOCUM];
oMd4 [MAIN_DOCUM];
UserProvMainDoc ref [USER];
PsbDocUser boolean; --Пользователь-создатель документа комиссии-пользователь, проведший основной документ

BusinessOpDocRef ref [MAIN_DOCUM];
oBusinessOpDocRef ref [MAIN_DOCUM];

AccountDepn ref [AC_FIN];
refRko ref [RKO];

d_Val [DATE];
d_Registr [DATE];
date_begin [DATE];
date_end [DATE];

nPSH_OUT_DOC number; --Башкиров В.Г. 13.03.2024 PSH_OUT_DOC-[ПСБ] Трактовка дебетования счета (0 - Дт-р/c  Кт-любой, 1 - Дт-р/c  Кт-3%)

--Башкиров В.Г. 20.08.2024
dCalc [DATE_TIME];
today_timestamp [TIMESTAMP];
vCommentCalc [MEMO];
s200 string(200);
BEGIN
	timeStart:=utils.get_time; --Башкиров В.Г. 25.05.2017 Для расчета времени выполнения HOOKa
	&debug('-> P_PAR->'||P_PAR||' P_DOC='||P_DOC%class||'.'||P_DOC%id||'.'||P_DOC%state||' P_PROD='||P_PROD%class||'.'||P_PROD%id||'.'||P_PROD.[COM_STATUS].[CODE]||' '||P_PROD%class||' P_PATT='||P_PATT||' Старт:'||to_char(sysdate,'hh24:mm:ss'),dp)
	&debug('P_DOC>'||::[HOOK_BANK].[RKO_CALC_PAR_1].InfoDoc(P_DOC),dp)
	::[HOOK_BANK].[RKO_CALC_PAR_1].DbpBusinessOp(1,&EnableDebug(&METHOD$CLASS,&METHOD$SNAME)='1');
	
	--Башкиров В.Г. 27.07.2015 Устранена цикличность вызовов
	if InStr(utils.call_stack,'IBS.Z$HOOK_BANK_RKO_CALC_PAR_1'||Chr(13)||Chr(10),1,2)>0 then -- 13-CR,10-LF
		&debug(utils.call_stack,dp)
		&debug('Повторный вызов. Выходим',dp)
		return null;
	end if;

-----------------
	--Башкиров В.Г. 23.08.2016 документ вычисляю до расчета Вычисляемый параметров
	if P_DOC%class='MAIN_DOCUM' then
		md:=P_DOC;
		&debug('Платежку получили из P_DOC',dp)
	--02.03.2012 Башкиров В.Г. перепишем. Будем искать документ для удержания комиссии, где только можно
	elsif ::[PATTERN_DOC].[BUSINESS_OP].doc_ref	is not null and ::[PATTERN_DOC].[BUSINESS_OP].doc_ref%class='MAIN_DOCUM' then
		md:=::[PATTERN_DOC].[BUSINESS_OP].doc_ref;
		&debug('Платежку получили из ::[PATTERN_DOC].[BUSINESS_OP].doc_ref',dp)
	elsif instr(P_PATT, '~DOC_RKO~') > 0 then	--
		var md_id number:=[STR].get_str_par(P_PATT, 'DOC_RKO');
		for md_rko in ::[MAIN_DOCUM] where md_rko%id=md_id loop
			md:=md_rko;
			&debug('Платежку нашли по доп.параметру DOC_RKO',dp)
			exit;
		end loop;
	elsif P_DOC%class='FOLDER_PAY' then
		FolderPay:=P_DOC;
		for fp in FolderPay.[DOCS_IN_FOLD] where fp.[DOCUMENT]%class='MAIN_DOCUM' order by fp.[DOCUMENT]%id loop
			md_tmp:=fp.[DOCUMENT];
			if md_tmp.[ACC_DT].[TO_PRODUCT].[CODE] in ('RKO','RKO_CUR') or
			   md_tmp.[ACC_KT].[TO_PRODUCT].[CODE] in ('RKO','RKO_CUR')
			then
				fl_not_kom:=true;
				/** / --Башкиров В.Г. 18.09.2019 По одной платежке может быть несколько комиссий
				for dcj in ::[DOC_COM_JOUR] all where dcj.[FIRST_DOC]=md_tmp and dcj%parentclass in ('RKO','RKO_CUR') loop
					fl_not_kom:=false;
					exit;
				end loop;
				/**/
				if fl_not_kom then
					if md is null then
						md:=md_tmp;
						&debug('Нашли единственную Платежку в переданной папке по которой возможно нужно удержать комиссию',dp)
					else
						md%id:=null;
						&debug('Не удалось однозначно найти MAIN_DOCUM в папке для удержания комисии РКО',dp)
						exit;				
					end if;
				end if;
			end if;
		end loop;
	end if;

	if md is not null then
		oMd:=md; --Башкиров В.Г. 20.01.2023
		if FolderPay is null then
		   FolderPay:=md.[IN_FOLDER];
		end if;
		AcDtRef :=md.[ACC_DT]; AcDtNum :=AcDtRef.[MAIN_V_ID]; AcS_Num :=coalesce(md.[KL_DT].[2].[1], md.[KL_DT].[1].[2].[MAIN_V_ID], md.[ACC_DT].[MAIN_V_ID]);
		AcKtRef :=md.[ACC_KT]; AcKtNum :=AcKtRef.[MAIN_V_ID]; AcR_Num :=coalesce(md.[KL_KT].[2].[1], md.[KL_KT].[1].[2].[MAIN_V_ID], md.[ACC_KT].[MAIN_V_ID]);
	end if;
-----------------
	&debug(TB$||'[01]',dp5)
	
		/*UNIMP.Reset;
		UNIMP.fMess := stdio.open(UNIMP.PathToFile, 'RKO_CALC_PAR_1' || '_msg', 'w');
		UNIMP.WriteMess(lpad(to_char(sysdate, 'DD/MM/YYYY   HH24:MI:SS'),78), 0);
		UNIMP.WriteMess(P_PAR||' '||'-' , 0);
		stdio.close(UNIMP.fMess);
		*/
		
	-- Для операции возмещения по мерчанту ------ Кокорин АС 18.09.15
	-- НП: Отражение суммы возмещения по операциям ( шт.) с платежными картами для [PSH_MERCHANT_NAME] (сумма комиссии -[PSH_MERCH_KOMISS])
	If P_PAR = 'PSH_MERCHANT_NAME' then -- Наименование мерчанта для документа возмещения
		varRet:= nvl(P_DOC->(MAIN_DOCUM)[KL_KT].[1].[1].[NAME],P_DOC->(MAIN_DOCUM)[KL_KT].[2].[2]); goto nnn;
	end if;

	If P_PAR = 'PSH_OUT_DOC' then
		if P_PROD%CLASS IN ('RKO','RKO_CUR') then
			refRko := P_PROD;
		end if;
		
		nPSH_OUT_DOC:=nvl(::[FP_TUNE].[LIB].get_num_value('PSH_OUT_DOC', null, 0),1);
		&debug('nPSH_OUT_DOC='||nPSH_OUT_DOC,dp)
		&debug('P_PROD '||P_PROD,dp)
		&debug('md '||md,dp)

		if nPSH_OUT_DOC=0 then --Башкиров В.Г. 13.03.2024 PSH_OUT_DOC-[ПСБ] Трактовка дебетования счета (0 - Дт-р/c  Кт-любой, 1 - Дт-р/c  Кт-3%)
			if md.[ACC_DT] = refRko.[ACCOUNT] then  
				&debug('Возвращаем 1',dp)
				return '1';
			else
				&debug('Возвращаем 0',dp)
				return '0';
			end if;
		else
			if md.[ACC_DT] = refRko.[ACCOUNT] and md.[ACC_KT].[MAIN_V_ID] = refRko.[ACCOUNT] like '3%' then
				&debug('Возвращаем 1',dp)
				return '1';
			else
				&debug('Возвращаем 0',dp)
				return '0';
			end if;
		end if;
	end if;

	
	If P_PAR = 'PSH_MERCH_KOMISS' then -- Сумма комиссии за эквайринг по мерчанту за день
		declare sum_kom [SUMMA] := 0;
		begin
			for vip_doc in P_DOC->(MAIN_DOCUM)[ACC_DT].[ARC_MOVE] where trunc(vip_doc.[DATE]) = trunc(P_DOC->(MAIN_DOCUM)[DATE_VAL]) and UPPER(vip_doc.[DOC]->(MAIN_DOCUM)[NAZN]) like '%КОМИС%' loop		
				sum_kom := nvl(sum_kom,0) + nvl(vip_doc.[SUMMA_NAT],0);
			end loop;
			varRet:= sum_kom||' руб.'; goto nnn;
		end;	
	end if;
	--------------------------------------------
	
	IF P_PAR like 'ПСБ_3352У%' and (P_DOC%state !='PROV' or P_DOC->(MAIN_DOCUM)[VID_DOC].[CODE]='КАСС_ВАЛ_ОРД') THEN -- Подписи кассовых документов по 3352-У
	sprav_podp:= null;
	KASSIR_OD:= null;
	
		begin
		select x (x) in ::[PSH_PODP_3352U] where x.[USER]=::[RUNTIME].[STDLIB].UserId into sprav_podp;
					exception
					when NO_DATA_FOUND then	sprav_podp:= null;
					when TOO_MANY_ROWS then sprav_podp:= null;
		end;
		
		if sprav_podp is null then
			begin
			select x (x) in ::[PSH_PODP_3352U] where (x.[KASSA]=P_DOC->(MAIN_DOCUM)[NUM_KS].[KASSA] or x.[KASSA]=P_DOC->(MAIN_DOCUM)[NUM_KS1].[KASSA]) and nvl(x.[USER],0)=0 into sprav_podp;
						exception
						when NO_DATA_FOUND then	sprav_podp:= null;
						when TOO_MANY_ROWS then	sprav_podp:= null;
			end;		
		end if;

				
		if sprav_podp is not null then
			if sprav_podp.[CENNOST_KASSIR] then
				 if P_DOC->(MAIN_DOCUM)[ACC_KT].[MAIN_V_ID] like ('20202%') then
				 				begin
				 				select x(x.[USER]) in ::[RICHES_GUIDE] where x.[CERT].[ACCOUNT]=P_DOC->(MAIN_DOCUM)[ACC_KT] into KASSIR_OD;
				 						exception
										when NO_DATA_FOUND then	KASSIR_OD:= null;
										when TOO_MANY_ROWS then	KASSIR_OD:= null;
				 				end;
				 elsif P_DOC->(MAIN_DOCUM)[ACC_DT].[MAIN_V_ID] like ('20202%') then null;
				 				begin
				 				select x(x.[USER]) in ::[RICHES_GUIDE] where x.[CERT].[ACCOUNT]=P_DOC->(MAIN_DOCUM)[ACC_DT] into KASSIR_OD;
				 						exception
										when NO_DATA_FOUND then	KASSIR_OD:= null;
										when TOO_MANY_ROWS then	KASSIR_OD:= null;
				 				end;
				 else KASSIR_OD := null;
				 end if;
			end if;
			-->> PSB VRI 09/06/2025 CFT-1546 Подписи сотрудников на кассовых документах
			if 		P_PAR = 'ПСБ_3352У_SOZDAT_FIO' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62'
			then varRet := nvl(sys_context(user_context, 'P_ISPOLNIT_PRINT_FIO'),CHR(13)); goto nnn; 
			
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_DOL' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62' 
			then varRet := nvl(sys_context(user_context, 'P_ISPOLNIT_PRINT_DOLZN'),CHR(13)); goto nnn;
			
			elsif 	P_PAR = 'ПСБ_3352У_KONTR_FIO' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62' 
			then varRet := nvl(sys_context(user_context, 'P_KONTROL_PRINT_FIO'),CHR(13)); goto nnn;
			
			elsif 	P_PAR = 'ПСБ_3352У_KONTR_DOL' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62' 
			then varRet := nvl(sys_context(user_context, 'P_KONTROL_PRINT_DOLZN'),CHR(13)); goto nnn;

			elsif 	P_PAR = 'ПСБ_3352У_KASS_FIO' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62' 
			then varRet := nvl(sys_context(user_context, 'P_KASSIR_PRINT_FIO'),CHR(13)); goto nnn;
			
			elsif 	P_PAR = 'ПСБ_3352У_KASS_DOL' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62' 
			then varRet := nvl(sys_context(user_context, 'P_KASSIR_PRINT_DOLZN'),CHR(13)); goto nnn;
			--<< PSB VRI 09/06/2025 CFT-1546 Подписи сотрудников на кассовых документах
			
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_FIO' and sprav_podp.[NOT_SOZDAT] then varRet:= chr(13); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_FIO' and nvl(sprav_podp.[NOT_SOZDAT],false) = false and sprav_podp.[SOZDAT] is not null then varRet:= nvl(::[RUNTIME].[STDLIB].FIO(sprav_podp.[SOZDAT].[NAME]),CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_FIO' and nvl(sprav_podp.[NOT_SOZDAT],false) = false and sprav_podp.[SOZDAT] is null then varRet:= nvl(::[RUNTIME].[STDLIB].FIO(P_DOC.[DOCUMENT_USER].[NAME]),CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_DOL' and sprav_podp.[NOT_SOZDAT] then varRet:= chr(13); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_DOL' and nvl(sprav_podp.[NOT_SOZDAT],false) = false and sprav_podp.[SOZDAT] is not null then varRet:= nvl(sprav_podp.[SOZDAT].[CASTA].[VALUE],CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_DOL' and nvl(sprav_podp.[NOT_SOZDAT],false) = false and sprav_podp.[SOZDAT] is null then varRet:= nvl(P_DOC.[DOCUMENT_USER].[CASTA].[VALUE],CHR(13)); goto nnn;

			elsif 	P_PAR = 'ПСБ_3352У_KONTR_FIO' and sprav_podp.[NOT_KONTROL] then varRet:= chr(13); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KONTR_FIO' and nvl(sprav_podp.[NOT_KONTROL],false) = false then varRet:= nvl(::[RUNTIME].[STDLIB].FIO(sprav_podp.[KONTROL].[NAME]),CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KONTR_DOL' and sprav_podp.[NOT_KONTROL] then varRet:= chr(13); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KONTR_DOL' and nvl(sprav_podp.[NOT_KONTROL],false) = false then varRet:= nvl(sprav_podp.[KONTROL].[CASTA].[VALUE],CHR(13)); goto nnn;

			elsif 	P_PAR = 'ПСБ_3352У_KASS_FIO' and sprav_podp.[NOT_KASSIR] then varRet:= chr(13); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KASS_FIO' and sprav_podp.[CENNOST_KASSIR] then varRet:= nvl(::[RUNTIME].[STDLIB].FIO(KASSIR_OD.[NAME]),CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KASS_FIO' and nvl(sprav_podp.[NOT_KASSIR],false) = false then varRet:= nvl(::[RUNTIME].[STDLIB].FIO(sprav_podp.[KASSIR].[KASSIR].[NAME]),CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KASS_DOL' and sprav_podp.[NOT_KASSIR] then varRet:= chr(13); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KASS_DOL' and sprav_podp.[CENNOST_KASSIR] then varRet:= nvl(KASSIR_OD.[CASTA].[VALUE],CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KASS_DOL' and nvl(sprav_podp.[NOT_KASSIR],false) = false then varRet:= nvl(sprav_podp.[KASSIR].[KASSIR].[CASTA].[VALUE],CHR(13)); goto nnn;
			end if;
		else
			if 		P_PAR = 'ПСБ_3352У_SOZDAT_FIO' then varRet:= nvl(::[RUNTIME].[STDLIB].FIO(P_DOC.[DOCUMENT_USER].[NAME]),CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_DOL' then varRet:= nvl(P_DOC.[DOCUMENT_USER].[CASTA].[VALUE],CHR(13)); goto nnn;

			elsif 	P_PAR = 'ПСБ_3352У_KONTR_FIO' then varRet:= chr(13); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KONTR_DOL' then varRet:= chr(13); goto nnn;

			elsif 	P_PAR = 'ПСБ_3352У_KASS_FIO' then varRet:= chr(13); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KASS_DOL' then varRet:= chr(13); goto nnn;
			end if;			
		end if;
		
	elsif P_PAR like 'ПСБ_3352У%' and P_DOC%state ='PROV' THEN
			-->> PSB VRI 09/06/2025 CFT-1546 Подписи сотрудников на кассовых документах
			if 		P_PAR = 'ПСБ_3352У_SOZDAT_FIO' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62'
			then varRet := nvl(sys_context(user_context, 'P_ISPOLNIT_PRINT_FIO'),CHR(13)); goto nnn; 
			
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_DOL' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62' 
			then varRet := nvl(sys_context(user_context, 'P_ISPOLNIT_PRINT_DOLZN'),CHR(13)); goto nnn;
			
			elsif 	P_PAR = 'ПСБ_3352У_KONTR_FIO' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62' 
			then varRet := nvl(sys_context(user_context, 'P_KONTROL_PRINT_FIO'),CHR(13)); goto nnn;
			
			elsif 	P_PAR = 'ПСБ_3352У_KONTR_DOL' 
				and ::[RUNTIME].[STDLIB].FIO(P_DOC.[DEPART].[CODE]) <> '001-62' 
			then varRet := nvl(sys_context(user_context, 'P_KONTROL_PRINT_DOLZN'),CHR(13)); goto nnn;
			--<< PSB VRI 09/06/2025 CFT-1546 Подписи сотрудников на кассовых документах

			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_FIO' then varRet:= chr(13); --nvl(::[RUNTIME].[STDLIB].FIO(P_DOC.[DOCUMENT_USER].[NAME]),CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_SOZDAT_DOL' then varRet:= chr(13); --nvl(P_DOC.[DOCUMENT_USER].[CASTA].[VALUE],CHR(13)); goto nnn;

			elsif 	P_PAR = 'ПСБ_3352У_KONTR_FIO' then varRet:= chr(13); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KONTR_DOL' then varRet:= chr(13); goto nnn;

			elsif 	P_PAR = 'ПСБ_3352У_KASS_FIO' then varRet:= nvl(::[RUNTIME].[STDLIB].FIO(P_DOC->(MAIN_DOCUM)[PROV_USER].[NAME]),CHR(13)); goto nnn;
			elsif 	P_PAR = 'ПСБ_3352У_KASS_DOL' then varRet:= nvl(P_DOC->(MAIN_DOCUM)[PROV_USER].[CASTA].[VALUE],CHR(13)); goto nnn;
			end if;				
			
	end if;

	&debug(TB$||'[02]',dp5)

	 -- Возвращает тип клиента: 'Ф' - физ. лицо, 'Ю' - юр. лицо
     IF P_PAR = 'НОМ_ДОГОВОРА' THEN
        IF P_PROD%CLASS IN ('RKO','RKO_CUR') then
		   rko := P_PROD;
        END IF;
        --Башкиров В.Г. 26.09.2019 Исправлена ошибка расчета 'НОМ_ДОГОВОРА'
        -- IF RKO.[FILIAL].[CODE] = '001' THEN
           N := 1;
			&debug(' RKO.[CLIENT]%CLASS='||RKO.[CLIENT]%CLASS||' RKO.[CONTRACT_CUR].[CODE_ISO]='||RKO.[CONTRACT_CUR].[CODE_ISO],0)
			IF RKO.[CLIENT]%CLASS = 'CL_PRIV' THEN
			     --CNT := NUM_RKO_JUR.NEXTVAL;
	           IF RKO.[CONTRACT_CUR].[CODE_ISO] = '643' THEN
		          varRet:= 'ФЛ-'||N||'-'||nvl(RKO.[CONTRACT_CUR].[CODE_ACC],'643')||'/'||rtl.next_value('SEQ_APP_32511533'); goto nnn;
	           ELSE
	              varRet:= 'ФЛ-'||N||'-'||RKO.[CONTRACT_CUR].[CODE_ISO]||'/'||rtl.next_value('SEQ_APP_32511533'); goto nnn;
	           END IF;
			ELSE
	           IF RKO.[CONTRACT_CUR].[CODE_ISO] = '643' THEN
		          varRet:= 'ЮЛ-'||N||'-'||nvl(RKO.[CONTRACT_CUR].[CODE_ACC],'643')||'/'||rtl.next_value('SEQ_APP_32511532'); goto nnn;
	           ELSE
	              varRet:= 'ЮЛ-'||N||'-'||RKO.[CONTRACT_CUR].[CODE_ISO]||'/'||rtl.next_value('SEQ_APP_32511532'); goto nnn;
	           END IF;
			END IF;
        -- ELSE
        --    N := 3;
		-- 	IF RKO.[CLIENT]%CLASS = 'CL_PRIV' THEN
		-- 	   &debug('VALUTA => '||RKO.[CONTRACT_CUR],dp)
		-- 	     --CNT := NUM_RKO_JUR.NEXTVAL;
	    --        IF RKO.[CONTRACT_CUR].[CODE_ISO] = '643' THEN
		--           varRet:= 'ФЛ-'||N||'-'||RKO.[CONTRACT_CUR].[CODE_ACC]||'/'||rtl.next_value('SEQ_APP_32511538'); goto nnn;
	    --        ELSE
	    --           varRet:= 'ФЛ-'||N||'-'||RKO.[CONTRACT_CUR].[CODE_ISO]||'/'||rtl.next_value('SEQ_APP_32511538'); goto nnn;
	    --        END IF;
		-- 	ELSE
	    --        IF RKO.[CONTRACT_CUR].[CODE_ISO] = '643' THEN
		--           varRet:= 'ЮЛ-'||N||'-'||RKO.[CONTRACT_CUR].[CODE_ACC]||'/'||rtl.next_value('SEQ_APP_32511535'); goto nnn;
	    --        ELSE
	    --           varRet:= 'ЮЛ-'||N||'-'||RKO.[CONTRACT_CUR].[CODE_ISO]||'/'||rtl.next_value('SEQ_APP_32511535'); goto nnn;
	    --        END IF;
		-- 	END IF;
        -- END IF;
     ELSIF P_PAR = 'НОМЕР_ДОГ_ВАЛ' THEN
        IF P_PROD%CLASS IN ('RKO','RKO_CUR') then
		   rko := P_PROD;
			IF RKO.[CLIENT]%CLASS = 'CL_PRIV' THEN
                varRet:= 'ФЛ-'||RKO.[CONTRACT_CUR].[CODE_ISO]||'/'||rtl.next_value('SEQ_APP_32514450'); goto nnn;
			ELSE
	            varRet:= 'ЮЛ-'||RKO.[CONTRACT_CUR].[CODE_ISO]||'/'||rtl.next_value('SEQ_APP_32514454'); goto nnn;
			END IF;
        END IF;
     END IF;

--------------------------  Еврокомм ------------
	&debug(TB$||'[03]',dp5)

	&debug('bal_acc='||bal_acc,dp)
	::[PATTERN_DOC].[LIB].write_debug(&method$||' P_PAR='||P_PAR||' P_DOC='||P_DOC%id||' '||P_DOC%class||' P_PROD='||P_PROD%id||' '||P_PROD%class||' P_PATT='||P_PATT);
	if P_PROD%class like 'RKO%' then
		rk1%id := P_PROD%id;
	end if;

	&debug(TB$||'[03.1]',dp5)
	begin
		locate md1 in ::[MAIN_DOCUM] where md1%id = [STR].get_num_par(P_PATT, 'DOC_RKO');
	exception when NO_DATA_FOUND then
		if P_DOC%class = 'MAIN_DOCUM' then
			md1%id := P_DOC%id;
		elsif P_DOC%class = 'FOLDER_PAY' then
			for x in P_DOC->([FOLDER_PAY])[DOCS_IN_FOLD] where x.[DOCUMENT]%class = 'MAIN_DOCUM'
				and (x.[DOCUMENT]->([MAIN_DOCUM])[KOD_NAZN_PAY].[KOD_NAZN] not like 'РКО_КОМИССИЯ%'
					or x.[DOCUMENT]->([MAIN_DOCUM])[KOD_NAZN_PAY] is null)
			loop
				md1%id := x.[DOCUMENT]%id;
				exit;
			end loop;
		end if;
	end;

	&debug(TB$||'[03.2]',dp5)

	md2 := ::[PATTERN_DOC].[BUSINESS_OP].mdoc;
	if nvl(md2.[SUM], 0) <= 0 then
		md2 := md1;
	end if;	

	&debug(TB$||'[03.3]',dp5)
	
	--Башкиров В.Г. 19.09.2019 Проблема с печатью документа ID:1514508280
	--if rk1 is null then varRet:= null;  goto nnn;end if;

	&debug(TB$||'[03.4]',dp5)

	if P_PAR = 'КОЛ_ДОК' then
		varRet:= to_char(::[RKO_INTERFACE].[PRX_DOCUMENT].BO_GET_KOL_DOC);		 goto nnn;
	end if;
	if P_PAR = 'КОД_ВО' then
       if P_DOC%class = 'FOLDER_PAY' then
			for x in P_DOC->([FOLDER_PAY])[DOCS_IN_FOLD] where x.[DOCUMENT]%class = 'MAIN_DOCUM'
		    loop
				md1%id := x.[DOCUMENT]%id;
				exit;
			end loop;
		end if;
		vo := md1.[CURR_OPER].[HIGH].[CODE]||md1.[CURR_OPER].[CODE];
		varRet:= nvl(vo,'EMPTY');		 goto nnn;
	end if;		
	&debug(TB$||'[04]',dp5)

	-- ************************************************************************************
	-- Параметры, вычисляемые исходя из договора РКО***********************************
	if P_PROD%class in ('RKO','RKO_CUR', 'TRC') then
		rko := P_PROD;	
		
		if P_PAR = 'FIL_CODE' then
			varRet:= RKO.[FILIAL].[CODE]; goto nnn;
		end if;	
		-- Еврокоммерц
		-- Возвращает '1',  если в выписке по расчетному счету договора РКО есть записи за последний месяц (считая от даты
		-- операционного дня), либо '0' в противном случае
		if P_PAR = 'ОПЕР_ПР_М' then --
			&OpDate;
			for m in rko.[ACCOUNT].[ARC_MOVE] where
			m.[DATE] >= trunc(today,'MM') and
			m.[DATE] <= trunc(today) loop
				varRet:= '1'; goto nnn;
			end loop;
			varRet:= '0'; goto nnn;
		elsif P_PAR = 'ВВЕД_СЧ_ОТС_ИНИЦ_КЛ' then --
			&OpDate;
			&debug('rko.[ACCOUNT].[ARC_MOVE] =>'||rko.[ACCOUNT].[ARC_MOVE],dp)
			for m in rko.[ACCOUNT].[ARC_MOVE] where
		    	m.[DATE] >= trunc(today,'MM') and
			    m.[DATE] <= last_day(today)
			    and m.[DOC]%class = 'MAIN_DOCUM'
				and not(	m.[DOC]->([MAIN_DOCUM])[DOCUMENT_NUM] = '777'
							and lower(m.[DOC]->([MAIN_DOCUM])[NAZN]) like '%перенос%'
				)
				and m.[DOC]->([MAIN_DOCUM])[ACC_KT].[MAIN_USV].[NUM] not in ('70601')
				and m.[DOC]->([MAIN_DOCUM])[VID_DOC].[CODE] not in ('БЕЗН_ИНКАСС_ПОР')
			loop
				varRet:= '1'; goto nnn;
			end loop;
			varRet:= '0';	 goto nnn;
		elsif P_PAR = 'КЛБ_СМС_ИНФО' then
			&OpDate;
			select t(count (t)) in rko.[CLIENT].[ADD_PROP] where t.[GROUP_PROP]=::[PROPERTY_GRP]([CODE] = 'SMS_IBANK2') and (t.[DATE_END] is null or t.[DATE_END]>=trunc(today,'MM')) and t.[DATE_BEG]<=last_day(today) into ins;
			if ins=0 then varRet:= '0'; goto nnn;
			else varRet:= '1'; goto nnn;
			end if;		
		-- Возвращает дату операционного  дня
		elsif P_PAR = 'ДАТА_ОПД' then
		    &OpDate;
			varRet:= to_char(today,'DD/MM/YYYY'); goto nnn;
		elsif P_PAR = 'МЕСЯЦ_ПЕРИОДА' then
			&OpDate;
			varRet:= to_char(today,'MONTH YYYY');								 goto nnn;
		elsif P_PAR = 'ВВЕД_СЧ_КЛБАНК_М' then --
			&OpDate;
			for m in rko.[ACCOUNT].[ARC_MOVE] where
		    	today <= m.[DATE] and m.[DATE] <= last_day(today)
			    and m.[DOC]%class = 'MAIN_DOCUM'
				and ((m.[DOC]->([MAIN_DOCUM])[KOD_NAZN_PAY].[KOD_NAZN] like 'CLIENT_BANK%')
				or (m.[DOC]->([MAIN_DOCUM])[DT_SEND] = ::[RKC_DOC_STATES]([CODE]='IBANK2')))
			loop
				varRet:= '1'; goto nnn;
			end loop;
			varRet:= '0';	 goto nnn;
		elsif P_PAR = 'ВВЕД_СЧ_КЛ' then --
		&debug('rko.[ACCOUNT].[ARC_MOVE] =>'||rko.[ACCOUNT].[ARC_MOVE],dp)
			&OpDate;
			for m in rko.[ACCOUNT].[ARC_MOVE] where
			  --trunc(today,'MM')<=m.[DATE]
			    ::[RUNTIME].[DATEFUN].bom(today) <= m.[DATE] and m.[DATE] <= last_day(today)
			    and m.[DOC]%class = 'MAIN_DOCUM'
			    and (m.[DOC]->([MAIN_DOCUM])[KOD_NAZN_PAY] is null or m.[DOC]->([MAIN_DOCUM])[KOD_NAZN_PAY].[KOD_NAZN]<>'РКО_КОМИССИЯ')
			loop
				varRet:= '1'; goto nnn;
			end loop;
			varRet:= '0';				 goto nnn;
		elsif P_PAR = 'ВВЕД_СЧ_СВ_КЛ_КЛБ' then --
		    varRet:= ::[CLIENT].[PSH_LIB].IsClientBank(rko.[CLIENT]);				 goto nnn;
		elsif P_PAR = 'ТАРИФ_ПОВЫШ' then -- с даты регистрации которых на момент открытия счета прошло менее 3-х месяцев, применяется в течение первых 3-х месяцев
		        IF P_PROD%CLASS IN ('RKO','RKO_CUR') then
		   		rko := P_PROD;
        		END IF;
        		&OpDate;
				if trunc(rko.[CLIENT]->(CL_ORG)[REGISTER].[DATE_REG]) >= trunc(add_months(rko.[DATE_BEGINING], -3))
					and rko.[DATE_BEGINING] is not null
					and rko.[CLIENT]->(CL_ORG)[REGISTER].[DATE_REG] is not null
					and trunc(last_day(add_months(rko.[DATE_BEGINING],-1))+1) > trunc(last_day(add_months(today, -4)))
					and P_PROD%CLASS ='RKO'
				then varRet:= '1'; goto nnn;
				else varRet:= '0'; goto nnn;
				END IF;
		elsif P_PAR = 'ПРОВЕРКА_КЛБАНК' then --
			&OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
            if mn_ref->([MAIN_DOCUM])[KOD_NAZN_PAY].[KOD_NAZN] like 'CLIENT_BANK%' or
               mn_ref->([MAIN_DOCUM])[DT_SEND] = ::[RKC_DOC_STATES]([CODE]='IBANK2')
            then
                BEGIN
	                SELECT V(TO_NUMBER(TO_CHAR(V.TIME, 'HH24')), TO_NUMBER(TO_CHAR(V.TIME, 'MI')), TO_NUMBER(TO_CHAR(V.TIME, 'SS')))
	                IN OBJECT_STATE_HISTORY%ROWTYPE
	                WHERE V.OBJ_ID = mn_ref AND v.STATE_ID = 'FORM'
	                ORDER BY V.ID DESC
	                INTO P_HOUR, P_MIN, P_SS;
			    EXCEPTION
			        WHEN NO_DATA_FOUND THEN
			             P_HOUR := TO_NUMBER(TO_CHAR(SYSDATE, 'HH24'));
			             P_MIN  := TO_NUMBER(TO_CHAR(SYSDATE, 'MI'));
			             P_SS   := TO_NUMBER(TO_CHAR(SYSDATE, 'SS'));
			        WHEN TOO_MANY_ROWS THEN
			             P_HOUR := TO_NUMBER(TO_CHAR(SYSDATE, 'HH24'));
			             P_MIN  := TO_NUMBER(TO_CHAR(SYSDATE, 'MI'));
			             P_SS   := TO_NUMBER(TO_CHAR(SYSDATE, 'SS'));
                END;

                --Кокорин АС 22.11.2016 в связи с переходом Саратова в другой часовой пояс
                declare	difference integer;
                begin
	              --if mn_ref.[DOCUMENT_DATE] > [FP_TUNE]::[LIB].get_date_value('PSH_SAR_TIME_ZONE_CHANGE') and mn_ref.[FILIAL].[CODE]='101' then
	                if mn_ref.[DOCUMENT_DATE] > [FP_TUNE]::[LIB].get_date_value('PSH_SAR_TIME_ZONE_CHANGE') and mn_ref.[DEPART].[CODE]='001-61' then
	                	difference := 1; --nvl(::[SYSTEM].[VARIABLES].OurBranch.[DIFFERENCE],0);
	                	/** /
			          --IF P_HOUR < 16-difference AND P_MIN <= 59 AND P_SS <= 59    THEN --04:59:59-1=03:59:59
			          	IF P_HOUR < 17-difference AND P_MIN <= 29 AND P_SS <= 29    THEN --17:29:29-1=16:29:29
							varRet:= '1';	goto nnn;
			            ELSE
							varRet:= '2';	goto nnn;
			            END IF;
			            /**/
	                else
                		difference := 0;	
	                end if;
		            IF P_HOUR < 16-difference AND P_MIN <= 59 AND P_SS <= 59  THEN
						varRet:= '1';	 goto nnn;
		            ELSIF P_HOUR >= 17-difference AND P_MIN >= 0 AND P_SS >= 0 THEN
		            	varRet:= '1'; goto nnn;
		            ELSIF P_HOUR >= 16-difference AND P_MIN >= 0 AND P_SS >= 0 AND P_HOUR < 17-difference AND P_MIN <= 59 AND P_SS <= 59 THEN
						varRet:= '2';						 				 goto nnn;
		            END IF;
	
                end;
	
            end if;
			varRet:= '0';		 goto nnn;
		elsif P_PAR = 'ИСКЛ_НАЛОГ' then --
			&OpDate;
			begin
			mn_ref:=coalesce(::[PATTERN_DOC].[BUSINESS_OP].doc_ref,md,mn_ref,P_DOC); --Башкиров В.Г. 19.09.2019
			if substr(nvl(mn_ref.[KL_KT].[2].[1], mn_ref.[KL_KT].[1].[2].[MAIN_V_ID]),1,3) not in ('401', '402', '403', '404', '031') then
			  varRet:= 1; goto nnn;
			end if;
			exception when NO_DATA_FOUND then
				   varRet:= '0'; goto nnn;
		    end;
				varRet:= '0';				 goto nnn;
		elsif P_PAR = 'ПРОВЕРКА_СЧ_КТ' then --
			&OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
			if mn_ref->([MAIN_DOCUM])[ACC_KT].[MAIN_V_ID] not like '70601%'
              -- and mn_ref->([MAIN_DOCUM])[VID_DOC].[CODE] = 'БЕЗН_ПЛ_ПОРУЧ'
 -- Кокорин АС 15.07.14 За платежный ордер тоже берем
 -- Кокорин АС 20.10.15 И за остальные тоже берем
              and mn_ref->([MAIN_DOCUM])[VID_DOC].[CODE]  IN ('БЕЗН_ПЛ_ПОРУЧ', 'БЕЗН_ПЛ_ОР', 'БЕЗН_ПЛ_ТРЕБ', 'БЕЗН_ИНКАСС_ПОР', 'ЗАЯВ_АККРЕД')
              and (mn_ref->([MAIN_DOCUM])[DOC_SEND_REF] is null or mn_ref->([MAIN_DOCUM])[DOC_SEND_REF].[COD] != '4')
               --and mn_ref->([MAIN_DOCUM])[DOC_SEND_REF].[COD] != '4'
-- Кокорин АС 10.07.14 для корректного расчета комиссии по импортированным докментам. у них  BUDGET_PAYMENT = null
               --and mn_ref->([MAIN_DOCUM])[BUDGET_PAYMENT] != 1
               and nvl(mn_ref->([MAIN_DOCUM])[BUDGET_PAYMENT],false) != true
------------------------------------------------------------------------------------------------------------------
            then
                BEGIN
	                SELECT V(TO_NUMBER(TO_CHAR(V.TIME, 'HH24')), TO_NUMBER(TO_CHAR(V.TIME, 'MI')), TO_NUMBER(TO_CHAR(V.TIME, 'SS')))
	                IN OBJECT_STATE_HISTORY%ROWTYPE
	                WHERE V.OBJ_ID = mn_ref AND v.STATE_ID = 'FORM'
	                ORDER BY V.ID DESC
	                INTO P_HOUR, P_MIN, P_SS;
			    EXCEPTION
			        WHEN NO_DATA_FOUND THEN
			             P_HOUR := TO_NUMBER(TO_CHAR(SYSDATE, 'HH24'));
			             P_MIN  := TO_NUMBER(TO_CHAR(SYSDATE, 'MI'));
			             P_SS   := TO_NUMBER(TO_CHAR(SYSDATE, 'SS'));
			        WHEN TOO_MANY_ROWS THEN
			             P_HOUR := TO_NUMBER(TO_CHAR(SYSDATE, 'HH24'));
			             P_MIN  := TO_NUMBER(TO_CHAR(SYSDATE, 'MI'));
			             P_SS   := TO_NUMBER(TO_CHAR(SYSDATE, 'SS'));
                END;

                --Кокорин АС 22.11.2016 в связи с переходом Саратова в другой часовой пояс
                declare	difference integer;
                begin
	                if mn_ref.[DOCUMENT_DATE] > [FP_TUNE]::[LIB].get_date_value('PSH_SAR_TIME_ZONE_CHANGE') and mn_ref.[FILIAL].[CODE]='101' then
	                	difference := nvl(::[SYSTEM].[VARIABLES].OurBranch.[DIFFERENCE],0);
	                else
	                	difference := 0;	
	                end if;
	
		            IF P_HOUR < 16-difference AND P_MIN <= 59 AND P_SS <= 59  THEN
						varRet:= '1';	 goto nnn;
		            ELSIF P_HOUR >= 17-difference AND P_MIN >= 0 AND P_SS >= 0 THEN
		            	varRet:= '1'; goto nnn;
		            ELSIF P_HOUR >= 16-difference AND P_MIN >= 0 AND P_SS >= 0 AND P_HOUR < 17-difference AND P_MIN <= 59 AND P_SS <= 59 THEN
						varRet:= '2';						 				 goto nnn;
		            END IF;
                end;
            end if;
			varRet:= '0';		 goto nnn;
		elsif P_PAR = 'ПРОВЕРКА_СЧ_КТ_ГОЛ' then --
			&OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
            if mn_ref->([MAIN_DOCUM])[ACC_KT].[MAIN_V_ID] not like '70601%'
               and mn_ref->([MAIN_DOCUM])[VID_DOC].[CODE] IN ('БЕЗН_ПЛ_ПОРУЧ', 'БЕЗН_ПЛ_ОР', 'БЕЗН_ПЛ_ТРЕБ', 'БЕЗН_ИНКАСС_ПОР', 'ЗАЯВ_АККРЕД')
            then
				varRet:= '1'; goto nnn;
            end if;
			varRet:= '0';				 goto nnn;
		elsif P_PAR = 'ВИД_ПЕРЕСЫЛКИ' then --
			&OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
            if mn_ref->([MAIN_DOCUM])[ACC_KT].[MAIN_V_ID] not like '70601%'
               and mn_ref->([MAIN_DOCUM])[VID_DOC].[CODE] IN ('БЕЗН_ПЛ_ПОРУЧ', 'БЕЗН_ПЛ_ОР', 'БЕЗН_ПЛ_ТРЕБ', 'БЕЗН_ИНКАСС_ПОР', 'ЗАЯВ_АККРЕД')
               and (mn_ref->([MAIN_DOCUM])[DOC_SEND_REF]  is not null and mn_ref->([MAIN_DOCUM])[DOC_SEND_REF].[COD] = '4')
               --and mn_ref->([MAIN_DOCUM])[DOC_SEND_REF].[COD] = 4
            then
                BEGIN
	                SELECT V(TO_NUMBER(TO_CHAR(V.TIME, 'HH24')), TO_NUMBER(TO_CHAR(V.TIME, 'MI')), TO_NUMBER(TO_CHAR(V.TIME, 'SS')))
	                IN OBJECT_STATE_HISTORY%ROWTYPE
	                WHERE V.OBJ_ID = mn_ref AND v.STATE_ID = 'FORM'
	                ORDER BY V.ID DESC
	                INTO P_HOUR, P_MIN, P_SS;
			    EXCEPTION
			        WHEN NO_DATA_FOUND THEN
			             P_HOUR := TO_NUMBER(TO_CHAR(SYSDATE, 'HH24'));
			             P_MIN  := TO_NUMBER(TO_CHAR(SYSDATE, 'MI'));
			             P_SS   := TO_NUMBER(TO_CHAR(SYSDATE, 'SS'));
			        WHEN TOO_MANY_ROWS THEN
			             P_HOUR := TO_NUMBER(TO_CHAR(SYSDATE, 'HH24'));
			             P_MIN  := TO_NUMBER(TO_CHAR(SYSDATE, 'MI'));
			             P_SS   := TO_NUMBER(TO_CHAR(SYSDATE, 'SS'));
                END;

                --Кокорин АС 22.11.2016 в связи с переходом Саратова в другой часовой пояс
                declare	difference integer;
                begin
	                if mn_ref.[DOCUMENT_DATE] > [FP_TUNE]::[LIB].get_date_value('PSH_SAR_TIME_ZONE_CHANGE') and mn_ref.[FILIAL].[CODE]='101' then
	                	difference := nvl(::[SYSTEM].[VARIABLES].OurBranch.[DIFFERENCE],0);
	                else
	                	difference := 0;	
	                end if;
	
		            IF P_HOUR < 16-difference AND P_MIN <= 59 AND P_SS <= 59  THEN
						varRet:= '1';	 goto nnn;
		            ELSIF P_HOUR >= 17-difference AND P_MIN >= 0 AND P_SS >= 0 THEN
		            	varRet:= '1'; goto nnn;
		            ELSIF P_HOUR >= 16-difference AND P_MIN >= 0 AND P_SS >= 0 AND P_HOUR < 17-difference AND P_MIN <= 59 AND P_SS <= 59 THEN
						varRet:= '2';						 				 goto nnn;
		            END IF;
                end;
            end if;
			varRet:= '0';	 goto nnn;
		elsif P_PAR = 'СУММА_ДОК' then --
			&OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
            if mn_ref->([MAIN_DOCUM])[SUM] <= 1500000
            then
				varRet:= 1; goto nnn;
            elsif mn_ref->([MAIN_DOCUM])[SUM] >= 1500001 and mn_ref->([MAIN_DOCUM])[SUM] <=3000000 then
                varRet:= 2; goto nnn;
            elsif mn_ref->([MAIN_DOCUM])[SUM] >= 3000001 and mn_ref->([MAIN_DOCUM])[SUM] <=5000000 then
                varRet:= 3; goto nnn;
            elsif mn_ref->([MAIN_DOCUM])[SUM] >= 5000001 then
                varRet:= 4; goto nnn;
            end if;
			varRet:= '0';		 goto nnn;
		elsif P_PAR = 'КАСС_СИМВ_ЗВ_КОМ' then --
			if CASH_SYM is null /*and main_ref is not null*/ then
				declare
					ksim ref [SUM_SYMKS];
				begin	
				    &OpDate;
					mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019			
			        locate ksim in mn_ref.[SUM_KSPL];
					CASH_SYM := ksim.[1].[1];
				exception when NO_DATA_FOUND then
					varRet:= '0'; goto nnn;
				end;
			end if;
			if CASH_SYM in (40, 41, 42, 44, 50)
			then
			     varRet:= '1'; goto nnn;
			end if;
			varRet:= '0';		 goto nnn;
         ELSIF P_PAR = 'ДРОРГ_0445' then
			&OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
		    IF MN_REF.[ACC_KT].[MAIN_USV].[NUM] IN ('30102', '47408') AND MN_REF.[VID_DOC].[CODE] IN ('БЕЗН_ПЛ_ПОРУЧ', 'БЕЗН_ПЛ_ОР', 'БЕЗН_ПЛ_ТРЕБ', 'БЕЗН_ИНКАСС_ПОР', 'ЗАЯВ_АККРЕД') THEN
		       varRet:= 1; goto nnn;
		    ELSE
		       varRet:= 0; goto nnn;
		    END IF;
		
		    /*
		       IF mn_ref.[KL_KT].[2].[3].[BIC] IS NOT NULL THEN
                IF mn_ref.[KL_KT].[2].[3].[BIC] IN ('044579771', '046375892') THEN  --AND (SUBSTR(MD.[KL_KT].[2].[1],1,5) IN (40817, 40820) OR SUBSTR(MD.[KL_KT].[2].[1],1,3) IN ('423','426')) THEN
                   varRet:= 0; goto nnn;
                ELSE
                   varRet:= 1; goto nnn;
                END IF;	
		       ELSE
                varRet:= 0;													 goto nnn;
		       END IF;*/
		elsif P_PAR = 'ОПЕР_ОБОР_ДН' then --
			&OpDate;
			SUM_DEN := 0; SUMA := 0;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
			SUMA := MN_REF.[SUM];		
		  	for (select MD(
		  	               SUM(MD.[SUM_KSPL].[2]) : SUM_KSPL
		  	             )
		  	     in [MAIN_DOCUM]
		  	     where trunc(MD.[DATE_PROV]) = trunc(today) AND MD.[ACC_DT] = RKO.[ACCOUNT]
		  	           AND MD.[ACC_KT].[MAIN_USV].[NUM] = '20202'
		  	           AND MD.[SUM_KSPL].[1].[1] NOT IN (40, 41, 42, 44, 50)
		  	    )
		  	loop
                SUM_DEN := MD.SUM_KSPL;
			end loop;
			IF SUM_DEN IS NOT NULL THEN
               SUMA := SUMA + NVL(SUM_DEN,0);
			END IF;		 	
			   varRet:= SUMA; goto nnn;
		elsif P_PAR = 'СУММА_ДОКУМ' then --
			&OpDate;
			SUM_DEN := 0; SUMA := 0;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019	
			SUMA := MN_REF.[SUM];	
			varRet:= SUMA;			   		 goto nnn;
		elsif P_PAR = 'ОБОР_ДН_БЕЗН' then --
			&OpDate;
			SUM_DEN := 0; SUMA := 0;		
		  	for (select MD(
		  	               SUM(MD.[SUM]) : SUM_DOC
		  	              )
		  	     in [MAIN_DOCUM]
		  	     where trunc(MD.[DATE_PROV]) >= trunc(today)-30 and trunc(MD.[DATE_PROV]) <= trunc(today)
		  	           AND MD.[ACC_KT] = RKO.[ACCOUNT]
		  	           and MD.[VID_DOC].[TYPE_DOC].[CODE] not like 'KASSA_DOCUM%'
		  	    )
		  	loop
                SUM_DEN := MD.SUM_DOC;
			end loop;
			IF SUM_DEN IS NOT NULL THEN
               varRet:= NVL(SUM_DEN,0); goto nnn;
			END IF;		 	
			   varRet:= 0; goto nnn;
		elsif P_PAR = 'ОБОР_ДН_КАС' then --
			&OpDate;
			SUM_DEN := 0; SUMA := 0;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019	
			SUMA := MN_REF.[SUM];		
		  	for (select MD(
		  	               SUM(MD.[SUM]) : SUM_DOC
		  	             )
		  	     in [MAIN_DOCUM]
		  	     where trunc(MD.[DATE_PROV]) = trunc(today) AND MD.[ACC_DT] = RKO.[ACCOUNT]
		  	           AND MD.[ACC_KT].[MAIN_USV].[NUM] = '20202'
		  	    )
		  	loop
                SUM_DEN := MD.SUM_DOC;
			end loop;
			IF SUM_DEN IS NOT NULL THEN
               SUMA := SUMA + NVL(SUM_DEN,0);
			END IF;		 	
			   varRet:= SUMA;	 goto nnn;
		ELSIF P_PAR = 'ПРОВЕРКА_СВИФТ' then --
			&OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
		    OUR_SWIFT := GET_SUM_FROM_RC(mn_ref);
            IF OUR_SWIFT = 1 THEN    --Если определен документ РЦ и комиссия OUR = 0
				varRet:= '1'; goto nnn;
            ELSIF OUR_SWIFT = 2 THEN   --Если определен документ РЦ и комиссия BEN = 1
                varRet:= '2'; goto nnn;
            END IF;
			varRet:= '0';				 goto nnn;
------------------ ПСХБ РАСЧЕТ СУММЫ ПО ШКАЛЕ
		ELSIF P_PAR = 'СУММА_РАСЧ_КОМ' THEN
		   &OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
	       SUMA_DOC := mn_ref.[SUM];  -- СУММА ДОКУМЕНТА
	
        	FOR (SELECT MD(
			  	          SUM(MD.[SUM]) : SUM_DOC
			  	         )
			  	IN [MAIN_DOCUM]
			  	WHERE trunc(MD.[DATE_PROV]) = trunc(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
			  	      AND MD.[ACC_KT].[MAIN_USV].[NUM] in ('20202')
			  	)
		   LOOP
	            SUM_DEN := MD.SUM_DOC;
		   END LOOP;
		 -- ----------
		  IF SUM_DEN IS NOT NULL THEN
	          SUMA := SUMA_DOC + NVL(SUM_DEN,0);
		   ELSE
		      SUMA := SUMA_DOC;
		   END IF;
		
		   SUMA_BP := GET_SUM_SCALE(RKO);
		  ------------------------   КОНЕЦ --------------------------------------------------
	       IF SUMA_BP > 0 AND SUM_DEN IS NOT NULL THEN
	          IF SUMA <= SUMA_SH1 AND SUMA_BP >= SUMA_DOC THEN
	             varRet:= SUMA_DOC; goto nnn;
	          ELSIF SUMA <= SUMA_SH1 AND SUMA_BP < SUMA_DOC AND SUM_DEN IS NULL THEN
	             SUMA := SUMA_BP;
	          ELSIF SUMA <= SUMA_SH1 AND SUMA_BP < SUMA_DOC AND SUM_DEN IS NOT NULL THEN
	             SUMA := SUMA_BP - NVL(SUM_DEN,0);
	          END IF;
	          IF SUMA > SUMA_SH1 AND SUMA_BP >= SUMA_SH1 THEN
	             SUMA := SUMA_SH1 - NVL(SUM_DEN,0);
	             IF SUMA > 0 THEN
	                varRet:= SUMA; goto nnn;
	             ELSE
	                SUMA := 0;
	                varRet:= SUMA; goto nnn;
	             END IF;
	          ELSIF SUMA > SUMA_SH1 AND SUMA_BP < SUMA_SH1 THEN
	             SUMA := SUMA_BP - NVL(SUM_DEN,0);
	             IF SUMA > 0 THEN
	                varRet:= SUMA; goto nnn;
	             ELSE
	                varRet:= 0; goto nnn;
	             END IF;
	          END IF;
	       END IF;		
	       IF SUMA_BP >= SUMA_DOC AND SUMA_DOC <= SUMA_SH1 THEN
	          varRet:= SUMA_DOC;			   	 goto nnn;
	       ELSIF SUMA_BP >= SUMA_DOC AND SUMA_DOC > SUMA_SH1 THEN
	          varRet:= SUMA_BP; goto nnn;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC <= SUMA_SH1 THEN
	          varRet:= SUMA_BP;	 goto nnn;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC > SUMA_SH1 THEN
	          IF SUMA_BP <= SUMA_SH1 THEN
	             varRet:= SUMA_BP; goto nnn;
	          ELSE
	             varRet:= SUMA_SH1;	 goto nnn;
	          END IF;	
	       END IF;
	       varRet:= 0; goto nnn;
------------------  КОНЕЦ РАСЧЕТА СУММЫ ПО ШКАЛЕ	
		ELSIF  P_PAR = 'СУММА_РАСЧ_КОМ2' THEN
		   &OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
	       SUMA_DOC := mn_ref.[SUM];  -- СУММА ДОКУМЕНТА
	
        	FOR (SELECT MD(
			  	          SUM(MD.[SUM]) : SUM_DOC
			  	         )
			  	IN [MAIN_DOCUM]
			  	WHERE trunc(MD.[DATE_PROV]) = trunc(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
			  	      AND MD.[ACC_KT].[MAIN_USV].[NUM] in ('20202')
			  	)
		   LOOP
	            SUM_DEN := MD.SUM_DOC;
		   END LOOP;
		 -- ----------
		  IF SUM_DEN IS NOT NULL THEN
	          SUMA := SUMA_DOC + NVL(SUM_DEN,0);
		   ELSE
		      SUMA := SUMA_DOC;
		   END IF;
		
		   SUMA_BP := GET_SUM_SCALE(RKO);
		  ------------------------   КОНЕЦ --------------------------------------------------
	       IF SUMA_BP > 0 AND SUM_DEN IS NOT NULL THEN
	          IF SUMA > SUMA_SH1 AND SUMA <= SUMA_SH2 AND SUMA_BP >= SUMA_DOC THEN
	             IF NVL(SUM_DEN,0) > SUMA_SH1 THEN
	                varRet:= SUMA_DOC; goto nnn;
	             ELSE
	                SUMA := SUMA - SUMA_SH1;
	             END IF;
	             varRet:= SUMA; goto nnn;
	          ELSIF SUMA <= SUMA_SH1 THEN
	             SUMA := 0;
	             varRet:= SUMA; goto nnn;
	          ELSIF SUMA > SUMA_SH2 AND SUMA_BP >= SUMA_DOC THEN
	             IF NVL(SUM_DEN,0) > SUMA_SH2 THEN
	                SUMA := 0;
	                varRet:= SUMA; goto nnn;
	             ELSIF NVL(SUM_DEN,0) <= SUMA_SH1 THEN
	                SUMA := SUMA_SH2 - SUMA_SH1;
	                varRet:= SUMA; goto nnn;
	             ELSIF NVL(SUM_DEN,0) > SUMA_SH1 AND NVL(SUM_DEN,0) <= SUMA_SH2 THEN
	                SUMA := SUMA_SH2 - NVL(SUM_DEN,0);
	                varRet:= SUMA; goto nnn;
	             END IF;
	          ELSIF SUMA > SUMA_SH2 AND SUMA_BP < SUMA_DOC THEN    --- ESLI SUMA SNIATII > 2 GRANITSI SHKALI I NEHVATAET BEZNALICHNIH PEREVODOV
	             IF (SUM_DEN + SUMA_BP)<= SUMA_SH1 THEN
	                SUMA := 0;
	                varRet:= SUMA; goto nnn;
	             ELSIF SUM_DEN > SUMA_SH2 THEN
	                SUMA := 0;
	                varRet:= SUMA; goto nnn;
	             ELSIF SUM_DEN <= SUMA_SH2 AND SUM_DEN > SUMA_SH1 AND (SUM_DEN + SUMA_BP) <= SUMA_SH2 THEN
	                varRet:= SUMA_BP; goto nnn;
	             ELSIF SUM_DEN <= SUMA_SH2 AND SUM_DEN > SUMA_SH1 AND (SUM_DEN + SUMA_BP) > SUMA_SH2 THEN
	                SUMA := SUMA_SH2 - SUM_DEN;
	                varRet:= SUMA; goto nnn;
	             END IF;
	          ELSIF SUMA > SUMA_SH1 AND SUMA <= SUMA_SH2 AND SUMA_BP < SUMA_DOC THEN
	             IF (SUM_DEN + SUMA_BP) <= SUMA_SH1 THEN
	                SUMA := 0;
	                varRet:= SUMA; goto nnn;
	             ELSIF SUM_DEN > SUMA_SH1 AND (SUM_DEN + SUMA_BP) <= SUMA_SH2 THEN
	                varRet:= SUMA_BP; goto nnn;
	             ELSIF SUM_DEN > SUMA_SH1 AND SUM_DEN <= SUMA_SH2 AND (SUM_DEN + SUMA_BP) > SUMA_SH2 THEN
	                SUMA := SUMA_SH2 - SUM_DEN;
	                varRet:= SUMA_BP; goto nnn;
	             END IF;
	          END IF;
	       END IF;		
	       IF SUMA_BP >= SUMA_DOC AND SUMA_DOC <= SUMA_SH1 THEN
	          varRet:= 0;			   	 goto nnn;
	       ELSIF SUMA_BP >= SUMA_DOC AND SUMA_DOC > SUMA_SH1 AND SUMA_DOC <= SUMA_SH2 THEN
	          SUMA := SUMA_DOC - SUMA_SH1;
	          varRet:= SUMA; goto nnn;
	       ELSIF SUMA_BP >= SUMA_DOC AND SUMA_DOC > SUMA_SH2 THEN
	          SUMA := SUMA_SH2 - SUMA_SH1;
	          varRet:= SUMA;	 goto nnn;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC <= SUMA_SH1 THEN
	          varRet:= 0;	 goto nnn;
	       ELSIF SUMA_BP < SUMA_SH1 THEN
	          varRet:= 0; goto nnn;
	       ELSIF SUMA_BP < SUMA_SH2 THEN
	          varRet:= SUMA_DOC; goto nnn;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC > SUMA_SH1 AND SUMA_DOC <= SUMA_SH2 AND SUMA_BP < SUMA_SH1 THEN
              varRet:= 0; goto nnn;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC > SUMA_SH1 AND SUMA_DOC <= SUMA_SH2 AND SUMA_BP > SUMA_SH1 THEN
	          SUMA := SUMA_BP - SUMA_SH1;
              varRet:= SUMA;              	 goto nnn;
	       END IF;
	        varRet:= 0; goto nnn;
-------------------------------------------------- КОНЕЦ -----
---------------------------------------    РАСЧЕТ СУММЫ ДЛЯ 3 ШКАЛЫ -----
	       ELSIF  P_PAR = 'СУММА_РАСЧ_КОМ3' THEN
		   &OpDate;
			mn_ref:= nvl(mn_ref,md); -- Башкиров В.Г. 19.09.2019
	       SUMA_DOC := mn_ref.[SUM];  -- СУММА ДОКУМЕНТА
	
        	FOR (SELECT MD(
			  	          SUM(MD.[SUM]) : SUM_DOC
			  	         )
			  	IN [MAIN_DOCUM]
			  	WHERE trunc(MD.[DATE_PROV]) = trunc(TODAY) AND MD.[ACC_DT] = RKO.[ACCOUNT]
			  	      AND MD.[ACC_KT].[MAIN_USV].[NUM] in ('20202')
			  	)
		   LOOP
	            SUM_DEN := MD.SUM_DOC;
		   END LOOP;
		 -- ----------
		  IF SUM_DEN IS NOT NULL THEN
	          SUMA := SUMA_DOC + NVL(SUM_DEN,0);
		   ELSE
		      SUMA := SUMA_DOC;
		   END IF;
		
		   SUMA_BP := GET_SUM_SCALE(RKO);
		  ------------------------   КОНЕЦ --------------------------------------------------
		   &debug('SUMA_DEN => '||SUM_DEN,dp)
	       IF SUMA_BP > 0 AND SUM_DEN IS NOT NULL THEN
	          IF SUMA > SUMA_SH2 AND SUMA_BP >= SUMA_DOC THEN
	             IF NVL(SUM_DEN,0) > SUMA_SH2 THEN
	                varRet:= SUMA_DOC; goto nnn;
	             ELSE
	                SUMA := SUMA - SUMA_SH2;
	             END IF;
	             varRet:= SUMA; goto nnn;
	          ELSIF SUMA <= SUMA_SH2 THEN
	             SUMA := 0;
	             varRet:= SUMA; goto nnn;
	          ELSIF SUMA > SUMA_SH2 AND SUMA_BP < SUMA_DOC THEN    --- ESLI SUMA SNIATII > 2 GRANITSI SHKALI I NEHVATAET BEZNALICHNIH PEREVODOV
	             IF (SUM_DEN + SUMA_BP) <= SUMA_SH2 THEN
	                SUMA := 0;
	                varRet:= SUMA; goto nnn;
	             ELSIF SUM_DEN > SUMA_SH2 AND SUMA_BP > SUM_DEN THEN
	                SUMA := SUMA_BP - SUM_DEN;
	                varRet:= SUMA; goto nnn;
	             ELSIF SUM_DEN < SUMA_SH2 AND SUMA_BP > SUMA_SH2 THEN
	                SUMA := SUMA_BP - SUMA_SH2;
	                varRet:= SUMA; goto nnn;
	             ELSIF SUM_DEN > SUMA_BP THEN
	                SUMA := 0;
	                varRet:= SUMA; goto nnn;
	             END IF;
	          END IF;
	       END IF;		
	       IF SUMA_BP >= SUMA_DOC AND SUMA_DOC <= SUMA_SH2 THEN
	          varRet:= 0;			   	 goto nnn;
	       ELSIF SUMA_BP >= SUMA_DOC AND SUMA_DOC > SUMA_SH2 THEN
	          SUMA := SUMA_DOC - SUMA_SH2;
	          varRet:= SUMA; goto nnn;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC <= SUMA_SH2 THEN
	          varRet:= 0;	 goto nnn;
	       ELSIF SUMA_BP < SUMA_DOC AND SUMA_DOC > SUMA_SH2 THEN
	          IF SUMA_BP <= SUMA_SH2 THEN
	             varRet:= 0; goto nnn;
	          ELSE
	             varRet:= SUMA_BP;	 goto nnn;
	          END IF;	
	       END IF;
	       varRet:= 0; goto nnn;
----------------------------------------------------- КОНЕЦ -------
		elsif P_PAR ='PSH_VSTRECHKA'  then
			&OpDate;
			mn_ref:=coalesce(P_DOC,md,mn_ref,::[PATTERN_DOC].[BUSINESS_OP].doc_ref); --Башкиров В.Г. 19.09.2019
			dCalc:=trunc(TODAY); --Башкиров В.Г. 20.08.2024
			if MN_REF.[ACC_KT].[MAIN_V_ID] like ('30102%') then
				SUMA_DOC := mn_ref.[SUM];  -- СУММА ДОКУМЕНТА
				SUMA_IN:=abs(::[RUNTIME].[F_5].A('И'||MN_REF.[ACC_DT]||'СН',dCalc));
				SUMA_DT:=abs(::[RUNTIME].[F_5].A('И'||MN_REF.[ACC_DT]||'ДН',dCalc,dCalc,ACTION=='В',ACT_PAR=='30102%'));
				SUMA_KT:=abs(::[RUNTIME].[F_5].A('И'||MN_REF.[ACC_DT]||'КН',dCalc,dCalc,ACTION=='И',ACT_PAR=='30102%'));
				&debug('SUMA_IN '|| SUMA_IN,dp)
				&debug('SUMA_DT '|| SUMA_DT,dp)
				&debug('SUMA_KT '|| SUMA_KT,dp)
				
				--if MN_REF%state='PROV' then SUMA_DT:=SUMA_DT-SUMA_DOC;
				--end if;
				
				if SUMA_IN+SUMA_KT-SUMA_DT>=0 then varRet:= 0; goto nnn;
				else
						if SUMA_IN+SUMA_KT-SUMA_DT < 0 then varRet:= abs(SUMA_IN+SUMA_KT-SUMA_DT); goto nnn;
						--else varRet:=(SUMA_DOC-abs(SUMA_IN+SUMA_KT-SUMA_DT)); goto nnn;
						end if;
				end if;
				/*
				if MN_REF%state='PROV' then SUMA_DT:=SUMA_DT-SUMA_DOC;
				end if;
				
				if SUMA_IN+SUMA_KT-SUMA_DOC-SUMA_DT>=0 then varRet:= 0; goto nnn;
				else if abs(SUMA_IN+SUMA_KT-SUMA_DT)>=SUMA_DOC then varRet:=(SUMA_DOC); goto nnn;
						else varRet:=(SUMA_DOC-abs(SUMA_IN+SUMA_KT-SUMA_DT)); goto nnn;
						end if;
				end if;
				*/
			else varRet:= 0; goto nnn;
			end if;

		elsif P_PAR ='PSH_VSTRECHKA_ONLINE'  then --Башкиров В.Г. 20.08.2024 Сумма встречки (OnLine) Расчет на дату:время проводки документа. Комиссия должна быть рассчитана после проводки документа.
			&OpDate; --TODAY := Z$BRANCH_SLIB.OPDATE_FILIAL(Z#RKO#INTERFACE.g#filial(RK1));
			mn_ref:=coalesce(P_DOC,md,mn_ref,::[PATTERN_DOC].[BUSINESS_OP].doc_ref);
			oMd   :=mn_ref;

			if oMd.[ACC_KT].[MAIN_V_ID] like '3%' then --('30102%') then
				SUMA_DOC := nvl(oMd.[SUM],oMd.[SUM_PO]);
				if oMd.[DATE_PROV] is null then
					if trunc(oMd.[DATE_VAL])=trunc(sysdate) then
						dCalc:=sysdate;
						s200:='Дата:время (DATE_VAL=sysdate) '||to_char(dCalc,fmtTS)||LF$;
						vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size);
						&debug(s200,dp)
					end if;
				else
					dCalc:=oMd.[DATE_PROV]; --Башкиров В.Г. 20.08.2024
					s200:='Дата:время проводки '||to_char(dCalc,fmtTS);
					vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size);
					&debug(s200,dp)
				end if;
				if dCalc is null then
					if trunc(oMd.[DATE_DOC])=trunc(sysdate) then
						dCalc:=sysdate;
						s200:='Дата:время (DATE_DOC=sysdate) '||to_char(dCalc,fmtTS);
						vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size);
						&debug(s200,dp)
					end if;
				end if;
				if dCalc is null then
					if trunc(TODAY)=trunc(sysdate) then
						dCalc:=sysdate;
						s200:='Дата:время (TODAY=sysdate) '||to_char(dCalc,fmtTS);
						vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size);
						&debug(s200,dp)
					end if;
				end if;
				if dCalc is null then
					today_timestamp:=to_date(to_char(TODAY,fmt)||' 23:59:59.999999',fmtTS);
					dCalc:=today_timestamp;
					s200:='Дата:время (TODAY 23:59:59.999999) '||to_char(dCalc,fmtTS);
					vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size); &debug(s200,dp)
				end if;

				SUMA_IN:=abs(::[RUNTIME].[F_5].A('И'||oMd.[ACC_DT]||'СН',trunc(TODAY)));
				SUMA_DT:=abs(::[RUNTIME].[F_5].A('И'||oMd.[ACC_DT]||'ДН',trunc(TODAY),dCalc,ACTION=='В',ACT_PAR=='3%')); --'30102%'));
				SUMA_KT:=abs(::[RUNTIME].[F_5].A('И'||oMd.[ACC_DT]||'КН',trunc(TODAY),dCalc,ACTION=='И',ACT_PAR=='3%')); --'30102%'));
				s200:='SUMA_IN на '||to_char(TODAY,fmt)||' '|| SUMA_IN; vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size); &debug(s200,dp)
				s200:='SUMA_DT на '||to_char(dCalc,fmtTS)||' '|| SUMA_DT; vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size); &debug(s200,dp)
				s200:='SUMA_KT на '||to_char(dCalc,fmtTS)||' '|| SUMA_KT; vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size); &debug(s200,dp)

				--if oMd%state='PROV' then SUMA_DT:=SUMA_DT-SUMA_DOC;
				--end if;

				s200:='SUMA_IN+SUMA_KT-SUMA_DT = '||SUMA_IN||'+'||SUMA_KT||'-'||SUMA_DT||' = '||SUMA_IN+SUMA_KT-SUMA_DT;
				vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size); &debug(s200,dp)
				
				if SUMA_IN+SUMA_KT-SUMA_DT>=0 then 
					varRet:= 0; 
					s200:='Сумма встречки('||to_char(dCalc,fmtTS)||'='||varRet;
					vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size); &debug(s200,dp)
					goto nnn;
				else
						if SUMA_IN+SUMA_KT-SUMA_DT < 0 then 
							varRet:= abs(SUMA_IN+SUMA_KT-SUMA_DT);
							s200:='Сумма встречки('||to_char(dCalc,fmtTS)||'='||varRet;
							vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size); &debug(s200,dp)
							if instr(oMd.[COMMENT],vCommentCalc)>0 then null;
							else mn_ref.[COMMENT]:=substr(mn_ref.[COMMENT]||vCommentCalc,1,oMd.[COMMENT]%size);
							end if;
							goto nnn;
					  --else varRet:=(SUMA_DOC-abs(SUMA_IN+SUMA_KT-SUMA_DT)); goto nnn;
						end if;
				end if;
				/*
				if oMd%state='PROV' then SUMA_DT:=SUMA_DT-SUMA_DOC;
				end if;
				
				if SUMA_IN+SUMA_KT-SUMA_DOC-SUMA_DT>=0 then varRet:= 0; goto nnn;
				else if abs(SUMA_IN+SUMA_KT-SUMA_DT)>=SUMA_DOC then varRet:=(SUMA_DOC); goto nnn;
						else varRet:=(SUMA_DOC-abs(SUMA_IN+SUMA_KT-SUMA_DT)); goto nnn;
						end if;
				end if;
				*/
			else 
				varRet:= 0; 
				s200:='Сумма встречки('||to_char(dCalc,fmtTS)||'='||varRet;
				vCommentCalc:=substr(vCommentCalc||s200||LF$,1,vCommentCalc%size); &debug(s200,dp)
				goto nnn;
			end if;

		elsif P_PAR ='PSH_VSTRECHKA_RAZ'  then -- 12/11/2021 KAS
		   
		 &debug ('P_PROD='||P_PROD,dp)
		 &debug ('P_DOC='||P_DOC,dp)
		 &debug ('P_PATT='||P_PATT,dp)
		    
		   ::[RUNTIME].[STR].get_par(P_PATT, 'DB', dtt);
		    
		  &debug ('dtt='||dtt,dp)

				      rk1 := P_PROD;
				      
				      SUMA_IN:=abs(::[RUNTIME].[F_5].A('И'||rk1 .[ACCOUNT]||'СН',trunc(dtt)));
				      SUMA_DT:=abs(::[RUNTIME].[F_5].A('И'||rk1 .[ACCOUNT]||'ДН',trunc(dtt),trunc(dtt),ACTION=='В',ACT_PAR=='30102%'));
				      SUMA_KT:=abs(::[RUNTIME].[F_5].A('И'||rk1 .[ACCOUNT]||'КН',trunc(dtt),trunc(dtt),ACTION=='И',ACT_PAR=='30102%'));
				      				      
				    &debug('SUMA_IN '|| SUMA_IN,dp)
				    &debug('SUMA_DT '|| SUMA_DT,dp)
				    &debug('SUMA_KT '|| SUMA_KT,dp)

				       if SUMA_IN+SUMA_KT-SUMA_DT>=0 then varRet:= 0; goto nnn;
				       else
				       		varRet:= abs(SUMA_IN+SUMA_KT-SUMA_DT); goto nnn;
				       end if;		       
			   				
		elsif P_PAR = 'СУММА_ДОК_ПРЕД' then --
			&OpDate;
			SUM_DEN := 0; SUMA := 0;
		  	for (select MD(
		  	               SUM(MD.[SUM_KSPL].[2]) : SUM_KSPL
		  	             )
		  	     in [MAIN_DOCUM]
		  	     where trunc(MD.[DATE_PROV]) = trunc(today) AND MD.[ACC_DT] = RKO.[ACCOUNT]
		  	           AND MD.[ACC_KT].[MAIN_USV].[NUM] = '20202'
		  	           AND MD.[SUM_KSPL].[1].[1] NOT IN (40, 41, 42, 44, 50)
		  	    )
		  	loop
                SUM_DEN := MD.SUM_KSPL;
			end loop; 	
			   varRet:= SUMA;				   					   		 goto nnn;
		ELSIF P_PAR = 'КЛИЕНТ_РКО_КАТЕГОР_БК' THEN
			&OpDate;		
            FOR I IN rko.[CLIENT].[VIDS_CL] WHERE I.[DATE_BEGIN] <= trunc(TODAY) AND NVL(I.[DATE_END],TO_DATE('31.12.3000', 'DD.MM.YYYY')) >= trunc(today)
            LOOP
                IF I.[CATEGORY].CODE = 'RKO_CAT_BC' THEN
                  V_IS := TRUE;
				  FOR M IN RKO.[ACCOUNT].[ARC_MOVE] WHERE M.[DATE] >= trunc(TODAY-5,'MM') AND
					                                      M.[DATE] <= trunc(TODAY) AND
					                                      (M.[ACC_CORR].[MAIN_USV].[NUM] NOT IN (47426,70601) OR
					                                      UPPER(M.[DOC].[NAZN]) NOT LIKE UPPER('%ОШИБ%'))
				  LOOP
					  varRet:= '1'; goto nnn;
				  END LOOP;
                END IF;
            END LOOP;
            IF V_IS = FALSE THEN
  			   FOR M IN RKO.[ACCOUNT].[ARC_MOVE] WHERE M.[DATE] >= trunc(TODAY-5,'MM') AND
				                                       M.[DATE] <= trunc(TODAY) AND
					                                   (M.[ACC_CORR].[MAIN_USV].[NUM] NOT IN (47426,70601) OR
					                                   UPPER(M.[DOC].[NAZN]) NOT LIKE UPPER('%ОШИБ%'))
			   LOOP
				   varRet:= '0'; goto nnn;
			   END LOOP;
            END IF;
			varRet:= '2';		 goto nnn;
		ELSIF P_PAR = 'КОМИСС_ОБОР_1000000' THEN
			&OpDate;		
				  FOR M IN RKO.[ACCOUNT].[ARC_MOVE] WHERE M.[DATE] >= trunc(TODAY-30) AND
					                                      M.[DATE] <= trunc(TODAY) /*AND
					                                      (M.[ACC_CORR].[MAIN_USV].[NUM] NOT IN (47426,70601) OR
					                                      UPPER(M.[DOC].[NAZN]) NOT LIKE UPPER('%ОШИБ%'))*/
				  LOOP
				      SUMA := SUMA + M.[SUMMA_NAT];
				  END LOOP;
				  IF SUMA < 1000000 THEN
				     varRet:= '1'; goto nnn;
				  ELSIF SUMA >= 1000000 AND SUMA < 3000000 THEN
				     varRet:= '2'; goto nnn;
				  ELSE
				     varRet:= '3'; goto nnn;
				  END IF;
			varRet:= '4';	 goto nnn;
       ELSIF P_PAR = 'КАССА_ДОК' then
             if p_prod%class in ('RKO', 'RKO_CUR') then
                DOC_REF := ::[PATTERN_DOC].[BUSINESS_OP].DOC_REF;
                    BEGIN
                          SELECT M(M)
                          IN [MAIN_DOCUM]
                          WHERE M = DOC_REF
                          INTO MD;
                    EXCEPTION
                          WHEN NO_DATA_FOUND THEN
                               MD := NULL;
                          WHEN OTHERS THEN
                               MD := NULL;
                    END;
             END IF;
             IF MD.[ACC_DT].[MAIN_USV].[NUM] IN (20202) THEN
                varRet:= '1'; goto nnn;
             END IF;
             varRet:= '0';							 goto nnn;
       ELSIF P_PAR = 'ВНПЛ_0445' then
             if p_prod%class in ('RKO', 'RKO_CUR') then
                DOC_REF := ::[PATTERN_DOC].[BUSINESS_OP].DOC_REF;
                    BEGIN
                          SELECT M(M)
                          IN [MAIN_DOCUM]
                          WHERE M = DOC_REF
                          INTO MD;
                    EXCEPTION
                          WHEN NO_DATA_FOUND THEN
                               MD := NULL;
                          WHEN OTHERS THEN
                               MD := NULL;
                    END;
                    IF MD.[KL_KT].[2].[3].[BIC] IS NULL AND (SUBSTR(MD.[KL_KT].[2].[1],1,5) IN (40817, 40820) OR SUBSTR(MD.[KL_KT].[2].[1],1,3) IN ('423','426')) THEN
                        varRet:= 2; goto nnn;
                    END IF;
              IF SUBSTR(MD.[KL_KT].[2].[3].[BIC],1,4) IN ('0445', '0483') THEN
                IF MD.[KL_KT].[2].[3].[BIC] IN ('044599205', '048327752') AND (SUBSTR(MD.[KL_KT].[2].[1],1,5) IN (40817, 40820) OR SUBSTR(MD.[KL_KT].[2].[1],1,3) IN ('423','426')) THEN
                   varRet:= 2; goto nnn;
                ELSE
                   varRet:= 1; goto nnn;
                END IF;
              ELSE
                 varRet:= 0; goto nnn;
              END IF;
             end if;

       ELSIF P_PAR = 'ВЫДАЧА_ЗП_ХЗ' then
	       &OpDate;
             if p_prod%class in ('RKO', 'RKO_CUR') then
                DOC_REF := ::[PATTERN_DOC].[BUSINESS_OP].DOC_REF;
                    BEGIN
                          SELECT M(M)
                          IN [MAIN_DOCUM]
                          WHERE M = DOC_REF
                          INTO MD;
                    EXCEPTION
                          WHEN NO_DATA_FOUND THEN
                               MD := NULL;
                          WHEN OTHERS THEN
                               MD := NULL;
                    END;
	           FOR i IN RKO.[DAILY] WHERE I.[DAT_GIVE]<=trunc(TODAY) AND I.[DAT_GIVE] = (SELECT J(MAX(J.[DAT_GIVE])) IN RKO.[DAILY] WHERE J.[DAT_GIVE] <= trunc(TODAY)) LOOP
			       SELECT M(SUM(M.[SUMMA_NAT]))			
			       IN RKO.[ACCOUNT].[ARC_MOVE] WHERE trunc(M.[DATE]) = trunc(TODAY) AND SUBSTR(M.[ACC_CORR].[MAIN_V_ID],1,5)!='70601'
			       INTO SUM_DEN;
			       SUM_DEN := NVL(SUM_DEN,0) + NVL(MD.[SUM],0);
			       &debug('SUM_DEN => '||SUM_DEN,dp)
			       IF SUM_DEN <= 300000 THEN
			          varRet:= '1'; goto nnn;
			       ELSIF SUM_DEN > 300000 AND SUM_DEN <= 3000000 THEN
			          varRet:= '2'; goto nnn;
			       ELSIF SUM_DEN > 3000000 AND SUM_DEN <= 7000000 THEN
			          varRet:= '3'; goto nnn;
			       ELSIF SUM_DEN > 7000000 THEN
			          varRet:= '4'; goto nnn;
			       END IF;
	           END LOOP;
			       SELECT M(SUM(M.[SUMMA_NAT]))			
			       IN RKO.[ACCOUNT].[ARC_MOVE] WHERE trunc(M.[DATE]) = trunc(TODAY) AND SUBSTR(M.[ACC_CORR].[MAIN_V_ID],1,5)!='70601'
			       INTO SUM_DEN;
			       SUM_DEN := NVL(SUM_DEN,0) + NVL(MD.[SUM],0);
			  --     &debug('SUM_DEN => '||SUM_DEN,dp)
			       IF SUM_DEN <= 600000 THEN
			          varRet:= '10'; goto nnn;
			       ELSIF SUM_DEN > 600000 AND SUM_DEN <= 3000000 THEN
			          varRet:= '11'; goto nnn;
			       ELSIF SUM_DEN > 3000000 AND SUM_DEN <= 7000000 THEN
			          varRet:= '12'; goto nnn;
			       ELSIF SUM_DEN > 7000000 THEN
			          varRet:= '13'; goto nnn;
			       END IF;
             END IF;
            varRet:= '100'; goto nnn;
		ELSIF P_PAR = 'КЛИЕНТ_РКО_ОВЕРДРАФТ' THEN
			&OpDate;		
			FOR O IN ::[OVERDRAFTS] WHERE O.[CLIENT] = RKO.[CLIENT] LOOP
				  FOR M IN O.[ACCOUNT].[ARC_MOVE] WHERE M.[DATE] >= trunc(TODAY-5,'MM') AND
					                                      M.[DATE] <= trunc(TODAY) AND
					                                      M.[ACC_CORR].[MAIN_USV].[NUM] NOT IN (47426,70601) AND
					                                      UPPER(M.[DOC].[NAZN]) NOT LIKE UPPER('%ОШИБ%')
				  LOOP
					  varRet:= '1'; goto nnn;
				  END LOOP;
			END LOOP;
			varRet:= '0';			 goto nnn;
		elsif P_PAR = 'ТАРИФ_ПЛАН' then --
			&OpDate;
			for p in rko.[TARIF_PLAN] where p.[DATE_BEGIN] is null or trunc(p.[DATE_BEGIN]) <= trunc(today)
			loop
				&debug('ТАРИф='||p.[TAR_PLAN].[CODE],dp)
				tar_pl := p.[TAR_PLAN].[CODE];
			end loop;
			varRet:= tar_pl; goto nnn;
		-- Возвращает сумму списаний по кассе по расчетному счету договора РКО за текущий день
		elsif P_PAR = 'КАСС_СПИС' then --
			&OpDate;
			&debug('Data='||trunc(today, 'MONTH'),dp)
			Select m(sum(m.[SUMMA_NAT]))			
				in rko.[ACCOUNT].[ARC_MOVE] where
			trunc(m.[DATE]) = trunc(today) And
			substr(m.[ACC_CORR].[MAIN_V_ID],1,5)='20202' and			
			m.[DT]= 1
			Into Sum_den;
			&debug('Sum_month='||Sum_den,dp)
			varRet:= to_char(nvl(Sum_den,0)); goto nnn;
		--Балансовый счет договора РКО
		elsif P_PAR = 'БАЛ_СЧ' then
			val	:= rko.[CONTRACT_CUR].[CODE_ISO];
			&debug(' val='||val,dp)		
			if val != 643 then
				bal_acc := bal_acc || to_char(val);
			end if;	
						
			varRet:= nvl(bal_acc,'0'); goto nnn;
		--Код филиала и подразделения
		elsif P_PAR = 'ФФПП' then --
			FFPP := lpad(nvl(rko.[FILIAL].[LOCAL_CODE],'0'),2,'0')||lpad(nvl(rko.[DEPART].[NUM], '0'),2,'0');
			varRet:= FFPP; goto nnn;
		--Количество договоров в подразделении
		elsif P_PAR = 'НОМ_ДОГ_ДО' then --
			begin
				Select m(count(m))	in ::[RKO] all where m.[DEPART] = rko.[DEPART] Into col_dog;
				exception when others then
				pragma error ('Ошибка при вычислении номера договора в разрезе подразделения');
			end;
			varRet:= to_char(nvl(col_dog,'0')); goto nnn;
			
		--yach
		ELSIF P_PAR like 'СУММА_РАСЧ_КОМ_Э%' THEN
			suma_bp := nvl(GET_SUM_SCALE(RKO),0);
			suma := get_sum_calc(md2.[SUM],suma_bp);
			
			if P_PAR = 'СУММА_РАСЧ_КОМ_Э' THEN
				if suma <= SUMA_SH_FIL then
					varRet:= suma; goto nnn;
				else
					varRet:= SUMA_SH_FIL; goto nnn;
				end if;
			elsif P_PAR = 'СУММА_РАСЧ_КОМ_Э2' THEN
				if suma <= SUMA_SH_FIL then
					varRet:= 0; goto nnn;
				else
					varRet:= suma - SUMA_SH_FIL; goto nnn;
				end if;	
			end if;	
		 -- Лопухов
		 ELSIF P_PAR like 'СУММА_РАСЧ_КОМ_НЭ%' THEN
               suma :=md2.[SUM];

               if P_PAR = 'СУММА_РАСЧ_КОМ_НЭ' THEN
                  if suma <= SUMA_SH_FILN then
                     varRet:= suma; goto nnn;
                  else
                     varRet:= 0.0; goto nnn;
                  end if;
               elsif P_PAR = 'СУММА_РАСЧ_КОМ_НЭ1' THEN
                     if (suma > SUMA_SH_FILN) and (suma <= SUMA_SH_FILN1) then
                        varRet:= suma; goto nnn;
                     else
                        varRet:= 0.0; goto nnn;
                     end if;
               elsif P_PAR = 'СУММА_РАСЧ_КОМ_НЭ2' THEN
                     if suma > SUMA_SH_FILN1 then
                        varRet:= suma; goto nnn;
                     else
                        varRet:= 0.0; goto nnn;
                     end if;
               end if;
               varRet:= 0;	 goto nnn;
		ELSIF P_PAR = 'СУММА_РАСЧ_КОМИС' THEN
            &OpDate;
			BEGIN
		         LOCATE MN_REF IN ::[MAIN_DOCUM] WHERE MN_REF%ID = RKO;
				 EXCEPTION WHEN NO_DATA_FOUND THEN
					  mn_ref:=coalesce(::[PATTERN_DOC].[BUSINESS_OP].doc_ref,md,mn_ref,P_DOC); --Башкиров В.Г. 19.09.2019
			END;
			IF MN_REF.[VID_DOC].[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR MN_REF.[ACC_DT].[MAIN_USV].[NUM] = '20202' THEN
			   varRet:= 0; goto nnn;
			END IF;			
			suma_bp := nvl(GET_SUM_SCALE(RKO),0);
			varRet:= get_sum_calc(nvl(md2.[SUM],0),nvl(suma_bp,0)); goto nnn;
		ELSIF P_PAR like 'СУММА_ПРИЕМ_ДН' THEN
			&OpDate;
			BEGIN
		         LOCATE MN_REF IN ::[MAIN_DOCUM] WHERE MN_REF%ID = RKO;
				 EXCEPTION WHEN NO_DATA_FOUND THEN
					  mn_ref:=coalesce(::[PATTERN_DOC].[BUSINESS_OP].doc_ref,md,mn_ref,P_DOC); --Башкиров В.Г. 19.09.2019
			END;
			IF MN_REF.[VID_DOC].[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR MN_REF.[ACC_DT].[MAIN_USV].[NUM] = '20202' THEN
			   varRet:= MN_REF.[SUM]; goto nnn;
			ELSE
			   varRet:= 0; goto nnn;
			END IF;		
			varRet:= 0;			 goto nnn;
	    ELSIF P_PAR = 'СУММА_РАСЧ_ЗП_СТИП' THEN
			&OpDate;
			
			BEGIN
		         LOCATE MN_REF IN ::[MAIN_DOCUM] WHERE MN_REF%ID = RKO;
				 EXCEPTION WHEN NO_DATA_FOUND THEN
						mn_ref:=coalesce(::[PATTERN_DOC].[BUSINESS_OP].doc_ref,md,mn_ref,P_DOC); --Башкиров В.Г. 19.09.2019
			END;
			PSH_VID_MD := ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_VID_DOC; -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
			PSH_ACC_DT_MD := ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_ACC_DT; -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
			PSH_SUMA := ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_SUMA; -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
			IF ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_VID_DOC IS NOT NULL OR ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_ACC_DT IS NOT NULL THEN -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
				IF PSH_VID_MD.[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR PSH_ACC_DT_MD.[MAIN_USV].[NUM] = '20202' THEN
				   varRet:= 0; goto nnn;
				END IF;	
			END IF;			
			IF MN_REF.[VID_DOC].[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR MN_REF.[ACC_DT].[MAIN_USV].[NUM] = '20202' THEN
			   varRet:= 0; goto nnn;
			END IF;				
			SUMA_DOC := NVL(MN_REF.[SUM], PSH_SUMA);
			SUM_ZAYAV_SAL := 0;
			FOR i IN RKO.[DAILY] WHERE I.[DAT] = trunc(TODAY) AND I.[TO_ARM] IS NOT NULL --AND NVL(I.[SALARY],0) != 0
			LOOP
			    --SUM_ZAYAV_SAL := SUM_ZAYAV_SAL + I.[SALARY];
			    SUM_ZAYAV_SAL := SUM_ZAYAV_SAL + I.[TO_ARM];
			END LOOP;		
			declare
				ksim ref [SUM_SYMKS];
			begin
				FOR R IN RKO.[ARRAY_OPER_DOG] WHERE R.[FIRST_DOC] = MN_REF
				LOOP
                   FOR SYM in mn_ref.[SUM_KSPL] WHERE SYM.[1].[1] = R.[SYM_KS].[1] AND R.[SYM_KS].[1] IN ('40','41')
				   LOOP
					   SUMAKS := NVL(SUMA,0) + SYM.[2];
				   END LOOP;				
				END LOOP;
				ksim := ::[RUNTIME].[STR].get_str_par(P_PATT, 'SUM_KS');
				if ksim.[1].[1] in ('40','41') then
					suma := ksim.[2];
				end if;
			end;
			SUM_DEN := GET_SUM_OBOR_DN(RKO, 'СУММА_РАСЧ_ЗП_СТИП');
			IF SUM_DEN IS NULL THEN
			   SUM_DEN := 0;
			END IF;
			IF SUM_ZAYAV_SAL < SUMA_GOL_BEZ_COM AND SUMA_DOC <= SUMA_GOL_BEZ_COM THEN
			   SUM_ZAYAV_SAL := SUMA_GOL_BEZ_COM;
			END IF;				
			/*IF SUM_ZAYAV_SAL >= SUMAKS THEN
			   SUM_ZAYAV_SAL := SUM_ZAYAV_SAL - SUMAKS;
			END IF;	*/ --Хрень какая то			
			IF (SUMA + SUM_DEN) <= SUM_ZAYAV_SAL  THEN
			   varRet:= SUMA; goto nnn;
			ELSIF SUM_DEN >= SUM_ZAYAV_SAL THEN
			   varRet:= 0; goto nnn;
			ELSIF SUM_DEN < SUM_ZAYAV_SAL AND (SUMA + SUM_DEN) > SUM_ZAYAV_SAL THEN
			   varRet:= SUM_ZAYAV_SAL - SUM_DEN; goto nnn;
			END IF;
			varRet:= 0;	 goto nnn;
	    ELSIF P_PAR = 'СУММА_РАСЧ_ЗП_СТИП05' THEN
			&OpDate;
			BEGIN
		         LOCATE MN_REF IN ::[MAIN_DOCUM] WHERE MN_REF%ID = RKO;
				 EXCEPTION WHEN NO_DATA_FOUND THEN
						mn_ref:=coalesce(::[PATTERN_DOC].[BUSINESS_OP].doc_ref,md,mn_ref,P_DOC); --Башкиров В.Г. 19.09.2019
			END;
			PSH_VID_MD := ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_VID_DOC; -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
			PSH_ACC_DT_MD := ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_ACC_DT; -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
			PSH_SUMA := ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_SUMA; -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
			IF ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_VID_DOC IS NOT NULL OR ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_ACC_DT IS NOT NULL THEN -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
				IF PSH_VID_MD.[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR PSH_ACC_DT_MD.[MAIN_USV].[NUM] = '20202' THEN
				   varRet:= 0; goto nnn;
				END IF;	
			END IF;			
			IF MN_REF.[VID_DOC].[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR MN_REF.[ACC_DT].[MAIN_USV].[NUM] = '20202' THEN
			   varRet:= 0; goto nnn;
			END IF;				
			SUMA_DOC := NVL(MN_REF.[SUM], PSH_SUMA);
			SUM_ZAYAV_SAL := 0;
			FOR i IN RKO.[DAILY] WHERE I.[DAT] = trunc(TODAY) AND I.[TO_ARM] IS NOT NULL--AND NVL(I.[SALARY],0) != 0
			LOOP
			    --SUM_ZAYAV_SAL := SUM_ZAYAV_SAL + I.[SALARY];
			    SUM_ZAYAV_SAL := SUM_ZAYAV_SAL + I.[TO_ARM];
			END LOOP;
			declare
				ksim ref [SUM_SYMKS];
			begin
				FOR R IN RKO.[ARRAY_OPER_DOG] WHERE R.[FIRST_DOC] = MN_REF
				LOOP
                   FOR SYM in mn_ref.[SUM_KSPL] WHERE SYM.[1].[1] = R.[SYM_KS].[1] AND R.[SYM_KS].[1] IN ('40','41')
				   LOOP
					   SUMAKS := NVL(SUMA,0) + SYM.[2];
				   END LOOP;				
				END LOOP;			
				ksim := ::[RUNTIME].[STR].get_str_par(P_PATT, 'SUM_KS');
				if ksim.[1].[1] in ('40','41') then
					suma := ksim.[2];
				end if;
			end;
			
			SUM_DEN := GET_SUM_OBOR_DN(RKO, 'СУММА_РАСЧ_ЗП_СТИП');
			IF SUM_DEN IS NULL THEN
			   SUM_DEN := 0;
			END IF;	
			IF SUM_ZAYAV_SAL < SUMA_GOL_BEZ_COM  AND SUMA_DOC <= SUMA_GOL_BEZ_COM THEN
			   SUM_ZAYAV_SAL := SUMA_GOL_BEZ_COM;
			END IF;				
			/*IF SUM_ZAYAV_SAL >= SUMAKS THEN
			   SUM_ZAYAV_SAL := SUM_ZAYAV_SAL - SUMAKS;
			END IF;	*/ --Хрень какая то
            IF (SUMA + SUM_DEN) <= SUM_ZAYAV_SAL THEN
			    varRet:= 0; goto nnn;
			ELSIF SUM_DEN >= SUM_ZAYAV_SAL THEN
			    varRet:= SUMA; goto nnn;
			ELSIF SUM_DEN < SUM_ZAYAV_SAL AND (SUM_DEN + SUMA) > SUM_ZAYAV_SAL THEN
			    varRet:= (SUM_DEN + SUMA) - SUM_ZAYAV_SAL; goto nnn;
			END IF;
			varRet:= 0;				 goto nnn;
		ELSIF P_PAR like 'СУММА_РКОМ_ЗАЙМЫ%' THEN
			&OpDate;
			BEGIN
		         LOCATE MN_REF IN ::[MAIN_DOCUM] WHERE MN_REF%ID = RKO;
				 EXCEPTION WHEN NO_DATA_FOUND THEN
						mn_ref:=coalesce(::[PATTERN_DOC].[BUSINESS_OP].doc_ref,md,mn_ref,P_DOC); --Башкиров В.Г. 19.09.2019
			END;
			PSH_VID_MD := ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_VID_DOC; -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
			PSH_ACC_DT_MD := ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_ACC_DT; -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
			PSH_SUMA := ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_SUMA; -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
			IF ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_VID_DOC IS NOT NULL OR ::[MAIN_DOCUM].[PSH_NEW_KASSA].PSH_ACC_DT IS NOT NULL THEN -- updated CHANGE_SHORT_NAME NEW_KASSA_EXT->PSH_NEW_KASSA 26/08/14
				IF PSH_VID_MD.[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR PSH_ACC_DT_MD.[MAIN_USV].[NUM] = '20202' THEN
				   varRet:= 0; goto nnn;
				END IF;	
			END IF;	
			IF MN_REF.[VID_DOC].[CODE] IN ('КАСС_ПРИХОД_ОРД', 'КАСС_ОБЪЯВ_ВЗНОС') OR MN_REF.[ACC_DT].[MAIN_USV].[NUM] = '20202' THEN
			   varRet:= 0; goto nnn;
			END IF;				
			SUMA_DOC := NVL(MN_REF.[SUM], PSH_SUMA);
			SUM_ZAYAV := 0;
			FOR i IN RKO.[DAILY] WHERE I.[DAT] = trunc(TODAY) AND I.[TO_ARM] IS NOT NULL
			LOOP
			    SUM_ZAYAV := I.[TO_ARM]; -- - NVL(I.[SALARY],0);
			    &debug('TO_ARM =>>>>>>>'||I.[TO_ARM],dp)
			    &debug('SUM_ZAYAV =>>>>>>>'||SUM_ZAYAV,dp)
			END LOOP;

			IF SUM_ZAYAV < SUMA_GOL_BEZ_COM  AND SUMA_DOC <= SUMA_GOL_BEZ_COM THEN
			   SUM_ZAYAV := SUMA_GOL_BEZ_COM;
			END IF;	
			SUM_DEN := GET_SUM_OBOR_DN(RKO, 'СУММА_РКОМ_ЗАЙМЫ');
			SUM_MONTH := GET_SUM_OBOR_MONTH(RKO, 'СУММА_РКОМ_ЗАЙМЫ');
			
			declare
				ksim ref [SUM_SYMKS];
			begin
				FOR R IN RKO.[ARRAY_OPER_DOG] WHERE R.[FIRST_DOC] = MN_REF
				LOOP
                   FOR SYM in mn_ref.[SUM_KSPL] WHERE SYM.[1].[1] = R.[SYM_KS].[1] AND R.[SYM_KS].[1] NOT IN ('40','41','50','58')
				   LOOP
					   SUMAKS := NVL(SUMA,0) + SYM.[2];
				   END LOOP;				
				END LOOP;			
				ksim := ::[RUNTIME].[STR].get_str_par(P_PATT, 'SUM_KS');
				if ksim.[1].[1] not in ('40','41','50','58') then --('42','53','54') then
					suma := ksim.[2];
				end if;
			end;

			/*IF SUM_ZAYAV >= SUMAKS THEN
			   SUM_ZAYAV := SUM_ZAYAV - SUMAKS;
			END IF;	*/ --Хрень какая то

			IF SUM_DEN IS NULL THEN
			   SUM_DEN := 0;
			END IF;

            &debug('SUM_DEN => '||SUM_DEN,dp)
            &debug('SUM_ZAYAV => '||SUM_ZAYAV,dp)
            &debug('SUM_MONTH => '||SUM_MONTH,dp)
            &debug('SUMA => '||SUMA,dp)

			if P_PAR = 'СУММА_РКОМ_ЗАЙМЫ1' THEN
			    IF NVL(SUM_DEN,0) > 0 OR NVL(SUM_MONTH,0) > 0 THEN
			      IF NVL(SUM_DEN,0) > 0 THEN
				      SUM_ZAYAV := SUM_ZAYAV - SUM_DEN;
				      IF SUM_ZAYAV < 0 THEN
				         SUM_ZAYAV := 0;
				      END IF;
			      END IF;			
			      IF (SUM_MONTH + SUMA) < SUMA_FIL_SH1 THEN
			         SUMA := SUMA;
			      ELSIF (SUM_MONTH + SUMA) > SUMA_FIL_SH1 THEN
			         IF SUM_MONTH < SUMA_FIL_SH1 THEN
			            SUMA := SUMA_FIL_SH1 - SUM_MONTH;
   			         ELSIF SUM_MONTH >= SUMA_FIL_SH1 THEN
   			            varRet:= 0; goto nnn;
			         END IF;			
			      END IF;
			    END IF;
			
