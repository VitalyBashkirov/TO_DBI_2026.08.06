	@name('Код банка плательщика (52)')                P_CODE_BANKPAY  in [STRING_35],
	@name('Наименование банка плательщика (52)')       P_NAME_BANKPAY  in [SWIFT_5X],
	@name('Код банка посредника (56)')                 P_CODE_BANKINT  in [STRING_35],
	@name('Наименование банка посредника (56)')        P_NAME_BANKINT  in [SWIFT_5X],
	@name('Код банка бенефициара (58)')                P_CODE_BANBEN   in [STRING_35],
	@name('Код банка получателя (57)')                 P_CODE_BANKREC  in [STRING_35],
	@name('Наименование банка получателя (57)')        P_NAME_BANKREC  in [SWIFT_5X],
	@name('Наименование получателя (59)')              P_RECEIVER      in [SWIFT_5X],
	@name('Детали расходов (71A)')                     P_CHARGE        in [CHARGES_REF],
	@name('Инф. отправителя получателю (72)')          P_CLINFO        in [MEMO],
	@name('Детали платежа (70)')                       P_DEST          in [MEMO],
	@name('Ссылочный идентификатор (20)')              P_TRN           in [STRING_16],
	@name('Выбор получателя')                          P_GET_RECEIVER  in [INTER_BEN_REF],
	@name('Договор списания')                          P_GET_INPUT     in [TRC_REF],
	@name('Вариант обработки')                         P_VAR           in [DOC_RC_VARIANT],
	@name('Договор зачисления')                        P_GET_OUTPUT    in [TRC_REF],
	@name('Курс сделки')                               P_RATE          in [SUPER_NUMBER],
	@name('Обратный курс')                             P_BACK_RATE     in [BOOLEAN],
	@name('Исходный документ')                         P_FIRST_REF     in [DOCUM_RC_REF],
	@name('Дополнительная информация')                 P_DOPINFO       in [MEMO_BIG],
	@name('Реквизиты МТ103')                           P_MT103         in [MT103],
	@name('Корреспондент отправителя (53)')            P_NAME_BANK_53  in [SWIFT_5X],
	@name('Код банка (53)')                            P_CODE_BANK_53  in [STRING_35],
	@name('Корреспондент получателя (54)')             P_NAME_BANK_54  in [SWIFT_5X],
	@name('Код банка (54)')                            P_CODE_BANK_54  in [STRING_35],
	@name('Третий банк возмещения (55)')               P_NAME_BANK_55  in [SWIFT_5X],
	@name('Код банка (55)')                            P_CODE_BANK_55  in [STRING_35],
	@name('Поставить на невыясненные')                 P_UKNOWN        in [BOOLEAN],
	@name('Филиал')                                    P_FILIAL        in [BRANCH_REF],
	@name('Счет плательщика')                          P_GET_PAYER     in [AC_FIN_REF],
	@name('Печать')                                    P_PRINT         in [BOOLEAN],
	@name('Банк-получатель')                           P_RECEIVER_BANK in [CL_BANK_F_REF],
	@name('Вид перевода (1/null-не опр, 2-кл, 3-бан)') P_KL_BNK        in [ONE_FROM_THREE]   default null,
	@name('Обязательная отчетность (77B)')             P_77B           in [MEMO],
	@name('Тип запроса n99')                           P_99_TYPE       in [ONE_FROM_THREE]
) is

validate is
	new_doc				[DOCUM_RC];
	new_doc_ref 		ref [DOCUM_RC];
	file_num			varchar2;
	tmp_in_iso 			ref [FT_MONEY];
	tmp_out_iso 		ref [FT_MONEY];
	err_msg				varchar2(250);
	v_string			[STRING_REC];
	v_23E_rec 			[SWIFT_23E_REC];
	lob_loc				CLOB;
	amount				integer := 32000;
	cnt					integer;
	v_add_len_70		number :=0;
	v_refid_list		varchar2(500);
	erm					[MEMO];
	procedure check_open_inv is	
	begin
		if V_APP_INV then
				--Если есть дело, новое открывать не надо
			if V_INV is not null then
				if ORI_DOC_RC.[TYPE_DOC] = '007' then
					V_OPEN_INV_INF := null;	
					csmd.Hide( V_VB, 'V_OPEN_INV_INF', 'V');
				else
					V_OPEN_INV := null;	
					csmd.Hide( V_VB, 'V_OPEN_INV', 'V');
				end if;
			else
				if ORI_DOC_RC.[TYPE_DOC] = '007' then
					V_OPEN_INV_INF	:= nvl(::[DEFVALS].[SLIB].RestoreBool(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'P_OPEN_INV_INF'),false);	
					csmd.Show( V_VB, 'V_OPEN_INV_INF', 'V');
				else
					V_OPEN_INV	:= nvl(::[DEFVALS].[SLIB].RestoreBool(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'P_OPEN_INV'),false);	
					csmd.Show( V_VB, 'V_OPEN_INV', 'V');
				end if;
				
			end if;
		end if;
	end;
		
	procedure put_to_47416(P_CHK_ACC boolean) is
		v_undef_dest	varchar2(4000);
		v_templ 		boolean;
	begin
		if P_CHK_ACC then
			if not((ORI_DOC_RC.[TYPE_DOC] in ('002', '004') and nvl(P_MAIN_DOC.[ACC_DT], 0) = ::[TRC].[LIB].calculate_acc(ORI_DOG_OUT, P_MAIN_DOC, null, true, 'STRANGE_ACC')) or
				(ORI_DOC_RC.[TYPE_DOC] not in ('002', '004') and nvl(P_MAIN_DOC.[ACC_KT], 0) = ::[TRC].[LIB].calculate_acc(ORI_DOG_OUT, P_MAIN_DOC, null, false, 'STRANGE_ACC')))
			then
				return;
			end if;
		end if;
		if in_iso != out_iso then -- на невыясненные не ставим, если есть конверсия платежа
			return;
		end if;
		if not ::[DOCUM_RC].[BUX_LIB].is_in(this) then -- BS00150726 п.1 если документ РЦ исходящий, то ничего не делаем
			return;
		end if;
		if V_UKNOWN = 'YES' then
			-- Удалим имеющуюся проводку, дабы не задублироваться
			::[DOCUM_RC].[LIB].delete_main_doc(this, true, false, false, 'DELETED');
			if ORI_DOC_RC.[TYPE_DOC] in ('002', '004') then
				P_MAIN_DOC := [LIB].create_main_doc(this, false, P_GET_OUTPUT, 'STRANGE_ACC');
				
				if this.[QUIT_DOC] is not null then
					P_MAIN_DOC.[EDIT_PROV](
				      ::[TRC].[LIB].calculate_acc(P_GET_OUTPUT, P_MAIN_DOC, null, true, 'STRANGE_ACC'),	-- Счет Дебет
				      ::[TRC].[LIB].calculate_acc(P_GET_INPUT, P_MAIN_DOC, null, true),					-- Вычислим прямой счет для договора
				      this.[QUIT_DOC]->(MAIN_DOCUM)[DATE_PROV]	-- если была квитовка, ставим на невыясненные тем же днем
					);
				
					V_MAIN_DOC := ::[DOCUM_RC].[SWIFT_DOC_LIB].get_docs_list_id(P_MAIN_DOC, null);
				else
					V_MAIN_DOC := ::[DOCUM_RC].[SWIFT_DOC_LIB].get_docs_list_id(P_MAIN_DOC, this.[QUIT_DOC]);
				end if;
			else
				P_MAIN_DOC := [LIB].create_main_doc(this, false, null, null, P_GET_OUTPUT, 'STRANGE_ACC');
				
				if this.[QUIT_DOC] is not null then	-- если к документу была сформирована квитовка
					P_MAIN_DOC.[EDIT_PROV](
				      ::[TRC].[LIB].calculate_acc(P_GET_INPUT, P_MAIN_DOC, null, true),						-- Вычислим прямой счет для договора
				      ::[TRC].[LIB].calculate_acc(P_GET_OUTPUT, P_MAIN_DOC, null, false, 'STRANGE_ACC'),	-- Счет Кредит
				      this.[QUIT_DOC]->(MAIN_DOCUM)[DATE_PROV]	-- если была квитовка, ставим на невыясненные тем же днем
					);
					
					V_MAIN_DOC := ::[DOCUM_RC].[SWIFT_DOC_LIB].get_docs_list_id(P_MAIN_DOC, null);
				else
					V_MAIN_DOC := ::[DOCUM_RC].[SWIFT_DOC_LIB].get_docs_list_id(P_MAIN_DOC, this.[QUIT_DOC]);
				end if;
			end if;
			::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'UNKNOWN', '1');
			P_MAIN_DOC.[TEXT_VOZV] := '[TO_UNDEF]'||[REFREASON]||[REFREASON2];
			
			-- Если установлена настройка 'MO_BO_47416',
			-- то формируем мем. ордер и меняем назначение платежа
			if ::[TRC].[GET_FLAG]('MO_BO_47416', null, this) then
				P_MAIN_DOC.[VID_DOC] := ::[NAME_PAYDOC]( [CODE] = 'БЕЗН_МЕМО_ОРД');
				P_MAIN_DOC.[DATE_DOC] := NVL(P_MAIN_DOC.[DATE_VAL], ::[SYSTEM].[VARIABLES].OpDate);
			end if;
			
			-- RP0092528 Если указана настройка, то берем назначение платежа из нее, иначе все работает по старому
			v_templ := ::[DOCUM_RC].[LIB_NEW].get_undef_templ(&METHOD$ID, this, P_MAIN_DOC, P_MAIN_DOC.[ACC_DT].[FINTOOL], v_undef_dest);
			if v_templ then
				P_MAIN_DOC.[NAZN] := v_undef_dest;
			elsif ::[TRC].[GET_FLAG]('MO_BO_47416', null, this) then
				P_MAIN_DOC.[NAZN] := 'Мем. ордер сформирован на основании МТ'||::[DOCUM_RC].[LIB_VIEW].get_type_doc_sform(this)||' референс '||::[DOCUM_RC].[LIB_VIEW].GetFirst(this).[ELDOCNUM]||' дата валютирования '||to_char(this.[VALDATE], 'DD.MM.YYYY');
			end if;
			
			P_UKNOWN := true;
		end if;
	end;
	
	procedure section_ok is
		v_doc ref [DOCUMENT];
		
		procedure change_receiver(p_doc ref [DOCUM_RC]) is
			v_esid ref [DOCUM_RC];
		begin
			-- Если включена настройка и документ входящий, то необходимо подменить участника получателя, т.к. докумет может прийти по межфилу
			if ::[TRC].[GET_FLAG]('MT19X_AUTO_ROUTE') and V_ORIG_EPD is not null and ORI_DOC_RC.[TYPE_DOC] = '007' and ::[DOCUM_RC].[BUX_LIB].is_in(::[DOCUM_RC].[MFIL_LIB_EXP].get_first_doc(p_doc)) then
				v_esid := ::[DOCUM_RC].[LIB_QA].get_original_swift(p_doc);
				::[DOCUM_RC].[PER_LIB].change_receiver(nvl(v_esid, V_ORIG_EPD), p_doc, ERR_MSG);
			end if;
		end;
	begin
	
		change_receiver(this);
	
		if ::[TRC].[GET_FLAG]('CONF_OPT', null, this) then
			&sp(conf_opt)
			this.[MAN_DOC_TO_PROV];
			last_error := [STR].get_str_par(this.[BLOCK_DATA], 'full_mess');
			&rb(conf_opt)
		end if;
		if (first_time and last_error is not null or V_ERRM is not null) and nvl(this.[FLAG_UPDATE], '*') <> '3' then
			V_ERRM := ::[DOCUM_RC].[PROC_DOCUM].ask(last_error);
			first_time := false;
		else
			if (ORI_DOG_IN != P_GET_INPUT or ORI_DOG_OUT != P_GET_OUTPUT) and ORI_DOG_OUT.[TYPE_DOG] != ::[CONTRACT_TYPE]([IDENT] = 'Z') then
				-- конверсия
				-- Если делаем конвертацию со сменой валюты в поле 32А
				new_doc := ::[DOCUM_RC].[COPY].next_doc( this, false, bool_char(P_VAR.[0] = 2, '1', '2'));
				-- BFS00032808 Имеет смысл только для МТ103
				if V_TYPED_COD like '103%' then
					-- 1) пишем курс в поле 36
					if P_MT103.[F_36] is null then
						new_doc.[MT103].[F_36] := P_RATE;
					end if;
					-- 2) рассчитываем сумму 33B
					if P_MT103.[F_33B] is null then
						if ORI_DOG_IN.[FINTOOL] != P_GET_INPUT.[FINTOOL] then
							-- Была конверсия по Дт
							new_doc.[MT103].[F_33B] :=	replace(  P_GET_INPUT.[FINTOOL].[CUR_SHORT], 'RUR', 'RUB') ||
								rtrim( TO_CHAR( nvl(::[DOCUM_RC].[LIB_VIEW].GetProv(this).[SUM], ORI_SUMMA), '9999999999999990D99','NLS_NUMERIC_CHARACTERS = '', ''' ), '0');							
						else
							new_doc.[MT103].[F_33B] :=	replace(  ORI_ISO.[CUR_SHORT], 'RUR', 'RUB') ||
								rtrim( TO_CHAR( ORI_SUMMA, '9999999999999990D99','NLS_NUMERIC_CHARACTERS = '', ''' ), '0');
						end if;
					end if;
				end if;
				new_doc.[ISO] := out_iso.[CUR_SHORT];
				new_doc.[SUMMA] := new_summa_doc;
				new_doc.[VALDATE] := P_VALDATE;
				new_doc.[MAIN_DOC] := P_MAIN_DOC;
				new_doc.[QUIT_DOC] := this.[QUIT_DOC];
				this.[QUIT_DOC] := null;
				
				new_doc.[DOPINFO] := 'NO_UPDATE'; -- Не менять документ при проводке документов
				
				if P_VAR.[0] = 2 then
					-- Новый уч.-получатель
					new_doc.[RCCLCODE] := V_READDR.[CODE];
					new_doc.[RECEIVER].[PART_REF] := V_READDR;
				end if;
	
				new_doc.[DOG_CR] := P_GET_INPUT;
				new_doc.[DOG_SD] := P_GET_INPUT;
				new_doc.[DOG_RC] := P_GET_OUTPUT;
				new_doc.[DONE] := this.[DONE];
	
				if ORI_DOC_RC.[TYPE_DOC] != '007' then
					new_doc.[CLINFO] := &SDL.str_to_swt(P_CLINFO,1,35,6);
				end if;
	
				if substr(V_TYPED_COD, 1, 2) = '20' then
					new_doc.[PAYER].[NAME] := substr(V_REF, 1, ORI_DOC_RC.[PAYER].[NAME]%size);
				end if;
	
				this.[MAIN_DOC] := null;
				this.[QUIT_DOC] := null;
				
				new_doc_ref := [DOCUM_RC]%insert(new_doc);
				
				::[DOCUM_RC].[LIB].init_data(new_doc_ref);
				
				if instr(V_MAIN_DOC, ',') > 0 then
					-- папка может висеть аппендиксом к документу РЦ
					--(kozlova) var v_doc ref [DOCUMENT];
					v_doc := P_MAIN_DOC.[IN_FOLDER];
					v_doc := nvl(v_doc, P_MAIN_DOC);
					::[DOCUM_RC].[RUN_BO].confirm_bo( v_doc, 'TO_MBR', P_VALDATE);
				end if;
	
				last_error := this.[REFREASON] || this.[REFREASON2];
				this.[NEXT_REF] := new_doc_ref;
				this.[OPER_MSG] := ::[DOCUMENT].ADD_MEMO( SYSDATE,
					'Произведена конвертация валюты. Создан порожденный документ с ID ' || new_doc_ref,
					this.[OPER_MSG] );
	
				if this%state <> 'S_16' then
					::[DOCUM_RC].[ADD_REC].COM := 'Произведена конвертация валюты. Создан порожденный документ с ID ' || new_doc_ref;
					this%state := 'S_16';
				end if;
	
				if this%state = 'S_16' then
					-- документ автоматом переоформился или переадресовался
					V_ERRM := null;
				elsif last_error is not null and nvl(this.[FLAG_UPDATE], '*') <> '3' then
					V_ERRM := ::[DOCUM_RC].[PROC_DOCUM].ask(last_error);
				else
					V_ERRM := null;
				end if;
				-- Обновление данных первичного документа
				if (::[TRC].[GET_FLAG]('UFEBS_SIGN_COS') or ::[TRC].[GET_FLAG]('COS_CR_FDATA')) and is_controlled_type then
					::[UFEBS_DATA_CONTR].[LIB].update_udc_fdoc(p_rDoc_rc == new_doc_ref, p_oDoc_rc == new_doc, p_oMT103 == new_doc.[MT103]);
				end if;	
			else
				if P_VAR.[0] = 7 and ORI_DOG_OUT != P_GET_OUTPUT and ORI_DOG_OUT.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'Z') then
					::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'p_rate', P_RATE); 			-- 16.03.10
					::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'p_back_rate', P_BACK_RATE); 	-- 16.03.10
				end if;
				if ORI_DOC_RC.[TYPE_DOC] != '007' then
					this.[CLINFO] := &SDL.str_to_swt(P_CLINFO,1,35,6);
				end if;
				if instr(V_MAIN_DOC, ',') > 0 then
					-- папка может висеть аппендиксом к документу РЦ
					v_doc := P_MAIN_DOC.[IN_FOLDER];
					v_doc := nvl(v_doc, P_MAIN_DOC);
					::[DOCUM_RC].[RUN_BO].confirm_bo( v_doc, 'TO_MBR', P_VALDATE);
				end if;
				if P_UKNOWN then
					if ::[TRC].[GET_FLAG]('SWIFT_USE_GPI') or (::[TRC].[GET_FLAG]('SWIFT_USE_UC') and ::[TRC].[GET_FLAG]('NEED_REASON_RJCT')) then
						::[RUNTIME].[STR].SET_PAR(this.[BLOCK_DATA], 'LAST_ERROR', ::[DOCUM_RC].[GPI_LIB].get_last_error(this));
					end if;
					if instr(this.[CHK], 'CR_MAIN') > 0  then
						-- Документ, поставленный на невыясненные суммы, не должен
						-- хранить сообщений об ошибках (иначе его не проведет автомат)
						if nvl( instr( this.[DONE], this.[CHK]||';' ), 0 ) = 0 then
							-- запомним эту ошибку для анализа в перечне ответных платежей
								this.[DONE] := SUBSTR( this.[DONE] || this.[CHK]||';', 1, this.[DONE]%size );
							end if;
						this.[CHK] := null ;
					end if;
					if this_state <> 'S_1' then
						if this_state = 'S_15' then
							this.[ANS_DOC_1].[REJECTED] := null; -- ribkin RP0630713 Сбросим признак, так как документ пошел на СНС и чтобы в дальнейшем он попал в выборку при сверке
						end if;
						
						::[DOCUM_RC].[ADD_REC].COM := 'Документ поставлен на счет невыясненных сумм';
						this%state := 'S_1';
				        if this.[VALDATE] > ::[TRC].[INI].TODAY then -- ETY 18.12.09 добавила переопределение ДПП, иначе при проводке для этого документа счет меняется на транзитный
					        var dpp	[DATE]; -- ДПП вычисляется с учетом DUE_PERIOD
					        dpp := ::[DOCUM_RC].[CHK_LIB].get_DPP(this, this.[DOG_RC]);
					        if dpp > ::[TRC].[INI].TODAY then
						        this.[BEGDATE] := dpp;
					        end if;
				        end if;
					end if;
					if ORI_DOG_IN.[TYPE_DOG] <> ::[CONTRACT_TYPE]([IDENT] = 'Z') then
						this.[DOG_RC] := ::[TRC].[LIB].get_dog(::[TRC].[INI].OUR_PART, err_msg, false, P_ISO);
					end if;
					if this.[QUIT_DOC] is not null then  -- при постановке на невыясненные всегда удаляем квитовку
						::[DOCUM_RC].[LIB].delete_main_doc(this, true, true);
					end if;
					
					return;
				end if;
				this.[DOG_SD] := P_GET_INPUT;
				this.[DOG_RC] := P_GET_OUTPUT;
	
				change_receiver(this);
				
				this.[MAN_DOC_TO_PROV];
	
				last_error := [REFREASON]||[REFREASON2];
				if this%state in  ('S_7','S_16') then
					-- документ автоматом переоформился или переадресовался
					V_ERRM := null;
				elsif last_error is not null and nvl(this.[FLAG_UPDATE], '*') <> '3' then
					V_ERRM := ::[DOCUM_RC].[PROC_DOCUM].ask(last_error);
				else
					V_ERRM := null;
				end if;
			end if;
		end if;		
	end;

BEGIN	
	if P_MESSAGE = 'DEFAULT' then
		V_VB := null;
		csmd.init_form( V_VB, 'DOCUM_RC', 'PROC#VD_3');
	
		ORI_DOC_RC	:= this;
		
		-- Проверка контекста
		::[TRC].[LIB_MFIL].check_context(ORI_DOC_RC.[FILIAL]);
		
		-- Кэшируем исходные данные о документе
		ORI_MT103 					:= ORI_DOC_RC.[MT103];
		P_MT103						:= ORI_MT103;
		ORI_SUMMA = P_SUMMA = new_summa_doc	:= ORI_DOC_RC.[SUMMA];
		v_summa						:= nvl(&LV.get_first_summa(ORI_DOC_RC%id), P_SUMMA);
		ORI_ISO = P_ISO 			:= ::[FT_MONEY].[LIB].Get_Money(ORI_DOC_RC.[ISO], 1);
		ORI_MAIN_DOC 				:= ORI_DOC_RC.[MAIN_DOC];
		ORI_DOG_IN = P_GET_INPUT 	:= ORI_DOC_RC.[DOG_SD];
		ORI_DOG_OUT = P_GET_OUTPUT	:= ORI_DOC_RC.[DOG_RC];
			
		-- Запомним валюту счета получателя
		acc_rc_fintool := nvl(::[DOCUM_RC].[LIB_VIEW].GetProv(this).[ACC_KT].[FINTOOL], ORI_DOG_OUT.[FINTOOL]);
		
		begin
			select x(x%id, x.[NAME], x.[SFORM]) in ::[TYPE_DOC_RC]
				where x.[NUM_CODE] = ORI_DOC_RC.[TYPE_DOC] and nvl(x.[UT], '*') = nvl(ORI_DOC_RC.[SUB_TYPE], '*')
				into P_TYPE_DOC, V_TYPED_NAME, V_TYPED_COD;
		exception when NO_DATA_FOUND or TOO_MANY_ROWS then
			pragma error('Не найден тип документа РЦ "' || ORI_DOC_RC.[TYPE_DOC] || '.' || ORI_DOC_RC.[SUB_TYPE] || '"');
		end;
		is_controlled_type := ::[UFEBS_DATA_CONTR].[LIB].is_controlled_type(this,  P_TYPE_DOC.[SFORM]);
		-- Контроль реквизитов на соответствие данным первичного документа
		if ::[TRC].[GET_FLAG]('UFEBS_SIGN_COS') and is_controlled_type then
			erm := ::[UFEBS_DATA_CONTR].[LIB].doc_data_control(p_rDoc_rc == this, p_oDoc_rc == ORI_DOC_RC, p_oMT103 == ORI_MT103);
			if erm is not null then
				pragma error('Ошибка контроля реквизитов: '||erm);
			end if;
		end if;
		--Установка контекстов для представлений опций
		&SDL.set_option_contexts(V_TYPED_COD, P_PAYER.[OPTION]
											, P_NAME_BANKPAY.[OPTION]
											, P_NAME_BANK_53.[OPTION]
											, P_NAME_BANK_54.[OPTION]
											, P_NAME_BANK_55.[OPTION]
											, P_NAME_BANKINT.[OPTION]
											, P_NAME_BANKREC.[OPTION]
											, V_OPT58
											, P_RECEIVER.[OPTION]);

		-- Параметры
		P_FILIAL		:= ORI_DOC_RC.[FILIAL];
		P_TRN 			:= ORI_DOC_RC.[ELDOCNUM];
		P_NUMBER_DOC 	:= ORI_DOC_RC.[NUMBER_DOC];
		P_CRDATE 		:= ORI_DOC_RC.[CRDATE];
		-- Если был выход из области тиражирования
		P_SDCL 			:= nvl(ORI_DOC_RC.[ORIGINAL].[DOG_SD].[CLIENT], ORI_DOC_RC.[PAYER].[PART_REF]);
		P_RCCL 			:= ORI_DOC_RC.[RECEIVER].[PART_REF];
		P_SUMMA 		:= ORI_DOC_RC.[SUMMA];
		P_VALDATE 		:= nvl(ORI_DOC_RC.[VALDATE], ::[TRC].[INI].TODAY);
		P_MAIN_DOC 		:= ORI_DOC_RC.[MAIN_DOC];
		P_FIRST_REF 	:= ORI_DOC_RC.[FIRST_REF];
		P_MSGTYPE 		:= [DOCUM_RC]::[BUX_LIB].get_message_type(ORI_DOC_RC.[MSGTYPE]);
		if V_TYPED_COD = 'SWT' then
	   		begin
		   		select x(x.[TEXT]) in ::[SWIFT_RAW_DATA] where x.[DOC_RC] = this into lob_loc;
		   		if lob_loc is null then
		   			P_DOPINFO := 'Текст отсутствует';
		   		else
					DBMS_LOB.READ(lob_loc, amount, 1, P_DOPINFO);
		   		end if;
		   	exception when NO_DATA_FOUND then
		   		P_DOPINFO := ORI_DOC_RC.[DOC_TEXT] || ORI_DOC_RC.[DOPINFO];
	   		end;
		else
			--KL P_DOPINFO 		:= replace(replace(ORI_DOC_RC.[DOC_TEXT] || ORI_DOC_RC.[DOPINFO], ';', ' '), 'NO_UPDATE');
			vTextExpDoc := null;
			if ::[DOCUM_RC].[BUX_LIB].is_in(::[DOCUM_RC].[LIB_VIEW].GetFirst(this)) then --KL
				vTextFirstDoc := replace(replace(ORI_DOC_RC.[DOC_TEXT], chr(1)), chr(3)); --KL
			else
				vTextFirstDoc := null;
			end if;			
		end if;
		-- Поле 72
		P_CLINFO  := &SDL.str_to_swt(ORI_DOC_RC.[CLINFO],1,35,6);
		-- Поля 50, 52
		&SDL.part_to_swift(ORI_DOC_RC.[PAYER], P_PAYER, P_NAME_BANKPAY, P_CODE_BANKPAY);
		-- Поле 53,54,55,56
		&SDL.ben_to_swift( ORI_MT103.[F_53], P_NAME_BANK_53, P_CODE_BANK_53);
		&SDL.ben_to_swift( ORI_MT103.[F_54], P_NAME_BANK_54, P_CODE_BANK_54);
		&SDL.ben_to_swift( ORI_MT103.[F_55], P_NAME_BANK_55, P_CODE_BANK_55);
		&SDL.ben_to_swift( ORI_DOC_RC.[INT], P_NAME_BANKINT, P_CODE_BANKINT);
		-- Поле 57
		&SDL.part_to_swift(ORI_DOC_RC.[RECEIVER], P_RECEIVER, P_NAME_BANKREC, P_CODE_BANKREC);
		-- Поле 58
		if substr(V_TYPED_COD, 1, 2) = '20' then
			&SDL.ben_to_swift(ORI_DOC_RC.[BEN], P_RECEIVER, P_CODE_BANBEN, true);
			V_OPT58 := P_RECEIVER.[OPTION];
		end if;
		
		-- Поле 70, Если новый формат, то добавляем 3*NL$
		if instr(ORI_DOC_RC.[DEST], NL$) > 0 then
			v_add_len_70 := 3*length(NL$);
		end if;
		P_DEST := &SDL.str_to_swt(SUBSTR( ORI_DOC_RC.[DEST], 1, 140+v_add_len_70));

		-- Поле 71
		begin
			P_CHARGE := ::[CHARGES]([VALUE] = ORI_DOC_RC.[CHARGPAY]);
		exception when NO_DATA_FOUND then
			null;
		end;
		P_RATE := 1;

		--Обязательная отчетность (77B)
		P_77B := &SDL.str_to_swt(&VCHK.swift_to_str(ORI_MT103.[F_77B]), 1, 35, 3);

		-- Переменные
		if substr(V_TYPED_COD, 1, 2) in ('10', '20') then
			V_PANEL.[0]	:= 1;
		elsif V_TYPED_COD = 'SWT' then
			V_PANEL.[0]	:= 4;
		else
			V_PANEL.[0]	:= 3;
		end if;
		V_BPNAME 		:= ORI_DOC_RC.[PAYER].[RB];
		V_BRNAME 		:= ORI_DOC_RC.[RECEIVER].[RB];
		if P_SDCL = ::[TRC].[INI].SWIFT_PART then
			V_PPNAME	:= ORI_MT103.[RECEIVER_BANK].[NAME];
		else
			V_PPNAME 	:= P_SDCL.[NAME];
		end if;
		if P_RCCL = ::[TRC].[INI].SWIFT_PART then
			V_PRNAME	:= ORI_MT103.[RECEIVER_BANK].[NAME];
		else
			V_PRNAME	:= P_RCCL.[NAME];
		end if;
		V_PNAME 		:= ORI_DOC_RC.[PAYER].[RN];
		V_RNAME  		:= ORI_DOC_RC.[RECEIVER].[RN];
		V_BINAME 		:= &LV.get_bank_name(ORI_DOC_RC.[INT].[BANK]);
		V_BBNAME 		:= &LV.get_bank_name(ORI_DOC_RC.[BEN].[BANK]);
		
		-- BS00484035 Получаем коды стран банка и получателя
		[STR].GET_PAR(this.[BLOCK_DATA], 'REC_COUNTRY', V_REC_COUNTRY);
		[STR].GET_PAR(this.[BLOCK_DATA], 'REC_BANK_COUNTRY', V_REC_BANK_COUNTRY);
		
		--Проверка корректности заполнения стран, на случай, если вместо ИД страны там что-то другое
		if V_REC_COUNTRY is not null then
			select x(count(1)) in ::[COUNTRY] where x%id = V_REC_COUNTRY into cnt;
			if cnt = 0 then
				stdio.put_line_buf('Неверный ID страны получателя - ' || V_REC_COUNTRY);
				V_REC_COUNTRY :=null;
			end if;
		end if;
		
		if V_REC_BANK_COUNTRY is not null then 		
			select x(count(1)) in ::[COUNTRY] where x%id = V_REC_BANK_COUNTRY into cnt;
			if cnt = 0 then
				stdio.put_line_buf('Неверный ID страны банка получателя - ' || V_REC_BANK_COUNTRY);
				V_REC_BANK_COUNTRY :=null;
			end if;
		end if;
		
		-- Поле 21
		if ORI_DOC_RC.[TYPE_DOC] = '007' or V_TYPED_COD like '202%' then
			V_REF := SUBSTR( nvl( ORI_DOC_RC.[PAYER].[NAME], 'NONREF'), 1, 16);
		end if;

		-- RP0013708 Проверка приложения "Расследования SWIFT"
		v_inf_inv := null;
		v_inf_epd := null;
		v_inf_is_in := null;
		v_one_esid := null;
		v_99_type := null;
		
		V_APP_INV := ::[INVESTIGATION].[LIB].check_swift_app;
		--Заполнение опций открытия дела
		if V_APP_INV then
			V_OPEN_INV	:= nvl(::[DEFVALS].[SLIB].RestoreBool(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'P_OPEN_INV'),false);
			V_OPEN_INV_INF	:= nvl(::[DEFVALS].[SLIB].RestoreBool(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'P_OPEN_INV_INF'),false);
			V_CREATE_MT195	:= nvl(::[DEFVALS].[SLIB].RestoreBool(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME,'P_CREATE_MT195'),false);
		end if;
		
		-- Поля переписки
		if ORI_DOC_RC.[TYPE_DOC] = '007' then
			v_inf_is_in := ::[DOCUM_RC].[BUX_LIB].is_in(this);
			
			-- Поле 11
			V_TYPE11  := substr( ORI_DOC_RC.[PAYER].[INN], 1, 1);
			V_VALUE11 := substr( ORI_DOC_RC.[PAYER].[INN], 2, V_VALUE11%size);
			-- Поле 77
			--(kozlova) V_COMMENT := ::[DOCUM_RC].[SWIFT_SB].str2swift( ORI_DOC_RC.[CLINFO], 30, 35, NL$);
			V_COMMENT := rtrim(substr(ORI_DOC_RC.[CLINFO], 1, 6*(35 + length(NL$))-length(NL$))); --(kozlova)
			V_77A := substr(ORI_DOC_RC.[CLINFO], 6*(35 + length(NL$))-length(NL$) + 1); --(kozlova)
			-- Поле 79
			V_DOPINFO := ORI_DOC_RC.[DEST];
			
			--Заполнение исходного документа, необходмо также заполнить при изменении.
			--Также проверять если найдено много документов, то давать на выбор только из них
			V_ORIG_EPD := ::[DOCUM_RC].[LIB_QA].get_original_swift(this);
			V_ORIG_EPD := ::[DOCUM_RC].[LIB_VIEW].GetLast(V_ORIG_EPD);
			
			if V_ORIG_EPD is null then
				--Если много документов, необходимо присвоить фильтр
				if ::[RUNTIME].[STR].get_bool_par(this.[BLOCK_DATA], 'MANY_DOCS') then
					v_refid_list := ::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'MANY_DOC_IDS');
					if v_refid_list is not null then	-- RP0531669 если найдено более 10 "исходных" докуметов, их перечень не сохраняется и фильтр не накладывается
						csmd.Set_Validate_Prop( V_VB, 'V_ORIG_EPD', 'V', '.ViewFilter ="ID in ('|| v_refid_list ||')" ', true);
					end if;
				end if;
			else
				--Получаем референс
				v_inf_epd := V_ORIG_EPD;
				V_ORIG_DOC_NUM := ::[DOCUM_RC].[LIB_QA].get_reference(V_ORIG_EPD);
				
				--Если документ исходящий, то нельзя менять исходный документ
				if not v_inf_is_in then
					csmd.Set_Validate_Prop( V_VB, 'V_ORIG_EPD', 'V', '.ViewFilter ="ID = '|| V_ORIG_EPD%id ||'" ', true);
					v_one_esid := true;
				end if;
			end if;
			
			--Если дело открыто по текущему документу
			v_esid_inv := ::[INVESTIGATION].[LIB].get_inv_on_esid(this);
			
			if v_esid_inv is not null then
				v_epd_inv := ::[INVESTIGATION].[LIB].get_inv_on_epd(V_ORIG_EPD);
				--Исходный финансовый документ также исходный по делу
				if v_epd_inv = v_esid_inv then
					csmd.Set_Validate_Prop( V_VB, 'V_ORIG_EPD', 'V', '.ViewFilter ="ID = '|| V_ORIG_EPD%id ||'" ', true);
					v_one_esid := true;
				else
					--Исходный документ привязан к текущему делу
					v_rd_inv := ::[INVESTIGATION].[LIB].get_inv_on_epd(::[DOCUM_RC].[LIB_VIEW].GetFirst(V_ORIG_EPD));
					if v_rd_inv = v_esid_inv then
						csmd.Set_Validate_Prop( V_VB, 'V_ORIG_EPD', 'V', '.ViewFilter ="ID = '|| V_ORIG_EPD%id ||'" ', true);						
						v_one_esid := true;
					end if;
				end if;
			end if;			
			csmd.Show( V_VB, 'V_ORIG_EPD', 'V');
			csmd.Show( V_VB, 'V_ORIG_DOC_NUM','V');
		else
			--Для финансовых документов заполним информационные документы
			V_STR_INF_DOCS := ::[RC_LINK].[LIB].get_links_to_str(::[DOCUM_RC].[LIB_VIEW].GetFirst(this), ::[RC_LINK_TYPE]([CODE]='ORIG_EPD(drc_drc)'), 'last_doc_rc');
			if V_STR_INF_DOCS is not null then
				csmd.Show( V_VB, 'V_INF_DOCS', 'V');
			end if;
		end if;

		::[DOCUM_RC].[SWIFT_DOC_LIB].getRelDocs(this, V_LD_STR, V_BC);
		
		--Дела по переписке
		if V_APP_INV then
			V_INV := ::[INVESTIGATION].[LIB].get_inv(this);
			v_99_type := P_99_TYPE.[0];
			
			if V_INV is not null then
				csmd.Show( V_VB, 'V_INV', 'V', true);
				--Сохраняем дело, если есть
				v_inf_inv := V_INV;
			else
				csmd.Set_Validate_Prop( V_VB, 'V_INV', 'V', '.ViewFilter ="1=1" ', true);
			end if;
			
			--Для информационных документов
			if ORI_DOC_RC.[TYPE_DOC] = '007' and V_TYPED_COD <> '103' then
				--Выводим номер дела
				csmd.Show( V_VB, 'V_INV', 'V');
				if V_INV is null then
					csmd.Show( V_VB, 'V_OPEN_INV_INF', 'V');
				else
					V_OPEN_INV_INF := null;
				end if;
				--Для запроса n99 выводим вариант обработки
				if substr(V_TYPED_COD, 2, 2) = '99' then
					P_99_TYPE.[0] := ::[RUNTIME].[STR].get_num_par(this.[BLOCK_DATA], 'P_99_TYPE');
					csmd.Show( V_VB, 'P_99_TYPE', 'P');
				end if;
			end if;
			
		end if;
		-- //RP0013708		
		
		if ORI_MT103.[F_23B] is not null then
			begin
				V_23B := ::[VAL_CODE_23B]([CODE] = ORI_MT103.[F_23B]);
			exception when NO_DATA_FOUND then
				null;
			end;
		end if;
		V_13C.delete;
		V_23E.delete;
		V_71F.delete;
		for i in P_MT103.[F_13C]
		loop
			V_13C(nvl(V_13C.last, 0) + 1) := i;
		end loop;
		for i in P_MT103.[F_23E]
		loop
			v_string := i;
			begin
				v_23E_rec.[CODE] := ::[VAL_INSTR23]([CODE] = substr(v_string.[STRING], 1, 4));
			exception when NO_DATA_FOUND then
				v_23E_rec.[CODE] := null;
			end;
			if substr(v_string.[STRING], 5, 1) = '/' then
				v_23E_rec.[ADD_INFO] := substr(v_string.[STRING], 6);
			else
				v_23E_rec.[ADD_INFO] := null;
			end if;
			V_23E(nvl(V_23E.last, 0) + 1) := v_23E_rec;
		end loop;
		for i in P_MT103.[F_71F] order by i%id
		loop
			V_71F(nvl(V_71F.last, 0) + 1) := i;
		end loop;
		
		in_dog := P_GET_INPUT;
		in_iso := P_GET_INPUT.[FINTOOL];
		out_dog := P_GET_OUTPUT;
		out_iso := P_GET_OUTPUT.[FINTOOL];

		P_UKNOWN := nvl(::[RUNTIME].[STR].get_str_par(ORI_DOC_RC.[BLOCK_DATA], 'UNKNOWN') = '1', false);
		V_UKNOWN := null;
		if ORI_DOG_OUT.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'Z') and ORI_DOC_RC.[TYPE_DOC] != '007' /*and in_iso = out_iso*/ then	-- BS00584188, avs 25/11/13 конверсию тоже надо ставить на н/с
			V_UKNOWN := 'YES';
		end if;

		this_state := this%state;
		first_time := true;
		if this_state = 'S_15' then
			V_STATE := 'S_15';
		elsif this_state not in ('S_3','S_4','S_5', 'S_6','S_8','S_9') then
			pragma error('Обработка документа в состоянии ' || lib.state_name( this_state, 'DOCUM_RC') || ' невозможна');
		elsif this.[FLAG_UPDATE] = '3' and this_state = 'S_6' then
			pragma error ('Документ находится в очереди особого контроля!'||NL$||'Для его обработки воспользуйтесь специализированной операцией!');
		end if;
		
		if &LV.is_COM_BEN(P_CHARGE, doc_rc == this) and  not nvl(::[RUNTIME].[STR].get_str_par(ORI_DOC_RC.[BLOCK_DATA], 'TAKE_COM_BEN'), false) and P_GET_OUTPUT.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'N') then
			set_71( P_ISO, P_CHARGE, P_MT103, P_GET_INPUT, P_SUMMA, v_summa, this, P_GET_PAYER);
		end if;

		-- Умолчательное действие
		if this_state in ('S_5', 'S_7') then
			-- dpp1 проводку создаем только если ДПП не больше текущего опердня
			if ORI_DOC_RC.[BEGDATE] <= ::[TRC].[INI].TODAY then
				::[DOCUM_RC].[LIB].create_main_doc(this);
			end if;
			P_MAIN_DOC := this.[MAIN_DOC];
			P_VAR.[0] := 7;	-- На проводку
			V_STATE := 'PROV';
			-- 25.03.10
			if acc_rc_fintool != ORI_DOG_OUT.[FINTOOL] then
			 -- если валюта счета проводки по кредиту не совпадает с валютой договора рц по кредиту, поищем договор рц в нужной валюте
				P_GET_OUTPUT := nvl(::[TRC].[LIB].get_dog(/*::[DOCUM_RC].[LIB_VAL].get_part_val(this),*/ P_RCCL, -- BS00478139 avs 29/04/13 при подтверждении документа берем участника на которого он уже идет, а не тот который вычислится - участника надо менять (только?) при переадресации
															err_msg,
															false,
															acc_rc_fintool)
															, P_GET_OUTPUT);
				-- определим новый курс
				tmp_out_iso := P_GET_OUTPUT.[FINTOOL];
				out_dog := P_GET_OUTPUT;
				out_iso := tmp_out_iso;
				P_RATE := ::[DOCUM_RC].[VCHK_NEW].[CALC_RATE](in_iso, out_iso, &LV.get_date_rate(P_GET_INPUT, P_VALDATE));
				P_BACK_RATE := true;
/*				if P_BACK_RATE then -- необходимо, если поднят признак обратного курса --16.03.10		
					P_RATE := 1 / P_RATE;
				end if;*/
			end if;			
			-- 25.03.10
		elsif this_state = 'S_9' and ORI_DOC_RC.[TYPE_DOC] = '007' then
			P_VAR.[0] := 7;	-- На проводку
			V_STATE := 'PROV';
		elsif this_state = 'S_9' then
			P_VAR.[0] := 2;	-- Переадресовать
			-- avs 23.01.13 BS00467576 не будем создавать проводку - она сформируется (если ее еще нет) уже при обработке переадресованного документа
			-- dpp1 проводку создаем только если ДПП не больше текущего опердня
/*			if ORI_DOC_RC.[BEGDATE] <= ::[TRC].[INI].TODAY then
				::[DOCUM_RC].[LIB].create_main_doc(this);
			end if;*/
			P_MAIN_DOC := this.[MAIN_DOC];
			-- В ст.9 всегда находятся документы, для которых стандартных образом (через get_part_val)
			-- не удалось опредлить уч.-получателя; поэтому пытаемся найти более гибким способом
			V_READDR := ::[DOCUM_RC].[LIB_VAL].get_part_val( this);
			V_STATE := 'READDR';
		elsif this_state = 'S_6'  then
			-- dpp1 проводку создаем только если ДПП не больше текущего опердня
			if ORI_DOC_RC.[BEGDATE] <= ::[TRC].[INI].TODAY then
				::[DOCUM_RC].[LIB].create_main_doc(this, false);
			end if;
			P_MAIN_DOC := this.[MAIN_DOC];

			-- 03.11.10
			acc_rc_fintool := nvl(P_MAIN_DOC.[ACC_KT].[FINTOOL], ORI_DOG_OUT.[FINTOOL]);
			if acc_rc_fintool != ORI_DOG_OUT.[FINTOOL] then
			 -- если валюта счета проводки по кредиту не совпадает с валютой договора рц по кредиту, поищем договор рц в нужной валюте
				P_GET_OUTPUT := nvl(::[TRC].[LIB].get_dog(/*::[DOCUM_RC].[LIB_VAL].get_part_val(this),*/ P_RCCL, -- BS00478139 avs 29/04/13 при подтверждении документа берем участника на которого он уже идет, а не тот который вычислится - участника надо менять (только?) при переадресации
															err_msg,
															false,
															acc_rc_fintool)
															, P_GET_OUTPUT);
				-- определим новый курс
				tmp_out_iso := P_GET_OUTPUT.[FINTOOL];
				out_dog := P_GET_OUTPUT;
				out_iso := tmp_out_iso;
				P_RATE := ::[DOCUM_RC].[VCHK_NEW].[CALC_RATE](in_iso, out_iso, &LV.get_date_rate(P_GET_INPUT, P_VALDATE));
				P_BACK_RATE := true;
			end if;			
			-- 03.11.10
			
			P_VAR.[0] := 1;	-- Подтвердить отказ
			V_STATE := 'REJECT';
		elsif this_state = 'S_15'  then
			if ORI_DOG_IN.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'N')
			 and ORI_DOG_OUT.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'L')
			 and ORI_DOG_OUT.[ACC_OVERD] is not null then
				V_STATE := 'REJECTED_FROM_FIL';
				P_VAR.[0] := 7;
				if ::[DOCUM_RC].[LIB].is_prov(P_MAIN_DOC) then	-- сразу пробуем ликивидировать проводку
					::[DOCUM_RC].[LIB].delete_main_doc(this);
					if P_MAIN_DOC%state = 'DELETED' then
						P_MAIN_DOC%state := 'TO_MBR';
					end if;
				end if;
				V_UKNOWN := 'YES';
				put_to_47416(false);
			else
				P_VAR.[0] := 3;
				V_STATE := 'S_15';
			end if;
		end if;
		V_MAIN_DOC := ::[DOCUM_RC].[SWIFT_DOC_LIB].get_docs_list_id( P_MAIN_DOC, this.[QUIT_DOC]);
		if in_iso != out_iso then
-- 16.03.10-- 16.03.10-- 16.03.10-- 16.03.10-- 16.03.10		
--			P_RATE := P_MT103.[F_36];
--			if P_RATE is null then
				P_RATE := ::[RUNTIME].[STR].GET_NUM_PAR(this.[BLOCK_DATA], 'p_rate'); -- 16.03.10
				P_BACK_RATE := nvl(::[RUNTIME].[STR].GET_BOOL_PAR(this.[BLOCK_DATA], 'p_back_rate'), true); -- 16.03.10
				if P_RATE is null then
					P_RATE := P_MT103.[F_36];
					if P_RATE is null then
						P_RATE := ::[DOCUM_RC].[VCHK_NEW].[CALC_RATE](in_iso, out_iso, &LV.get_date_rate(P_GET_INPUT, P_VALDATE));
					end if;
				end if;
--			end if;
		end if;
-- 16.03.10-- 16.03.10-- 16.03.10-- 16.03.10-- 16.03.10		
				
		last_error := ORI_DOC_RC.[REFREASON] || ORI_DOC_RC.[REFREASON2];
		P_VAR.[REJECT].[REZ] := last_error;
		if ORI_DOC_RC.[REFTYPE] is not null then
			begin
				select x(x%id, substr(nvl(last_error, x.[NAME]), 1, P_VAR.[REJECT].[REZ]%size)) in ::[REJECT]
					where x.[CODE] = ORI_DOC_RC.[REFTYPE]
					into P_VAR.[REJECT].[CODE], P_VAR.[REJECT].[REZ];
			exception when NO_DATA_FOUND then
				null;
			when TOO_MANY_ROWS then
				begin
					select x(x%id, substr(nvl(last_error, x.[NAME]), 1, P_VAR.[REJECT].[REZ]%size)) in ::[REJECT]
						where x.[CODE] = ORI_DOC_RC.[REFTYPE] and x.[ERR_CLASS]= 'E'
						into P_VAR.[REJECT].[CODE], P_VAR.[REJECT].[REZ];
				exception when NO_DATA_FOUND or TOO_MANY_ROWS then
					null;
				end;
			end;
		else
			P_VAR.[REJECT].[CODE] := ::[REJECT]([CODE] = '600' and [ERR_CLASS] = 'E');
		end if;

		if not P_UKNOWN and ::[DOCUM_RC].[BUX_LIB].is_in(this) then
			if (ORI_DOC_RC.[TYPE_DOC] in ('002', '004') and P_MAIN_DOC.[ACC_DT] = ::[TRC].[LIB].calculate_acc(ORI_DOG_OUT, P_MAIN_DOC, null, true, 'STRANGE_ACC')) or
			   (ORI_DOC_RC.[TYPE_DOC] not in ('002', '004') and P_MAIN_DOC.[ACC_KT] = ::[TRC].[LIB].calculate_acc(ORI_DOG_OUT, P_MAIN_DOC, null, false, 'STRANGE_ACC'))
			then
				P_UKNOWN := true; -- BS00132505
			end if;
		end if;

		if ::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'MX_REF') is not null then
			declare
				mxClob 		clob;
				mxFileName 	string;
				tmpBlob 	blob;
			begin
				mxClob 	   := ::[ISO_MESSAGE].[LIB].getIsoText(this);
				if mxClob is not null and coalesce(dbms_lob.getlength(mxClob),0) < 20000 then
					V_MX := mxClob;
				elsif mxClob is not null and dbms_lob.getlength(mxClob) > 0 then
					V_MX := substr(mxClob,1,20000)||'...';
					dbms_lob.createtemporary( tmpBlob, false );
					::[RUNTIME].[LOB_UTILS].clob2blob(tmpBlob, mxClob, 'CL8MSWIN1251') ;	
					init_blob(tmpBlob);
					mxFileName := ::[ISO_MESSAGE].[LIB].getIsoFileName(this);
					csmd.command(V_VB, 'openFileMx_Btn.Visible = true');
					csmd.command(V_VB, 'openFileMxFIleName.Caption = "'||mxFileName||'"');
				else
					V_MX := mxClob;
				end if;	
			end;
		end if;

		if V_TYPED_COD in ('103', '103+','200', '202') then
			V_URGENT := this.[HOWLONG] = '1';
			csmd.command(V_VB, 'urg.Enabled = false');
		else
			csmd.command(V_VB, 'urg.Visible = false');
		end if;

		-- Клиент скрипты
		csmd.Set_Validate_Prop( V_VB, 'P_GET_PAYER', 'P', '.Visible = false');

		::[RUNTIME].[STR].get_par(this.[BLOCK_DATA], 'ACC_FOR_COMISS', V_ACC_FOR_COMISS);
		if V_ACC_FOR_COMISS is not null then
			csmd.Set_Validate_Prop( V_VB, 'V_ACC_FOR_COMISS.MAIN_V_ID', 'V', '.locked = true', true);
			csmd.Set_Validate_Prop( V_VB, 'V_ACC_FOR_COMISS', 'V', '.enabled = false', true);
		else
			csmd.Set_Validate_Prop( V_VB, 'V_ACC_FOR_COMISS', 'V', '.visible = false');
		end if;

		csmd.Set_Validate_Prop( V_VB, 'P_PAYER.ACC', 'P', '.locked = true');
		csmd.Set_Validate_Prop( V_VB, 'P_PAYER.NAME', 'P', '.locked = true');
		csmd.Set_Validate_Prop( V_VB, 'P_PAYER.OPTION.OPT', 'P', '.locked = true');

		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.ACC', 'P', '.locked = true');
