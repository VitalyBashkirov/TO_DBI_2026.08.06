			else
					P_DATA := 'Отсутствует';
			end if;
-------	*/		

		elsif p_info = 'МИГР_КАРТА_ВИЗА' then	--  МИГР_КАРТА_ВИЗА  --NGA 26/09/2014
		  if client_priv%id is not null then
			temp_str1 := Get_Migration_Card(client_priv, P_DATE_PRINT);
			temp_str2 := Get_Visa(client_priv,P_DATE_PRINT);
            if length(temp_str1) > 1 then
				if   length(temp_str2) > 1 then	P_DATA := temp_str1 || NL$ || temp_str2;
				else   					        P_DATA := temp_str1;
				end if;
			else
			    if   length(temp_str2) > 1 then P_DATA := temp_str2;
