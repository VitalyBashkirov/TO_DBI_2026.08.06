class PSH_CUST_DOCS;

@import_plsql(true)
@name('[ПСБ] Проверить по XSD')
@tag('COPIED')
static method PSH_CHECK_SCHEMA is
pragma include(::[RUNTIME].[MACRO_LIB]);
pragma include(::[PSH_CUST_DOCS].[PSH_LIB_TC]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25

pragma macro(lib, '::[PSH_CUST_DOCS].[PSH_LIB]', substitute); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25

type Q_Docs is
	select x(x)
	in ::[PSH_CUST_DOCS] all -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
	where
		x%class = ::[PSH_CUST_DOCS_OU]%class	 -- updated CHANGE_QUALIFIER PSB_CUST_DOCS_OU->PSH_CUST_DOCS_OU 08/10/25
		and x.[DOC_STATE] = &libtc.stCheckXSD;

type ref_QDocs is ref cursor return Q_Docs;

type TDocs is table of ref [PSH_CUST_DOCS_OU]; -- updated CHANGE_QUALIFIER PSB_CUST_DOCS_OU->PSH_CUST_DOCS_OU 08/10/25
PSH_CHECK_SCHEMA is

execute is

v_cur		ref_QDocs;
v_tab_docs	TDocs;
v_lockId	pls_integer;
v_app_mess	varchar2(128);
begin
	v_app_mess := ::[PSH_CUST_DOCS].[PSH_LIB_FUN].checkApp('1B028090'); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
	if v_app_mess is not null then
		pragma error(v_app_mess);
	end if;
	
	v_lockId := &lib.setLock(&METHOD$ID);

	v_cur.open(Q_Docs);
	loop
		v_cur.fetch_limit(100, v_tab_docs);			
		
		exit when v_tab_docs.count = 0;

		v_tab_docs.[PSH_CHECK_SCH](); -- updated CHANGE_SHORT_NAME CHECK_SCHEMA->PSH_CHECK_SCH 15/10/25
		
		v_tab_docs.delete;

		exit when v_cur.notfound;
	end loop;

	v_cur.close;
	
	&lib.delLock(v_lockId);	
exception
	when others then		
		&lib.delLock(v_lockId);	
		raise;
end;
end;
end;
