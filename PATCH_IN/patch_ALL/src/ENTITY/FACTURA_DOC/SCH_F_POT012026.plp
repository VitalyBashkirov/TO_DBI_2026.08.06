class FACTURA_DOC;

@import_plsql(true)
@this(plsql_lock:=false,create_on_start:=true)
@name('Печать счетов-фактур (потоковая) с 01.01.2026')
@tag('COPIED')
static method SCH_F_POT012026 is

@name('Руководитель')                     public V_LEADER         [USER_REF];
@name('Главный бухгалтер')                public V_BUHG           [USER_REF];
@name('Начальная дата')                   public V_BEG_DATE       [DATE];
@name('Конечная дата')                    public V_END_DATE       [DATE];
@name('Начальный номер')                  public V_BEG_NUM        [NUMBER_DOC];
@name('Конечный номер')                   public V_END_NUM        [NUMBER_DOC];
@name('Поставщик')                        public V_CL_DT          [REQ_CLIENT];
@name('Получатель')                       public V_CL_KT          [REQ_CLIENT];
@name('Кроме клиента')                    public V_KRK            [CLIENT_REF];
@name('Вид счета-фактуры')                public V_KIND           [ONE_FROM_THREE];
@name('Руководитель (строка)')            public V_LEADER_STR     [STRING];
@name('Главный бухгалтер (строка)')       public V_BUHG_STR       [STRING];
@name('Создано пользователем')            public V_DOCUMENT_USER  [USER_REF];
@name('Подразделение')                    public V_HIGHEST_DEPART [DEPART_REF];
@name('Файл шаблона Excel')               public V_FILE           [STRING_32000];
@name('Строка скрипта')                   public V_VB             [STRING_32000];
@name('На печать')                        public V_PRINT          [BOOLEAN];
@name('Доверенность руководителя')        public V_DOV_LEADER     [STRING_1000];
@name('Доверенность бухгалтера')          public V_DOV_BUHG       [STRING_1000];
@name('Кол-во сф для подписи по дов рук') public V_I              [DIG_6];
@name('Кол-во сф для подписи по дов бух') public V_J              [DIG_6];
@name('Размер выборки')                   public V_KOLVO          [DIG_6];

/*
 *     Дата  		 Автор       ATM         Описание
 * -------------    -----------	----------- ---------------------------------------------------
 * 13.01.2026		karasev		RP0707766	Новый формат печати.
 * 27.02.2026		karasev		RP0709579	Добавлено vRowEnd.
 * 											Добавлено использование шаблона SCH_F_04_2026_POTOK с dt_01_04_2026.
*/

pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma include(::[FACTURA_DOC].[SLIB]);

pragma macro(xl,'::[OOXML].[API_XL]');
pragma macro(lp,'::[SHABLON_DOC].[LIB_OOXML]');

pragma macro(iFont,'&xl.get_font(''Times New Roman'',2,8)');
pragma macro(iBorder,'&xl.get_border(&xl.xl_b_thin,&xl.xl_b_thin,&xl.xl_b_thin,&xl.xl_b_thin)');
pragma macro(iNum_fmt,'&xl.get_numFmt(''#,0.00'')');

function IsTraceGoodsExists(p_sf ref [FACTURA_DOC], p_is_corr boolean default false) return boolean 
is
	n number;
begin
	select x(count(1)) in p_sf.[SERV_LIST]
	where x.[TRACE_GOODS] = true
	into n;
	
	if n = 0 and p_is_corr = true then
		select x(count(1)) in p_sf.[SERV_LIST]
		where x.[SERVICE_BASE].[TRACE_GOODS] = true
		into n;	
	end if;
	
	return n > 0;
end;

SCH_F_POT012026 (
	@name('Основной отчет')                            P_REPORT         in out [TMC_TREPS_REF],
	@name('Выводить инфо о доверенности Руководителя') P_DOV_LEADER     in     [BOOLEAN],
	@name('Выводить инфо о доверенности Глав.Бух.')    P_DOV_BUHG       in     [BOOLEAN],
	@name('Выбор подписантов')                         P_KIND_SIGNATURE in     [CASE_BETWEEN_TWO]
) is

validate is
	type t_arr is varray(0) of number;
	vDepartArr		t_arr;
	vLeaderStr 		varchar2(200);
	vBuhgStr		varchar2(200);
	vRow 			number;
	vRowC 			number;
	vRow_pr			number;
	vObj			ref [SIGN_BY_RIGHT]; --ссылка на основание подписи
	vObj1 			ref [DECLENSION];
	vCommonFlag 	boolean default false;
	vCorrecFlag 	boolean default false;
	vSrcSheet		number;
	vDstSheet		number;
	vNum			number 	:= 1;
	vCount			number 	:= 0;
	vKindRateNds  	boolean;
	vRowEnd			number;
begin
	if p_message='DEFAULT' then
		::[VHO_INTERFACE].[PRX_FACTURA].CL_PR_LIB_DL_TuneFilterForView(::[SYSTEM].[VARIABLES].OurBank, 'SIGN_FACTURA', ::[SYSTEM].[VARIABLES].OurBranch);
		P_DOV_LEADER := true;
		P_DOV_BUHG := true;
		v_dov_leader := null;
		v_dov_buhg := null;
		V_VB 		:= null;
		V_PRINT		:= false;
		
		V_LEADER	:=	::[DEFVALS].[SLIB].RestoreRef(STDLIB.USERID, &METHOD$CLASS, &METHOD$SNAME, 'V_LEADER');
		V_BUHG		:=	::[DEFVALS].[SLIB].RestoreRef(STDLIB.USERID, &METHOD$CLASS, &METHOD$SNAME, 'V_BUHG');
		V_KIND.[0] 	:= 2;	--на продажу
		P_KIND_SIGNATURE.[0] := 1;
		V_HIGHEST_DEPART:=[STDLIB].UserId.Depart;
		if V_LEADER is not null then
		begin
			locate vObj in v_leader.[BY_RIGHT]
			where 	vObj.[CLASS_DOG]%id = 'FACTURA_DOC';			
			begin
				locate vObj1 in vObj.[DECLENSIONS]
				where vObj1.[CASE_GR].[CODE] = 'И';
					v_dov_leader := vObj1.[NAME];				
			exception	
				when NO_DATA_FOUND then
					v_dov_leader := null;
			end;	
			exception
			when NO_DATA_FOUND then
				v_dov_leader := null;	
		end;
		end if;
		if V_BUHG is not null then
		begin
			locate vObj in v_buhg.[BY_RIGHT]
			where 	vObj.[CLASS_DOG]%id = 'FACTURA_DOC';			
			begin
				locate vObj1 in vObj.[DECLENSIONS]
				where vObj1.[CASE_GR].[CODE] = 'И';
					v_dov_buhg := vObj1.[NAME];				
			exception	
				when NO_DATA_FOUND then
					v_dov_buhg := null;
			end;	
			exception
			when NO_DATA_FOUND then
				v_dov_buhg := null;	
		end;
		end if;
		if v_dov_leader is null then
			P_DOV_LEADER := false;
			[CSMD].Hide(V_VB, 'P_DOV_LEADER');
		else
			[CSMD].Show(V_VB, 'P_DOV_LEADER');
			P_DOV_LEADER := true;
		end if;
		if v_dov_buhg is null then
			P_DOV_BUHG := false;
			[CSMD].Hide(V_VB, 'P_DOV_BUHG');
		else
			[CSMD].Show(V_VB, 'P_DOV_BUHG');
			P_DOV_BUHG := true;
		end if;

  	elsif p_message='VALIDATE' then
		If (p_info = '%VAR%.V_LEADER') then
			begin
				locate vObj in v_leader.[BY_RIGHT]
				where 	vObj.[CLASS_DOG]%id = 'FACTURA_DOC';			
				begin
					locate vObj1 in vObj.[DECLENSIONS]
					where vObj1.[CASE_GR].[CODE] = 'И';
						v_dov_leader := vObj1.[NAME];				
				exception	
					when NO_DATA_FOUND then
						v_dov_leader := null;
				end;	
			exception
				when NO_DATA_FOUND then
					v_dov_leader := null;	
			end;
			if v_dov_leader is null then
				P_DOV_LEADER := false;
				[CSMD].Hide(V_VB, 'P_DOV_LEADER');
			else
				[CSMD].Show(V_VB, 'P_DOV_LEADER');
				P_DOV_LEADER := true;
			end if;		
		end if;
		If (p_info = '%VAR%.V_BUHG') then
			begin
				locate vObj in v_buhg.[BY_RIGHT]
				where 	vObj.[CLASS_DOG]%id = 'FACTURA_DOC';			
				begin
					locate vObj1 in vObj.[DECLENSIONS]
					where vObj1.[CASE_GR].[CODE] = 'И';
						v_dov_buhg := vObj1.[NAME];				
				exception	
					when NO_DATA_FOUND then
						v_dov_buhg := null;
				end;	
			exception
				when NO_DATA_FOUND then
					v_dov_buhg := null;	
			end;	
			if v_dov_buhg is null then
				P_DOV_BUHG := false;
				[CSMD].Hide(V_VB, 'P_DOV_BUHG');
			else
				[CSMD].Show(V_VB, 'P_DOV_BUHG');
				P_DOV_BUHG := true;
			end if;	
		end if;
		if p_info = 'OK' then
			v_kolvo := 0;
			v_i := 0;
			v_j := 0;
		  	If V_HIGHEST_DEPART is Null Then
		  	  pragma error('Укажите подразделение');
		  	End If;
		
		    If V_BEG_DATE is Null Or V_END_DATE is Null Then
		  	  pragma error('Даты должны быть заполнены');
		    End If;
		  	
		  	if V_KIND.[0] = 1 Then		  		
		  		v_dov_buhg 	:= null;
		  		v_dov_leader:= null;
		  		P_DOV_LEADER:= false;
		  		P_DOV_BUHG	:= false;	  		
		  	End If;
			
			if P_KIND_SIGNATURE.[0] = 1 then
				vLeaderStr 	:= stdlib.FIO(V_LEADER.[NAME], 'Ф И.О.');
		  		vBuhgStr 	:= stdlib.FIO(V_BUHG.[NAME], 'Ф И.О.');
			else	
				vLeaderStr 	:= V_LEADER_STR;
		  		vBuhgStr 	:= V_BUHG_STR;
			end if;	
		  		
			-- заселектим id подразделений
			with recursive x(ID) as
			(select t(t%id : ID) in ::[DEPART] where t%id = V_HIGHEST_DEPART
			 union all
			 select t(t%id : ID) in ::[DEPART] join (x : x2) on t.[HIGH] = x2.ID	
			) select x(x.ID : ID) in x
			into vDepartArr;

			vRow := 0;
			vRowC := 0;
			
			if V_BEG_DATE >= ::[FACTURA_DOC].[REP_LIB_01072021].dt_01_04_2026 then
				&lp.xl_init('SCH_F_04_2026_POTOK','TMC');
				vRowEnd := 39;
			else
				&lp.xl_init('SCH_F_01_2026_POTOK','TMC');
				vRowEnd := 35;
			end if;
			
			&xl.Open_Sheet('Лист1');
			&xl.AddCopySheet('Лист1','ЛистПоток' || vNum);
			&xl.Open_Sheet('ЛистПоток' || vNum);
			&xl.Delete_Row(1, vRowEnd);
			
			for (select a (a : a_id, a.[DOCUMENT_DATE] : doc_date, a.[SIGN_ADVANCE] : sign_adv, a.[ADVANCE] : adv, a.[AGENT] : agent) in [FACTURA_DOC]
				where
					(trunc(a.[DOCUMENT_DATE], 'DD') >= trunc(V_BEG_DATE, 'DD') and trunc(a.[DOCUMENT_DATE], 'DD') <= trunc(V_END_DATE, 'DD'))
					and (V_KIND.[0]=1 or (V_KIND.[0]=2 and (a.[DOCUMENT_NUM] >= V_BEG_NUM or V_BEG_NUM is null) and (a.[DOCUMENT_NUM] <= V_END_NUM or V_END_NUM is null)))
					and (a.[CL_DT].[1].[1] = V_CL_DT.[1].[1] or a.[CL_DT].[2].[2] = V_CL_DT.[2].[2] or (V_CL_DT.[1].[1] is null and V_CL_DT.[2].[2] is null))
					and (a.[CL_KT].[1].[1] = V_CL_KT.[1].[1] or a.[CL_KT].[2].[2] = V_CL_KT.[2].[2] or (V_CL_KT.[1].[1] is null and V_CL_KT.[2].[2] is null))
					and (V_KRK is null or a.[CL_KT].[1].[1] != V_KRK)
					and (
							V_HIGHEST_DEPART is null 
							or exists (select d(d) in vDepartArr where d.[COLUMN_VALUE] = a.[DEPART]%id)
						)
					and a%State = 'ACTIVE'
					and a.[INITION] is null
					and ((V_KIND.[0]=1 and a.[KIND].[0]=1) or (V_KIND.[0]!=1 and a.[KIND].[0]!=1))
					and (V_DOCUMENT_USER is null or a.[DOCUMENT_USER] = V_DOCUMENT_USER)
					and not ((a.[INITION] is null and a.[INITION_CORR] is not null)
						or (a.[INITION].[INITION] is null and a.[INITION].[INITION_CORR] is not null))
				order by a.[NUM_FACT], a.[DOCUMENT_DATE]
				)
			loop
				if IsTraceGoodsExists(a.a_id) then
					vSrcSheet := &xl.getSheetNum('Лист1');
				else
					vSrcSheet := &xl.getSheetNum('Лист1_2');
				end if;
				vDstSheet := &xl.getSheetNum('ЛистПоток' || vNum);													
				-----------------------------------------------------------------------
				&xl.CopyPasteRows(1, vRowEnd, vRow + 1, vSrcSheet, vDstSheet);
				-----------------------------------------------------------------------
				vRow_pr := vRow;
									
				v_kolvo := v_kolvo + 1;
				if V_LEADER is not null then
					v_dov_leader := [FACTURA_DOC].[REPORTS_LIB].GetDoverennost(V_LEADER, a.doc_date);
				end if;
				if V_BUHG is not null then
					v_dov_buhg := [FACTURA_DOC].[REPORTS_LIB].GetDoverennost(V_BUHG, a.doc_date);
				end if;		
			  	if not P_DOV_LEADER then
					v_dov_leader := null;
				end if;			  	
				if not P_DOV_BUHG then
					v_dov_buhg := null;
				end if;
				if	v_dov_leader is not null then
					v_i := v_i + 1;						
				end if;
				if	v_dov_buhg is not null then
					v_j := v_j + 1;						
				end if;
				if (nvl(a.sign_adv,false) and a.adv is null) or nvl(a.agent,false) then
					vKindRateNds := true;
				else
					vKindRateNds := false;
				end if;
				
				-----------------------------------------------------------------------
				&xl.Open_Sheet('ЛистПоток');
				::[FACTURA_DOC].[REP_LIB_01072021].print_sf(vRow, A.a_id, V_LEADER, V_BUHG, vLeaderStr, vBuhgStr, vKindRateNds, v_dov_leader, v_dov_buhg);
				-----------------------------------------------------------------------
				vCommonFlag := true;
				&xl.PutPageBreak(vRow);
				vCount := vCount + 1;
				if vCount = 500 then
					vCount := 0;
					vNum := vNum + 1;
					&xl.AddCopySheet('Лист1','ЛистПоток' || vNum);
					&xl.Open_Sheet('ЛистПоток' || vNum);
					&xl.Delete_Row(1, vRowEnd);
					vRow := 0;
				end if;
			End loop;
			
			if vCommonFlag = true then
				&xl.SetPrintArea(1, 1, vRow , 19, &xl.getSheetNum('ЛистПоток' || vNum));
			end if;
			
			vCount := 0;
			vNum := 1;
			
			&xl.Open_Sheet('Лист2');
			&xl.AddCopySheet('Лист2','ЛистПотокКорр' || vNum);
			&xl.Open_Sheet('ЛистПотокКорр' || vNum);
			&xl.Delete_Row(1, 35);
			
			for (select a (a : a_id, a.[DOCUMENT_DATE] : doc_date, a.[SIGN_ADVANCE] : sign_adv, a.[ADVANCE] : adv, a.[AGENT] : agent) in [FACTURA_DOC]
				where
					(trunc(a.[DOCUMENT_DATE], 'DD') >= trunc(V_BEG_DATE, 'DD') and trunc(a.[DOCUMENT_DATE], 'DD') <= trunc(V_END_DATE, 'DD'))
					and (V_KIND.[0]=1 or (V_KIND.[0]=2 and (a.[DOCUMENT_NUM] >= V_BEG_NUM or V_BEG_NUM is null) and (a.[DOCUMENT_NUM] <= V_END_NUM or V_END_NUM is null)))
					and (a.[CL_DT].[1].[1] = V_CL_DT.[1].[1] or a.[CL_DT].[2].[2] = V_CL_DT.[2].[2] or (V_CL_DT.[1].[1] is null and V_CL_DT.[2].[2] is null))
					and (a.[CL_KT].[1].[1] = V_CL_KT.[1].[1] or a.[CL_KT].[2].[2] = V_CL_KT.[2].[2] or (V_CL_KT.[1].[1] is null and V_CL_KT.[2].[2] is null))
					and (V_KRK is null or a.[CL_KT].[1].[1] != V_KRK)
					and (
							V_HIGHEST_DEPART is null
							or exists (select d(d) in vDepartArr where d.[COLUMN_VALUE] = a.[DEPART]%id)
						)
					and a%State = 'ACTIVE'
					and a.[INITION] is null
					and ((V_KIND.[0]=1 and a.[KIND].[0]=1) or (V_KIND.[0]!=1 and a.[KIND].[0]!=1))
					and (V_DOCUMENT_USER is null or a.[DOCUMENT_USER] = V_DOCUMENT_USER)
					and ((a.[INITION] is null and a.[INITION_CORR] is not null) or (a.[INITION].[INITION] is null and a.[INITION].[INITION_CORR] is not null))
				order by a.[NUM_FACT], a.[DOCUMENT_DATE]
				)
			loop
				if IsTraceGoodsExists(a.a_id,true) then
					vSrcSheet := &xl.getSheetNum('Лист2');
				else
					vSrcSheet := &xl.getSheetNum('Лист2_2');
				end if;
				vDstSheet := &xl.getSheetNum('ЛистПотокКорр' || vNum);						
				-----------------------------------------------------------------------
				&xl.CopyPasteRows(1, 35, vRowC + 1, vSrcSheet, vDstSheet);
				-----------------------------------------------------------------------
				vRow_pr := vRow;
									
				v_kolvo := v_kolvo + 1;
				if V_LEADER is not null then
					v_dov_leader := [FACTURA_DOC].[REPORTS_LIB].GetDoverennost(V_LEADER, a.doc_date);
				end if;
				if V_BUHG is not null then
					v_dov_buhg := [FACTURA_DOC].[REPORTS_LIB].GetDoverennost(V_BUHG, a.doc_date);
				end if;		
			  	if not P_DOV_LEADER then
					v_dov_leader := null;
				end if;			  	
				if not P_DOV_BUHG then
					v_dov_buhg := null;
				end if;
				if	v_dov_leader is not null then
					v_i := v_i + 1;						
				end if;
				if	v_dov_buhg is not null then
					v_j := v_j + 1;						
				end if;
				if (nvl(a.sign_adv,false) and a.adv is null) or nvl(a.agent,false) then
					vKindRateNds := true;
				else
					vKindRateNds := false;
				end if;
				-----------------------------------------------------------------------
				&xl.Open_Sheet('ЛистПотокКорр');
				vDstSheet := &xl.getSheetNum('ЛистПотокКорр');
				::[FACTURA_DOC].[REP_LIB_01072021].print_sf_c(vRowC, A.a_id, V_LEADER, V_BUHG, vLeaderStr, vBuhgStr, vKindRateNds, v_dov_leader, v_dov_buhg);
				-----------------------------------------------------------------------
				vCorrecFlag := true;
				&xl.PutPageBreak(vRowC);
				
				vCount := vCount + 1;
				if vCount = 500 then
					vCount := 0;
					vNum := vNum + 1;
					&xl.AddCopySheet('Лист2','ЛистПотокКорр' || vNum);
					&xl.Open_Sheet('ЛистПотокКорр' || vNum);
					&xl.Delete_Row(1, 35);
					vRowC := 0;
				end if;
				
			End loop;
			
			if vCorrecFlag = true then
				&xl.SetPrintArea(1, 1, vRowC , 21, &xl.getSheetNum('ЛистПотокКорр' || vNum));
			end if;
			
			if (v_i > 0) and (v_i < v_kolvo) and p_dov_leader then
				stdio.put_line_buf(v_i||' счетов-фактур из '|| v_kolvo || ' напечатаны по доверенности руководителя');
			end if;
			if (v_j > 0) and (v_j < v_kolvo) and p_dov_buhg then
				stdio.put_line_buf(v_j||' счетов-фактур из '|| v_kolvo || ' напечатаны по доверенности бухгалтера');
			end if;
			
			if not vCommonFlag then
				&xl.delSheet('ЛистПоток1');
			else
				&xl.delSheet('Лист1');
				&xl.delSheet('Лист1_2');					
			end if;
			&xl.delSheet('Лист2');
			&xl.delSheet('Лист2_2');
			if not vCorrecFlag then
				&xl.delSheet('ЛистПотокКорр1');
			end if;	
	
			&lp.xl_finish;
			p_info :='CANCEL';
		end if;
	end if;
end;

execute is
begin	
	::[DEFVALS].[SLIB].SaveRef(STDLIB.USERID, &METHOD$CLASS, &METHOD$SNAME, 'V_LEADER', V_LEADER%Id, 'USER');
	::[DEFVALS].[SLIB].SaveRef(STDLIB.USERID, &METHOD$CLASS, &METHOD$SNAME, 'V_BUHG', V_BUHG%Id, 'USER');
end;
end;
end;
