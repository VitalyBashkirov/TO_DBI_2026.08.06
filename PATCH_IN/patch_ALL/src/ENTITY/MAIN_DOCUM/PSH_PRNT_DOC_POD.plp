class MAIN_DOCUM;

@optimize(false)
@import_plsql(true)
@archive(value:='archive',package:=true)
@this(create_on_start:=true)
@name('[ПСБ] Распечатать с подписантами')
@tag('COPIED')
batch method PSH_PRNT_DOC_POD is

PSH_PRNT_DOC_POD (
	@name('Контролер')   P_KONTROL  in [USER_REF],
	@name('Исполнитель') P_ISPOLNIT in [USER_REF],
	-->> PSB VRI 09/06/2025 CFT-1546 Подписи сотрудников на кассовых документах
	@name('Кассир') 	 P_KASSIR   in [USER_REF],
	@name('ОПЕРУ')		 P_OPERU	in [MEMO],
	@name('КАССИРЫ')	 P_KASSIRS	in [MEMO]
) is

validate is
begin
	if p_message = 'DEFAULT' then
		--P_ISPOLNIT:=::[RUNTIME].[STDLIB].UserId;
		P_ISPOLNIT :=  nvl(::[DEFVALS].[SLIB].RestoreNum(::[RUNTIME].[STDLIB].UserId,&METHOD$CLASS,&METHOD$SNAME, 'PSH_PRNT_DOC_POD_P_ISPOLNIT'),	::[RUNTIME].[STDLIB].UserId);
		/*if P_ISPOLNIT.[FILIAL].[CODE]='001' then P_KONTROL:=22644522;
		end if;*/
		P_KONTROL :=  nvl(::[DEFVALS].[SLIB].RestoreNum(::[RUNTIME].[STDLIB].UserId,&METHOD$CLASS,&METHOD$SNAME, 'PSH_PRNT_DOC_POD_P_KONTROL'),	::[RUNTIME].[STDLIB].UserId);

		-->> PSB VRI 09/06/2025 CFT-1546 Подписи сотрудников на кассовых документах
		for (select p(p.[PATTERN] patt, p.[PATTERN_CORR] value)
			in ::[ANALYTIC_CODE]([CODE] = 'PSB_USER_PRNT_DOC').[ACC_PATTERN]
			where   p.[PRODUCT] = ::[PATTERN_PRODUCT]([CODE] = 'PSB_NORM_DT_KT')
				and p.[OR_DOWN] = '1'
			)
		loop
			if p.patt = 'ОПЕРУ' then
				P_OPERU := p.value;
			elsif p.patt = 'КАССИРЫ' then
				P_KASSIRS := p.value;
			end if;
		end loop;
		--<< PSB VRI 09/06/2025 CFT-1546 Подписи сотрудников на кассовых документах
	end if;
end;

execute is
doc_tbl	THIS_TABLE;
begin
executor.set_context('P_KONTROL_PRINT_FIO',   ::[RUNTIME].[STDLIB].FIO(P_KONTROL.[NAME]));
executor.set_context('P_KONTROL_PRINT_DOLZN',   P_KONTROL.[CASTA].[VALUE]);
executor.set_context('P_ISPOLNIT_PRINT_FIO',   ::[RUNTIME].[STDLIB].FIO(P_ISPOLNIT.[NAME]));
executor.set_context('P_ISPOLNIT_PRINT_DOLZN',   P_ISPOLNIT.[CASTA].[VALUE]);
-->> PSB VRI 09/06/2025 CFT-1546 Подписи сотрудников на кассовых документах
executor.set_context('P_KASSIR_PRINT_FIO',   ::[RUNTIME].[STDLIB].FIO(P_KASSIR.[NAME]));
executor.set_context('P_KASSIR_PRINT_DOLZN',   P_KASSIR.[CASTA].[VALUE]);


	if this.count > 0 then
		for i in this.first..this.last loop -- Некоторые документы печатать не нужно
			if  ::[MAIN_DOCUM].[MD_FUN_ADD].get_main_smart_mo(this(i)) is null or this(i).[VID_DOC] = ::[NAME_PAYDOC]([CODE] = 'БЕЗН_БАНК_ОРД') then
				doc_tbl(doc_tbl.count) := this(i);  			
			end if;
		end loop;
	end if;	
	if doc_tbl.count > 0 then
		::[PRN_TUNE].[PREPARATION](doc_tbl);
	end if;	
	
executor.set_context('P_KONTROL_PRINT_FIO',   null);
executor.set_context('P_KONTROL_PRINT_DOLZN',   null);
executor.set_context('P_ISPOLNIT_PRINT_FIO',   null);
executor.set_context('P_ISPOLNIT_PRINT_DOLZN',   null);
-->> PSB VRI 09/06/2025 CFT-1546 Подписи сотрудников на кассовых документах
executor.set_context('P_KASSIR_PRINT_FIO',   null);
executor.set_context('P_KASSIR_PRINT_DOLZN',   null);
	
::[DEFVALS].[SLIB].SaveNum (::[RUNTIME].[STDLIB].UserId,&METHOD$CLASS,&METHOD$SNAME, 'PSH_PRNT_DOC_POD_P_KONTROL',P_KONTROL);
::[DEFVALS].[SLIB].SaveNum (::[RUNTIME].[STDLIB].UserId,&METHOD$CLASS,&METHOD$SNAME, 'PSH_PRNT_DOC_POD_P_ISPOLNIT',P_ISPOLNIT);
end;
end;
end;
