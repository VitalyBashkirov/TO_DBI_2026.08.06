class PSH_CUST_DOCS_IN;

@import_plsql(true)
@name('[ПСБ] 4.1.Исполнить документ')
@tag('COPIED')
batch method PSH_PROCESS_DOC is
pragma include(::[PSH_CUST_DOCS].[PSH_LIB]);
pragma include(::[PSH_CUST_DOCS].[PSH_LIB_TC]);
PSH_PROCESS_DOC is

execute is

v_tab_docs	&lib.T_Doc;
v_doc_state ::[PSH_CUST_DOCS].[DOC_STATE]%type;
begin
	for i in 1..this.count loop
		v_doc_state := this(i).[DOC_STATE];
	
		if v_doc_state in (&libtc.stPodtv, &libtc.stErrCheckSt) then
			v_tab_docs(i).doc		:= this(i);
			v_tab_docs(i).doc_type	:= this(i).[DOC_TYPE];
			v_tab_docs(i).doc_state	:= v_doc_state;
		end if;
	end loop;

	&lib.process_docs(v_tab_docs);

end;
end;
end;
