	if smkt >0 then	
		sm := 0;	
		for md in [MAIN_DOCUM] WHERE md%state = 'PROV'
									and md.[DATE_PROV] >= p_d_beg and md.[DATE_PROV] <= p_d_end
									and md.[ACC_KT] = p_acc

									and ((	md.[KL_DT].[0] = 1
										AND ( 	SUBSTR(md.[KL_DT].[1].[2].[MAIN_V_ID],1,5) IN ('40701', '40702', '40703', '40802', '40804', '40805', '40806', '40807', '30232', '40817', '40820')
											OR	SUBSTR(md.[KL_DT].[1].[2].[MAIN_V_ID],1,3) IN ('423', '426') 				
											)
										)
										OR
										( md.[KL_DT].[0] = 2
										AND ( 	SUBSTR(md.[KL_DT].[2].[1],1,5) IN ('40701', '40702', '40703', '40802', '40804', '40805', '40806', '40807', '30232', '40817', '40820')
											OR	SUBSTR(md.[KL_DT].[2].[1],1,3) IN ('423', '426') 				
				)			
			)
		)
									
		loop
			if	checkNaznPlat_NDS(md.[NAZN] ) and checkNaznPlat_ZRP(md.[NAZN])=false then
			--if	checkNaznPlat_NDS(md.[NAZN] ) then
				sm := sm + md.[SUM_NT];
			end if;
		end loop;
		--return sm/smdbt*100;
		return sm;
		
	else
		return 0;
	end if;
end;

-- Доля зачислений на клиента c НДС к КТ обороту (в процентах)
public function GetKTPayClient_NDS_PRC(p_acc ref [AC_FIN], p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is  -- KAS 21/05/2020 по задаче Шмидт для представления
sm number(18,2);
smkt number(18,2);
begin
	smkt := nvl(::[RUNTIME].[F_5].A('И'||p_acc||'КВ', p_d_beg, p_d_end),0);	
	if smkt >0 then	
		sm := 0;	
		sm := nvl ( GetKTPayClient_NDS(p_acc, p_d_beg, p_d_end), 0);
		return sm/smkt*100;
	else
		return 0;
	end if;
end;

-- Доля списаний на контрагента без НДС к сумме списаний на контрагента (в процентах)
public function GetDTPayContragent_noNDS_PRC(p_acc ref [AC_FIN], p_INN string, p_d_beg	[DATE], p_d_end	[DATE]) return number(18,2) is  -- KAS 21/05/2020 по задаче Шмидт для представления
sm number(18,2);
smctg number(18,2);
begin
	smctg := nvl( GetDTPayContragent(p_acc, p_INN, p_d_beg, p_d_end),0);	
	if smctg >0 then	
		sm := 0;	
		sm := nvl( GetDTPayContragent_noNDS(p_acc, p_INN, p_d_beg, p_d_end),0);	
		return sm/smctg*100;
	else
		return 0;
	end if;
end;

