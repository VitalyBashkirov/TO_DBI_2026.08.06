class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Редактировать уникальный номер документа')
method PSH_EDIT_UNIQ is
PSH_EDIT_UNIQ (
	@name('Уникальный номер документа') P_DOCUMENT_UNO in [STRING_25]
) is

validate is
Begin
	if p_message='DEFAULT' then
		if this.[DOCUMENT_UNO] is null then
			P_DOCUMENT_UNO := 'SBP';
		else
			P_DOCUMENT_UNO := this.[DOCUMENT_UNO];
		end if;
	end if;
End;

execute is
Begin
	this.[DOCUMENT_UNO] := P_DOCUMENT_UNO;
end;
end;
end;
