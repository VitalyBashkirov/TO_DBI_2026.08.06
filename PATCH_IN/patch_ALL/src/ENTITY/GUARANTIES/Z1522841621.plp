class GUARANTIES;

@import_plsql(true)
@name('[ПСБ] Портфель гарантий')
@speciality('filter')
static method Z1522841621 is
public V_CALC_DATE [DATE];

dp number :=0;	--управление debug_pipe
dp2 number:=null;	--управление debug_pipe
fmt string(10):='dd/mm/yyyy';

public function GetDateCalc return [DATE] is 
begin
	return nvl(V_CALC_DATE,[SYSTEM].[OP_DATE]);
end;
Z1522841621 (
	@name('Отчет на дату') P_CALC_DATE in [DATE]
) is

validate is
begin
	if P_MESSAGE = 'DEFAULT' then
		P_CALC_DATE  := nvl(V_CALC_DATE ,::[SYSTEM].[OP_DATE]);
	else
		if p_info = 'OK' then
			if P_CALC_DATE is null then pragma error('Пустая дата отчета!'); end if;
			V_CALC_DATE :=P_CALC_DATE;
			
			executor.set_context('$VW$_CALC_DATE', to_char(V_CALC_DATE,fmt));
			--debug_pipe(&METHOD$||' -- V_CALC_DATE='||to_char(V_CALC_DATE,fmt), dp);
		end if;
	end if;
end;

execute is
begin
	if P_CALC_DATE is null then pragma error('Пустая дата отчета!'); end if;
	V_CALC_DATE :=P_CALC_DATE;
	
	executor.set_context('$VW$_CALC_DATE', to_char(V_CALC_DATE,fmt));
	--debug_pipe(&METHOD$||' == V_CALC_DATE='||to_char(V_CALC_DATE,fmt), dp);
end;
end;
end;
