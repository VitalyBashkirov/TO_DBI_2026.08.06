class PSH_LOCAL_JOBS_F;

@name('[ПСБ] Добавить')
@tag('COPIED')
constructor PSH_CFB_NEW is
PSH_CFB_NEW (
	@name('Адресат')       P_CLIENT_REF in [CLIENT_REF] default null,
	@name('Признак EMAIL') P_EMAIL      in [BOOLEAN]    default null,
	@name('Признак SMS')   P_SMS        in [BOOLEAN]    default null,
	@name('Дата')          P_DATE_OP    in [DATE_TIME]  default null,
	@name('Сообщение')     P_TEXT       in [MEMO_BIG]   default null
) return ref [PSH_LOCAL_JOBS_F] is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_CLIENT_REF := this.[CLIENT_REF];
	P_EMAIL := this.[EMAIL];
	P_SMS := this.[SMS];
	P_DATE_OP := this.[DATE_OP];
	P_TEXT := this.[TEXT];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Адресат"
	[CLIENT_REF] := P_CLIENT_REF;
	-- Установка значения реквизита "Признак EMAIL"
	[EMAIL] := nvl(P_EMAIL,false);
	-- Установка значения реквизита "Признак SMS"
	[SMS] := nvl(P_SMS,false);
	-- Установка значения реквизита "Дата"
	[DATE_OP] := P_DATE_OP;
	-- Установка значения реквизита "Сообщение"
	[TEXT] := P_TEXT;
	commit;
end;
end;
end;
