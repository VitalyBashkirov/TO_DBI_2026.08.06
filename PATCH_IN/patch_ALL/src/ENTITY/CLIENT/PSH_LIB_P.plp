			if  p_info =  'ДА_МРПДЛ' and client_priv.[IS_IPDL].[CODE]     in ('DLMO','RPDL') then P_DATA:='V'; end if;  -- Межд.или Росс.(сам)
			if  p_info = 'НЕТ_МРПДЛ' and client_priv.[IS_IPDL].[CODE] not in ('DLMO','RPDL') then P_DATA:='V'; end if;

			if  p_info =  'ДА_ИПДЛ_Р' and client_priv.[IS_IPDL].[CODE] =  'IPDL_RELATIVE' then  P_DATA:='V'; end if;  -- Иностр.(родств.)
			if  p_info = 'НЕТ_ИПДЛ_Р' and client_priv.[IS_IPDL].[CODE] <> 'IPDL_RELATIVE' then  P_DATA:='V'; end if;

			if  p_info =  'ДА_ИПДЛ_П' and client_priv.[IS_IPDL].[CODE] =  'IPDL_REPR' then  P_DATA:='V'; end if;  -- Иностр.(действ.в интер.)
			if  p_info = 'НЕТ_ИПДЛ_П' and client_priv.[IS_IPDL].[CODE] <> 'IPDL_REPR' then  P_DATA:='V'; end if;
			-- Нет еще раз посмотрим
			if p_info in ('НЕТ_ИПДЛ','НЕТ_МРИПДЛ','НЕТ_ИПДЛ_Р','НЕТ_ИПДЛ_П') and client_priv.[IS_IPDL].[CODE] = 'PSB_NOT_PDL' then
				P_DATA:='V';
			end if;
			if client_priv.[IS_IPDL] is null then P_DATA:=' '; end if; -- Сбросим, если не задано ничего

		--NGA03/06/2015 end
		
		--NGA04/06/2015 для ПДЛ ищем не по типу, а по категории! Пока отключим.
/*		elsif p_info like '%ПДЛ%' AND 1=2 then

         --Иностр.(сам)			
         if p_info =  'ДА_ИПДЛ' AND nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&IPDL),::[IPDL_CATEGORY]([CODE]=&IPDL).[NAME]),0)>0 then P_DATA:='V'; end if;
         if p_info = 'НЕТ_ИПДЛ' AND nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&IPDL),::[IPDL_CATEGORY]([CODE]=&IPDL).[NAME]),0)=0 then P_DATA:='V'; end if;
         --Межд.или Росс.(сам)		
         if p_info =  'ДА_МРПДЛ' AND (nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&DLMO),::[IPDL_CATEGORY]([CODE]=&DLMO).[NAME]),0)>0 OR
                                      nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&RPDL),::[IPDL_CATEGORY]([CODE]=&RPDL).[NAME]),0)>0)   then P_DATA:='V'; end if;
         if p_info = 'НЕТ_МРПДЛ' AND  nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&DLMO),::[IPDL_CATEGORY]([CODE]=&DLMO).[NAME]),0)=0 AND
                                      nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&RPDL),::[IPDL_CATEGORY]([CODE]=&RPDL).[NAME]),0)=0     then P_DATA:='V'; end if;
         --Иностр.(родств.)		
         if p_info =  'ДА_ИПДЛ_Р' AND nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&IPDL_RELATIVE),::[IPDL_CATEGORY]([CODE]=&IPDL_RELATIVE).[NAME]),0)>0 then P_DATA:='V'; end if;
         if p_info = 'НЕТ_ИПДЛ_Р' AND nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&IPDL_RELATIVE),::[IPDL_CATEGORY]([CODE]=&IPDL_RELATIVE).[NAME]),0)=0 then P_DATA:='V'; end if;
         -- Иностр.(действ.в интер.)		
         if p_info =  'ДА_ИПДЛ_П' AND nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&IPDL_REPR),::[IPDL_CATEGORY]([CODE]=&IPDL_REPR).[NAME]),0)>0 then  P_DATA:='V'; end if;
         if p_info = 'НЕТ_ИПДЛ_П' AND nvl(instr(::[IPDL_CATEGORY].[LIB].GetPDLStr(client_priv.[IS_IPDL],&IPDL_REPR),::[IPDL_CATEGORY]([CODE]=&IPDL_REPR).[NAME]),0)=0 then  P_DATA:='V'; end if;

         -- Нет еще раз посмотрим (пока не удален PSB_NOT_PDL)
         if p_info in ('НЕТ_ИПДЛ','НЕТ_МРИПДЛ','НЕТ_ИПДЛ_Р','НЕТ_ИПДЛ_П') AND client_priv.[IS_IPDL].[CODE] = 'PSB_NOT_PDL' then  P_DATA:='V';   end if;
         if client_priv.[IS_IPDL] is NULL then P_DATA:=' '; end if; -- Сбросим, если не задано ничего
         		--NGA04/06/2015 end
*/
        --NGA20/07/2015
		elsif p_info in ('S1_','S2_','S3_','S4_','S5_','S6_','S7_','S8_','S10_','S10txt') then -- CL_ANK_CHARACTER_REL  (Предполагаемый характер деловых отношений с Банком),
			for rec in cl_ref.[ADD_PROP]
			where rec.[GROUP_PROP].[CODE] = 'CL_ANK_CHARACTER_REL'
			loop
				recprop:=rec;
				exit;
			end loop;
			if p_info = 'S1_' then  -- вклады
				if recprop%id is not null and recprop.[STR] like '%1 Размещение вклада(депозита)%' then
					P_DATA:='V';
				else /*вычисляем*/
					for dep in ::[DEPN]
					where	(dep.[ACCOUNT].[MAIN_V_ID] like '4230%' or
							dep.[ACCOUNT].[MAIN_V_ID] like '4260%') and -- только вклады!
							dep.[CLIENT] = client_priv%id
					loop
						P_DATA:='V';
						exit;
					end loop;
				end if;
			elsif p_info = 'S2_' then  -- покупка/продажа валюты
				if recprop%id is not null and recprop.[STR] like '%2 Покупка/продажа иностранной валюты%' then
					P_DATA:='V';
				else /*вычисляем*/
					for kv in ::[KASSA_V] -- найдем ВОП Клиента.
					--1. В операции ВОП нет ссылки на Клиента, но есть такие же серия/номер, как в истории изменений Клиента
					where	(	kv.[CLIENT] is null and
								exists (
										select v(v)
											in ::[CL_HIST]
										where	v.[VALUE] = kv.[NEW_CLIENT].[SERIA] and
												v.[QUAL]='DOC.SER' and
												v.[CLIENT_REF] = client_priv%id and
												rownum=1
										) and
								exists (
										select v(v)
											in ::[CL_HIST]
										where	v.[VALUE] = kv.[NEW_CLIENT].[NUMBER] and
												v.[QUAL]='DOC.NUM' and
												v.[CLIENT_REF] = client_priv%id and
												rownum=1
										)
							) or
					--2. В операции ВОП нет ссылки на Клиента, но есть такие же паспорт/серия/номер, как у Клиента
						(	kv.[CLIENT] is null and
							kv.[NEW_CLIENT].[PASSPORT]	= client_priv.[DOC].[TYPE].[FULL_NAME] and
							kv.[NEW_CLIENT].[SERIA]		= client_priv.[DOC].[SER] and
							kv.[NEW_CLIENT].[NUMBER]   = client_priv.[DOC].[NUM]
						) or
					--3. Есть прямая ссылка на клиента
						kv.[CLIENT] = client_priv%id
					order by kv.[DATE]
					loop
						P_DATA:='V';
						exit;
					end loop;
				end if;
			elsif p_info = 'S3_' then  -- переводы БОС
				if recprop%id is not null and recprop.[STR] like '%3 Переводы без открытия счета%' then
					P_DATA:='V';
				else /*вычисляем*/
					for doc in ::[MAIN_DOCUM]
					where -- найдем перевод БОС Клиента.
					--1. В переводе БОС нет ссылки на Клиента, но есть такие же серия/номер, как в истории изменений Клиента
						(
							(	doc.[REQ_MAN].[CLIENTREF] is null and
								exists (
											select	v(v)
												in ::[CL_HIST]
											where	replace(upper(v.[VALUE]),' ','') = replace(doc.[REQ_MAN].[SERIA],' ','') and
													v.[QUAL]='DOC.SER' and v.[DATE_EDIT]> to_date('01/01/1900','dd/mm/yyyy') and
													v.[CLIENT_REF] = client_priv%id and
													rownum=1
										) and
								exists (
											select	v(v)
												in ::[CL_HIST]
											where	upper(v.[VALUE]) = doc.[REQ_MAN].[NUMBER] and
													v.[QUAL]='DOC.NUM' and v.[DATE_EDIT]> to_date('01/01/1900','dd/mm/yyyy') and
													v.[CLIENT_REF] = client_priv%id and
													rownum=1
										)
							) or
					--2. В переводе БОС нет ссылки на Клиента, но есть такие же паспорт/серия/номер, как у Клиента
							(	doc.[REQ_MAN].[CLIENTREF] is null and
								doc.[REQ_MAN].[PASSPORT] = client_priv.[DOC].[TYPE].[FULL_NAME] and
								replace(doc.[REQ_MAN].[SERIA],' ','') = replace(client_priv.[DOC].[SER],' ','') and
								doc.[REQ_MAN].[NUMBER]   = client_priv.[DOC].[NUM]
							) or
					--3. Есть прямая ссылка на клиента 	
							doc.[REQ_MAN].[CLIENTREF] = client_priv%id
						) -- условия на клиента end
						and
						(	
							doc.[ACC_DT].[MAIN_V_ID] like '20202%' and doc.[ACC_KT].[MAIN_V_ID] like '409%' or
							doc.[ACC_DT].[MAIN_V_ID] like '409%'   and doc.[ACC_KT].[MAIN_V_ID] like '20202%'
						) and
						upper(doc%state) = 'PROV'
					loop
						P_DATA:='V';
						exit;
					end loop;
				end if;
			elsif p_info = 'S4_' then  -- кредиты
				if recprop%id is not null and recprop.[STR] like '%4 Кредитование%' then
					P_DATA:='V';
				else /*вычисляем*/
					for cred in ::[PR_CRED]
					where cred.[CLIENT] = client_priv%id
					loop
						P_DATA:='V';
						exit;
					end loop;
				end if;
			elsif p_info = 'S5_' then  -- операции с Цен.Бум.
				if recprop%id is not null and recprop.[STR] like '%5 Операции с ценными бумагами%' then
					P_DATA:='V';
				else /*вычисляем*/
					for nod in ::[NS_OPER_DOG]
					where	nod.[AGENT]%id = client_priv%id or
							nod.[CLIENT_F]%id = client_priv%id or
							nod.[COAGENT]%id  = client_priv%id
					loop
						P_DATA:='V';
						exit;
					end loop;
				end if;
			elsif p_info = 'S6_' then  -- сейф.ячейки
				if recprop%id is not null and recprop.[STR] like '%6 Сейфовые ячейки%' then
					P_DATA:='V';
				else /*вычисляем*/
					for h in ::[HOLDER] all
					where h.[CLIENT] = client_priv%id
					loop
						P_DATA:='V';
						exit;
					end loop;
				end if;
			elsif p_info = 'S7_' then  -- ПК
				if recprop%id is not null and recprop.[STR] like '%7 Оформление ПК%' then
					P_DATA:='V';
				else /*вычисляем*/
					for card in ::[IP_CARDS]
					where card.[CLIENT] = client_priv%id
					loop
						P_DATA:='V';
						exit;
					end loop;
				end if;
			elsif p_info = 'S8_' then  -- Тек.счета
				if recprop%id is not null and recprop.[STR] like '%8 Текущий счет%' then
					P_DATA:='V';
				else /*вычисляем*/
					for dep in ::[DEPN]
					where	(
								dep.[ACCOUNT].[MAIN_V_ID] like '40817%' or
								dep.[ACCOUNT].[MAIN_V_ID] like '40820%'
							) and -- только тек.счета!
							dep.[CLIENT] = client_priv%id
					loop
						P_DATA:='V';
						exit;
					end loop;
				end if;
			elsif p_info = 'S10_' and recprop.[STR] like '%#%' then
				P_DATA:='V';
			elsif p_info = 'S10txt' and recprop.[STR] like '%#%' then
				P_DATA := substr(recprop.[STR],instr(recprop.[STR],'#')+1);
			end if; -- по 'S_%'

--> ivanov a.v. 14/06/2017 Анкета
		elsif p_info in ('S1_N','S2_N','S3_N','S4_N','S5_N','S6_N','S7_N','S8_N','S10_N','S10txtN') then -- CL_ANK_CHARACTER_REL  (Предполагаемый характер деловых отношений с Банком),
			for rec in cl_ref.[ADD_PROP]
			where rec.[GROUP_PROP].[CODE] = 'CL_ANK_CHARACTER_REL'
			loop
				recprop:=rec;
				exit;
			end loop;
			if p_info = 'S1_N' then  -- вклады
				if recprop%id is not null and recprop.[STR] like '%1 Размещение вклада(депозита)%' then
					P_DATA:='V';
				else /*вычисляем*/
					for i in 1..v_rec_prod_tbl.count loop
						if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
							exit;
						else
							if v_rec_prod_tbl(i).prod_class in ('DEPOSIT_MULT','DEPOSIT_PRIV') and
							   v_rec_prod_tbl(i).p_date_begin  <= P_DATE_PRINT and
							   v_rec_prod_tbl(i).p_date_close  >= P_DATE_PRINT and
							   (v_rec_prod_tbl(i).p_acc like '4230%' or
								v_rec_prod_tbl(i).p_acc like '4260%' or
								v_rec_prod_tbl(i).p_acc like '40817%' or
								v_rec_prod_tbl(i).p_acc like '40820%')--включаем текущие счета
							    then
								P_DATA:='V';
								exit;
							end if;
						end if;
					end loop;
				end if;
			elsif p_info = 'S2_N' then  -- покупка/продажа валюты
				if recprop%id is not null and recprop.[STR] like '%2 Покупка/продажа иностранной валюты%' then
					P_DATA:='V';
				else /*вычисляем*/
					for i in 1..v_rec_prod_tbl.count loop
						if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
							exit;
						else
							if v_rec_prod_tbl(i).prod_class =  'KASSA_V' and
							   v_rec_prod_tbl(i).p_date_begin  <= P_DATE_PRINT
							    then
								P_DATA:='V';
								exit;
							end if;
						end if;
					end loop;
				end if;
			elsif p_info = 'S3_N' then  -- переводы БОС
				if recprop%id is not null and recprop.[STR] like '%3 Переводы без открытия счета%' then
					P_DATA:='V';
				else /*вычисляем*/
					for i in 1..v_rec_prod_tbl.count loop
						if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
							exit;
						else
							if v_rec_prod_tbl(i).prod_class =  'MAIN_DOCUM' and
							   v_rec_prod_tbl(i).p_date_begin  <= P_DATE_PRINT and
							   v_rec_prod_tbl(i).p_date_close  >= P_DATE_PRINT
							    then
								P_DATA:='V';
								exit;
							end if;
						end if;
					end loop;
				end if;
			elsif p_info = 'S4_N' then  -- кредиты
				if recprop%id is not null and recprop.[STR] like '%4 Кредитование%' then
					P_DATA:='V';
				else /*вычисляем*/
					for i in 1..v_rec_prod_tbl.count loop
						if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
							exit;
						else
							if v_rec_prod_tbl(i).prod_class in ('KRED_PERS','OVERDRAFTS') and
							   v_rec_prod_tbl(i).p_date_begin  <= P_DATE_PRINT and
							   v_rec_prod_tbl(i).p_date_close  >= P_DATE_PRINT
							    then
								P_DATA:='V';
								exit;
							end if;
						end if;
					end loop;
				end if;
			elsif p_info = 'S5_N' then  -- операции с Цен.Бум.
				if recprop%id is not null and recprop.[STR] like '%5 Операции с ценными бумагами%' then
					P_DATA:='V';
				else /*вычисляем*/
					for nod in ::[NS_OPER_DOG]
					where	nod.[AGENT]%id = client_priv%id or
							nod.[CLIENT_F]%id = client_priv%id or
							nod.[COAGENT]%id  = client_priv%id
					loop
						P_DATA:='V';
						exit;
					end loop;
				end if;
			elsif p_info = 'S6_N' then  -- сейф.ячейки
				if recprop%id is not null and recprop.[STR] like '%6 Сейфовые ячейки%' then
					P_DATA:='V';
				else /*вычисляем*/
					for i in 1..v_rec_prod_tbl.count loop
						if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
							exit;
						else
							if v_rec_prod_tbl(i).prod_class =  'IND_SAFE_LEASE' and
							   v_rec_prod_tbl(i).p_date_begin  <= P_DATE_PRINT and
							   v_rec_prod_tbl(i).p_date_close  >= P_DATE_PRINT
							    then
								P_DATA:='V';
								exit;
							end if;
						end if;
					end loop;
				end if;
			elsif p_info = 'S7_N' then  -- ПК
				if recprop%id is not null and recprop.[STR] like '%7 Оформление ПК%' then
					P_DATA:='V';
				else /*вычисляем*/
					for i in 1..v_rec_prod_tbl.count loop
						if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
							exit;
						else
							if v_rec_prod_tbl(i).prod_class =  'VZ_CARDS' and
							   v_rec_prod_tbl(i).p_date_begin  <= P_DATE_PRINT and
							   v_rec_prod_tbl(i).p_date_close  >= P_DATE_PRINT
							    then
								P_DATA:='V';
								exit;
							end if;
						end if;
					end loop;
				end if;
/*			elsif p_info = 'S8_N' then  -- Тек.счета
				if recprop%id is not null and recprop.[STR] like '%8 Текущий счет%' then
					P_DATA:='V';
				else --вычисляем
					for i in 1..v_rec_prod_tbl.count loop
						if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
							exit;
						else
							if v_rec_prod_tbl(i).prod_class in ('DEPOSIT_MULT','DEPOSIT_PRIV') and
							   v_rec_prod_tbl(i).p_date_begin  <= P_DATE_PRINT and
							   v_rec_prod_tbl(i).p_date_close  >= P_DATE_PRINT and
							   (v_rec_prod_tbl(i).p_acc like '40817%' or
								v_rec_prod_tbl(i).p_acc like '40820%')
							    then
								P_DATA:='V';
								exit;
							end if;
						end if;
					end loop;
				end if;*/
			elsif p_info = 'S10_N' and recprop.[STR] like '%#%' then
				P_DATA:='V';
			elsif p_info = 'S10txtN' and recprop.[STR] like '%#%' then
				P_DATA := substr(recprop.[STR],instr(recprop.[STR],'#')+1);
			end if; -- по 'S_%'
--< ivanov a.v. 14/06/2017 Анкета
		elsif p_info in ('D1_','D2_') then -- PSB_PASP  (Паспорт действительный/недействительный
			for rec in cl_ref.[ADD_PROP]
			where rec.[GROUP_PROP].[CODE] = 'PSB_PASP'
			loop recprop:=rec;
				exit;
			end loop;
			if p_info = 'D1_' then  -- Паспорт всегда действительный, если прямо не указано обратное!!
				if recprop%id is null or recprop%id is not null and nvl(recprop.[BOOL],true) then
					P_DATA:='V';
				end if;
			elsif p_info = 'D2_' then  -- Паспорт недействительный, если это прямо указано!!
				if recprop%id is not null and nvl(recprop.[BOOL],true) then
					P_DATA:='V';
				end if;
			end if;

		elsif p_info in ('V1_','V2_','V3_','V4_','V5_','V6_','V7_','V8_','V9_','V10_','V10txt') then -- CL_ANK_PURPOSES_ACTIV Цели финансово-хозяйственной деятельности
			for rec in cl_ref.[ADD_PROP]
			where rec.[GROUP_PROP].[CODE] = 'CL_ANK_PURPOSES_ACTIV'
			loop
				recprop:=rec;
				exit;
			end loop;
			if recprop%id is NOT NULL then
				if p_info = 'V1_' and recprop.[STR] like '%1 Работа по найму в бюджетной организации%' then
					P_DATA:='V';
				elsif p_info = 'V2_' and recprop.[STR] like '%2 Работа по найму в коммерческой организации%' then
					P_DATA:='V';
				elsif p_info = 'V3_' and recprop.[STR] like '%3 Работа по гражданско-правовому договору (фрилансер и т.д.)%' then
					P_DATA:='V';
				elsif p_info = 'V4_' and recprop.[STR] like '%4 Социальные выплаты (пенсия, пособие)%' then
					P_DATA:='V';
				elsif p_info = 'V5_' and recprop.[STR] like '%5 Стипендия%' then
					P_DATA:='V';
				elsif p_info = 'V6_' and recprop.[STR] like '%6 Алименты%' then
					P_DATA:='V';
				elsif p_info = 'V7_' and recprop.[STR] like '%7 Дивиденды%' then
					P_DATA:='V';
				elsif p_info = 'V8_' and recprop.[STR] like '%8 Наследство%' then
					P_DATA:='V';
				elsif p_info = 'V9_' and recprop.[STR] like '%9 Предпринимательская деятельность%' then
					P_DATA:='V';
				elsif p_info = 'V10_' and recprop.[STR] like '%#%' then
					P_DATA:='V';
				elsif p_info = 'V10txt' and recprop.[STR] like '%#%' then
					P_DATA:=substr(recprop.[STR],instr(recprop.[STR],'#')+1);
				end if;
			end if;
		elsif p_info in ('W1_','W2_') then -- в списке террористов
			if p_info  = 'W1_' then
				for ch in ::[CL_CHECK_RESULT]
				where	ch.[CHECK_OBJ]%id = cl_ref%id and
						upper(ch.[CHECK_VAL].[CODE]) not like '%CLEAR%' and
						upper(ch.[CHECK_VAL].[CODE]) not like '%NEED%' and
						ch.[CHECK_DATE]<=P_DATE_PRINT
				loop
					P_DATA:='V';
					exit;
				end loop;
			elsif p_info  = 'W2_' then
				P_DATA:='V';
				for ch in ::[CL_CHECK_RESULT]
				where	ch.[CHECK_OBJ]%id = cl_ref%id and
						upper(ch.[CHECK_VAL].[CODE]) not like '%CLEAR%' and
						upper(ch.[CHECK_VAL].[CODE]) not like '%NEED%'  and
						ch.[CHECK_DATE]<=P_DATE_PRINT
				loop
					P_DATA:='';
					exit;
				end loop;
			end if;
		elsif p_info = 'FORM_CODE' then
			P_DATA	:= client_corp.[FORM_CODE];

		elsif p_info = 'КАПИТАЛ' then		--КАПИТАЛ
			P_DATA := nvl(client_corp.[REGISTER].[DECLARE_UF], '');
			if P_DATA is not null then
				P_DATA := P_DATA || ' '||client_corp.[REGISTER].[DECLARE_UF_CUR].[INT_CUR_SHORT];
			end if;
			P_DATA := rtl.bool_char(P_DATA is not null, 'Объявленный уставной фонд: '||P_DATA||chr(13), '');
			temp_string := nvl(client_corp.[REGISTER].[PAID_UF], '');
			if temp_string is not null then
				temp_string := temp_string || ' '||client_corp.[REGISTER].[PAID_UF_CUR].[INT_CUR_SHORT];
			end if;
			P_DATA := P_DATA || rtl.bool_char(temp_string is not null, 'Оплаченный уставной фонд: '||temp_string, '');
		--06.12.2016 Картешкина добавила КАПИТАЛ_ПРОПИСЬЮ
		elsif p_info = 'КАПИТАЛ_ПРОПИСЬЮ' then	 	--КАПИТАЛ_ПРОПИСЬЮ
			::[RUNTIME].[STDLIB].N2Str(client_corp.[REGISTER].[DECLARE_UF],P_DATA,client_corp.[REGISTER].[DECLARE_UF_CUR].[INT_CUR_SHORT]);		
			P_DATA := nvl(client_corp.[REGISTER].[DECLARE_UF], '')||'/'||P_DATA;
			P_DATA := rtl.bool_char(P_DATA is not null, 'Зарегистрированный уставной фонд: '||P_DATA||chr(13), '');

			::[RUNTIME].[STDLIB].N2Str(client_corp.[REGISTER].[PAID_UF],temp_string,client_corp.[REGISTER].[PAID_UF_CUR].[INT_CUR_SHORT]);
			temp_string := nvl(client_corp.[REGISTER].[PAID_UF], '')||'/'||temp_string;
			P_DATA := P_DATA || rtl.bool_char(temp_string is not null, 'Оплаченный уставной фонд: '||temp_string, '');

		elsif p_info = 'СТРУКТУРА' then	 	--СТРУКТУРА
			declare
				v_out [MEMO_32767] := '';
				v_bool boolean;
				temp_str string := 'Должностные лица' || chr(13);
				v_boss_counter integer;
			begin
				P_DATA := nvl(trim(client_corp.[ADMINISTRATION]), '');
				P_DATA := rtl.bool_char(P_DATA is null, null, 'Органы управления:'||chr(13)||P_DATA||chr(13)||chr(13));
				get_all_boss(client_corp, length (P_DATA)+length(temp_str), v_out, v_bool, v_boss_counter);
				if v_bool then
					V_ERR := 'Количество должностных лиц слишком велико и не может быть обработано. Взяты только первые ' || to_char(v_boss_counter) || '!';
				else
					V_ERR := '';
				end if;
				P_DATA := P_DATA||rtl.bool_char(v_out is not null, temp_str || v_out, '');
				/*if trim(P_DATA) is not NULL then  -- NGA 02/04/2013
				   str_not_empty := true;
				end if;*/
			end;

		elsif p_info = 'УЧРЕДИТЕЛИ' then		--УЧРЕДИТЕЛИ
			declare
				v_out [MEMO_32767] := '';
				v_bool boolean;
--NGA				temp_str string := 'Учредители:'||chr(13);
				temp_str string := 'Участники общества:'||chr(13);
				v_founder_counter integer;
			begin

				--NGA Get_FOUNDERS(client_corp, length(temp_str), v_out, v_bool, v_founder_counter);
				PSB_Get_FOUNDERS(client_corp, length(temp_str), v_out, v_bool, v_founder_counter);
				if v_bool then
					V_ERR := 'Количество учредителей слишком велико и не может быть обработано. Взяты только первые ' || to_char(v_founder_counter) || '!';
				else
					V_ERR := '';
				end if;
				P_DATA := rtl.bool_char(v_out is null, null, temp_str||v_out);

			end;
		
		elsif p_info = 'КОДЫ_ОКВЭД' then
			declare
				okv	[OKVED];
				date_ank	date;
			begin
				date_ank :=  nvl(client_corp.[DATE_ANK], op_dat);
				okv := ::[CLIENT].[LIB].Get_Main_OKVED(cl_ref, date_ank);
				P_DATA := 'Основной: ' || okv.[CODE] || ' ' || okv.[NAME] || NL$ || 'Допустимые: ';
				for (select vd(	vd.[OKVED].[CODE] : CODE,
								vd.[OKVED].[NAME] : NAME)
						in cl_ref.[OKVED_IN_PERIOD]
						where nvl(vd.[MAIN], false) = false
						and nvl(vd.[DATE_BEGIN], date_ank) <= date_ank
						and nvl(vd.[DATE_END], date_ank) >= date_ank
					)
				loop
					P_DATA := P_DATA || vd.[CODE] || ' ' || vd.[NAME] || NL$;
				end loop;
			end;

		elsif p_info = 'КОД_ОКПО' then
			P_DATA := client_corp.[KOD_OKPO];

		elsif p_info = 'КОД_OKATO' then
			P_DATA := client_corp.[OKATO_CODE];

		elsif p_info = 'БИК' then    --БИК
			if client_bank%id is not null then
				if cl_ref%class(true) = 'CL_PART' then
					declare
						cl_part_ref ref [CL_PART];
					begin
						cl_part_ref := cl_ref;
						P_DATA := 'БИК:'||cl_part_ref.[BANK].[BIC];
						if P_DATA is null then
							P_DATA := nvl('SWIFT:'||cl_part_ref.[BANK_F].[SWIFT_C], '');
						end if;
					end;
				else
					declare
						bank_n_ref ref [CL_BANK_N];
					begin
						bank_n_ref := cl_ref;
						P_DATA := nvl('БИК:'||bank_n_ref.[BIC], '');
					end;
				end if;
			else
				P_DATA := '';
			end if;

		elsif p_info = 'INFO_ADDR' then          --INFO_ADDR

			P_DATA := nvl(GetAddress(client_corp.[ADDRESSES],'ALL', 'FACT') || NL$ || client_corp.[INFO_ADDR],
							GetAddress(client_bank.[ADDRESSES],'ALL', 'FACT') || NL$ || client_bank.[INFO_ADDR]);

		elsif p_info = 'МЕСТО_РЕГ' then     --МЕСТО_РЕГ
			if client_corp.[REGISTER].[CITY] is not null then

				--Страна
				temp_string := nvl(client_corp.[REGISTER].[CITY].[COUNTRY].[VALUE], null);
				if temp_string is not null then
					P_DATA := temp_string||', ';
				end if;

				declare print_region	boolean := true;-- BFS00036935 - если city_id.[KLADR] следующего вида "nn00000000000" то регион не печатаем
						city_kladr		client_corp.[REGISTER].[CITY].[KLADR]%type;
						reg_kind		::[PEOPLE_PLACE].[FOR_ADDRESS]%type;
						reg_to_end		boolean;
				begin
					city_kladr := client_corp.[REGISTER].[CITY].[KLADR];
					if city_kladr is not null then
						if Length(city_kladr) <= 2 then
							print_region := false;
						else
							if Length(rtrim(city_kladr, '0')) <= 2 then
								print_region := false;
							end if;
						end if;
					end if;

					if print_region then
						-- Регион
						--temp_string := nvl(this.[REGISTER].[CITY].[REGION].[NAME], null);
						
						--Башкиров В.Г. 26.06.2014 Удалена обработка полей для ОКАТО при переходе на 14.3
							-- меняю client_corp.[REGISTER].[CITY].[REGION_GNI]
							-- на ::[PERSONAL_ADDRESS].[LIB].get_region(client_corp.[REGISTER].[CITY]%ID)
							--[PEOPLE_PLACE] на [KIND]
						reg_kind := nvl(::[PERSONAL_ADDRESS].[LIB].get_region(client_corp.[REGISTER].[CITY]%ID).[KIND].[FOR_ADDRESS], ::[PERSONAL_ADDRESS].[LIB].get_region(client_corp.[REGISTER].[CITY]%ID).[KIND].[SHORT_NAME]);
						reg_to_end := nvl(::[PERSONAL_ADDRESS].[LIB].get_region(client_corp.[REGISTER].[CITY]%ID).[KIND].[TO_END], false);
						temp_string := ::[PERSONAL_ADDRESS].[LIB].get_region(client_corp.[REGISTER].[CITY]%ID).[NAME];
						if temp_string is not null then
							if reg_to_end then
								temp_string := temp_string||' '||reg_kind;
							else
								temp_string := reg_kind||' '||temp_string;
							end if;
							P_DATA := P_DATA||temp_string||', ';
						end if;
					end if;
				end;

				--Тип нас-го пункта
				P_DATA := P_DATA||nvl(client_corp.[REGISTER].[CITY].[KIND].[SHORT_NAME], '')||' ';

				--название нас-го пункта
				temp_string := nvl(client_corp.[REGISTER].[CITY].[NAME], null);
				if temp_string is not null then
					P_DATA := P_DATA||temp_string||', ';
				end if;

				--район нас-го пункта
				--STYLY в населенном пункте хранится район области, а никак не район населенного пункта...
				--temp_string := nvl(this.[REGISTER].[DISTRICT].[NAME], this.[REGISTER].[CITY].[AREA].[NAME]);
				temp_string := client_corp.[REGISTER].[DISTRICT].[NAME];
				if temp_string is not null then
					P_DATA := P_DATA||temp_string||' р-он';
				else
					P_DATA := ltrim(rtrim(P_DATA));
					P_DATA :=substr(P_DATA,1,length(P_DATA)-1);
				end if;
			else
				P_DATA :='';
			end if;
			-- NGA для нерезидента берем место регистрации из др.поля
			if NOT client_corp.[NU_REZIDENT] then
				P_DATA := client_corp.[REGISTER].[REG_PLACE];
			end if;

		elsif p_info = 'МЕСТО_НАХОЖД' then          --МЕСТО_НАХОЖД (Юридический)
			if client_corp%id is not null then
				P_DATA := GetAddress(client_corp.[ADDRESSES],'ALL', 'CORP');
			elsif client_bank%id is not null then
				P_DATA := GetAddress(client_bank.[ADDRESSES],'ALL', 'CORP');
			end if;

		elsif p_info = 'РЕГ_ОРГАН' then     --РЕГ_ОРГАН

			if client_corp%id is not null then
				P_DATA := nvl(client_corp.[REGISTER].REGISTRAR, ' ') || ' / ' || nvl(client_corp.[REGISTER].[REG_BODY].[NAME], client_corp.[REGISTER].[REG_BODY].[LONG_NAME]);
			elsif client_bank%id is not null then
				P_DATA := nvl(client_bank.[REGISTER].REGISTRAR, ' ') || ' / ' || nvl(client_bank.[REGISTER].[REG_BODY].[NAME], client_bank.[REGISTER].[REG_BODY].[LONG_NAME]);
			end if;

		elsif p_info = 'ОП_ФОРМА' then      --ОП_ФОРМА
			P_DATA := nvl(client_corp.[FORMA].[NAME], client_corp.[FORMA].[SHORT_NAME]);

		elsif p_info = 'РЕГ_НОМЕР' then     --РЕГ_НОМЕР
			if client_corp%id is not null then
				P_DATA := nvl(client_corp.[REGISTER].[NUM_REESTR], ' ') || ' / ' || nvl(client_corp.[REGISTER].[GOS_REG_NUM_REC],' ');
			elsif client_bank%id is not null then
				P_DATA := nvl(client_bank.[REGISTER].[NUM_REESTR], ' ') || ' / ' || nvl(client_bank.[REGISTER].[GOS_REG_NUM_REC],' ');
			end if;

		elsif p_info = 'ДАТА_РЕГ' then     --ДАТА_РЕГ
			if client_corp%id is not null then
				P_DATA := nvl(::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REESTR]), ' ') || ' / ' || nvl(::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REG]), ' ');
--				rtl.bool_char(client_corp.[REGISTER].[DATE_REG] is not null, ::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REG]), rtl.bool_char(client_corp.[REGISTER].[DATE_REESTR] is not null, 'Дата внесения в ЕГРЮЛ до 1 января 2004 года: '||::[RUNTIME].[FDP].pdat(client_corp.[REGISTER].[DATE_REESTR]), ''));
			elsif client_bank%id is not null then
				P_DATA := nvl(::[RUNTIME].[FDP].pdat(client_bank.[REGISTER].[DATE_REESTR]), ' ') || ' / ' || nvl(::[RUNTIME].[FDP].pdat(client_bank.[REGISTER].[DATE_REG]), ' ');
			end if;
		--Картешкина 22.12.2016 добавила ЧИСЛЕННОСТЬ
		elsif p_info = 'ЧИСЛЕННОСТЬ' then
			if client_corp%id is not null then
				P_DATA := client_corp.[NUMBERS];
			end if;
		--Картешкина 22.12.2016 добавила СЧЕТА_В_БАНКАХ_ДА
		elsif p_info = 'СЧЕТА_В_БАНКАХ_ДА' then
				P_DATA := '_';
				if client_corp%id is not null then
					for acc_bank in client_corp.[ACC_BANK] where
							nvl(acc_bank.[DATE_BEGIN],to_date('01.01.1980','dd.mm.yyyy')) <= P_DATE_PRINT and
							nvl(acc_bank.[DATE_END],to_date('01.01.4000','dd.mm.yyyy')) >  P_DATE_PRINT and
							nvl(acc_bank.[BANK].[DATE_OP],to_date('01.01.1980','dd.mm.yyyy')) <= P_DATE_PRINT
					loop
						if is_bank_active (acc_bank.[BANK]) then
							if P_DATA = '_' then
								P_DATA := 'V';
								exit;
							end if;
						end if;
					end loop;
				end if;
		--Картешкина 22.12.2016 добавила СЧЕТА_В_БАНКАХ_НЕТ
		elsif p_info = 'СЧЕТА_В_БАНКАХ_НЕТ' then
				P_DATA := 'V';
				if client_corp%id is not null then
					for acc_bank in client_corp.[ACC_BANK] where
							nvl(acc_bank.[DATE_BEGIN],to_date('01.01.1980','dd.mm.yyyy')) <= P_DATE_PRINT and
							nvl(acc_bank.[DATE_END],to_date('01.01.4000','dd.mm.yyyy')) >  P_DATE_PRINT and
							nvl(acc_bank.[BANK].[DATE_OP],to_date('01.01.1980','dd.mm.yyyy')) <= P_DATE_PRINT
					loop
						if is_bank_active (acc_bank.[BANK]) then
							P_DATA := '_';
							exit;
						end if;
					end loop;
				end if;
		--Картешкина 30.12.2016 добавила СЧЕТА_В_БАНКАХ
		elsif p_info = 'СЧЕТА_В_БАНКАХ' then
				P_DATA := ' ';
				if client_corp%id is not null then
					for acc_bank in client_corp.[ACC_BANK] where
							nvl(acc_bank.[DATE_BEGIN],to_date('01.01.1980','dd.mm.yyyy')) <= P_DATE_PRINT and
							nvl(acc_bank.[DATE_END],to_date('01.01.4000','dd.mm.yyyy')) >  P_DATE_PRINT and
							nvl(acc_bank.[BANK].[DATE_OP],to_date('01.01.1980','dd.mm.yyyy')) <= P_DATE_PRINT
					loop
						if is_bank_active (acc_bank.[BANK]) then
							if instr(P_DATA,acc_bank.[BANK].[NAME]) = 0 then
								P_DATA := P_DATA||acc_bank.[BANK].[NAME]||',';
							end if;
						end if;
					end loop;
					if P_DATA <> ' ' then
						P_DATA:=RTRIM(P_DATA,',');
					end if;
				end if;
				
		elsif p_info = 'СОЗД_СОТР' then     --СОЗДАТЕЛЬ АНКЕТЫ
			begin

			--создатель анкеты
				for ( select x(x.[USER_NAME] 	: vuser,
							x.[USER_CASTA]	: vcasta)
					in ::[CL_HIST] all
					where x.[CLIENT_REF] = cl_ref
					order by x.[DATE_EDIT]
				) loop

					P_DATA:= 'Создал(а): '||x.vuser||', '||x.vcasta;
					exit;
				end loop;
			exception when others then
				null;
			end;
		
		elsif p_info = 'ИЗМ_СОТР' then     --ИЗМ. АНКЕТУ

			P_DATA:= '';
			begin

			--последний польз. обновил анкету
			for ( select x(x.[USER_NAME]	: vuser,
							x.[USER_CASTA]	: vcasta)
					in ::[CL_HIST] all
					where x.[CLIENT_REF] = cl_ref
					order by x.[DATE_EDIT] desc
			) loop

				P_DATA:= 'Обновил(а): '||x.vuser||', '||x.vcasta;
				exit;
			end loop;

			exception when others then
				null;
			end;

		elsif p_info = 'ИЗМ_СОТР_NEW' then     --ИЗМ. АНКЕТУ

--> ivanov a.v. 17/04/2017 Анкета
			P_DATA:= '';
			/** /
			for ( select x(	x.[WHO_UPDATE].[NAME]			: vuser,
							x.[WHO_UPDATE].[CASTA].[VALUE]	: vcasta)
					in [CL_DATE_FORM_UPD],
						([CLIENT] all cl) all
					where	cl%id = cl_ref and
							x%collection = cl.[DATES_FORM_UPD] and
							x.[DATE_UPD] <= P_DATE_PRINT and
							x.[WHO_UPDATE] is not null
					order by x.[DATE_UPD] desc
			) loop
				P_DATA:= 'Обновил(а): '||x.vuser||', '||x.vcasta;
				exit;
			end loop;
			/**/
			
			if P_DATA is null then
				for i in 1..v_rec_prod_tbl.count loop
					if v_rec_prod_tbl(i).p_date_begin > P_DATE_PRINT then
						exit;
					else
						v_max_user := v_rec_prod_tbl(i).create_user;
					end if;
				end loop;
				if v_max_user is not null then
					for (	select us (	us.[NAME]			: vuser,
										us.[CASTA].[VALUE]	: vcasta)
							 in ::[USER] all where us%id = v_max_user)
					loop
						P_DATA:= 'Обновил(а): '||us.vuser||', '||us.vcasta;
					end loop;
				end if;
			end if;
--< ivanov a.v. 17/04/2017 Анкета

		--NGA20/07/2015  end
		end if; --end P_info
--debug_pipe('вышли! p_info = '||p_info  ||'   P_DATA='||P_DATA,0);
		
		if P_INFO not in (	'ДА','НЕТ','ИНОСТР_ГОС','НЕТ_БЕН','БЕН_ВЛАД_N'
							,'S1_','S2_','S3_','S4_','S5_','S6_','S7_','S8_','S10_','S10txt'
--> ivanov a.v. 17/04/2017 Анкета
							,'S1_N','S2_N','S3_N','S4_N','S5_N','S6_N','S7_N','S8_N','S10_N','S10txtN'
--< ivanov a.v. 17/04/2017 Анкета
							,'D1_','D2_'
							,'V1_','V2_','V3_','V4_','V5_','V6_','V7_','V8_','V9_','V10_','V10txt'
							,'W1_','W2_'
						) AND P_INFO not like '%ПДЛ%' then
		if (P_DATA = '') or (P_DATA = ' ') or P_DATA is null then P_DATA := 'Отсутствует'; end if;  -- NGA20/05/2015 Эти коды на "Отсутствует" не заменяем!
		end if;

		P_DATA := nvl(P_DATA, ' ');

	return P_DATA;
exception when OTHERS then
	pragma error('Ошибка при вычисление реквизитов клиента. Ошибка '||sqlerrm);
end;

--Дианков А.В. 20.09.2016 Есть ли СНИЛС?
public function CL_SNILS(cl ref [CLIENT]) return boolean is 
dt date := [SYSTEM].[OP_DATE];
begin
	if cl%class = 'CL_PRIV' then
		--27/12/2016 Дианков А.В. Добавлен контроль реквизита СНИЛС
		if cl -> (CL_PRIV)[SNILS] is not null then return true; end if;
		for doc in cl -> (CL_PRIV)[DOC_ARR] where doc.[TYPE].[KOD] = 'СНИЛС'
												  AND (doc.[DATE] <= dt OR doc.[DATE] is null)
												  AND (doc.[DATE_END] is null OR dt <= doc.[DATE_END])
		loop
			if doc.[NUM] is not null OR doc.[SER] is not null then
			--cl->(CL_PRIV)[SNILS] := doc.num;
				return true;
			end if;
		end loop;

		return false;
	end if;
end;
end;
