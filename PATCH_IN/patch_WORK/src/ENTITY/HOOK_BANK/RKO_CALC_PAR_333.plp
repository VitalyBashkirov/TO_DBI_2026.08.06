							end if;
						end loop;
					end Loop;
					debug_pipe(sm);
					
					/*for ksim in mn_ref.[SUM_KSPL] loop
						if ksim.[1].[1]<>40 and ksim.[1].[1]<>50 then
							sm := sm + ksim.[2];
						end if;
					end loop;*/
					
					if sm<=10000 then
						ExMemo:= 1; goto nnn;
					elsif sm>10000 and sm<=500000 then
						ExMemo:= 2;
					elsif sm>500000 and sm<=1000000 then
						ExMemo:= 3; goto nnn;
					elsif sm>1000000 and sm<=5000000 then
						ExMemo:= 4;
					elsif sm>5000000 then
						ExMemo:= 5; goto nnn;
					end if;
				exception
				when NO_DATA_FOUND then
					Null;
				end;
				ExMemo:= Null;
			end;
		end if;
		
		if P_PAR = 'ОРЛ_БЮДЖЕТ' then
			if mn_ref.[BUDGET_PAYMENT] then
				if mn_ref.[PRIORITET]>=5 then
					ExMemo:= '0'; goto nnn;
				else
					ExMemo:= '1';
				end if;
			else
				ExMemo:= '0'; goto nnn;
			end if;
		end if;
		
		if P_PAR = 'ОРЛ_ПЛ_ДБ' then
			vacc := P_PROD->([RKO])[ACCOUNT];
			declare
				sm number;
				sm_nt number;
				smx number;
			begin
				sm := 0;
				sm_nt := 0;
				smx := 0;
				smx:=mn_ref.[SUM];
				if mn_ref%state = 'PROV' then
					dtt := trunc(mn_ref.[DATE_PROV]);
					--dtt := [SYSTEM]::[OP_DATE];
					dta := mn_ref.[ASTR_DATE_PROV];
				else
					dtt := [SYSTEM]::[OP_DATE];
					dta := [SYSTEM]::[OP_DATE]+1;
				end if;
				debug_pipe(dtt||' '||dta);
				debug_pipe(vacc.[MAIN_V_ID]||' '||nvl(vacc.[GET_SALDO](dtt-1, sm, sm_nt, null, true),0)||' '||smx);
				debug_pipe(vacc.[MAIN_V_ID]||' '||nvl(vacc.[GET_SALDO](dtt, sm, sm_nt, null, true),0)||' '||smx);
				for doo in CURSOR mndc_a Loop null;
					debug_pipe(doo.COUNT_DOC||' '||doo.SUMMA);
					if doo.SUMMA<=sm then
						ExMemo:= '0';
					else
						ExMemo:= '1'; goto nnn;
					end if;
				end Loop;
			end;
		end if;
		
		if P_PAR = 'ОРЛ_СУМ_ПР_ЗАЯ' then
			vacc := P_PROD->([RKO])[ACCOUNT];
			declare
				sm number;
				sk number;
				sp number;
				rko ref	[RKO];
				dc ref	[MAIN_DOCUM];
			begin
				begin
					sm := 0;
					sk := 0;
					sp := 0;
					dc := null;
					rko := P_PROD;
					
					if mn_ref%state = 'PROV' then
						dtt := trunc(mn_ref.[DATE_PROV]);
						dta := mn_ref.[ASTR_DATE_PROV];
					else
						dtt := [SYSTEM]::[OP_DATE];
						dta := [SYSTEM]::[OP_DATE]+1;
					end if;
					
					for s in rko.[DAILY] where s.[DAT] = trunc(nvl(mn_ref.[DATE_PROV],mn_ref.[DATE_DOC])) loop
						sk := sk + s.[TO_ARM];
						--debug_pipe('1 '||sk);
					end loop;
					
					for doo in CURSOR mndc_kas Loop null;
						--debug_pipe(doo.dc||' '||doo.SM);
						for ksim in doo.dc.[SUM_KSPL] loop
							if ksim.[1].[1]<>40 and ksim.[1].[1]<>50 then
								sm := sm + ksim.[2];
								--debug_pipe('2 '||ksim.[2]);
								
								if sm <= sk then
									null;
								else
									if sp = 0 then
										sp := sm - sk;
									else
										sp := ksim.[2];
									end if;
								end if;
								
							end if;
						end loop;
						
						dc := mn_ref;
						if doo.dc = mn_ref then
							exit;
						end if;
					end Loop;
					
					debug_pipe(sm||' '||sk||' '||sp);
					ExMemo:= sp;
				exception
				when NO_DATA_FOUND then
					Null;
				end;
				ExMemo:= Null; goto nnn;
			end;
		end if;
	end if;
	ExMemo:= null;

	--Башкиров В.Г. 17.06.2019 Расчет PSB_RECEIVER_FL-[ПСБ] Перевод со счета индивидуального предпринимателя на свой счёт физического лица или счет иного физического лица
	ExMemo:=CalcParamsBWG(P_PAR,P_DOC,P_PROD,P_PATT);
	
	<<nnn>>
	&debug('ExMemo->'||ExMemo,dp)
END;
end;
end;
