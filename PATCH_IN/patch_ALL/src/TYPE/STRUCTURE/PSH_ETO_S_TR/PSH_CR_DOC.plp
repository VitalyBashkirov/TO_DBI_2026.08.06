class PSH_ETO_S_TR;

@name('[ПСБ] Создать документы и отправить на обработку') /* Свойство операции "Наименование" */
method PSH_CR_DOC is

/* Секция глобальных переменных *
@name('пример переменной 1') public V_EXAMPLE1 [STRING_100];
@name('пример переменной 2') public V_EXAMPLE2 [NUMBER];
/* Конец секции глобальных переменных */
	
/* Описания */
cvTransactionTypeDebit	const varchar2(1)		:= ::[PSH_ETO_SVXP_REG].[PSH_CL].cvEntryTypeDebit;
cvTransactionTypeCredit	const varchar2(1)		:= ::[PSH_ETO_SVXP_REG].[PSH_CL].cvEntryTypeCredit;
cvBoCt					const ref [PATTERN_DOC]	:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getBoFromMapByValue('PREP_CT_MIR_REFUND');
cvBoDt					const ref [PATTERN_DOC]	:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getBoFromMapByValue('PREP_DT_MIR_PAYMENT');
cvRko					const ref [RKO]			:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getRkoForBo();
cvCalcParCardAccount	const varchar2(19)		:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].cv_calc_par_card_account;
cvCalcParCardAmount		const varchar2(18)		:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].cv_calc_par_card_amount;
cvCalcParMerchantName	const varchar2(15)		:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].cv_calc_par_merchant_name;

/* Блок инициализации */

/* Описания */

function getCardNumberMasked(pCardNumber varchar2) return varchar2 is
	vFirstPartLen	const integer := 6;
	vLastPartLen	const integer := 4;
	vMaskPartLen	const integer := length(pCardNumber) - (vFirstPartLen + vLastPartLen);
	vMaskSymbol		const varchar2(1) := '*';
begin
	return substr(pCardNumber, 1, vFirstPartLen) || lpad(vMaskSymbol, vMaskPartLen, vMaskSymbol) || substr(pCardNumber, -vLastPartLen);
end;

function getMerchantForNazn(pMerchantName varchar2, pOperDate date, pAmount number, pCardNumber varchar2) return varchar2 is
begin
	return 'В ' || trim(pMerchantName) || ' от ' || to_char(pOperDate, 'dd/mm/yyyy hh24:mi')
		|| ', сумма ' || pAmount || 'руб., карта ' || getCardNumberMasked(pCardNumber);
end;

procedure GetParams(pTransactionsCollection [PSH_ETO_S_OP].[TRANSACTIONS], pDateVal out date, pMerchant out varchar2) is begin
	for (select x(x.[MERCHANT_NAME]					:cMerchantName
				 ,x.[OPER_DATE]						:cOperDate
				 ,x.[TRANSACTIONS].[AMOUNT_VALUE]	:cAmountValue
				 ,x.[CARD_NUMBER]					:cCardNumber
				 )
		 in ::[PSH_ETO_S_OP] all
		 where x.[TRANSACTIONS] = pTransactionsCollection
		)
	loop
		pMerchant	:= getMerchantForNazn(x.cMerchantName, x.cOperDate, x.cAmountValue, x.cCardNumber);
	end loop;
	if pDateVal	is null then
		pDateVal := sysdate;
	end if;
end;

PSH_CR_DOC
/* Секция параметров операции */
(
	@name('Дата валютирования') P_DATE_VAL in [DATE],
	@name('Merchant') P_MERCHANT in [STRING_2000],
	@name('Отправить на обработку') P_POST_2_PROCESS in [BOOLEAN]
) 
/* Конец секции параметров операции */
	return ref [FOLDER_PAY] is

validate is /* Секция "Проверка" */
begin
	if P_MESSAGE = 'DEFAULT' then
		P_POST_2_PROCESS := false;
		GetParams(this%collection, P_DATE_VAL, P_MERCHANT);
	end if;
end;

execute is /* Секция "Тело" */
	vAcFinRef	ref [AC_FIN];
	vPar4Bo			[STRING_32767];
	vFolder		ref [FOLDER_PAY];
	vBo			ref [PATTERN_DOC];
begin
	GetParams(this%collection, P_DATE_VAL, P_MERCHANT);
	vAcFinRef	:= ::[PSH_ETO_SVXP_REG].[PSH_CL].getAcFinByNum(this.[ACCOUNT_NUMBER]);
	[STR].set_par(vPar4Bo, cvCalcParCardAccount,	vAcFinRef);
	[STR].set_par(vPar4Bo, cvCalcParCardAmount,		this.[AMOUNT_VALUE]);
	[STR].set_par(vPar4Bo, cvCalcParMerchantName,	P_MERCHANT);

	vBo := case
			when this.[ENTRY_TYPE] = cvTransactionTypeDebit then cvBoDt
			when this.[ENTRY_TYPE] = cvTransactionTypeCredit then cvBoCt
			else null
			end;

	vBo.[BUSINESS_OP](null, cvRko, null, null, null, vFolder, P#ADDS == vPar4Bo);

	this.[FOLDER] := vFolder;

	::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].setDateValForFolderDocs(vFolder, P_DATE_VAL);
	::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].setDocumentUnoForFolderDocs(vFolder, 'PREPR');
	::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].writeBaseValOpForFolderDocs(vFolder);

	if P_POST_2_PROCESS then
		::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].postForProcess(vFolder);
	end if;

	return vFolder;
end;

end; 
end; /* конeц method CR_DOC */
