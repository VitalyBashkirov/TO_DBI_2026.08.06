class PSH_ETO_CARD;

@name('[ПСБ] Библиотека функций, для интерфейсов интегратора')
library PSH_CIT_INT_LIB is

pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma include(::[INTERFACE].[COMPILE_LIB]);
--pragma macro(cl, '::[PSH_ETO_CARD].[PSH_CL]')

cv_tune_bo_map	const ref [FP_TUNE] := ::[FP_TUNE]([CODE] = 'PSH_MAP_BO');
v_tune_values	[FP_TUNE].[VALUES];
v_rko_for_bo	ref [RKO];

public cv_calc_par_card_account		const varchar2(19) := 'PSH_PREPAID_ACCOUNT';
public cv_calc_par_card_account_new	const varchar2(23) := 'PSH_PREPAID_ACCOUNT_NEW';
public cv_calc_par_card_amount		const varchar2(18) := 'PSH_PREPAID_AMOUNT';
public cv_calc_par_merchant_name	const varchar2(15) := 'PSH_PREP_RETAIL';

type property_grp_ref_tab_type is table of ref [PROPERTY_GRP] index by varchar2;
v_property_grp_cache property_grp_ref_tab_type;
public cv_property_grp_CRS_INVEST_NATIONALITY			const varchar2(22) := 'CRS_INVEST_NATIONALITY';
public cv_property_grp_CRS_TIN							const varchar2( 7) := 'CRS_TIN';
public cv_property_grp_CRS_TIN_ABSCENCE					const varchar2(16) := 'CRS_TIN_ABSCENCE';
public cv_property_grp_CRS_REASON_FOR_TIN_ABSCENCE		const varchar2(27) := 'CRS_REASON_FOR_TIN_ABSCENCE';
public cv_property_grp_CRS_SUBREASON_FOR_TIN_ABSCENCE	const varchar2(30) := 'CRS_SUBREASON_FOR_TIN_ABSCENCE';
public cv_property_grp_NEED_CHECK						const varchar2(10) := 'NEED_CHECK';
public cv_property_grp_PP_FOREIGN_PUBLIC_OFFICIAL		const varchar2(26) := 'PP_FOREIGN_PUBLIC_OFFICIAL';
public cv_property_grp_PP_INTERNATIONAL_PUBLIC_OFFICIAL	const varchar2(32) := 'PP_INTERNATIONAL_PUBLIC_OFFICIAL';
public cv_property_grp_PP_RUSSIAN_PUBLIC_OFFICIAL		const varchar2(26) := 'PP_RUSSIAN_PUBLIC_OFFICIAL';
public cv_property_grp_PP_PURPOSE_OF_RELATIONSHIP		const varchar2(19) := 'CL_EXT_ANK_PRIV_N16';
public cv_property_grp_PP_PURPOSE_OF_ACTIVITY			const varchar2(19) := 'CL_EXT_ANK_PRIV_N17';
public cv_property_grp_PP_FINANCIAL_STATUS				const varchar2(19) := 'CL_EXT_ANK_PRIV_N18';
public cv_property_grp_PP_BUSINESS_REPUTATION			const varchar2(19) := 'CL_EXT_ANK_PRIV_N19';
public cv_property_grp_PP_SOURCE_OF_FUNDS				const varchar2(19) := 'CL_EXT_ANK_PRIV_N20';
public cv_property_grp_PP_NEED_CHECK					const varchar2(13) := 'PP_NEED_CHECK';

public type prop_codes_tab_type is varray(0) of [PROPERTY_GRP].[CODE]%type;
prop_codes_varr	prop_codes_tab_type;

public type docs_in_fold_tab_type is varray(0) of ref [MAIN_DOCUM];

public function getPropCodesVarr return prop_codes_tab_type is begin
	return prop_codes_varr;
end;

function getFpTuneCanonVal(p_fptune_values [FP_TUNE].[VALUES]%type, p_fptune_value [FP_TUNE_VAL].[VALUE]%type, p_canon_num integer := 1) return varchar2;

--TODO: можно закешировать, уточнить - надо ли?
public function getBoFromMapByValue(p_fptune_value [FP_TUNE_VAL].[VALUE]%type) return ref [PATTERN_DOC] is
begin
	return getFpTuneCanonVal(v_tune_values, p_fptune_value);
end;

public function getRkoForBo return ref [RKO] is
begin
	return v_rko_for_bo;
end;

public function getPropertyGrpFromCache(p_property_grp_code [PROPERTY_GRP].[CODE]%type) return ref [PROPERTY_GRP] is
begin
	if v_property_grp_cache.exists(p_property_grp_code) then
		return v_property_grp_cache(p_property_grp_code);
	end if;
	return null;
end;

public function postForProcess(p_folder ref [FOLDER_PAY]) return docs_in_fold_tab_type is
	v_docs_in_fold_tab	docs_in_fold_tab_type;
begin
	select x(x.[DOCUMENT]	:c_document)
	in p_folder.[DOCS_IN_FOLD]
	bulk collect into v_docs_in_fold_tab;

	for x in v_docs_in_fold_tab.first..v_docs_in_fold_tab.last loop
		v_docs_in_fold_tab(x).[PSH_TO_EVENT](null);
		&debug('.postForProcess: event for process v_docs_in_fold_tab(x) = ' || v_docs_in_fold_tab(x), 0)
	end loop;

	return v_docs_in_fold_tab;
end;

public function getCard(p_card_number [PSH_ETO_CARD].[CARD_NUMBER]%type) return [PSH_ETO_CARD] is
	v_eto_card	[PSH_ETO_CARD];
begin
	&debug('.getCard Begin: p_card_number = ' || p_card_number, 0)
	for (select x(x								:c_id
				 ,x.[CARD_ACCOUNT]				:c_ac
				 ,x.[OPERATIONS]				:c_op
				 )
		 in ::[PSH_ETO_CARD]
		 where x.[CARD_NUMBER] = p_card_number
		 --TODO: карта должна быть действующей
		 --and x.[HOT_CARD_STATUS] = &cl.CV_CARD_STATUS_ACTIVE
		)
	loop
		v_eto_card%id				:= x.c_id;
		v_eto_card.[CARD_ACCOUNT]	:= x.c_ac;
		v_eto_card.[OPERATIONS]		:= x.c_op;
	end loop;
	&debug('.getCard End: v_eto_card%id = ' || v_eto_card%id, 0)
	return v_eto_card;
end;

function getFpTuneValuesArr(p_fptune ref [FP_TUNE]) return [FP_TUNE].[VALUES]%type is
begin
	for (select x(x.[VALUES] :c_fptune_values) in p_fptune)
	loop
		return x.c_fptune_values;
	end loop;
	return null;
end;

function getFpTuneCanonVal(p_fptune_values [FP_TUNE].[VALUES]%type, p_fptune_value [FP_TUNE_VAL].[VALUE]%type, p_canon_num integer := 1) return varchar2 is
begin
	for (select x(x.[CANON_VALS] :c_canon_vals)
		 in p_fptune_values
		 where x.[VALUE] = p_fptune_value
		)
	loop
		return substr(x.c_canon_vals, ::[FP_TUNE].[LIB].code_len * (p_canon_num - 1) + 1, ::[FP_TUNE].[LIB].code_len);
	end loop;
	return null;
end;

function getAnyRkoForBo return ref [RKO] is
begin
	/*
	 * По аналогии с дистрибутивной MAIN_DOCUM.TAKE_CHARGES - 'Новая сложная проводка':
	 * 'Ищем любой закрытый договор, для совместимости...'
	 * только без лишнего джоина и с более хорошим планом
	 */
	pragma hint('first_rows(1)');
	for (select x(x :c_id)
		 in ::[PRODUCT] all
		 where x%class = ::[RKO]%class
		 and x.[DATE_CLOSE] is not null
		 and x.[COM_STATUS] = [COM_STATUS_PRD]([CODE]='CLOSE')
		 and x.[FILIAL] = ::[BRANCH]([CODE] = '001')
--		 and x.[DEPART] = ::[DEPART]([CODE] = '001')
		)
	loop
		return x.c_id;
	end loop;
	return null;
end;

function initPropertyGrpCache return property_grp_ref_tab_type is
	v_property_grp_cache property_grp_ref_tab_type;
begin
	for (select x(x			:c_id
				 ,x.[CODE]	:c_code
				 )
		 in ::[PROPERTY_GRP]
		 where x.[CODE] in /*( cv_property_grp_CRS_INVEST_NATIONALITY
							,cv_property_grp_CRS_TIN
							,cv_property_grp_CRS_TIN_ABSENCE
							,cv_property_grp_CRS_REASON_FOR_TIN_ABSENCE
							,cv_property_grp_CRS_SUBREASON_FOR_TIN_ABSENCE
							,cv_property_grp_NEED_CHECK
		 					)*/
		 					(select t(t.column_value) in prop_codes_varr)
	)
	loop
		v_property_grp_cache(x.c_code) := x.c_id;
	end loop;
	return v_property_grp_cache;
end;

public function writeCardOperation(pCardOperations ::[PSH_ETO_CARD].[OPERATIONS]%type, pCitInRequest [PSH_ETO_C_OP].[CIT_REQUEST]%type := null, pFolderPay [PSH_ETO_C_OP].[FOLDER_PAY]%type := null, pExtId [PSH_ETO_C_OP].[EXT_ID]%type := null) return ref [PSH_ETO_C_OP] is
	vInsertedOperationId ref [PSH_ETO_C_OP];
begin
	&debug('.writeCardOperation Begin: pCardOperations = ' || pCardOperations || ', pCitInRequest = ' || pCitInRequest || ', pFolderPay = ' || pFolderPay || ', pExtId = ' || pExtId, 0)
	insert into pCardOperations
	x(x.[DT]			= sysdate
	 ,x.[CIT_REQUEST]	= pCitInRequest
	 ,x.[FOLDER_PAY]	= pFolderPay
	 ,x.[EXT_ID]		= pExtId
	 )
	return x into vInsertedOperationId;
	&debug('.writeCardOperation End: vInsertedOperationId = ' || vInsertedOperationId, 0)
	return vInsertedOperationId;
end;

public function writeCardOperationAT(pCardOperations ::[PSH_ETO_CARD].[OPERATIONS]%type, pCitInRequest ref [CIT_IN_REQUEST] := null, pFolderPay ref [FOLDER_PAY] := null) return ref [PSH_ETO_C_OP] is
	pragma autonomous_transaction;
	vInsertedOperationId ref [PSH_ETO_C_OP];
begin
	&debug('.writeCardOperationAT Begin: pCardOperations = ' || pCardOperations || ', pCitInRequest = ' || pCitInRequest || ', pFolderPay = ' || pFolderPay, 0)
	vInsertedOperationId := writeCardOperation(pCardOperations, pCitInRequest, pFolderPay);
	commit;
	&debug('.writeCardOperationAT End: vInsertedOperationId = ' || vInsertedOperationId, 0)
	return vInsertedOperationId;
end;

public procedure setDateValForFolderDocs(pFolder ref [FOLDER_PAY], pDateVal date) is
	vAccOper ::[MAIN_DOCUM].[ACC_OPER]%type;
begin
	if pFolder is not null and pDateVal is not null then
		if trunc(pDateVal) <= ::[SYSTEM].[OP_DATE] then
			pDateVal := trunc(pDateVal + 1) - 1/86400;	-- 'pDateVal 23:59:59'
			vAccOper := ::[ACC_OPER]([CODE] = '40');
		else
			pDateVal := trunc(pDateVal);				-- 'pDateVal 00:00:00'
			vAccOper := null;
		end if;

		update x(x.[DATE_VAL] = pDateVal
				,x.[ACC_OPER] = vAccOper
				)
		in ::[MAIN_DOCUM]
		where x.[IN_FOLDER] = pFolder;
	end if;
end;

public procedure setDocumentUnoForFolderDocs(pFolder ref [FOLDER_PAY], pDocumentUno [MAIN_DOCUM].[DOCUMENT_UNO]%type) is
begin
	if pFolder is not null then
		update x(x.[DOCUMENT_UNO] = pDocumentUno)
		in ::[MAIN_DOCUM]
		where x.[IN_FOLDER] = pFolder;
	end if;
end;

public procedure setHistoryStateForFolderDocs(pFolder ref [FOLDER_PAY], pState [HISTORY_STATES].[STATE]%type, pAddInfo [HISTORY_STATES].[ADD_INFO]%type) is
	vHistoryState [HISTORY_STATES];
begin
	if pFolder is not null then
		vHistoryState.[DATE]	:= sysdate;
		vHistoryState.[STATE]	:= pState;
		vHistoryState.[ADD_INFO]:= pAddInfo;
		for (select x(x.[HISTORY_STATE] :cDocumentHistoryState)
			 in ::[DOCUMENT] all
			 where x.[IN_FOLDER] = pFolder
			)
		loop
			x.cDocumentHistoryState%insert(vHistoryState);
		end loop;
	end if;
end;

public procedure writeBaseValOpForFolderDocs(pFolder ref [FOLDER_PAY]) is
	type CL_REQ_REC_TYPE is record ( name	::[CLIENT].[NAME]%type
									,inn	::[CLIENT].[INN]%type
									,kpp	::[CLIENT].[KPP]%type
									,dateReestr	::[CL_CORP].[REGISTER].[DATE_REESTR]%type
									,dateReg	::[CL_CORP].[REGISTER].[DATE_REG]%type
									,addr			::[BASE_VAL_OP].[ADDRESS]%type
									,countryCode	::[BASE_VAL_OP].[COUNTRY_CODE]%type
									);
	type DOC_REQ_REC_TYPE is record (refDoc			ref [MAIN_DOCUM]
									,sum			::[MAIN_DOCUM].[SUM]%type
									,accDtMainVId	::[MAIN_DOCUM].[ACC_DT].[MAIN_V_ID]%type
									,accKtMainVId	::[MAIN_DOCUM].[ACC_KT].[MAIN_V_ID]%type
									,accKtDateOp	::[MAIN_DOCUM].[ACC_KT].[DATE_OP]%type
									,accKtClientV	::[MAIN_DOCUM].[ACC_KT].[CLIENT_V]%type
									,clKtReq		CL_REQ_REC_TYPE
									--,refBaseValOp	ref ::[BASE_VAL_OP]
									);
	type DOC_REQ_TAB_TYPE is table of DOC_REQ_REC_TYPE index by integer;

	vDocsInFoldTab	DOC_REQ_TAB_TYPE;
	cnt	integer;
begin
	if pFolder is null then
		return;
	end if;
	for (select x(x							:c_ref_doc
				 ,x.[SUM]					:c_sum
				 ,x.[ACC_DT].[MAIN_V_ID]	:c_acc_dt_main_v_id
				 ,x.[ACC_KT].[MAIN_V_ID]	:c_acc_kt_main_v_id
				 ,x.[ACC_KT].[DATE_OP]		:c_acc_kt_date_op

				 ,x.[ACC_KT].[CLIENT_V]			:c_acc_kt_client_v
				 ,x.[ACC_KT].[CLIENT_V].[NAME]	:c_cl_kt_req_name
				 ,x.[ACC_KT].[CLIENT_V].[INN]	:c_cl_kt_req_inn
				 ,x.[ACC_KT].[CLIENT_V].[KPP]	:c_cl_kt_req_kpp
				 ,x.[ACC_KT].[CLIENT_V]->(::[CL_CORP])[REGISTER].[DATE_REESTR]	:c_cl_kt_req_date_reestr
				 ,x.[ACC_KT].[CLIENT_V]->(::[CL_CORP])[REGISTER].[DATE_REG]		:c_cl_kt_req_date_reg
				 )
		 in ::[MAIN_DOCUM]
		 where x.[IN_FOLDER] = pFolder
		)
	loop
		cnt := vDocsInFoldTab.count + 1;
		vDocsInFoldTab(cnt).refDoc				:= x.c_ref_doc;
		vDocsInFoldTab(cnt).sum					:= x.c_sum;
		vDocsInFoldTab(cnt).accDtMainVId		:= x.c_acc_dt_main_v_id;
		vDocsInFoldTab(cnt).accKtMainVId		:= x.c_acc_kt_main_v_id;
		vDocsInFoldTab(cnt).accKtDateOp			:= x.c_acc_kt_date_op;
		vDocsInFoldTab(cnt).accKtClientV		:= x.c_acc_kt_client_v;
		vDocsInFoldTab(cnt).clKtReq.name		:= x.c_cl_kt_req_name;
		vDocsInFoldTab(cnt).clKtReq.inn			:= x.c_cl_kt_req_inn;
		vDocsInFoldTab(cnt).clKtReq.kpp			:= x.c_cl_kt_req_kpp;
		vDocsInFoldTab(cnt).clKtReq.dateReestr	:= x.c_cl_kt_req_date_reestr;
		vDocsInFoldTab(cnt).clKtReq.dateReg		:= x.c_cl_kt_req_date_reg;
	end loop;

	for x in vDocsInFoldTab.first..vDocsInFoldTab.last loop
		if vDocsInFoldTab(x).accDtMainVId like '30232%' and substr(vDocsInFoldTab(x).accKtMainVId, 1, 5) in ('40903', '40914') then
			&call_int(DOCUMENT_INT, INT_VAL_CTRL, 1).base_val_op_add_rec_doc(vDocsInFoldTab(x).refDoc);
			for (select o(o :c_ref_base_val_op)
				 in ::[BASE_VAL_OP]
				 where o.[DOC] = vDocsInFoldTab(x).refDoc
				)
			loop
				::[BASE_VAL_OP].[LIB].get_req_cl(vDocsInFoldTab(x).accKtClientV, vDocsInFoldTab(x).clKtReq.addr, vDocsInFoldTab(x).clKtReq.countryCode, vDocsInFoldTab(x).refDoc);
				update i(i.[PAYMENT_TYPE]	= 1
						,i.[SUMMA]			= vDocsInFoldTab(x).sum
						,i.[CL_NAME]		= vDocsInFoldTab(x).clKtReq.name
						,i.[CL_INN]			= vDocsInFoldTab(x).clKtReq.inn
						,i.[CL_KPP]			= vDocsInFoldTab(x).clKtReq.kpp
						,i.[CL_ACC_NUM]		= vDocsInFoldTab(x).accKtMainVId
						,i.[ACC_OPEN_DATE]	= vDocsInFoldTab(x).accKtDateOp
						,i.[DATE_REG]		= nvl(vDocsInFoldTab(x).clKtReq.dateReestr, vDocsInFoldTab(x).clKtReq.dateReg)
						,i.[COUNTRY_CODE]	= vDocsInFoldTab(x).clKtReq.countryCode
						,i.[ADDRESS]		= vDocsInFoldTab(x).clKtReq.addr
						)
				in ::[BASE_VAL_OP]
				where i = o.c_ref_base_val_op;
				exit;
			end loop;
		end if;
	end loop;
end;

--Добавление/обновление Id во внешней системе
--from CIT_OBJ.LIB
function SetExtID(p_class		[METACLASS_REF]
				 ,p_id			[REFERENCE]
				 ,p_ab 			ref [CIT_ABONENT]
				 ,p_ext_id		[REFSTRING]
				 ,p_cit_in_req	ref [CIT_IN_REQUEST]
				 ) return ref [CIT_OBJ] is
obj		[CIT_OBJ];
obj_ref	ref [CIT_OBJ];
begin
	--Поиск
	for (select x(x	:c_cit_obj_ref)
		 in ::[CIT_OBJ] all
		 where x.[EXT_ID] = p_ext_id
		 and x.[OBJ_CLASS] = p_class
		 and x.[CIT_AB] in ( ::[CIT_ABONENT](code = 'BSS')
		 					,::[CIT_ABONENT](code = 'CRS')
		 					,::[CIT_ABONENT](code = 'ETO')
		 					)
		)
	loop
		obj_ref := x.c_cit_obj_ref;
	end loop;
	if obj_ref is null then
		--Добавление
		obj%init;
		obj.[CIT_AB]	:= p_ab;
		obj.[OBJ_ID]	:= p_id;
		obj.[OBJ_CLASS]	:= p_class;
		obj.[EXT_ID]	:= p_ext_id;
		obj.[CIT_IN_REQ]:= p_cit_in_req;
		return ::[CIT_OBJ]%insert(obj);
	else
		--Обновление
		--	obj := obj_ref;
		--	obj.[OBJ_ID]	:= p_id;
		--	obj.[OBJ_CLASS]	:= p_class;
		--	obj.[CIT_IN_REQ]:= p_cit_in_req;
		--	obj_ref := obj;
		return obj_ref;
	end if;
--exception
--when TOO_MANY_ROWS then
--	pragma error('В справочнике "Интегратор. Соответствие объектов" существует несколько записей с ID во внешней системе '||p_ext_id||' и системой-абонентом '||p_ab.[CODE]);
end;

--from CIT_OBJ.LIB
function GetObjID(p_ext_id	[REFSTRING]
				 ,p_class	ref [METACLASS]
				 ) return [REFERENCE] is
begin
	for (select x(x.[OBJ_ID] :c_obj_id)
		 in ::[CIT_OBJ]
		 where x.[EXT_ID] = p_ext_id
		 and x.[OBJ_CLASS] = p_class
		 and x.[CIT_AB] in ( ::[CIT_ABONENT](code = 'BSS')
							,::[CIT_ABONENT](code = 'CRS')
							,::[CIT_ABONENT](code = 'ETO')
							)
		)
	loop
		return x.c_obj_id;
	end loop;
--exception when NO_DATA_FOUND then
--	return null;
--when TOO_MANY_ROWS then
--	pragma error('В справочнике "Интегратор. Соответствие объектов" существует несколько записей с ID во внешней системе '||p_ext_id||' и системой-абонентом '||p_ab.[CODE]);
end;

public function getClientFromMapping(pExtId [REFSTRING]) return ref [CL_PRIV] is
begin
	return cast_to([CL_PRIV_REF], GetObjID(pExtId, [CL_PRIV]%class));
end;

public function writeClientToMapping(pId	[REFERENCE]
									,pAb 	ref [CIT_ABONENT]
									,pExtId	[REFSTRING]
									) return ref [CIT_OBJ] is
begin
	return SetExtID([CL_PRIV]%class, pId, pAb, pExtId, null);
end;

-- Блок инициализации
begin
	prop_codes_varr.init(cv_property_grp_CRS_INVEST_NATIONALITY
						,cv_property_grp_CRS_TIN
						,cv_property_grp_CRS_TIN_ABSCENCE
						,cv_property_grp_CRS_REASON_FOR_TIN_ABSCENCE
						,cv_property_grp_CRS_SUBREASON_FOR_TIN_ABSCENCE
						,cv_property_grp_NEED_CHECK
						,cv_property_grp_PP_FOREIGN_PUBLIC_OFFICIAL
						,cv_property_grp_PP_INTERNATIONAL_PUBLIC_OFFICIAL
						,cv_property_grp_PP_RUSSIAN_PUBLIC_OFFICIAL
						,cv_property_grp_PP_PURPOSE_OF_RELATIONSHIP
						,cv_property_grp_PP_PURPOSE_OF_ACTIVITY
						,cv_property_grp_PP_FINANCIAL_STATUS
						,cv_property_grp_PP_BUSINESS_REPUTATION
						,cv_property_grp_PP_SOURCE_OF_FUNDS
						,cv_property_grp_PP_NEED_CHECK
						);
	v_tune_values	:= getFpTuneValuesArr(cv_tune_bo_map);
	v_rko_for_bo	:= getAnyRkoForBo();
	v_property_grp_cache := initPropertyGrpCache();
end;

end;
