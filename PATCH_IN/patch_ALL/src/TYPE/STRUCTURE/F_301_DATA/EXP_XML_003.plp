function ExportR3
	return boolean
is
	subtype rec_Data is &lib_exp.cur_R3;
	curData	::[RUNTIME].[UTILS].ref_cursor;
	nOstatok	number;
	--флаг наличия данных в разделе
	bExistsData	boolean	default false;
begin
	curData := &lib_exp.OpenCurData(lrParam, 3);
	&for_opened_cursor(recData, curData, rec_Data, 1000)
		nOstatok	:=	recData.C_SALDO_MLN;
		if nOstatok <> 0 then
			--если данные есть изменяем флаг и открываем тэг
			if not bExistsData then
				bExistsData	:=	true;
				--	Открытие тега Раздел3
				&lib_delta.OpenTag('Раздел3');
			end if;
			&lib_delta.OpenTag('ИзменПоСчетам');

			&lib_delta.SetAttribute	(
										P_ATTR			==	'Счет2Пор'
									,	P_VALUE			==	recData.C_MAIN_USV
									,	P_LEN_MAX		==	5
									,	P_IS_REQUIRED	==	true
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'ТипСубъект'
									,	P_VALUE			==	recData.C_SUBJ_TYPE
									,	P_LEN_MAX		==	1
									,	P_IS_REQUIRED	==	true
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'РезидентСтатус'
									,	P_VALUE			==	recData.C_RESIDENT
									,	P_LEN_MAX		==	1
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'НаимКлиент'
									,	P_VALUE			==	recData.C_CL_NAME
									,	P_LEN_MAX		==	1000
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'РегНомер'
									,	P_VALUE			==	recData.C_CL_REG_NUM
									,	P_LEN_MAX		==	4
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'СВИФТ'
									,	P_VALUE			==	recData.C_CL_SWIFT
									,	P_LEN_MAX		==	11
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'ОГРН'
									,	P_VALUE			==	recData.C_CL_OGRN
									,	P_LEN_MAX		==	13
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'КодВал'
									,	P_VALUE			==	recData.C_CUR_CODE
									,	P_LEN_MAX		==	3
									,	P_IS_REQUIRED	==	true
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'СуммаИзмен'
									,	P_VALUE			==	nOstatok
									,	P_LEN_MAX		==	12
									,	P_PATTERN		==	'^-?[0-9]+$'
									,	P_IS_REQUIRED	==	true
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'Примечание'
									,	P_VALUE			==	recData.C_INFO
									,	P_LEN_MAX		==	4000
									,	P_IS_REQUIRED	==	true
									);

			&lib_delta.CloseTag('ИзменПоСчетам');
		end if;
	&end_forcursor;

	--если данные в разделе были закрываем тэг 
	if  bExistsData then
		&lib_delta.CloseTag('Раздел3');
	end if;
	return bExistsData;
end;


function ExportR4
	return boolean
is
	subtype rec_Data is &lib_exp.cur_R4;
	curData	::[RUNTIME].[UTILS].ref_cursor;
	nValRF		number;
	nInVal		number;
	nValRFDue	number;
	nInValDue	number;
begin
	--	Открытие тега Раздел4
	&lib_delta.OpenTag('Раздел4');

	curData := &lib_exp.OpenCurData(lrParam, 4);
	&for_opened_cursor(recData, curData, rec_Data, 1000)
		if recData.C_TUN_CODE =  '4.1' then
			nValRF		:=	recData.C_DEBT_MLN;
		elsif recData.C_TUN_CODE = '4.1.2' then
			nValRFDue	:=	recData.C_DEBT_MLN;
		elsif recData.C_TUN_CODE = '4.2' then
			nInVal		:=	recData.C_DEBT_MLN;
		elsif recData.C_TUN_CODE = '4.2.2' then
			nInValDue	:=	recData.C_DEBT_MLN;
		end if;
	&end_forcursor;

	&lib_delta.OpenTag('Задолженность');

	&lib_delta.SetAttribute	(
								P_ATTR			==	'ЗадолжВалРФ'
							,	P_VALUE			==	nValRF
							,	P_LEN_MAX		==	12
							,	P_PATTERN		==	'^-?[0-9]+$'
							,	P_IS_REQUIRED	==	true
							);
	&lib_delta.SetAttribute	(
								P_ATTR			==	'ЗадолжИнострВал'
							,	P_VALUE			==	nInVal
							,	P_LEN_MAX		==	12
							,	P_PATTERN		==	'^-?[0-9]+$'
							,	P_IS_REQUIRED	==	true
							);
	&lib_delta.SetAttribute	(
								P_ATTR			==	'ПросрочЗадолжВалРФ'
							,	P_VALUE			==	nValRFDue
							,	P_LEN_MAX		==	12
							,	P_PATTERN		==	'^-?[0-9]+$'
							,	P_IS_REQUIRED	==	true
							);
	&lib_delta.SetAttribute	(
								P_ATTR			==	'ПросрочЗадолжИнВал'
							,	P_VALUE			==	nInValDue
							,	P_LEN_MAX		==	12
							,	P_PATTERN		==	'^-?[0-9]+$'
							,	P_IS_REQUIRED	==	true
							);

	&lib_delta.CloseTag('Задолженность');

	&lib_delta.CloseTag('Раздел4');

	--если данных в разделе не было 
	if (nValRF = 0 or nValRF is null) and (nInVal = 0 or nInVal is null) then 
		return false;
	else
		return true;
	end if;
end;


/**
 *	Заполнение "шапки" отчёта
 */
procedure FillHeader	(P_REP		string(32767))
is
begin
	&lib_delta.AddHeader6406	(
									P_XMLNS		== 'urn:cbr-ru:rep0409301:v5.0.4.5'
								,	P_OKATO_LEN	== 8
								,	P_VID_REP	== P_REP
								);
end;


/**
 *	Формирование данных по разделам 1 и 2
 */
function ExpRazd1and2
	return boolean
is
	-- флаг наличия данных в разделе 1
	bRaz1	boolean;
	-- флаг наличия данных в разделе 2
	bRaz2	boolean;
begin
	--	Заполнение "шапки" отчёта
	FillHeader('Раздел 1, Раздел 2');
	--	Открытие тега Данные301
	&lib_delta.OpenTag('Данные301');
	--	Установка атрибута Ид для тега Данные301
	&lib_delta.SetAttribute('Ид', 1);

	bRaz1	:=	ExportR1;
	bRaz2	:=	ExportR2;

	&lib_delta.CloseTag('Данные301');

	--если отсутсвуют данные в обоих разделах, не сохраняем файл
	if bRaz1 = false and bRaz2 = false then
		&debug_output('Файл экспорта по разделам 1 и 2 не сформировался из-за отсутствия данных.',	0);
		return false;
	else
		-- Заполнение "подвала" отчёта
		&lib_delta.AddFooter;
		return true;
	end if;
end;


/**
 *	Формирование данных по разделам 3 и 4
 */
function ExpRazd3and4
	return boolean
is
	-- флаг наличия данных в разделе 3
	bRaz3	boolean;
	-- флаг наличия данных в разделе 4
	bRaz4	boolean;
begin
	-- Заполнение "шапки" отчёта
	FillHeader('Раздел 3, Раздел 4');
	--	Открытие тега Данные301
	&lib_delta.OpenTag('Данные301');
	--	Установка атрибута Ид для тега Данные301
	&lib_delta.SetAttribute('Ид', 1);

	bRaz3	:=	ExportR3;
	bRaz4	:=	ExportR4;

	&lib_delta.CloseTag('Данные301');

	--если отсутсвуют данные в обоих разделах, не сохраняем файл
	if bRaz3 = false and bRaz4 = false then
		&debug_output('Файл экспорта по разделам 3 и 4 не сформировался из-за отсутствия данных.',	0);
		return false;
	else
		-- Заполнение "подвала" отчёта
		&lib_delta.AddFooter;
		return true;
	end if;
end;



/*
 *	Инициализация параметров расчёта
 *	@param P_PARAM	- Параметры реализации
 */
procedure InitParam
		(
			P_PARAM		ref	[REPS_PARAMS]
		)
is
begin
	--	Ссылка на реализацию
	lrParam	:= P_PARAM;
	--	Ссылка на отчёт из реализации
	lrRep			:= lrParam.[REPORT];
	-- Определяем, является ли реализация ежемесячной (lbIsMonthParam = true)
	lbIsMonthParam := char_bool(&str.get_str_par(P_PARAM.[INFO], 'P_MONTHLY'));
end;


/*
 *	Инициализация файла экспорта
 *	@param P_PARAM	- Параметры реализации
 *	@param P_STR	- Строка параметров\
 *	@param P_SEGM	- Сегмент окончания названия файла
 *
 *	@return имя файла экспорта
 */
function InitExpFile
		(
			P_PARAM		ref	[REPS_PARAMS]
		,	P_STR		varchar2(32767)
		,	P_SEGM		varchar2(10)
		)
	return varchar2(32767)
is
	--	Наименование файла
	vFileName	varchar2(32767);
begin
	--	Определение наименования файла
	vFileName	:= &lib_delta.GetExpFileNames
		(
			P_REP			==	lrRep
		,	P_PARAM			==	lrParam
		,	P_EXP_METH		==	&METHOD$SNAME
		,	P_PERIOD_CODE	==	'D'
		,	P_SEGMENT		==	P_SEGM
		).vXmlFileName;

	--	Добавление наименования XML файла в строку параметров
	::[RUNTIME].[STR].Set_Par(P_STR, 'P_XMLNAME',	vFileName	);

	--	Инициализация параметров экспорта
	&lib_delta.Init(P_PARAM, P_STR);
	return vFileName;
end;


/**
 * Сохранение файла по разделам 1 и 2
 *
 * @param P_PARAM	- Параметры реализации
 * @param P_STR		- Строка параметров
 * @return	Наименование экспортируемого файла
 */
function ExportRaz1and2
		(
			P_PARAM		ref	[REPS_PARAMS]
		,	P_STR		varchar2(32767)
		)
	return varchar2(32767)
is
	--	Наименование файла
	vFileName	varchar2(32767);
	--	Сегмент окончания названия файла
	vFilePostfixName 	varchar2(10);
begin
	--	Сегмент окончания названия файла определяется в зависимости от периодичности расчета 
	if lbIsMonthParam then
		vFilePostfixName := '301M';
	else
		vFilePostfixName := '301';
	end if;
	--	Инициализация файла экспорта для 1 и 2 разделов
	vFileName := InitExpFile(P_PARAM, P_STR, vFilePostfixName);
	--	Заполнение файла по разделам 1 и 2 данными
	if ExpRazd1and2 then
		--	Сохранение XML файла на сервере без архивации
		&lib_delta.SaveDataInFile;
		return vFileName;
	else
		return null;
	end if;
end;


/**
 * Сохранение файла по разделам 3 и 4
 *
 * @param P_PARAM	- Параметры реализации
 * @param P_STR		- Строка параметров
 * @return	Наименование экспортируемого файла
 */
function ExportRaz3and4
		(
			P_PARAM		ref	[REPS_PARAMS]
		,	P_STR		varchar2(32767)
		)
	return varchar2(32767)
is
	--	Наименование файла
	vFileName	varchar2(32767);
begin
	--Инициализация файла экспорта для 3 и 4 разделов
	vFileName := InitExpFile(P_PARAM, P_STR, '301A');
	--	Заполнение файла по разделам 3 и 4 данными
	if ExpRazd3and4 then
		--	Сохранение XML файла на сервере без архивации
		&lib_delta.SaveDataInFile;
		return vFileName;
	else
		return null;
	end if;
end;


/**
 *	Запуск экспорта в формате XML
 *
 *	@param P_PARAM	- Параметры реализации
 *	@param P_STR	- Строка параметров
 */
public function RUN
		(
			P_PARAM		ref	[REPS_PARAMS]
		,	P_STR		varchar2(32767)
		)
	return integer
is
--	Маска файлов для архивации
	vFileNameMask1		varchar2(32767);
	vFileNameMask2		varchar2(32767);
	--	Позиция символа в наименовании файла
	iCharPos			integer;
begin
	if P_PARAM is null then
		&debug_output('Реализация не выбрана. Экспорт данных отчета в формат Дельта невозможен.',	0);
		return -1;
	end if;
	InitParam(P_PARAM);

	--	Экспорт файла по разделам 1  и 2
	&debug_output('Начало экспорта данных по разделам 1 и 2.',	0);
	vFileNameMask1	:= ExportRaz1and2(P_PARAM, P_STR);
	&debug_output('Окончание экспорта данных по по разделам 1 и 2.',	0);
	&debug_output('Файл по разделам 1 и 2: ' || vFileNameMask1, 0);

	-- Для месячной периодичности расчета блок для экспорта данных разделов 3 и 4 
	-- не формируется независимо от того есть ли там данные
	if not lbIsMonthParam then
		--	Экспорт файла по разделам 3  и 4
		&debug_output('Начало экспорта данных по разделам 3 и 4.',	0);
		vFileNameMask2	:= ExportRaz3and4(P_PARAM, P_STR);
		&debug_output('Окончание экспорта данных по разделам 3 и 4.',	0);
		&debug_output('Файл по разделам 3 и 4: ' || vFileNameMask2, 0);
		--если отсутствуют данные в 1 и 2 разделах
		if vFileNameMask1 is null then
			vFileNameMask1	:= vFileNameMask2;
		end if;
	end if;
	--	Определение маски файлов для архивации:
	--	Индекс самого правого вхождения точки
	iCharPos		:= instr(vFileNameMask1, '.', -1);
	if iCharPos > 0 then
		--	Название файла без расширения
		vFileNameMask1	:= substr(vFileNameMask1, 1, iCharPos - 1);
	end if;
	--	Индекс самого правого вхождения символа "_"
	iCharPos		:= instr(vFileNameMask1, '_', -1, 2);
	if iCharPos > 0 then
		--	Название файла без сегмента
		vFileNameMask1	:= substr(vFileNameMask1, 1, iCharPos - 1);
	end if;
	vFileNameMask1 := '_' || substr(vFileNameMask1, 2);

	&debug_output('Маска файла: ' || vFileNameMask1, 0);

	--	Инициализация параметров экспорта для получения полного наименования экспортного файла - архива
	&lib_delta.Init(P_PARAM, P_STR);
	--	Архивация сохранённых файлов
	&lib_delta.ArchXMLFiles(vFileNameMask1);

	&debug_output('Закончен экспорт данных в формат Дельта',	0);

	return 0;
end;
end;
