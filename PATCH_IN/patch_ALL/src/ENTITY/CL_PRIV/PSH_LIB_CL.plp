--Башкиров В.Г. 08.07.2019 Отключил API DECL_ON_GET_CRED
function cl_mon(cl_id number) return number is
rez number;
begin
	
	for dp in ::[DECL_ON_GET_CRED] all where dp.[CLIENT] = cl_id
	loop
		rez:=dp.[PSB_INCOME];
	end loop;		
		
	return	rez;	
