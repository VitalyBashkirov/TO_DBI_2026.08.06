-- bulk,batch,performance
-- Включение batch для bulk операций

begin --<добавлено при генерации теста>
  Для массовых операций включить batch через `APPLICATION.DBI=1` или `pragma hint('jdbc_batch(true)')`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

