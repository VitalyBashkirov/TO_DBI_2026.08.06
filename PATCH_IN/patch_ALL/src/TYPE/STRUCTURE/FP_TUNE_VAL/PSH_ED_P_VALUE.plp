class FP_TUNE_VAL;

@name('[ПСБ] Изменить значение настройки (списком)')
method PSH_ED_P_VALUE is
PSH_ED_P_VALUE (
	@name('Значение настройки') P_VALUE in [STRING_2000]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_VALUE := this.[VALUE];
end if;
-- End initialization of parameters and variables
end;

execute is
/*********************************************************************
Назначение:

bashkirov, последнее изменение 11 Ноябрь 2019 г.
*********************************************************************/
begin
	this.[VALUE]:=P_VALUE;
end;
end;
end;
