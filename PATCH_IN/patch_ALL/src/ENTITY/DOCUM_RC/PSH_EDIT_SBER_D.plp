v_trn			varchar2(16);
v_sum_doc		number;

function find_part(swift_cod varchar2) return ref [CL_PART]
is
	part	ref [CL_PART];
begin
	select x(x%id) in ::[CL_PART] where x.[BANK_F].[SWIFT_C] = rpad(swift_cod, 11, 'X') and nvl(x.[DATE_CL], ::[SYSTEM].[VARIABLES].OpDate + interval('1', 'day')) > ::[SYSTEM].[VARIABLES].OpDate into part;
	return part;
exception when TOO_MANY_ROWS then
	begin
		select x(x%id) in ::[CL_PART] where x.[BANK_F].[SWIFT_C] = rpad(swift_cod, 11, 'X') and nvl(x.[DATE_CL], ::[SYSTEM].[VARIABLES].OpDate + interval('1', 'day')) > ::[SYSTEM].[VARIABLES].OpDate and nvl(x.[READDRESS], '0') = '1' into part;
		return part;
	exception when NO_DATA_FOUND or TOO_MANY_ROWS then
		return null;
	end;
when NO_DATA_FOUND then
	return null;
end;


-- определение участника по умолчанию в заданной валюте
function find_clearing_part(p_fintool ref [FT_MONEY], p_Filial ref [BRANCH], p_manual boolean default false) return ref [CL_PART]
is
	v_part ref [CL_PART];
begin
	if ::[TRC].[GET_FLAG]('TEMPL_ROUTE_SWIFT') then
		return null;
	end if;
	select x(x.[CLIENT]) in ::[TRC] where
			x.[CLEARING_BANK] = '1'
		and x.[STATUS] = ::[STATUS_MB]([CODE] = 'WORK')
		and x.[FINTOOL] = p_fintool
		and (x.[FILIAL] = p_Filial or (P_FILIAL.[CMFR] and x.[FILIAL].[CMFR]))
		into v_part;
	return v_part;
exception when TOO_MANY_ROWS then
	return null;
when NO_DATA_FOUND then
	return null;
end;

function find_rccl(p_SWIFT_CODE [SWIFT_C], p_FILIAL ref [BRANCH], p_ISO ref [FT_MONEY]) return ref [CL_PART]
is
	v_dog 			ref [TRC];
	v_part			ref [CL_PART];
begin
	if ::[TRC].[GET_FLAG]('TEMPL_ROUTE_SWIFT') then
		return null;
	end if;
	v_part := find_part(p_SWIFT_CODE);
	if v_part is null then
		v_part := find_clearing_part(p_ISO, p_FILIAL);
	else
		begin
			locate exact v_dog in [TRC] where v_dog.[FILIAL] = p_FILIAL
				and v_dog.[CLIENT] = v_part
				and v_dog.[FINTOOL] = p_ISO
				and v_dog.[STATUS] = ::[STATUS_MB]([CODE] = 'WORK');
		exception
			when NO_DATA_FOUND then
				v_dog := null;
		end;
		if not ((v_dog is not null) and (::[TRC].[GET_FLAG]('IGNORE_CLEAR_BANK'))) then
			if v_dog is null or (v_dog is not null and v_dog.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'N')) then
			v_part := find_clearing_part(p_ISO, p_FILIAL);
		else
			v_part := null;
		end if;
	end if;
	end if;
	return v_part;
end;

-->>
-- возвращает текст документа p_rDocRc в формате SWIFT
function get_dopinfo(
	p_rDocRc	ref [DOCUM_RC]
) return varchar2(4000) is
	v_sform				string(10);
	v_swift_receiver	varchar2;
	v_block3			string;
	v_idMT103			string;	
	v_ret				varchar2(4000);
	ed503_				boolean;
begin
	&sp(sp1)
	::[DOCUM_RC].[SWIFT_LIB].INIT_EXP_FORMAT;
	v_sform := ::[DOCUM_RC].[LIB_VIEW].get_type_doc_sform(p_rDocRc);

	v_ret := ::[DOCUM_RC].[SWIFT_LIB].get_title(p_rDocRc.[DOG_RC], v_sform, v_swift_receiver, v_block3, doc_rc == p_rDocRc, ed503==ed503_)
		|| ::[DOCUM_RC].[SWIFT_LIB_EXP].get_block_4(p_rDocRc, v_sform, ::[TRC].[INI].TODAY, false, null, false, v_idMT103);

	::[DOCUM_RC].[T_LIB].RESET_ERRS;
	return v_ret;
exception when others then
	&rb(sp1)
end;
--<< PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline

PSH_EDIT_SBER_D (
	@name('Тип документа РЦ')                          P_TYPE_DOC      in [TYPE_DOC_RC_REF],
	@name('Номер документа')                           P_NUMBER_DOC    in [STRING_6],
	@name('Дата создания')                             P_CRDATE        in [DATE],
	@name('Участник-отправитель')                      P_SDCL          in [CL_PART_REF],
	@name('Участник-получатель')                       P_RCCL          in [CL_PART_REF],
	@name('Сумма')                                     P_SUMMA         in [SUMMA],
	@name('Дата валютирования')                        P_VALDATE       in [DATE],
	@name('Вид валюты')                                P_ISO           in [FT_MONEY_REF],
	@name('Тип сообщения')                             P_MSGTYPE       in [SBRF_TYPE_ME_REF],
	@name('Проводки')                                  P_MAIN_DOC      in [MAIN_DOCUM_REF],
	@name('Наименование плательщика (50)')             P_PAYER         in [SWIFT_5X],
	@name('Код банка плательщика (52)')                P_CODE_BANKPAY  in [STRING_35],
	@name('Наименование банка плательщика (52)')       P_NAME_BANKPAY  in [SWIFT_5X],
	@name('Код банка посредника (56)')                 P_CODE_BANKINT  in [STRING_35],
	@name('Наименование банка посредника (56)')        P_NAME_BANKINT  in [SWIFT_5X],
	@name('Код банка бенефициара (58)')                P_CODE_BANBEN   in [STRING_35],
	@name('Код банка получателя (57)')                 P_CODE_BANKREC  in [STRING_35],
	@name('Наименование банка получателя (57)')        P_NAME_BANKREC  in [SWIFT_5X],
	@name('Наименование получателя (59)')              P_RECEIVER      in [SWIFT_5X],
	@name('Детали расходов (71A)')                     P_CHARGE        in [CHARGES_REF],
	@name('Инф. отправителя получателю (72)')          P_CLINFO        in [MEMO],
	@name('Детали платежа (70)')                       P_DEST          in [MEMO],
	@name('Ссылочный идентификатор (20)')              P_TRN           in [STRING_16],
	@name('Выбор получателя')                          P_GET_RECEIVER  in [INTER_BEN_REF],
	@name('Договор списания')                          P_GET_INPUT     in [TRC_REF],
	@name('Вариант обработки')                         P_VAR           in [DOC_RC_VARIANT],
	@name('Договор зачисления')                        P_GET_OUTPUT    in [TRC_REF],
	@name('Курс сделки')                               P_RATE          in [SUPER_NUMBER],
	@name('Обратный курс')                             P_BACK_RATE     in [BOOLEAN],
	@name('Исходный документ')                         P_FIRST_REF     in [DOCUM_RC_REF],
	@name('Дополнительная информация')                 P_DOPINFO       in [MEMO_BIG],
	@name('Реквизиты МТ103')                           P_MT103         in [MT103],
	@name('Корреспондент отправителя (53)')            P_NAME_BANK_53  in [SWIFT_5X],
	@name('Код банка (53)')                            P_CODE_BANK_53  in [STRING_35],
	@name('Корреспондент получателя (54)')             P_NAME_BANK_54  in [SWIFT_5X],
	@name('Код банка (54)')                            P_CODE_BANK_54  in [STRING_35],
	@name('Третий банк возмещения (55)')               P_NAME_BANK_55  in [SWIFT_5X],
	@name('Код банка (55)')                            P_CODE_BANK_55  in [STRING_35],
	@name('Поставить на невыясненные')                 P_UKNOWN        in [BOOLEAN],
	@name('Филиал')                                    P_FILIAL        in [BRANCH_REF],
	@name('Счет плательщика')                          P_GET_PAYER     in [AC_FIN_REF],
	@name('Печать')                                    P_PRINT         in [BOOLEAN],
	@name('Банк-получатель')                           P_RECEIVER_BANK in [CL_BANK_F_REF],
	@name('Вид перевода (1/null-не опр, 2-кл, 3-бан)') P_KL_BNK        in [ONE_FROM_THREE]   default null,
	@name('Обязательная отчетность (77B)')             P_77B           in [MEMO],
	@name('Тип запроса n99')                           P_99_TYPE       in [ONE_FROM_THREE]
) is

validate is
	this_state 		string(16);
	file_num		varchar2;
	err_msg			varchar2(250);
	v_string		[STRING_REC];
	v_23E_rec 		[SWIFT_23E_REC];
	lob_loc			CLOB;
	amount			integer := 32000;
	cnt				integer;
	v_key 			integer;
	v_add_len_70	number :=0;
	v_refid_list	varchar2(500);
	v_dog 			ref [TRC]; -->> PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline	
BEGIN
	if P_MESSAGE = 'DEFAULT' then

-->> PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline		
		if not(this%state = 'S_10' and this.[CRCLCODE] = 'LK_SBANK') then
			pragma error('Данная операция предназначена для переотправки документов РЦ от SberFinline в 10 статусе!');
		end if;
		v_dest_prev 	:= this.[DEST];
		v_valdate_pr 	:= this.[VALDATE];

		v_pol_name_pr 	:= this.[RECEIVER].[NAME];
		v_pol_acc_pr	:= this.[RECEIVER].[ACC];
		v_pol_bcode_pr	:= this.[RECEIVER].[BCODE];
		v_pol_bname_pr	:= this.[RECEIVER].[BANK];	
		v_pol_bank_pr	:= this.[RECEIVER].[BANK_REF];
		v_pol_bacc_pr	:= this.[RECEIVER].[BACC];
		v_dopinfo_pr	:= this.[DOPINFO];
		v_doc_text_pr	:= this.[DOC_TEXT];
		P_VALDATE 		:= ::[SYSTEM].[OP_DATE];
		v_out_trc		:= this.[RECEIVER].[PART_REF];
		v_pay_name		:= this.[PAYER].[NAME];
		v_pol_bank_opt  := this.[RECEIVER].[OPTION_BANK];
		v_name_bank_53	:= this.[MT103].[F_53].[NAME];
		v_acc_bank_53	:= this.[MT103].[F_53].[ACC];
		v_bank_53		:= this.[MT103].[F_53].[BANK];
		v_opt_bank_53	:= this.[MT103].[F_53].[OPTION_BEN];
		v_trn			:= this.[ELDOCNUM]; 
		v_sum_doc		:= this.[SUMMA];  -->> PSH VRI 05/11/2025 CFT-2795 [ПСБ] Переотправка документов от SberFinline в 10 статусе
		
--<< PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline
		
		-- Клиент скрипты
		V_VB := null;
		csmd.init_form( V_VB, 'DOCUM_RC', 'LOOK#VD_3');

		-- Проверка контекста
		ORI_DOC_RC	:= this;

		ON_CONTROL := null;
		V_VARIANT.[0] := 1;	-- без обработки
		
		-- Кэшируем исходные данные о документе
		ORI_MT103 					:= ORI_DOC_RC.[MT103];
		P_MT103						:= ORI_MT103;
		ORI_SUMMA = P_SUMMA = new_summa_doc	:= ORI_DOC_RC.[SUMMA];
		ORI_ISO = P_ISO 			:= ::[FT_MONEY].[LIB].Get_Money(ORI_DOC_RC.[ISO], 1);
		ORI_MAIN_DOC 				:= ORI_DOC_RC.[MAIN_DOC];
		ORI_DOG_IN = P_GET_INPUT 	:= ORI_DOC_RC.[DOG_SD];
		ORI_DOG_OUT = P_GET_OUTPUT	:= ORI_DOC_RC.[DOG_RC];
			
		begin
			select x(x%id, x.[NAME], x.[SFORM]) in ::[TYPE_DOC_RC]
				where x.[NUM_CODE] = ORI_DOC_RC.[TYPE_DOC] and nvl(x.[UT], '*') = nvl(ORI_DOC_RC.[SUB_TYPE], '*')
				into P_TYPE_DOC, V_TYPED_NAME, V_TYPED_COD;
		exception when NO_DATA_FOUND or TOO_MANY_ROWS then
			pragma error('Не найден тип документа РЦ "' || ORI_DOC_RC.[TYPE_DOC] || '.' || ORI_DOC_RC.[SUB_TYPE] || '"');
		end;

		--Установка контекстов для представлений опций
		&SDL.set_option_contexts(V_TYPED_COD, P_PAYER.[OPTION]
											, P_NAME_BANKPAY.[OPTION]
											, P_NAME_BANK_53.[OPTION]
											, P_NAME_BANK_54.[OPTION]
											, P_NAME_BANK_55.[OPTION]
											, P_NAME_BANKINT.[OPTION]
											, P_NAME_BANKREC.[OPTION]
											, V_OPT58
											, P_RECEIVER.[OPTION]);


		-- Параметры
		P_FILIAL		:= ORI_DOC_RC.[FILIAL];
		P_TRN 			:= ORI_DOC_RC.[ELDOCNUM];
		P_NUMBER_DOC 	:= ORI_DOC_RC.[NUMBER_DOC];
		P_CRDATE 		:= ORI_DOC_RC.[CRDATE];
		-- Если был выход из области тиражирования
		P_SDCL 			:= nvl(ORI_DOC_RC.[ORIGINAL].[DOG_SD].[CLIENT], ORI_DOC_RC.[PAYER].[PART_REF]);
		P_RCCL 			:= ORI_DOC_RC.[RECEIVER].[PART_REF];
		P_SUMMA 		:= ORI_DOC_RC.[SUMMA];
-->> PSH VRI 02/10/2025 Заккоментарил  P_VALDATE 		:= ORI_DOC_RC.[VALDATE];  -- RP0488781 (убран nvl c ::[TRC].[INI].TODAY, т.к. не хорошо выдавать желаемое за действительное)
		P_MAIN_DOC 		:= ORI_DOC_RC.[MAIN_DOC];
		P_FIRST_REF 	:= ORI_DOC_RC.[FIRST_REF];
		P_MSGTYPE 		:= [DOCUM_RC]::[BUX_LIB].get_message_type(ORI_DOC_RC.[MSGTYPE]);
		if V_TYPED_COD = 'SWT' then
	   		begin
		   		select x(x.[TEXT]) in ::[SWIFT_RAW_DATA] where x.[DOC_RC] = this into lob_loc;
		   		if lob_loc is null then
		   			P_DOPINFO := 'Текст отсутствует';
		   		else
					DBMS_LOB.READ(lob_loc, amount, 1, P_DOPINFO);
					--P_DOPINFO := ORI_DOC_RC.[CLINFO] || rtrim(P_DOPINFO, NL$ ) || NL$ || '-}';
		   		end if;
	   		exception when NO_DATA_FOUND then
	   			P_DOPINFO := ORI_DOC_RC.[DOC_TEXT] || ORI_DOC_RC.[DOPINFO];
	   		end;
		else
			if ::[DOCUM_RC].[BUX_LIB].is_in(this) then
				if ::[DOCUM_RC].[LIB_NEW].is_fin_doc(ORI_DOC_RC.[TYPE_DOC]) and ORI_DOC_RC.[FLAG_EXPORT_DOC] then -- если фин.док. уже экспортирован, в DOPINFO уже будет помещен текст экспртированного сообщения и текст входящего документа будет несправедливо им дополнен
					vTextFirstDoc := replace(replace(replace(replace(rtrim(ORI_DOC_RC.[DOC_TEXT]), chr(1)), chr(3)), ';', ' '), 'NO_UPDATE'); -- поэтому возьмем текст только из DOC_TEXT
				else
					vTextFirstDoc := replace(replace(replace(replace(rtrim(ORI_DOC_RC.[DOC_TEXT]) || ORI_DOC_RC.[DOPINFO], chr(1)), chr(3)), ';', ' '), 'NO_UPDATE');
				end if;
			else
				vTextFirstDoc := null;
			end if;
			if V_TYPED_COD = '608' then
				if vTextFirstDoc is not null then
					P_DOPINFO := 'Текст входящего документа:'||NL$||vTextFirstDoc||NL$||NL$;
				else
					P_DOPINFO := P_DOPINFO||bool_char(nvl(ORI_DOC_RC.[FLAG_EXPORT_DOC], false) = false, 'При экспорте в SWIFT будет сформирован следующий текст:' , 'Текст экспортированного документа:')||NL$||::[DOCUM_RC].[PROC#VD_3].get_dopinfo(this);
				end if;
			end if;
		end if;
		-- Поле 72
		P_CLINFO  := &SDL.str_to_swt(ORI_DOC_RC.[CLINFO],1,35,6);
		-- Поля 50, 52
		&SDL.part_to_swift(ORI_DOC_RC.[PAYER], P_PAYER, P_NAME_BANKPAY, P_CODE_BANKPAY);
		-- Поле 53,54,55,56
		&SDL.ben_to_swift( ORI_MT103.[F_53], P_NAME_BANK_53, P_CODE_BANK_53);
		&SDL.ben_to_swift( ORI_MT103.[F_54], P_NAME_BANK_54, P_CODE_BANK_54);
		&SDL.ben_to_swift( ORI_MT103.[F_55], P_NAME_BANK_55, P_CODE_BANK_55);
		&SDL.ben_to_swift( ORI_DOC_RC.[INT], P_NAME_BANKINT, P_CODE_BANKINT);
		-- Поле 57
		&SDL.part_to_swift(ORI_DOC_RC.[RECEIVER], P_RECEIVER, P_NAME_BANKREC, P_CODE_BANKREC);
		-- Поле 58
		if substr(V_TYPED_COD, 1, 2) = '20' then
			&SDL.ben_to_swift(ORI_DOC_RC.[BEN], P_RECEIVER, P_CODE_BANBEN, true);
			V_OPT58 := P_RECEIVER.[OPTION];
		end if;
		-- Поле 70, Если новый формат, то добавляем 3*NL$
		if instr(ORI_DOC_RC.[DEST], NL$) > 0 then
			v_add_len_70 := 3*length(NL$);
		end if;
		P_DEST := &SDL.str_to_swt(SUBSTR(ORI_DOC_RC.[DEST], 1, 140+v_add_len_70));		

		-- Поле 71
		begin
			P_CHARGE := ::[CHARGES]([VALUE] = ORI_DOC_RC.[CHARGPAY]);
		exception when NO_DATA_FOUND then
			null;
		end;
		P_RATE := 1;

		--Обязательная отчетность (77B)
		P_77B := &SDL.str_to_swt(&VCHK.swift_to_str(ORI_MT103.[F_77B]), 1, 35, 3);
				
		-- Переменные
		if substr(V_TYPED_COD, 1, 2) in ('10', '20') then
			V_PANEL.[0]	:= 1;
		elsif V_TYPED_COD = 'SWT' or V_TYPED_COD = '608' then
			V_PANEL.[0]	:= 4;
		else
			V_PANEL.[0]	:= 3;
		end if;
		V_BPNAME 		:= ORI_DOC_RC.[PAYER].[RB];
		V_BRNAME 		:= ORI_DOC_RC.[RECEIVER].[RB];
		if P_SDCL = ::[TRC].[INI].SWIFT_PART then
			V_PPNAME	:= ORI_MT103.[RECEIVER_BANK].[NAME];
		else
			V_PPNAME 	:= P_SDCL.[NAME];
		end if;
		if P_RCCL = ::[TRC].[INI].SWIFT_PART then
			V_PRNAME	:= ORI_MT103.[RECEIVER_BANK].[NAME];
		else
			V_PRNAME	:= P_RCCL.[NAME];
		end if;
		V_PNAME 		:= ORI_DOC_RC.[PAYER].[RN];
		V_RNAME  		:= ORI_DOC_RC.[RECEIVER].[RN];
		V_BINAME 		:= ::[DOCUM_RC].[LIB_VAL].get_bank_name(ORI_DOC_RC.[INT].[BANK]);
		V_BBNAME 		:= ::[DOCUM_RC].[LIB_VAL].get_bank_name(ORI_DOC_RC.[BEN].[BANK]);

		-- BS00484035 Получаем коды стран банка и получателя
		[STR].GET_PAR(this.[BLOCK_DATA], 'REC_COUNTRY', V_REC_COUNTRY);
		[STR].GET_PAR(this.[BLOCK_DATA], 'REC_BANK_COUNTRY', V_REC_BANK_COUNTRY);
		
		--Проверка корректности заполнения стран, на случай, если вместо ИД страны там что-то другое
		if V_REC_COUNTRY is not null then
			select x(count(1)) in ::[COUNTRY] where x%id = V_REC_COUNTRY into cnt;
			if cnt = 0 then
				stdio.put_line_buf('Неверный ID страны получателя - ' || V_REC_COUNTRY);
				V_REC_COUNTRY :=null;
			end if;
		end if;
		
		if V_REC_BANK_COUNTRY is not null then 		
			select x(count(1)) in ::[COUNTRY] where x%id = V_REC_BANK_COUNTRY into cnt;
			if cnt = 0 then
				stdio.put_line_buf('Неверный ID страны банка получателя - ' || V_REC_BANK_COUNTRY);
				V_REC_BANK_COUNTRY :=null;
			end if;
		end if;
		
		-- Поле 21
		if ORI_DOC_RC.[TYPE_DOC] = '007' or V_TYPED_COD like '202%' then
			V_REF := SUBSTR( nvl( ORI_DOC_RC.[PAYER].[NAME], 'NONREF'), 1, 16);
		end if;
		
-- RP0013708 Проверка приложения "Расследования SWIFT"
		V_APP_INV := ::[INVESTIGATION].[LIB].check_swift_app;
	
		-- Поля переписки
		if ORI_DOC_RC.[TYPE_DOC] = '007' then
		
			-- Поле 11
			V_TYPE11  := substr( ORI_DOC_RC.[PAYER].[INN], 1, 1);
			V_VALUE11 := substr( ORI_DOC_RC.[PAYER].[INN], 2, V_VALUE11%size);
			-- Поле 77
			--(kozlova) V_COMMENT := ::[DOCUM_RC].[SWIFT_SB].str2swift( ORI_DOC_RC.[CLINFO], 30, 35, NL$);
			V_COMMENT := rtrim(substr(ORI_DOC_RC.[CLINFO], 1, 6*(35 + length(NL$))-length(NL$))); --(kozlova)
			V_77A := substr(ORI_DOC_RC.[CLINFO], 6*(35 + length(NL$))-length(NL$) + 1); --(kozlova)
			-- Поле 79
			V_DOPINFO := ORI_DOC_RC.[DEST];
			
			--Заполнение исходного документа, необходмо также заполнить при изменении.
			--Также проверять если найдено много документов, то давать на выбор только из них
			V_ORIG_EPD := ::[DOCUM_RC].[LIB_QA].get_original_swift(this);
			V_ORIG_EPD := ::[DOCUM_RC].[LIB_VIEW].GetLast(V_ORIG_EPD);
			
			if V_ORIG_EPD is null then
				--Если много документов, необходимо присвоить фильтр
				if ::[RUNTIME].[STR].get_bool_par(this.[BLOCK_DATA], 'MANY_DOCS') then
					v_refid_list := ::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'MANY_DOC_IDS');
					if v_refid_list is not null then
						csmd.Set_Validate_Prop( V_VB, 'V_ORIG_EPD', 'V', '.ViewFilter ="ID in ('|| v_refid_list ||')" ', true);
						csmd.Show( V_VB, 'V_ORIG_EPD', 'V');
						csmd.Show( V_VB, 'V_ORIG_DOC_NUM', 'V');
					end if;
				end if;
			else
				--Получаем референс
				V_ORIG_DOC_NUM := ::[DOCUM_RC].[LIB_QA].get_reference(V_ORIG_EPD);
				csmd.Show( V_VB, 'V_ORIG_EPD', 'V');
				csmd.Show( V_VB, 'V_ORIG_DOC_NUM', 'V');
			end if;
		else
			--Для финансовых документов заполним информационные документы
			V_STR_INF_DOCS := ::[RC_LINK].[LIB].get_links_to_str(::[DOCUM_RC].[LIB_VIEW].GetFirst(this), ::[RC_LINK_TYPE]([CODE]='ORIG_EPD(drc_drc)'), 'last_doc_rc');
			if V_STR_INF_DOCS is not null then
				csmd.Show( V_VB, 'V_INF_DOCS', 'V');
			end if;
		end if;

		::[DOCUM_RC].[SWIFT_DOC_LIB].getRelDocs(this, V_LD_STR, V_BC);

		--Дела по переписке
		if ::[INVESTIGATION].[LIB].check_swift_app then
			V_INV := ::[INVESTIGATION].[LIB].get_inv(this);
			if V_INV is not null then
				csmd.Show( V_VB, 'V_INV', 'V', true );
			end if;
			
			--Для информационных документов
			if ORI_DOC_RC.[TYPE_DOC] = '007' then
				--Выводим номер дела
				if V_INV is not null then
					csmd.Show( V_VB, 'V_INV', 'V');
				end if;
				--Для запроса n99 выводим вариант обработки
				if substr(V_TYPED_COD, 2, 2) = '99' then
					P_99_TYPE.[0] := ::[RUNTIME].[STR].get_num_par(this.[BLOCK_DATA], 'P_99_TYPE');
					csmd.Show( V_VB, 'P_99_TYPE', 'P');
					csmd.Disable( V_VB, 'P_99_TYPE', 'P');
				end if;
			end if;
			
		end if;
-- //RP0013708		
		

		
		if ORI_MT103.[F_23B] is not null then
			begin
				V_23B := ::[VAL_CODE_23B]([CODE] = ORI_MT103.[F_23B]);
			exception when NO_DATA_FOUND then
				null;
			end;
		end if;
		V_13C.delete;
		V_23E.delete;
		V_71F.delete;
		for i in P_MT103.[F_13C]
		loop
			V_13C(nvl(V_13C.last, 0) + 1) := i;
		end loop;
		for i in P_MT103.[F_23E]
		loop
			v_string := i;
			begin
				v_23E_rec.[CODE] := ::[VAL_INSTR23]([CODE] = substr(v_string.[STRING], 1, 4));
			exception when NO_DATA_FOUND then
				v_23E_rec.[CODE] := null;
			end;
			if substr(v_string.[STRING], 5, 1) = '/' then
				v_23E_rec.[ADD_INFO] := substr(v_string.[STRING], 6);
			else
				v_23E_rec.[ADD_INFO] := null;
			end if;
			V_23E(nvl(V_23E.last, 0) + 1) := v_23E_rec;
		end loop;
		for i in P_MT103.[F_71F] order by i%id
		loop
			V_71F(nvl(V_71F.last, 0) + 1) := i;
		end loop;
		
		in_dog := P_GET_INPUT;
		in_iso := P_GET_INPUT.[FINTOOL];
		out_dog := P_GET_OUTPUT;
		out_iso := P_GET_OUTPUT.[FINTOOL];

		P_UKNOWN := false;
		V_UKNOWN := null;

		this_state := this%state;
		first_time := true;

		V_MAIN_DOC := ::[DOCUM_RC].[SWIFT_DOC_LIB].get_docs_list_id(P_MAIN_DOC, this.[QUIT_DOC]);
		if in_iso != out_iso then
			P_RATE := ::[RUNTIME].[STR].GET_NUM_PAR(this.[BLOCK_DATA], 'p_rate');
			P_BACK_RATE := nvl(::[RUNTIME].[STR].GET_BOOL_PAR(this.[BLOCK_DATA], 'p_back_rate'), true);
			if P_RATE is null then
				P_RATE := P_MT103.[F_36];
				if P_RATE is null then
					P_RATE := &VCHK.[CALC_RATE](in_iso, out_iso, ::[TRC].[INI].TODAY);
				end if;
			end if;
		end if;
				
		last_error := ORI_DOC_RC.[REFREASON] || ORI_DOC_RC.[REFREASON2];
		V_REFTYPE   := ORI_DOC_RC.[REFTYPE];
		V_REFREASON := last_error;

		if V_MAIN_DOC is not null then
			V_STATE := '1';
		else
			V_STATE := '0';
		end if;
		if ::[DOCUM_RC].[CONTROL].CONTROL then
			V_STATE := V_STATE || '1';
		else
			V_STATE := V_STATE || '0';
		end if;

		if ::[RUNTIME].[STR].get_str_par(this.[BLOCK_DATA], 'MX_REF') is not null then
			declare
				mxClob 		clob;
				mxFileName 	string;
				tmpBlob 	blob;
			begin
				mxClob 	   := ::[ISO_MESSAGE].[LIB].getIsoText(this);
				if mxClob is not null and coalesce(dbms_lob.getlength(mxClob),0) < 20000 then
					V_MX := mxClob;
				elsif mxClob is not null and dbms_lob.getlength(mxClob) > 0 then
					V_MX := substr(mxClob,1,20000)||'...';
					dbms_lob.createtemporary( tmpBlob, false );
					::[RUNTIME].[LOB_UTILS].clob2blob(tmpBlob, mxClob, 'CL8MSWIN1251') ;	
					init_blob(tmpBlob);
					mxFileName := ::[ISO_MESSAGE].[LIB].getIsoFileName(this);
					csmd.command(V_VB, 'openFileMx_Btn.Visible = true');
					csmd.command(V_VB, 'openFileMxFIleName.Caption = "'||mxFileName||'"');
				else
					V_MX := mxClob;
				end if;	
			end;
		end if;

		if V_TYPED_COD in ('103', '103+','200', '202') then
			V_URGENT := this.[HOWLONG] = '1';
			csmd.command(V_VB, 'urg.Enabled = false');
		else
			csmd.command(V_VB, 'urg.Visible = false');
		end if;

		--Если экземляр архивный, то привязываем архивные представления
		if ::[RUNTIME].[DLC].is_table_partitioned('DOCUM_RC') then
			declare
				param ::[RUNTIME].[PLP].[VARCHAR_TABLE]%type;
			begin
				param(1) := this;
				v_key := ::[RUNTIME].[PLP].plp_n_tbl('select x(x%key) in ::[DOCUM_RC]  where x = to_number(str_params(1)) into Result;',param);
			end;
		end if;
		if v_key <> 1000 then
			csmd.Set_Validate_Prop( V_VB, 'P_MAIN_DOC', 'P', '.ViewShortName = "'||::[DOCUM_RC].[DEF_PARTITION].VW_ARC_MAIN_DOC||'"', true);
		end if;

		csmd.Set_Validate_Prop( V_VB, 'P_GET_PAYER', 'P', '.Visible = false');
		
		::[RUNTIME].[STR].get_par(this.[BLOCK_DATA], 'ACC_FOR_COMISS', V_ACC_FOR_COMISS);
		if V_ACC_FOR_COMISS is not null then
			csmd.Set_Validate_Prop( V_VB, 'V_ACC_FOR_COMISS.MAIN_V_ID', 'V', '.locked = true', true);
			csmd.Set_Validate_Prop( V_VB, 'V_ACC_FOR_COMISS', 'V', '.enabled = false', true);
		else
			csmd.Set_Validate_Prop( V_VB, 'V_ACC_FOR_COMISS', 'V', '.visible = false');
		end if;

		csmd.Set_Validate_Prop( V_VB, 'V_INV.NUM_INV', 'V', '.locked = true');
		
		csmd.Set_Validate_Prop( V_VB, 'P_PAYER.ACC', 'P', '.locked = true');
		--csmd.Set_Validate_Prop( V_VB, 'P_PAYER.ACC', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
-->> PSH VRI 02/10/2025 CFT-2508 Закомментарил	csmd.Set_Validate_Prop( V_VB, 'P_PAYER.NAME', 'P', '.locked = true');
		--csmd.Set_Validate_Prop( V_VB, 'P_PAYER.NAME', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		csmd.Set_Validate_Prop( V_VB, 'P_PAYER.OPTION.OPT', 'P', '.locked = true');
		--csmd.Set_Validate_Prop( V_VB, 'P_PAYER.OPTION', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');

		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.ACC', 'P', '.locked = true');
		--csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.ACC', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.NAME', 'P', '.locked = true');
		--csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.NAME', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.OPTION.OPT', 'P', '.locked = true');
		--csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.OPTION', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.BANK', 'P', '.visible = false');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.BANK.SWIFT_C', 'P', '.enabled = true');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.BANK.SWIFT_C', 'P', '.locked = true');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKPAY.BANK.SWIFT_C', 'P', '.visible = false');
		csmd.Set_Validate_Prop( V_VB, 'P_CODE_BANKPAY', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');

		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.ACC', 'P', '.locked = true');
		--csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.ACC', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.NAME', 'P', '.locked = true');
		--csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.NAME', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.OPTION.OPT', 'P', '.locked = true');
		--csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.OPTION', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.BANK', 'P', '.visible = false');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.BANK.SWIFT_C', 'P', '.enabled = true');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.BANK.SWIFT_C', 'P', '.locked = true');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKINT.BANK.SWIFT_C', 'P', '.visible = false');
		csmd.Set_Validate_Prop( V_VB, 'P_CODE_BANKINT', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		

-->> PSH VRI 02/10/2025 CFT-2508 Закомментарил	
		/*csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.ACC', 'P', '.locked = true');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.ACC', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.NAME', 'P', '.locked = true');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.NAME', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.OPTION.OPT', 'P', '.locked = true');*/
--<< PSH VRI 02/10/2025 CFT-2508 Закомментарил

		--csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.OPTION', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');

-->> PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline
		csmd.Set_Validate_Prop( V_VB, 'P_VALDATE', 'P', '.enabled = true');
		/*
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.BANK', 'P', '.visible = false');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.BANK.SWIFT_C', 'P', '.enabled = true');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.BANK.SWIFT_C', 'P', '.locked = true');
		csmd.Set_Validate_Prop( V_VB, 'P_NAME_BANKREC.BANK.SWIFT_C', 'P', '.visible = false');
		csmd.Set_Validate_Prop( V_VB, 'P_CODE_BANKREC', 'P', '.BackColor = "' || &LV.BackColorGRAY || '"');*/
--<< PSH VRI 02/10/2025 CFT-2508 Корректировка платежных сообщений SBER Finline		

		if V_TYPED_COD like '10%' then
			csmd.Set_Validate_Prop( V_VB, 'P_RECEIVER', 'P', '.Caption = "Бенефициар (59)"', true);
			csmd.Set_Validate_Prop( V_VB, 'P_RECEIVER.ACC', 'P', '.top = 360');
