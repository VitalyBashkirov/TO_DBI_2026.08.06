-- Тестовый файл для проверки правил: тдс20240828
-- Дата генерации: 2026-04-29 15:35:35

--[32] тдс20240828.стр.1|Теги:|dml,join,update,delete

begin --<добавлено при генерации теста>
  В `update`/`delete` нельзя присоединять таблицы, которые не модифицируются. Переписать на подзапросы или явные условия.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[33] тдс20240828.стр.3|Теги:|metadata,join,analytics

begin --<добавлено при генерации теста>
  Нельзя использовать `JOIN` с `varray`, аналитические функции и иерархические запросы при обращении к метаданным. В колонках запроса можно разыменовывать реквизиты-ссылки на метаданные (аналогично UDF).
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[34] тдс20240828.стр.3|Теги:|pseudocolumn,oracle

begin --<добавлено при генерации теста>
  Псевдоколонки `OBJECT_ID`, `OBJECT_VALUE`, `ORA_ROWSCN`, `ROWID`, `ROWNUM`, `XMLDATA` не поддерживаются. Исключить или заменить на прикладную логику.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[35] тдс20240828.стр.3|Теги:|report,oracle reports

begin --<добавлено при генерации теста>
  Операции типа «Отчёт» на основе Oracle Reports запрещены. Использовать OOXML.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[36] тдс20240828.стр.3|Теги:|view,simple

begin --<добавлено при генерации теста>
  Вместо простых представлений (`VIEW`) использовать PL+ представления.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[37] тдс20240828.стр.3-4|Теги:|ansi,join,annotation

begin --<добавлено при генерации теста>
  Для хранилищ A2 добавлять аннотацию для генерации ANSI JOIN. В A1 (старый АРМ) неявные внешние соединения писать вручную.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[38] тдс20240828.стр.5|Теги:|fetch,exists,subquery

begin --<добавлено при генерации теста>
  В подзапросе `EXISTS` нельзя использовать `fetch` — это вызывает полную выборку подзапроса.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[39] тдс20240828.стр.6|Теги:|udf,limits

begin --<добавлено при генерации теста>
  UDF разрешены только в SELECT-листе запроса верхнего уровня без UNION. Запрещены в WHERE, GROUP BY, ORDER BY, подзапросах, выражениях.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[40] тдс20240828.стр.7|Теги:|xml,xmltype

begin --<добавлено при генерации теста>
  В SQL-запросах нельзя использовать `XMLType` — его нет в PostgreSQL. Процедурная поддержка XMLType есть на уровне ТЯ.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[41] тдс20240828.стр.7|Теги:|vw_sql,view

begin --<добавлено при генерации теста>
  Представления `VW_SQL` не поддерживаются. Использовать `VW_RPT` или прямые запросы. Обращения к `VW_CRIT`, `VW_RPT` допустимы при отсутствии UDF-колонок.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[42] тдс20240828.стр.7|Теги:|macro,execute,process

begin --<добавлено при генерации теста>
  Макросы подстановки `execute` и `process` не поддерживаются в DBI.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[43] тдс20240828.стр.7|Теги:|dynamic sql,dbms_sql

begin --<добавлено при генерации теста>
  Динамический SQL через `DBMS_SQL` заменить на `::[RUNTIME].[CALC]` или `::[RUNTIME].[PLP]`. Запрещены `RTL.execute_sql`, `RTL.exec_sql_out`, `UTILS.open_cursor`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[44] тдс20240828.стр.7-8|Теги:|decode,case

begin --<добавлено при генерации теста>
  Не любой `DECODE` компилятор сможет заменить на `CASE`. В `DECODE` может возникнуть неявное приведение типов. `CASE` более универсален.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[45] тдс20240828.стр.8|Теги:|date,arithmetic,interval

begin --<добавлено при генерации теста>
  В PostgreSQL `DATE - DATE` возвращает `INTERVAL`. Приводить к числу через `to_number()`. Не использовать `INTERVAL 'MONTH'`, `'YEAR'` — применять `add_months` или `interval('1','DAY')*k`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[46] тдс20240828.стр.8|Теги:|temp table,init

begin --<добавлено при генерации теста>
  Перед использованием временной таблицы вызвать `::[RUNTIME].[STORAGE_MGR].init_temp_table(p_class_id)`. Для таблиц «на сессию» предварительно очищать.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[47] тдс20240828.стр.9-10|Теги:|trigger,database

begin --<добавлено при генерации теста>
  Триггеры БД заменить на операции типа «Триггер» в PL+. Для совместимости добавить проверку `attribute_mapping_service.is_enabled`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[48] тдс20240828.стр.10|Теги:|functional,attributes

begin --<добавлено при генерации теста>
  Функциональные реквизиты можно использовать только в SELECT-листе верхнего уровня. При использовании в outer join возможно ошибка ORA-01799.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[49] тдс20240828.стр.10-11|Теги:|hierarchical,connect by

begin --<добавлено при генерации теста>
  Иерархические запросы по метаданным запрещены. Внутри `WITH` нельзя использовать колонку вышестоящего запроса. Нет аналога `NOCYCLE`. Порядок выборки отличается.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[50] тдс20240828.стр.11|Теги:|cast,type conversion

begin --<добавлено при генерации теста>
  Разные правила неявного приведения типов. Писать код с совместимыми типами или явным преобразованием. `LIKE` только к строкам.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[51] тдс20240828.стр.11|Теги:|exceptionloop

begin --<добавлено при генерации теста>
  Конструкция `exceptionloop` запрещена, так как портит транзакцию в PostgreSQL.
end loop; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[52] тдс20240828.стр.12|Теги:|bind,group by,distinct

begin --<добавлено при генерации теста>
  Нельзя использовать bind-переменные в выражениях `GROUP BY`, `DISTINCT`, `ORDER BY`. Переписать запрос.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[53] тдс20240828.стр.12|Теги:|context,userenv

begin --<добавлено при генерации теста>
  Контексты `USERENV` и `<OWNER>_SYSTEM` (например, `IBS_SYSTEM`) запрещены. Использовать пользовательский контекст через `executor.set_context`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[54] тдс20240828.стр.12|Теги:|xmlquery

begin --<добавлено при генерации теста>
  `XMLQuery` не поддерживается в PLPlus. Выполнять через `execute immediate`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[55] тдс20240828.стр.12|Теги:|nested table,varray

begin --<добавлено при генерации теста>
  Выборка из вложенных массивов (`nested table`) запрещена. Использовать циклы или выборку из скалярных/объектных типов.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[56] тдс20240828.стр.13|Теги:|json,object types

begin --<добавлено при генерации теста>
  Объектные типы Oracle (`JSON_Object_T`, `AQ$_JMS_MAP_MESSAGE` и др.) не поддерживаются. Использовать `LIB_JSON` для JSON.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[57] тдс20240828.стр.13|Теги:|ora_hash

begin --<добавлено при генерации теста>
  Функция `ORA_HASH` не поддерживается. Использовать `dbms_crypto.hash` или `INT_EXT_CALL_001`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[58] тдс20240828.стр.14|Теги:|codegen

begin --<добавлено при генерации теста>
  Нельзя из PL+ создавать или изменять операции и представления.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[59] тдс20240828.стр.14|Теги:|transaction,rollback

begin --<добавлено при генерации теста>
  После ошибки БД транзакция прерывается. В `WHEN OTHERS` делать `ROLLBACK` до savepoint или `RAISE`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[60] тдс20240828.стр.14|Теги:|json,lib_json

begin --<добавлено при генерации теста>
  Для работы с JSON использовать только `::[RUNTIME].[LIB_JSON]`. Объектные типы Oracle и PLJSON не поддерживаются.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[61] тдс20240828.стр.14|Теги:|charset,encoding

begin --<добавлено при генерации теста>
  Для конвертации кодировок использовать `::[RUNTIME].[CHARSET]`. Функция `convert` запрещена.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

