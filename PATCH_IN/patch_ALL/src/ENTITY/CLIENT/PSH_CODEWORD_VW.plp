class CLIENT;

@import_plsql(true)
@name('[ПСБ] Просмотреть кодовое слово')
method PSH_CODEWORD_VW is

@name('Кодовое слово') public V_CODEWORD [STRING_100];
@name('v_dest')        public V_DEST     [STRING_2000];

pragma include ([RUNTIME]::[MACRO_LIB]);
pragma include ([RUNTIME].[CSMD]);


show_code    const ::[fp_tune].[CODE]%type := 'SHOW_CODEWORD';
PSH_CODEWORD_VW is

validate is

begin
	if &DEFAULT_MES then
		::[CODEWORD].[LIB].check_class_supported (this%class);

		&init_form (v_dest)
		if ::[FP_TUNE].[LIB].get_bool_value (show_code, throw_error == '0') then
			::[RUNTIME].[CSMD].Command (v_dest, 'v_codeword.PasswordChar = ""');
		end if;
		v_codeword := ::[CODEWORD].[LIB].find (this);
	end if;
end;

execute is
begin
	null;
end;
end;
end;
