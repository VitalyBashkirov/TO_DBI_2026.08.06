class PSH_IBANK2;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Библиотека СБП Новая')
@tag('COPIED')
library PSH_L2 is
pragma macro (lj_lib,'::[PSH_LOCAL_JOB].[PSH_LIB]');

VID_DOC_BO const ref [NAME_PAYDOC]:=::[NAME_PAYDOC]([CODE] = 'БЕЗН_БАНК_ОРД');
VID_DOC_MO const ref [NAME_PAYDOC]:=::[NAME_PAYDOC]([CODE] = 'БЕЗН_МЕМО_ОРД');
VID_DOC_PP const ref [NAME_PAYDOC]:=::[NAME_PAYDOC]([CODE] = 'БЕЗН_ПЛ_ПОРУЧ');

l_VO99090 const ref [CURR_OPERATION]:=::[CURR_OPERATION]([FULL_CODE] = '99090');
l_VO99010 const ref [CURR_OPERATION]:=::[CURR_OPERATION]([FULL_CODE] = '99010');

--l_30233_B const ref [PL_USV]:=::[PL_USV]([NUM]='30233' and [FILIAL]=1985880 and [FINTOOL]=43353); 
l_30233_B const ref [PL_USV]:=::[PL_USV]([NUM]='30233' and [FILIAL]= ::[BRANCH]([CODE] = '001') and [FINTOOL] = ::[SYSTEM].[SYS_MAIN_VAL]);
--l_30232_B	const ref [PL_USV]:=::[PL_USV]([NUM] = '30232' and [FILIAL]=1985880 and [FINTOOL]=43353); 
--l_30232_C	const ref [AC_FIN]:=::[AC_FIN]([MAIN_V_ID] = '30232810400000001104'); 
--l_30233_C	const ref [AC_FIN]:=::[AC_FIN]([MAIN_V_ID] = '30233810700000001104');
l_70601 const ref [AC_FIN]:=::[AC_FIN]([MAIN_V_ID] = '70601810801002740828');
l_user_cr const ref [USER]:=::[USER]([USERNAME] = 'PAY_GATE2');

function MAIN_DOCUM_CREATE(
P_DOCUMENT_NUM string
,P_DATE_DOC date
,P_VID_DOC ref [NAME_PAYDOC]
,P_SUM_DT number
,P_NAZN [MEMO]
,l_CL_DT [REQ_CLIENT]
,P#VIB_DT [CASE_BETWEEN_TWO]
,l_CL_KT [REQ_CLIENT]
,P#VIB_KT [CASE_BETWEEN_TWO]
,P_FILIAL ref [BRANCH]
,P_DEPART ref [DEPART]
,P_CUR_OP ref [CURR_OPERATION]
,P_ORDER  number default null
) 
return ref [MAIN_DOCUM]
is
P_PRIORITET number:=5;
P_DATE_VAL date:=P_DATE_DOC;
begin
 	-->> Valishin 10/12/2024
    if P_CUR_OP is not null then
    	::[MAIN_DOCUM].[NEW#DOC].V_CURR_OPER := P_CUR_OP;
    	P_NAZN:='{VO' || P_CUR_OP.[FULL_CODE] || '} ' ||P_NAZN;
    end if;
 	--<< Valsihin 10/12/2024
 	return ::[MAIN_DOCUM].[NEW#DOC](
 	                                P_DOCUMENT_NUM --   -- P#DOCUMENT_NUM	--Номер
					                ,P_DATE_DOC --      --P#DATE_DOC		--Дата документа
					                ,P_VID_DOC --       --P#VID_DOC		    --Вид документа
					                ,P_SUM_DT --        --P#SUM		        --Сумма в валюте платежа
									,null --            --P#DATE_PL		    --Срок оплаты
									,nvl(P_ORDER,P_PRIORITET) --     --P#PRIORITET		--Срочность платежа
									,null --            --P#DOC_SEND_REF	--Почта/телеграф
									,P_NAZN --          --P#NAZN		    --Назначение платежа
									,null --            --P#SUM_CARD		--Сумма в картотеке
									,null --            --NEW_STATE		    --Отправка документа
									,null --            --CODE_DOC		    --Условное обозначение(шифр) пл.документа
									,null --            --P#KOD_NAZN_PAY	--Код назначения платежа
									,null --            --P#ACC_PROV		--Корсчет проводки
									,null --            --P#SSS		        --Строка
									,null --            --P_VID_OBOROTA		--Вид оборота
									,null --            --P_BUDGET_PAYMENT	--Бюджетный платеж
									,null --            --P#ACC_PROV_DT		--Корсчет проводки дебет
									,null --            --P#SSS_DT		    --Строка дебет
									,P_DATE_VAL --      --P#DATE_VAL		--Дата валютирования
									,null --            --P#INNDt		    --ИНН для фильтра (плательщик)
									,null --            --P#INNCt		    --ИНН для фильтра (получатель)
									,null --            --P#BICDt		    --БИК для фильтра (плательщик)
									,null --            --P#BICCt		    --БИК для фильтра  (получатель)
									,l_CL_DT.[1] --     --P#CL_DT_1		    --Внутренние реквизиты ДТ
									,l_CL_DT.[2] --     --P#CL_DT_2		    --Внешние реквизиты ДТ
									,P#VIB_DT --        --P#VIB_DT		    --Выбор ДТ
									,l_CL_KT.[1] --     --P#CL_KT_1		    --Внутренние реквизиты КТ
									,l_CL_KT.[2] --     --P#CL_KT_2		    --Внешние реквизиты КТ
									,P#VIB_KT --        --P#VIB_KT		    --Выбор КТ
									,null --            --P#SUM_PO		    --Сумма зачисления	
									,null --            --P#SUM_NT		    --Сумма нац.покрытия
									,null --            --P#MULTICURR		--Свойство валютности
									,null --            --P_PACHKA		    --Пачка
									,null --            --P_BUD_REQS		--Дополнительные реквизиты бюджетного документа
									,null --            --P_USER_TYPE		--Пользовательский тип
									,null --            --P_NUMB_BASE_DOC	--Количество ПУД
									,null --            --P_LIST_BASE_DOC	--Количество листов в ПУД
									,null --            --P_PUD_APPLIED_TO  --Пуд приложен к
									,null --            --P_REP_1ST_SIGN	--Представитель для первой подписи
									,null --            --P_KL_BNK		    --Вид перевода
									,null --            --P_ACC_COM		    --Счет для удержания комиссии по документу
									,P_FILIAL --        --P_FILIAL	        --Филиал
									,P_DEPART --        --P_DEPART		    --Подразделение
									,null --            --P_CODE		    --Код
									);
end;

procedure MAIN_DOCUM_TO_PROV_REPEAT(
p_doc ref [MAIN_DOCUM]
) 
is
l_MAX_PROV_ATTEMPTS number:=::[FP_TUNE].[LIB].get_num_value('PSB_MAX_ATTEMPTS_SBP');
l_WAIT_TIME_BEFORE_PROV number:=::[FP_TUNE].[LIB].get_num_value('PSB_WAIT_BEFORE_REPEAT_SBP');
EXPN_RESOURCE_LOCK exception;
pragma exception_init(EXPN_RESOURCE_LOCK, -20500);  -- ORA-20500: LOCK-RESOURCE_BUSY: Экземпляр ... блокирован, тип [...]
begin
	p_doc.[DOC_TO_PROV]();
	if p_doc%state = 'TO_RKO' then
		p_doc.[DOC_TO_PROV]();
	end if;
exception
	when RESOURCE_BUSY or EXPN_RESOURCE_LOCK then
		for r in 1..l_MAX_PROV_ATTEMPTS loop
			begin
				Utils.Sleep(l_WAIT_TIME_BEFORE_PROV);
				p_doc.[DOC_TO_PROV]();
				if p_doc%state = 'TO_RKO' then
					p_doc.[DOC_TO_PROV]();
				end if;
			exception
				when RESOURCE_BUSY or EXPN_RESOURCE_LOCK then
					null;
			end;
			if p_doc%state = 'PROV' then
				exit;
			end if;
		end loop;
end;

public function EXECUTE_QUERY
(
P_DATE_DOC date --                      --Дата платежа 
,P_INN varchar2(12) --                  --ИНН
,P_MCC varchar2 --                      --МСС-код
,P_ACCOUNT varchar2(20) --              --Номер счета (из АБС) 
,P_OPER integer --                      --Тип операции
--                                      --     1    -покупка
--                                      --     2    -возврат-резерв
--                                      --     3    -возврат-списание
--                                      --     4    -выплата-резервирование
--                                      --     5    -выплата-списание
--                                      --     6    -отмена возврата
--                                      --     7    -отмена выплаты
--                                      --     8    -диспут 
--                                      --     -1   -alive запрос
--                                      --     -2   -запрос остатка по счету
--                                      --     -999 -тип операции пустой (внутр. код)
,P_AMOUNT IN OUT NOCOPY number --       --Сумма 
,P_COMMISSION number --                 --Комиссия
,P_OREDER varchar2 --                   --Номер документа в ПС
,P_REQUEST_NUM integer DEFAULT 0 --     --Номер обрабатываемого запроса, в разрезе Номера документа в ПС 
,P_TRANSACTION IN OUT NOCOPY varchar2   --Номер транзакции
)
return number
--                                      --     0    -возникла ошибка при обработке запроса на создание/допроводку/ликвидацию платежного документа
--                                      --     1    -найден проведенный платежный документ/непроведенный платежный документ с переданным P_TRANSACTION допровелся/создан платежный документ, документ проведен/ликвидирован
--                                      --     -1   -не совпадает ИНН клиента по счету с переданным P_INN
--                                      --     -2   -счет P_ACCOUNT:'||P_ACCOUNT||' закрыт
--                                      --     -3   -счет P_ACCOUNT не найден в справочнике Финансовые счета
--                                      --     -4   -не найден счет НЗР соответствующий клиенту владельцу счета P_ACCOUNT
--                                      --     -5   -не найдено платежного документа для подтверждения соответствующего переданному P_TRANSACTION
--                                      --     -7   -недостаточно средств на счёте плательщика
--                                      --     -100 -найденный платежный документ не проведен/созданный платежный документ не проведен
--                                      --     -101 -не найдено платежного документа для ликвидации соответствующего переданному P_TRANSACTION
--                                      --     не возвращаются:
--                                      --     -6   -не найден счет НЗР соответствующий клиенту владельцу счета P_ACCOUNT (проверка не выполняется)
--                                      --     -102 -созданный комиссионный документ не проведен (внутр. код)
is
l_STR MEMO_BIG;
l_TRANSACTION varchar2;
l_DATE_DOC date;
l_SUM_DT number; -- Сумма Дт.
l_DOCUMENT_NUM string:='1'; -- Номер платежного документа
l_ACC_KT ref [AC_FIN];
l_CLIENT_V ref[CLIENT];
l_30233	ref [AC_FIN];
l_ACC ref [AC_FIN];
P_NAZN [MEMO]; -- Назначение платежа
P_VID_DOC ref [NAME_PAYDOC]; -- Вид документа
P_FILIAL ref [BRANCH]; -- Филиал документа
P_DEPART ref [DEPART]; -- Подразделение документа
P#VIB_KT [CASE_BETWEEN_TWO];
l_CL_KT	[REQ_CLIENT];
P#VIB_DT [CASE_BETWEEN_TWO];
l_CL_DT	[REQ_CLIENT];
main_doc ref [MAIN_DOCUM];
--l_30232 ref [AC_FIN];
b_100 boolean:=false;
--b_102 boolean:=false;
/*
l_acc_mvd_kt varchar2;
l_main_doc ref [MAIN_DOCUM];
l_folder ref [FOLDER_PAY];
l_RCPT_NAME	varchar2;
l_RCPT_LEGAL_NAME varchar2;
*/
begin
    --::[SYSTEM].[VARIABLES].set_system_vars_by_user(32303141); 
    --::[END_OD_INTERFACE].[PRX_DOCUMENT].trc_set_var_current;
    --stdio.put_line_pipe('==================', 'SBP');  
    /*формируем данные для отладки*/
    l_STR:='P_OREDER=>'''||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'
    ||''',P_OPER=>'''||nvl(P_OPER, -999)    
    ||''',P_DATE_DOC=>'||to_char(P_DATE_DOC, 'DD.MM.YYYY HH24:MI:SS')    
    ||''',P_INN=>'''||nvl(P_INN, ' ')
    ||''',P_MCC=>'''||nvl(P_MCC , ' ')
    ||''',P_ACCOUNT=>'''||nvl(P_ACCOUNT, ' ')
    ||''',P_AMOUNT=>'''||nvl(P_AMOUNT, 0)
    ||''',P_COMMISSION=>'''||nvl(P_COMMISSION, 0)
    ||''',P_TRANSACTION=>'''||nvl(regexp_replace(P_TRANSACTION, '[^[[:digit:]]]*'), ' '||'''');
    --stdio.put_line_pipe(to_char(sysdate, 'hh:mi:ss')||' '||l_str,'SBP');
    --l_rec.[TEXT_LIST].[CFB_NEW](null, false, false, sysdate,rtrim(ltrim(l_str)));
    --&lj_lib.write_log('EXEC_QUERY', substr(l_str, 1, 200));
    &lj_lib.write_log('EXEC_QUERY', l_str);    
    l_TRANSACTION:=regexp_replace(P_TRANSACTION,'[^[[:digit:]]]*'); --запоминаем переданный ID транзакции
    P_TRANSACTION:=0; --обнуляем параметр ID транзакции
    -- 1=покупка =============================================================================================================
    if P_OPER = 1 then
        begin    
			--if nvl(P_COMMISSION,0)=0 then 
			--   l_SUM_DT := P_AMOUNT/100-round(0.007*P_AMOUNT/100,2);
			--else
			l_SUM_DT:=(P_AMOUNT-nvl(P_COMMISSION,0))/100;
			--end if;    
	        &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Сумма платежа='||l_SUM_DT);
			--stdio.put_line_pipe(Сумма платежа='||l_SUM_DT, 'SBP');			
			l_DATE_DOC:=trunc(P_DATE_DOC);
			/*ищем уже проведенный документ по номеру документа в ПС на дату платежа*/            			
            begin
                locate main_doc in ::[MAIN_DOCUM] 
                --where trunc(main_doc.[DATE_PROV]) = l_DATE_DOC
				where main_doc.[DATE_DOC] = l_DATE_DOC   		-->> PSB VRI 28/07/2025 Заменил, чтобы находился и непроведённый документ с таким P_OREDER
					and main_doc.[VID_DOC]  = VID_DOC_BO
	                and main_doc.[DOCUMENT_UNO] = 'SBP-'||to_char(P_OREDER);
	            if main_doc.[SUM] = l_SUM_DT
	            	and trunc(main_doc.[DATE_PROV]) = l_DATE_DOC -->> PSB VRI 28/07/2025 Добавил, чтобы проверялась дата проводки
	                and main_doc%state = 'PROV' then
	                &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Найден проведенный платежный документ: ID='||main_doc%id||' Возврат=1');
	                --stdio.put_line_pipe('Найден проведенный платежный документ: ID='||main_doc%id||' Возврат=1', 'SBP');
	                P_TRANSACTION:=main_doc%id;
	                return 1;
	            /*если передан P_TRANSACTION, проверяем что значение совпадает и пытаемся провести*/
	            elsif main_doc.[SUM] = l_SUM_DT 
	                and main_doc%state <> 'PROV'
	                and main_doc%id = l_TRANSACTION then
	                	
	                -->> PSH VRI 27/03/2026 Перевод на проводку через PSH_EVENT 
	                main_doc.[PSH_TO_EVENT](null);            
            		&lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Непроведенный платежный документ с переданным P_TRANSACTION отправлен на проводку в PSH_EVENT: ID='||main_doc%id||' Возврат=1');
                    P_TRANSACTION:=main_doc%id;
                    return 1;			    
	                
	                /*MAIN_DOCUM_TO_PROV_REPEAT(main_doc);
	                
                    if main_doc%state = 'PROV' then
	                    &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Непроведенный платежный документ с переданным P_TRANSACTION допровелся: ID='||main_doc%id||' Возврат=1');
	                    --stdio.put_line_pipe('Непроведенный платежный документ с переданным P_TRANSACTION допровелся: ID='||main_doc%id||' Возврат=1', 'SBP');
	                    P_TRANSACTION:=main_doc%id;
	                    return 1;			    
				    else 
	                    &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Найденный платежный документ не проведен: ID='||main_doc%id||' '||nvl(main_doc.[TEXT_VOZV], '')||' Возврат=-100');
	                    --stdio.put_line_pipe('Найденный платежный документ не проведен: ID='||main_doc%id||' '||nvl(main_doc.[TEXT_VOZV],'')||' Возврат=-100', 'SBP');
	                    P_TRANSACTION:=main_doc%id;
	                    return -100;                    
				    end if;*/
				    --<< PSH VRI 27/03/2026
				    
	            end if;
	        exception
	            when no_data_found then
                    null;
	        end;
	        /*ищем счет по переданному P_ACCOUNT*/
	        begin
                locate l_ACC_KT in ::[AC_FIN]
                where l_ACC_KT.[MAIN_V_ID] = P_ACCOUNT;
			    /*проверяем совпадение ИНН клиента по счету с переданным P_INN*/
			    if nvl(l_ACC_KT.[CLIENT_V].[INN],0) != P_INN then
			        &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Не совпадает ИНН клиента по счету с переданным P_INN='||l_ACC_KT.[CLIENT_V].[INN]||'<>'||P_INN||' для платежа №'||P_OREDER||'. Возврат=-1');
	                --stdio.put_line_pipe('Не совпадает ИНН клиента по счету с переданным P_INN='||l_ACC_KT.[CLIENT_V].[INN]||'<>'||P_INN||' для платежа №'||P_OREDER||'. Возврат=-1', 'SBP');
			        return -1;
			    end if;
			    /*проверяем что счет не закрыт*/
			    if l_ACC_KT.[DATE_CLOSE] is not null then 
			        &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Счет P_ACCOUNT='||P_ACCOUNT||' закрыт'||'. Возврат=-2');
	                --stdio.put_line_pipe('Счет P_ACCOUNT='||P_ACCOUNT||' закрыт'||'. Возврат=-2', 'SBP');
			        return -2;
			    end if;
			    l_CLIENT_V:=l_ACC_KT.[CLIENT_V];			    			    
	        exception
	            when no_data_found then
	    			/*счет не найден*/       
			        &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Счет не найден P_ACCOUNT='||P_ACCOUNT||'. Возврат=-3'); 
		            --stdio.put_line_pipe('Счет не найден P_ACCOUNT='||P_ACCOUNT||'. Возврат=-3', 'SBP');
			        return -3;
	        end;
	        /*ищем счет НЗР соответствующий клиенту владельцу счета P_ACCOUNT*/	        
	        begin
                locate l_30233 in ::[AC_FIN]
                where l_30233.[MAIN_USV] = l_30233_B
	                and l_30233.[CLIENT_V] = l_CLIENT_V                
	                --and substr(l_30233.[MAIN_V_ID],17,1) = '1'
	                and l_30233.[TARGET].CODE = 'PSB_30233_SBP'
	                and rownum = 1;
                l_ACC:=l_30233;--l_30233_C;	                
	        exception
	            when no_data_found then
		            &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Не найден счет НЗР соответствующий клиенту владельцу счета P_ACCOUNT='
		            ||P_ACCOUNT||' и PL_USV.NUM='||l_30233_B.[NUM]||'. Возврат=-4');
		            --stdio.put_line_pipe('Не найден счет НЗР соответствующий клиенту владельцу счета P_ACCOUNT='
		            --||P_ACCOUNT||' и PL_USV.NUM='||l_30233_B.[NUM]||'. Возврат=-4', 'SBP');
		            return -4;	            
	        end;
			P_NAZN:='Перечисление денежных средств по операции оплаты с использованием СБП за '||to_char(l_DATE_DOC, 'dd.mm.yy')
			||substr(l_ACC.[NAME], instr(l_ACC.[NAME], ' по договору '), instr(l_ACC.[NAME], ' по операц') - instr(l_ACC.[NAME], ' по договору '));
	        --stdio.put_line_pipe(substr(l_ACC.[NAME], instr(l_ACC.[NAME], ' по договору '), instr(l_ACC.[NAME],' по операц') - instr(l_ACC.[NAME],' по договору ')), 'SBP');
			P_NAZN := P_NAZN||'. Комиссия '||to_char(nvl(P_COMMISSION / 100, 0), 'FM99,999,999,999,990.00')||' руб. НДС не облагается.';
	        --::[FP_TUNE].[LIB].get_date_value('PSB_DATE_SBP', null, '0')		
	        P_VID_DOC:=VID_DOC_BO;
	   		P_FILIAL:=l_ACC.[FILIAL];
			P_DEPART:=l_ACC.[DEPART]; --8935433
			P#VIB_KT.[0]:=1;
			l_CL_KT.[0]:=1;
			l_CL_KT.[1].[1]:=l_CLIENT_V;
			l_CL_KT.[1].[2]:=l_ACC_KT;		
			P#VIB_DT.[0]:=1;		
			l_CL_DT.[0]:=1;
			l_CL_DT.[1].[1]:=l_CLIENT_V;
			l_CL_DT.[1].[2]:=l_ACC;
    		/*создаем платежный документ*/
            &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' Создаем платежный документ');
            --savepoint A1_PSB_IBANK2_L2; 
            --stdio.put_line_pipe('создаем платежный документ'||to_char(sysdate,'hh:mi:ss'), 'SBP');
	        -->> Valishin 10/12/2024
	        if substr(P_ACCOUNT,1,5) in ('40807') then
                main_doc:=MAIN_DOCUM_CREATE(l_DOCUMENT_NUM, l_DATE_DOC, P_VID_DOC, l_SUM_DT, P_NAZN, l_CL_DT, P#VIB_DT, l_CL_KT, P#VIB_KT, P_FILIAL, P_DEPART, l_VO99090);
            else
                main_doc:=MAIN_DOCUM_CREATE(l_DOCUMENT_NUM, l_DATE_DOC, P_VID_DOC, l_SUM_DT, P_NAZN, l_CL_DT, P#VIB_DT, l_CL_KT, P#VIB_KT, P_FILIAL, P_DEPART, null);
            end if;
            main_doc.[DOCUMENT_USER] := l_user_cr;
			--<< Valishin 10/12/2024
		    &lj_lib.write_log('EXEC_QUERY', 'P_OREDER='||nvl(P_OREDER, ' ')||'('||P_REQUEST_NUM||')'||' ID платежного документа ='||MAIN_DOC%id);
            main_doc.[DOCUMENT_UNO]:='SBP-'||to_char(P_OREDER);
            main_doc.[DATE_DOC]:=l_DATE_DOC;            
			main_doc.[DATE_VAL]:=l_DATE_DOC;
