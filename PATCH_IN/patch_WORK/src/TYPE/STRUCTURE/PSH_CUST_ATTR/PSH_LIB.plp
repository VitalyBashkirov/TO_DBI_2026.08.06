class PSH_CUST_ATTR;

@this(create_on_start:=true)
@name('[ПСБ] Библиотека')
@tag('COPIED')
library PSH_LIB is

public type t_item_tab is table of string(250);
/*Тип для передачи списка значений реквизитов.*/

/*Список значений реквизита, которые связаны с запросом.*/
public procedure set_req_attr
/*Процедура для создания связи "запрос-реквизит".*/
(
	  P_REQ ref [PSH_CUST_REQS] -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
		/*Запрос, с которым нужно связать реквизит.*/
	, P_ATTR varchar2(16)
		/*Код реквизита.*/
	, P_VALUE string(250)
		/*Значение реквизита.*/
) is 
begin
	::[PSH_CUST_ATTR].[PSH_NEW_AUTO]( -- updated CHANGE_QUALIFIER PSB_CUST_ATTR->PSH_CUST_ATTR 08/10/25 -- updated CHANGE_SHORT_NAME NEW_AUTO->PSH_NEW_AUTO 15/10/25
		  P_REQ
		, P_ATTR
		, P_VALUE
	);
end;

public function get_value_by_req
/*Функция для получения списка значений реквизита, которые связаны с запросом.*/
(
	  P_REQ ref [PSH_CUST_REQS] -- updated CHANGE_QUALIFIER PSB_CUST_REQS->PSH_CUST_REQS 08/10/25
		/*Запрос, для которого нужно получить список значений реквизита, которые связаны с запросом.*/
	, P_ATTR varchar2(16)
		/*Код реквизита.*/
)
return t_item_tab is 
	v_ret_tab t_item_tab;
begin
	select x(x.[ATTR_VALUE]) in ::[PSH_CUST_ATTR] all -- updated CHANGE_QUALIFIER PSB_CUST_ATTR->PSH_CUST_ATTR 08/10/25
	where
		x.[REQ] = P_REQ and x.[ATTR_ID] = P_ATTR
	into v_ret_tab;
	
	return v_ret_tab;
end;
end;
