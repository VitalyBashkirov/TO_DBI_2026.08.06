class PL_US;

@import_plsql(true)
@name('[ПСБ] Библиотека')
library PSH_LIB is
public function get_ps(
	p_pl		ref [PL_US],
	p_letter	string
) return string is 
	v_str	string(1000);
begin
	for c in p_pl.[B_PS]
	where c.[PS_CODE] like p_letter || '%'
	order by c.[PS_CODE]
	loop
		if v_str is null then
			v_str := c.[PS_CODE];
		else
			v_str := v_str || '; ' || c.[PS_CODE];
		end if;
	end loop;
	
	return v_str;
end;

pragma restrict_references(get_ps, WNDS, WNPS);
end;
