-- Получение пользователя, работающего с клиентом
public function get_cl_info_user(code ::[VID_OPER_DOG].[CODE]%type, collection_id [CL_INFO_USER_ARR], event_date date) return string(350) is 
begin
	if collection_id is not null then
		for (	select x(x.[NAME] : name, x.[CASTA_NAME] : casta)
				in collection_id
				where	x.[PERSON_TYPE].[CODE] = code
					and trunc(x.[OPER_DATE]) <= trunc(event_date)
					and	x.[OPER_TYPE].[CODE] = 'FIRST_ACCOUNT_OPEN'
				order by x.[OPER_DATE]
			)
		loop
			return x.name || bool_char(x.casta is not null, ', '||x.casta, '');
		end loop;
		return null;
	else
		return null;
	end if;
end;

public function get_date_upd(cl ref [CLIENT], on_date date default trunc(sysdate) ) return date is 
	is_auto		boolean;
	last_date	date;
	value		varchar2(4000);
	cl_hist_ref ref [CL_HIST];
begin
	is_auto := ::[CL_CORP].[EDIT_ANKETA].is_auto_fill_date_upd( nvl(on_date, trunc(sysdate)) );
	if is_auto then
		last_date := ::[LEGAL_INTERFACE].[PRX_CLIENT].cl_hist_get_last_date(cl, on_date);
		return last_date;
	else
		cl_hist_ref := ::[LEGAL_INTERFACE].[PRX_CLIENT].cl_hist_get_value(cl, 'DATE_FORM_UPD', on_date + 1, value);
		if cl_hist_ref is not null then
			return value;
		else
			return CL.[DATE_FORM_UPD];
		end if;
	end if;
	return null;
end;
/**************************************************************
 возвращает строку, содержащую все контакты типа contact_type
 и принадлежности contact_private
***************************************************************/
function GetContacts(cont_arr [CONTACTS_ARR], contact_type string) return varchar2(1000) is
str varchar2(1000);
begin
	str := null;
	if contact_type is not null  then
	-- optimaize
		for
		(
			select res
			(
				res.[PRIVATE].[VALUE]: 	c_priv,
				res.[TYPE].[VALUE]:		c_val,
				res.[NUMB]:				c_numb
			)
		in		cont_arr
		where	res.[ACTIV] = true
				and res.[NUMB] is not null
				and res.[TYPE].[CODE] = contact_type
				and (res.[PRIVATE].[CODE] in ('1', '2', '3') or res.[PRIVATE] is null)
		order by res.[PRIVATE].[CODE]
		)loop
			if str is null then
				str := LTRIM(res.c_priv || ' ' || res.c_val || ' ' || res.c_numb);
			else
				str := str || NL$ || LTRIM(res.c_priv || ' ' || res.c_val || ' ' || res.c_numb);
			end if;
		end loop;
	else
		return '';
	end if;
	return str;
end;

/*******************************************
 Функция возвращает сведения о документах,
 подтверждающих право проживания в РФ
********************************************/
function Get_Visa(p_cl [CL_PRIV], p_date date) return varchar2(32000)
is
	str varchar2(32000) := '';
begin

	-- optimaize
	for
	(
		select v_visa
		(
			v_visa.[TYPE].[FULL_NAME]: 	v_name,
			v_visa.[SER]:				v_ser,
			v_visa.[NUM]:				v_num,			
			v_visa.[DATE]:				v_date,
			v_visa.[DATE_END]:			v_date_end,
			v_visa.[WHO]:				v_who
		)
	in p_cl.[DOC_ARR]
	where v_visa.[TYPE].[RESIDENCE_RIGHT]  and
		  nvl(v_visa.[DATE],p_date) <= p_date and
		  nvl(v_visa.[DATE_END],p_date) >= p_date
	)	
	loop
	-- VISA инфо
		str :=  str||
				nvl(v_visa.v_name, '')||
				' Серия: '||nvl(v_visa.v_ser,'-')||' №: '||nvl(v_visa.v_num,'-')||
				' Действует с '||nvl(to_char(v_visa.v_date,'dd.mm.rr'),'-/-/--')||' по '||nvl(to_char(v_visa.v_date_end,'dd.mm.rr'),'-/-/--')||
				' Выдан: '||ltrim(rtrim(v_visa.v_who))
				||NL$;	
	end loop;	
	
	return str;
end;

/*******************************************
 Функция возвращает сведения о СНИЛС
********************************************/

function Get_SNILS(p_cl [CL_PRIV], p_date date) return varchar2(32000)
is
	str varchar2(32000) := '';
begin
	-- optimaize
	if nvl(p_cl.[SNILS], '-') = '-' then
	for
	(
		select v_visa
		(
			v_visa.[TYPE].[FULL_NAME]: 	v_name,
			v_visa.[TYPE].[KOD]: 	v_kod,
			v_visa.[SER]:				v_ser,
			v_visa.[NUM]:				v_num,			
			v_visa.[DATE]:				v_date,
			v_visa.[DATE_END]:			v_date_end,
			v_visa.[WHO]:				v_who
		)
	in p_cl.[DOC_ARR]
	where 	(v_visa.[TYPE].[KOD] = '15' or v_visa.[TYPE].[KOD] = 'СНИЛС') and
		  nvl(v_visa.[DATE],p_date) <= p_date and
		  nvl(v_visa.[DATE_END],p_date) >= p_date	
	)	
	loop
		-- СНИЛС инфо
		str := nvl(v_visa.v_num,'-');
		exit;
	end loop;	
	else
		str := p_cl.[SNILS];
	end if;
	--debug_pipe(str,0);
	return str;
end;

/*******************************************
 Функция возвращает сведения о месте работы
********************************************/
function Get_Work(p_cl [CL_PRIV], p_date date) return varchar2(32000)
is
	str varchar2(32000) := '';
	op_dat date;
begin
	op_dat := nvl(p_date, ::[SYSTEM].[VARIABLES].OpDate);
	for
		(
			select rabota
				( nvl(rabota.[CORP_R].[NAME], rabota.[CORP])	:vCorp
				, rabota.[RANGE]								:vRange
				)
			in p_cl.[WORK_ACTIVITY]
			where
				    (nvl(rabota.[START_DATE],op_dat) <= op_dat )
				and	(nvl(rabota.[END_DATE],op_dat) >= op_dat )
				and (rabota.[CORP_R] is not null or rabota.[CORP] is not null or rabota.[RANGE] is not null)
			order by nvl(rabota.[START_DATE],op_dat) desc
		)
	loop
		str := str || trim(rabota.vCorp || ' ' || rabota.vRange) || NL$;
	end loop;
	str := substr(str, 1, length(str) - 2);	
	return str;
end;

/**********************************************************
 Функция возвращает сведения обо всех минграционных картах
**********************************************************/
function Get_Migration_Card(p_cl [CL_PRIV], p_date date) return varchar2(32000) is
str varchar2(32000);
begin
	str :='';
	for (
		select x(x.[CARD_NUM] :CARD_NUM
				,x.[DATE_BEG] :DATE_BEG
				,x.[DATE_END] :DATE_END)
		in p_cl.[MIGR_CARD]
		where	nvl(x.[DATE_BEG],p_date) <= p_date
			and	nvl(x.[DATE_END],p_date) >= p_date
		)
	loop
		str := str || 'Номер карты: ' || nvl(x.[CARD_NUM], '-') ||
					  ' Действует с ' || nvl(to_char(x.[DATE_BEG],'dd.mm.rr'), '-/-/--') ||
					  ' по ' || nvl(to_char(x.[DATE_END],'dd.mm.rr'), '-/-/--') || NL$;
	end loop;	
	return str;	                        	
end;

/**********************************************************
Функция возвращает паспортные данные клиента - физ лица.
**********************************************************/
function Get_passport(p_cl [CL_PRIV]) return string is
doc [CERTIFICATE];
begin
	doc := p_cl.[DOC];
	if doc.[TYPE] is not null then
	 	return doc.[TYPE].[NAME]||
	 		   bool_char(doc.[SER] is null, null, ' '||doc.[SER])||
 			   bool_char(doc.[NUM] is null, null, ' №'||doc.[NUM])||
			   bool_char(doc.[DATE]is null, null, '  выдан '||to_char(doc.[DATE],'dd/mm/yyyy'))||
			   bool_char(doc.[WHO] is null, null, ' '||doc.[WHO])||
			   bool_char(doc.[DEPART_CODE] is null, null, ' код подр. '||doc.[DEPART_CODE]);
	elsif doc.[WHO] is not null then
		return doc.[WHO];
	end if;
end;

/*********************************************************************
     Получить адрес клиента
*********************************************************************/
function GetAddressByRef
/* Получение адреса строкой по ссылке. */
	( a ref [PERSONAL_ADDRESS]
		/* Ссылка на "Адрес" */
	, AddRecv varchar2(100) default null
		/* Формат адреса. */
	, p_struct number default 1
        /* Структура адресного деления: 1 - административно-территориальное, 2 - муниципальное */
	)
	/* Строка с адресом. */
	return varchar2(1000)
is 
	ar	varchar2(200);
	v_address [PERSONAL_ADDRESS];
begin
	ar := upper(nvl(AddRecv, 'CITY'));
	if ar = 'ALL' then
		ar := 'POST_CODE,REGION_NCT,DISTRICT,MAIN_CITY,CITY,STREET,HOUSE,KORPUS,FLAT';
	end if;

	if a is null then
		return null;
	end if;
	v_address := a;
	
  --return ::[PERSONAL_ADDRESS].[API_LIB].addr_to_str
	return ::[PERSONAL_ADDRESS].[PSH_SLIB].addr_to_str
		( p_addr == v_address
		, p_format == ar
		, p_delimiter == ', '
		, p_add_empty == '0'
		, p_struct == p_struct
		);
end;
/**********************************************************
Функция возвращает адрес строкой
**********************************************************/
Function GetAddress(	cl_adresses		[CLIENT].[ADDRESSES]%type
						,AddRecv varchar2(100) default null
						,AddrCode varchar2(20) default null
			)return varchar2(1000)
is
addr			varchar2(1000);
addr_ref		ref [PERSONAL_ADDRESS];
cl ref [CLIENT];
begin
	
	if cl_adresses%parentclass='CL_PRIV' then
		cl:=cl_adresses%parent;
		--debug_pipe('.GetAddress -- cl_adresses%parentclass='||cl_adresses%parentclass||' '||cl%class||'.'||cl%id||'.'||cl.[NAME],dp);
	end if;
	
	AddrCode := upper(AddrCode);
	begin
		select a(a)
			in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all : t ) all
			where	a%collection = cl_adresses
					and t = a.[TYPE]
					and t.[KOD] = AddrCode
					and rownum <= 1
			into addr_ref;
			--debug_pipe('.GetAddress -- (1) addr_ref='||addr_ref||' AddRecv='||AddRecv||' AddrCode='||AddrCode,dp);
	exception
		when NO_DATA_FOUND then
			if AddrCode is null then   -- ищем любой адрес
				begin
					select a(a)
						in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all: t) all
						where	a%collection = cl_adresses
								and t = a.[TYPE]
								and rownum <= 1
						into addr_ref;
						--debug_pipe('.GetAddress -- (2) addr_ref='||addr_ref||' AddRecv='||AddRecv||' AddrCode='||AddrCode,dp);
				exception when NO_DATA_FOUND then
					null;
				end;
			end if;
	end;
  --addr := VIEWFUN.GetAddressByRef(	a		== addr_ref,
	addr := GetAddressByRef(	a		== addr_ref,
								AddRecv	== AddRecv);
	--debug_pipe('.GetAddress -- (3) addr='||addr,dp);
	return addr;
end;

-- Получение подразделения пользователя, работающего с клиентом, в родительном падеже
function get_cl_depart(code ::[VID_OPER_DOG].[CODE]%type, collection_id [CL_INFO_USER_ARR], event_date date) return ::[DECLENSION].[NAME]%type is
begin
	for (	select x(d : depart)
			in collection_id, (::[DEPART] : d)
			where	x.[PERSON_TYPE].[CODE] = code
				and d.[CODE] = x.[DEPART_CODE]
				and	trunc(x.[OPER_DATE]) <= trunc(event_date)
			order by x.[OPER_DATE] desc
		)
	loop
		return ::[DEPART].[LIB].get_declension(x.depart);	
	end loop;		
	return null;
end;

public function fill_benefit
/*Функция заполнения данных о выголоприобретателе и выгододателе и основаниии с возможностью отдельного вывода*/
(
	P_DATE_PRINT date
		/*Дата печати анкеты*/
	, P_CL_LINKS [LINKS_CL_ARR]
		/*Клиент, для которого ищутся взаимосвязи*/
	, P_TYPE ref [CL_LINK]
		/*Тип взаимосвязи. Ссылка*/
	, P_FOUND boolean
		/*Выводить основание*/
	, P_BEN boolean
		/*выводить выгододателя/выгодоприобретателя*/
)
/*Возвращается строка вида:
<ИМЯ>, на основании: <ОСНОВАНИЕ>
<ИМЯ2>, на основании: <ОСНОВАНИЕ2>

либо (если основания нет, либо вывод основания не нужен):
<ИМЯ>
<ИМЯ2>

либо(если вывод выгододателя/приобретателя не нужен):
<ОСНОВАНИЕ>
<ОСНОВАНИЕ2>
*/
return string(32000) is 
	ret_DATA string(32000);
	header boolean := true;
begin
	for cl_link in P_CL_LINKS
	where
		cl_link.[VID_LINK]  = P_TYPE
		and (cl_link.[DATE_BEG]<=P_DATE_PRINT or cl_link.[DATE_BEG] is null)
		and (cl_link.[DATE_END]>=P_DATE_PRINT or cl_link.[DATE_END] is null)
  	order by cl_link.[DATE_BEG]
	loop
		ret_DATA := rtl.bool_char(ret_DATA is not null, ret_DATA || bool_char(cl_link.[PARTNER] is not null or cl_link.[FOUND] is not null, ';'|| NL$,'') , '');
		if P_BEN then
			if header then
				if P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОПРИОБРЕТАТЕЛЬ') then
					ret_DATA := ret_DATA ||'Выгодоприобретатели: ';
				elsif P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОДАТЕЛЬ') then
					ret_DATA := ret_DATA ||'Выгододатели: ';
				end if;
				header := false;
			end if;

		--	if cl_link.[PARTNER] = P_CL_LINKS%parent(LINKS_OTHER) then
		--		ret_DATA := ret_DATA ||'бенефициарным владельцем клиента - физического лица является это лицо';
		--	else	
				ret_DATA := ret_DATA || cl_link.[PARTNER].[NAME];
		--	end if;
		end if;
		
		if P_FOUND and cl_link.[FOUND] is not null then
			if P_BEN then
				ret_DATA := ret_DATA || ', на основании: ';--если выводятся и сами выгододатели, напишем слово "на основании"
			end if;
			ret_DATA := ret_DATA || cl_link.[FOUND];
		end if;
	end loop;
	if trim(ret_DATA) is null then
		if P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОПРИОБРЕТАТЕЛЬ') then
			ret_DATA := 'Выгодоприобретатели: нет сведений';
		elsif P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОДАТЕЛЬ') then
			ret_DATA := 'Выгододатели: нет сведений';
		end if;
	end if;

	return ret_DATA;--удалим последнюю запятую
end;

-- Получает номер миграционной карты
function migr_card_str (CLIENT_ID in ref [CL_PRIV]) return string(100) is
ans string(100) := null;
begin
	select migr( migr.[CARD_NUM] : CARD_NUM )
	in		CLIENT_ID.[MIGR_CARD]
	where	migr.[DATE_BEG] <= op_dat
			and migr.[DATE_END] >= op_dat
			and rownum = 1
	into ans;
	return ans;
exception
	when NO_DATA_FOUND then
		return null;
end;


function GetAddProps(pOnDate date, pCode string) return string(4000) is
str string(4000);
rec ref [PROPERTIES];
begin
	if client_priv%id is null then
		return null;
	end if;
	pOnDate := trunc(nvl(pOnDate, sysdate));
	begin
		locate rec in client_priv.[ADD_PROP]
			where	rec.[GROUP_PROP].[CODE] = pCode
					and nvl(rec.[DATE_BEG], pOnDate) <= pOnDate
					and nvl(rec.[DATE_END], pOnDate) >= pOnDate;
		str := trim(substr(rec.[STR], 1, str%size));
	exception
		when NO_DATA_FOUND then null;
	end;
	
	return str;
end;


function GetPDLStr(	  p_pdl_ref		ref [IPDL_TYPE]
					, p_pdl_type	::[IPDL_CATEGORY].[PDL_TYPE]%type
					)return varchar2(32000)
is
v_ret GetPDLStr%type;
begin
	select c(analytic(listagg(c.[CATEGORY].[NAME], ','), 'within group (order by [1])', c.[CATEGORY].[NAME]))
	in p_pdl_ref.[CATEGORY_LIST]
	where c.[CATEGORY].[PDL_TYPE] = p_pdl_type or c.[CATEGORY].[PDL_TYPE] is null or p_pdl_type is null
	into v_ret;
	
	return v_ret;
	
end;

function get_date_close(
	p_cl_info [CL_INFO_REQ]
	, p_client ref [CLIENT]
	, p_date_print date
)
return date
is
	v_has_open integer;
	v_close_date date;
	v_close_date_v date;
	v_close_date_r date;
begin
	v_close_date := p_cl_info.[CLOSE_DATE];
	if v_close_date is null then
			
		select acc(max(acc.[DATE_CLOSE]), max(decode(acc.[COM_STATUS], ::[COM_STATUS_PRD]([CODE] = 'CLOSE'), 0, 1)))
			in ::[AC_FIN]
			where acc.[CLIENT_V]=p_client
				and (acc.[COM_STATUS] is null
					or not (
						acc.[COM_STATUS] in (::[COM_STATUS_PRD]([CODE] = 'TO_OPEN'), ::[COM_STATUS_PRD]([CODE] = 'SHIFR'))
						or acc.[COM_STATUS] = ::[COM_STATUS_PRD]([CODE] = 'CLOSE') and acc.[DATE_CLOSE] is null
						)
					)
		into v_close_date_v, v_has_open;
		
		if v_has_open = 1 then
			return null;
		else
			select acc(max(acc.[DATE_CLOSE]), max(decode(acc.[COM_STATUS], ::[COM_STATUS_PRD]([CODE] = 'CLOSE'), 0, 1)))
				in ::[AC_FIN]
				where acc.[CLIENT_R]=p_client
					and (acc.[COM_STATUS] is null
						or not (
							acc.[COM_STATUS] in (::[COM_STATUS_PRD]([CODE] = 'TO_OPEN'), ::[COM_STATUS_PRD]([CODE] = 'SHIFR'))
							or acc.[COM_STATUS] = ::[COM_STATUS_PRD]([CODE] = 'CLOSE') and acc.[DATE_CLOSE] is null
							)
						)
			into v_close_date_r, v_has_open;
			
			if v_has_open = 1 then
				return null;
			else
				if v_close_date_r > v_close_date_v then
					v_close_date := v_close_date_r;
				else
					v_close_date := v_close_date_v;
				end if;
			end if;
		end if;
	end if;
	
	-- дата прекращения отношений клиента не может быть больше даты печати анкеты
	if v_close_date > p_date_print then
		return null;
	end if;
	
	if p_cl_info.[CLOSE_DATE] is null and v_close_date is not null then
		::[CL_INFO_REQ].[LIB].InsertOrUpdateFirstDate(
			p_client
			, null
			, p_cl_info.[FIRST_ACC_DATE]
			, v_close_date
		);
	end if;
	
	return v_close_date;
end;

function GetAddPropVal (p_client ref [CLIENT], p_prop_code varchar2(64), P_DATE_PRINT date) return varchar2(4000)
is

v_temp_str varchar2(4000);

begin
		v_temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
		for dop in p_client.[ADD_PROP]
		 		where Upper(dop.[GROUP_PROP].[CODE])=Upper(p_prop_code) and
				nvl(dop.[DATE_BEG],P_DATE_PRINT)<=P_DATE_PRINT and P_DATE_PRINT<=nvl(dop.[DATE_END],P_DATE_PRINT)
		loop
			v_temp_str := trim(
						iif(dop.[GROUP_PROP].[TYPE_VALUE] is null ,dop.[PROP].[NAME],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='NUMBER',to_char(dop.[NUM],'999G999G999G999G990D0099'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='STRING',dop.[STR],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='DATE'  ,to_char(dop.[V_DATE],fmt),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='BOOL'  ,iif(dop.[BOOL],'Да','Нет'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='REF'   ,::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),'')
						);
		end loop;
						
		return 	v_temp_str;			
end;
PSH_WRD_FIZCLANK (
	@name('Руководитель подразделения')         P_HEADUSER        in [USER_REF],
	@name('Строка для передачи данных')         P_DATA            in [MEMO_32767],
	@name('Дата заполнения анкеты')             P_DATE_ANK        in [DATE],
	@name('Печать анкеты на дату')              P_DATE_PRINT      in [DATE],
	@name('Подразделение')                      P_DEPART          in [DEPART_REF]       default null,
	@name('Подразделение')                      P_DEPART_STR      in [STRING_128]       default null,
	@name('Работа с клиентом в подразделениях') P_WORK_IN_DEPARTS in [CL_INFO_USER_REF] default null,
	@name('Руководитель подразделения')         P_HEADUSER_STR    in [STRING_500]       default null,
	@name('Дата обновления анкеты')             P_DATE_FORM_UPD   in [DATE],
	@name('Документ')                           P_SHABLON         in [SHABLON_DOC_REF],
	@name('Без поднятия формы')                 P_NO_FORM         in [BOOLEAN]          default null,
	@name('Отправить на печать')                P_AUTO_PRINT      in [BOOLEAN]          default null,
	@name('Взаимосвязанные клиенты')            P_LINKS           in [LINKS_CL_REF]     default null,
	@name('Виды взаимосвязей')                  P_CL_LINK         in [CL_LINK_REF]      default null,
	@name('Пакетная печать')                    P_BATCH           in [BOOLEAN]
) is

validate is
temp_str	varchar2(2000) := '';
v_cl_links	[LINKS_CL_ARR];
links_ref	number;

--rClient		ref [CLIENT];

flSpace boolean:=false; --Башкиров В.Г. 28.05.2019 Для кодов типа CL_ANK_PDL_INFO_ (последний символ "_") если значение пустое - выдавать " " вместо "нет"

tmp_str varchar2(2000);

--Башкиров В.Г. 07.04.2023 [ПСБ] Ограничение на вывод числа строк о последних провероках клиента
CntClCheckResult number:=0; 
CntClCheckResultAll number:=90; --Будет делится на 3 т.к. используются три вч.пара ТЕР_РЕЗ/ТЕР_РЕЗ1/ТЕР_РЕЗ2

migr_card1  [MIGRATION_CARD];
migr_card2  [MIGRATION_CARD];
migr_card3  [MIGRATION_CARD];
migr_cnt 	integer;

ac			ref	[AC_FIN];

begin
	if p_message = 'DEFAULT' then
		v_this := this;
		V_LINKS_ID := this.[LINKS_OTHER];
		-- Инициализация переменных		
		op_dat 		:= ::[SYSTEM].[VARIABLES].OpDate;
		rabota 		:= null;
		account 	:= null;
		client_priv	:= null;
		client_corp	:= null;

		V_UPD_ANKETA 	:= false;
		V_LAST_VERSION  := true;
		V_VB			:= null;
		
		var rPropGRP ref [PROPERTY_GRP]; -- Используется в получениии значения из "Противодействие легализации. Список шаблонов сведений" Vorobey 20190605
		
		declare
			cl_ref ref [CLIENT];		    		
	    begin
	    	if client_org_ref is not null then
	    		cl_ref := client_org_ref;
	    	else
	    		cl_ref := this;
	    	end if;
	    	
	    	for a
	    		in ::[AC_FIN]
	    		where a.[CLIENT_V] = cl_ref
	    		order by a.[DATE_OP] asc
	    	loop
	    		account := a;
	    		exit;
	    	end loop;
	    	
	    	-- последний откытый счет
	    	for a
	    		in ::[AC_FIN]
	    		where a.[CLIENT_V] = cl_ref
	    		order by a.[DATE_OP] desc
	    	loop
	    		v_acc_last := a;
	    		exit;
	    	end loop;
	    	

			P_DATE_ANK := cl_ref.[DATE_ANK];
	 	end;
		
		--По умолчанию показываем дату печати - текущую дату.
		P_DATE_PRINT := nvl(P_DATE_PRINT,trunc(sysdate));

		
		if client_org_ref is null then
			V_PRIV_BUSINES := false;
			P_DATE_FORM_UPD = V_DATE_UPD_TO_PRINT := [DATE_FORM_UPD_F];
		else
			V_PRIV_BUSINES := true;
			P_DATE_FORM_UPD = V_DATE_UPD_TO_PRINT := client_org_ref.[DATE_FORM_UPD_F];
--			P_SHABLON := ::[SHABLON_DOC]([CODE] = 'АНК_ИП');
		end if;

		is_auto := 	::[CL_CORP].[EDIT_ANKETA].is_auto_fill_date_upd;	
		if is_auto then
			csmd.Disable(V_VB, 'P_DATE_FORM_UPD');
			csmd.Show(V_VB, 'V_UPD_ANKETA', 'V');
		else
			V_UPD_ANKETA :=  P_DATE_ANK is not null and P_DATE_FORM_UPD is null; -- обновляем
			csmd.Enable(V_VB, 'P_DATE_FORM_UPD');
			csmd.Hide(V_VB, 'V_UPD_ANKETA', 'V');
		end if;

		begin
			P_SHABLON := null;
			locate P_SHABLON in ::[SHABLON_DOC] where P_SHABLON.[CODE] = 'АНК_ФИЗ_ЛИЦ' order by P_SHABLON;
		exception
			when NO_DATA_FOUND then null;
		end;
		
		if nvl(::[FP_TUNE].[LIB].get_bool_value('REG_WORK_IN_DEPARTS', ::[FP_TUNE].[LIB].set_canons('<TYPE_REG_IN_DEPART>', 'WORK_REG')),false) then
			[CSMD].Enable(V_VB, 'P_WORK_IN_DEPARTS');			
			
			executor.set_context( 'CL_INFO_DATE', to_char(nvl(P_DATE_PRINT, sysdate), 'DD/MM/YYYY'));
			declare
				collect_id collection;
			begin
				if client_org_ref is not null then
					select x(x.[CL_WORK_USERS]) in ::[CL_INFO_REQ] where x.[CLIENT] = client_org_ref into collect_id;
				else
					select x(x.[CL_WORK_USERS]) in ::[CL_INFO_REQ] where x.[CLIENT] = this into collect_id;
				end if;
				executor.set_context('CL_INFO_COLLECTION', to_char(collect_id));
			exception when NO_DATA_FOUND then
				executor.set_context('CL_INFO_COLLECTION', null );	
			end;		
		else
			[CSMD].Disable(V_VB, 'P_WORK_IN_DEPARTS');			
		end if;
		
		-- Заполнение подразделения и руководителя подразделения
		P_DEPART 		:= ::[SYSTEM].[VARIABLES].OurDepart;
		P_HEADUSER 		:= ::[CL_CORP].[EDIT_ANKETA].get_chief_user(P_DEPART, 'DEPART_BOSS');
		P_DEPART_STR 	:= P_DEPART.[NAME];
		P_HEADUSER_STR	:= P_HEADUSER.[NAME];
		P_NO_FORM		:= nvl(P_NO_FORM, false);
		P_AUTO_PRINT	:= nvl(P_AUTO_PRINT, false);

	elsif p_message = 'VALIDATE' then
	    
	    debug_pipe('P_INFO ='||P_INFO,0);        
	
	    if p_info = '%PLPCALL%' and nvl(P_NO_FORM, false) then
	        V_VB := V_VB || NL$ || 'Call Form1.ScriptPostEvent(OK,"CLICK")' || NL$;
	    end if;
		
		P_DATA := ' ';
		if p_info = 'P_HEADUSER' then
			if P_HEADUSER is not null then
				--P_HEADUSER_STR := P_HEADUSER.[NAME]|| bool_char(P_HEADUSER.[CASTA].[VALUE] is not null, )
				P_HEADUSER_STR := nvl(::[RUNTIME].[STDLIB].fio(P_HEADUSER.[NAME],'Ф И. О.'), '');
				P_HEADUSER_STR := rtl.bool_char(P_HEADUSER_STR is not null, nvl(P_HEADUSER.[CASTA].[VALUE], '')||' '||P_HEADUSER_STR, '');				
			end if;
		elsif P_INFO = 'P_DEPART' then
			if P_DEPART is not null then
				P_DEPART_STR := P_DEPART.[NAME];
			end if;
		elsif P_INFO = 'P_WORK_IN_DEPARTS' then
			P_HEADUSER_STR := 	P_WORK_IN_DEPARTS.[NAME_CHIEF]||
								bool_char( P_WORK_IN_DEPARTS.[CASTA_CHIEF] is not null, ', ' || P_WORK_IN_DEPARTS.[CASTA_CHIEF], '');
			P_DEPART_STR :=	P_WORK_IN_DEPARTS.[DEPART_NAME]||' '||
							bool_char(P_WORK_IN_DEPARTS.[DEPART_CODE]is not null,'('||P_WORK_IN_DEPARTS.[DEPART_CODE]||')', '');
		elsif P_INFO = 'P_DATE_PRINT' then
			executor.set_context( 'CL_INFO_DATE', to_char(nvl(P_DATE_PRINT, sysdate), 'DD/MM/YYYY'));
			if nvl(P_DATE_PRINT, trunc(sysdate)) <> trunc(sysdate) then
				V_DATE_UPD_TO_PRINT := get_date_upd(this,P_DATE_PRINT);
				V_LAST_VERSION 		:= false;
			else
				V_DATE_UPD_TO_PRINT := P_DATE_FORM_UPD;
			end if;
					
		elsif p_info = 'P_DATE_FORM_UPD' then
			 -- если пользователь сам установил дату или удалил, тогда
			 V_UPD_ANKETA := false;

		elsif p_info = '%VAR%.V_UPD_ANKETA' then
			 -- если пользователь сам установил дату или удалил, тогда
			if V_UPD_ANKETA then
				P_DATE_FORM_UPD := trunc(sysdate);
			else
				P_DATE_FORM_UPD := [DATE_FORM_UPD_F];
			end if;

			if nvl(P_DATE_PRINT, trunc(sysdate)) <> trunc(sysdate) then
			  --V_DATE_UPD_TO_PRINT := get_date_upd(this,P_DATE_PRINT);
			    V_DATE_UPD_TO_PRINT := get_date_upd(this,P_DATE_PRINT);
				V_LAST_VERSION 		:= false;
			else
				V_DATE_UPD_TO_PRINT := P_DATE_FORM_UPD;
			end if;
		elsif p_info = 'P_SHABLON' then
			if P_SHABLON.[CODE] like 'АНК_ФИЗ_ЛИЦ_2025%' then
				P_CL_LINK := ::[CL_LINK]([CODE] = 'КЛИЕНТ');			
				csmd.command(V_VB, '
				if Object3.Top - 480*1.5 <= Label5.Top then
				Combo3.Visible = true
				Combo4.Visible = true
				Combo4.Enabled = false
				
				Object3.Top = Object3.Top + 480
				Text4.Top = Text4.Top + 480
				
				Object5.Top = Object5.Top + 480
				Text3.Top = Text3.Top + 480
				
				Object4.Top = Object4.Top + 480
				
				Object6.Top = Object6.Top + 480
				Text7.Top = Text7.Top + 480
				
				Label1.Top = Label1.Top + 480
				Date1.Top = Date1.Top + 480
				
				Label3.Top = Label3.Top + 480
				date_last_upd.Top = date_last_upd.Top + 480
				
				Label6.Top = Label6.Top + 480
				date_upd_to_print.Top = date_upd_to_print.Top + 480
				
				Label2.Top = Label2.Top + 480
				datePrint.Top = datePrint.Top + 480
				
				save_doc.Top = save_doc.Top + 480
				end if
				');
			else
				csmd.command(V_VB, '
				if Object3.Top - 480*1.5 > Label5.Top then
				Combo3.Visible = false
				Combo4.Visible = false
				
				Object3.Top = Object3.Top - 480
				Text4.Top = Text4.Top - 480
				
				Object5.Top = Object5.Top - 480
				Text3.Top = Text3.Top - 480
				
				Object4.Top = Object4.Top - 480
				
				Object6.Top = Object6.Top - 480
				Text7.Top = Text7.Top - 480
				
				Label1.Top = Label1.Top - 480
				Date1.Top = Date1.Top - 480
				
				Label3.Top = Label3.Top - 480
				date_last_upd.Top = date_last_upd.Top - 480
				
				Label6.Top = Label6.Top - 480
				date_upd_to_print.Top = date_upd_to_print.Top - 480
				
				Label2.Top = Label2.Top - 480
				datePrint.Top = datePrint.Top - 480
				
				save_doc.Top = save_doc.Top - 480
				end if
				');
			end if;
		elsif p_info = 'P_CL_LINK' then
			if P_CL_LINK.[CODE] = 'КЛИЕНТ' then
				P_LINKS := null;
				csmd.command(V_VB, '
				Combo4.Enabled = false
				');
/*			elsif P_CL_LINK.[CODE] in ('ВЫГОДОПРИОБРЕТАТЕЛЬ', 'ПРЕДСТАВИТЕЛЬ', 'БЕНЕФИЦИАР') then
				begin
					select x(x) in V_LINKS_ID
						where x.[VID_LINK] = P_CL_LINK and rownum = 1
						into P_LINKS;
					csmd.command(V_VB, '
					Combo4.Enabled = true
					');
				exception when others then
					P_LINKS := null;
					csmd.command(V_VB, '
					Combo4.Enabled = false
					');
				end;
*/			else
				select x(x) in V_LINKS_ID
						where rownum = 1
						into P_LINKS;
				csmd.command(V_VB, '
				Combo4.Enabled = true
				');
			end if;
		end if;

		if p_info = 'CANCEL' then
			client_org_ref := null;
		elsif p_info = 'OK' then
			V_BEN_STR := '';
			if V_UPD_ANKETA then
				V_MESSAGE := 'Хотите изменить дату обновления на текущую -' ||to_char(sysdate, 'dd/mm/yyyy') || '?';
			end if;

			-- Если дата заполнения анкеты не указана, тогда не печатаем анкету
			if P_DATE_ANK is null then
				pragma error('Укажите дату заполнения анкеты!');
			end if;
			--Если дата печати не заполнена, то печатаем только из текущих значений
			P_DATE_PRINT := nvl(P_DATE_PRINT,trunc(sysdate));
			--P_DATE_FORM_UPD := nvl(P_DATE_FORM_UPD,trunc(SYSDATE)); -- Дата обновления МОЖЕТ быть пустая
			--Получаем структуры клиентов на дату
			--Изменения анкеты, сделанные в дату P_DATE_PRINT, начинают действовать сразу же,
			--т.е. прежние реквизиты будут действительны до (P_DATE_PRINT-1) включительно.
			client_priv := ::[LEGAL_INTERFACE].[PRX_CLIENT].CL_HIST_GET_PRIV(this,P_DATE_PRINT+1);
		
			--name_cl:= nvl(client_priv.[NAME], ''); --but -- Низя так делать!!!!!!
			
			if client_org_ref is not null then
				client_corp := ::[LEGAL_INTERFACE].[PRX_CLIENT].CL_HIST_GET_CORP(client_org_ref, P_DATE_PRINT + 1);
				cl_info := ::[CL_INFO_REQ].[LIB].GetClInfoReq_OnDate(client_org_ref, P_DATE_PRINT + 1);
			else
				cl_info := ::[CL_INFO_REQ].[LIB].GetClInfoReq_OnDate(this, P_DATE_PRINT + 1);
			end if;
			
			if P_CL_LINK.[CODE] in ('ПРЕДСТАВИТЕЛЬ', 'ВЫГОДОПРИОБРЕТАТЕЛЬ', 'БЕНЕФИЦИАР') and P_LINKS.[PARTNER] is not null
				and P_SHABLON.[CODE] = 'АНК_ФИЗ_ЛИЦ_2025' then
				P_SHABLON := ::[SHABLON_DOC]([CODE] = 'АНК_ФИЗ_ЛИЦ_2025_НЕ_КЛ');
			end if;
			
			V_CHECK_VIG	:= P_SHABLON.[CODE];
			P_DATA		:= '';
			
			if V_CHECK_VIG = 'АНК_ПРЕДСТ_ФЛ' then --ПРИНЦИПАЛ BS00299498
				select a(nvl(a.[CLIENT_NAME], a.[PARTNER].[NAME]) : clien_name)
					in client_priv.[LINKS_OTHER]
					where a.[VID_LINK] = ::[CL_LINK]([CODE] = 'ПРИНЦИПАЛ')
					  and (a.[DATE_BEG] is null or a.[DATE_BEG] <= P_DATE_PRINT)
					  and (a.[DATE_END] is null or a.[DATE_END] >= P_DATE_PRINT)
					into principal;
				if principal.count = 0 then
					-- Башкиров В.Г. 0.11.2024
					principal(1):=client_priv.[NAME];
					--pragma error('Данный клиент не является представителем');
				end if;
			end if;	

			/***********************************************************************
				 ПЕЧАТЬ ОТЧЕТОВ О БЕНЕФИЦИАРНЫХ ВЛАДЕЛЬЦАХ ФИЗИЧЕСКОГО ЛИЦА
				 анкета каждого физ.лица печатается в отдельный Word - документ.
				 печать анкет физических лиц являющихся бенефицирами реализуется в другой операции,
				 здесь передается только ссылка на физ.лицо.
			***********************************************************************/
			if V_CHECK_VIG = 'АНК_БЕН_ФЛ' then
				if client_corp%id is not null then
					links_ref := client_corp.[LINKS_OTHER];
					V_NAME := client_corp.[NAME];
				else
					links_ref := client_priv.[LINKS_OTHER];
					V_NAME := client_priv.[NAME];
				end if;
				for
					(select
						c (c.[PARTNER] : cl_priv_id)
						in  ::[LINKS_CL] all
						where c.[VID_LINK] = ::[CL_LINK]([CODE] = 'БЕНЕФИЦИАР')
							and c%collection = links_ref
							and (c.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or c.[DATE_BEG] is null)
							and (c.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or c.[DATE_END] is null)
							and c.[PARTNER] is not null
					)
				loop
					V_BEN_STR := V_BEN_STR||c.cl_priv_id||'#';
				end loop;
				if V_BEN_STR is null then
					pragma error(case when client_corp%id is not null then 'Индивидуальный предприниматель' else 'Физическое лицо' end||' не имеет действующих бенефициаров - клиентов');
				end if;
			end if;
			
		
		----------- Массив миграционных карт 2023-------------------
			migr_cnt := 1;
			for dd in client_priv.[DOC_ARR] where dd.[TYPE].[RESIDENCE_RIGHT] 
					and (dd.[DATE] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or dd.[DATE] is null)
					and (dd.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or dd.[DATE_END] is null)
			loop
			--P_DATA := dd.[TYPE].[NAME]||' '||dd.[SER]||' '||dd.[NUM]||' '||nvl(to_char(dd.[DATE],'dd.mm.yyyy'), '')||' '||dd.[WHO]||' '||dd.[DEPART_CODE]||NL$;
		   		 case migr_cnt of	
					: '1'		: Migr_doc1.vid := dd.[TYPE].[NAME];
								  Migr_doc1.ser	:= dd.[SER];
								  Migr_doc1.num	:= dd.[NUM];
								  Migr_doc1.date_b	:= nvl(to_char(dd.[DATE],'dd.mm.yyyy'), '');
								  Migr_doc1.date_e	:= nvl(to_char(dd.[DATE_END],'dd.mm.yyyy'), '');
							  
					: '2'		: Migr_doc2.vid := dd.[TYPE].[NAME];
								  Migr_doc2.ser	:= dd.[SER];
								  Migr_doc2.num	:= dd.[NUM];
								  Migr_doc2.date_b	:= nvl(to_char(dd.[DATE],'dd.mm.yyyy'), '');
								  Migr_doc2.date_e	:= nvl(to_char(dd.[DATE_END],'dd.mm.yyyy'), '');
							  
					: '3'		: Migr_doc3.vid := dd.[TYPE].[NAME];
								  Migr_doc3.ser	:= dd.[SER];
								  Migr_doc3.num	:= dd.[NUM];
								  Migr_doc3.date_b	:= nvl(to_char(dd.[DATE],'dd.mm.yyyy'), '');
								  Migr_doc3.date_e	:= nvl(to_char(dd.[DATE_END],'dd.mm.yyyy'), '');
				end;
				migr_cnt := migr_cnt+1;
				if migr_cnt = '3' then exit; end if;		
			end loop;			
		
			for migr_card in client_priv.[MIGR_CARD]
			where	nvl(migr_card.[DATE_BEG],P_DATE_PRINT) <= P_DATE_PRINT
				and	nvl(migr_card.[DATE_END],P_DATE_PRINT) >= P_DATE_PRINT
			loop
				if migr_cnt = '3' then exit; end if;
				case migr_cnt of	
					: '1'		: Migr_doc1.vid := 'Миграционная карта';
								  Migr_doc1.ser	:= migr_card.[CARD_SERIA];
								  Migr_doc1.num	:= migr_card.[CARD_NUM];
								  Migr_doc1.date_b	:= nvl(to_char(migr_card.[DATE_BEG],'dd.mm.yyyy'), '');
								  Migr_doc1.date_e	:= nvl(to_char(migr_card.[DATE_END],'dd.mm.yyyy'), '');
							  
					: '2'		: Migr_doc2.vid := 'Миграционная карта';
								  Migr_doc2.ser	:= migr_card.[CARD_SERIA];
								  Migr_doc2.num	:= migr_card.[CARD_NUM];
								  Migr_doc2.date_b	:= nvl(to_char(migr_card.[DATE_BEG],'dd.mm.yyyy'), '');
								  Migr_doc2.date_e	:= nvl(to_char(migr_card.[DATE_END],'dd.mm.yyyy'), '');
							  
					: '3'		: Migr_doc3.vid := 'Миграционная карта';
								  Migr_doc3.ser	:= migr_card.[CARD_SERIA];
								  Migr_doc3.num	:= migr_card.[CARD_NUM];
								  Migr_doc3.date_b	:= nvl(to_char(migr_card.[DATE_BEG],'dd.mm.yyyy'), '');
								  Migr_doc3.date_e	:= nvl(to_char(migr_card.[DATE_END],'dd.mm.yyyy'), '');
				end;
				migr_cnt := migr_cnt+1;
			
				if migr_cnt = '3' then exit; end if;
			end loop;
	----------- конец Массив миграционных карт 2023-------------------			
			
			&debug('[ 1]P_DATA('||Length(P_DATA)||')='||P_DATA,dp3)
		else
			&debug('[ 2]P_DATA('||Length(P_DATA)||')='||P_DATA,dp3)
			
			if p_info = 'REPORTFILE' then
		 		P_DATA := P_SHABLON.[FILE_NAME];--&ReportFile;
	
		 	elsif p_info = 'REPORTPATH' then
		 		--P_DATA := [MSLIB].GetReportPath;
		 		P_DATA := ::[SYSTEM_PARAMS].[GET]('PATH_PRINT_DOC');
			---------------------------------------------------------------------------
			elsif p_info = 'CheckBox1' then   
			   P_DATA := 'НЕТ';
		 	elsif p_info = 'CheckBox3' then   
		 	    P_DATA := 'НЕТ';
		 		/*if client_corp%id is not null then
		 			P_DATA := 'ДА';
		 		else
		 			P_DATA := 'НЕТ';
		 		end if; --*/
		 	elsif p_info = 'КАТЕГОРИЯ' then   --КАТЕГОРИЯ
		 		if client_corp%id is not null then
		 			P_DATA := 'индивидуального предпринимателя';
		 		else
		 			P_DATA := 'физического лица';
		 		end if;

		 	elsif p_info like 'НАИМ_КЛИЕНТА%' then P_DATA := nvl(client_priv.[NAME], '');
		 	elsif p_info like 'ИМЯ_КЛИЕНТА%' then P_DATA := nvl(client_priv.[NAME_CL], '');
		 	elsif p_info like 'ФАМИЛИЯ_КЛИЕНТА%' then P_DATA := nvl(client_priv.[FAMILY_CL], '');
		 	elsif p_info like 'ОТЧЕСТВО_КЛИЕНТА%' then P_DATA := nvl(client_priv.[SNAME_CL], '');
		
		 	elsif p_info = 'ДАТА_РОЖД' then      --ДАТА_РОЖД
		 		P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(client_priv.[DATE_PERS]), '');
		 		
			elsif p_info = 'МЕСТО_РОЖД' then     --МЕСТО_РОЖД
			
				temp_str := client_priv.[DOC].[BIRTH_PLACE];
				if temp_str is not null then -- BFS00023043 теперь есть реквизит
			 	P_DATA := temp_str;
				else
					temp_str := nvl(client_priv.[BORN].[COUNTRY].[VALUE], '');
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, temp_str||', ');
					
					temp_str := nvl(client_priv.[BORN].[OKATO].[NAME], '');
					P_DATA := P_DATA||rtl.bool_char(temp_str is null, null, temp_str||', ');
			
					P_DATA := P_DATA||nvl(client_priv.[BORN].[KIND].[SHORT_NAME]||' '||client_priv.[BORN].[NAME], ', ');
	
					P_DATA := substr(rtrim(ltrim(P_DATA)),1,length(P_DATA)-1);
			 	end if;
	
			elsif p_info = 'ГРАЖД' then          --ГРАЖДАНСТВО
				P_DATA := COALESCE(client_corp.[COUNTRY].[NAME],client_priv.[COUNTRY].[NAME],'Лицо без гражданства');
				
			elsif p_info = 'ДОКУМЕНТ' then       --ДОКУМЕНТ, удостоверяющий личность
				P_DATA := nvl(Get_passport(client_priv), '');
			elsif p_info = 'ДОКУМЕНТ_ВИД' then      
				P_DATA := nvl(client_priv.[DOC].[TYPE].[NAME], '');
			elsif p_info = 'ДОКУМЕНТ_СЕРИЯ' then      
				P_DATA := nvl(client_priv.[DOC].[SER], '');
			elsif p_info = 'ДОКУМЕНТ_НОМЕР' then      
				P_DATA := nvl(client_priv.[DOC].[NUM], '');
			elsif p_info = 'ДОКУМЕНТ_Д_ВЫДАЧИ' then      
				P_DATA := nvl(to_char(client_priv.[DOC].[DATE],'dd.mm.yyyy'), '');
			elsif p_info = 'ДОКУМЕНТ_ВЫДАН' then      
				P_DATA := nvl(client_priv.[DOC].[WHO], '');
			elsif p_info = 'ДОКУМЕНТ_КОД_ПОДР' then      
				P_DATA := nvl(client_priv.[DOC].[DEPART_CODE], '');
			elsif p_info = 'ВИЗА' then            --ВИЗА
				P_DATA := Get_Visa(client_priv,P_DATE_PRINT);

			elsif p_info = 'СНИЛС' then            --СНИЛС
				P_DATA := Get_SNILS(client_priv,P_DATE_PRINT);
			elsif p_info = 'СНИЛС_ФОРМАТ' then     --СНИЛС - форматированный
				P_DATA := regexp_replace(client_priv.[SNILS], '(.{3})(.{3})(.{3})(.{2})', '\1-\2-\3 \4');
			elsif p_info = 'МИГР_КАРТА' then            --МИГР_КАРТА
				P_DATA := Get_Migration_Card(client_priv, P_DATE_PRINT);									
--Доп. удостоверения
			elsif p_info = 'ДОП_ДОК_ВИД' then
				for (select x(x.[TYPE].[NAME] : cert_type)
