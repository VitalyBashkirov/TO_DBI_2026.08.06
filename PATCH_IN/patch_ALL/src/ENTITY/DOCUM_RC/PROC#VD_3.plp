procedure clear_blob is
begin
	if mx_blob is not null then
		if dbms_lob.istemporary(mx_blob)=1 then
			dbms_lob.freetemporary(mx_blob);
		else
			mx_blob := null;
		end if;
	end if;
end;

procedure init_blob(p_blob blob := null) is
begin
	clear_blob;
	if p_blob is not null then
		mx_blob := p_blob;
	else
		dbms_lob.createtemporary(mx_blob,false,dbms_lob.session);
	end if;
end;

