class HOOK_BANK;

@import_plsql(true)
@this(create_on_start:=true)
@name('Карты. Расчет для открытия счетов')
@tag('COPIED')
static method DEPN_ACC_OPEN is
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma MACRO (LGW, '::[CL_PRIV].[PSB_EDIT_SEX]');
pragma MACRO (ARC, '::[PSH_FTC].[PSH_ADD_REF_CL]'); -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25 -- updated CHANGE_SHORT_NAME ADD_REF_CLIENT->PSH_ADD_REF_CL 15/10/25

dp	integer:=0;	--управление &debug
dp2	integer:=0;
dp3	integer:=0;
dp5	integer:=null;

fmt string:='dd/mm/yyyy';
fmt24 string:='dd/mm/yyyy hh24:mi:ss';

procedure MsgLogPragma(msgBs string(1000), pf ref [PSH_FTC]) is -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25
msg string(1000);
begin
	msg:='Клиент в справочнике "[ПСБ] Перечень должников ФТС"'||LF$||'ID:'||pf%id||' '||pf.[F_NAME]||' '||to_char(pf.[DATE_IN],fmt24)||LF$||'ИНН участника ВЭД:'||pf.[FTC_INN]||' Наименование участника ВЭД:'||pf.[FTC_NAME];
	&debug(msg,dp)
	::[CL_PRIV].[PSH_DATE_DEATH].UniLog(
		Substr(msgBs||' '||msg,1,350),Rpad('FTC_Check',10),			--тема
				'_'||&METHOD$SNAME||'.log');	--log
	pragma error(msgBs||LF$||msg);
end;

--Башкиров В.Г. 06.06.2019 Проверка Клиента по "[ПСБ] Перечень должников ФТС" при открытии счета
--из настройки FTC_BS - [ПСБ] ФТС Перечень счетов для запрета на открытие (405;406;407;40802;40807;40821;423;426;40817;40820 и др.)
public procedure FTC_Check(AcNum [ACCNUM], P_CLIENT ref [CLIENT], P_DATE [DATE_TIME] default [SYSTEM].[OP_DATE]) is 
--P_CLIENT ref [CLIENT];
 BS_TUNE string(1000);
 BS_ONE string(100);
 nnn number;
 ppp number;
 spr char:=';';
 FTC_ON boolean;
 flSeek boolean:=false;
 ClOrgRef ref [CL_ORG];
 ClPrivRef ref [CL_PRIV];
 ClBankN ref [CL_BANK_N];
 ClBankF ref [CL_BANK_F];
 vName [STRING_300]; --[NAME];
 vInn [STRING_12];
 msgBs string(1000);
 --msg string(1000);
 PrefIP string(200);
begin
	FTC_ON	:=nvl([FP_TUNE]::[LIB].get_bool_value('FTC_ON',null,throw_error==0),false);
	&debug('.FTC_Check -- [ПСБ] ФТС Включить проверку по Переченю ФТС:'||FTC_ON,dp)
	if FTC_ON then null;
	else
		&debug('.FTC_Check -- Ничего не делаем. Проверка по Переченю ФТС отключена',dp)
		return;
	end if;	

	if AcNum is null then
		&debug('.FTC_Check -- Ничего не делаем. Номер БС пуст',dp)
		return;
	end if;	

	if P_CLIENT is null then --ClPrivRef is null then
		&debug('.FTC_Check -- Ничего не делаем. Клиент не определен',dp)	
		return;
	end if;
	
  --P_CLIENT:=coalesce(P_CLIENT_R,P_CLIENT_V,P_THIS.[CLIENT]);
  --if P_CLIENT is not null and P_CLIENT=P_BSV.[FILIAL].[BANK] then
  	if P_CLIENT is not null and P_CLIENT=[SYSTEM].[SYS_MY_COMPANY] then
		&debug('.FTC_Check -- Ничего не делаем. Клиент - наш Банк:'||P_CLIENT.[NAME],dp)	
		return;
	end if;
	
	if P_CLIENT%class='CL_ORG' then ClOrgRef:=P_CLIENT%id;
		if ::[RKO_INTERFACE].[PRX_CLIENT].isClientCHP(ClOrgRef) then
			ClPrivRef:=::[RKO_INTERFACE].[PRX_CLIENT].getCHPclPriv(ClOrgRef);
			if ClPrivRef is not null then
				&debug('.FTC_Check -- Клиент - ИПшник:'||ClPrivRef.[NAME],dp)
			else
				&debug('.FTC_Check -- У ИП-шно Организации нет Должностного лица! Будем искать по ИНН/Наименованию Организации', dp)
				if nvl([FP_TUNE]::[LIB].get_bool_value('IP_BOSS_ON',null,throw_error==0),true) then
			  		pragma error('У ИП-шной Организации нет Должностного лица!');
				else
					stdio.put_line_buf('У ИП-шной Организации нет Должностного лица!');
				end if;
			end if;
		end if;
		vInn :=nvl(ClOrgRef.[INN],ClOrgRef.[KIO]);
		vName:=ClOrgRef.[NAME];
		&debug('.FTC_Check -- Клиент - Организация '||'ИНН/КИО:'||vInn||' '||vName,dp)
	elsif P_CLIENT%class='CL_PRIV' then ClPrivRef:=P_CLIENT%id;
		vInn :=ClPrivRef.[INN];
		vName:=ClPrivRef.[NAME];
		&debug('.FTC_Check -- Клиент - ФЛ '||'ИНН:'||vInn||' '||vName,dp)	
	
	--Башкиров В.Г. 07.06.2019 Проверка всех Клиентов на ФТС, а не только ИП-шников
	elsif P_CLIENT%class='CL_BANK_N' then ClBankN:=P_CLIENT%id;
		vInn :=nvl(ClBankN.[INN],ClBankN.[KIO]);
		vName:=ClBankN.[NAME];
		&debug('.FTC_Check -- Клиент - Нац.Банк '||'ИНН/КИО:'||vInn||' '||vName,dp)
	elsif P_CLIENT%class='CL_BANK_F' then ClBankF:=P_CLIENT%id;
		vInn :=nvl(ClBankF.[INN],ClBankF.[KIO]);
		vName:=ClBankF.[NAME];
		&debug('.FTC_Check -- Клиент - Участник SWIFT '||'ИНН/КИО:'||vInn||' '||vName,dp)
	end if;
	
	if vInn is null and vName is null then --ClPrivRef is null then
		&debug('.FTC_Check -- Ничего не делаем. ИНН и Наименование/ФИО Клиента не определены',dp)	
		return;
	end if;

	BS_TUNE	:=trim([FP_TUNE]::[LIB].get_str_value('FTC_BS',null,throw_error==0),';');
	&debug('.FTC_Check -- [ПСБ] ФТС Перечень счетов для запрета на открытие:'||BS_TUNE,dp)
	
	nnn:=nvl(Length(BS_TUNE),0)-nvl(Length(Replace(BS_TUNE,spr)),0)+1;
  --P_DATE:=nvl(P_DATE,sysdate);
	P_DATE:=coalesce(P_DATE,[SYSTEM].[OP_DATE],sysdate);
	for i in 1..nnn loop
		BS_ONE:=::[CL_PRIV].[PSH_DATE_DEATH].wbn(BS_TUNE,spr,i)||'%';
		&debug('.FTC_Check -- Сравниваем AcNum='||AcNum||' и BS_ONE='||BS_ONE,dp)
		if AcNum like BS_ONE then
			&debug('.FTC_Check -- Найден "'||BS_ONE||'" Будем искать среди Действующих по Перечню ФТС на дату >= '||to_char(P_DATE,fmt24) ,dp)
			msgBs:='Клиенту нельзя открывать счет "'||BS_ONE||'"';
			flSeek:=true;
			exit;
		end if;
	end loop;
	
	if flSeek then
		&debug('.FTC_Check -- Ищем по ссылке на Клиента АБС '||P_CLIENT%class||'.'||P_CLIENT%id||' на дату >= '||to_char(P_DATE,fmt24),dp)
		for pf in ::[PSH_FTC] -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25
	  --where pf.[WORK] and trunc(pf.[DATE_IN])>=P_DATE and pf.[FTC_CLIENT]=P_CLIENT
		where pf.[WORK] and pf.[FTC_CLIENT]=P_CLIENT
		order by pf.[DATE_IN] desc
		loop MsgLogPragma(msgBs,pf);
		end loop;

		if vInn is not null then
			&debug('.FTC_Check -- Ищем по ИНН "'||vInn||'" за дату >= '||to_char(P_DATE,fmt24),dp)
			for pf in ::[PSH_FTC] where pf.[WORK] and pf.[FTC_INN]=vInn -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25
			order by pf.[DATE_IN] desc
			loop MsgLogPragma(msgBs,pf);
			end loop;
		end if;

		if vName is not null then
			
			var vNameUpper [STRING_300];
			vNameUpper:=Upper(vName);
			if vNameUpper=&ARC.TransPref(vNameUpper,&ARC.DelPref,dp5) then
			   vNameUpper:='ИП '||vNameUpper; &debug('.FTC_Check -- --- Добавим "ИП " ---',dp)
			end if;
		
			&debug('.FTC_Check -- Ищем по "'||vNameUpper||'" за дату >= '||to_char(P_DATE,fmt24),dp)
			for pf in ::[PSH_FTC] where pf.[WORK] and Upper(pf.[FTC_NAME])=vNameUpper -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25
													--Upper(cl.[NAME])    =vNameUpper)
			order by pf.[DATE_IN] desc
			loop MsgLogPragma(msgBs,pf);
			end loop;

			var vNameOnlyChar [STRING_300];
			vNameOnlyChar:=Replace(vNameUpper,' ');
			if vNameOnlyChar is not null and vNameOnlyChar not in (vNameUpper) then
				&debug('.FTC_Check -- Ищем по "'||vNameOnlyChar||'" за дату >= '||to_char(P_DATE,fmt24),dp)
				for pf in ::[PSH_FTC] where pf.[WORK] and Replace(Upper(pf.[FTC_NAME]),' ')=vNameOnlyChar -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25
														--Replace(Upper(cl.[NAME]),' ')	   =vNameOnlyChar)
				order by pf.[DATE_IN] desc
				loop MsgLogPragma(msgBs,pf);
				end loop;
			end if;
			
			var vNameOnlyLitter [STRING_300];
			vNameOnlyLitter:=&ARC.Trans(vNameOnlyChar,&ARC.DelChar);
			if vNameOnlyLitter is not null and vNameOnlyLitter not in (vNameUpper, vNameOnlyChar) then
				&debug('.FTC_Check -- Ищем по "'||vNameOnlyChar||'" за дату >= '||to_char(P_DATE,fmt24),dp)
				for pf in ::[PSH_FTC] where pf.[WORK] and &ARC.Trans( Replace(Upper(pf.[FTC_NAME]),' '), &ARC.DelChar)=vNameOnlyLitter -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25
														--&ARC.Trans( Replace(Upper(cl.[NAME]),' '), 	 &ARC.DelChar)=vNameOnlyLitter)
				order by pf.[DATE_IN] desc
				loop MsgLogPragma(msgBs,pf);
				end loop;
			end if;

			var vNameOnlyName[STRING_300];
			vNameOnlyName:=&ARC.Trans(&ARC.TransPref(vNameUpper,&ARC.DelPref,dp),&ARC.DelChar);
			if vNameOnlyName is not null and vNameOnlyName not in (vNameUpper, vNameOnlyChar, vNameOnlyLitter) then
				&debug('.FTC_Check -- Ищем по "'||vNameOnlyName||'" за дату >= '||to_char(P_DATE,fmt24),dp)
				for pf in ::[PSH_FTC] where pf.[WORK] and &ARC.Trans(&ARC.TransPref(Upper(pf.[FTC_NAME]),&ARC.DelPref),&ARC.DelChar)=vNameOnlyName -- updated CHANGE_QUALIFIER PSB_FTC->PSH_FTC 08/10/25
														--&ARC.Trans(&ARC.TransPref(Upper(cl.[NAME]),	 &ARC.DelPref),&ARC.DelChar)=vNameOnlyName)
				order by pf.[DATE_IN] desc
				loop MsgLogPragma(msgBs,pf);
				end loop;
			end if;
		end if;
	end if;
	&debug('.FTC_Check -- Проверка по "[ПСБ] Перечень должников ФТС" пройдена',dp)
end;

/*by smith 04/12/24 via http://jira.bank.local:8080/browse/CFT-22*/
public procedure Fincert_Check(P_CLIENT ref [CLIENT], P_DATE [DATE_TIME] default [SYSTEM].[OP_DATE]) is 
 ClPrivRef ref [CL_PRIV];
 ClOrgRef ref  [CL_ORG];
 ClBankN ref [CL_BANK_N]; 
 message_text string(10000); 
begin
  	if P_CLIENT is not null and P_CLIENT=::[SYSTEM].[VARIABLES].OurBank then
		return;
	end if;    
	if P_CLIENT%class='CL_ORG' then
	    ClOrgRef:=P_CLIENT%id;
	elsif P_CLIENT%class='CL_PRIV' then 
	    ClPrivRef:=P_CLIENT%id;
	end if;
    for(	
		select x(
                        case
	                        when x.[INN] is not null then 'ИНН'
	                        when x.[NAME] is not null then 'Электронный кошелек + эмитент'
	                        else 
		                        case x.[DOP_VAL].[TYPE_CODE] 
			                    when 'NCL_PASSP_HASH' then 'Хэш паспорта'
			                    when 'NCL_ACCOUNT_NUMBER' then 'Бик + лицевой счет'
			                    when 'NCL_CARD_NUMBER' then 'Номер карты'
			                    when 'NCL_PHONE_NUMBER' then 'Номер телефона'
			                    when 'NCL_SNILS_HASHES' then 'Хэш СНИЛС'
			                    when 'NCL_SWIFT_CODE' then 'SWIFT код + SWIFT счет'
			                    when 'NCL_FASTPAY' then 'Номер телефона в СБП'
			                    else 'Неизвестный тип'
		                        end
	                    end:c_type,  
	                    x.[LISTS].[LIST_CODE]:c_list_code,
						case when P_CLIENT%class='CL_PRIV' and instr(lower(::[NOCONSENT_LIST].[PSH_LIB].get_docs_hash(ClPrivRef)),lower(x.[DOP_VAL].[VAL])) > 0 then x.[DOP_VAL].[VAL] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
                             when P_CLIENT%class='CL_PRIV' and instr(lower(::[NOCONSENT_LIST].[PSH_LIB].get_docs_hash(ClPrivRef)),lower(x.[DOP_VAL].[VAL])) > 0 then x.[DOP_VAL].[VAL_ORIG] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
                             else null
                        end:c_doc_cl_ch,
	                    case when P_CLIENT%class='CL_PRIV' and lower(::[NOCONSENT_LIST].[PSH_LIB].get_hash(regexp_replace(ClPrivRef.[SNILS],'*[^[[:digit:]]]*'))) = lower(x.[DOP_VAL].[VAL]) then lower(x.[DOP_VAL].[VAL]) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
	                         when P_CLIENT%class='CL_PRIV' and lower(::[NOCONSENT_LIST].[PSH_LIB].get_hash(regexp_replace(ClPrivRef.[SNILS],'*[^[[:digit:]]]*'))) = lower(x.[DOP_VAL].[VAL_ORIG]) then lower(x.[DOP_VAL].[VAL_ORIG]) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
	                         else null
	                    end:c_snils_hash_cl_ch,
	                    case when P_CLIENT%class='CL_PRIV' and ClPrivRef.[INN] = x.[INN] then x.[INN]
                             when P_CLIENT%class='CL_ORG' and ClOrgRef.[INN] = x.[INN] then x.[INN]	                    
                             else null
                        end:c_inn_cl_ch,
						case when P_CLIENT%class='CL_PRIV' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClPrivRef),replace(replace(replace(x.[DOP_VAL].[VAL], '-', ''), ' ', ''), '+', '')) > 0 then x.[DOP_VAL].[VAL] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     when P_CLIENT%class='CL_PRIV' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClPrivRef),replace(replace(replace(x.[DOP_VAL].[VAL_ORIG], '-', ''), ' ', ''), '+','')) > 0 then x.[DOP_VAL].[VAL_ORIG] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     when P_CLIENT%class='CL_ORG' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClOrgRef),replace(replace(replace(x.[DOP_VAL].[VAL], '-', ''), ' ', ''), '+', '')) > 0 then x.[DOP_VAL].[VAL] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     when P_CLIENT%class='CL_ORG' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClOrgRef),replace(replace(replace(x.[DOP_VAL].[VAL_ORIG], '-', ''), ' ', ''), '+','')) > 0 then x.[DOP_VAL].[VAL_ORIG] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     else null
						end:c_tel_cl_ch,
						case when P_CLIENT%class='CL_PRIV' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_accbiks(ClPrivRef),x.[DOP_VAL].[VAL]) > 0 then x.[DOP_VAL].[VAL] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     when P_CLIENT%class='CL_PRIV' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClPrivRef),x.[DOP_VAL].[VAL_ORIG]) > 0 then x.[DOP_VAL].[VAL_ORIG] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     when P_CLIENT%class='CL_ORG' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClOrgRef),x.[DOP_VAL].[VAL]) > 0 then x.[DOP_VAL].[VAL] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     when P_CLIENT%class='CL_ORG' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClOrgRef),x.[DOP_VAL].[VAL_ORIG]) > 0 then x.[DOP_VAL].[VAL_ORIG] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     else null
						end:c_accbiks_cl_ch,
						case when P_CLIENT%class='CL_PRIV' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_cards(ClPrivRef), x.[DOP_VAL].[VAL]) > 0 then x.[DOP_VAL].[VAL] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     when P_CLIENT%class='CL_PRIV' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_cards(ClPrivRef), x.[DOP_VAL].[VAL_ORIG]) > 0 then x.[DOP_VAL].[VAL_ORIG] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     when P_CLIENT%class='CL_ORG' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClOrgRef),x.[DOP_VAL].[VAL]) > 0 then x.[DOP_VAL].[VAL] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     when P_CLIENT%class='CL_ORG' and instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClOrgRef),x.[DOP_VAL].[VAL_ORIG]) > 0 then x.[DOP_VAL].[VAL_ORIG] -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     else null
						end c_card_cl_ch
		         )
	    in ::[NOCONSENT_LIST]
		where x.[TYPE_CHECK].[CODE]='NOCONSENT_LIST'
        and x.[MODE_USE].[CODE]='CONTROL'
        and x.[LISTS].[DATE_START]<=P_DATE
        and P_DATE<coalesce(x.[LISTS].[DATE_END],to_date('31.12.9999','dd.mm.yyyy'))
		and (
		     (
		        P_CLIENT%class='CL_PRIV'
		        and (
					    (x.[DOP_VAL].[TYPE_CODE]='NCL_PASSP_HASH'
					    and (
						    	(x.[DOP_VAL].[VAL] is not null and instr(lower(::[NOCONSENT_LIST].[PSH_LIB].get_docs_hash(ClPrivRef)),lower(x.[DOP_VAL].[VAL])) > 0) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						    	or(x.[DOP_VAL].[VAL_ORIG] is not null and instr(lower(::[NOCONSENT_LIST].[PSH_LIB].get_docs_hash(ClPrivRef)),lower(x.[DOP_VAL].[VAL_ORIG])) > 0) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     )
					     )
						or (x.[DOP_VAL].[TYPE_CODE] = 'NCL_SNILS_HASHES' 
							and (
						    	(x.[DOP_VAL].[VAL] is not null and lower(::[NOCONSENT_LIST].[PSH_LIB].get_hash(regexp_replace(ClPrivRef.[SNILS],'*[^[[:digit:]]]*')))=lower(x.[DOP_VAL].[VAL])) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						    	or(x.[DOP_VAL].[VAL_ORIG] is not null and lower(::[NOCONSENT_LIST].[PSH_LIB].get_hash(regexp_replace(ClPrivRef.[SNILS],'*[^[[:digit:]]]*')))=lower(x.[DOP_VAL].[VAL_ORIG])) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
								)
							)
												     
		             )
		      )
		     or ( 
		         (P_CLIENT%class='CL_PRIV' or P_CLIENT%class='CL_ORG')
		         and (
    					(x.[INN] is not null and ((P_CLIENT%class='CL_PRIV' and ClPrivRef.[INN] = x.[INN]) or (P_CLIENT%class='CL_ORG' and ClOrgRef.[INN] = x.[INN])))
					    or (
		    				(x.[DOP_VAL].[TYPE_CODE] = 'NCL_PHONE_NUMBER' or x.[DOP_VAL].[TYPE_CODE] = 'NCL_FASTPAY')
				    		and (
						     	 (
                                  P_CLIENT%class='CL_PRIV'
                                  and (instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClPrivRef),replace(replace(replace(x.[DOP_VAL].[VAL], '-', ''), ' ', ''), '+', '')) > 0 or instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClPrivRef),replace(replace(replace(x.[DOP_VAL].[VAL_ORIG], '-', ''), ' ', ''), '+','')) > 0) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     	 )
						     	 or(
                                    P_CLIENT%class='CL_ORG' 
                                    and (instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClOrgRef),replace(replace(replace(x.[DOP_VAL].[VAL], '-', ''), ' ', ''), '+', '')) > 0 or instr(::[NOCONSENT_LIST].[PSH_LIB].get_tels(ClOrgRef),replace(replace(replace(x.[DOP_VAL].[VAL_ORIG], '-', ''), ' ', ''), '+','')) > 0) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     	    )
				    		     )
					        )
					    or (
		    				x.[DOP_VAL].[TYPE_CODE] = 'NCL_CARD_NUMBER'
				    		and (
						     	 (
                                  P_CLIENT%class='CL_PRIV'
                                  and (instr(::[NOCONSENT_LIST].[PSH_LIB].get_cards(ClPrivRef),x.[DOP_VAL].[VAL]) > 0 or instr(::[NOCONSENT_LIST].[PSH_LIB].get_cards(ClPrivRef),x.[DOP_VAL].[VAL_ORIG]) > 0) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     	 )
						     	 or(
                                    P_CLIENT%class='CL_ORG' 
                                    and (instr(::[NOCONSENT_LIST].[PSH_LIB].get_cards(ClOrgRef),x.[DOP_VAL].[VAL]) > 0 or instr(::[NOCONSENT_LIST].[PSH_LIB].get_cards(ClOrgRef),x.[DOP_VAL].[VAL_ORIG]) > 0) -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 15/10/25
						     	    )
				    		     )
					        )
		              )
		         )
		     )
        order by decode(x.[LISTS].[LIST_CODE],'NOCONSENT_LIST_MVD',0,1)
        ) loop
        message_text:='Внимание! ';
        if x.c_doc_cl_ch is not null then
            message_text:=message_text||' хэш паспорта клиента - '||ClPrivRef.[NAME];
        elsif x.c_snils_hash_cl_ch is not null then
            message_text:=message_text||' хэш СНИЛС клиента - '||ClPrivRef.[NAME];
        elsif x.c_inn_cl_ch is not null and P_CLIENT%class='CL_PRIV' then
            message_text:=message_text||' ИНН клиента - '||ClPrivRef.[NAME];
        elsif x.c_inn_cl_ch is not null and P_CLIENT%class='CL_ORG' then
            message_text:=message_text||' ИНН клиента - '||ClOrgRef.[NAME];
        elsif x.c_tel_cl_ch is not null and P_CLIENT%class='CL_PRIV' then
            message_text:=message_text||' номер телефона клиента - '||ClPrivRef.[NAME];
        elsif x.c_tel_cl_ch is not null and P_CLIENT%class='CL_ORG' then
            message_text:=message_text||' номер телефона клиента - '||ClOrgRef.[NAME];
        elsif x.c_card_cl_ch is not null and P_CLIENT%class='CL_PRIV' then
            message_text:=message_text||' номер карты клиента - '||ClPrivRef.[NAME];
        elsif x.c_card_cl_ch is not null and P_CLIENT%class='CL_ORG' then
            message_text:=message_text||' номер карты клиента - '||ClOrgRef.[NAME];
        end if;
        if x.c_list_code = 'NOCONSENT_LIST_MVD' then
            message_text:=message_text||' находится в списке фидов МВД!';
	        pragma error(message_text);        
        else
            message_text:=message_text||' находится в списке фидов Fincert!';
	        stdio.put_line_buf(message_text);
        end if;
    end loop;
end;
DEPN_ACC_OPEN (
	@name('Ссылка на договор')     P_THIS     in  [DEPN_REF],
	@name('На дату')               P_DATE     in  [DATE],
	@name('Для балансового')       P_BSV      in  [PL_USV_REF],
	@name('Для реквизита')         P_REQ_NAME in  [STRING_16],
	@name('Клиент владелец счета') P_CLIENT_V out [CLIENT_REF],
	@name('Клиент для расчетов')   P_CLIENT_R out [CLIENT_REF],
	@name('Доп. параметры')        P_ADDS     out [STRING_32000],
	@name('Наименование счета')    P_ACC_NAME out [STRING_32000]
) return [MEMO_BIG] is

execute is
Begin
	&debug(LF$||utils.call_stack, dp)
	&debug('Ссылка на договор    :'||P_THIS%class||'.'||P_THIS%id||' '||P_THIS.[CLIENT]%class||'.'||P_THIS.[CLIENT].[NAME],dp)
	&debug('Дата открытия        :'||to_char(P_DATE,fmt),dp)
	&debug('Балансовый счёт      :'||P_BSV.[NUM]||' '||P_BSV.[FINTOOL].[CUR_SHORT],dp)
	&debug('Реквизит             :'||P_REQ_NAME,dp)
	&debug('Клиент владелец счёта:'||P_CLIENT_V%class||'.'||P_CLIENT_V.[NAME],dp)
	&debug('Клиент для расчетов  :'||P_CLIENT_R%class||'.'||P_CLIENT_R.[NAME],dp)
	&debug('Доп. параметры       :'||P_ADDS,dp)
	&debug('Наименование счета   :'||P_ACC_NAME,dp)
	
 	--Башкиров В.Г. 06.06.2019 Проверка Клиента по "[ПСБ] Перечень должников ФТС" при открытии счета
	--из настройки FTC_BS - [ПСБ] ФТС Перечень счетов для запрета на открытие (405;406;407;40802;40807;40821;423;426;40817;40820 и др.)
 	::[HOOK_BANK].[DEPN_ACC_OPEN].FTC_Check(P_BSV.[NUM], coalesce(P_CLIENT_R,P_CLIENT_V,P_THIS.[CLIENT]), P_DATE);

    /*by smith 04/12/24 via http://jira.bank.local:8080/browse/CFT-22*/ 	
--	stdio.put_line_buf('1');        
 	::[HOOK_BANK].[DEPN_ACC_OPEN].Fincert_Check(coalesce(P_CLIENT_R,P_CLIENT_V,P_THIS.[CLIENT]), P_DATE);
	return null;
End;
end;
end;
