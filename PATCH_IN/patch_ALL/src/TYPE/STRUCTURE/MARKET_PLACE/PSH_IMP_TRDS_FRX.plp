class MARKET_PLACE;

@calculate(false)
@optimize(false)
@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] FOREX Импорт сделок в формате ММВБ')
@tag('COPIED')
method PSH_IMP_TRDS_FRX is
dp integer:=0; --управление debug_pipe

pragma include(::[RUNTIME].[MACRO_LIB]);

PrevFile		string(70);			-- Предыдущее имя файла
f_name_log		string(50);
ServerDir		string(250);
g#file			integer;			-- used for file i/o
g#file_log		integer;			-- used for file i/o

is_4611			boolean:=::[FP_TUNE].[LIB].get_date_value('BEGIN_4611U') <= [SYSTEM].[VARIABLES].OpDate;
-------------------------------------------------------------------------------------------------------------------
procedure mess2pipe(mess string) is
begin
	debug_pipe(mess, 0);
	stdio.put_line(g#file_log, replace(mess, chr(10), chr(13) || chr(10)) || chr(13), true, null, stdio.WINTEXT); -- вывод в файл протокола
end;

-------------------------------------------------------------------------------------------------------------------
procedure close_and_err(msg string) is
begin
	mess2pipe(msg);
	stdio.close(g#file);
	stdio.close(g#file_log);
	
	pragma error (msg);
end;

--======================= Операция проверяет есть ли конверсионная операция ==========================================================================================================
public function check_sale(rec [MT_TRADE_BUF], v_client ref [CLIENT], v_cur_in [CUR_SALE], v_cur_out [CUR_SALE], v_pay_to_deal ref [SALE_PAY_TO_DEAL], p_market ref [MARKET_PLACE]) return ref [SALE] is 
	v_tmp_sale	ref [SALE];
begin
	locate v_tmp_sale
		in ::[SALE]
		where v_tmp_sale.[EXCHANGE] = p_market
		  and v_tmp_sale.[NUMBER] = rec.[NUM]
		  and v_tmp_sale.[VID_OPER] = v_pay_to_deal.[DEAL]
		  and v_tmp_sale.[DATE] >= trunc(rec.[D])
		  and v_tmp_sale.[DATE] < trunc(rec.[D]) + 1
		  and v_tmp_sale.[INPUT].[CURRENCY] = v_cur_in.[CURRENCY]
		  and v_tmp_sale.[INPUT].[AMOUNT] = v_cur_in.[AMOUNT]
		  and v_tmp_sale.[OUTPUT].[CURRENCY] = v_cur_out.[CURRENCY]
		  and v_tmp_sale.[OUTPUT].[AMOUNT] = v_cur_out.[AMOUNT]
		  and nvl(v_tmp_sale.[CLIENT]%id, 0) = nvl(v_client%id, 0);
	return v_tmp_sale;
exception when NO_DATA_FOUND then
	return null;
end;

--======================Процедура создаёт новый экземпляр в конверсионных операциях, при этом вызываются дополнительные функции=====================================================================================================
public function new_sale(rec [MT_TRADE_BUF]
				, v_client ref [CLIENT]
				, v_cur_in [CUR_SALE]
				, v_cur_out [CUR_SALE]
				, v_deal_type string(3)
				, v_oper_type ref [TYPE_SALE]
				, v_pay_to_deal ref [SALE_PAY_TO_DEAL]
				, section_ref ref [MT_SECTIONS]
				, p_market ref [MARKET_PLACE]
				, p_set_pfi_swap boolean default False
				) return ref [SALE] is 
v_sale	Ref [SALE];
begin
	if v_cur_in.[CURRENCY] is not null then
		::[SALE].[SALE_LIB].FindCustProps(v_client, v_cur_in.[CURRENCY], 1, v_cur_in.[ACCOUNT], v_cur_in.[SWIFT_FRIENDS]);
	end if;
	
	if v_cur_out.[CURRENCY] is not null then
		::[SALE].[SALE_LIB].FindCustProps(v_client, v_cur_out.[CURRENCY], 2, v_cur_out.[ACCOUNT], v_cur_out.[SWIFT_FRIENDS]);
		::[SALE_INTERFACE].[PRX_DOCUMENT].Get_Standart_Route_For_Rub(v_cur_out, v_client);
	end if;

	v_sale := [SALE]::[NEW#AUTO_BANK](
		rec.[NUM]
		, trunc(rec.[D])
		, v_oper_type
		, v_pay_to_deal.[DEAL]
		, v_client
		, v_cur_out
		, v_cur_in
		, Null
		, rec.[PRICE]
		, Null
		, Null
		, rec.[ORDER_NUM] || '#' || rec.[NOTE]
		, StdLib.UserId
		, Null
		, Null
		, p_market
		, section_ref
		, Null
		, rec.[REJIM_S]
		, P_COMMIS_BARG == rec.[COMMIS_BARG]
		, P_COMMIS_ITS == rec.[COMMIS_ITS]
		, P_COMMIS_CLEARING == rec.[COMMIS_CLEARING]
		, P_TRADE_TIME == rec.[D]
		, P_ORDER_NUM == rec.[ORDER_NUM]
		);

	v_sale.[NUM_DOG] := rec.[ORDER_NUM];
	v_sale.[DATE_BEGIN] := rec.[D];
	v_sale.[PFI] := nvl(rec.[IS_PFI], false);
	v_sale.[IMP_NUM] := rec.[NUM];

	-- BS00072161		
	-- v_sale.[SWAP] := rec.[TIP] in ('S', 'W');	
	declare
		v_tmp_sale	ref [SALE];
		is_pfi boolean;
	begin
		locate v_tmp_sale
			in ::[SALE]
			where v_tmp_sale.[EXCHANGE] = p_market
			  and v_tmp_sale.[NUM_DOG] =rec.[ORDER_NUM]
			  and v_tmp_sale.[OPER] <> v_oper_type
			  and v_tmp_sale.[DATE_BEGIN] = rec.[D]
			  and v_tmp_sale.[INPUT].[CURRENCY] = v_cur_out.[CURRENCY]
			  and v_tmp_sale.[OUTPUT].[CURRENCY] = v_cur_in.[CURRENCY]
			  and (v_oper_type = ::[TYPE_SALE]([CODE] = 'FOREX_BUY') and v_tmp_sale.[OUTPUT].[AMOUNT] = v_cur_in.[AMOUNT] or
			  	   v_oper_type = ::[TYPE_SALE]([CODE] = 'FOREX_SEL') and v_tmp_sale.[INPUT].[AMOUNT] = v_cur_out.[AMOUNT])
			  and nvl(v_tmp_sale.[CLIENT]%id, 0) = nvl(v_client%id , 0)
			  and v_tmp_sale.[SWAP_REF] is null
			  ;
		v_sale.[SWAP_REF] := v_tmp_sale;
		v_sale.[SWAP] := true;
		v_tmp_sale.[SWAP_REF] := v_sale;
		v_tmp_sale.[SWAP] := true;
		if p_set_pfi_swap then
			is_pfi := True;
		else
			is_pfi := (nvl(v_tmp_sale.[PFI], false) or nvl(v_sale.[PFI],false));
		end if;
		v_tmp_sale.[PFI] = v_sale.[PFI] := is_pfi;
	exception when NO_DATA_FOUND then
		null;
	end;
	return v_sale;
end;
--=======================Функция инициализирует некоторые параметры конверсионной операции=====================================================================================
public function form_sale (rec [MT_TRADE_BUF], f_vid string(1), v_cur_in out [CUR_SALE], v_cur_out out [CUR_SALE], v_deal_type out string(3), v_oper_type out ref [TYPE_SALE], v_pay_to_deal out ref [SALE_PAY_TO_DEAL]) return string(2000) is 
	v_currency_left		ref [FT_MONEY];
	v_currency_right	ref [FT_MONEY];
	v_next_date			date;
	cur_code_left		[FT_MONEY].[CUR_ISO].[INT_CUR_SHORT]%type;
	cur_code_right		[FT_MONEY].[CUR_ISO].[INT_CUR_SHORT]%type;
	p_date 				[DATE];
	calend				varchar2;
	days_count			pls_integer;
	period				ref [SALE_PERIOD];
	country				ref [COUNTRY];
	is_marg				boolean;
begin
	
	v_cur_in%init(false, true);
	v_cur_out%init(false, true);
	p_date := trunc(rec.[D]);
	cur_code_left := substr(rec.[CB_NAME], 1, 3);
	cur_code_right := substr(rec.[CB_NAME], 4, 3);
	-->> PSH VRI 02/03/2026 CFT-3709 Загрузка биржевых сделок в Модуль конверсия, биржевые валютные сделки GLDRUB (СВОП)
	if cur_code_left  = 'GLD' then cur_code_left  := 'XAU'; end if;
	if cur_code_right = 'GLD' then cur_code_right := 'XAU'; end if;
	--<< PSH VRI 02/03/2026 CFT-3709 Загрузка биржевых сделок в Модуль конверсия, биржевые валютные сделки GLDRUB (СВОП)
	
	v_currency_left := [FT_MONEY]::[LIB].get_money(cur_code_left);

	if instr(cur_code_right,'_') > 0 then
		v_currency_right := [SYSTEM]::[VARIABLES].NatCur;
	else
		v_currency_right := [FT_MONEY]::[LIB].get_money(cur_code_right);
	end if;
	v_deal_type := substr(rec.[CB_CODE], -3);

	country := rec.[COAG_ID].[COUNTRY];
	calend := ::[FP_TUNE].[LIB].get_str_value('SALE_CALENDAR', ::[FP_TUNE].[LIB].set_exact_canons('COUNTRY', country, true), '0');
	if trim(calend) is null then
		calend := nvl(::[SYSTEM].[VARIABLES].OurBranch.[HOLIDAYS], 'HOLIDAYS');
		for d in ::[SALE] all where d.[FILIAL] = ::[SYSTEM].[VARIABLES].OurBranch loop
			calend := nvl(d.[GET_STR_TUNE]('CALENDAR'), calend);
			exit;	
		end loop;	
	end if;
		
	if rec.[PAYMENT_DATE] is not null then
		-- если заполнена дата расчетов, то берем ее. иначе по старому
		v_cur_in.[date_VALUE] = v_cur_out.[date_VALUE] := rec.[PAYMENT_DATE];
	else
		if v_deal_type = 'TOD' then
			v_cur_in.[date_VALUE] = v_cur_out.[date_VALUE] := p_date;
		else
			if [RUNTIME]::[CALENDAR].Check_date(calend, p_date) = '0' then
				v_next_date := [RUNTIME]::[CALENDAR].Next_date(calend, '0', p_date, 2);
			else
				v_next_date := [RUNTIME]::[CALENDAR].Next_date(calend, '0', p_date, 1);
			end if;
			v_cur_in.[DATE_VALUE] = v_cur_out.[DATE_VALUE] := v_next_date;
		end if;
	end if;


	-- Определение маржируемости
	is_marg := nvl(rec.[IS_PFI], false);	-- Внимание ! В new_sale этот реквизит используется для определения признака PFI на сделке. Реально это тэг TradeDeriv из CUX23
											-- Но этот тэг на самом деле определяет маржируемая или не маржируемая сделка
											-- После перехода на 4611-У ВСЕМ сделкам СВОП будет проставлятся признак ПФИ независимо от тэга TradeDeriv
											-- Поэтому мы должны различать в SALE_PAY_TO_DEAL маржируемые и не маржируемые сделки. Для этого в него добавлен реквизит VM
											-- И при поиске мы возвращаемся к первоначальному назначению TradeDeriv - он будет означать какой именно вид сделки мы будем искать в SALE_PAY_TO_DEAL
											-- Отличие маржируемые и не маржируемые сделки с точки зрения SALE_LIST заключается в том, что не маржируемые сделки переоцениваются по ТСС
											-- А по маржируемым сделкам приходит ежедневная вариационная маржа
	
	if not nvl(is_4611,False) then
		is_marg := False;
	end if;
	
	if rec.[PAYMENT_DATE] is not null then
		days_count := ::[SALE].[GET_WORK_DAYS](p_date, rec.[PAYMENT_DATE], country, P_CUR_INP == v_currency_left, P_CUR_OUT == v_currency_right);
		
		if days_count > 2 and days_count <= 7 then
			period := ::[SALE_PERIOD]([CODE] = 'DAY_2_7');
		elsif days_count >= 8 and days_count <= 30 then
			period := ::[SALE_PERIOD]([CODE] = 'DAY_8_30');
		elsif days_count >= 31 and days_count <= 90 then
			period := ::[SALE_PERIOD]([CODE] = 'DAY_31_90');
		elsif days_count >= 91 then
			period := ::[SALE_PERIOD]([CODE] = 'DAY_91_999999');
		else
			period := ::[SALE_PERIOD]([CODE] = 'DAY_0_1');
		end if;		
	
		begin
			locate v_pay_to_deal
				in ::[SALE_PAY_TO_DEAL]
				where v_pay_to_deal.[DEST].[CODE] = f_vid || '_' || v_deal_type || '_' || rec.[TIP]
				  and is_marg = nvl(v_pay_to_deal.[VM], False)
				  and v_pay_to_deal.[CURR_IN] = v_currency_left
				  and v_pay_to_deal.[TYPE_DEAL] = period;
		exception when NO_DATA_FOUND then
			begin
				locate v_pay_to_deal
					in ::[SALE_PAY_TO_DEAL]
					where v_pay_to_deal.[DEST].[CODE] = f_vid || '_' || v_deal_type || '_' || rec.[TIP]
					  and is_marg = nvl(v_pay_to_deal.[VM], False)
					  and v_pay_to_deal.[CURR_IN] is null
					  and v_pay_to_deal.[TYPE_DEAL] = period;
			exception when NO_DATA_FOUND then
				null;
			end;
		end;
	end if;
			
	if v_pay_to_deal is null then
		--Башкиров В.Г. 26.12.2016 Появился новый инструмент TOMSPT
		debug_pipe('Поиск в SALE_PAY_TO_DEAL '||f_vid || '_' || v_deal_type || '_' || rec.[TIP],dp);
		debug_pipe('                 is_marg='||is_marg,dp);
		debug_pipe('         v_currency_left='||v_currency_left.[CUR_SHORT],dp);
		begin
			locate v_pay_to_deal
				in ::[SALE_PAY_TO_DEAL]
				where v_pay_to_deal.[DEST].[CODE] = f_vid || '_' || v_deal_type || '_' || rec.[TIP]
				  and is_marg = nvl(v_pay_to_deal.[VM], False)
				  and v_pay_to_deal.[CURR_IN] = v_currency_left
				  and v_pay_to_deal.[TYPE_DEAL] is null;
		exception when NO_DATA_FOUND then
			begin
				locate v_pay_to_deal
					in ::[SALE_PAY_TO_DEAL]
					where v_pay_to_deal.[DEST].[CODE] = f_vid || '_' || v_deal_type || '_' || rec.[TIP]
					  and is_marg = nvl(v_pay_to_deal.[VM], False)
					  and v_pay_to_deal.[CURR_IN] is null
					  and v_pay_to_deal.[TYPE_DEAL] is null;
			exception when NO_DATA_FOUND then
				return 'Невозможно определить вид конверсионной операции по справочнику (SALE_PAY_TO_DEAL)';
			end;
		end;
	end if;	

	if f_vid = 'B' then
		v_oper_type := ::[TYPE_SALE]([CODE] = 'FOREX_BUY');
		v_cur_in.[CURRENCY] := v_currency_left;
		v_cur_in.[AMOUNT] := rec.[QUANTITY] * coalesce(v_pay_to_deal.[LOT_SIZE], rec.[REJIM_S].[REJIM].[LOT_SIZE], 100);
		v_cur_out.[CURRENCY] := v_currency_right;
		v_cur_out.[AMOUNT] := rec.[SUMMA];
	else
		v_oper_type := ::[TYPE_SALE]([CODE] = 'FOREX_SEL');
		v_cur_out.[CURRENCY] := v_currency_left;
		v_cur_out.[AMOUNT] := rec.[QUANTITY] * coalesce(v_pay_to_deal.[LOT_SIZE], rec.[REJIM_S].[REJIM].[LOT_SIZE], 100);
		v_cur_in.[CURRENCY] := v_currency_right;
		v_cur_in.[AMOUNT] := rec.[SUMMA];
	end if;
end;
-------------------------------------------------------------------------------------------------------------------
function string_processing(	
							p_source	string(1000),
							p_date		date,
							market		ref [MARKET_PLACE],
                            i			in out pls_integer,
                            i_all		in out pls_integer,
                            p_success	in out pls_integer,
                            p_repeat	in out pls_integer,
                            razd		string,
                            p_make_oper	boolean,
                            p_market	ref [MARKET_PLACE],
                            P_VERSION_FILE [SIXTH_CHOICE],
                            p_error		in out pls_integer) return string(2000) is
section_ref			ref [MT_SECTIONS];
rej_s				ref [MT_REJIM_S];
vid_r				ref [NS_ORIGIN];
rec					[MT_TRADE_BUF];
ns_origin_ident		[NS_ORIGIN].[IDENT]%type;
f_num				string(20);		-- 1
f_time				string(8);		-- 2
f_order_num			string(20);		-- 3
f_cb_name			string(20);		-- 4
f_rejim				string(50);		-- 5
f_cb_code			string(20);		-- 6
f_vid				string(1);		-- 7
f_acc_trade			string(20);		-- 8
f_contragent		string(20);		-- 9
f_price				string(18);		-- 10
f_nkd				string(18);		-- 11
f_quantity			string(16);		-- 12
f_summa				string(18);		-- 13
f_dohod				string(12);		-- 14
f_trader			string(20);		-- 15
f_investor			string(20);		-- 16
f_note				string(30);		-- 17
f_tip				string(5);		-- 19
f_comis				string(18);		-- 20

f_date				varchar2(15);	-- 20 поле в новом формате (дата расчетов)
str4mess			string(400);
trade_code			ref [COAG_TRADE_CODE];
v_sale				ref [SALE];
v_deal_type			string(3);
v_oper_type			ref [TYPE_SALE];
v_pay_to_deal		ref [SALE_PAY_TO_DEAL];
v_cur_in			[CUR_SALE];
v_cur_out			[CUR_SALE];
v_client			ref [CLIENT];
v_errm				string(2000);
v_sect 				ref [MT_SECTIONS];
v_place 			ref [MARKET_PLACE];
subtype TArr is varray(0) of string;
begin
	if trim(p_source) is Null then
		return null;
	end if;

	i := i + 1;	

	begin
		f_num        := trim([FD].GetStrGroup(p_source, 1, razd)); -- номер сделки
		f_time       := trim([FD].GetStrGroup(p_source, 2, razd)); -- время заключения сделки в формате hh:mm:ss (это не оракловый шаблон)
		f_order_num  := trim([FD].GetStrGroup(p_source, 3, razd)); -- номер заявки
		f_cb_name    := trim([FD].GetStrGroup(p_source, 4, razd)); -- наименование ЦБ
		f_rejim      := trim([FD].GetStrGroup(p_source, 5, razd)); -- режим торгов
		f_cb_code    := trim([FD].GetStrGroup(p_source, 6, razd)); -- торговый код бумаги
		f_vid        := trim([FD].GetStrGroup(p_source, 7, razd)); -- вид сделки ("B" - покупка, "S" - продажа)
		f_acc_trade  := trim([FD].GetStrGroup(p_source, 8, razd)); -- торговый счет
		f_contragent := trim([FD].GetStrGroup(p_source, 9, razd)); -- контрагент
		f_price      := trim([FD].GetStrGroup(p_source, 10, razd)); -- цена (% -гос.бум., руб. - корпоративные) с точностью до 3 знаков после зап.
		f_nkd        := trim([FD].GetStrGroup(p_source, 11, razd)); -- процентный доход, руб
		f_quantity   := trim([FD].GetStrGroup(p_source, 12, razd)); -- количество
		f_summa      := trim([FD].GetStrGroup(p_source, 13, razd)); -- объем, руб
		f_dohod      := trim([FD].GetStrGroup(p_source, 14, razd)); -- доходность, %
		f_trader     := trim([FD].GetStrGroup(p_source, 15, razd)); -- код трейдера(пользователя)
		f_investor   := trim([FD].GetStrGroup(p_source, 16, razd)); -- торговый код инвестора
		f_note       := trim([FD].GetStrGroup(p_source, 17, razd)); -- примечание
		f_tip        := trim([FD].GetStrGroup(p_source, 18, razd)); -- тип сделки
		f_date		 := trim([FD].GetStrGroup(p_source, 20, razd, false)); -- дата расчетов
	
	exception when NO_DATA_FOUND or standard.NO_DATA_FOUND or VALUE_ERROR then
		&inc(p_error)
		return 'Неправильный формат файла в строке ' || to_char(i);
	end;
	
	if f_contragent is null then
		-- BS00354505. Ищем секцию по режиму торгов
		for (
			select	s(s : ID,
						s%parent : parent)
			in		::[MT_SECTIONS], (::[MT_REJIM_S] collections : r) collections
			where	s%parentclass = 'MARKET_PLACE' and
					s.[REJIM_S] = r%collection and
					r.[REJIM].[NAME] = f_rejim
			)
		loop
			v_place%id := s.parent;
			exit;
		end loop;
		
		if v_place is null then
			&inc(p_error)
			return 'Сделка № ' || f_num || '. Не найдена секция с режимом торгов "' || f_rejim || '"!';
		end if;
	else
		-- BS00207449. определение контрагента	
		begin
			locate v_sect in ::[MT_SECTIONS] collections where v_sect%parentclass = 'MARKET_PLACE' and v_sect.[MARKET_CODE] = f_contragent;
			
			v_place%id := v_sect%parent;
		exception
			when NO_DATA_FOUND then
				&inc(p_error)
				return 'Сделка № ' || f_num || '. Не найдена секция с кодом "' || f_contragent || '"!';
		end;
	end if;
	
	var v_str varchar2(500);
	v_str := ::[FP_TUNE].[LIB].get_str_value('SALE_SWAP_CODES');
	
	for (
		select	x(regexp_substr(v_str, '[^,]+', 1, level) : str)
      	in		dual%rowtype
      	connect by level <= regexp_count(v_str, '[^,]+')
     	)
	loop
		if substr(f_cb_name, -1 * length(x.str)) = x.str then
			-- служебная запись по SWAP сделке, уменьшим общее число сделок
			i := i - 1;
			return 'Служебная информация по SWAP, заявка N ' || f_order_num || ' в строке ' || to_char(i) || ' пропущена.';
		end if;
	end loop;
	
	i_all := i_all + 1;
	
	str4mess := 'Сделка № ' || f_num || '.';

	if f_vid = 'B' then
		ns_origin_ident := 'BUY';
	elsif f_vid = 'S' then
		ns_origin_ident := 'SELL';
	else
		&inc(p_error)
		return str4mess || ' Неизвестный код вида сделки "' || f_vid || '". Импорт запрещен.';
	end if;
	
	begin
		locate vid_r in ::[NS_ORIGIN] where vid_r.[IDENT] = ns_origin_ident;
	exception when NO_DATA_FOUND then
		&inc(p_error)
		return str4mess || ' В справочнике "Тип изменения в портфеле ЦБ банка" отсутствует запись с идентификатором ' || ns_origin_ident || '. Импорт запрещен.';
	end;

	-- поиск в массиве буфера приема сделок
	declare
		tr	ref [MT_TRADE_BUF];
	begin
		pragma hint( 'index(a1 IDX_Z#MT_TRADE_BUF_COLL_N_V_D)');
		
		locate tr in market.[TRADE_BUF]
			where tr.[NUM] = f_num
			  and tr.[VID] = vid_r
			  and p_date <= tr.[D]
			  and tr.[D] < p_date + 1;
		
		p_repeat := p_repeat + 1;
		
		-- '2' - соощение о попытке повторного импорта сделки
		return '2' || str4mess || ' Сделка с таким номером, видом и датой уже есть в массиве принятых сделок этой торговой площадки. Импорт запрещен.';
	exception when NO_DATA_FOUND then
		null;
	end;

	-- цикл по секциям торговой площадки
	for v_s in market.[SECTIONS] loop
		begin
			-- поиск в секции режима торгов совпадающего по наименованию с режимом в сделке из файла импорта
			locate rej_s in v_s.[REJIM_S] where rej_s.[REJIM].[NAME] = f_rejim;
			section_ref := v_s; -- запомним ссылку на секцию
			
			exit;
		exception when NO_DATA_FOUND then
			null;
		end;
	end loop;
	
	if section_ref is null then
		&inc(p_error)
		return str4mess || ' Режим торгов "' || f_rejim || '" не найден ни в одной из секций этой торговой площадки. Импорт запрещен.';
	end if;

	rec.[NUM] := f_num;
	rec.[PAYMENT_DATE] := to_date(f_date, 'dd/mm/yyyy');
	if P_VERSION_FILE.[0] = 1 then
		rec.[D] := to_date(to_char(p_date,'dd/mm/yyyy') || ' ' || trim(f_time), 'dd/mm/yyyy hh24:mi:ss');
	elsif P_VERSION_FILE.[0] = 2 then
		rec.[D] := to_date( to_char(p_date,'dd/mm/yyyy') || ' ' || ltrim(rtrim(f_time)), 'dd/mm/yyyy hh24:mi:ss');
	end if;
	rec.[ORDER_NUM] := f_order_num;
	rec.[CB_NAME] := f_cb_name;
	rec.[REJIM] := f_rejim;
	rec.[CB_CODE] := f_cb_code;
	rec.[VID] := vid_r;
	rec.[ACC_TRADE] := f_acc_trade;
	rec.[CONTRAGENT] := f_contragent;
	rec.[COAG_ID] := v_place.[DOSSIER];
	v_client := v_place.[DOSSIER];
	rec.[PRICE] := to_number(replace(f_price, ',', '.'));
	rec.[NKD] := to_number(replace(f_nkd, ',', '.'));
	rec.[QUANTITY] := to_number(replace(f_quantity, ',', '.'));
	rec.[SUMMA] := to_number(replace(f_summa, ',', '.'));
	rec.[DOHOD] := to_number(replace(f_dohod, ',', '.'));
	rec.[TRADER] := f_trader;
	rec.[INVESTOR] := f_investor;
	rec.[NOTE] := f_note;
	rec.[NS] := Null;	-- Ценная бумага
	rec.[REJIM_S] := rej_s;
	if P_VERSION_FILE.[0] = 1 then
		rec.[TIP] := f_tip;
	elsif P_VERSION_FILE.[0] = 2 then
		rec.[TIP] := substr(f_tip, 1, 1);
	end if;
	-- rec.[COMIS] := to_number(f_comis);
	rec.[COMIS_BIRJ] := to_number(replace(f_comis, ',', '.'));

	v_errm := form_sale (rec, f_vid, v_cur_in, v_cur_out, v_deal_type, v_oper_type, v_pay_to_deal);
	if v_errm is  not null then
		&inc(p_error)
		return v_errm;
	end if;
	
	-- Поиск дубля в конверсионных операциях
	declare
		v_tmp_sale	ref [SALE];
	begin
		v_tmp_sale := check_sale(rec, v_client, v_cur_in, v_cur_out, v_pay_to_deal, p_market);
		if v_tmp_sale is not null then
			p_repeat := p_repeat + 1;
			-- '2' - соощение о попытке повторного импорта сделки
			return '2' || str4mess || ' Сделка с таким номером, торговой площадкой, видом, датой, контрагентом и валютами принято/выдано уже есть в продукте "Конверсионные операции". Импорт запрещен.';
		end if;
	end;

	-- Занести сделку в массив "Приём сделок"
	market.[TRADE_BUF]%insert(rec);

	-- Если выставлен флаг, то сразу создадим
	if p_make_oper then
		new_sale(rec, v_client, v_cur_in, v_cur_out, v_deal_type, v_oper_type, v_pay_to_deal, section_ref, p_market);
	end if;
	
	p_success := p_success + 1;
	
	return '1' || str4mess || ' Импортирована.'; -- '1' - соощение об успешном импорте сделки
end;
PSH_IMP_TRDS_FRX (
	@name('Данные за дату')                                 P_DATE         in [DATE],
	@name('Торговая площадка')                              P_MARKET       in [MARKET_PLACE_REF],
	@name('Сообщения: попытка повторного импорта')          P_POVTOR       in [BOOLEAN],
	@name('Сообщения: успешный импорт')                     P_USPEH        in [BOOLEAN],
	@name('Разделитель элементов списка в файле импорта')   P_RAZD         in [STRING_1],
	@name('Файл')                                           P_SOURCE       in [FILE$LOAD],
	@name('Лог-файл')                                       P_LOG          in [FILE$LOAD],
	@name('Автоматически создавать конверсионную операцию') P_MAKE_OPER    in [BOOLEAN],
	@name('Версия файла с данными')                         P_VERSION_FILE in [SIXTH_CHOICE]
) return [BOOLEAN] is

validate is
i			integer;
begin
	if p_message = 'DEFAULT' then
		if PrevFile is not null then
		  P_SOURCE.[SRC_NAME] := PrevFile; --Имя файла в директории на клиенте
		end if;
		
		P_DATE := [SYSTEM].[OP_DATE];
		P_MARKET := this;
		P_MAKE_OPER := False;

		-- Подготовка структуры для работы с исходным файлом
		ServerDir := [SYSTEM_PARAMS]::[GET]('PATH', Null); --Директория на сервере
		
		P_SOURCE.[SRC_PATH] := [FP_TUNE]::[LIB].get_str_value('SALE_PATH_IMP_TRADES'); --Директория на клиенте
		P_SOURCE.[SRC_TYPE] := instr(upper(P_SOURCE.[SRC_PATH]),upper(ServerDir)) <> 0;
		P_SOURCE.[DST_TYPE] := true;
		P_SOURCE.[DST_PATH] := ServerDir; --Директория на сервере
		P_SOURCE.[DST_NAME] := P_SOURCE.[SRC_NAME]; --Имя файла в директории на сервере
		P_SOURCE.[DST_DELETE] := true; --Удалить файл на сервере после выполнения
		
		if P_SOURCE.[SRC_NAME] is not null then
			i := instr(P_SOURCE.[SRC_NAME], '.');
			
			if i = 0 then -- нет '.' в имени файла
				f_name_log := P_SOURCE.[SRC_NAME] || '_log';
			else
				f_name_log := substr(P_SOURCE.[SRC_NAME], 1, i - 1) || '_log.' || substr(P_SOURCE.[SRC_NAME], i + 1);
			end if;
		end if;
		
		-- Подготовка структуры для работы с лог-файлом
		-- Лог-файл сначала открывается на сервере
		P_LOG.[SRC_TYPE] := true;
		P_LOG.[SRC_PATH] := ServerDir; --Директория на сервере
		P_LOG.[SRC_NAME] := f_name_log; --Имя файла в директории на сервере
		P_LOG.[SRC_DELETE] := True; --Удалить файл на сервере после выполнения
		P_LOG.[DST_TYPE] := P_SOURCE.[SRC_TYPE];
		P_LOG.[DST_PATH] := P_SOURCE.[SRC_PATH]; --Директория на клиенте
		P_LOG.[DST_NAME] := f_name_log; --Имя файла в директории на клиенте
	
		P_VERSION_FILE.[0] := nvl(::[DEFVALS].[SLIB].RestoreNum(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_VERSION_FILE'), 1);
		P_RAZD := nvl(::[DEFVALS].[SLIB].RestoreStr(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_RAZD'), ';');
		
	elsif p_message = 'VALIDATE' then
		if p_info = 'OK' then
			if instr(upper(P_SOURCE.[SRC_PATH]),upper(ServerDir))<>0 then
				-- Файлы изначально находятся на сервере
				P_SOURCE.[SRC_TYPE] = P_LOG.[DST_TYPE] = P_SOURCE.[DST_TYPE] = P_LOG.[SRC_TYPE] := true;
				P_LOG.[SRC_PATH] := P_SOURCE.[SRC_PATH];
			else
				-- Файлы изначально находятся на локальном устройстве
				P_SOURCE.[SRC_TYPE] = P_LOG.[DST_TYPE] := False;
				P_SOURCE.[DST_PATH] = P_LOG.[SRC_PATH] := ServerDir;
			end if;
		  	P_SOURCE.[DST_NAME] := P_SOURCE.[SRC_NAME]; --Имя файла в директории на сервере

			i := instr(P_SOURCE.[SRC_NAME], '.');
			if i = 0 then -- нет '.' в имени файла
				f_name_log := P_SOURCE.[SRC_NAME] || '_log';
			else
				f_name_log := substr(P_SOURCE.[SRC_NAME],1,i-1) || '_log.' || substr(P_SOURCE.[SRC_NAME],i+1);
			end if;
			P_LOG.[SRC_NAME] := f_name_log; --Имя файла в директории на сервере
			P_LOG.[DST_NAME] := f_name_log; --Имя файла в директории на клиенте
		
		elsif p_info like 'P_SOURCE.%' then
			P_SOURCE.[SRC_TYPE] := instr(upper(P_SOURCE.[SRC_PATH]),upper(ServerDir))<>0;
			if P_SOURCE.[SRC_TYPE] then
				P_SOURCE.[DST_PATH] := P_SOURCE.[SRC_PATH];
			else
				P_SOURCE.[DST_PATH] := ServerDir;
			end if;
			P_LOG.[DST_PATH] := P_SOURCE.[SRC_PATH];
		end if;
	end if;
end;

execute is
	v_source	string(1000);
str4mess	string(2000);
letter1		string(1);

i			integer := 0;
i_all		integer := 0;
v_success	integer := 0;
v_repeat	integer := 0;
v_error		pls_integer := 0;

arr_trades	[MT_TRADE_BUF_ARR];

begin
	P_RAZD := trim(P_RAZD);

	if P_RAZD is null then
		pragma error('Не задан "Разделитель элементов списка в файле импорта"!');
	end if;
	
	if P_DATE is null then
		pragma error('Не задана дата');
	elsif P_MARKET is null then
		pragma error('Не задана торговая площадка');
	end if;
	
	g#file := stdio.open(P_SOURCE.[DST_PATH], P_SOURCE.[DST_NAME], 'r');
	g#file_log := stdio.open(P_LOG.[SRC_PATH], P_LOG.[SRC_NAME], 'a'); -- append

	mess2pipe('ИМПОРТ СДЕЛОК ЗА ' || to_char(P_DATE, 'DD.MM.RRRR'));
	mess2pipe('Торговая площадка - ' || P_MARKET.[NAME]);

	while stdio.get_line(g#file, v_source, false, stdio.WINTEXT) loop
		v_source := replace(v_source, CR$);
		
		if P_VERSION_FILE.[0] > 2 then
			pragma error('Версия файла с данными не поддерживается');
		end if;

		str4mess := string_processing(v_source, P_DATE, P_MARKET, i, i_all, v_success, v_repeat, P_RAZD, P_MAKE_OPER, P_MARKET, P_VERSION_FILE, v_error);
		
		if str4mess is not null then
			letter1 := substr(str4mess, 1, 1);
			
			if instr('0123456789', letter1) = 0 then -- если первый символ не цифра, безусловный вывод в монитор
				mess2pipe(str4mess);
			elsif letter1 = '1' and P_USPEH then -- соощение об успешном импорте сделки
				mess2pipe(substr(str4mess, 2));
			elsif letter1 = '2' and P_POVTOR then -- соощение о попытке повторного импорта сделки
				mess2pipe(substr(str4mess, 2));
			end if;
		end if;
	end loop;

	mess2pipe('Всего сделок в файле - ' || to_char(i));
	mess2pipe('  из них, успешно импортировано - ' || to_char(v_success));
	
	if v_repeat > 0 then
		mess2pipe('  уже существуют в системе - ' || to_char(v_repeat));
	end if;
	
	if v_error > 0 then
		mess2pipe('  с ошибками - ' || to_char(v_error));
	end if;
	
	mess2pipe('Импорт завершен');
	mess2pipe(' ');

	stdio.close(g#file);
	stdio.close(g#file_log);
	
	PrevFile := P_SOURCE.[DST_NAME];
	
	::[DEFVALS].[SLIB].SaveNum(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_VERSION_FILE', P_VERSION_FILE.[0]);
	::[DEFVALS].[SLIB].SaveStr(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'P_RAZD', P_RAZD);

	if v_error > 0 then
		return false;
	else
		return true;
	end if;
exception when others then
	stdio.close(g#file);
	stdio.close(g#file_log);
	return false;
end;
end;
end;
