class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Редактировать назначение платежа')
method PSH_EDIT_NAZN is
PSH_EDIT_NAZN (
	@name('Назначение платежа') P_NAZN in [MEMO]
) is

validate is
Begin
	if p_message='DEFAULT' then
		P_NAZN := this.[NAZN];
	end if;
End;

execute is
Begin
	-- Проверка документа на наличие в электронном архиве
	::[EARCHIVE].[DOC_LIB].edit_mdoc(this);

	if	this.[VID_DOC] in (::[NAME_PAYDOC](CODE = 'БЕЗН_ПЛ_ПОРУЧ'), ::[NAME_PAYDOC](CODE = 'БЕЗН_ИНКАСС_ПОР'), ::[NAME_PAYDOC](CODE = 'БЕЗН_ПЛ_ТРЕБ'))
		and length(P_NAZN) > 210
	then
		pragma error('В платежном документе длина назначения платежа не может быть более 210 символов!');
	end if;
	
	this.[NAZN] := P_NAZN;
End;
end;
end;
