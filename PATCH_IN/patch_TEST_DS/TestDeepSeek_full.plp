BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		--#IF DEFINED(DEBUG)
			debug('test');
		--#ENDIF
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		debug('test');
	-- end pl/sql
END;

-- ============================================================================
-- Правило 36: v50.PROC.NATIVEID.п.3.26 - NativeID для метаданных
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: NativeID для метаданных
--   Подробное описание: Идентификаторы операций и представлений стали строками, а не числами. Нельзя присваивать в NUMBER переменные.
--   Пример кода для корректировки: v_id number; v_id := rMeth%id;
--   Пример исправленного кода: v_id varchar2(100); v_id := rMeth%id;
--   Теги: nativeid, identifiers
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: На уровне Платформы ведется плановая работа по переводу синтетических идентификаторов операций и представлений на NativeID. Вместо числового идентификатора в колонке ID таблиц methods и criteria будут храниться идентификаторы типа КОРОТКОЕ_ИМЯ_КЛАССА.КОРОТКОЕ_ИМЯ_ОПЕРАЦИИ.
--   plplus_materials_note: Переход на NativeID в Платформе.
--   search_prompt: Найти присваивание %id операций или представлений в NUMBER переменные.
--   regex_patterns.for_search: \w+%id\s*:=\s*\w+; \w+\s+number\s*;.*\w+%id
--   code_example_bad: v_id number; v_id := rMeth%id;
--   fix_instruction: Использовать VARCHAR2(100) для хранения NativeID.
--   fix_prompt: Замени NUMBER на VARCHAR2 для NativeID.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.NATIVEID.п.3.26'.
--   priority: high
--   category: PROC
--   subcategory: PROC.OTHER
--   source_files: v50.docx
--   source_sections: п.3.26
-- ============================================================================
PROCEDURE v50_PROC_NATIVEID_p_3_26 IS
	v_method_id VARCHAR2(100);
	v_bad_id NUMBER;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		v_bad_id NUMBER;
		v_bad_id := rMeth%id;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		v_method_id VARCHAR2(100);
		v_method_id := rMeth%id;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 37: v50.PROC.ID_SIZE.п.3.27 - Размер идентификатора бизнес-данных
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Размер идентификатора бизнес-данных
--   Подробное описание: В PostgreSQL ID генерируется sequence типа bigint (до 19 цифр). Переменные для хранения ID должны быть не менее 20 символов.
--   Пример кода для корректировки: v_id varchar2(10);
--   Пример исправленного кода: v_id varchar2(20);
--   Теги: id, bigint, size
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: В PostgreSQL максимальная размерность sequence, которая генерирует идентификаторы строк таблиц Z# - bigint. Минимальное значение -9 223 372 036 854 775 808, максимальное 9 223 372 036 854 775 807. Таким образом, размерность строковой или числовой переменной для хранения ID должна быть не менее 20 символов (19 цифр и знак "-").
--   plplus_materials_note: Максимальное значение bigint: 9 223 372 036 854 775 807 (19 цифр).
--   search_prompt: Найти объявления переменных для ID бизнес-данных с недостаточным размером.
--   regex_patterns.for_search: \b\w+\s+(varchar2|string)\s*\(\d+\)\s*;.*%id
--   code_example_bad: v_id varchar2(10); v_id := r%id;
--   fix_instruction: Использовать varchar2(20) или number для хранения ID.
--   fix_prompt: Увеличь размер переменной для ID до 20 символов.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.ID_SIZE.п.3.27'.
--   priority: high
--   category: PROC
--   subcategory: PROC.OTHER
--   source_files: v50.docx
--   source_sections: п.3.27
-- ============================================================================
PROCEDURE v50_PROC_ID_SIZE_p_3_27 IS
	v_client_id VARCHAR2(20);
	v_bad_id VARCHAR2(10);
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		v_bad_id VARCHAR2(10);
		v_bad_id := client%id;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		v_client_id VARCHAR2(20);
		v_client_id := client%id;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 38: v50.INT.DBLINK.п.4.2 - Замена Database Link на REST/SOAP
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена Database Link на REST/SOAP
--   Подробное описание: Database Link не поддерживается. Использовать веб-сервисы: REST или SOAP.
--   Пример кода для корректировки: select * from table@dblink
--   Пример исправленного кода: REST/SOAP веб-сервисы
--   Теги: dblink, rest, soap
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Database Link не поддерживается. Использовать веб-сервисы: REST (1B060230 — потребитель, 1B060220 — поставщик) или SOAP (1B060250 — потребитель, 1B060240 — поставщик).
--   plplus_materials_note: Database Link не работает в DBI.
--   search_prompt: Найти обращения к Database Link (@dblink).
--   regex_patterns.for_search: \b\w+@\w+\b
--   regex_patterns.for_ignore: ^\s*@import_plsql; ^\s*@this\(; ^\s*@name\(
--   code_example_bad: select * from table@dblink
--   fix_instruction: Заменить Database Link на вызов REST/SOAP веб-сервиса: 1B060230, 1B060220 (REST) или 1B060250, 1B060240 (SOAP).
--   fix_prompt: Выполни замену Database Link на REST/SOAP веб-сервис.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.INT.DBLINK.п.4.2'.
--   examples.rest.bad: select * from table@dblink
--   examples.rest.good: -- использовать REST веб-сервис 1B060230
--   priority: high
--   category: INT
--   subcategory: INT.WEBSERVICES
--   source_files: v50.docx
--   source_sections: п.4.2
-- ============================================================================
PROCEDURE v50_INT_DBLINK_p_4_2 IS
	v_result VARCHAR2(4000);
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		select * from remote_table@remote_db;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		v_result := ::[RUNTIME].[HTTP_MGR].url_get('http://service/api/data');
	-- end pl/sql
END;

-- ============================================================================
-- Правило 39: v50.INT.QUEUE.п.4.4 - Использование [RUNTIME].[AQ_LIB] для очередей
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Использование [RUNTIME].[AQ_LIB] для очередей
--   Подробное описание: Для работы с очередями использовать библиотеку ::[RUNTIME].[AQ_LIB].
--   Пример кода для корректировки: dbms_aq.enqueue
--   Пример исправленного кода: ::[RUNTIME].[AQ_LIB].enqueue
--   Теги: queue, aq, mq
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Для работы с очередями использовать библиотеку ::[RUNTIME].[AQ_LIB]. Для PostgreSQL обязательно использование Apache ActiveMQ.
--   plplus_materials_note: Oracle AQ заменяется на AQ_LIB.
--   search_prompt: Найти использование Oracle AQ (DBMS_AQ).
--   regex_patterns.for_search: \bDBMS_AQ\.\w+\b
--   code_example_bad: dbms_aq.enqueue
--   fix_instruction: Заменить DBMS_AQ на ::[RUNTIME].[AQ_LIB].
--   fix_prompt: Выполни замену DBMS_AQ на RUNTIME.AQ_LIB.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.INT.QUEUE.п.4.4'.
--   examples.aq.bad: dbms_aq.enqueue
--   examples.aq.good: ::[RUNTIME].[AQ_LIB]
--   priority: medium
--   category: INT
--   subcategory: INT.QUEUES
--   source_files: v50.docx
--   source_sections: п.4.4
-- ============================================================================
PROCEDURE v50_INT_QUEUE_p_4_4 IS
	v_enqueue_options DBMS_AQ.ENQUEUE_OPTIONS_T;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		dbms_aq.enqueue(queue_name => 'test_queue', enqueue_options => v_enqueue_options);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		::[RUNTIME].[AQ_LIB].enqueue(queue_name => 'test_queue', payload => v_payload);
	-- end pl/sql
END;

-- ============================================================================
-- Правило 40: v50.CACHE.REF.п.6.10 - Получение полей сразу в курсоре
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Получение полей сразу в курсоре
--   Подробное описание: Разыменование ссылок в цикле вызывает точечные запросы. Получать нужные поля сразу в SELECT-листе курсора.
--   Пример кода для корректировки: for rec in (select ref_col from t) loop v := rec.ref_col.field; end loop;
--   Пример исправленного кода: for rec in (select ref_col.field from t) loop v := rec.field; end loop;
--   Теги: cache, ref, dereference
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Разыменование ссылок в цикле вызывает точечные запросы. Получать нужные поля сразу в SELECT-листе курсора.
--   plplus_materials_note: Кэш Hibernate: 1 уровень — 200 объектов, 2 уровень — 1 млн объектов.
--   search_prompt: Найти циклы FOR с разыменованием ссылок (REF.FIELD).
--   regex_patterns.for_search: FOR\s+\w+\s+IN\s+.*?\w+\.\[\w+\]\.\[\w+\]
--   code_example_bad: for rec in (select ref_col from t) loop v := rec.ref_col.field; end loop;
--   fix_instruction: Переписать запрос, добавив поле в SELECT-лист: select ref_col.field from t
--   fix_prompt: Выполни оптимизацию — вынеси поле в SELECT-лист курсора.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.CACHE.REF.п.6.10'.
--   examples.cursor.bad: for rec in (select ref_col from t) loop v := rec.ref_col.field; end loop;
--   examples.cursor.good: for rec in (select ref_col.field from t) loop v := rec.field; end loop;
--   priority: medium
--   category: CACHE
--   subcategory: CACHE.OPTIMIZATION
--   source_files: v50.docx
--   source_sections: п.6.10
-- ============================================================================
PROCEDURE v50_CACHE_REF_p_6_10 IS
	v_field_value VARCHAR2(100);
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		for rec in (select ref_col from t) loop
			v_field_value := rec.ref_col.field;
		end loop;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		for rec in (select ref_col.field from t) loop
			v_field_value := rec.field;
		end loop;
	-- end pl/sql
END;

