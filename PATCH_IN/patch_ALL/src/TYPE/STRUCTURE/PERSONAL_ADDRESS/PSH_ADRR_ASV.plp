class PERSONAL_ADDRESS;

@import_plsql(true)
@name('[ПСБ] Сформировать адрес АСВ')
method PSH_ADRR_ASV is

function get_city_double_for_parent(p_addr_obj ref [ADDRESS_OBJ]) return ref [ADDRESS_OBJ] is
begin
    for    (select r
            ( p : city_ref
            )
            in ::[ADDRESS_OBJ], (::[ADDRESS_OBJ] : p)
            where r = p_addr_obj
                and p%class = ::[NAMES_CITY]%class
                and p.[PARENT] = r
                and p.[KIND] = r.[KIND]
                and p.[NAME] = r.[NAME]
                and p.[KIND].[SHORT_NAME] in ('г','г.','Г','Г.')
            order by p.[ARCHAIC]
        )
    loop
        return r.city_ref;
    end loop;
    return null;
end;
PSH_ADRR_ASV (
	@name('Тип адреса')  P_TYPE  in [ADDRESS_TYPE_REF],
	@name('Адрес. Дома') P_HOUSE in [HOUSES_REF]
) return [PERSONAL_ADDRESS] is

validate is
begin
	if P_MESSAGE = 'DEFAULT' then
		P_TYPE := ::[ADDRESS_TYPE]([KOD] = 'ASV_REGISTRATION');
		--P_HOUSE := 1164314256;
	end if;
end;

execute is
v_addr_obj 		::[PERSONAL_ADDRESS].[API_LIB].addr_obj_expanded_rectype%type;
V_COUNTRY 		[COUNTRY_REF];
V_REGION 		[ADDRESS_OBJ_REF];
V_DISTRICT 		[ADDRESS_OBJ_REF];
V_SETTLEMENT 	[ADDRESS_OBJ_REF];
V_CITY 			[ADDRESS_OBJ_REF];
V_TOWN 			[ADDRESS_OBJ_REF];
V_SUBAREA 		[ADDRESS_OBJ_REF];
V_STREET 		[ADDRESS_OBJ_REF];
V_REGION_CITY	[ADDRESS_OBJ_REF];
V_DISTRICT_CITY	[ADDRESS_OBJ_REF];
begin
	v_addr_obj := ::[PERSONAL_ADDRESS].[API_LIB].get_addr_obj_expanded(P_HOUSE.[AOGUID], 1, P_HOUSE.[OKTMO]);
	
	V_COUNTRY := coalesce(v_addr_obj.COUNTRY.ID, V_COUNTRY, ::[SYSTEM].[COUNTRY]);
	V_REGION := v_addr_obj.REGION.ID;
	V_DISTRICT := v_addr_obj.DISTRICT.ID;
	V_SETTLEMENT := v_addr_obj.SETTLEMENT.ID;
	V_CITY := v_addr_obj.CITY.ID;
	V_TOWN := v_addr_obj.TOWN.ID;
	V_SUBAREA := v_addr_obj.SUBAREA.ID;
	V_STREET := v_addr_obj.STREET.ID;
	V_REGION_CITY := v_addr_obj.region_city;
	V_DISTRICT_CITY := v_addr_obj.district_city;

	if	V_CITY is null and 
		V_TOWN is null and 
		V_REGION_CITY is null and 
		V_DISTRICT_CITY is null and  
		(V_REGION is not null or V_DISTRICT is not null)
	then
		V_REGION_CITY := get_city_double_for_parent(nvl(V_DISTRICT, V_REGION));

		if V_REGION_CITY%class = ::[REGION_AREA]%class then
			V_DISTRICT_CITY := V_REGION_CITY;
			V_REGION_CITY := null;
		end if;
	end if;

	/*debug_pipe('V_COUNTRY = ' || V_COUNTRY.[NAME], 10);
	debug_pipe('V_REGION = ' || V_REGION.[NAME] , 10);
	debug_pipe('V_DISTRICT = ' || V_DISTRICT.[NAME] , 10);
	debug_pipe('V_SETTLEMENT = ' || V_SETTLEMENT.[NAME] , 10);
	debug_pipe('V_CITY = ' || V_CITY.[NAME] , 10);
	debug_pipe('V_TOWN = ' || V_TOWN.[NAME] , 10);
	debug_pipe('V_SUBAREA = ' || V_SUBAREA.[NAME] , 10);
	debug_pipe('V_STREET = ' || V_STREET.[NAME] , 10);
	debug_pipe('V_REGION_CITY = ' || V_REGION_CITY.[NAME] , 10);
	debug_pipe('V_DISTRICT_CITY = ' || V_DISTRICT_CITY.[NAME] , 10);*/
	
	stdio.put_line_buf('<% PLPCALL [PERSONAL_ADDRESS].[NEW#AUTO](
			   '||'%COLLECTION% => ''' 					||this%collection
			    ||''',%PARAM%.P_TYPE => '''				||P_TYPE
			    ||''',%PARAM%.P_ZIP => '''				||P_HOUSE.[ZIP]
				||''',%PARAM%.P_CITY => '''				||V_CITY
				||''',%PARAM%.P_STREET_REF => '''		||V_STREET
				||''',%PARAM%.P_HOUSE_REF => '''		||P_HOUSE
				||''',%PARAM%.P_STRUCT => '''			||1
				||''',%PARAM%.P_HOUSE => '''			||P_HOUSE.[NAME]
				||''',%PARAM%.P_KORPUS => '''			||P_HOUSE.[KORP]
				||''',%PARAM%.P_ADDR_OBJ => '''			||coalesce(V_STREET, V_SUBAREA, V_TOWN, V_CITY, V_DISTRICT_CITY, V_SETTLEMENT, V_DISTRICT, V_REGION_CITY, V_REGION)	
				||''',%VAR%.V_OKTMO_REF=>''' 			||P_HOUSE.[OKTMO]						
				||''') %>');					
	
		
end;
end;
end;
