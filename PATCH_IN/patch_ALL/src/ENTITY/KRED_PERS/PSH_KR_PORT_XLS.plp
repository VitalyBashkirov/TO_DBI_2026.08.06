							cr.[FILIAL].code :depbal,
							null :cli_code,
							coalesce(cr.[CLIENT]->(::CL_ORG)[LONG_NAME],cr.[CLIENT].name) :cli_name,
							decode(cr.[CLIENT]%class,'CL_PRIV','ФЛ',decode(cr.[CLIENT]->(::CL_ORG)[FORMA].CODE,'91','ИП','ЮЛ')) :cli_tp,
							cr.num_dog :dea_code,
							cr.[KIND_CREDIT].name :dea_prod,
							cr.date_begin :fromdate,
							cr.date_ending :todate,
							cr.date_ending-cr.date_begin :srok,
							(select z(::[PRC_SCHEME].[LIB].GetPrcRate(z.[PRC_SCHEME],cr.date_begin)) in cr.[COMISS_ARR] where z.[DEBT].CODE='НЕУЧТЕН_ПРОЦЕНТЫ') :prc_start,
							(select z(::[PRC_SCHEME].[LIB].GetPrcRate(z.[PRC_SCHEME],&GD)) in cr.[COMISS_ARR] where z.[DEBT].CODE='НЕУЧТЕН_ПРОЦЕНТЫ') :prc_now,
							cr.[FT_CREDIT].[CUR_ISO].INT_CUR_SHORT :val_code,
							cr.SUMMA_DOG :dea_sdok,
							null :prol,
							null :dea_risk,
							::[PR_CRED].[PSH_CRED_REP].fGetRiskGr(cr, &GD) :hd_risk,
							::[PR_CRED].[PSH_CRED_REP].fGetRiskPrc(cr, &GD) :res_prc,
							coalesce(tech.ACC.MAIN_V_ID,::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&GD,'ACCOUNT').MAIN_V_ID) :acc_od,
							&BAL(coalesce(tech.ACC.[ARC_MOVE], ::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&GD,'ACCOUNT').[ARC_MOVE])) :bal_od,
							decode(cr.HIGH_LEVEL_CR,null,cr.[VNB_UNUSED_LINE].MAIN_V_ID,null) :acc_lim,
							decode(cr.HIGH_LEVEL_CR,null,&BAL(cr.[VNB_UNUSED_LINE].[ARC_MOVE]),null) :bal_lim,
							cr.[ACC_DEMAND_PRC].MAIN_V_ID :acc_prc,
							&BAL(cr.[ACC_DEMAND_PRC].[ARC_MOVE]) :bal_prc,
							cr.[ACC_DEBTS_CR].MAIN_V_ID :acc_exod,
							&BAL(cr.[ACC_DEBTS_CR].[ARC_MOVE]) :bal_exod,
							decode(cr.HIGH_LEVEL_CR,null,cr.[ACC_DEBTS_PRC].MAIN_V_ID) :acc_exprc,
							decode(cr.HIGH_LEVEL_CR,null,&BAL(cr.[ACC_DEBTS_PRC].[ARC_MOVE])) :bal_exprc,
						  --Башкиров В.Г. 25.01.2019 21:50 Обновление 18.6.07
					      --greatest([PR_CRED].l_2.PeriodDebt(cr, 'ПРОСРОЧ_КРЕДИТ', &GD),[PR_CRED].l_2.PeriodDebt(cr,'ПРОСРОЧ_ПРОЦЕНТЫ',&GD)) :exp_srok,
							coalesce(::[PR_CRED].[PSH_CRED_REP].fGetResAcc(cr.[ACC_DEMAND_PRC], &GD).[MAIN_V_ID] ,ptf.accpc) :acc_resprc,
							decode(ptf.ptf_code,null,&BAL(::[PR_CRED].[PSH_CRED_REP].fGetResAcc(cr.[ACC_DEMAND_PRC], &GD).[ARC_MOVE]),::[PR_CRED].[PSH_CRED_REP].fGetPtfDeaRes(&RBAL(cr.[ACC_DEMAND_PRC].[ARC_MOVE]),ptf.ptf_id,'RESPCN')) :bal_resprc,
							coalesce(expc_r.[RES_ACC].MAIN_V_ID,ptf.accexpc) :acc_resexprc,
							decode(ptf.ptf_code,null,&BAL(expc_r.[RES_ACC].[ARC_MOVE]),::[PR_CRED].[PSH_CRED_REP].fGetPtfDeaRes(&RBAL(cr.[ACC_DEBTS_PRC].[ARC_MOVE]),ptf.ptf_id,'RESEXPCN')) :bal_resexprc,
							decode(ptf.ptf_code,null,coalesce(tech.RES_ACC.MAIN_V_ID,::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&GD,'ACC_RESERV').MAIN_V_ID),ptf.accod) :acc_resod,
							decode(ptf.ptf_code,null,&BAL(coalesce(tech.RES_ACC.[ARC_MOVE],::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&GD,'ACC_RESERV').[ARC_MOVE])),::[PR_CRED].[PSH_CRED_REP].fGetPtfDeaRes(&RBAL(::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&RD,'ACCOUNT').[ARC_MOVE]),ptf.ptf_id,'RESOD')) :bal_resod,
							decode(ptf.ptf_code,null,::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&GD,'ACC_RESERV_DEBTS').MAIN_V_ID,ptf.accex) :acc_resexod,
							decode(ptf.ptf_code,null,&BAL(::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&GD,'ACC_RESERV_DEBTS').[ARC_MOVE]),::[PR_CRED].[PSH_CRED_REP].fGetPtfDeaRes(&RBAL(cr.[ACC_DEBTS_CR].[ARC_MOVE]),ptf.ptf_id,'RESEXOD')) :bal_resexod,
							com.ACC.MAIN_V_ID :acc_com,
							&BAL(com.ACC.[ARC_MOVE]) :bal_com,
							com.RES_ACC.MAIN_V_ID :acc_rescom,
							&BAL(com.RES_ACC.[ARC_MOVE]) :bal_rescom,
							null :com1,
							cr.[VNB_DEMAND_PRC].MAIN_V_ID :acc_vnbprc,
							&BAL(cr.[VNB_DEMAND_PRC].[ARC_MOVE]) :bal_vnbprc,
							cr.[VNB_EXCEED_PRC].MAIN_V_ID :acc_vnbexprc,
							&BAL(cr.[VNB_EXCEED_PRC].[ARC_MOVE]) :bal_vnbexprc,
							--ОБЕСПЕЧЕНИЕ
							decode(cr.HIGH_LEVEL_CR,null,::[KRED_PERS].[PSH_KR_PORT_XLS].fGetMort(cr,'ACC')) :mort_acc,
							decode(cr.HIGH_LEVEL_CR,null,::[KRED_PERS].[PSH_KR_PORT_XLS].fGetMort(cr,'NAME')) :mort_name,
							decode(cr.HIGH_LEVEL_CR,null,(select amnt(sum(round(amnt.[MARKET_SUM].SUMM*f.COURSE(amnt.[MARKET_SUM].[CURR].[JOUR_RECONT],&GD),2))) --Башкиров В.Г. 30.10.2018 ,'Ж','ЕД'),2))) и заменил amnt.[MARKET_SUM].[CURR] на amnt.[MARKET_SUM].[CURR].[JOUR_RECONT]
							in ::[ZALOG] where amnt.[PART_TO_LOAN].PRODUCT=cr and amnt.[MARKET_SUM].DATE_BEG<=&GD and coalesce(amnt.[MARKET_SUM].DATE_END,&MD)>=&GD)) :mort_amnt,
							
							decode(cr.HIGH_LEVEL_CR,null,::[KRED_PERS].[PSH_KR_PORT_XLS].fGetMortAccBal(cr, &GD, '91311')) :a91311,
							decode(cr.HIGH_LEVEL_CR,null,::[KRED_PERS].[PSH_KR_PORT_XLS].fGetMortAccBal(cr, &GD, '91312')) :a91312,
							decode(cr.HIGH_LEVEL_CR,null,::[KRED_PERS].[PSH_KR_PORT_XLS].fGetMortAccBal(cr, &GD, '91315')) :a91315,
							decode(cr.HIGH_LEVEL_CR,null,::[KRED_PERS].[PSH_KR_PORT_XLS].fGetMortAccBal(cr, &GD, '91414')) :a91414,
							
							decode(cr.HIGH_LEVEL_CR,null,::[KRED_PERS].[PSH_KR_PORT_XLS].fGetMort(cr,'KK')) :mort_kk,
							--ОД ПО СРОКАМ
							decode(cr%class||cr.[CLIENT]%class,'OVERDRAFTSCL_ORG',&BAL(coalesce(tech.ACC.[ARC_MOVE],cr.[ACCOUNT].[ARC_MOVE])),f133.F_115_LOAN_VOSTR+f133.F_115_LOAN_1) :od1day,
							f133.F_115_LOAN_2 :od5,
							f133.F_115_LOAN_6 :od10,
							f133.F_115_LOAN_7 :od20,
							f133.F_115_LOAN_8 :od30,
							f133.F_115_LOAN_9 :od90,
							f133.F_115_LOAN_10 :od180,
							f133.F_115_LOAN_11 :od270,
							f133.F_115_LOAN_12 :od1y,
							f133.F_115_LOAN_13 :odmax,
							--Просроченный ОД
							f133.PZ_SUM1+f133.PZ_SUM2 :odex30,
							f133.PZ_SUM_31_90 :odex90,
							f133.PZ_SUM_91_180 :odex180,
							f133.PZ_SUM4 :odexmax,
							::[KRED_PERS].[PSH_KR_PORT_XLS].itog_prosr_180(cr, &GD) :itodex_180,
							--Просроченные %%
							f133.PZ_PRC1+f133.PZ_PRC2 :pcnex30,
							f133.PZ_PRC3 :pcnex90,
							f133.PZ_PRC31 :pcnex180,
							f133.PZ_PRC4 :pcnexmax,
							case
							when f133.PZ_PRC4+f133.PZ_SUM4>0 then 12
							when f133.PZ_PRC31+f133.PZ_SUM_91_180>0 then 11
							when f133.PZ_PRC3+f133.PZ_SUM_31_90>0 then 10
							when f133.PZ_SUM1+f133.PZ_SUM2+f133.PZ_PRC1+f133.PZ_PRC2>0 then 9
							end :ex115_col,
							case
							when f133.PZ_PRC4+f133.PZ_SUM4+f133.PZ_PRC31+f133.PZ_SUM_91_180+f133.PZ_PRC3+f133.PZ_SUM_31_90+f133.PZ_SUM1+f133.PZ_SUM2+f133.PZ_PRC1+f133.PZ_PRC2 > 0 then &BAL(cr.[ACCOUNT].[ARC_MOVE])+&BAL(cr.[ACC_DEBTS_CR].[ARC_MOVE])
							end :f115_21_28_31_34,
							case
							when f133.PZ_PRC4+f133.PZ_SUM4+f133.PZ_PRC31+f133.PZ_SUM_91_180+f133.PZ_PRC3+f133.PZ_SUM_31_90+f133.PZ_SUM1+f133.PZ_SUM2+f133.PZ_PRC1+f133.PZ_PRC2 > 0 then &BAL(cr.[ACC_DEMAND_PRC].[ARC_MOVE])+&BAL(cr.[ACC_DEBTS_PRC].[ARC_MOVE])+&BAL(com.ACC.[ARC_MOVE])+&BAL(pen.ACC.[ARC_MOVE])
							end :f115_27_36,
							--------------
							coalesce(cr.[CLIENT].OKATO_CODE,::[REPS_SUBJRF].[SLIB].GetSubjectClient(cr.[CLIENT],&GD).CODE) :okato,
							::[CLIENT].[LIB].Get_Main_OKVED(cr.[CLIENT],&GD).CODE :okved,--ОКВЭД
							cr.[CLIENT]->(::CL_ORG)[REGISTER].GOS_REG_NUM_REC :ogrn,--ОГРН
							&BAL(cr.[ACCOUNT].[ARC_MOVE])-(decode(cr%class||cr.[CLIENT]%class,'OVERDRAFTSCL_ORG',&BAL(coalesce(tech.ACC.[ARC_MOVE],cr.[ACCOUNT].[ARC_MOVE])),f133.F_115_LOAN_VOSTR+f133.F_115_LOAN_1)+f133.F_115_LOAN_2+f133.F_115_LOAN_6+f133.F_115_LOAN_7 + f133.F_115_LOAN_8+f133.F_115_LOAN_9+f133.F_115_LOAN_10+f133.F_115_LOAN_11+f133.F_115_LOAN_12+f133.F_115_LOAN_13) :delta_od,
							&BAL(cr.[ACC_DEBTS_CR].[ARC_MOVE])-(f133.PZ_SUM1+f133.PZ_SUM2+f133.PZ_SUM_31_90+f133.PZ_SUM_91_180+f133.PZ_SUM4) :delta_odex,
							null :delta_mort,
							--::[CLIENT].[PSH_CLI_REP].fGetDispFl(cr.[CLIENT],'ИН',&GD) :ins,
							--::[CLIENT].[PSH_CLI_REP].fGetGrpFl(cr.[CLIENT],'SMALL',&GD) :msb,
							ptf.ptf_code :ptf,
							null :prevend,
							(select p(p.[OBJ_CRED].SYS_NAME) in cr.[OBJECTS_CRED] where p.[OBJ_CRED].SYS_NAME like '[%' and rownum=1) :purp,
							case
							when f133.PZ_SUM_91_180+f133.PZ_SUM4+f133.PZ_PRC31+f133.PZ_PRC4 > 0 then &BAL(cr.[VNB_EXCEED_PRC].[ARC_MOVE])
							else 0
							end :f115_spr,
							pen.ACC.MAIN_V_ID :acc_pen,
							&BAL(pen.ACC.[ARC_MOVE]) :bal_pen,
							pen.RES_ACC.MAIN_V_ID :acc_respen,
							&BAL(pen.RES_ACC.[ARC_MOVE]) :bal_respen,
							--::[CLIENT].[PSH_CLI_REP].fGetDispFl(cr.[CLIENT],'СЛ',&GD) :wrk,
							cr.[CLIENT_REQ].[1].[2].[MAIN_V_ID] :acc_rashet,
							&BAL(cr.[CLIENT_REQ].[1].[2].[ARC_MOVE]) :bal_rashet,
							cr.[CLIENT_REQ].[1].[2].[ARC_MOVE] :vip_rashet,
							::[KRED_PERS].[PSH_KR_PORT_XLS].fGetResLimAcc(cr).MAIN_V_ID :LimResAcc,
							&BAL(::[KRED_PERS].[PSH_KR_PORT_XLS].fGetResLimAcc(cr).[ARC_MOVE]) :LimResBal,
							::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&GD,'ACC_GP').[MAIN_V_ID] :accgp,
							&BAL(::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr, &GD, 'ACC_GP').[ARC_MOVE]) :balgp,
							::[PR_CRED].[PSH_CRED_REP].fGetResAcc(::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&GD,'ACC_GP'), &GD).[MAIN_v_ID] :accgpres,
							&BAL(::[PR_CRED].[PSH_CRED_REP].fGetResAcc(::[PR_CRED].[PSH_CRED_REP].fGetDeaMainAcc(cr,&GD,'ACC_GP'), &GD).[ARC_MOVE]) :accgpresbal
							)
							in ::[PR_CRED],
							(::[RES_BASE_ACCS] all :expc_r),
							(select tech(tech%collection :collection_id,tech.[ACCOUNT_DOG].[1].[2] :ACC,tech_r.[RES_ACC] :RES_ACC)
							in ::[HOZ_OP_ACC],(::[RES_BASE_ACCS] all :tech_r) all
							where tech.[NAME_ACCOUNT].COD='ACCOUNT_TECH' and tech_r.ACC(true)=tech.[ACCOUNT_DOG].[1].[2]),
							(select com(com%collection :collection_id,com.[ACCOUNT_DOG].[1].[2] :ACC,com_r.RES_ACC :RES_ACC)
							in ::[HOZ_OP_ACC],(::[RES_BASE_ACCS] all :com_r) all
							where com.[NAME_ACCOUNT].COD='ACC_DEMAND_COM' and com_r.ACC(true)=com.[ACCOUNT_DOG].[1].[2]),
							(select pen(pen%collection :collection_id,pen.[ACCOUNT_DOG].[1].[2] :ACC,pen_r.[RES_ACC] :RES_ACC)
							in ::[HOZ_OP_ACC],(::[RES_BASE_ACCS] all :pen_r) all
							where pen.[NAME_ACCOUNT].COD='ACC_DEMAND_PEN' and pen_r.ACC(true)=pen.[ACCOUNT_DOG].[1].[2]),
							(select ptf(ptf%id :ptf_id,ptf.NUM_DOG :ptf_code,ptf.[CREDITS].[PR_CRED] :cred,(select r(r.[ACCOUNT_DOG].[1].[2].MAIN_V_ID) in ptf.[ARRAY_DOG_ACC] where r.[NAME_ACCOUNT].COD='ACC_RESERV') :accod, (select r(r.[ACCOUNT_DOG].[1].[2].MAIN_V_ID) in ptf.[ARRAY_DOG_ACC] where r.[NAME_ACCOUNT].COD='ACC_RESERV_DEBTS') :accex,
							::[PR_CRED].[PSH_CRED_REP].fGetPotAcc(ptf,&GD,'ACC_DEMAND_PRC').MAIN_V_ID :accpc,
							::[PR_CRED].[PSH_CRED_REP].fGetPotAcc(ptf,&GD,'ACC_DEBTS_PRC').MAIN_V_ID :accexpc)
							in ::[SIM_LOAN_PORT] all
							where ptf.[CREDITS].DATE_BEGIN <= &RD and (ptf.[CREDITS].DATE_END is null or ptf.[CREDITS].DATE_END > &RD)),
							(select f133(
							f133.[CRED_DOG] :dea_id,
							f133.F_115_LOAN_VOSTR :F_115_LOAN_VOSTR,
							f133.F_115_LOAN_1 :F_115_LOAN_1,
							f133.F_115_LOAN_2 :F_115_LOAN_2,
							f133.F_115_LOAN_6 :F_115_LOAN_6,
							f133.F_115_LOAN_7 :F_115_LOAN_7,
							f133.F_115_LOAN_8 :F_115_LOAN_8,
							f133.F_115_LOAN_9 :F_115_LOAN_9,
							f133.F_115_LOAN_10 :F_115_LOAN_10,
