-- запись лога выполнения операции
public procedure write_log (job_name string, str MEMO_BIG) is
rec ref [PSH_LOCAL_JOB]; -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
	begin
     	locate rec in ::[PSH_LOCAL_JOB] where rec.[CODE]=job_name;  -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
     	rec.[TEXT_LIST].[PSH_CFB_NEW](null,false,false,sysdate,rtrim(ltrim(str))); -- updated CHANGE_SHORT_NAME CFB_NEW->PSH_CFB_NEW 15/10/25
    exception when OTHERS then  exit;
	end;	
	
--Список Email группы
public function get_email_list_for_group(job_name string) return string is
rec ref [PSH_LOCAL_JOB];  -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
vRet string;
Begin
   begin
     	locate rec in ::[PSH_LOCAL_JOB] where rec.[CODE]=job_name;  -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
      exception when OTHERS then  exit;
	end;	
	for f in rec.[CLIENT_LIST] where f.[EMAIL] loop
		for (select t(t.[NUMB] :Email) in f.[CLIENT_REF].[CONTACTS] all where t.[TYPE].[CODE] = 'MAIL' and t.[PRIVATE].[CODE] = 'CFB_BANK')
		loop vRet:=vRet||t.Email||';';end loop;
	end loop;
return vRet;	

end;	
	
-- рассылка уведомлений
public  procedure send_info_jobs_email is
	begin
		for j in ::[PSH_LOCAL_JOB] all where     exists (select r(1) in j.[TEXT_LIST] all where nvl(r.[EMAIL],false) = false)  -- updated CHANGE_QUALIFIER PSB_LOCAL_JOB->PSH_LOCAL_JOB 09/10/25
		                                     and exists (select r(1) in j.[CLIENT_LIST] all where nvl(r.[EMAIL],false) = true)
			loop
			    for m in j.[TEXT_LIST] all where nvl(m.[EMAIL],false) = false
				    loop
				        for u in j.[CLIENT_LIST] all where nvl(u.[EMAIL],false) = true
					        loop
					            for c in u.[CLIENT_REF].[CONTACTS] all where c.[TYPE].[CODE] = 'MAIL' and c.[PRIVATE].[CODE] = 'CFB_BANK' and c.[NUMB] is not null
						            loop
						                begin
						                    /* ::[RUNTIME].[SMTP_MAIL].send_mail(c.[NUMB],j.[NAME],m.[TEXT],null, true, true);*/
						                    ::[FP_INTERFACE].[PRX_PCORE].Send_Mail(c.[NUMB],j.[NAME],m.[TEXT],null, true, true);
						                    null;
						                exception when OTHERS then write_log('JOB_SENDMAIL','Ошибка '||j.[NAME]||' '||u.[CLIENT_REF].[NAME]); end;
						            end loop;
					        end loop;
				        m.[EMAIL] := true;
				    end loop;
			end loop;
	end;




public  function is_it_work_db return boolean
is
res BOOLEAN DEFAULT FALSE;
v_instance_name varchar2;
begin
	select x(x.INSTANCE_NAME)
	in v$instance%rowtype
	into v_instance_name;
IF v_instance_name='IBSO' THEN res := TRUE; END IF;
return res;
end;	




public function GetPhoneNumber
/*	Функция для получения номера телефона клиента */
(
	p_CONTACTS	[CONTACTS_ARR]
	/*	Массив контактов клиента */
) return varchar2(100) is 
	v_ret_value			varchar2(100);
	v_prev_num_comm		number := null;
	v_prev_num_own		number := null;
	v_new_num_comm		number := null;
	v_new_num_own		number := null;
begin
	for(
		select x(	x.[NUMB]	:	C_NUM, x.[TYPE].[CODE] : C_TYPE_CODE, x.[PRIVATE] : C_PRIVATE)
		in p_CONTACTS all
		where x.[TYPE] in (::[COMUNICATION]([CODE] = 'PHONE'), ::[COMUNICATION]([CODE] = 'MOBILEPHONE'))
		order by  x.[ACTIV] desc -- сначала действующие контакты
				, x.[PRIVATE].[CODE]
	)loop
		v_new_num_comm := coalesce(::[FP_TUNE].[LIB].GET_NUM_VALUE('COMMUNICATION_PRIORITY',::[FP_TUNE].[LIB].SET_CANONS('<COMMUNICATION_TYPE>',to_char(x.C_TYPE_CODE)),'0'),99);
		v_new_num_own := coalesce(::[FP_TUNE].[LIB].GET_NUM_VALUE('OWNER_COM_PRIORITY',::[FP_TUNE].[LIB].SET_CANONS('OWNER_COM',to_char(x.C_PRIVATE)),'0'),99);
		if v_prev_num_comm is null or v_prev_num_comm >= v_new_num_comm then
			if v_prev_num_own is null or v_prev_num_own > v_new_num_own then
				v_ret_value := x.C_NUM;
			end if;
		end if;
		v_prev_num_comm := v_new_num_comm;
		v_prev_num_own := v_new_num_own;
	end loop;
	return v_ret_value;
end;
end;
