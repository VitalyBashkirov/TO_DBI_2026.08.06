begin
	ft_usd := ::[FT_MONEY]([CUR_SHORT]='USD');
exception when others then
	pragma error('Невозможно найти валюту USD');
end;

public function actual_accountant_name(acc	ref [AC_FIN], OnDate [DATE] default [SYSTEM].[OP_DATE]) return [STRING_100] is 
Cl ref [CLIENT];
begin
	if acc.[CLIENT_R] is not null then Cl:=acc.[CLIENT_R];
	else							   Cl:=acc.[CLIENT_V];
	end if;
	
	/** /
	for lih in Cl.[LOAN_INS_HISTORY]
	where nvl(lih.[DATE_BEGIN],OnDate)<=OnDate and OnDate<=nvl(lih.[END_DATE],OnDate)
	loop
		debug_pipe('.actual_accountant_name -- OnDate='||to_char(OnDate,fmt)||
			' lih.[DATE_BEGIN]='||to_char(lih.[DATE_BEGIN],fmt)||
			' lih.[END_DATE]='||to_char(lih.[END_DATE],fmt)||
			' '||lih.[INSPECTOR].[NAME]
			,0);
		return lih.[INSPECTOR].[NAME];
	end loop;
	/*
	for (select lih(lih.[INSPECTOR].[NAME] : C_INSPECTOR_NAME) in Cl.[LOAN_INS_HISTORY]
	where nvl(lih.[DATE_BEGIN],OnDate)<=OnDate and OnDate<=nvl(lih.[END_DATE],OnDate))
	loop
		return lih.C_INSPECTOR_NAME;
	end loop;
	*/

	-->> VRI 18/02/2025 CFT-928 Среднемесячные остатки по счетам
	-- ФИО клиентского менеджера
	for (select u(analytic(max(u.[NAME]), 'keep (dense_rank last order by [1]) ', u.[OPER_DATE]) fio)
		in ::[CL_INFO_USER],
		  (::[CL_INFO_REQ] : inf) all
			where inf.[CL_WORK_USERS] = u%collection
				and u.[PERSON_TYPE] = ::[MARK_PERS_G]([CODE] = 'ACC_MANAGER')
				and inf.[CLIENT] = Cl
		)
	loop
		return u.fio;
	end loop; 	
	--<< VRI 18/02/2025 CFT-928
	
	return null;
end;
pragma restrict_references(actual_accountant_name,wnds,wnps,trust);

public function GetDocAllCnt(acc ref [ac_fin], TypePayment number, dBeg [DATE_TIME] default trunc([SYSTEM].[OP_DATE]), dEnd [DATE_TIME] default trunc([SYSTEM].[OP_DATE]+1)) return number is 
n number:=0;
begin
	if trunc(dBeg)=trunc(dEnd) then dEnd:=trunc(dBeg)+1; end if;
	for (select am(am.[DOC].[ACC_DT] 			      : C_MD_ACC_DT,
		    SubStr(am.[DOC].[ACC_KT].[MAIN_V_ID],1,1) : C_MD_ACC_KT_7,
		    SubStr(am.[DOC].[ACC_KT].[MAIN_V_ID],1,5) : C_MD_ACC_KT_40101,
		    SubStr( am.[DOC].[KL_KT].[2].[1],1,5) 	  : C_MD_KL_KT_2_1_40101,
		    SubStr( am.[DOC].[KL_KT].[1].[2].[MAIN_V_ID] ,1,5) : C_MD_KL_KT_1_2_40101,
	   nvl(am.[DOC].[KOD_NAZN_PAY].[KOD_NAZN],'null') : C_KOD_NAZN)
			in acc.[ARC_MOVE] where dBeg<=am.[DATE] and am.[DATE]<dEnd)
	loop
		if    TypePayment= 0 																						    then n:=n+1; 		--Всего док. за период
		elsif TypePayment= 1 then if not (am.C_MD_ACC_KT_7='7' or am.C_KOD_NAZN like 'RECONT%')                         then n:=n+1; end if;--Платежей за период
		elsif TypePayment= 2 then if     (am.C_MD_ACC_KT_7='7' and am.C_KOD_NAZN not like 'RECONT%')                    then n:=n+1; end if;--Комиссий за период
		elsif TypePayment= 3 then if not (am.C_MD_ACC_KT_7='7' or am.C_KOD_NAZN like 'RECONT%') and acc =am.C_MD_ACC_DT then n:=n+1; end if;--Дебетовых док. за период
		elsif TypePayment= 4 then if not (am.C_MD_ACC_KT_7='7' or am.C_KOD_NAZN like 'RECONT%') and acc<>am.C_MD_ACC_DT then n:=n+1; end if;--Кедитовых док. за период
		
		elsif TypePayment=20 then if  	 (am.C_MD_ACC_KT_40101='40101' or am.C_MD_KL_KT_2_1_40101='40101' or am.C_MD_KL_KT_1_2_40101='40101') then n:=n+1; end if; --Док. в бюджет за период
		end if;
	end loop;
	if n=0 then n:=null; end if;
	return n;
end;
pragma restrict_references(GetDocAllCnt,wnds,wnps,trust);

public function GetDocAllSum(acc ref [ac_fin], TypePayment number, dBeg [DATE_TIME] default trunc([SYSTEM].[OP_DATE]), dEnd [DATE_TIME] default trunc([SYSTEM].[OP_DATE]+1)) return [SUMMA] is 
s [SUMMA]:=0;
begin
	if trunc(dBeg)=trunc(dEnd) then dEnd:=trunc(dBeg)+1; end if;
	debug_pipe('.GetDocAllSum -- acc.'||acc||'='||acc.[MAIN_V_ID]||' TypePayment='||TypePayment||' dBeg='||to_char(dBeg,fmt)||' dEnd='||to_char(dEnd,fmt),dp);
	for (select am(am.[DOC].[ACC_DT] 			      : C_MD_ACC_DT,
		    SubStr(am.[DOC].[ACC_KT].[MAIN_V_ID],1,1) : C_MD_ACC_KT_7,
		    SubStr(am.[DOC].[ACC_KT].[MAIN_V_ID],1,5) : C_MD_ACC_KT_40101,
		    SubStr( am.[DOC].[KL_KT].[2].[1],1,5) 	  : C_MD_KL_KT_2_1_40101,
		    SubStr( am.[DOC].[KL_KT].[1].[2].[MAIN_V_ID] ,1,5) : C_MD_KL_KT_1_2_40101,
	   nvl(am.[DOC].[KOD_NAZN_PAY].[KOD_NAZN],'null') : C_KOD_NAZN,
				   am.[DOC].[SUM] 					  : C_SUM,
				   am.[DOC].[SUM_PO] 				  : C_SUM_PO,
				   am.[DOC].[SUM_NT] 				  : C_SUM_NT)
			in acc.[ARC_MOVE] where dBeg<=am.[DATE] and am.[DATE]<dEnd)
	loop
		debug_pipe('.GetDocAllSum -- TypePayment='||TypePayment||' am.C_MD_ACC_DT='||am.C_MD_ACC_DT||' am.C_SUM='||am.C_SUM||' am.C_SUM_PO='||am.C_SUM_PO||' am.C_MD_ACC_KT_7='||am.C_MD_ACC_KT_7||' am.C_KOD_NAZN='||am.C_KOD_NAZN,dp);
		if    TypePayment= 0 																						    then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0);			--Сумма Всего за период
		elsif TypePayment= 1 then if not (am.C_MD_ACC_KT_7='7' or am.C_KOD_NAZN like 'RECONT%')                         then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0); end if;	--Сумма Платежей за период
		elsif TypePayment= 2 then if     (am.C_MD_ACC_KT_7='7' and am.C_KOD_NAZN not like 'RECONT%')           		    then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0); end if;	--Сумма Комиссий за период
		elsif TypePayment= 3 then if not (am.C_MD_ACC_KT_7='7' or am.C_KOD_NAZN like 'RECONT%') and acc =am.C_MD_ACC_DT then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0); end if;	--Сумма Дт за период
		elsif TypePayment= 4 then if not (am.C_MD_ACC_KT_7='7' or am.C_KOD_NAZN like 'RECONT%') and acc<>am.C_MD_ACC_DT then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0); end if;	--Сумма Кт за период

		elsif TypePayment=10 																						    then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(am.C_SUM_NT,nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0));		 --Сумма в нац. Всего за период
		elsif TypePayment=11 then if not (am.C_MD_ACC_KT_7='7' or am.C_KOD_NAZN like 'RECONT%')                         then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(am.C_SUM_NT,nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0)); end if; --Сумма в нац. Платежей за период
		elsif TypePayment=12 then if     (am.C_MD_ACC_KT_7='7' and am.C_KOD_NAZN not like 'RECONT%')           		    then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(am.C_SUM_NT,nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0)); end if; --Сумма в нац. Комиссий за период
		elsif TypePayment=13 then if not (am.C_MD_ACC_KT_7='7' or am.C_KOD_NAZN like 'RECONT%') and acc =am.C_MD_ACC_DT then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(am.C_SUM_NT,nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0)); end if; --Сумма в нац. Дт за период
		elsif TypePayment=14 then if not (am.C_MD_ACC_KT_7='7' or am.C_KOD_NAZN like 'RECONT%') and acc<>am.C_MD_ACC_DT then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(am.C_SUM_NT,nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0)); end if; --Сумма в нац. Кт за период

		elsif TypePayment=20 then if  	 (am.C_MD_ACC_KT_40101='40101' or am.C_MD_KL_KT_2_1_40101='40101' or am.C_MD_KL_KT_1_2_40101='40101') then debug_pipe('.GetDocAllSum -- '||TypePayment,dp); s:=s+nvl(am.C_SUM_NT,nvl(iif(am.C_MD_ACC_DT=acc,am.C_SUM_PO,am.C_SUM),0)); end if; --Сумма в бюджет за период
		end if;
	end loop;
	
	if s=0 then s:=null; end if;
	return s;
end;

public function GetCEO(acc ref [AC_FIN], OnDate [DATE] default [SYSTEM].[OP_DATE], TypeInfo number default 0) return string(1000) is 
Cl ref [CLIENT];
ClCorp ref [CL_CORP];
ClPart ref [CL_PART];
ClPriv ref [CL_PRIV];
CodeDepart [STRING_20];
ExStr string(1000);
PhoneStr string(1000);

nn number:=0;
begin
	if acc.[CLIENT_R] is not null then Cl:=acc.[CLIENT_R];
	else							   Cl:=acc.[CLIENT_V];
	end if;

	if TypeInfo in (4) then -- 4-Класс клиента
		return Cl%class;
	end if;
			
	if    Cl%class in ('CL_ORG','CL_BANK_N','CL_BANK_F') then ClCorp:=Cl;
	elsif Cl%class = 'CL_PART' then ClPart:=Cl; ClCorp:=ClPart.[BANK]; --debug_pipe('CL_PART -- '||ClCorp.[NAME],0); --47422840203000000005
	elsif Cl%class = 'CL_PRIV' then ClPriv:=Cl;
		if TypeInfo in (0,1) then -- 0-ФИО  1-телефон
			if TypeInfo=0 then
				null; --ExStr:=Substr(ClPriv.[NAME]||LF$,1,ExStr%size);
			elsif TypeInfo=2 then
				ExStr:=Substr(ExStr||::[PSH_LOCAL_JOB].[PSH_LIB].GetPhoneNumber(ClPriv.[CONTACTS])||LF$,1,ExStr%size); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 14/10/25
			end if;
		elsif TypeInfo in (3) then -- 3-Москва/Саратов
			CodeDepart:=acc.[DEPART].[CODE];
			if    CodeDepart like '001-61%' then ExStr:='Саратов';
			elsif CodeDepart like '001-62%' then ExStr:='Энгельс';
			elsif CodeDepart like '101%'    then ExStr:='Энгельс';
			else  ExStr:='Москва';
			end if;
		end if;
		return ExStr;
	else
		ExStr:='Ош. Класс клиента '||Cl%class;
		return ExStr;
	end if;
	
	if TypeInfo in (0,1) then -- 0-ФИО ГенДир 1-телефон ГенДир
		for ab in ClCorp.[ALL_BOSS]
		where ab.[CHIEF]
			and (ab.[WORK_END] is null or OnDate<=ab.[WORK_END])
		loop
			if TypeInfo=0 then
				ExStr:=Substr(ExStr||ab.[FASE].[NAME]||LF$,1,ExStr%size);
			elsif TypeInfo=1 then
				ExStr:=Substr(ExStr||::[PSH_LOCAL_JOB].[PSH_LIB].GetPhoneNumber(ab.[FASE].[CONTACTS])||LF$,1,ExStr%size); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 14/10/25
			end if;
		end loop;
	elsif TypeInfo in (2) then -- 2-ФИО учредителя (тел.XXX)
		for fndr in ClCorp.[REGISTER].[FOUNDERS]
		where (fndr.[DATE_END] is null or OnDate<=fndr.[DATE_END])
		order by fndr.[PERCENT] desc
		loop
			nn:=nn+1;
			PhoneStr:=Substr(::[PSH_LOCAL_JOB].[PSH_LIB].GetPhoneNumber(fndr.[FOUNDER].[CONTACTS]),1,ExStr%size); -- updated CHANGE_SHORT_NAME PSB_LIB->PSH_LIB 14/10/25
			if Length(PhoneStr)>0 then
				PhoneStr:=Substr(' (тел.'||PhoneStr||')',1,ExStr%size);
			end if;
			ExStr:=Substr(ExStr||fndr.[FOUNDER].[NAME]||PhoneStr||LF$,1,ExStr%size);
		end loop;
	elsif TypeInfo in (3) then -- 3-Москва/Саратов
		CodeDepart:=acc.[DEPART].[CODE];
		if    CodeDepart like '001-61%' then ExStr:='Саратов';
		elsif CodeDepart like '001-62%' then ExStr:='Энгельс';
		elsif CodeDepart like '101%'    then ExStr:='Энгельс';
		else  ExStr:='Москва';
		end if;
	end if;

	if nn>1 then
		ExStr:=Substr('['||nn||']'||ExStr,1,ExStr%size);
	end if;
	return trim(trim(ExStr,Chr(10)),Chr(13));
end;
pragma restrict_references(GetCEO,wnds,wnps,trust);
end;
