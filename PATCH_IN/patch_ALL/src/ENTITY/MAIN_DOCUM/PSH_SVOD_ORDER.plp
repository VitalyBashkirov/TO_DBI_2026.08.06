class MAIN_DOCUM;

@import_plsql(true)
@name('ПСХ. Сводный банковский ордер (OOXML)')
@tag('COPIED')
batch method PSH_SVOD_ORDER is
public type rec is record ( gr number, doc	ref [MAIN_DOCUM]);  -- составной тип


public type tbl_t is table of rec;  -- табличный тип
public grDocs tbl_t;



public type tbl_doc is table of ref [MAIN_DOCUM];  -- табличный тип
public docs tbl_doc; -- массив документов

pragma macro(xl,'[OOXML]::[API_XL]');

procedure Get_docs(PROV [BOOLEAN],
			patt_dt [ACCNUM],
			patt_kt [ACCNUM],
			P_DATE_PROV date,
			P_USER ref [USER],
			P_OTV_DT  ref [USER],
			P_OTV_KT ref [USER],
			P_FILIAL ref [BRANCH],
			P_DEPART ref [DEPART])
is
gr 			integer;
patt		varchar2(100);
new_patt	varchar2(100);
i			integer;
begin
	grDocs.Delete;
	gr := 0;
	patt := '***';
	i := 0;
	if patt_dt <> '%' and patt_kt <> '%' then	

		for md in ::[MAIN_DOCUM] where
  			md%state = 'PROV' and
			nvl(md.[KL_DT].[2].[1], md.[ACC_DT]->(true)[MAIN_V_ID]) like PATT_DT and
			nvl(md.[KL_KT].[2].[1], md.[ACC_KT]->(true)[MAIN_V_ID]) like PATT_KT and
			md.[DATE_PROV] >= P_DATE_PROV and
			md.[DATE_PROV] < P_DATE_PROV + 1 and
			(md.[DOCUMENT_USER] = P_USER or P_USER is null) and
			(md.[ACC_DT]->(true)[OTV] = P_OTV_DT or P_OTV_DT is null) and
			(md.[ACC_KT]->(true)[OTV] = P_OTV_KT or P_OTV_KT is null) and
			md.[FILIAL] = P_FILIAL  and
			(md.[DEPART] = P_DEPART or P_DEPART is null)
			order by md.[VALUTA], md.[document_num]
		loop
			new_patt := md.[VALUTA].[CUR_SHORT];
			if new_patt <> patt then
				gr := gr + 1;	
				patt := new_patt;
			end if;
			grDocs(i).gr := gr;
			grDocs(i).doc := md;
			i := i + 1;
		end loop;
	else
		pragma hint ('index (a1 idx_z#MAIN_DOCUM_DATE_PROV)');
		for md in ::[MAIN_DOCUM] where
  				md%state = 'PROV' and
			md.[NUM_DT] like PATT_DT and
			md.[DATE_PROV] >= P_DATE_PROV and
			md.[DATE_PROV] < P_DATE_PROV + 1 and
			md.[NUM_KT] like PATT_KT and
			(md.[DOCUMENT_USER] = P_USER or P_USER is null) and
			(md.[ACC_DT]->(false)[OTV] = P_OTV_DT or P_OTV_DT is null) and
			(md.[ACC_KT]->(false)[OTV] = P_OTV_KT or P_OTV_KT is null) and
			md.[FILIAL] = P_FILIAL  and
			(md.[DEPART] = P_DEPART or P_DEPART is null)
			order by md.[VALUTA], md.[document_num]
		loop
			new_patt := md.[VALUTA].[CUR_SHORT];
			if new_patt <> patt then
				gr := gr + 1;	
				patt := new_patt;
			end if;
			grDocs(i).gr := gr;
			grDocs(i).doc := md;
			i := i + 1;
		end loop;
	end if;
end;


PSH_SVOD_ORDER (
	@name('Дата')                           P_DATE      in [DATE],
	@name('Филиал')                         P_FILIAL    in [BRANCH_REF],
	@name('Подразделение')                  P_DEPART    in [DEPART_REF],
	@name('Первая подпись')                 P_BOSS1     in [USER_REF],
	@name('Вторая подпись')                 P_BOSS2     in [USER_REF],
	@name('Номер сводного П/П')             P_NUM       in [NUM10],
	@name('Ответственный по счету дебета')  P_DT_USER   in [USER_REF],
	@name('Ответственный по счету кредита') P_KT_USER   in [USER_REF],
	@name('Создано пользователем')          P_CR_USER   in [USER_REF],
	@name('Только проведенные')             P_ONLY_PROV in [BOOLEAN],
	@name('Назначение платежа')             P_NAZN      in [STRING_500],
	@name('Шаблон выборки документа')       P_TEMPL     in [STRING_200]
) is

validate is
type sum_val_t is table of [SUMMA] index by string;
type accounts_t is table of number index by string;



procedure DrawReestr(docs tbl_doc, Sheet number) is
idx		integer;
nRow	integer;
rDoc	ref [MAIN_DOCUM];
iFormat integer;
iBorder	integer;
iFont	integer;

nSum	[SUMMA];
nSumNt	[SUMMA];


bFirst 		boolean;
rCurrency	ref [FT_MONEY];
str_idx		[STRING];


sum_val 	sum_val_t;
v_summa		[SUMMA];
v_val_name	[STRING];
v_summa_str	varchar2(512);
i	integer;

v_stamp			varchar2(512);
v_adds			varchar2(2000);
rDepart			ref [DEPART];
sCode			varchar2(25);
sVidDoc			varchar2(8);
nPrioritet		number;

acc_dts		accounts_t;
acc_kts		accounts_t;	
acc			string;


begin
	&xl.AddCopySheet('SVOD', 'SVOD'||to_char(Sheet));
	&xl.AddCopySheet('Reestr', 'Reestr'||to_char(Sheet));

	&xl.Open_Sheet('Reestr'||to_char(Sheet));
	nRow := 0;
	iFormat := &xl.get_numFmt('#################0.00');
	iBorder := &xl.get_border(&xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
	acc_dts.Delete;
	acc_kts.Delete;
	
	iFont	:= &xl.get_font
		( p_name			== 'Calibri'
		, p_family			== 2
		, p_fontsize		== 10
		, p_theme			== 1
		, p_underline		== false
		, p_italic			== false
		, p_bold			== false
		, p_rgb				== null
		);
		
	nSum := 0;
	nSumNt := 0;
	bFirst := true;
	idx := docs.first;
	while idx is not null loop
	
		nRow := nRow + 1;
		rDoc := docs(idx);
		
		if bFirst then
			bFirst := false;
			rCurrency := rDoc.[VALUTA];
			rDepart := rDoc.[DEPART];
			::[MAIN_DOCUM].[MD_OTHERS].SetCounter(::[NAME_PAYDOC]([code]='СВОД_ПЛ_ПОРУЧ'), P_NUM, true, true, false, null, null, rDepart);
			sVidDoc := rDoc.[vid_doc].[short_code];
			nPrioritet := rDoc.[prioritet];

			[STR].set_par(v_adds, 'STAMP_DATE', to_char(P_DATE, 'DD/MM/RRRR'));			
			[STR].set_par(v_adds, 'STAMP_USER', stdlib.user_id.[name]);
			v_stamp := ::[PRINT_ATTR_VALUE].[PRINT_LIB].get_field_by_code(rDoc, 'STAMP', null, v_adds);
		end if;		
		
		-- Счета в дебете
		acc := substr(nvl(rDoc.[KL_DT].[2].[1], rDoc.[ACC_DT].[MAIN_V_ID]), 1, 8);
		if not acc_dts.exists(acc) then
			acc_dts(acc) := 0;
		end if;
		
		-- Счета в кредите
		acc := substr( nvl(rDoc.[KL_KT].[2].[1], rDoc.[ACC_KT].[MAIN_V_ID]), 1, 8);
		if not acc_kts.exists(acc) then
			acc_kts(acc) := 0;
		end if;
		
		v_summa := nvl(rDoc.[SUM], 0);
		if v_summa = 0 then
			v_summa := nvl(rDoc.[SUM_PO], 0);
			v_val_name := rDoc.[VALUTA_PO].[CUR_SHORT];
		else
			v_val_name := rDoc.[VALUTA].[CUR_SHORT];
		end if;
		if  v_val_name is not null then
			if  sum_val.exists(v_val_name) then
				sum_val(v_val_name) := nvl(sum_val(v_val_name), 0) + v_summa;
			else
				sum_val(v_val_name) :=  v_summa;				
			end if;
		end if;

		nSum := nSum + rDoc.[SUM];
		nSumNt := nSumNt + rDoc.[SUM_NT];

		&xl.Write(2+nRow, 2, rDoc.[VID_DOC].[SHORT_CODE] , null, null, 10, null, 'M'); -- Вид

		&xl.Write(2+nRow, 3, rDoc.[DOCUMENT_NUM], null, null, 10, null, 'M'); -- Номер документа

		&xl.Write(2+nRow, 4, to_char(rDoc.[DATE_PROV], 'dd.mm.yyyy'), null, null, 10, null, 'M'); -- Дата
		&xl.Write(2+nRow, 5, nvl( rDoc.[KL_DT].[2].[1], rDoc.[ACC_DT].[MAIN_V_ID]), null, null, 10, null, 'M'); -- Счет Дт
		&xl.Write(2+nRow, 6, nvl( rDoc.[KL_KT].[2].[1], rDoc.[ACC_KT].[MAIN_V_ID]), null, null, 10, null, 'M'); -- Счет Кт
		
		&xl.cell
			( 2+nRow
			, 7
			, rDoc.[Sum]
			, iFormat
			, iFont
			, null
			, iBorder
			, &xl.xl_av_center
			, &xl.xl_ah_right
			);
		&xl.Write(2+nRow, 8, rDoc.[VALUTA].[CUR_SHORT], null, null, 10, null, 'M');

		&xl.cell
			( 2+nRow
			, 9
			, rDoc.[Sum_nt]
			, iFormat
			, iFont
			, null
			, iBorder
			, &xl.xl_av_center
			, &xl.xl_ah_right
			);
		
		idx := docs.next(idx);
	end loop;

	iBorder := &xl.get_border(&xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
	&xl.Set_format_range(3, 2,  3+nRow, 9, p_BorderID == iBorder);  -- Границы для таблицы

	&xl.Write(3+nRow, 2, 'Итого  '||to_char(nRow)||' документов', null, null, 12, null, 'MС');
	&xl.Merge(3+nRow, 2, 3+nRow,9);

	iBorder := &xl.get_border(&xl.xl_b_none, &xl.xl_b_none, &xl.xl_b_thin, &xl.xl_b_thin);
	&xl.Set_format_range(3+nRow, 2,  3+nRow, 9, p_BorderID == iBorder);  -- Границы для таблицы

	i := 0;
	str_idx := sum_val.first;
	while str_idx is not null loop
		-- Сумма строкой
		v_summa_str := str_idx|| ' '||to_char(sum_val(str_idx), '99,999,999,990.00')||' ('||STDLIB.N2STR( sum_val(str_idx), str_idx)||')';
		&xl.Write(4+nRow+i, 2, v_summa_str, null, null, 12, null, 'MС', true);
		&xl.Merge(4+nRow+i, 2, 4+nRow+i,9);
		iBorder := &xl.get_border(&xl.xl_b_none, &xl.xl_b_none, &xl.xl_b_thin, &xl.xl_b_thin);
		&xl.Set_format_range(3+nRow+i, 2,  3+nRow+i, 9, p_BorderID == iBorder);  -- Границы для таблицы
		&xl.set_row_height(30, 4+nRow+i);
		str_idx := sum_val.next(str_idx);
		i := i + 1;
	end loop;

	iBorder := &xl.get_border(&xl.xl_b_none, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
	&xl.Set_format_range(3+nRow+i, 2,  3+nRow+i, 9, p_BorderID == iBorder);  -- Границы для таблицы
	&xl.Write(5+nRow+i, 5, 'М.П.', null, null, 10, null, 'MС');

	&xl.Merge(6+nRow+i, 2, 6+nRow+i, 4);
	&xl.Write(6+nRow+i, 2, p_boss1.[casta].[value], null, null, 10, null, 'MС', true);
	&xl.Write(6+nRow+i, 6, ::[RUNTIME].[STDLIB].fio(p_boss1.[NAME],'Ф И. О.'));
	
	&xl.Merge(8+nRow+i, 2, 8+nRow+i, 4);
	&xl.Write(8+nRow+i, 2, p_boss2.[casta].[value], null, null, 10, null, 'MС', true);
	&xl.Write(8+nRow+i, 6, ::[RUNTIME].[STDLIB].fio(p_boss2.[NAME],'Ф И. О.'));
	
	&xl.Write(1, 2, 'РЕЕСТР ДОКУМЕНТОВ  к сводному банковскому ордеру № '||P_NUM||' дата ' || to_char(P_DATE, 'dd.mm.yyyy'), null, null, 10, null, 'CM');
	
	

	-- Печатаем сводник -----------------------------------------------------
	&xl.Open_Sheet('SVOD'||to_char(Sheet));

	&xl.Write(3, 10, p_num, null, null, 10, null, 'CM');
	&xl.Write(3, 18, to_char(p_date, 'dd.mm.yyyy'), null, null, 10, null, 'CM');
	&xl.Write(7, 6, STDLIB.N2STR(nSum, rCurrency.[CUR_SHORT]), null, null, 10, null, 'LT', true);
	&xl.Write(7,31, sVidDoc, null, null, 10, null, 'LT', true);
	&xl.Write(10,31, nPrioritet, null, null, 10, null, 'LT', true);
	
	&xl.Write(15,1, 'Разные', null, null, 10, null, 'LT', true); -- Плательщик
	&xl.Write(21,1, 'Разные', null, null, 10, null, 'LT', true); -- Получатель
	
	-- Счета в дебете
	acc := '';
	bFirst := true;
	str_idx := acc_dts.first;
	while str_idx is not null loop
		if bFirst then
			acc := str_idx;
			bFirst := false;
		else
			acc := acc || ', ' || str_idx;
		end if;
		str_idx := acc_dts.next(str_idx);
	end loop;
	
	&xl.Write(15,13, acc, null, null, 10, null, 'LT', true); --
	

	-- Счета в кредите
	str_idx := acc_kts.first;
	acc := '';
	bFirst := true;
	while str_idx is not null loop
		if bFirst then
			acc := str_idx;
			bFirst := false;
		else
			acc := acc || ', ' || str_idx;
		end if;
		str_idx := acc_kts.next(str_idx);
	end loop;
	&xl.Write(21,13, acc, null, null, 10, null, 'LT', true); --
	
	if rCurrency = ::[SYSTEM].[VARIABLES].NatCur then
		&xl.Write(15, 22, [PRINTFUN].PrintNumSumm(nSum) , null, null, 10, null, 'RT', true); --
	else
		&xl.Write(15, 22, [PRINTFUN].PrintNumSumm(nSumNt) , null, null, 10, null, 'RT', true); --
		&xl.Write(15, 29, [PRINTFUN].PrintNumSumm(nSum) , null, null, 10, null, 'RT', true); --
	end if;
	
	&xl.Write(27, 1, p_nazn , null, null, 10, null, 'LT', true); --
	&xl.Write(28, 29, v_stamp, null, null,9, null, 'CT', true);
end;


	xl_out		blob		:= empty_blob();
	gr			number;
	vRepId		string;
	patt_dt		string;
	patt_kt		string;
	
	
Begin
	if P_MESSAGE = 'DEFAULT' then

		P_DATE := trunc(::[SYSTEM].[OP_DATE]);
		P_NUM := 1;
		P_FILIAL := StdLib.user_id.filial;
		P_DEPART := null;
		P_TEMPL := '423% | %';
		p_nazn := 	'Списание сумм начисленных процентов на счета депозитов физических лиц (вклады) ';

		P_BOSS1 := StdLib.user_id;	
		P_BOSS2 := ::[CL_CORP].[EDIT_ANKETA].get_chief_user(::[SYSTEM].[VARIABLES].OurDepart, 'DEPART_BOSS');

	elsif P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'P_DATE'and P_DATE is null	then
			pragma error('Введите отчетную дату');
		elsif P_INFO = 'CANCEL' then
			null;
		elsif P_INFO = 'OK' then
			
			if p_filial is null then
				pragma error('Укажите филиал');
			end if;
			
			patt_dt := trim(substr(p_templ, 1, instr(p_templ, '|')-1));
			patt_kt := trim(substr(p_templ, instr(p_templ, '|')+1));
			
			Get_docs(true, patt_dt, patt_kt, p_date, P_CR_USER, P_DT_USER, P_KT_USER, P_FILIAL, P_DEPART);

            [SHABLON_DOC]::[LIB_OOXML].load_blob('PSH_SVOD_BO',xl_out);
			If not [OOXML]::[API_XL].open_file(xl_out) Then				
				pragma error('Ошибка преобразования шаблона !');
			End If;

			docs.Delete;
			gr := 0;
			var Sheet number;
			Sheet := 0;

			for idx in 0..grDocs.count-1 loop
				if gr<>0 and grDocs(idx).gr<>gr then
					Sheet := Sheet + 1;
	    			DrawReestr(Docs, Sheet);
					Docs.Delete;
				end if;
				
				gr := grDocs(idx).gr;
				Docs(Docs.Count) := grDocs(idx).doc;
			end loop;

			-- Последняя группа
			if Docs.Count > 0 then
				Sheet := Sheet + 1;
				DrawReestr(Docs, Sheet);
			end if;
			
			if Sheet > 0 then
				&xl.delSheet('Reestr');
				&xl.delSheet('SVOD');
			end if;

			&xl.finish(xl_out);		
			-- Отправка файла отчёта пользователю на клиентскую машину
			vRepId	:= [OOXML]::[API_ORSA].putReport2Run(xl_out,'xlsx','Сводный банковский ордер № '||P_NUM||' за '||to_char(P_DATE,'dd-mm-yyyy'));
			
			Docs.Delete;
			grDocs.Delete;
		end If;
	end if;
End;

execute is

begin
   Null;
end;
end;
end;
