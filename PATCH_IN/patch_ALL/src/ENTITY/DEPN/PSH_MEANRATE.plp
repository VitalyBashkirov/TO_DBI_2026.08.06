class DEPN;

@import_plsql(true)
@name('[ПСБ] Среднехронологическая % ставка по счетам клиентов')
@tag('COPIED')
static method PSH_MEANRATE is
function GetOrCreateAnalyticCode(p_rep ref [REPS], p_code string, p_name string, p_shablon string(32000)) return ref [ANALYTIC_CODE] is
	anc ref [ANALYTIC_CODE];
begin
	begin
		locate anc in ::[ANALYTIC_CODE] where anc.[CODE] = p_code and anc.[FORM] = p_rep and anc%collection is null;
	exception when no_data_found then
	
		anc := ::[ANALYTIC_CODE].[NEW#AUTO](
			 P_FORM == p_rep					--Форма
			,P_CODE	== p_code					--Код признака
			,P_NAME	== p_name					--Наименование признака
			,P_NUMBER_VALUE == null				--Числовой признак
		);
		
		if length(trim(p_shablon)) > 0 then
			anc.[ACC_PATTERN].[NEW#AUTO](
				 P_PRODUCT == ::[PATTERN_PRODUCT](CODE='AC_FIN')		--Категория шаблона
				,P_PATTERN == p_shablon				--Шаблон счёта
				,P_OR_DOWN == true					--Используется
			);
		end if;
	end;
	return anc;
end;

-- Вернуть % ставку по счету депозита или РКО
public function getRateForAccount(p_acc ref [AC_FIN], p_date date) return number is
	dep ref [DEPN];
	rk	ref [RKO];
	rate number:=0;
begin
	select x(
				case 
					when b is null then ::[PRC_SCHEME].[LIB].GetPrcRate(::[DEPN].[LIB_CALC_PRC].GetPrcSchem(x, p_date), p_date)	
					else b.[PRC]
				end						: rate
	   ) 
	in ::[DEPN], (::[STRING_CALC_PRC] all: b) all
	where x.[ACCOUNT] = p_acc
		and b%collection(true) = x.[JOUR_CALC_PRC]
		and b.[DATE_BEG](true) <= p_date
		and b.[DATE_END](true) >= p_date
		and rownum = 1
	into rate;
	
	return nvl(rate,0);
	
exception when no_data_found then
	begin
		select x(
					case 
						when b is null then 
							(select y(::[PRC_SCHEME].[LIB].GetPrcRate(y.[PRC], p_date)) 
								in x.[PRC_DURING] all 
								where y.[DATE_BEG] <= p_date
		       					  and nvl(y.[DATE_END], p_date) >= p_date
								  and y.[TYPE] = ::[VID_OPER_DOG]([CODE]='ОСНОВНАЯ_СХЕМА')
								  and rownum = 1)	
						else b.[PRC]
					end														: rate
		   ) 
		in ::[RKO], (::[STRING_CALC_PRC] all: b) all
		where x.[ACCOUNT] = p_acc
			and b%collection(true) = x.[JOUR_CALC_PRC]
			and b.[DATE_BEG](true) <= p_date
			and b.[DATE_END](true) >= p_date
			and rownum = 1
		into rate;
		
	exception when no_data_found then
		null;
	end;
	
	return nvl(rate,0);
end;
PSH_MEANRATE (
	@name('Дата начала')      P_DATE1     in [DATE],
	@name('Дата окончания')   P_DATE2     in [DATE],
	@name('Счет для отладки') P_ACC_DEBUG in [ACCNUM],
	@name('Суммы в тыс.руб.') P_THOUSAND  in [BOOLEAN]
) is

validate is
begin
	if p_message = 'DEFAULT' then
		p_date1 := trunc(::[SYSTEM].[OP_DATE],'Q'); -- первый день текущего квартала
		p_date2 := ::[SYSTEM].[OP_DATE];
		P_ACC_DEBUG := null;
		P_THOUSAND := true;
	end if;
end;

execute is
pragma macro(xl,'[OOXML]::[API_XL]');
pragma macro(lib_ooxml,'::[SHABLON_DOC].[LIB_OOXML]');
pragma macro(width, '[OOXML]::[API_XL].set_column_width([1], iCol, iCol); iCol:=iCol+1;', substitute);

-- быстрое получение остатка по счету в SQL-запросах
/*
pragma macro(acc_saldo, '
	case when [1].[DATE_LAST] <= [2] then [1].[SALDO]
		else nvl(
				(select	xx( 
					xx.[START_SUM] : START_SUM
				) in (
					select  cc( cc.[START_SUM] : START_SUM
					) in	::[RECORDS] all
					where	cc%collection = [1].[ARC_MOVE]
						and cc.[DATE] >= [2]
					order by cc.[DATE], cc.[STAMP], cc%id
				) where rownum <= 1)
			, [1].[SALDO])
	end	
', substitute); */

-- быстрое получение остатка по счету в SQL-запросах в нац.покрытии
pragma macro(acc_saldo_nt, '
	case when [1].[DATE_L_NT] <= [2] then [1].[SALDO_NT]
		else nvl(
				(select	xx( 
					xx.[START_SUM_NAT] : START_SUM_NAT
				) in (
					select  cc( cc.[START_SUM_NAT] : START_SUM_NAT
					) in	::[RECORDS] all
					where	cc%collection = [1].[ARC_MOVE]
						and cc.[DATE] >= [2]
					order by cc.[DATE], cc.[STAMP], cc%id
				) where rownum <= 1)
			, [1].[SALDO_NT])
	end	
', substitute);

--pragma macro(acc_saldo_nt, 'f.a_saldo_short([2], [1], ''С'', p_in_nat==true)', substitute);


iRow		integer;
iCol		integer;
nn			integer;
days_in_year integer;
fmt			string := 'dd.mm.yyyy';
AllDebt		number := 0;
AllPrc		number := 0;
prev_code	string :=' ';
glen		number := 3;
rep		ref [REPS] := ::[REPS](CODE='F_113');
--an5		ref [ANALYTIC_CODE];
unit		number;
unit_str	string;

--iFmt1	integer:= &xl.get_numFmt('@');
iFmt2	integer:= &xl.get_numFmt('#,##0.00');


begin
	unit := case when P_THOUSAND then 1000 else 1 end;
	unit_str := case when P_THOUSAND then 'тыс.руб.' else 'руб.' end;

	GetOrCreateAnalyticCode(rep, 'ПСБ_ПАСС_5', 'Средства клиентов - всего', '');
	/*
		'20309,20310,30220,30223,30227,30601,30606, 40101,40105,40106,40116,402,40301,40302,40306,40307,40312,
		404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,
		47401,47418,476,521,522,52403,52404 
		!40908,47606,47607,47608,47609,47611'
	);*/
	
	GetOrCreateAnalyticCode(rep, 'ПСБ_ПАСС_5.1', 'Депозиты и средства на счетах нефинансовых и финансовых (кроме кредитных) организаций', '');
	
	GetOrCreateAnalyticCode(rep, 'ПСБ_ПАСС_5.1.0', 'Депозиты нефинансовых и финансовых (кроме кредитных) организаций', 
		'414,415,416,417,418,419,420,421,422,425,431,432,433,434,435,436,437,438,439,440,47601,47602,47610,521,52403'
	);
	
	GetOrCreateAnalyticCode(rep, 'ПСБ_ПАСС_5.1.1', 'Cредства нефинансовых и финансовых (кроме кредитных) организаций на счетах', 
		'405,406,407,408
		!40803,40810,40813,40817,40820,40821,40823,40824,40826'
	);
	
	GetOrCreateAnalyticCode(rep, 'ПСБ_ПАСС_5.2', 'Депозиты и средства на счетах Минфина России, органов местного самоуправления, бюджетов, государственных и других внебюджетных фондов', 
		'40101,40105,40106,40116,402,40301,40302,40306,40307,40312,404,410,411,412,413,427,428,429,430'
	);
	
	GetOrCreateAnalyticCode(rep, 'ПСБ_ПАСС_5.3', 'Cредства клиентов в расчетах', 
		'30220,30223,30601,30606,40821,409
		!40908,40909,40910,40912,40913'
	);
	
	GetOrCreateAnalyticCode(rep, 'ПСБ_ПАСС_5.4', 'Вклады физических лиц', 
		'40803,40813,40817,40820,40823,40824,40826,423,426,47603,47605,522,52404'
	);
	
	GetOrCreateAnalyticCode(rep, 'ПСБ_ПАСС_5.5', 'Средства клиентов по факторинговым, форфейтинговым операциям', '47401' );
	
	/*  -- запрос для получения списка прочих счетов клиентов, для п.5.6.
	
	select c_pattern 
	from z#ACC_PATTERN  
	where collection_id in (
	    select c_PATT_NORMAL
	    from z#ANALYTIC_CODE
	    where c_code like 'ПСБ_ПАСС_5'
	)
	
	minus
	
	select c_pattern 
	from z#ACC_PATTERN  
	where collection_id in (
	    select c_PATT_NORMAL
	    from z#ANALYTIC_CODE
	    where c_code like 'ПСБ_ПАСС_5_%'
	    )
	*/
	
	GetOrCreateAnalyticCode(rep, 'ПСБ_ПАСС_5.6', 'Прочие счета клиентов', '20309,20310,30227,47418'); -- счет 476 исключен вручную
	
	&lib_ooxml.xl_init();
	
	nn := P_DATE2 - P_DATE1 + 1; -- Количество дней в периоде
	days_in_year := ::[DEPN].[LIB_CALC_IRR].getDaysCalendarForPSV(p_DateBeg == P_DATE1, p_DateEnd == P_DATE2); -- Количество дней в году
	
	-- Заполним DUMMY количеством дней в периоде
	::[DUMMY].[FILL_IT](nn);
	
	----------------
	iRow := iRow+1;
	
	
	for(
		select distinct x(
			replace(ana.[CODE], 'ПСБ_ПАСС_','')	: code,
			ana.[NAME]							: name,
			x.dat								: dat,
			--x.bal								: bal,
			x.cnt								: cnt,
			x.saldo_nt							: saldo_nt,
			x.sum_prc							: sum_prc
		)
		in (
	
			select x(
				x.code											: code,
				x.subCode										: subCode,
				x.subSubCode									: subSubCode,
				x.dat											: dat,
				--x.bal											: bal,
				sum(x.cnt_active)								: cnt,
				nvl(sum(x.saldo_nt),0)							: saldo_nt,
				nvl(sum(x.saldo_nt*x.rate/(100*days_in_year)),0): sum_prc
			)
			in (
			
			-- Все счета клиентов
			select x(
				
				[STR].piece( replace(an.[CODE],'ПСБ_ПАСС_',''), '.', 1)	: code,
				
				[STR].piece( replace(an.[CODE],'ПСБ_ПАСС_',''), '.', 2)	: subCode,
				
				[STR].piece( replace(an.[CODE],'ПСБ_ПАСС_',''), '.', 3)	: subSubCode,
				
				d.dat						: dat,
				
				substr(x.[MAIN_V_ID],1,5)	: bal,
				
				case when x.[DATE_OP]<=d.dat and (x.[DATE_CLOSE] is null or x.[DATE_CLOSE] >= d.dat) then 1 else 0 end
											: cnt_active,
				
				&acc_saldo_nt(x, d.dat) 	: saldo_nt,
				
				case 
					when an.[CODE] in ('ПСБ_ПАСС_5.1.0','ПСБ_ПАСС_5.1.1','ПСБ_ПАСС_5.4') then
						getRateForAccount(x, d.dat)
					else 0
				end							: rate
					
			)
			in ::[AC_FIN],
			(::[ANALYTIC_CODE]	all : an ),
			(::[ACC_PATTERN]	all	: ap ),
			(::[ACC_PATTERN]	all	: pn ),
			(select d(P_DATE1+rownum-1 : dat) in ::[DUMMY] where rownum<=nn) all
			where an.[CODE] like 'ПСБ_ПАСС_5%'
			  and an.[FORM] = rep
			  and an.[ACC_PATTERN]+0 = ap%collection
			  and an.[PATT_NORMAL]+0 = pn%collection
			  and x.[MAIN_V_ID] like pn.[PATTERN]||'%'
			  and not exists
				(	select patt(null)
					in an.[ACC_PATT_EXCLUDE]
					where	patt.[OR_DOWN]
						and patt.[REF_PARENT] = ap
						and x.[MAIN_V_ID] like patt.[PATTERN]||'%'
				)
			  and x.[DATE_OP] <= P_DATE2
			  and (x.[DATE_CLOSE] is null or x.[DATE_CLOSE] >= P_DATE1)
			  and (P_ACC_DEBUG is null or x.[MAIN_V_ID] like trim(P_ACC_DEBUG)||'%')	  
			)
			group by grouping_sets (set(x.code, x.subCode, x.subSubCode, x.dat), -- x.bal), 
									set(x.code, x.subCode, x.dat), 
									set(x.code, x.dat))
								
		),
		(::[ANALYTIC_CODE] all : ana)
		where ana.[FORM] = rep
		  and ana.[CODE] like 'ПСБ_ПАСС_'||x.code|| 
		  								   case when x.subCode is null then '' else '.'||x.subCode end ||
		  								   case when x.subSubCode is null then '' else '.'||x.subSubCode end
		order by 1,2,3
	)loop
	
		if x.dat = P_DATE1 and x.code != prev_code then
			--
			&xl.new_sheet(x.code);
			&xl.Open_Sheet(x.code);
			&xl.Put(1, 1, x.code||'.  '||x.name);
			&xl.Put(2, 1, 'Расчет средней ставки за период: '||to_char(P_DATE1,fmt)||' - '||to_char(P_DATE2,fmt));
			AllDebt=AllPrc:=0;
			--
			iRow := 10;
			iCol := 1;
			&xl.Put(iRow, iCol, 'Дата'); 									&width(11) 
			&xl.Put(iRow, iCol, 'Колич-во счетов');							&width(10)
			&xl.Put(iRow, iCol, 'Сальдо, '||unit_str);						&width(15)
			&xl.Put(iRow, iCol, 'Сумма начисленных процентов, '||unit_str);	&width(15)
			&xl.Put(iRow, iCol, 'Ср. % ставка');							&width(11)
			iRow := iRow+1;
		end if;
	
		&xl.Put( iRow, 1, to_char(x.dat,fmt));
		&xl.Put( iRow, 2, x.cnt);
		&xl.cell( iRow, 3, round(x.saldo_nt/unit,2), p_numFmtId == iFmt2); 
		&xl.cell( iRow, 4, round(x.sum_prc/unit,2), p_numFmtId == iFmt2); 
		&xl.cell( iRow, 5, case when x.saldo_nt!=0 then round(x.sum_prc*100*days_in_year/x.saldo_nt,3) else 0 end, p_numFmtId == iFmt2);
		--&xl.Put( iRow, 6, x.bal); 
		iRow := iRow+1;
		if x.dat in (P_DATE1, P_DATE2) then 
			AllDebt := AllDebt + x.saldo_nt/2; 
		else
			AllDebt := AllDebt + x.saldo_nt;
		end if; 
		AllPrc := AllPrc + x.sum_prc;
		
		if x.dat = P_DATE2 then
			AllDebt := AllDebt / (nn-1); -- Среднехронологич.остаток
			
			iRow := 4;
			&xl.Put(iRow, 1, 'Дней в периоде / дней в году : ');
			&xl.Put(iRow, 5, nn||' / '||days_in_year);
			
			iRow := iRow+1;	
			&xl.Put(iRow, 1, 'Средний хронологический остаток по счетам, '||unit_str);
			&xl.cell(iRow, 5, round(AllDebt/unit, 2), p_numFmtId == iFmt2);
			
			iRow := iRow+1;	
			&xl.Put(iRow, 1, 'Сумма начисленных процентов, '||unit_str);
			&xl.cell(iRow, 5, round(AllPrc/unit, 2), p_numFmtId == iFmt2);
			
			iRow := iRow+1;	
			&xl.Put(iRow, 1, 'Ставка привлечения, % годовых');
			&xl.cell(iRow, 5, case when AllDebt!=0 then round((AllPrc/AllDebt) * (days_in_year/nn) * 100, 3) else 0 end, p_numFmtId == iFmt2);
			
			if P_ACC_DEBUG is not null then
				iRow := iRow+1;	
				&xl.Put(iRow, 1, 'Показаны данные только по счету: ');
				&xl.Put(iRow, 5, P_ACC_DEBUG);
			end if;
		end if;
		prev_code := x.code;
	end loop;
	
	&xl.delSheet(1);
	
	&lib_ooxml.xl_finish(p_description == &METHOD$NAME);
end;
end;
end;
