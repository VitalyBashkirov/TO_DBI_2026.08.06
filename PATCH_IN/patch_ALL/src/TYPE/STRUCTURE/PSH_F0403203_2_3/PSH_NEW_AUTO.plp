class PSH_F0403203_2_3;

@name('[ПСБ] Добавить')
@tag('CREATED')
constructor PSH_NEW_AUTO is
PSH_NEW_AUTO (
	@name('Код')                 P_CODE      in [STRING_8],
	@name('Наименование кода')   P_CODE_NAME in [STRING_500],
	@name('Расшифровка кода')    P_NAME      in [STRING_1200],
	@name('Вид операции')        P_VID_CODE  in [STRING_8],
	@name('Дата начала')         P_DATE_BEG  in [DATE],
	@name('Дата окончания')      P_DATE_END  in [DATE],
	@name('Класс клиента')       P_CL_CLASS  in [STRING_128],
	@name('Количество операций') P_OP_COUNT  in [SHORT8],
	@name('Сумма операций')      P_OP_SUM    in [SUMMA],
	@name('Дата расчета')        P_CALC_DATE in [DATE_TIME]
) return ref [PSH_F0403203_2_3] is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_CODE := this.[CODE];
	P_CODE_NAME := this.[CODE_NAME];
	P_NAME := this.[NAME];
	P_VID_CODE := this.[VID_CODE];
	P_DATE_BEG := this.[DATE_BEG];
	P_DATE_END := this.[DATE_END];
	P_CL_CLASS := this.[CL_CLASS];
	P_OP_COUNT := this.[OP_COUNT];
	P_OP_SUM := this.[OP_SUM];
	P_CALC_DATE := this.[CALC_DATE];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Код"
	[CODE] := P_CODE;
	-- Установка значения реквизита "Наименование кода"
	[CODE_NAME] := P_CODE_NAME;
	-- Установка значения реквизита "Расшифровка кода"
	[NAME] := P_NAME;
	-- Установка значения реквизита "Вид операции"
	[VID_CODE] := P_VID_CODE;
	-- Установка значения реквизита "Дата начала"
	[DATE_BEG] := P_DATE_BEG;
	-- Установка значения реквизита "Дата окончания"
	[DATE_END] := P_DATE_END;
	-- Установка значения реквизита "Класс клиента"
	[CL_CLASS] := P_CL_CLASS;
	-- Установка значения реквизита "Количество операций"
	[OP_COUNT] := P_OP_COUNT;
	-- Установка значения реквизита "Сумма операций"
	[OP_SUM] := P_OP_SUM;
	-- Установка значения реквизита "Дата расчета"
	[CALC_DATE] := P_CALC_DATE;
end;
end;
end;
