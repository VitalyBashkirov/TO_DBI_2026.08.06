-- Получение пользователя, работающего с клиентом
public function get_cl_info_user(code ::[VID_OPER_DOG].[CODE]%type, collection_id [CL_INFO_USER_ARR], event_date date) return string(350) is 
begin
	if collection_id is not null then
		for (	select x(x.[NAME] : name, x.[CASTA_NAME] : casta)
				in collection_id
				where	x.[PERSON_TYPE].[CODE] = code
					and trunc(x.[OPER_DATE]) <= trunc(event_date)
					and	x.[OPER_TYPE].[CODE] = 'FIRST_ACCOUNT_OPEN'
				order by x.[OPER_DATE]
			)
		loop
			return x.name || bool_char(x.casta is not null, ', '||x.casta, '');
		end loop;
		return null;
	else
		return null;
	end if;
end;

-- Получение подразделения пользователя, работающего с клиентом, в родительном падеже
function get_cl_depart(code ::[VID_OPER_DOG].[CODE]%type, collection_id [CL_INFO_USER_ARR], event_date date) return ::[DECLENSION].[NAME]%type is
begin
	for (	select x(d : depart)
			in collection_id, (::[DEPART] : d)
			where	x.[PERSON_TYPE].[CODE] = code
				and d.[CODE] = x.[DEPART_CODE]
				and	trunc(x.[OPER_DATE]) <= trunc(event_date)
			order by x.[OPER_DATE] desc
		)
	loop
		return ::[DEPART].[LIB].get_declension(x.depart);	
	end loop;		
	return null;
end;

public function get_date_upd(cl ref [CLIENT], on_date date default trunc(sysdate) ) return date is 
	is_auto		boolean;
	last_date	date;
	value		varchar2(4000);
	cl_hist_ref ref [CL_HIST];
begin
	is_auto := ::[CL_CORP].[EDIT_ANKETA].is_auto_fill_date_upd( nvl(on_date, trunc(sysdate)) );
	if is_auto then
		last_date := ::[LEGAL_INTERFACE].[PRX_CLIENT].cl_hist_get_last_date(cl, on_date);
		return last_date;
	else
		cl_hist_ref := ::[LEGAL_INTERFACE].[PRX_CLIENT].cl_hist_get_value(cl, 'DATE_FORM_UPD', on_date + 1, value);
		if cl_hist_ref is not null then
			return value;
		else
			return CL.[DATE_FORM_UPD];
		end if;
	end if;
	return null;
end;

-- Получает номер миграционной карты
function migr_card_str (CLIENT_ID in ref [CL_PRIV]) return string(100) is
ans string(100) := null;
begin
	select migr( migr.[CARD_NUM] : CARD_NUM )
	in		CLIENT_ID.[MIGR_CARD]
	where	migr.[DATE_BEG] <= op_dat
			and migr.[DATE_END] >= op_dat
			and rownum = 1
	into ans;
	return ans;
exception
	when NO_DATA_FOUND then
		return null;
end;

/**********************************************************
Функция возвращает паспортные данные клиента - физ лица.
**********************************************************/
function Get_passport(p_cl [CL_PRIV]) return string is
doc [CERTIFICATE];
begin
	doc := p_cl.[DOC];
	if doc.[TYPE] is not null then
	 	return doc.[TYPE].[NAME]||
	 		   bool_char(doc.[SER] is null, null, ' '||doc.[SER])||
 			   bool_char(doc.[NUM] is null, null, ' №'||doc.[NUM])||
			   bool_char(doc.[DATE]is null, null, '  выдан '||to_char(doc.[DATE],'dd/mm/yyyy'))||
			   bool_char(doc.[WHO] is null, null, ' '||doc.[WHO])||
			   bool_char(doc.[DEPART_CODE] is null, null, ' код подр. '||doc.[DEPART_CODE]);
	elsif doc.[WHO] is not null then
		return doc.[WHO];
	end if;
end;

/*************************************************************
 Функция возвращает всех учредителей организации через запятую
**************************************************************/
procedure Get_FOUNDERS_PSH(p_cl [CL_CORP], p_used_length in integer, p_founders out [MEMO_32767], p_err out boolean, p_founder_counter out integer, p_date in date default ::[SYSTEM].[VARIABLES].OpDate) is
	available_length integer := 32500 - p_used_length;
	adding_str [MEMO_32767];
    v_out [MEMO_32767];
begin
	p_founder_counter := 0;
	for fonder in p_cl.[REGISTER].[FOUNDERS] where fonder.[FOUNDER]%class='CL_PRIV' --физики
 												and ((fonder.[DATE_BEG] is null or fonder.[DATE_BEG] <= p_date))
												and ((fonder.[DATE_END] is null or fonder.[DATE_END] >= p_date))
	    loop
		p_founder_counter := p_founder_counter + 1;
        client_priv:=fonder.[FOUNDER];

--debug_pipe('!cl_link '||fonder.[FOUNDER].[NAME]||fonder.[FOUNDER]%class||Get_passport(client_priv)||client_priv.[DOC].[BIRTH_PLACE]|| nvl(::[RUNTIME].[VIEWFUN].DAT_STR(client_priv.[DATE_PERS]), ''),0);

        adding_str := to_char(p_founder_counter)||'. Доля (в %%): '||fonder.PERCENT||'. '||client_priv.NAME||', '||' адрес регистрации: '||GetAddress(client_priv.[ADDRESSES],'ALL','REGISTRATION');
		adding_str := adding_str || ', '||'адрес фактический: '||GetAddress(client_priv.[ADDRESSES],'ALL','REAL_LIVE');
        adding_str := adding_str || ', '||Get_passport(client_priv);
        adding_str := adding_str || ', '||'место рождения: '|| client_priv.[DOC].[BIRTH_PLACE];
        adding_str := adding_str || ', '||'дата рождения: '||nvl(::[RUNTIME].[VIEWFUN].DAT_STR(client_priv.[DATE_PERS]),'')||chr(13);

        if length(adding_str) > available_length then
			p_founders := substr(rtrim(p_founders),1,length(p_founders)-2);
			p_founder_counter := p_founder_counter-1;
			p_err := true;
			return;
		else
			available_length := available_length - length(adding_str);
		end if;

		p_founders := p_founders || adding_str;
        end loop;
	p_founders := substr(rtrim(p_founders),1,length(p_founders)-2);

	for fonder in p_cl.[REGISTER].[FOUNDERS] where fonder.[FOUNDER]%class='CL_ORG' --юрики
 												and ((fonder.[DATE_BEG] is null or fonder.[DATE_BEG] <= p_date))
												and ((fonder.[DATE_END] is null or fonder.[DATE_END] >= p_date))
	    loop

		p_founder_counter := p_founder_counter + 1;
        client_org:=fonder.[FOUNDER];

        --debug_pipe('',0);

        adding_str := chr(13)||to_char(p_founder_counter)||'. Доля (в %%): '||fonder.PERCENT||'. '||client_org.NAME||', '||'ОГРН: '||
                                          nvl(client_org.[REGISTER].[GOS_REG_NUM_REC], client_org.[REGISTER].[NUM_REESTR]);
        adding_str := adding_str || ', '||'Дата регистрации: '||    rtl.bool_char(client_org.[REGISTER].[DATE_REESTR] is not null,
		 								'Дата внесения в ЕГРЮЛ до 1 июля 2002 года: '||
		 								::[RUNTIME].[VIEWFUN].DAT_STR(client_org.[REGISTER].[DATE_REESTR]),
		 								rtl.bool_char(client_org.[REGISTER].[DATE_REG] is not null,
		 								::[RUNTIME].[VIEWFUN].DAT_STR(client_org.[REGISTER].[DATE_REG]), ''));
        adding_str := adding_str || ', '||'ИНН '||client_org.[INN];
        adding_str := adding_str || ', '||'ОКПО '||client_org.[KOD_OKPO];

        adding_str := adding_str || ', '||'адрес юридический: '||GetAddress(client_org.[ADDRESSES],'ALL','CORP');
		adding_str := adding_str || ', '||'адрес фактический: '||GetAddress(client_org.[ADDRESSES],'ALL','FACT');

	for
	(
		select dolg
		(
			dolg.[RANGE].[VALUE]: 	d_range,
			dolg.[FASE].[NAME]:		d_name
		)
	in client_org.[ALL_BOSS]	
	where dolg.[FASE] is not null and dolg.CHIEF
/*************
		  nvl(dolg.[WORK_BEGIN],op_dat) <= op_dat and
		  nvl(dolg.[WORK_END],op_dat) >= op_dat
*******/
	)
	loop

		adding_str := adding_str||', '||rtrim(dolg.d_range) || ' ' || rtrim(dolg.d_name);
	end loop;

        if length(adding_str) > available_length then
			p_founders := substr(rtrim(p_founders),1,length(p_founders)-2);
			p_founder_counter := p_founder_counter-1;
			p_err := true;
			return;
		else
			available_length := available_length - length(adding_str);
--			p_founders := p_founders||to_char(p_founder_counter)||'. '||client_priv.Name||','||chr(13);
		end if;

		p_founders := p_founders || adding_str;
        end loop;
--	p_founders := substr(rtrim(p_founders),1,length(p_founders)-2);
	p_founders := substr(rtrim(p_founders),1,length(p_founders));

end;

function GetPDLStr(	  p_pdl_ref		ref [IPDL_TYPE]
					, p_pdl_type	::[IPDL_CATEGORY].[PDL_TYPE]%type
					)return varchar2(32000)
is
v_ret GetPDLStr%type;
begin
	select c(analytic(listagg(c.[CATEGORY].[NAME], ','), 'within group (order by [1])', c.[CATEGORY].[NAME]))
	in p_pdl_ref.[CATEGORY_LIST]
	where c.[CATEGORY].[PDL_TYPE] = p_pdl_type or c.[CATEGORY].[PDL_TYPE] is null or p_pdl_type is null
	into v_ret;
	
	return v_ret;
	
end;

function GetAddProps(pOnDate date, pCode string) return string(4000) is
str string(4000);
rec ref [PROPERTIES];
begin
	if client_corp%id is null then
		return null;
	end if;
	pOnDate := trunc(nvl(pOnDate, sysdate));
	begin
		locate rec in client_corp.[ADD_PROP]
			where	rec.[GROUP_PROP].[CODE] = pCode
					and nvl(rec.[DATE_BEG], pOnDate) <= pOnDate
					and nvl(rec.[DATE_END], pOnDate) >= pOnDate;
		str := trim(substr(rec.[STR], 1, str%size));
	exception
		when NO_DATA_FOUND then null;
	end;
	
	return str;
end;

function GetAddPropVal (p_client ref [CLIENT], p_prop_code varchar2(64), P_DATE_PRINT date) return varchar2(4000)
is

v_temp_str varchar2(4000);

begin
		v_temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
		for dop in p_client.[ADD_PROP]
		 		where Upper(dop.[GROUP_PROP].[CODE])=Upper(p_prop_code) and
				nvl(dop.[DATE_BEG],P_DATE_PRINT)<=P_DATE_PRINT and P_DATE_PRINT<=nvl(dop.[DATE_END],P_DATE_PRINT)
		loop
			v_temp_str := trim(
						iif(dop.[GROUP_PROP].[TYPE_VALUE] is null ,dop.[PROP].[NAME],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='NUMBER',to_char(dop.[NUM],'999G999G999G999G990D0099'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='STRING',dop.[STR],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='DATE'  ,to_char(dop.[V_DATE],fmt),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='BOOL'  ,iif(dop.[BOOL],'Да','Нет'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='REF'   ,::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),'')
						);
		end loop;
						
		return 	v_temp_str;			
end;

public function fill_benefit
/*Функция заполнения данных о выголоприобретателе и выгододателе и основаниии с возможностью отдельного вывода*/
(
	P_DATE_PRINT date
		/*Дата печати анкеты*/
	, P_CL_LINKS [LINKS_CL_ARR]
		/*Клиент, для которого ищутся взаимосвязи*/
	, P_TYPE ref [CL_LINK]
		/*Тип взаимосвязи. Ссылка*/
	, P_FOUND boolean
		/*Выводить основание*/
	, P_BEN boolean
		/*выводить выгододателя/выгодоприобретателя*/
)
/*Возвращается строка вида:
<ИМЯ>, на основании: <ОСНОВАНИЕ>
<ИМЯ2>, на основании: <ОСНОВАНИЕ2>

либо (если основания нет, либо вывод основания не нужен):
<ИМЯ>
<ИМЯ2>

либо(если вывод выгододателя/приобретателя не нужен):
<ОСНОВАНИЕ>
<ОСНОВАНИЕ2>
*/
return string(32000) is 
	ret_DATA string(32000);
	header boolean := true;
begin
	for cl_link in P_CL_LINKS
	where
		cl_link.[VID_LINK]  = P_TYPE
		and (cl_link.[DATE_BEG]<=P_DATE_PRINT or cl_link.[DATE_BEG] is null)
		and (cl_link.[DATE_END]>=P_DATE_PRINT or cl_link.[DATE_END] is null)
  	order by cl_link.[DATE_BEG]
	loop
		ret_DATA := rtl.bool_char(ret_DATA is not null, ret_DATA || bool_char(cl_link.[PARTNER] is not null or cl_link.[FOUND] is not null, ';'|| NL$,'') , '');
		if P_BEN then
			if header then
				if P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОПРИОБРЕТАТЕЛЬ') then
					ret_DATA := ret_DATA ||'Выгодоприобретатели: ';
				elsif P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОДАТЕЛЬ') then
					ret_DATA := ret_DATA ||'Выгододатели: ';
				end if;
				header := false;
			end if;
			ret_DATA := ret_DATA || cl_link.[PARTNER].[NAME];
		end if;
		
		if P_FOUND and cl_link.[FOUND] is not null then
			if P_BEN then
				ret_DATA := ret_DATA || ', на основании: ';--если выводятся и сами выгододатели, напишем слово "на основании"
			end if;
			ret_DATA := ret_DATA || cl_link.[FOUND];
		end if;
	end loop;
	if trim(ret_DATA) is null then
		if P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОПРИОБРЕТАТЕЛЬ') then
			ret_DATA := 'Выгодоприобретатели: нет сведений';
		elsif P_TYPE = ::[CL_LINK]([CODE]='ВЫГОДОДАТЕЛЬ') then
			ret_DATA := 'Выгододатели: нет сведений';
		end if;
	end if;

	return ret_DATA;--удалим последнюю запятую
end;

/*

	    For i = 1 To WrdDoc.InlineShapes.Count
	        if 	(WrdDoc.InlineShapes.Item(i).Type= 5)  then
		        Text4Setting  =  GetData(WrdDoc.InlineShapes.Item(i).OLEFormat.Object.Name)
		        	if Text4Setting = "ДА" then
			         WrdDoc.InlineShapes.Item(i).OLEFormat.Object.value = true
	        	    end if
			end if
		Next 		


*/
PSH_WRD_JURCLNK (
	@name('Руководитель подразделения')         P_HEADUSER        in [USER_REF],
	@name('Строка для передачи данных')         P_DATA            in [MEMO_32767],
	@name('Дата заполнения анкеты')             P_DATE_ANK        in [DATE],
	@name('Печать анкеты на дату')              P_DATE_PRINT      in [DATE],
	@name('Подразделение')                      P_DEPART          in [DEPART_REF]       default null,
	@name('Подразделение')                      P_DEPART_STR      in [STRING_128]       default null,
	@name('Работа с клиентом в подразделениях') P_WORK_IN_DEPARTS in [CL_INFO_USER_REF] default null,
	@name('Руководитель подразделения')         P_HEADUSER_STR    in [STRING_500]       default null,
	@name('Дата обновления анкеты')             P_DATE_FORM_UPD   in [DATE],
	@name('Документ')                           P_SHABLON         in [SHABLON_DOC_REF]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE_ANK := this.[DATE_ANK];
	P_DATE_FORM_UPD := this.[DATE_FORM_UPD_F];

	V_DATE_UPD_TO_PRINT := this.[DATE_FORM_UPD_F];
end if;
-- End initialization of parameters and variables
declare
--pragma MACRO(ReportFile,'''DOC\WRD_JURCL_ANK.dot''');
--pragma MACRO(ReportFile,'''WRD_JURCL_ANK.dot''');
temp_string [MEMO_32767] := '';
register	[CL_CORP];
val			string(4000);
cl_hist_ref	ref [CL_HIST];
links_ref	number;
cl_priv ref [CL_PRIV];
v_count	integer;
temp_str varchar2(2000);

flSpace boolean:=false; --Башкиров В.Г. 28.05.2019 Для кодов типа CL_ANK_PDL_INFO_ (последний символ "_") если значение пустое - выдавать " " вместо "нет"

ac	ref	[AC_FIN];

begin
	if p_message = 'DEFAULT' then
	
		-- Инициализация переменных				
		account := null;
		client_corp	:= null;
		op_dat := [SYSTEM].[OP_DATE];

		V_UPD_ANKETA 	:= false;
		V_LAST_VERSION  := true;
		
		
		
		is_auto := 	::[CL_CORP].[EDIT_ANKETA].is_auto_fill_date_upd;	
		if is_auto then
			csmd.Disable(V_VB, 'P_DATE_FORM_UPD');
			csmd.Show(V_VB, 'V_UPD_ANKETA', 'V');
		else
			V_UPD_ANKETA :=  P_DATE_ANK is not null and  P_DATE_FORM_UPD is null; -- обновляем
			csmd.Enable(V_VB, 'P_DATE_FORM_UPD');
			csmd.Hide(V_VB, 'V_UPD_ANKETA', 'V');
		end if;
		
		V_BANK := false; -- Клиент не является банком
		if this%class(true) in ('CL_BANK_N', 'CL_PART', 'CL_BANK_F') then -- %class(true) правильно работает при использовании кэширования
			V_BANK := true; -- Клиент является банком
	 	end if;
		--P_DATE_ANK := op_dat;

		begin
		P_SHABLON := null;
		locate P_SHABLON in ::[SHABLON_DOC] where P_SHABLON.[CODE] = 'АНК_ЮР_ЛИЦА' order by P_SHABLON;
		exception
			when NO_DATA_FOUND then null;
		end;

       P_SHABLON:=	nvl(::[DEFVALS].[SLIB].RestoreRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SHABLON'),P_SHABLON);
       
    	for a
    		in ::[AC_FIN]
    		where a.[CLIENT_V] = this
    		order by a.[DATE_OP] asc
    	loop
    		account := a;
    		exit;
    	end loop;
		
		if nvl(::[FP_TUNE].[LIB].get_bool_value('REG_WORK_IN_DEPARTS', ::[FP_TUNE].[LIB].set_canons('<TYPE_REG_IN_DEPART>', 'WORK_REG')),false) then
			[CSMD].Enable(V_VB, 'P_WORK_IN_DEPARTS');			
			executor.set_context( 'CL_INFO_DATE', to_char(nvl(P_DATE_PRINT, sysdate), 'DD/MM/YYYY'));
			declare
				collect_id collection;
			begin
				select x(x.[CL_WORK_USERS]) in ::[CL_INFO_REQ] where x.[CLIENT] = this into collect_id;
				executor.set_context('CL_INFO_COLLECTION', to_char(collect_id));
			exception when NO_DATA_FOUND then
				executor.set_context('CL_INFO_COLLECTION', null );	
			end;	

		else
			[CSMD].Disable(V_VB, 'P_WORK_IN_DEPARTS');			
		end if;
		
		-- Заполнение подразделения и руководителя подразделения
		P_DEPART := ::[SYSTEM].[VARIABLES].OurDepart;
		P_HEADUSER := ::[CL_CORP].[EDIT_ANKETA].get_chief_user(P_DEPART, 'DEPART_BOSS');
		P_DEPART_STR := P_DEPART.[NAME];
		P_HEADUSER_STR := P_HEADUSER.[NAME];
		
		--По умолчанию показываем дату печати - текущую дату.
		P_DATE_PRINT := nvl(P_DATE_PRINT,trunc(sysdate));
		
-----------------------------------------------------------------
	elsif p_message = 'VALIDATE' then
		debug_pipe('! p_info = '||p_info,dp);
		P_DATA := ' ';
		if p_info = 'P_HEADUSER' then
			if P_HEADUSER is not null then
				--P_HEADUSER_STR := P_HEADUSER.[NAME]|| bool_char(P_HEADUSER.[CASTA].[VALUE] is not null, )
				P_HEADUSER_STR := nvl(::[RUNTIME].[STDLIB].fio(P_HEADUSER.[NAME], 'Ф И. О.'), '');
				P_HEADUSER_STR := rtl.bool_char(P_HEADUSER_STR is not null, nvl(P_HEADUSER.[CASTA].[VALUE], '')||' '||P_HEADUSER_STR, '');				
			end if;
		elsif P_INFO = 'P_DEPART' then
			if P_DEPART is not null then
				P_DEPART_STR := P_DEPART.[NAME];
			end if;
		elsif P_INFO = 'P_WORK_IN_DEPARTS' then
			P_HEADUSER_STR := P_WORK_IN_DEPARTS.[NAME_CHIEF]||bool_char( P_WORK_IN_DEPARTS.[CASTA_CHIEF] is not null, ', ' || P_WORK_IN_DEPARTS.[CASTA_CHIEF], '');
			P_DEPART_STR :=	P_WORK_IN_DEPARTS.[DEPART_NAME]||' '||
							bool_char(P_WORK_IN_DEPARTS.[DEPART_CODE]is not null,'('||P_WORK_IN_DEPARTS.[DEPART_CODE]||')', '');
		elsif P_INFO = 'P_DATE_PRINT' then
			executor.set_context( 'CL_INFO_DATE', to_char(nvl(P_DATE_PRINT, sysdate), 'DD/MM/YYYY'));
			
			if nvl(P_DATE_PRINT, trunc(sysdate)) <> trunc(sysdate) then
				V_DATE_UPD_TO_PRINT := get_date_upd(this,P_DATE_PRINT);
				V_LAST_VERSION 		:= false;
			else
				V_DATE_UPD_TO_PRINT := P_DATE_FORM_UPD;
			end if;
					
		elsif p_info = 'P_DATE_FORM_UPD' then
			 -- если пользователь сам установил дату или удалил, тогда
			 V_UPD_ANKETA := false;

		elsif p_info = '%VAR%.V_UPD_ANKETA' then
			 -- если пользователь сам установил дату или удалил, тогда
			if V_UPD_ANKETA then
				P_DATE_FORM_UPD := trunc(sysdate);
			else
				P_DATE_FORM_UPD := [DATE_FORM_UPD_F];
				
			end if;
			if nvl(P_DATE_PRINT, trunc(sysdate)) <> trunc(sysdate) then
				V_DATE_UPD_TO_PRINT := get_date_upd(this,P_DATE_PRINT);
				V_LAST_VERSION 		:= false;
			else
				V_DATE_UPD_TO_PRINT := P_DATE_FORM_UPD;
			end if;
		end if;

		if p_info = 'OK' then
			V_BEN_STR := '';
			if V_UPD_ANKETA then
				V_MESSAGE := 'Хотите изменить дату обновления на текущую -' ||to_char(sysdate, 'dd/mm/yyyy') || '?';
			end if;

			if P_DATE_ANK is null then
				pragma error('Укажите дату заполнения анкеты!');
			end if;
			--Если дата печати не заполнена, то печатаем только из текущих значений
			P_DATE_PRINT := nvl(P_DATE_PRINT,trunc(sysdate));
			--P_DATE_FORM_UPD := nvl(P_DATE_FORM_UPD,trunc(sysdate)); -- Дата обновления может быть пустая
			--Получаем структуру клиента на дату
			--Изменения анкеты, сделанные в дату P_DATE_PRINT, начинают действовать сразу же,
			--т.е. прежние реквизиты будут действительны до (P_DATE_PRINT-1) включительно.
			client_corp := ::[LEGAL_INTERFACE].[PRX_CLIENT].CL_HIST_GET_CORP(this, P_DATE_PRINT + 1);
			cl_info		:= ::[CL_INFO_REQ].[LIB].GetClInfoReq_OnDate(this, P_DATE_PRINT + 1);
			
			/*
			------------------------------------------------------------------------
				 ПЕЧАТЬ ОТЧЕТОВ О БЕНЕФИЦИАРНЫХ ВЛАДЕЛЬЦАХ ЮРИДИЧЕСКОГО ЛИЦА
				 анкета каждого физ.лица печатается в отдельный Word - документ.
				 печать анкет физических лиц являющихся бенефицираными
				 владельцами реализуется в другой операции, здесь передается только
				 ссылка на физ.лицо.
			------------------------------------------------------------------------
			*/
			if P_SHABLON.[CODE] = 'АНК_БЕН_ЮРЛ' then
				V_NAME := client_corp.[NAME];
				for ( select lo(lo.[PARTNER] : cl_priv_id)
					  in client_corp.[LINKS_OTHER]
					  where lo.[VID_LINK] = ::[CL_LINK]([CODE] = 'БЕНЕФИЦИАР')
					  	and (lo.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or lo.[DATE_BEG] is null)
						and (lo.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or lo.[DATE_END] is null)
						and lo.[PARTNER] is not null
				)
				loop
					V_BEN_STR := V_BEN_STR||lo.cl_priv_id||'#';
				end loop;
				if V_BEN_STR is null then
					pragma error('Юридическое лицо не имеет действующих бенефициарных владельцев - клиентов');
				end if;
			end if;
			------------------------------------------------------------------------
					
			if P_SHABLON.[CODE] = 'АНК_ПРЕДСТ_ЮРЛ' then --ПРИНЦИПАЛ BS00299498								
				select a(nvl(a.[CLIENT_NAME], a.[PARTNER].[NAME]) : clien_name)
					in client_corp.[LINKS_OTHER]
					where a.[VID_LINK] = ::[CL_LINK]([CODE] = 'ПРИНЦИПАЛ')
					  and (a.[DATE_BEG] is null or a.[DATE_BEG] <= P_DATE_PRINT)
					  and (a.[DATE_END] is null or a.[DATE_END] >= P_DATE_PRINT)					
					into principal;
				if principal.count = 0 then
					pragma error('Данный клиент не является представителем');
				end if;					
			end if;

	 	elsif p_info = 'REPORTFILE' then
	 		P_DATA := P_SHABLON.[FILE_NAME];--&ReportFile;
	 	elsif p_info = 'REPORTPATH' then
	 		--P_DATA := [MSLIB].GetReportPath;
	 		P_DATA := ::[SYSTEM_PARAMS].[GET]('PATH_PRINT_DOC');
		------------------------------------------------------------------------------------------------------------
		else
	 		if p_info = 'КАТЕГОРИЯ' then   --КАТЕГОРИЯ
		 		if V_BANK then
		 			P_DATA := 'кредитной организации';
		 		else
		 			P_DATA := 'юридического лица';
		 		end if;
									
		 	elsif p_info like 'НАИМ_КЛИЕНТА%' then   --НАИМ_КЛИЕНТА
			 	temp_string := nvl(client_corp.[LONG_NAME], client_corp.[NAME]);
		 		P_DATA := temp_string;
		 		temp_string := nvl(client_corp.[I_NAME], '');
	 			P_DATA := P_DATA||rtl.bool_char(temp_string is null, '', chr(13)||temp_string);
	 		
	 		elsif p_info like 'КОР_НАИМ_КЛИЕНТА%' then -- КОРОТ НАИМ КЛИЕНТА
				P_DATA := client_corp.[NAME];
	 		elsif p_info = 'УК_НАИМ_ИНН' then
	 			for (select x(x.[PARTNER].[NAME] : part_name,
	 						x.[PARTNER].[INN] : part_inn)
	 				in client_corp.[LINKS_OTHER]
	 				where x.[VID_LINK].[CODE] = 'ПОД_УПРАВЛЕНИЕМ'
	 				and nvl(x.[DATE_END], ::[SYSTEM].[OP_DATE]) >= ::[SYSTEM].[OP_DATE]
	 			)
	 			loop
	 				P_DATA := x.part_name || ' ' || x.part_inn;
	 			end loop;	 			          	 		          	 		
	 		elsif p_info = 'ИНН_КИО_КПП' then -- ИНН_КИО_КПП

--				P_DATA := client_corp.[INN] || ' (' || client_corp.[KIO] || ') / ' || client_corp.[KPP];	 			          	 		          	 		
				P_DATA := client_corp.[INN] || '/ ' || client_corp.[KPP];	 			          	 		          	 		

			elsif p_info = 'ОП_ФОРМА' then      --ОП_ФОРМА
--but для Решетова
--		 		P_DATA := nvl(client_corp.[FORMA].[NAME], client_corp.[FORMA].[SHORT_NAME]);
		 		P_DATA := nvl(client_corp.[FORMA].[SING_NAME], client_corp.[FORMA].[NAME]);
		 		 		
			elsif p_info = 'РЕГ_НОМЕР' then     --РЕГ_НОМЕР
		 		P_DATA := nvl(client_corp.[REGISTER].[GOS_REG_NUM_REC], client_corp.[REGISTER].[NUM_REESTR]);
	
			elsif p_info = 'ДАТА_РЕГ' then     --ДАТА_РЕГ	 		
		 		/*P_DATA := rtl.bool_char(client_corp.[REGISTER].[DATE_REESTR] is not null,
		 								'Дата внесения в ЕГРЮЛ до 1 июля 2002 года: '||
		 								::[RUNTIME].[VIEWFUN].DAT_STR(client_corp.[REGISTER].[DATE_REESTR]),
		 								rtl.bool_char(client_corp.[REGISTER].[DATE_REG] is not null,
		 								::[RUNTIME].[VIEWFUN].DAT_STR(client_corp.[REGISTER].[DATE_REG]), ''));*/
		 								
		 		P_DATA := rtl.bool_char(client_corp.[REGISTER].[DATE_REG] is not null,::[RUNTIME].[VIEWFUN].DAT_STR(client_corp.[REGISTER].[DATE_REG]),
		 								rtl.bool_char(client_corp.[REGISTER].[DATE_REESTR] is not null,
		 								 'Дата внесения в ЕГРЮЛ до 1 июля 2002 года: '||
		 								::[RUNTIME].[VIEWFUN].DAT_STR(client_corp.[REGISTER].[DATE_REESTR]),''));						
	
			elsif p_info = 'РЕГ_ОРГАН' then     --РЕГ_ОРГАН
				--BS00210976 Берем имя налоговой такое, какое оно было при регистрации
				register := ::[LEGAL_INTERFACE].[PRX_CLIENT].CL_HIST_GET_CORP(client_corp.[REGISTER].[REG_BODY],client_corp.[REGISTER].[DATE_REG] + 1);
				P_DATA := coalesce(register.[NAME],register.[LONG_NAME],client_corp.[REGISTER].[REGISTRAR]);
					
			elsif p_info = 'МЕСТО_РЕГ' then     --МЕСТО_РЕГ
				if client_corp.[REGISTER].[CITY] is not null then
				
				   --Страна
	               temp_string := nvl(client_corp.[REGISTER].[CITY].[COUNTRY].[VALUE], null);
	               if temp_string is not null then
	                  P_DATA := temp_string||', ';
	               end if;
	
					declare print_region	boolean := true;-- BFS00036935 - если city_id.[KLADR] следующего вида "nn00000000000" то регион не печатаем
							city_kladr		client_corp.[REGISTER].[CITY].[KLADR]%type;
							reg_kind		::[PEOPLE_PLACE].[FOR_ADDRESS]%type;
							reg_to_end		boolean;
							region			ref [CODE_REGION];
					begin
						city_kladr := client_corp.[REGISTER].[CITY].[KLADR];
						if city_kladr is not null then
							if Length(city_kladr) <= 2 then
								print_region := false;
							else
								if Length(rtrim(city_kladr, '0')) <= 2 then
									print_region := false;
								end if;
							end if;
						end if;
	
						if print_region then
							
							region := ::[PERSONAL_ADDRESS].[LIB].get_region(client_corp.[REGISTER].[CITY]);
							
							if region is not null then
							select x(decode(x.[KIND].[TO_END],	true,
										x.[NAME]||' '||lower(nvl(x.[KIND].[FOR_ADDRESS], x.[KIND].[SHORT_NAME])),
										lower(nvl(x.[KIND].[FOR_ADDRESS], x.[KIND].[SHORT_NAME]))||' '||x.[NAME]))
										in ::[ADDRESS_OBJ] where x = region
										into temp_string;
							end if;			
										
							
							if temp_string is not null then
								P_DATA := P_DATA||temp_string||', ';
							end if;
						end if;
					end;
	
	               --Тип нас-го пункта
	               --P_DATA := P_DATA||nvl(client_corp.[REGISTER].[CITY].[PEOPLE_PLACE].[SHORT_NAME], '')||' ';
	               P_DATA := P_DATA||nvl(client_corp.[REGISTER].[CITY].[KIND].[SHORT_NAME], '')||' ';
	
	               --название нас-го пункта
	               temp_string := nvl(client_corp.[REGISTER].[CITY].[NAME], null);
	               if temp_string is not null then
	                  P_DATA := P_DATA||temp_string||', ';
	               end if;
	
				   --район нас-го пункта
				   --STYLY в населенном пункте хранится район области, а никак не район населенного пункта...
	--             temp_string := nvl(this.[REGISTER].[DISTRICT].[NAME], this.[REGISTER].[CITY].[AREA].[NAME]);
		           temp_string := client_corp.[REGISTER].[DISTRICT].[NAME];
	               if temp_string is not null then
	                  P_DATA := P_DATA||temp_string||' р-он';
	               else
	                  P_DATA := ltrim(rtrim(P_DATA));
	                  P_DATA :=substr(P_DATA,1,length(P_DATA)-1);
	               end if;
	            else
	               P_DATA :=client_corp.[REGISTER].[REG_PLACE];
				end if;
		 	
		 	elsif p_info = 'МЕСТО_НАХОЖД_УЧ_ДОК' then   --Место нахождения (по учр.документам)
				P_DATA := GetAddress(client_corp.[ADDRESSES],'ALL', 'CORP_CHARTER');
		 			 		
			elsif p_info = 'МЕСТО_НАХОЖД' then          --МЕСТО_НАХОЖД (Юридический)
				P_DATA := GetAddress(client_corp.[ADDRESSES],'ALL', 'CORP');
	 		elsif p_info = 'ЮР_АДРЕС_СТРОКОЙ' then
	 			for (select x(x.[IMP_STR] : imp_str)
	 				in client_corp.[ADDRESSES]
	 				where x.[TYPE].[KOD] = 'CORP'
	 			)
	 			loop
	 				P_DATA := x.imp_str;
	 			end loop;
	
			elsif p_info = 'ПОЧТ_АДРЕС' then          --ПОЧТ_АДРЕС (почтовый)
				P_DATA := GetAddress(client_corp.[ADDRESSES],'ALL', 'POST');
	
			elsif p_info = 'ФАКТ_АДРЕС' then          --ФАКТ_АДРЕС (фактический)
				P_DATA := GetAddress(client_corp.[ADDRESSES],'ALL', 'FACT');

			elsif p_info = 'КОНТАКТ_ТЕЛ' then        --КОНТАКТЫ
			    --ищем телефоны и факсы
				P_DATA := GetContacts(client_corp.[CONTACTS], 'PHONE')||
			    		  GetContacts(client_corp.[CONTACTS], 'MOBILEPHONE')||
			              GetContacts(client_corp.[CONTACTS], 'FAX');
			elsif p_info = 'КОНТАКТ_ПОЧ' then        
				P_DATA := GetContacts(client_corp.[CONTACTS], 'MAIL');
			elsif p_info = 'WEB' then        		--Веб-сайт
			    --ищем телефоны и факсы
				P_DATA := GetContacts(client_corp.[CONTACTS], 'WEB');

			elsif p_info = 'INFO_ADDR' then          --INFO_ADDR

                    cl_hist_ref := ::[CL_INFO_REQ].[LIB].GetClInfoQual_OnDate(this, P_DATE_PRINT + 1, 'PRESENCE', val);
				if cl_hist_ref is not null then --по старому, когда реквизит был типа "ЛОГИКА"
					if nvl(val, '0') = '1' then
						P_DATA := 'Присутствует' 	|| NL$;
					else
					    P_DATA := 'Отсутствует.'		|| NL$||this.[INFO_ADDR]||NL$;
					end if;
				else
					if cl_info.[PRESENCE_PLACE].[0] in (4) then
              			P_DATA := P_DATA || 'Присутствует'	|| NL$;
					else
              			P_DATA := P_DATA || 'Отсутствует.'||NL$||this.[INFO_ADDR]||NL$;
					end if;

				end if;

	
/***********************************				
				cl_hist_ref := ::[CL_INFO_REQ].[LIB].GetClInfoQual_OnDate(this, P_DATE_PRINT + 1, 'PRESENCE', val);
				if cl_hist_ref is not null then --по старому, когда реквизит был типа "ЛОГИКА"
					if nvl(val, '0') = '1' then
						P_DATA := 'Юридическое лицо присутствует по своему местонахождению.' 	|| NL$;
					else
						P_DATA := 'Юридическое лицо отсутствует по своему местонахождению.'		|| NL$;
					end if;
				else
					if cl_info.[PRESENCE_PLACE].[0] in (1, 2) then
						P_DATA := P_DATA || 'Юридическое лицо отсутствует по своему местонахождению.'	|| NL$;
					elsif cl_info.[PRESENCE_PLACE].[0]   = 3 then
						P_DATA := P_DATA || 'Юридическое лицо присутствует по фактическому адресу.'		|| NL$;
					elsif cl_info.[PRESENCE_PLACE].[0]   = 4 then
						P_DATA := P_DATA || 'Юридическое лицо присутствует по юридическому адресу.'		|| NL$;
					end if;
				end if;
				
				cl_hist_ref := ::[CL_INFO_REQ].[LIB].GetClInfoQual_OnDate(this, P_DATE_PRINT + 1, 'PRESENCE_CNTRL', val);
				if cl_hist_ref is not null then --по старому, когда реквизит был типа "ЛОГИКА"
					if nvl(val, '0') = '1' then
						P_DATA := P_DATA || 'Постоянно действующий орган управления юридического лица присутствует по своему местонахождению.'||NL$;
					else
						P_DATA := P_DATA || 'Постоянно действующий орган управления юридического лица отсутствует по своему местонахождению.'||NL$;
					end if;
				else
					if cl_info.[PRESENCE_MANAG].[0] in (1, 2) then
						P_DATA := P_DATA || 'Постоянно действующий орган управления юридического лица отсутствует по своему местонахождению.'||NL$;
					elsif cl_info.[PRESENCE_MANAG].[0] = 3 then
						P_DATA := P_DATA || 'Постоянно действующий орган управления юридического лица присутствует по фактическому адресу.'||NL$;
					elsif cl_info.[PRESENCE_MANAG].[0] = 4 then
						P_DATA := P_DATA || 'Постоянно действующий орган управления юридического лица присутствует по юридическому адресу.'||NL$;
					end if;
				end if;
				
				cl_hist_ref := ::[CL_INFO_REQ].[LIB].GetClInfoQual_OnDate(this, P_DATE_PRINT + 1, 'PRESENCE_OTHER_C', val);
				if cl_hist_ref is not null then --по старому, когда реквизит был типа "ВЫБОР ИЗ 3х"
					if nvl(val, '1') = '2' then
						P_DATA := P_DATA || 'Для данного юридического не предусмотрен иной орган (физ. лицо), который имеет право '||
											'действовать без доверенности от его имени.'||NL$;
					elsif nvl(val, '1') = '3' then
						P_DATA := P_DATA || 'Для данного юридического лица предусмотрен иной орган (физ. лицо), который имеет право действовать '||
											'без доверенности от его имени, который присутствует по своему местонахождению.'||NL$;
					elsif nvl(val, '1') = '4' then
						P_DATA := P_DATA || 'Для данного юридического лица предусмотрен иной орган (физ. лицо), который имеет право действовать '||
											'без доверенности от его имени, который отсутствует по своему местонахождению.'||NL$;
					end if;
				else								
					if cl_info.[PRESENCE_OTHER].[0]    = 1 then
						P_DATA := P_DATA || 'Для данного юридического лица не предусмотрен иной орган (физ. лицо), который имеет право '||
											'действовать без доверенности от его имени.'||NL$;
					elsif cl_info.[PRESENCE_OTHER].[0] = 2 then
						P_DATA := P_DATA || 'Для данного юридического лица предусмотрен иной орган (физ. лицо), который имеет право действовать '||
											'без доверенности от его имени, который отсутствует по своему местонахождению.'||NL$;
					elsif cl_info.[PRESENCE_OTHER].[0] = 3 then
						P_DATA := P_DATA || 'Для данного юридического лица предусмотрен иной орган (физ. лицо), который имеет право действовать '||
											'без доверенности от его имени, который присутствует по фактическому адресу.'||NL$;
					elsif cl_info.[PRESENCE_OTHER].[0] = 4 then
						P_DATA := P_DATA || 'Для данного юридического лица предусмотрен иной орган (физ. лицо), который имеет право действовать '||
											'без доверенности от его имени, который присутствует по юридическому адресу.'||NL$;
					end if;
				end if;
******************************/				
				--P_DATA := P_DATA || client_corp.[INFO_ADDR];
	
			elsif p_info = 'Е_МАЙЛ' then --Е_МАЙЛ
		 		P_DATA := GetContacts(client_corp.[CONTACTS], 'MAIL');
	
			elsif p_info = 'БИК' then    --БИК
				if V_BANK then
					if this%class(true) = 'CL_PART' then
						declare
							cl_part_ref ref [CL_PART];
						begin
							cl_part_ref := this;
							P_DATA := cl_part_ref.[BANK].[BIC];
							if P_DATA is null then
								P_DATA := nvl(cl_part_ref.[BANK_F].[SWIFT_C], '');
							end if;
						end;
					elsif this%class(true) = 'CL_BANK_N' then -- добавлено условие в виду добавления ТБП "Банки иностранных государств"
						declare
							bank_n_ref ref [CL_BANK_N];
						begin
							bank_n_ref := this;
							P_DATA := nvl(bank_n_ref.[BIC], '');
						end;
					else -- если вызвано из ТБП "Банки иностранных государств"
						P_DATA := '';
					end if;
				else
					P_DATA := '';
				end if;
			elsif p_info = 'ИНН' then    --ИНН
		 		P_DATA := nvl(client_corp.[INN], client_corp.[KIO]);
	
			elsif p_info = 'УРОВЕНЬ_РИСКА' then	 	--Уровень риска
				declare
					fl	ref [FAIL_LEVEL];
					fv	number;
				begin
					::[LEGAL_INTERFACE].[PRX_CLIENT].getRisk_FailValueAndLevel(client_corp%id, fl, fv, P_DATE_PRINT);
					case fl.[NAME] of
						:'НИЗКИЙ' : P_DATA := 'НИЗКАЯ';
						:'СРЕДНИЙ': P_DATA := 'СРЕДНЯЯ';
						:'ВЫСОКИЙ': P_DATA := 'ВЫСОКАЯ';
					else P_DATA := fl.[CODE];
					end;
					-- Кокорин АС	03.07.14				
					--P_DATA := nvl(fl.[NAME], fl.[CODE]) || ' ' || client_corp.[FAIL_MARK];
					--P_DATA := nvl(fl.[NAME], fl.[CODE]);
-----------------------------------------------------------------------------					
				end;

			elsif p_info = 'ИСТОРИЯ_РИСКА' then	 	--история риска
				  --P_DATA := COALESCE(client_corp.[FAIL_MARK],' '); --Башкиров В.Г. 14.11.2020
					debug_pipe(client_corp.[FAIL_MARK],0);
					debug_pipe(client_corp.[PSH_FAIL_MARK],0);
					P_DATA := Substr(COALESCE(client_corp.[FAIL_MARK]||iif(client_corp.[PSH_FAIL_MARK] is null,'',LF$||client_corp.[PSH_FAIL_MARK]),' '),1,32767);
					
			elsif p_info = 'ДАТА_СЧЕТА1' then	 	--ДАТА_СЧЕТА1
				
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_info.[FIRST_ACC_DATE]), '');	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
			 		P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(account.[DATE_OP]), '');
		 		else
		 		    P_DATA :='';
		 		end if;

			elsif p_info = 'НОМЕР_СЧЕТА1' then	 	--НОМЕР_СЧЕТА1
				if account is not null then
					P_DATA := account.[MAIN_V_ID];
		 		else
		 		    P_DATA :='';
		 		end if;
		 		
			elsif p_info = 'СОТР_ОТКР' then	 	--СОТР_ОТКР
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_info_user('ACC_OPEN_USER', cl_info.[CL_WORK_USERS], P_DATE_PRINT);	
					end if;
				elsif account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[USER_OP];
						if (account is not null) and (u is not null) then
							P_DATA := nvl(u.[NAME], '') || ', ' || u.[CASTA].[VALUE];
						else
							P_DATA :='';
						end if;
					end;
				end if;
			elsif p_info = 'СОТР_ОТКР_ПОДР' then
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_depart('ACC_OPEN_USER', cl_info.[CL_WORK_USERS], P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[USER_OP];
						if (account is not null) and (u is not null) then
							P_DATA := ::[DEPART].[LIB].get_declension(u.[DEPART]);
						else
							P_DATA :='';
						end if;
					end;	
				end if;	
			elsif p_info = 'СОТР_УТВ' then	 	--СОТР_УТВ
				P_DATA := get_cl_info_user('ACC_CONFIRM', cl_info.[CL_WORK_USERS], P_DATE_PRINT);
			elsif p_info = 'СОТР_УТВ_ПОДР' then
				P_DATA := get_cl_depart('ACC_CONFIRM', cl_info.[CL_WORK_USERS], P_DATE_PRINT);	
			elsif p_info = 'СОТР_ОТВ' then	 	--СОТР_ОТВ
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_info_user('ACC_MANAGER', cl_info.[CL_WORK_USERS], P_DATE_PRINT);	
					end if;
				elsif account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[OTV];
						if (account is not null) and (u is not null) then
							P_DATA := nvl(u.[NAME], '') || ', ' || u.[CASTA].[VALUE];
						else
							P_DATA :='';
						end if;
					end;
				end if;
			elsif p_info = 'СОТР_ОТВ_ПОДР' then	 	--СОТР_ОТВ
				if cl_info.[FIRST_ACC_DATE] is not null then
					if cl_info.[FIRST_ACC_DATE] <= P_DATE_PRINT then
						P_DATA := get_cl_depart('ACC_MANAGER', cl_info.[CL_WORK_USERS],  P_DATE_PRINT);	
					end if;
				elsif account is not null and account.[DATE_OP] <= P_DATE_PRINT then
					declare u ref [USER];
					begin
						u := account.[OTV];
						if (account is not null) and (u is not null) then
							P_DATA := ::[DEPART].[LIB].get_declension(u.[DEPART]);
						else
							P_DATA :='';
						end if;
					end;
				end if;		
			elsif p_info = 'ДАТА_ТЕРРОР' then		--Дата проверки				
					for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
						order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt)||' - '||rez.[CHECK_VAL].[NAME];
							exit;
						end loop;		
			elsif p_info = 'ДАТА_ООН' then		--Дата проверки				
					for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='LIST_OON' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
						order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt)||' - '||rez.[CHECK_VAL].[NAME];
							exit;
						end loop;		
			elsif p_info = 'ДАТА_ЗАМ_СР' then		--Дата проверки				
					for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='FREEZE_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
						order by rez.[CHECK_DATE] desc
						loop
							P_DATA :=to_char(rez.[CHECK_DATE],fmt)||' - '||rez.[CHECK_VAL].[NAME];
							exit;
						end loop;		
			elsif p_info = 'РЕШ_БАНК' then		--Решение банка
	 		    P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_RESH_BANK');--CL_ANK_PSH_IDENT_BEN_JUR
	 			if nvl(P_DATA,' ')!=' ' then
	 			   -- P_DATA := 'Бенефициарный владелец установлен';
	 			   null;
	 			end if; 

			elsif p_info = 'ОСН_РЕШ_БАНК' then		--Основание решения
	 		   --Сведения об идентификации бенефициара клиента
	 		   
	 			  P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_OSNOV_RESH');--CL_ANK_PSH_IDENT_BEN_JUR
               if nvl(P_DATA,' ')=' ' then
                null;
	 			 --P_DATA := 'в результате принятых мер Бенефициарный владелец не выявлен';
	 		   end if; 
			elsif p_info = 'ДАТА_НАЧ_ОТН' then		--Дата начала отношений
	 			P_DATA := nvl(to_char(cl_info.[FIRST_ACC_DATE],fmt) , '');
	 		elsif p_info = 'ДАТА_ПРЕК_ОТН' then		--Дата прекращения отношений
	 			if cl_info.[CLOSE_DATE] is null then
	 				begin
	 					locate ac in ::[AC_FIN] where ac.[CLIENT_V] = this and ac.[DATE_CLOSE] is null and rownum = 1;
	 				exception when NO_DATA_FOUND then
	 					begin
	 						select distinct ac(max(ac.[DATE_CLOSE])) in ::[AC_FIN] where ac.[CLIENT_V] = this into cl_info.[CLOSE_DATE];
	 					exception when NO_DATA_FOUND then
	 						null;
	 					end;
	 				end;	 					
	 			end if;
	 			P_DATA := nvl(to_char(cl_info.[CLOSE_DATE],fmt) , '');
			elsif p_info = 'OSU_FIO' then
	 			P_DATA := '';
 				for ( select org(org.[REGISTER].[FOUNDERS].[FOUNDER].[NAME] : c_fio,
	 				org.[REGISTER].[FOUNDERS].[FOUNDER].[INN] : c_inn,
	 				org.[REGISTER].[FOUNDERS].[PERCENT] : c_perc) 
	 				in ::[CL_ORG]
		 			where org = this and org.[REGISTER].[FOUNDERS].[DATE_END] is null)
	 			loop
	 				P_DATA := P_DATA || org.c_fio || NL$;
	 			end loop;
	 			P_DATA := rtrim(P_DATA, NL$);
	 		elsif p_info = 'OSU_INN' then
 				P_DATA := '';
 				for ( select org(org.[REGISTER].[FOUNDERS].[FOUNDER].[NAME] : c_fio,
	 				org.[REGISTER].[FOUNDERS].[FOUNDER].[INN] : c_inn,
	 				org.[REGISTER].[FOUNDERS].[PERCENT] : c_perc) 
	 				in ::[CL_ORG]
		 			where org = this and org.[REGISTER].[FOUNDERS].[DATE_END] is null)
	 			loop
	 				if org.c_inn is not null then
	 					P_DATA := P_DATA || org.c_inn || NL$;
	 				else
	 					P_DATA := P_DATA || '-' || NL$;
	 				end if;
	 				if length(org.c_fio) > 19 then
	 					P_DATA := P_DATA || NL$;
	 				end if;
	 			end loop;
	 			P_DATA := rtrim(P_DATA, NL$);
	 		elsif p_info = 'OSU_PART' then
 				P_DATA := '';
 				for ( select org(org.[REGISTER].[FOUNDERS].[FOUNDER].[NAME] : c_fio,
	 				org.[REGISTER].[FOUNDERS].[FOUNDER].[INN] : c_inn,
	 				org.[REGISTER].[FOUNDERS].[PERCENT] : c_perc) 
	 				in ::[CL_ORG]
		 			where org = this and org.[REGISTER].[FOUNDERS].[DATE_END] is null)
	 			loop
	 				if to_number(org.c_perc) < 1 then
	 					P_DATA := P_DATA || '0' || org.c_perc || NL$;
	 				else
	 					P_DATA := P_DATA || org.c_perc || NL$;
	 				end if;
	 				if length(org.c_fio) > 19 then
	 					P_DATA := P_DATA || NL$;
	 				end if;
	 			end loop;
	 			P_DATA := rtrim(P_DATA, NL$);
	 		elsif p_info = 'SD_FIO' then
 				P_DATA := '';
 				for ( select org(inf.[OPER_CONTROL].[PERSONNEL].[CLIENT](true)->(CL_PRIV)[NAME] : c_fio)
					in ::[CL_ORG] left join (::[CL_INFO_REQ]: inf) on inf.[CLIENT] = org
					where org = this
					and inf.[OPER_CONTROL].[CONTROL_TYPE].[CODE] in ('СД','НАБЛ_СОВЕТ')
					and (inf.[OPER_CONTROL].[DATE_END] is null or inf.[OPER_CONTROL].[DATE_END] >= ::[SYSTEM].OP_DATE)
 				)
 				loop
 					P_DATA := P_DATA || org.c_fio || NL$;
 				end loop;
 				--Добавление должностных лиц через доп. свойства
 				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N11_1'
 				)
 				loop
 					P_DATA := P_DATA || x.c_value || NL$;
 				end loop;
 				P_DATA := rtrim(P_DATA, NL$);
	 		elsif p_info = 'KIO_FIO' then
 				P_DATA := '';
 				for ( select org(inf.[OPER_CONTROL].[PERSONNEL].[CLIENT](true)->(CL_PRIV)[NAME] : c_fio,
 					inf.[OPER_CONTROL].[PERSONNEL].[CASTA].[VALUE] : c_casta)
					in ::[CL_ORG] left join (::[CL_INFO_REQ]: inf) on inf.[CLIENT] = org
					where org = this
					and inf.[OPER_CONTROL].[CONTROL_TYPE].[CODE] in ('КОЛЛЕГ_ПРАВЛЕН','КОЛЛЕГИАЛЬНЫЙ')
					and (inf.[OPER_CONTROL].[DATE_END] is null or inf.[OPER_CONTROL].[DATE_END] >= ::[SYSTEM].OP_DATE)
 				)
 				loop
 					P_DATA := P_DATA || org.c_fio || NL$;
 					if length(org.c_fio) <= 29 and length(org.c_casta) > 26 then
	 					P_DATA := P_DATA || NL$;
	 				end if;
 				end loop;
 				--Добавление должностных лиц через доп. свойства
 				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N11_2'
 				)
 				loop
 					declare
 						str_num		integer := 1;
 						str_fio		string;
 						str_casta	string;
 					begin
 						temp_str := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, str_num, null, chr(13)));
 						while temp_str is not null
 						loop
 							str_fio := ltrim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(temp_str, 1, null, '/'), NL$);
 							str_fio := trim(str_fio);
 							str_casta := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(temp_str, 2, null, '/'));
 							str_num := str_num + 1;
 							temp_str := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, str_num, null, chr(13)));
 							P_DATA := P_DATA || str_fio || NL$;
	 						if length(str_fio) <= 29 and length(str_casta) > 26 then
		 						P_DATA := P_DATA || NL$;
		 					end if;
 						end loop;
 					end;
 				end loop;
 				P_DATA := rtrim(P_DATA, NL$);
	 		elsif p_info = 'KIO_CASTA' then
 				P_DATA := '';
 				for ( select org(inf.[OPER_CONTROL].[PERSONNEL].[CLIENT](true)->(CL_PRIV)[NAME] : c_fio,
 					inf.[OPER_CONTROL].[PERSONNEL].[CASTA].[VALUE] : c_casta)
					in ::[CL_ORG] left join (::[CL_INFO_REQ]: inf) on inf.[CLIENT] = org
					where org = this
					and inf.[OPER_CONTROL].[CONTROL_TYPE].[CODE] in ('КОЛЛЕГ_ПРАВЛЕН','КОЛЛЕГИАЛЬНЫЙ')
					and (inf.[OPER_CONTROL].[DATE_END] is null or inf.[OPER_CONTROL].[DATE_END] >= ::[SYSTEM].OP_DATE)
 				)
 				loop
 					if org.c_casta is not null then
 						P_DATA := P_DATA || org.c_casta || NL$;
 					else
 						P_DATA := P_DATA || '-' || NL$;
 					end if;
 					if length(org.c_fio) > 29 and length(org.c_casta) <= 26 then
	 					P_DATA := P_DATA || NL$;
	 				end if;
 				end loop;
 				--Добавление должностных лиц через доп. свойства
 				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N11_2'
 				)
 				loop
 					declare
 						str_num		integer := 1;
 						str_fio		string;
 						str_casta	string;
 					begin
 						temp_str := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, str_num, null, chr(13)));
 						while temp_str is not null
 						loop
 							str_fio := ltrim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(temp_str, 1, null, '/'), NL$);
 							str_fio := trim(str_fio);
 							str_casta := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(temp_str, 2, null, '/'));
 							str_num := str_num + 1;
 							temp_str := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, str_num, null, chr(13)));
 							P_DATA := P_DATA || str_casta || NL$;
	 						if length(str_fio) > 29 and length(str_casta) <= 26 then
		 						P_DATA := P_DATA || NL$;
		 					end if;
 						end loop;
 					end;
 				end loop;
 				P_DATA := rtrim(P_DATA, NL$);
			elsif p_info = 'EIO_FIO' then
				P_DATA := '';
 				for ( select org(inf.[OPER_CONTROL].[PERSONNEL].[CLIENT](true)->(CL_PRIV)[NAME] : c_fio,
 					inf.[OPER_CONTROL].[PERSONNEL].[CASTA].[VALUE] : c_casta)
					in ::[CL_ORG] left join (::[CL_INFO_REQ]: inf) on inf.[CLIENT] = org
					where org = this
					and inf.[OPER_CONTROL].[CONTROL_TYPE].[CODE] = 'ЕИО'
					and (inf.[OPER_CONTROL].[DATE_END] is null or inf.[OPER_CONTROL].[DATE_END] >= ::[SYSTEM].OP_DATE)
 				)
 				loop
 					P_DATA := P_DATA || org.c_fio || NL$;
 					if length(org.c_fio) <= 29 and length(org.c_casta) > 26 then
	 					P_DATA := P_DATA || NL$;
	 				end if;
 				end loop;
 				P_DATA := rtrim(P_DATA, NL$);
			elsif p_info = 'EIO_CASTA' then
				P_DATA := '';
 				for ( select org(inf.[OPER_CONTROL].[PERSONNEL].[CLIENT](true)->(CL_PRIV)[NAME] : c_fio,
 					inf.[OPER_CONTROL].[PERSONNEL].[CASTA].[VALUE] : c_casta)
					in ::[CL_ORG] left join (::[CL_INFO_REQ]: inf) on inf.[CLIENT] = org
					where org = this
					and inf.[OPER_CONTROL].[CONTROL_TYPE].[CODE] = 'ЕИО'
					and (inf.[OPER_CONTROL].[DATE_END] is null or inf.[OPER_CONTROL].[DATE_END] >= ::[SYSTEM].OP_DATE)
 				)
 				loop
 					if org.c_casta is not null then
 						P_DATA := P_DATA || org.c_casta || NL$;
 					else
 						P_DATA := P_DATA || '-' || NL$;
 					end if;
 					if length(org.c_fio) > 29 and length(org.c_casta) <= 26 then
	 					P_DATA := P_DATA || NL$;
	 				end if;
 				end loop;
 				P_DATA := rtrim(P_DATA, NL$);
	 		elsif p_info = 'ДАТА_ОФОР_АНК' then		--Дата оформления
	 			P_DATA := to_char(nvl(P_DATE_ANK, op_dat),fmt);
	 			
			elsif p_info = 'ДАТА_ЗАПОЛН' then		--Дата заполнения
	 			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_ANK, op_dat)), '');
			elsif p_info = 'ДАТА_ПЕЧАТИ' then		--Дата печати
	 			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(nvl(P_DATE_PRINT, op_dat)), '');
			elsif p_info = 'ДАТА_ОБНОВЛ' then		--Дата обновления
				--P_DATA:=this.[FAIL_MARK];			
				if to_char(this.[DATE_FORM_UPD],fmt) != to_char(nvl(P_DATE_ANK, op_dat),fmt) then
					P_DATA:=to_char(this.[DATE_FORM_UPD],fmt);	--Башкиров В.Г. 14.11.2020
				end if;
			elsif p_info = 'ДАТА_ПРЕД_ОБНОВЛ' then	--Даты предыдущих обновлений	--Ильин Д.А. 09.12.2024
				P_DATA := '';
				for (
				select distinct y(y.c_value : c_y_value) in
				(select distinct x(to_char(to_date(trim(x.[VALUE]),'yyyy-MM-dd hh24:mi:ss'), fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = this%id and x.[QUAL] = 'DATE_FORM_UPD'
				union all
				select distinct x(to_char(x.[DATE_EDIT], fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = this%id and x.[QUAL] = 'MANUAL_EDIT')
				order by to_date(y.c_value, 'dd/MM/yyyy') desc
				)
				loop
					if to_date(y.c_y_value, 'dd/MM/yyyy') < this.[DATE_FORM_UPD] then 
						P_DATA := P_DATA || y.c_y_value || ', ';
					end if;
				end loop;
				P_DATA := rtrim(ltrim(P_DATA, ', '), ', ');
			elsif p_info = 'ДАТЫ_ОБНОВЛ_ВСЕ' then
				P_DATA := to_char(this.[DATE_FORM_UPD],fmt);
				for (
				select distinct y(y.c_value : c_y_value) in
				(select distinct x(to_char(to_date(trim(x.[VALUE]),'yyyy-MM-dd hh24:mi:ss'), fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = client_corp%id and x.[QUAL] = 'DATE_FORM_UPD'
				union all
				select distinct x(to_char(x.[DATE_EDIT], fmt) : c_value, x.[DATE_EDIT] : c_date_edit) 
					in ::[CL_HIST] all 
					where x.[CLIENT_REF] = client_corp%id and x.[QUAL] = 'MANUAL_EDIT')
				where y.c_value is not null
					and to_date(y.c_value, 'dd/MM/yyyy') < this.[DATE_FORM_UPD]
				order by to_date(y.c_value, 'dd/MM/yyyy') desc
				)
				loop
					P_DATA := P_DATA || ', ' || y.c_y_value;
				end loop;
			elsif p_info = 'ДАТА_ЗАКРЫТИЯ' then		--Дата прекращения отношений с клиентом
                if cl_info.[CLOSE_DATE] is not null then
               		if cl_info.[CLOSE_DATE] <= P_DATE_PRINT then
			 			P_DATA := nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_info.[CLOSE_DATE]),'нет');
               		end if;
                end if;

			elsif p_info = 'КОД_ОКПО' then		
				P_DATA := client_corp.[KOD_OKPO];
			elsif p_info = 'ВИД_ДЕЯТЕЛЬНОСТИ' then		
				declare
					okv	[OKVED];
					date_ank	date;
				begin
--but				date_ank	:=  nvl(client_corp.[DATE_ANK], op_dat); --не выводилось, если дата нач.действия ОКВЭД > больше даты заполнения анкеты
                    date_ank	:=  nvl(P_DATE_PRINT, op_dat);					

					okv 		:= ::[LEGAL_INTERFACE].[PRX_CLIENT].Get_Main_OKVED(this, date_ank);
					P_DATA		:= okv.[CODE] || ' - ' || okv.[NAME];
				end;

			elsif p_info = 'КОДЫ_ОКВЭД' then	
				declare
					okv	[OKVED];
					date_ank	date;
				begin
					date_ank	:=  nvl(client_corp.[DATE_FORM_UPD], nvl(client_corp.[DATE_ANK], op_dat));
					okv 		:= ::[LEGAL_INTERFACE].[PRX_CLIENT].Get_Main_OKVED(this, date_ank);
					P_DATA		:= okv.[CODE] || ' ' || okv.[NAME] || NL$;
					for (select vd(	vd.[OKVED].[CODE] : CODE,
									vd.[OKVED].[NAME] : NAME)
							in this.[OKVED_IN_PERIOD]
							where nvl(vd.[MAIN], false) = false
							and nvl(vd.[DATE_BEGIN], date_ank) <= date_ank
							and nvl(vd.[DATE_END], date_ank) >= date_ank
						)
					loop
						P_DATA := P_DATA || vd.[CODE] || ' ' || vd.[NAME] || NL$;
					end loop;
				end;
			elsif p_info = 'ПРАВЛЕНИЕ_ФИО' then
				if cl_info.[FIRST_ACC_DATE] is not null then
					P_DATA := ::[CLIENT].[PSH_LIB_1].head_master_fio(cl_info.[FIRST_ACC_DATE]);
				end if;
			elsif p_info = 'ПРАВЛЕНИЕ_ДОЛЖ' then
				if cl_info.[FIRST_ACC_DATE] is not null then
					P_DATA := ::[CLIENT].[PSH_LIB_1].head_master_casta(cl_info.[FIRST_ACC_DATE]);
				end if;
			elsif p_info = 'ПРИНЯЛ_ФИО' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(this);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_OPEN_USER', cl_info, p_name, p_casta);
					P_DATA := p_name;
				end;
			elsif p_info = 'ПРИНЯЛ_ДОЛЖ' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(this);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_OPEN_USER', cl_info, p_name, p_casta);
					P_DATA := p_casta;
				end;
			elsif p_info = 'УТВЕРДИЛ_ФИО' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(this);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_CONFIRM', cl_info, p_name, p_casta);
					P_DATA := p_name;
				end;
			elsif p_info = 'УТВЕРДИЛ_ДОЛЖ' then
				declare
					v_ref 	ref [CL_INFO_USER];
					p_name	::[CL_INFO_USER].[NAME]%type;
	 				p_casta	::[CL_INFO_USER].[CASTA_NAME]%type;
	 				cl_info ref	[CL_INFO_REQ];
				begin
					cl_info := ::[CL_INFO_REQ].[LIB].getReqRefByClient(this);
					v_ref := ::[CL_CORP].[EDIT_ANKETA].get_user_ref('ACC_CONFIRM', cl_info, p_name, p_casta);
					P_DATA := p_casta;
				end;
			elsif p_info = 'ОБН_ЗАПОЛН_ПОЛН' then	 	--ЗАПОЛНИЛ ФИО полностью
				P_DATA := null;
				for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
							where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_FORM_UPD'
								order by a.[DATE_EDIT] desc )
				loop
					P_DATA := a.[USER_NAME];
					exit;
				end loop;
				if P_DATA is null then
					for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
								where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_ANK'
									order by a.[DATE_EDIT] desc )
					loop
						P_DATA := a.[USER_NAME];
						exit;
					end loop;
				end if;
			elsif p_info = 'ОБН_ЗАПОЛН_ДОЛЖ' then
				P_DATA := null;
				for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
							where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_FORM_UPD'
								order by a.[DATE_EDIT] desc )
				loop
					P_DATA := a.[USER_CASTA];
					exit;
				end loop;
				if P_DATA is null then
					for ( select a(a.[USER_NAME]: USER_NAME, a.[USER_CASTA]: USER_CASTA) in ::[CL_HIST] all
							where	a.[CLIENT_REF] = this and a.[qual] = 'DATE_ANK'
								order by a.[DATE_EDIT] desc )
					loop
						P_DATA := a.[USER_CASTA];
						exit;
					end loop;
				end if;	
			elsif p_info = 'СФОРМИРОВАЛ' then	 	--СФОРМИРОВАЛ
				P_DATA := nvl(::[RUNTIME].[STDLIB].fio(stdlib.userid.[NAME], 'Ф И. О.'), '');
			elsif p_info = 'СФОРМИРОВАЛ_ПОЛН' then	 	--СФОРМИРОВАЛ ФИО полностью
				P_DATA := nvl(::[RUNTIME].[STDLIB].fio(stdlib.userid.[NAME], 'Ф И О'), '');
			elsif p_info = 'СФОРМИРОВАЛ_ДОЛЖ' then
				P_DATA := nvl(stdlib.userid.[CASTA].[VALUE], '');	
			elsif p_info = 'СФОРМИРОВАЛ_ПОДР' then
				P_DATA := nvl(::[DEPART].[LIB].get_declension(::[SYSTEM].[VARIABLES].OurDepart), '');			
			elsif p_info = 'РУК_ПОДР' then	 	--РУК_ПОДР
				if P_HEADUSER_STR  is not null then
					P_DATA := P_HEADUSER_STR;
		 		else
		 		    P_DATA :='                   ';
		 		end if;
		 		
			elsif p_info = 'УЧРЕДИТЕЛИ' then	 	--УЧРЕДИТЕЛИ
				declare
					v_out [MEMO_32767] := '';
					v_bool boolean;
					temp_str string := 'Учредители:'||chr(13);
					v_founder_counter integer;
				begin
					
--but			 		Get_FOUNDERS(client_corp, length(temp_str), v_out, v_bool, v_founder_counter, coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat));
			 		Get_FOUNDERS_PSH(client_corp, length(temp_str), v_out, v_bool, v_founder_counter, coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat));
					if v_bool then
						V_ERR := 'Количество учредителей слишком велико и не может быть обработано. Взяты только первые ' || to_char(v_founder_counter) || '!';
					else
						V_ERR := '';
					end if;
					
					P_DATA := rtl.bool_char(v_out is null, null, temp_str||v_out);
				end;
			elsif p_info = 'ЛИЦЕНЗИИ' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
					-- optimaze

					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],P_DATE_PRINT) <= P_DATE_PRINT and
						  nvl(lic.[DATE_END],P_DATE_PRINT) >= P_DATE_PRINT				
					)
					loop
						--Прил 2. П 1.6. Сведения о лицензии на право осуществления деятельности, подлежащей лицензированию:
						--  вид, номер, дата выдачи лицензии; кем выдана; срок действия; перечень видов лицензируемой деятельности.
						P_DATA := P_DATA
							  ||rtl.bool_char(lic.l_type	is null, null, 'Вид лицензии: '		||lic.l_type|| NL$)
							  ||rtl.bool_char(lic.l_num		is null, null, 'Номер: '			||lic.l_num|| NL$)
							  ||rtl.bool_char(lic.l_date1	is null, null, 'Дата выдачи: '		||to_char(lic.l_date1, 'DD.MM.YYYY')|| NL$)
							  ||rtl.bool_char(lic.l_date2	is null, null, 'Дата окончания: '	||to_char(lic.l_date2, 'DD.MM.YYYY')|| NL$)
							  ||rtl.bool_char(lic.l_who		is null, null, 'Выдана: '			||lic.l_who|| NL$)
							  ||rtl.bool_char(lic.l_list	is null, null, 'Виды лицензируемой деятельности: '||lic.l_list)
							  ||NL$||NL$;
					end loop;				
				
				P_DATA := trim(P_DATA);
				P_DATA := rtl.bool_char(P_DATA is null, null, substr(P_DATA, 1, length(P_DATA)-4));
			
			elsif p_info = 'ЛИЦЕНЗИЯ_ВИД' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
				i := 0;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						i := i + 1;
						P_DATA := P_DATA || i || ') ' || lic.l_type || NL$;
					end loop;				
				 	
			elsif p_info = 'ЛИЦЕНЗИЯ_НОМЕР' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
				i := 0;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						i := i + 1;
						P_DATA := P_DATA || i || ') ' || lic.l_num || NL$;
					end loop;				

			elsif p_info = 'ЛИЦЕНЗИЯ_ПЕРЕЧЕНЬ' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
				i := 0;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						i := i + 1;
						P_DATA := P_DATA || i || ') ' || lic.l_list || NL$;
					end loop;				

			elsif p_info = 'ЛИЦЕНЗИЯ_ДАТА_ВЫДАЧИ' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
				i := 0;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						i := i + 1;
						P_DATA := P_DATA || i || ') ' || to_char(lic.l_date1, 'dd.mm.yyyy') || NL$;
					end loop;

			elsif p_info = 'ЛИЦЕНЗИЯ_КЕМ' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
				i := 0;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						i := i + 1;
						P_DATA := P_DATA || i || ') ' || lic.l_who || NL$;
					end loop;				

			elsif p_info = 'ЛИЦЕНЗИЯ_СРОК' then	 	--ЛИЦЕНЗИИ
				P_DATA := null;
				i := 0;
					-- optimaze
					for
					(
						select lic
						(
							lic.[TYPE_LICENCE].[NAME]: 		l_type,
							lic.[NUM_LICENCE]:				l_num,
							lic.[DATE_BEGIN]:				l_date1,
							lic.[DATE_END]:					l_date2,
							lic.[WHO]:						l_who,
							lic.[LIST_TYPES]:				l_list
						)				
					in client_corp.[LICENCES]
					where nvl(lic.[DATE_BEGIN],op_dat) <= op_dat and
						  nvl(lic.[DATE_END],op_dat) >= op_dat
					order by lic.date_begin desc
					)
					loop
						i := i + 1;
						if lic.l_date2 is null then
							P_DATA := P_DATA || i || ') ' || 'бессрочно' || NL$;
						else
							P_DATA := P_DATA || i || ') ' || to_char(lic.l_date2, 'dd.mm.yyyy') || NL$;
						end if;
					end loop;				

			elsif p_info = 'СТРУКТУРА' then	 	--СТРУКТУРА
				declare
					temp_str string(4000) := 'Состав правления: ' || chr(13);
					v_counter integer := 0;
					v_tmp_cnt integer;
					v_inf		ref [CL_INFO_REQ];
				begin
					-- из структуры Органы управления
					begin
						locate v_inf in ::[CL_INFO_REQ] where v_inf.[CLIENT]%id = client_corp%id;
						
						if v_inf.[OPER_CONTROL]%size(1) > 0 then

							for ctrl
								in v_inf.[OPER_CONTROL]
								-- KAS 15.10.2021 по запросу Абрамова Юлия  "Просим поменять настройки, чтобы в любом случае директор попадал в анкету." нужно закомментироваться условие where (обе строки)
								where ctrl.[DATE_BEGIN] <= nvl(P_DATE_PRINT, trunc(sysdate))
									and (ctrl.[DATE_END] >= nvl(P_DATE_PRINT, trunc(sysdate)) or ctrl.[DATE_END] is null)
							loop
								v_tmp_cnt := 0;
								
								temp_str := ctrl.[CONTROL_TYPE].[NAME] || ': ';
							
/*****
								for gpb in ctrl.[PERSONNEL] loop
									temp_str := temp_str || bool_char(v_tmp_cnt > 0, ', ' || coalesce(gpb.[CASTA].[VALUE], gpb.[CASTA_STR], '') ||
												' ' || gpb.[CLIENT].[NAME],
												coalesce(gpb.[CASTA].[VALUE], gpb.[CASTA_STR], '') || ' ' || gpb.[CLIENT].[NAME]);

									v_tmp_cnt := v_tmp_cnt + 1;
								end loop;
******/

                            if ctrl.[CONTROL_TYPE].[CODE] = 'ЕИО'	then						
								
								for gpb in ctrl.[PERSONNEL] loop

									temp_str := temp_str || bool_char(v_tmp_cnt > 0, ', ' || coalesce(gpb.[CASTA].[VALUE], gpb.[CASTA_STR], '') ||
												' ' || gpb.[CLIENT].[NAME],
												coalesce(gpb.[CASTA].[VALUE], gpb.[CASTA_STR], '') || ' ' || gpb.[CLIENT].[NAME]);

									cl_priv := gpb.[CLIENT];
									temp_str := temp_str ||', дата рождения: '||nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_priv.[DATE_PERS]),'');
									temp_str := temp_str ||', место рождения: '|| cl_priv.[DOC].[BIRTH_PLACE];
									temp_str := temp_str ||', адрес регистрации: '||GetAddress(cl_priv.[ADDRESSES],'ALL','REGISTRATION');
									temp_str := temp_str ||', место пребывания: '||GetAddress(cl_priv.[ADDRESSES],'ALL','REAL_LIVE');
									temp_str := temp_str ||', документ: '||Get_Passport(cl_priv);
									temp_str := temp_str ||', отношение к ПДЛ: '||GetPDLStr(cl_priv.[IS_IPDL], null);		
                                    temp_str := temp_str ||', контактные данные: '||GetContacts(cl_priv.[CONTACTS], 'PHONE')||GetContacts(cl_priv.[CONTACTS], 'MOBILEPHONE')||GetContacts(cl_priv.[CONTACTS], 'FAX');		

									v_tmp_cnt := v_tmp_cnt + 1;
								end loop;

      						else

                               for gpb in ctrl.[PERSONNEL] loop
									temp_str := temp_str || bool_char(v_tmp_cnt > 0, ', ' || coalesce(gpb.[CASTA].[VALUE], gpb.[CASTA_STR], '') ||
												' ' || gpb.[CLIENT].[NAME],
												coalesce(gpb.[CASTA].[VALUE], gpb.[CASTA_STR], '') || ' ' || gpb.[CLIENT].[NAME]);

									v_tmp_cnt := v_tmp_cnt + 1;
								end loop;

               				end if; --if ЕИО

								if v_tmp_cnt > 0 then
									P_DATA := P_DATA || temp_str || chr(13);
								end if;
		
								v_counter := v_counter + 1;
							end loop;
						end if;
					exception
						when NO_DATA_FOUND then
							null;
					end;
					-- если в структуре пусто, заполняем по старому
					if v_counter = 0 then				
			 			P_DATA := nvl(trim(client_corp.[ADMINISTRATION]), '');
						P_DATA := rtl.bool_char(P_DATA is null, null, 'Органы управления:'||chr(13)||P_DATA||chr(13));				
					
/**********
						for(
							select x(x.[PARTNER].[NAME] : FIO, x.[CLIENT_NAME] : CL_NAME )
							in client_corp.[LINKS_OTHER]
							where x.[VID_LINK].[CODE] = 'УПРАВЛЕНИЕ_ОРГ')
						loop
							if nvl(x.[FIO],x.[CL_NAME]) is not null then
								temp_str := temp_str || bool_char(v_counter > 0,', ' || nvl(x.[FIO],x.[CL_NAME]), nvl(x.[FIO],x.[CL_NAME]) );
								v_counter := v_counter + 1;
							end if;
						end loop;
*****************/

						for(
							select dolg
								(
									dolg.[RANGE].[VALUE]: 	d_range,
									dolg.[FASE].[NAME]:		d_name,
								    dolg.[FASE]:cl_ref
								 )
							in client_corp.[ALL_BOSS]	
	                        where dolg.[FASE] is not null and dolg.[CHIEF]
                       	  )
	                   loop

                          P_DATA:= P_DATA||', '||rtrim(dolg.d_range) || ' ' || rtrim(dolg.d_name);
                          cl_priv:=dolg.cl_ref;
                          P_DATA:=P_DATA|| ', '||'дата рождения: '||nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_priv.[DATE_PERS]),'');
                          P_DATA:= P_DATA||', '||'место рождения: '|| cl_priv.[DOC].[BIRTH_PLACE];
	                      P_DATA:= P_DATA||', '||'адрес регистрации: '||GetAddress(cl_priv.[ADDRESSES],'ALL','REGISTRATION');
	                      P_DATA:= P_DATA||', '||'адрес фактический: '||GetAddress(cl_priv.[ADDRESSES],'ALL','REAL_LIVE');
                          P_DATA:= P_DATA||', '||'документ: '||Get_passport(cl_priv);
                          P_DATA:= P_DATA||', '||GetContacts(cl_priv.[CONTACTS], 'PHONE')||
                          		  GetContacts(cl_priv.[CONTACTS], 'MOBILEPHONE')||
			                      GetContacts(cl_priv.[CONTACTS], 'FAX');
                          P_DATA:= P_DATA||', '||',отношение к ПДЛ: '||GetPDLStr(cl_priv.[IS_IPDL], null);
                       end loop;

						if v_counter > 0 then
							P_DATA := P_DATA || temp_str;
						end if;
					end if;
				end;
	
			elsif p_info = 'КАПИТАЛ' then	 	--КАПИТАЛ
				P_DATA := nvl(client_corp.[REGISTER].[DECLARE_UF], '');
				if P_DATA is not null then
					P_DATA := P_DATA || ' '||client_corp.[REGISTER].[DECLARE_UF_CUR].[INT_CUR_SHORT];
				end if;
		 		P_DATA := rtl.bool_char(P_DATA is not null, 'Объявленный уставной фонд: '||P_DATA||chr(13), '');
		 		temp_string := nvl(client_corp.[REGISTER].[PAID_UF], '');
				if temp_string is not null then
					temp_string := temp_string || ' '||client_corp.[REGISTER].[PAID_UF_CUR].[INT_CUR_SHORT];
				end if;
		 		P_DATA := P_DATA || rtl.bool_char(temp_string is not null, 'Оплаченный уставной фонд: '||temp_string, '');
		 				 	
			elsif p_info = 'ОБЪЯВ_УСТ_ФОНД' then	 	--Объявленный уставной фонд
				P_DATA := nvl(client_corp.[REGISTER].[DECLARE_UF], '');
				if P_DATA is not null then
					P_DATA := P_DATA || ' '||client_corp.[REGISTER].[DECLARE_UF_CUR].[INT_CUR_SHORT];
				end if;

			elsif p_info = 'ОПЛАЧ_УСТ_ФОНД' then	 	--Оплаченный уставной фонд
				P_DATA := nvl(client_corp.[REGISTER].[PAID_UF], '');
				if P_DATA is not null then
					P_DATA := P_DATA || ' '||client_corp.[REGISTER].[PAID_UF_CUR].[INT_CUR_SHORT];
				end if;

			elsif p_info = 'КОНТРАГЕНТ' then	 	--КОНТРАГЕНТ
				P_DATA := '';
				for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'КОНТРАГЕНТ'
					and ((cl_link.[DATE_BEG] is null or cl_link.[DATE_BEG] <= P_DATE_PRINT))
					and ((cl_link.[DATE_END] is null or cl_link.[DATE_END] >= P_DATE_PRINT))

				loop
					temp_string := nvl(cl_link.[PARTNER].[NAME], '');
					P_DATA := P_DATA || rtl.bool_char(temp_string is not null, temp_string|| ', ', '');
				end loop;
				P_DATA := trim(P_DATA);
				P_DATA := substr(P_DATA,1,length(P_DATA)-1);
                P_DATA := P_DATA ||nvl(GetAddProps(P_DATE_PRINT, 'CL_ANK_OSN_KONTR'), '')||NL$; --в доп.свойствах тоже может быть
/*********
	 		--Сведения о планируемых плательщиках клиента
	 			temp_string := GetAddProps(P_DATE_PRINT, 'CL_ANK_PLAN_PAY');
				P_DATA := P_DATA || rtl.bool_char(temp_string is not null, temp_string|| ', ', '');
	 		--Сведения о планируемых получателях клиента
	 			temp_string := GetAddProps(P_DATE_PRINT, 'CL_ANK_PLAN_REC');
				P_DATA := P_DATA || nvl(temp_string, '');
***********/
			elsif p_info = 'FORM_CODE' then
				P_DATA	:= client_corp.[FORM_CODE];
				if trim(P_DATA) is null then P_DATA:='ОКТМО: '; end if;
				
			elsif p_info = 'USER_OP' then
			    begin
			        locate account in ::[AC_FIN] where account.[CLIENT_V]=this order by account.[DATE_OP] asc;
	            exception
	                when NO_DATA_FOUND then
	                account := null;
		 		end;
		 		if account is not null then
		 			P_DATA := account.USER_OP.name;
		 		else
		 		    P_DATA :='';
		 		end if;
		 	
		 	elsif p_info = 'ВЫГОДОПРИОБРЕТАТЕЛЬ' then
		 		P_DATA := 'Выгодоприобретатели: ';
				v_count:=0;

				for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОПРИОБРЕТАТЕЛЬ'
					and ((cl_link.[DATE_BEG] is null or cl_link.[DATE_BEG] <= P_DATE_PRINT))
					and ((cl_link.[DATE_END] is null or cl_link.[DATE_END] >= P_DATE_PRINT))

				loop
					temp_string := nvl(cl_link.[PARTNER].[NAME], cl_link.[CLIENT_NAME]);
--but
					temp_string := temp_string || '. Адрес: ' || GetAddress(cl_link.[PARTNER].[ADDRESSES],'ALL','REGISTRATION');
--					
					P_DATA := P_DATA || rtl.bool_char(temp_string is not null, temp_string|| ', ', '');
				end loop;
				if v_count=0 then P_DATA:=P_DATA||'нет'; end if;

/*******************
				P_DATA := rtrim(P_DATA,' ,');
				
				P_DATA := P_DATA || NL$ || 'Выгододатели: ';
				v_count:=0;
				for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ' loop
					v_count:=v_count +1;
					temp_string := nvl(cl_link.[PARTNER].[NAME], cl_link.[CLIENT_NAME]);
--but
					temp_string := temp_string || '. Адрес: ' || GetAddress(cl_link.[PARTNER].[ADDRESSES],'ALL','REGISTRATION');
--
					P_DATA := P_DATA || rtl.bool_char(temp_string is not null, temp_string|| ', ', '');
				end loop;

				if v_count=0 then P_DATA:=P_DATA||'нет'; end if;

****************/
				P_DATA := rtrim(P_DATA,' ,');

		 	elsif p_info = 'ВЫГОДОДАТЕЛЬ' then
		 		P_DATA := null;
		 		if client_corp%id is null then
		 			links_ref := client_priv.[LINKS_OTHER];
		 		else
		 			links_ref := client_corp.[LINKS_OTHER];
		 		end if;	
		 		
		 		for(select cl_link(cl_link.[PARTNER]->(false)[NAME] : partner_name,
                             cl_link.[PARTNER] : partner)
					in ::[LINKS_CL] all
					where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ'
                    		and cl_link%collection = links_ref
							and (cl_link.[DATE_BEG] <= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_BEG] is null)
							and (cl_link.[DATE_END] >= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat) or cl_link.[DATE_END] is null)
					)					
					
				loop

					var rTmpCl number;
--                        rTmpCl:=links_ref;
					temp_string := nvl(cl_link.partner_name, '');
					P_DATA := P_DATA || rtl.bool_char(temp_string is not null, temp_string|| ', ', '');
					declare
   					acc	ref [AC_FIN];

					begin
     				    rTmpCl:=cl_link.[PARTNER];
                        locate acc in ::[AC_FIN] where acc.[CLIENT_V] = rTmpCl;
                        if acc.[MAIN_V_ID] is not null then
	                        P_DATA := P_DATA || ' счет '||acc.[MAIN_V_ID];
                        end if;
					exception
						when NO_DATA_FOUND then null;
					end;
		 		end loop;

				if P_DATA is null then
					P_DATA := 'нет';
				end if;

			elsif p_info = 'ПРЕДСТАВИТЕЛЬ' then
		 		P_DATA := 'Представители: ';
				
				for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ПРЕДСТАВИТЕЛЬ'
					and ((cl_link.[DATE_BEG] is null or cl_link.[DATE_BEG] <= P_DATE_PRINT))
					and ((cl_link.[DATE_END] is null or cl_link.[DATE_END] >= P_DATE_PRINT))
				
				loop
					
					cl_priv := cl_link.[PARTNER];
					
					temp_string := nvl(cl_priv.[NAME], cl_link.[CLIENT_NAME]);
--but
      				temp_string := temp_string || '. Адрес: ' || GetAddress(cl_priv.[ADDRESSES],'ALL','REGISTRATION');

      				temp_string := temp_string || '. Документ: ' || Get_Passport(cl_priv);
			
			        temp_string := temp_string || '. Дата Рождения: ' || nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_priv.[DATE_PERS]), '');
			
			        temp_string := temp_string || '. Место Рождения: ' || cl_priv.[DOC].[BIRTH_PLACE];
					
					P_DATA := P_DATA || rtl.bool_char(temp_string is not null, temp_string|| ', ', '');
				end loop;
				P_DATA := rtrim(P_DATA,' ,');

				elsif p_info = 'ЛИЦО_ДЛЯ_СВЯЗИ' then
		 		P_DATA := '';
				for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ЛИЦО_ДЛЯ_СВЯЗИ'
					and ((cl_link.[DATE_BEG] is null or cl_link.[DATE_BEG] <= P_DATE_PRINT))
					and ((cl_link.[DATE_END] is null or cl_link.[DATE_END] >= P_DATE_PRINT))
			
				loop
					temp_string := nvl(cl_link.[PARTNER].[NAME], cl_link.[CLIENT_NAME]);
					P_DATA := P_DATA || rtl.bool_char(temp_string is not null, temp_string|| ', ', '');
				end loop;
				P_DATA := rtrim(P_DATA,' ,');
--				
			elsif	p_info = 'ПОДРАЗДЕЛЕНИЕ' then
				if P_DEPART_STR is not null then
					P_DATA := P_DEPART_STR;
				else
					P_DATA := '           ';
				end if;
	
			elsif (p_info='ОСНОВАНИЕ') then
				P_DATA := '';
				for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ' order by cl_link.[DATE_BEG] loop
	
					if (cl_link.[FOUND] is not null)
						and (cl_link.[DATE_BEG]<=P_DATE_PRINT or cl_link.[DATE_BEG] is null)
						and (cl_link.[DATE_END]>=P_DATE_PRINT or cl_link.[DATE_END] is null) then
						P_DATA := rtl.bool_char(P_DATA is not null, P_DATA || NL$, '') || cl_link.[FOUND];
					end if;			
				end loop;			 					
	
			elsif p_info = 'ДАТА_ЗАПОЛН_ВЫГ' then	
				P_DATA := '';
				for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'ВЫГОДОДАТЕЛЬ' order by cl_link.[DATE_BEG] loop
	
					if (cl_link.[DATE_BEG] is not null) then
						P_DATA := ::[RUNTIME].[VIEWFUN].DAT_STR(cl_link.[DATE_BEG]);
						exit;
					end if;			
				end loop;			 					
			elsif p_info = 'ВЫГОДОДАТ_С_ОСН' then
				P_DATA := fill_benefit(P_DATE_PRINT, client_corp.[LINKS_OTHER], ::[CL_LINK]([CODE]='ВЫГОДОДАТЕЛЬ'), true, true);
			elsif p_info = 'ВЫГОДОПРИ_С_ОСН' then
				P_DATA := fill_benefit(P_DATE_PRINT, client_corp.[LINKS_OTHER], ::[CL_LINK]([CODE]='ВЫГОДОПРИОБРЕТАТЕЛЬ'), true, true);
	 		elsif p_info = 'ФАКТ_АДРЕС' then
	 			P_DATA := ::[LEGAL_INTERFACE].[PRX_FP].stock_lib_client_get_reqvs(this, '{[ИНДЕКС],} {[Обл],} {[типнп] [Город],} [Ул] [дом] {корпус [КОРПУС]} {кв. [кв]}', 'FACT');
	 		elsif p_info = 'РУКОВОДИТЕЛЬ' then
	 			declare
	 				m_card string(100)	:= null;
	 			begin
	 				for(
						select boss(
							boss.[FASE]					:FASE,
							boss.[RANGE].[VALUE]		:RANGE_V,
							decode(boss.[FASE].[BORN], null, boss.[FASE].[DOC].[BIRTH_PLACE], boss.[FASE].[BORN].[NAME])	:B_PLACE
						)
						in [ALL_BOSS]
						where boss.[CHIEF]
						and	nvl(boss.[WORK_END], P_DATE_PRINT) >= P_DATE_PRINT
						and boss.[FASE]%class = 'CL_PRIV'
					)
					loop
						m_card := migr_card_str(boss.[FASE]);
						if m_card is not null then
							m_card := 'Миграционная карта № '||m_card||LF$;
						end if;
						
						P_DATA := P_DATA||::[LEGAL_INTERFACE].[PRX_FP].stock_lib_client_get_reqvs(
												boss.[FASE],
												boss.[RANGE_V]||';'||LF$||
												'{[_ИМЯ];'||LF$||'}'||
												'{[ДАТАРОЖД]; }'||boss.[B_PLACE]||LF$||
												'{[_ГРАЖДАНСТВО];'||LF$||'}'||
												'{[адрес_ю];'||LF$||'}'||
												'{[документ];'||LF$||'}'||
												m_card||
												'{[ИНН];'||LF$||'}'||
												'{[тел.]}{/[факс]}'||' '||GetContacts(boss.[FASE].[CONTACTS], 'MAIL')
											)||NL$;
					end loop;
	 			end;
	 		elsif p_info = 'ЗА_РУК' then
	 			declare
	 				m_card string(100)	:= null;
	 			begin
	 				for(
						select boss(
							boss.[FASE]					:FASE,
							boss.[RANGE].[VALUE]		:RANGE_V,
							decode(boss.[FASE].[BORN], null, boss.[FASE].[DOC].[BIRTH_PLACE], boss.[FASE].[BORN].[NAME])	:B_PLACE
						)
						in [ALL_BOSS], (::[MARK_PERS] all :mp)
						where nvl(boss.[CHIEF], '0') != true
							and	nvl(boss.[WORK_END], P_DATE_PRINT) >= P_DATE_PRINT
							and boss.[FASE]%class = 'CL_PRIV'
							and mp.[MARK].[CODE] = 'SIGN_BOSS'
							and boss.[MARK_PERS] = mp%collection
					)
					loop
						m_card := migr_card_str(boss.[FASE]);
						if m_card is not null then
							m_card := 'Миграционная карта № '||m_card||LF$;
						end if;
						P_DATA := P_DATA||::[LEGAL_INTERFACE].[PRX_FP].stock_lib_client_get_reqvs(
												boss.[FASE],
												boss.[RANGE_V]||';'||LF$||
												'{[_ИМЯ];'||LF$||'}'||
												'{[ДАТАРОЖД]; }'||boss.[B_PLACE]||LF$||
												'{[_ГРАЖДАНСТВО];'||LF$||'}'||
												'{[адрес_ю];'||LF$||'}'||
												'{[документ];'||LF$||'}'||
												m_card||
												'{[ИНН];'||LF$||'}'||
												'{[тел.]}{/[факс]}'||' '||GetContacts(boss.[FASE].[CONTACTS], 'MAIL')
											)||NL$;
					end loop;
	 			end;
	 		elsif p_info = 'ГЛ_БУХГАЛТЕР' then
	 			declare
	 				m_card string(100)	:= null;
	 			begin
	 				for(
						select boss(
							boss.[FASE]				: FASE,
							boss.[RANGE].[VALUE]	: RANGE_V,
							decode(boss.[FASE].[BORN], null, boss.[FASE].[DOC].[BIRTH_PLACE], boss.[FASE].[BORN].[NAME]) : B_PLACE
						)
						in [ALL_BOSS]
						where boss.[GENERAL_ACC]
						and	nvl(boss.[WORK_END], P_DATE_PRINT) >= P_DATE_PRINT
						and boss.[FASE]%class = 'CL_PRIV'
					)
					loop
						m_card := migr_card_str(boss.[FASE]);
						if m_card is not null then
							m_card := 'Миграционная карта № '||m_card||LF$;
						end if;
						P_DATA := P_DATA||::[LEGAL_INTERFACE].[PRX_FP].stock_lib_client_get_reqvs(
												boss.[FASE],
												boss.[RANGE_V]||';'||LF$||
												'{[_ИМЯ];'||LF$||'}'||
												'{[ДАТАРОЖД]; }'||boss.[B_PLACE]||LF$||
												'{[_ГРАЖДАНСТВО];'||LF$||'}'||
												'{[адрес_ю];'||LF$||'}'||
												'{[документ];'||LF$||'}'||
												m_card||
												'{[ИНН];'||LF$||'}'||
												'{[тел.]}{/[факс]}'||' '||GetContacts(boss.[FASE].[CONTACTS], 'MAIL')
											)||NL$;
					end loop;
	 			end;
	 		elsif p_info = 'ЗА_ГЛБУХ' then
	 			declare
	 				m_card string(100)	:= null;
	 			begin
	 				for(
						select boss(
							boss.[FASE]					: FASE,
							boss.[RANGE].[VALUE]		: RANGE_V,
							decode(boss.[FASE].[BORN], null, boss.[FASE].[DOC].[BIRTH_PLACE], boss.[FASE].[BORN].[NAME]) : B_PLACE
						)
						in [ALL_BOSS], (::[MARK_PERS] all :mp)
						where nvl(boss.[GENERAL_ACC], '0') != true
							and	nvl(boss.[WORK_END], P_DATE_PRINT) >= P_DATE_PRINT
							and boss.[FASE]%class = 'CL_PRIV'
							and mp.[MARK].[CODE] = 'SIGN_BUH'
							and boss.[MARK_PERS] = mp%collection
					)loop
						m_card := migr_card_str(boss.[FASE]);
						if m_card is not null then
							m_card := 'Миграционная карта № '||m_card||LF$;
						end if;
						P_DATA := P_DATA||::[LEGAL_INTERFACE].[PRX_FP].stock_lib_client_get_reqvs(
												boss.[FASE],
												boss.[RANGE_V]||';'||LF$||
												'{[_ИМЯ];'||LF$||'}'||
												'{[ДАТАРОЖД]; }'||boss.[B_PLACE]||LF$||
												'{[_ГРАЖДАНСТВО];'||LF$||'}'||
												'{[адрес_ю];'||LF$||'}'||
												'{[документ];'||LF$||'}'||
												m_card||
												'{[ИНН];'||LF$||'}'||
												'{[тел.]}{/[факс]}'||' '||GetContacts(boss.[FASE].[CONTACTS], 'MAIL')
											)||NL$;
					end loop;
	 			end;
	 		elsif p_info = 'ВНОСИТЕЛЬ' then
	 			declare
	 				m_card string(100)	:= null;
	 			begin
	 				for(
						select links(
							links.[PARTNER] 			:PARTNER,
							decode(links.[PARTNER]->([CL_PRIV])[BORN],
								null, links.[PARTNER]->([CL_PRIV])[DOC].[BIRTH_PLACE],
								links.[PARTNER]->([CL_PRIV])[BORN].[NAME])	:B_PLACE
						)
						in [LINKS_OTHER]
						where links.[VID_LINK].[CODE] = 'ВНОСИТЕЛЬ'
						and links.[PARTNER]%class = 'CL_PRIV'
					)
					loop
						m_card := migr_card_str(links.[PARTNER]);
						if m_card is not null then
							m_card := 'Миграционная карта № '||m_card||LF$;
						end if;
						P_DATA := P_DATA||::[LEGAL_INTERFACE].[PRX_FP].stock_lib_client_get_reqvs(
												links.[PARTNER],
												'{[_ИМЯ];'||LF$||'}'||
												'{[ДАТАРОЖД]; }'||links.[B_PLACE]||LF$||
												'{[_ГРАЖДАНСТВО];'||LF$||'}'||
												'{[адрес_ю];'||LF$||'}'||
												'{[документ];'||LF$||'}'||
												m_card||
												'{[ИНН];'||LF$||'}'||
												'{[тел.]}{/[факс]}'||' '||GetContacts(links.[PARTNER].[CONTACTS], 'MAIL')
											)||NL$;
					end loop;
	 			end;
	 		elsif p_info = 'ОБОСН_РИСКА' then
                is_benef:=false; is_country:=false; is_prod:=false; is_vid_op:=false;
 				for(
					select crit(
						crit.[CRITERIA].[NAME] :NAME
						,crit.[ACTIVE_FACTORS] :pArr
						,crit.[CRITERIA].[CODE]:code						
					)
					in ::[MONITORING_CRIT] all
					where crit.[CLIENT] = this
					and (crit.[CRIT_DATE_BEGIN] is null or crit.[CRIT_DATE_BEGIN] <= op_dat)
					and (crit.[CRIT_DATE_END] is null or crit.[CRIT_DATE_END] >= op_dat)
				)
				loop
 				  if    crit.[CODE] like 'PSH_BENEF%'    then is_benef:=true; 	
                  elsif crit.[CODE] like 'PSH_COUNTRY%'  then is_country:=true; 	
                  elsif crit.[CODE] like 'PSH_PROD%'     then is_prod:=true; 	
                  elsif crit.[CODE] like 'PSH_VID_OP%'   then is_vid_op:=true; 	
                  end if;					
			      P_DATA := P_DATA||crit.[NAME]||NL$;
						--далее ищем факторы клиента по текущему критерию
						for(
								select x(x%Id : Id)
								in		crit.[pArr]
						
						        where x.[DATE_BEGIN]<= op_dat
						     			and nvl(x.[DATE_END], op_dat)	>= op_dat
						     			)
						     loop
								fc := x.Id;
						        rf:= fc.[FACTOR];
								P_DATA := P_DATA||rf.[NAME]||NL$;
						    end loop;

				end loop;
		
                  if not is_benef   then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск по типу клиента и (или) бенефициарного владельца;'||NL$; end if;
                  if not is_country then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Страновой риск;'||NL$; end if;
                  if not is_prod    then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск продукта;'||NL$; end if;
                  if not is_vid_op  then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск, связанный с проведением клиентом определенного вида операций;'||NL$; end if;
				
                 -- Кокорин АС 03.09.14 для печати обоснования оценки рика из реквизита "Оценка риска легализации"				
			         --	P_DATA := ltrim(P_DATA, '; ');
				
				If P_DATA = ' ' or P_DATA is null then
					P_DATA := 'Критерий риска не соответствует ни одному пункту ПВК оценки высокого или среднего уровня риска';
				else
				--	P_DATA := this.[FAIL_MARK];
					P_DATA := ltrim(P_DATA, '; ');
				end if;
				
--------------------------------------------------------------------------------------------------
	 		elsif p_info = 'ОБОСНОВ_РИСКА' then
	 			P_DATA := '';
                is_benef:=false; is_country:=false; is_prod:=false; is_vid_op:=false;
 				for(
					select crit(
						crit.[CRIT_DATE_BEGIN]	:date_begin
						,crit.[CRIT_DATE_END]	:date_end
						,crit.[CRITERIA].[NAME] :NAME
						,crit.[ACTIVE_FACTORS] :pArr
						,crit.[CRITERIA].[CODE]:code						
					)
					in ::[MONITORING_CRIT] all
					where crit.[CLIENT] = this
					and (crit.[CRIT_DATE_BEGIN] is null or crit.[CRIT_DATE_BEGIN] <= op_dat)
					and (crit.[CRIT_DATE_END] is null or crit.[CRIT_DATE_END] >= op_dat)
				)
				loop
 				  if    crit.[CODE] like 'PSH_BENEF%'    then is_benef:=true; 	
                  elsif crit.[CODE] like 'PSH_COUNTRY%'  then is_country:=true; 	
                  elsif crit.[CODE] like 'PSH_PROD%'     then is_prod:=true; 	
                  elsif crit.[CODE] like 'PSH_VID_OP%'   then is_vid_op:=true; 	
                  end if;
                  P_DATA := P_DATA||to_char(crit.date_begin, fmt)||' ';
                  if crit.date_end is not null then
                  	P_DATA := P_DATA||'- '||to_char(crit.date_end, fmt)||' ';
                  end if;					
			      P_DATA := P_DATA||crit.[NAME]||NL$;
				--далее ищем факторы клиента по текущему критерию
						for(
								select x(x%Id : Id)
								in		crit.[pArr]
						
						        where x.[DATE_BEGIN]<= op_dat
						     			and nvl(x.[DATE_END], op_dat)	>= op_dat
						     			)
						     loop
								fc := x.Id;
						        rf:= fc.[FACTOR];
								P_DATA := P_DATA||rf.[NAME]||NL$;
						    end loop;
				end loop;
		
                /*  if not is_benef   then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск по типу клиента и (или) бенефициарного владельца;'||NL$; end if;
                  if not is_country then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Страновой риск;'||NL$; end if;
                  if not is_prod    then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск продукта;'||NL$; end if;
                  if not is_vid_op  then P_DATA:=P_DATA||'Не соответствует ни одному из критериев высокого и критичного уровня риска по категории Риск, связанный с проведением клиентом определенного вида операций;'||NL$; end if;
				--*/
				If P_DATA = ' ' or P_DATA is null then
					P_DATA := 'Критерий риска не соответствует ни одному пункту ПВК оценки высокого или среднего уровня риска';
				else
					P_DATA := ltrim(P_DATA, '; ');
				end if;
--------------------------------------------------------------------------------------------------		

			elsif p_info = 'OPER_CHARACTER' then
				P_DATA := SubStr(client_corp.[OPER_CHARACTER]||iif(client_corp.[PSH_OPER_CHAR] is null,'',LF$||client_corp.[PSH_OPER_CHAR]),1,32767);
			elsif p_info = 'ШТАТНАЯ_ЧИСЛЕННОСТЬ' then
	 			P_DATA := nvl(GetAddProps(P_DATE_PRINT, 'CL_ANK_SOTRUDNIKI'), client_corp.[NUMBERS]);
			elsif p_info = 'ПРИНЦИПАЛ' then   --ПРИНЦИПАЛ BS00299498
				for i in principal.first..principal.last
				loop
					P_DATA := P_DATA || ', ' || principal(i);					
				end loop;	
				P_DATA := nvl(rtrim(ltrim(P_DATA, ', '), ', '), '');	
			elsif p_info = 'ВИД_ДЕЯТЕЛЬНОСТИ' then	--BS00468164
	 			declare
	 				cl ref [CL_ORG];
	 			begin
	 				locate cl in ::[CL_ORG] where cl%id = this%id;
	 				P_DATA := trim(cl.[BUSINESS]);
	 			exception
	 				when NO_DATA_FOUND then null;
	 			end;
	 		elsif p_info = 'БЕНЕФИЦИАР' then
			P_DATA := 'Бенефициары: ';
				for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
					and ((cl_link.[DATE_BEG] is null or cl_link.[DATE_BEG] <= P_DATE_PRINT))
					and ((cl_link.[DATE_END] is null or cl_link.[DATE_END] >= P_DATE_PRINT))

				loop
					
					temp_string := nvl(cl_link.[PARTNER].[NAME], cl_link.[CLIENT_NAME]);
					temp_string := temp_string || '. Адрес регистрации: ' || GetAddress(cl_link.[PARTNER].[ADDRESSES],'ALL','REGISTRATION');					
					temp_string := temp_string || '. Адрес места жительства: ' || GetAddress(cl_link.[PARTNER].[ADDRESSES],'ALL','REAL_LIVE');					

--
                    cl_priv := cl_link.[PARTNER];
                    temp_string := temp_string || '. Документ: ' || Get_Passport(cl_priv);
                    temp_string := temp_string || '. Дата Рождения: ' || nvl(::[RUNTIME].[VIEWFUN].DAT_STR(cl_priv.[DATE_PERS]), '');
                    temp_string := temp_string || '. Место Рождения: ' || cl_priv.[DOC].[BIRTH_PLACE];
--										
					P_DATA := P_DATA || rtl.bool_char(temp_string is not null, temp_string|| ', ', '');
				end loop;
				P_DATA := rtrim(P_DATA,' ,');
			
				if P_DATA is null then
                	P_DATA :='';
				end if;
	 		
	 		elsif p_info like 'БЕНЕФИЦИАР_ФИО%' then
	 			P_DATA :='';
	 			for cl_link in client_corp.[LINKS_OTHER] where cl_link.[VID_LINK].[CODE] = 'БЕНЕФИЦИАР'
					and ((cl_link.[DATE_BEG] is null or cl_link.[DATE_BEG] <= P_DATE_PRINT))
					and ((cl_link.[DATE_END] is null or cl_link.[DATE_END] >= P_DATE_PRINT))
				loop		
					temp_string := nvl(cl_link.[PARTNER].[NAME], cl_link.[CLIENT_NAME]);
					P_DATA := P_DATA || rtl.bool_char(temp_string is not null, temp_string|| ', ', '');
	 			end loop;
	 			P_DATA := rtrim(P_DATA,', ');
	 			
	 		elsif p_info = 'КОДЫ_ФОРМ' then
 			
	 		--Коды форм федерального государственного статистического наблюдения (ОКПО, ОКВЭД, ОКАТО, ОКОГУ)
	 			P_DATA := bool_char(client_corp.[OWNERSHIP] is not null, 'ОКФС: '||client_corp.[OWNERSHIP].[NAME], 'ОКФС: нет сведений')||NL$||				
	 				bool_char(client_corp.[FORMA] is not null, 'ОКОПФ: '||client_corp.[FORMA].[CODE], 'ОКОПФ: нет сведений')||NL$||				
                    bool_char(client_corp.[OKTMO_CODE] is not null, 'ОКТМО: '||client_corp.[OKTMO_CODE], 'ОКТMО: нет сведений')||NL$||
	 				bool_char(client_corp.[OKATO_CODE] is not null, 'ОКАТО: '||client_corp.[OKATO_CODE], 'ОКАТО: нет сведений')||NL$||
	 				bool_char(client_corp.[OKOGU_CODE] is not null, 'ОКОГУ: '||client_corp.[OKOGU_CODE].[CODE], 'ОКОГУ: нет сведений')||NL$||
	 				bool_char(client_corp.[KOD_OKPO] is not null, 'ОКПО: '||client_corp.[KOD_OKPO], 'ОКПО: нет сведений');

	 		elsif p_info = 'СЧЕТА_В_БАНКАХ' then
	 		-- Счета в друних банках
				for z in client_corp.[ACC_BANK] loop
					temp_string := z.[TYPE].[NAME_ACC] || ' ' || z.[MAIN_V_ID] || ' в ' || z.[BANK].NAME;
					P_DATA := bool_char(P_DATA=' ', P_DATA||temp_string, P_DATA||NL$||temp_string);
				end loop;
  				P_DATA := ltrim(P_DATA, NL$);
 	 		elsif p_info = 'ЦЕЛИ_ДЕЛ_ОТН' then
	 		--Сведения о целях установления деловых отношений с Банком
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PURPOSES_REL');
	 		elsif p_info = 'ХАРАКТЕР_ДЕЛ_ОТН' then
	 		--Сведения о предполагаемом характере деловых отношений с Банком
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_CHARACTER_REL');
	 		elsif p_info = 'ЦЕЛИ_ФИНХОЗ_ДЕЯТ' then
	 		--Сведения о целях финансово-хозяйственной деятельности
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PURPOSES_ACTIV');
	 		elsif p_info = 'ФИН_ПОЛОЖ' then
	 		--Сведения о текущем финансовом положении
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_FINANCIAL_POS');
	 		elsif p_info = 'РЕПУТАЦИЯ' then
	 		--Сведения о деловой репутации
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_REPUTATION_JUR');
	 		elsif p_info = 'ФИН_ИСТОЧНИК' then
	 		--Сведения об источниках происхождения фин. средств
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_SOURCES_OF_MONEY');	 			
           elsif p_info = 'КОЛ_ОП_СТР' then
	 		--Сведения об объеме операций за квартал. если в CL_ANK_KOL_OP_STR пусто, выводим по-старому
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_KOL_OP_STR');
                if P_DATA is null then
 		 			temp_string := GetAddProps(P_DATE_PRINT, 'CL_ANK_KOL_OP');
	                    if temp_string is not null then temp_string:='Количество операций за квартал: '||temp_string;
	                    end if;
		 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_SUM_OP');
	                    if P_DATA is not null then P_DATA:=temp_string||' Сумма операций за квартал: '||P_DATA;
	                    else P_DATA := temp_string;
	                    end if;
                end if;
/***************
           elsif p_info = 'КОЛ_ОП_СТР' then
 	 		--Сведения о количестве операций за период
	 			P_DATA := nvl(GetAddProps(P_DATE_PRINT, 'CL_ANK_KOL_OP_STR'),'-');
           elsif p_info = 'КОЛ_ОП' then
	 		--Сведения о количестве операций за квартал
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_KOL_OP');
	 			if P_DATA is not null then P_DATA:=' количество операций: '||P_DATA; end if;
    	   elsif p_info = 'СУМ_ОП' then
	 		--Сведения о сумме операций за квартал
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_SUM_OP');
	 			if P_DATA is not null then P_DATA:=' сумма операций: '||P_DATA; end if;
****************/
           elsif p_info = 'ВИД_ДОГ' then
	 		--Сведения о видах договоров клиента
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_VID_DOG');
           elsif p_info = 'ПЛАН_ПЛАТ' then
	 		--Сведения о планируемых плательщиках клиента
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PLAN_PAY');
           elsif p_info = 'ПЛАН_ПОЛУЧ' then
	 		--Сведения о планируемых получателях клиента
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PLAN_REC');
			elsif p_info = 'ПЕРЕВОД_НЕРЕЗ' then
	 		--Сведения о переводах клиента нерезидентам
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PLAN_NEREZ');
			elsif p_info = 'ИДЕНТ_БЕНЕФИЦИАРА' then
	 		--Сведения об идентификации бенефициара клиента
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PSH_IDENT_BEN_JUR');	 			
			elsif p_info = 'REZ_USA' then  --пока так
	 		--Сведения о статусе налогового резидента
	 			P_DATA := 'нет';
			elsif p_info = 'JUR_PDL' then  --пока так
	 		--Сведения о статусе налогового резидента
	 			P_DATA := 'нет';

		/*	elsif p_info = 'ТЕРРОРИЗМ_РЕЗУЛЬТАТ' then	 	--результаты проверки на терроризм

				for rec in [legal_list]
					where rec.[LIST_DATE] <= P_DATE_PRINT and rec.[LIST_DATE]<=nvl(cl_info.[CLOSE_DATE],P_DATE_PRINT)
					order by rec.[LIST_DATE] desc	
				loop
					result := rec;
					exit;
				end loop;

				if result is not null then	
                     date_test:= result.[LIST_DATE];
					 if date_test<=P_DATE_ANK then
					    date_test:= P_DATE_ANK;
					 end if;
				     P_DATA:= 'Проверка по списку подозрительных лиц и организаций '||result.[FILE_NAME]||' от '||to_char(result.[LIST_DATE],'dd.mm.yyyy')||' г. Дата проверки '||to_char(date_test,'dd.mm.yyyy')||' г. В списке не значится.';	
				else P_DATA:= ' ';
				end if;*/
				
			elsif p_info = 'ТЕРРОРИЗМ_РЕЗУЛЬТАТ' then temp_data:=null;
				
				/*for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' order by rez.[CHECK_DATE]
				loop
				temp_data:='Проверен '||to_char(rez.[CHECK_DATE],'DD.MM.YYYY')||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||' результат: '||rez.[CHECK_VAL].[NAME]||';'||CHR(13);
				exit;
				end loop;*/
				
				for rec in [legal_list]
					where rec.[LIST_DATE] < nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK])
					order by rec.[LIST_DATE] desc
				loop
					temp_data:=Substr(temp_data||'Проверен '||to_char(nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]),'DD.MM.YYYY')||' по '||rec.[FILE_NAME]||' нет совпадений по справочнику террорисов РФ;'||CHR(13),1,temp_data%size);
				exit;
				end loop;
				
				for rec in [legal_list]
					where rec.[LIST_DATE] >= nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]) and rec.[LIST_DATE]<=nvl(cl_info.[CLOSE_DATE],P_DATE_PRINT)
							and rec.[LIST_DATE]<to_date('01.09.2016','DD.MM.YYYY')
					order by rec.[LIST_DATE] desc
				loop
					temp_data:=Substr(temp_data||'Проверен '||to_char(rec.[LIST_DATE],'DD.MM.YYYY')||' по '||rec.[FILE_NAME]||' нет совпадений;'||CHR(13),1,temp_data%size);
				end loop;
				
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
				order by rez.[CHECK_DATE] desc
				loop
					temp_data:=Substr(temp_data||'Проверен '||to_char(rez.[CHECK_DATE],'DD.MM.YYYY')||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||' результат: '||rez.[CHECK_VAL].[NAME]||';'||CHR(13),1,temp_data%size);
				end loop;
				
				P_DATA:=temp_data;

			elsif p_info = 'ТЕРРОРИЗМ_РЕЗУЛЬТАТ1' then temp_data:=null; -- KAS 07/07/21 Разделил вывод истории результатов проверок на 2 параметра
				
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.01.2019',ShortFmt)
					order by rez.[CHECK_DATE]
				loop
					temp_data:=SubStr('Проверен '||to_char(rez.[CHECK_DATE],ShortFmt)||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||'. '||rez.[CHECK_VAL].[NAME]||';'||CHR(13)||temp_data,1,temp_data%size);
				end loop;
				
				P_DATA:=trim(temp_data,chr(13));			
								
			elsif p_info = 'ТЕРРОРИЗМ_РЕЗУЛЬТАТ2' then temp_data:=null; -- KAS 07/07/21 Разделил вывод истории результатов проверок на 2 параметра
				
				for rec in [legal_list]
					where rec.[LIST_DATE] < nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK])
					order by rec.[LIST_DATE] --desc
				loop
					temp_data:=SubStr('Проверен '||to_char(nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]),ShortFmt)||' по '||rec.[FILE_NAME]||'. Нет совпадений со справочником террористов РФ;'||CHR(13)||temp_data,1,temp_data%size);
					exit;
				end loop;
				
				for rec in [legal_list]
					where rec.[LIST_DATE] >= nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]) and rec.[LIST_DATE]<=nvl(cl_info.[CLOSE_DATE],P_DATE_PRINT) and rec.[LIST_DATE]<to_date('01.09.2016',ShortFmt)
					order by rec.[LIST_DATE]
				loop
					temp_data:=SubStr('Проверен '||to_char(rec.[LIST_DATE],ShortFmt)||' по '||rec.[FILE_NAME]||'. Нет совпадений со справочником террористов РФ;'||CHR(13)||temp_data,1,temp_data%size);
				end loop;
				
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='TERROR_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016',ShortFmt) and rez.[CHECK_DATE]<to_date('01.01.2019',ShortFmt)
					order by rez.[CHECK_DATE]
				loop
					temp_data:=SubStr('Проверен '||to_char(rez.[CHECK_DATE],ShortFmt)||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||'. '||rez.[CHECK_VAL].[NAME]||';'||CHR(13)||temp_data,1,temp_data%size);
				end loop;
				
				P_DATA:=trim(temp_data,chr(13));	
			----------------------------------------------------
			--(
			elsif p_info = 'ДАТА_ООН2' then temp_data:=null; --asankulov 19/09/24 Разделил вывод истории результатов проверок на 2 параметра
				
				for rec in [legal_list]
					where rec.[LIST_DATE] < nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK])
					order by rec.[LIST_DATE] desc
				loop
					temp_data:=Substr(temp_data||'Проверен '||to_char(nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]),'DD.MM.YYYY')||' по '||rec.[FILE_NAME]||' нет совпадений по справочнику ООН;'||CHR(13),1,temp_data%size);
				exit;
				end loop;
				
				for rec in [legal_list]
					where rec.[LIST_DATE] >= nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]) and rec.[LIST_DATE]<=nvl(cl_info.[CLOSE_DATE],P_DATE_PRINT)
							and rec.[LIST_DATE]<to_date('01.09.2016','DD.MM.YYYY')
					order by rec.[LIST_DATE] desc
				loop
					temp_data:=Substr(temp_data||'Проверен '||to_char(rec.[LIST_DATE],'DD.MM.YYYY')||' по '||rec.[FILE_NAME]||' нет совпадений;'||CHR(13),1,temp_data%size);
				end loop;
				
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='LIST_OON' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
				order by rez.[CHECK_DATE] desc
				loop
					temp_data:=Substr(temp_data||'Проверен '||to_char(rez.[CHECK_DATE],'DD.MM.YYYY')||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||' результат: '||rez.[CHECK_VAL].[NAME]||';'||CHR(13),1,temp_data%size);
				end loop;
				
				P_DATA:=temp_data;
				
				elsif p_info = 'ДАТА_ЗАМ_СР2' then temp_data:=null; --asankulov 19/09/24 Разделил вывод истории результатов проверок на 2 параметра
				
				for rec in [legal_list]
					where rec.[LIST_DATE] < nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK])
					order by rec.[LIST_DATE] desc
				loop
					temp_data:=Substr(temp_data||'Проверен '||to_char(nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]),'DD.MM.YYYY')||' по '||rec.[FILE_NAME]||' нет совпадений по справочнику Перечнем о замораживании (блокировании);'||CHR(13),1,temp_data%size);
				exit;
				end loop;
				
				for rec in [legal_list]
					where rec.[LIST_DATE] >= nvl(cl_info.[FIRST_ACC_DATE],this.[DATE_ANK]) and rec.[LIST_DATE]<=nvl(cl_info.[CLOSE_DATE],P_DATE_PRINT)
							and rec.[LIST_DATE]<to_date('01.09.2016','DD.MM.YYYY')
					order by rec.[LIST_DATE] desc
				loop
					temp_data:=Substr(temp_data||'Проверен '||to_char(rec.[LIST_DATE],'DD.MM.YYYY')||' по '||rec.[FILE_NAME]||' нет совпадений;'||CHR(13),1,temp_data%size);
				end loop;
				
				for rez in ::[CL_CHECK_RESULT] where rez.[CHECK_OBJ]=this and rez.[CHECK_TYPE].[CODE]='FREEZE_LIST' and rez.[CHECK_DATE]>=to_date('01.09.2016','DD.MM.YYYY')
				order by rez.[CHECK_DATE] desc
				loop
					temp_data:=Substr(temp_data||'Проверен '||to_char(rez.[CHECK_DATE],'DD.MM.YYYY')||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||' результат: '||rez.[CHECK_VAL].[NAME]||';'||CHR(13),1,temp_data%size);
				end loop;
				
				P_DATA:=temp_data;
				--)
				----------------------------------------------------
            	-- KAS 20/05/2021 для анкет по 499-П    	
		 	elsif p_info = 'НАЛ_РЕЗ' then
	 			--10. Государство налогового резидентства
	 				if nvl(this.[NU_REZIDENT], false) then  P_DATA := 'РФ'; end if;
					temp_str := GetAddPropVal(this, 'НАЛ_РЕЗ_ИНЫЕ', P_DATE_PRINT);
		 			if temp_str is not null then
		 				if P_DATA is not null then
		 					P_DATA := P_DATA||NL$||temp_str;
		 				else
		 					P_DATA := temp_str;
		 				end if;	
		 			end if;
		 		-- KAS 15/10/2021 по задаче Благовой Екатерины	
		 	elsif p_info = 'ДОВЕР_СОБСТВ' then		
		 			P_DATA :='НЕТ';
		 			temp_str := GetAddPropVal(this, 'STATUS_DOVER_SOBST', P_DATE_PRINT);
		 			if temp_str is not null then
		 				P_DATA := temp_str;
		 			end if;	 			 				
 	 		elsif p_info = 'CL_ANK_ORG_AKTIV' then
 				-- 12. Ваша нефинансовая организация является: 	 		
		 			temp_str := GetAddPropVal(this, 'CL_ANK_ORG_AKTIV', P_DATE_PRINT);
		 			P_DATA :=temp_str;
--================================================================================================================================		 			
			elsif p_info = 'CheckBox1' then   
			   P_DATA := 'ДА';
		
			elsif p_info = 'CheckBox5' then   -- совпадает с адресом местонахождения
			   if GetAddress(client_corp.[ADDRESSES],'ALL', 'CORP')=GetAddress(client_corp.[ADDRESSES],'ALL', 'FACT') then   
			     P_DATA := 'ДА';
			   end if;  
			elsif p_info = 'CheckBox8' then   
			   if GetContacts(client_corp.[CONTACTS], 'WEB') is  null then
			     P_DATA := 'ДА';
		       end if;   
			elsif p_info = 'CheckBox9' then   
			  if GetContacts(client_corp.[CONTACTS], 'WEB') is not  null then
			   P_DATA := 'ДА';
		      end if;
--/* Расширение анкеты IDA2506
			elsif p_info = 'ПОЛН_НАИМ_КЛИЕНТА' then   --НАИМ_КЛИЕНТА
			 	P_DATA := client_corp.[LONG_NAME];
			elsif p_info = 'ИН_НАИМ_КЛИЕНТА' then
				P_DATA := client_corp.[I_NAME];
			elsif p_info = 'DOMAIN_WEB' then
				for (select cont(
						cont.[PRIVATE].[VALUE]: 	c_priv,
						cont.[TYPE].[VALUE]:		c_val,
						cont.[NUMB]:				c_numb)
					in client_corp.[CONTACTS]
					where cont.[ACTIV] = true and
						cont.[NUMB] is not null and
						(cont.[TYPE].[CODE] = 'DOMAIN' or cont.[TYPE].[CODE] = 'WEB')
				)
				loop
					P_DATA := P_DATA || cont.c_numb || ', ';
				end loop;
				P_DATA := rtrim(P_DATA, ', ');
			elsif p_info = 'ПРЕДСТАВИТЕЛЬ1' then
				for (select dolg(
						dolg.[RANGE].[VALUE]: 	d_range,
						dolg.[FASE].[NAME]	:	d_name,
					    dolg.[FASE]			:	cl_ref,
					    dolg.[NOTES] 		:	d_notes
					 )
				in client_corp.[ALL_BOSS]	
                where dolg.[FASE] is not null and dolg.[CHIEF]
           	  	)
            	loop
            		P_DATA := dolg.d_name;
            		exit;
				end loop;
			elsif p_info = 'ПРЕДСТАВИТЕЛЬ1_ДОК' then
				for (select dolg(
						dolg.[RANGE].[VALUE]: 	d_range,
						dolg.[FASE].[NAME]	:	d_name,
					    dolg.[FASE]			:	cl_ref,
					    dolg.[NOTES] 		:	d_notes
					 )
				in client_corp.[ALL_BOSS]	
                where dolg.[FASE] is not null and dolg.[CHIEF]
           	  	)
            	loop
            		P_DATA := dolg.d_notes;
            		exit;
				end loop;
			elsif p_info = 'ПРЕДСТАВИТЕЛИ' then
				i := 0;
				for (select dolg(
						dolg.[RANGE].[VALUE]: 	d_range,
						dolg.[FASE].[NAME]	:	d_name,
					    dolg.[FASE]			:	cl_ref,
					    dolg.[NOTES] 		:	d_notes,
					    dolg.[WORK_END]     :   d_end
					 )
				in client_corp.[ALL_BOSS]	
                where dolg.[FASE] is not null and nvl(dolg.[WORK_END], P_DATE_PRINT) >= P_DATE_PRINT
           	  	)
            	loop
            		i:= i + 1;
            		P_DATA := P_DATA || i || ') ' || dolg.d_name || chr(13);
				end loop;
				P_DATA := rtrim(P_DATA, chr(13));
			elsif p_info = 'ПРЕДСТАВИТЕЛИ_ДОК' then
				i := 0;
				for (select dolg(
						dolg.[RANGE].[VALUE]: 	d_range,
						dolg.[FASE].[NAME]	:	d_name,
					    dolg.[FASE]			:	cl_ref,
					    dolg.[NOTES] 		:	d_notes,
					    dolg.[WORK_END]     :   d_end
					 )
				in client_corp.[ALL_BOSS]	
                where dolg.[FASE] is not null and nvl(dolg.[WORK_END], P_DATE_PRINT) >= P_DATE_PRINT
           	  	)
            	loop
            		i:= i + 1;
            		P_DATA := P_DATA || i || ') ' || dolg.d_notes;
            		if dolg.d_end is not null then
            			P_DATA := P_DATA || ' сроком до ' || to_char(dolg.d_end, 'dd.mm.yyyy') || chr(13);
            		else
            			P_DATA := P_DATA || chr(13);
            		end if;
				end loop;
				P_DATA := rtrim(P_DATA, chr(13));
			elsif p_info = 'CheckBox181' then --CL_EXT_ANK_ORG_N18
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N18'
 				)
 				loop
 					if x.c_value like '%Расчетно-кассовое обслуживание%' then
 						P_DATA := P_DATA || '1'; end if;
 					if x.c_value like '%Зарплатные проекты%' then
 						P_DATA := P_DATA || '2'; end if;
 					if x.c_value like '%Кредитование%' then
 						P_DATA := P_DATA || '3'; end if;
 					if x.c_value like '%Овердрафт%' then
 						P_DATA := P_DATA || '4'; end if;
 					if x.c_value like '%Банковские гарантии%' then
 						P_DATA := P_DATA || '5'; end if;
 					if x.c_value like '%Депозиты%' then
 						P_DATA := P_DATA || '6'; end if;
 					if x.c_value like '%Внешнеэкономическая деятельность%' then
 						P_DATA := P_DATA || '7'; end if;
 					if x.c_value like '%Прием/выдача наличных денежных средств%' then
 						P_DATA := P_DATA || '8'; end if;
 					if x.c_value like '%Операции с ценными бумагами, с векселями%' then
 						P_DATA := P_DATA || '9'; end if;
				end loop;
			elsif p_info = 'ДРУГОЕ18' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N18'
 				)
				loop
					if x.c_value not like '%Расчетно-кассовое обслуживание%' 
					and x.c_value not like '%Зарплатные проекты%'
					and x.c_value not like '%Кредитование%'
					and x.c_value not like '%Овердрафт%'
					and x.c_value not like '%Банковские гарантии%'
					and x.c_value not like '%Депозиты%'
					and x.c_value not like '%Внешнеэкономическая деятельность%'
					and x.c_value not like '%Прием/выдача наличных денежных средств%'
					and x.c_value not like '%Операции с ценными бумагами, с векселями%' 
					then
 						P_DATA := x.c_value;
					end if;
 				end loop;
 			elsif p_info = 'CheckBox1921' then --CL_EXT_ANK_ORG_N19_2
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_2'
 				)
 				loop
 					if x.c_value like '%купли-продажи%' then
 						P_DATA := P_DATA || '1'; end if;
 					if x.c_value like '%аренды%' then
 						P_DATA := P_DATA || '2'; end if;
 					if x.c_value like '%подряда%' then
 						P_DATA := P_DATA || '3'; end if;
 					if x.c_value like '%оказания услуг%' then
 						P_DATA := P_DATA || '4'; end if;
 					if x.c_value like '%поставки%' then
 						P_DATA := P_DATA || '5'; end if;
 					if x.c_value like '%займа%' then
 						P_DATA := P_DATA || '6'; end if;
				end loop;
			elsif p_info = 'ДРУГОЕ19_2' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_2'
 				)
				loop
					if x.c_value not like '%купли-продажи%' 
					and x.c_value not like '%аренды%'
					and x.c_value not like '%подряда%'
					and x.c_value not like '%оказания услуг%'
					and x.c_value not like '%поставки%'
					and x.c_value not like '%займа%'
					then
 						P_DATA := x.c_value;
					end if;
 				end loop;
 			elsif p_info = 'ПЛАН_ПЛАТЕЛЬЩИКИ' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_3_1'
 				)
				loop
 					P_DATA := x.c_value;
 				end loop;
 			elsif p_info = 'ПЛАН_ПОЛУЧАТЕЛИ' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_3_2'
 				)
				loop
 					P_DATA := x.c_value;
 				end loop;
 			elsif p_info = 'CheckBox201' then --CL_EXT_ANK_ORG_N20
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N20'
 				)
 				loop
 					if x.c_value like '%Организация создана менее 3-х месяцев назад%' then
 						P_DATA := '1';
 					elsif x.c_value like '%Стабильное (устойчиво прибыльное)%' then
 						P_DATA := '2';
 					elsif x.c_value like '%Условно стабильное (стадия развития, реорганизации, смены видов деятельности, смены собственников)%' then
 						P_DATA := '3';
 					elsif x.c_value like '%Не стабильное (убыточность деятельности, наличие задолженности по налогам, судебных предписаний)%' then
 						P_DATA := '4';
 					end if;
				end loop;
			elsif p_info = 'CheckBox2001' then --CL_EXT_ANK_ORG_N20ADD
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N20ADD'
 				)
 				loop
 					if x.c_value like '%Копии годовой бухгалтерской отчетности (бухгалтерский баланс, отчет о финансовом результате)%' then
 						P_DATA := '1';
 					elsif x.c_value like '%Копии годовой (либо квартальной) налоговой декларации с отметками налогового органа об их принятии или без такой отметки с приложением либо копии квитанции об отправке заказного письма с описью вложения (при направлении по почте), либо копии подтверждения отправки на бумажных носителях (при передаче в электронном виде)%' then
 						P_DATA := '2';
 					elsif x.c_value like '%Копия аудиторского заключения на годовой отчет за прошедший год, в котором подтверждаются достоверность финансовой (бухгалтерской) отчетности и соответствие порядка ведения бухгалтерского учета законодательству Российской Федерации%' then
 						P_DATA := '3';
 					elsif x.c_value like '%Справка об исполнении налогоплательщиком (плательщиком сборов, налоговым агентом) обязанности по уплате налогов, сборов, пеней, штрафов, выданная налоговым органом%' then
 						P_DATA := '4';
 					elsif x.c_value like '%Сведения об отсутствии в отношении клиента производства по делу о несостоятельности (банкротстве), вступивших в силу решений судебных органов о признании его несостоятельным (банкротом), проведения процедур ликвидации по состоянию на дату представления документов в кредитную организацию%' then
 						P_DATA := '5';
 					elsif x.c_value like '%Сведения об отсутствии фактов неисполнения клиентом своих денежных обязательств по причине отсутствия денежных средств на банковских счетах%' then
 						P_DATA := '6';
 					elsif x.c_value like '%Данные о рейтинге клиента, размещенные в сети "Интернет" на сайтах российских кредитных рейтинговых агентств и международных рейтинговых агентств%' then
 						P_DATA := '7';
 					elsif x.c_value like '%Финансовая (налоговая) отчетность юридических лиц, зарегистрированных в соответствии с законодательством иностранного государства%' then
 						P_DATA := '8';
 					end if;
				end loop;
			elsif p_info = 'CheckBox2111' then --CL_EXT_ANK_ORG_N21
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N21'
 				)
 				loop
 					if x.c_value like '%Вновь созданная организация для нового бизнеса%' then
 						P_DATA := P_DATA || '1'; end if;
 					if x.c_value like '%Вновь созданная организация для существующего бизнеса%' then
 						P_DATA := P_DATA || '2'; end if;
 					if x.c_value like '%Организация, созданная в процессе реорганизации%' then
 						P_DATA := P_DATA || '3'; end if;
 					if x.c_value like '%Наличие информации в общедоступных источниках (СМИ, интернет, пресса, телевидение)%' then
 						P_DATA := P_DATA || '4'; end if;
 					if x.c_value like '%Участие в государственных проектах%' then
 						P_DATA := P_DATA || '5'; end if;
 					if x.c_value like '%Участие в тендерах, государственных заказах%' then
 						P_DATA := P_DATA || '6'; end if;
 					if x.c_value like '%Наличие общедоступного источника информации, содержащий финансовый отчет организации%' then
 						P_DATA := P_DATA || '7'; end if;
				end loop;
			elsif p_info = 'CheckBox2181' then --CL_EXT_ANK_ORG_N21_8
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N21_8'
 				)
 				loop
 					if x.c_value like '%Отзывы других клиентов Банка, имеющих с клиентом деловые отношения%' then
 						P_DATA := '1';
 					elsif x.c_value like '%Отзывы от других кредитных организаций, в которых клиент ранее находился на обслуживании%' then
 						P_DATA := '2';
 					elsif x.c_value like '%Отзывы от контрагента, имеющего c Вашей организацией деловые отношения%' then
 						P_DATA := '3';
 					elsif x.c_value like '%Отсутствует возможность получения отзывов от ранее обслуживавших кредитных организаций%' then
 						P_DATA := '4';
 					end if;
				end loop;
			elsif p_info = 'CheckBox221' then --CL_EXT_ANK_ORG_N22
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N22'
 				)
 				loop
 					if x.c_value like '%Финансирование учредителей/участников%' then
 						P_DATA := P_DATA || '1'; end if;
 					if x.c_value like '%Доходы от основного вида деятельности%' then
 						P_DATA := P_DATA || '2'; end if;
 					if x.c_value like '%Доходы от дополнительных видов деятельности%' then
 						P_DATA := P_DATA || '3'; end if;
 					if x.c_value like '%Заемные/привлеченные денежные средства%' then
 						P_DATA := P_DATA || '4'; end if;
 					if x.c_value like '%Государственное финансирование%' then
 						P_DATA := P_DATA || '5'; end if;
				end loop;
			elsif p_info = 'ДРУГОЕ22' then
				for	( select x(x.[ADD_PROP].[STR] : c_value)
 					in ::[CL_ORG]
 					where x = this
 						and x.[ADD_PROP].[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N22'
 				)
				loop
					if x.c_value not like '%Финансирование учредителей/участников%' 
					and x.c_value not like '%Доходы от основного вида деятельности%'
					and x.c_value not like '%Доходы от дополнительных видов деятельности%'
					and x.c_value not like '%Заемные/привлеченные денежные средства%'
					and x.c_value not like '%Государственное финансирование%'
					then
 						P_DATA := x.c_value;
					end if;
 				end loop;
			elsif p_info = 'НЕДЕЛЯ_КОЛ1' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 1, null, ';'));
				end loop;
			elsif p_info = 'НЕДЕЛЯ_СУМ1' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 2, null, ';'));
				end loop;
			elsif p_info = 'МЕСЯЦ_КОЛ1' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 3, null, ';'));
				end loop;
			elsif p_info = 'МЕСЯЦ_СУМ1' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 4, null, ';'));
				end loop;
			elsif p_info = 'КВАРТАЛ_КОЛ1' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 5, null, ';'));
				end loop;
			elsif p_info = 'КВАРТАЛ_СУМ1' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 6, null, ';'));
				end loop;
			elsif p_info = 'ГОД_КОЛ1' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 7, null, ';'));
				end loop;
			elsif p_info = 'ГОД_СУМ1' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 8, null, ';'));
				end loop;
			elsif p_info = 'НЕДЕЛЯ_КОЛ2' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 9, null, ';'));
				end loop;
			elsif p_info = 'НЕДЕЛЯ_СУМ2' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 10, null, ';'));
				end loop;
			elsif p_info = 'МЕСЯЦ_КОЛ2' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 11, null, ';'));
				end loop;
			elsif p_info = 'МЕСЯЦ_СУМ2' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 12, null, ';'));
				end loop;
			elsif p_info = 'КВАРТАЛ_КОЛ2' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 13, null, ';'));
				end loop;
			elsif p_info = 'КВАРТАЛ_СУМ2' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 14, null, ';'));
				end loop;
			elsif p_info = 'ГОД_КОЛ2' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 15, null, ';'));
				end loop;
			elsif p_info = 'ГОД_СУМ2' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 16, null, ';'));
				end loop;	
			elsif p_info = 'НЕДЕЛЯ_КОЛ3' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 17, null, ';'));
				end loop;
			elsif p_info = 'НЕДЕЛЯ_СУМ3' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 18, null, ';'));
				end loop;
			elsif p_info = 'МЕСЯЦ_КОЛ3' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 19, null, ';'));
				end loop;
			elsif p_info = 'МЕСЯЦ_СУМ3' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 20, null, ';'));
				end loop;
			elsif p_info = 'КВАРТАЛ_КОЛ3' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 21, null, ';'));
				end loop;
			elsif p_info = 'КВАРТАЛ_СУМ3' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 22, null, ';'));
				end loop;
			elsif p_info = 'ГОД_КОЛ3' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 23, null, ';'));
				end loop;
			elsif p_info = 'ГОД_СУМ3' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 24, null, ';'));
				end loop;
			elsif p_info = 'ВИД_ВАЛЮТЫ_ОПЕР' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					P_DATA := trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 25, null, ';'));
				end loop;
			elsif p_info = 'ЭКСПОРТ_ИМПОРТ' then
				for (select x(x.[STR] : c_value)
					in this.[ADD_PROP]
					where x.[GROUP_PROP].[CODE] = 'CL_EXT_ANK_ORG_N19_1'
				)
				loop
					if length(trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 26, null, ';'))) > 0 then
						P_DATA := ::[COM_STATUS_PRD]([CODE] = trim(::[CL_PRIV].[PSH_DATE_DEATH].GetNextWord(x.c_value, 26, null, ';'))).[NAME];
					end if;
				end loop;
			elsif p_info = 'ВОО' then
				if stdlib.userid.[CASTA].[CODE] in ('PSB_73', 'PSH_58', 'IBS') then
					P_DATA := 1;
				else
					P_DATA := 0;
				end if;
			elsif p_info = 'ПЕРЕЧЕНЬ_КОНТР_ДАТ' then
				P_DATA := to_char(cl_info.[FIRST_ACC_DATE], 'dd/mm/yyyy');
				for (select x(x.[CTRL_DATE] : ctrl_date)
					in ::[PSH_LEGAL_DATES]
					where x.[CTRL_DATE] > cl_info.[FIRST_ACC_DATE] and x.[CTRL_DATE] <= nvl(cl_info.[CLOSE_DATE], ::[SYSTEM].[OP_DATE])
					order by x.[CTRL_DATE] asc
				)
				loop
					P_DATA := P_DATA || ', ' || to_char(x.ctrl_date, 'dd/mm/yyyy');
				end loop;
--*/ Расширение анкеты IDA2506			   
			end if; --end P_info значимых полей			
----
			--Башкиров В.Г. 21.05.2019 Добавлен поиск произвольного доп.свойства
			--Башкиров В.Г. 22.05.2019 Для РЕПУТАЦИЯ_PLUS и ФИНПОЛОЖЕНИЕ_PLUS null,Да - Положительная(ое) Нет - Отрицательная(ое) (Письмо от Лопухова С.Н., Карзановой Е.В. от 22.05.2019)
			if p_info='НЕ_ПРЕД_КЛ_ИЛИ_БЕНЕФ' then
				--&debug('Ищем доп.свойство "ПРЕД_КЛ" P_DATE_PRINT='||to_char(P_DATE_PRINT,fmt),dp2)	
				if GetAddProps(P_DATE_PRINT, 'ПРЕД_КЛ') is null and
				   GetAddProps(P_DATE_PRINT, 'БЕНЕФ') is null then
				   P_DATA:= ' V '; --'Да' "Птица" для квадратика в анкете
				end if;
	 		elsif p_info = 'РЕПУТАЦИЯ_PLUS' then
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'РЕПУТАЦИЯ_PLUS');
                if    P_DATA is null or Upper(trim(P_DATA))='ДА'  then P_DATA := 'Положительная';
                elsif Upper(trim(P_DATA))='НЕТ' 				  then P_DATA := 'Отрицательная';
                end if;

	 		elsif p_info = 'ФИНПОЛОЖЕНИЕ_PLUS' then
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'ФИНПОЛОЖЕНИЕ_PLUS');
                if    P_DATA is null or Upper(trim(P_DATA))='ДА'  then P_DATA := 'Положительное';
                elsif Upper(trim(P_DATA))='НЕТ' 				  then P_DATA := 'Отрицательное';
                end if;
			end if;
			
			if trim(P_DATA) is null then
				--Башкиров В.Г. 28.05.2019 Для кодов типа CL_ANK_PDL_INFO_ (последний символ "_") если значение пустое - выдавать " " вместо "нет"
				if Substr(p_info,Length(p_info))='_' then
					--&debug('Обрезаем последний символ кода "_" (признак вывода " " вместо "Нет") '||p_info||'->'||Substr(p_info,1,Length(p_info)-1),dp2)
					p_info:=Substr(p_info,1,Length(p_info)-1); flSpace:=true;
				end if;
				--
				--&debug('Ищем доп.свойство "'||p_info||'" P_DATE_PRINT='||to_char(P_DATE_PRINT,fmt),dp2)
	
				temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
				for dop in this.[ADD_PROP]
				where Upper(dop.[GROUP_PROP].[CODE])=Upper(p_info) and
					nvl(dop.[DATE_BEG],P_DATE_PRINT)<=P_DATE_PRINT and P_DATE_PRINT<=nvl(dop.[DATE_END],P_DATE_PRINT)
				loop
					temp_str := trim(
						iif(dop.[GROUP_PROP].[TYPE_VALUE] is null ,dop.[PROP].[NAME],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='NUMBER',to_char(dop.[NUM],'999G999G999G999G990D0099'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='STRING',dop.[STR],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='DATE'  ,to_char(dop.[V_DATE],fmt),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='BOOL'  ,iif(dop.[BOOL],'Да','Нет'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='REF'   ,::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),'')
						           );
					--&debug('Нашли группу '||dop.[GROUP_PROP].[CODE]||'-'||dop.[GROUP_PROP].[NAME]||' С типом значения:'||dop.[GROUP_PROP].[TYPE_VALUE]||' -> '||temp_str,dp2)
					exit;
				end loop;
				if temp_str is null then
					var p_info2 varchar(100);
					if InStr(Upper(p_info),'_ЛОГИКА')>0 then p_info2:=SubStr(Upper(p_info),1,InStr(Upper(p_info),'_ЛОГИКА')-1);
						--&debug('Ищем доп.свойство "'||p_info2||'" P_DATE_PRINT='||to_char(P_DATE_PRINT,fmt),dp2)
			
						temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
						for dop in this.[ADD_PROP]
						where Upper(dop.[GROUP_PROP].[CODE])=Upper(p_info2) and
							nvl(dop.[DATE_BEG],P_DATE_PRINT)<=P_DATE_PRINT and P_DATE_PRINT<=nvl(dop.[DATE_END],P_DATE_PRINT)
						loop
							temp_str := trim(
								iif(dop.[GROUP_PROP].[TYPE_VALUE] is null ,dop.[PROP].[NAME],'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='NUMBER',to_char(dop.[NUM],'999G999G999G999G990D0099'),'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='STRING',dop.[STR],'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='DATE'  ,to_char(dop.[V_DATE],fmt),'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='BOOL'  ,iif(dop.[BOOL],'Да','Нет'),'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='REF'   ,::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),'')
								           );
							if temp_str='Да' then temp_str:=' V ';   --dop.[PROP].[NAME]; типа 'Да' "Птица" для квадратика в анкете
							else				  temp_str:='     '; --пять пробелов для пустышки а квадратике
							end if;
							--&debug('Для %_ЛОГИКА Нашли группу '||dop.[GROUP_PROP].[CODE]||'-'||dop.[GROUP_PROP].[NAME]||' С типом значения:'||dop.[GROUP_PROP].[TYPE_VALUE]||' -> "'||'"',dp2)
							exit;
						end loop;
						if temp_str is null then
							temp_str:='     '; --пять пробелов для пустышки а квадратике
						end if;
					end if;
				end if;

				if temp_str is not null then P_DATA:=temp_str;
				else
					if flSpace then P_DATA:=' ';  -- &debug('flSpace='||flSpace,dp)--Башкиров В.Г. 28.05.2019 Для кодов типа CL_ANK_PDL_INFO_ (последний символ "_") если значение пустое - выдавать " " вместо "нет"
					else	  	    P_DATA:=empty_filler; --Ильин Д.А. 11.12.2024 заменил 'Нет' на '-'
					end if;
				end if;
			end if;

			/*if trim(P_DATA) is null then
				P_DATA := 'нет';
			end if;*/
			
			--&debug('На '||to_char(P_DATE_PRINT,fmt)||' '||Rpad(p_info,22)||'->'||P_DATA,dp)

		end if; --end P_info
		--debug_pipe('->('||Length(P_DATA)||')'||P_DATA,dp);
	end if; --end p_message	
end;
                                                             	

end;

execute is
/*********************************************************************
Назначение: печать анкеты клиетна-организации
Отвественный: Купрееа Антон
Akupreev, последнее изменение 7 Сентябрь 2004 г.
*********************************************************************/
begin
	/*
						ВНИМАНИЕ!
	В КЛИЕНТ-СКРИПТЕ ЕСТЬ УДАЛЕНИЕ СТРОК ТАБЛИЦЫ В ШАБЛОНЕ ПО НОМЕРУ СТРОКИ!
	ЕСЛИ ВЫ ДОБАВЛЯЕТЕ В ШАБЛОН НОВУЮ СТРОКУ В ТАБЛИЦЕ, УБЕДИТЕСЬ ЧТО ЭТО НЕ ПОВЛИЯЕТ НА УДАЛЕНИЕ
	МОЖЕТ ПОЛУЧИТЬСЯ ТАК, ЧТО СТАНЕТ УДАЛЯТЬСЯ НЕ ТА СТРОКА, СООТВЕТСТВЕННО ОПЕРАЦИЯ БУДЕТ РАБОТАТЬ НЕКОРРЕКТНО
	
						pikalov
	*/
	::[DEFVALS].[SLIB].SaveRef(stdlib.userid,&METHOD$CLASS,&METHOD$SNAME, 'P_SHABLON', P_SHABLON, 'SHABLON_DOC');
	[DATE_ANK] 			:= P_DATE_ANK;
	[DATE_FORM_UPD_F] 	:= P_DATE_FORM_UPD;
	executor.set_context( 'CL_INFO_COLLECTION', null);
	executor.set_context( 'CL_INFO_DATE', null);
end;
end;
end;
