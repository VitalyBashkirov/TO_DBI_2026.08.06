						in ::[TRUST_FOR_PROD] all
						where this=x.[TRUST_CLIENT]
							and (x.[begin_date] is null or x.[begin_date]<= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat))
							and (x.[end_date] is null or coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat)<=x.[end_date])
					 union all
*/					
			 		 select x(x.[trust_client].[name]	: client_name,
			 		 		  x%id						: client_id,
			 		 		  'Доверенное лицо'			: vid_link)
						in ::[TRUST_FOR_PROD] all
						where this =x.[ini_client]	
							and (x.[begin_date] is null or x.[begin_date]<= coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat))
							and (x.[end_date] is null or coalesce(P_DATE_PRINT, P_DATE_ANK, op_dat)<=x.[end_date])
				)loop
					P_DATA := P_DATA || ', ' ||x.[client_name];
				end loop;

				P_DATA := ltrim(P_DATA,', ');

	 		elsif p_info = 'Причина_Выбора' then
