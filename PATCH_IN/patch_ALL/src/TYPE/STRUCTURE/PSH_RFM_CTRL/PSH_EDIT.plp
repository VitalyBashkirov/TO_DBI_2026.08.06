class PSH_RFM_CTRL;

@name('[ПСБ] Изменить')
@tag('COPIED')
method PSH_EDIT uses PSH_NEW is
PSH_EDIT (
	@name('Запись')           P_CTRL_REC      in [STRING_60],
	@name('Тип записи')       P_CTRL_TYPE     in [ONE_FROM_THREE],
	@name('Частота проверки') P_CTRL_PERIOD   in [CASE_BETWEEN_TWO],
	@name('Дата добавления')  P_CTRL_ADD_DATE in [DATE],
	@name('Добавил')          P_CTRL_USER     in [STRING_60],
	@name('Примечание')       P_CTRL_NOTE     in [MEMO]             default null
) is

validate is
begin
if p_message = 'DEFAULT' then
	P_CTRL_REC := this.[CTRL_REC];
	P_CTRL_TYPE.[0] := this.[CTRL_TYPE].[0];
	P_CTRL_PERIOD.[0] := this.[CTRL_PERIOD].[0];
	P_CTRL_ADD_DATE := this.[CTRL_ADD_DATE];
	P_CTRL_USER := this.[CTRL_USER];
	P_CTRL_NOTE := this.[CTRL_NOTE];
end if;
end;

execute is
same_rec INTEGER;
begin
	select x(count(x)) in ::[PSH_RFM_CTRL]
		where x.[CTRL_REC] = P_CTRL_REC
		into same_rec;
	if P_CTRL_REC is null then
		pragma error('Запись пуста!');
	end if;
	if same_rec = 0 then
		[CTRL_REC] := P_CTRL_REC;
		[CTRL_TYPE] := P_CTRL_TYPE;
		[CTRL_PERIOD] := P_CTRL_PERIOD;
		[CTRL_ADD_DATE] := ::[SYSTEM].[OP_DATE];
		[CTRL_USER] := ::[RUNTIME].[STDLIB].fio(stdlib.userid.[NAME], 'Ф И. О.');
		[CTRL_NOTE] := P_CTRL_NOTE;
	else
		pragma error('Указанная запись уже присутствует в перечне!');
	end if;
end;
	
end;
end;
