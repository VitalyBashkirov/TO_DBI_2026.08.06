class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Заявление на перечисление (внутренний)')
@tag('COPIED')
method PSH_ZAYAV_PER_VN is

@name('V_DEST') public V_DEST [STRING_32000];

PSH_ZAYAV_PER_VN (
	@name('Клиент')         P_KLI      in [CL_PRIV_REF],
	@name('Работник банка') P_RAB_BANK in [USER_REF]
) is

validate is
i 			number;
vColCount 	number; -- колво колонок в отчете
vFileName 	varchar2(250); -- имя Excel-шаблона
--users ref [USER];
-- Шаблон адреса
V_ADR_MASK		varchar2(100):='ALL';
City			ref [NAMES_CITY];
Addres			[STRING_250];
AddresPost		[STRING_250];
Okato			[STRING_20];
komiss number;

begin

  if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
		[EXCEL].Init_Xls;
		P_KLI:=this.[ACC_DT].[CLIENT_V];
		P_RAB_BANK := ::[RUNTIME].[STDLIB].UserId;
							
  elsif P_MESSAGE = 'VALIDATE' then -- переход между полями

		if p_info = 'OK' then
			
			vFileName := 'PSH_Заявление на перечисление(внутренний).xlsx';
  			  			  	
			if [EXCEL].F_Click then
				[EXCEL].F_Click := False;

				vColCount := 7; -- всего колонок в отчете
				i := 9; -- первая строка в Excel
				
				-- обнуляем переменные
			    --debug_pipe('Ищем шаблон '||::[REPS].[SLIB].GetPath('PATH_PRINT_EXCEL', vFileName),0);
				-- запуск Excel
				[EXCEL].open_file(::[REPS].[SLIB].GetPath('PATH_PRINT_EXCEL', vFileName),false);
			   -- debug_pipe('цикл по договорам',0);
				
				-- цикл по договорам
				
[DEPN_INTERFACE]::[PRX_DEPN_TO_CRED].Get_Adr_Client
						(P_KLI
						,V_ADR_MASK
						,City
						,Addres
						,AddresPost
						,Okato);				

				[EXCEL].Write(4, 2,  ::[RUNTIME].[TMC_REPORTS].formatDate(this.[DATE_DOC]));
				[EXCEL].Write(8, 1,  Addres);
				[EXCEL].Write(11, 1,  P_KLI.[DOC].[TYPE].[FULL_NAME]||','|| P_KLI.[DOC].[SER]||','||P_KLI.[DOC].[NUM]||', выдан '||to_char(P_KLI.[DOC].[DATE],'DD.MM.YYYY')||','||P_KLI.[DOC].[WHO]||', код подр. '||P_KLI.[DOC].[DEPART_CODE]);
				[EXCEL].Write(13, 2,  P_KLI.[NAME]);
				[EXCEL].Write(15, 7,  this.[ACC_DT].[MAIN_V_ID]);
				[EXCEL].Write(17, 3,  to_char(this.[SUM],'999G999G999D99'));
				[EXCEL].Write(18, 3,  ::[RUNTIME].[STDLIB].N2Str(this.[SUM],'!'||this.[VALUTA]));
				[EXCEL].Write(21, 4,  nvl(this.[KL_KT].[1].[1].[NAME],this.[KL_KT].[2].[2]));
				[EXCEL].Write(22, 4,  nvl(this.[KL_KT].[1].[1].[INN],this.[KL_KT].[2].[INN]));
				[EXCEL].Write(23, 4,  nvl(this.[KL_KT].[1].[2].[MAIN_V_ID],this.[KL_KT].[2].[1]));
				[EXCEL].Write(24, 4,  nvl(this.[KL_KT].[1].[2].[FILIAL].[BANK].[NAME],this.[KL_KT].[2].[3].[NAME]));
				[EXCEL].Write(25, 4,  nvl(this.[KL_KT].[1].[2].[FILIAL].[BANK].[KS],this.[KL_KT].[2].[3].[KS]));
				[EXCEL].Write(26, 4,  nvl(this.[KL_KT].[1].[2].[FILIAL].[BANK].[BIC],this.[KL_KT].[2].[3].[BIC]));
				[EXCEL].Write(28, 1,  this.[NAZN]);
				if substr(this.[ACC_KT].[MAIN_V_ID],1,1)='3'
				then komiss:=trunc((this.[SUM]*::[DOCUMENT].[LIB_CUR].Get_rate(this.[ACC_DT].[FINTOOL],this.[DATE_DOC])*0.002),2);
					if komiss<60 then komiss:=60;
					elsif komiss>1500 then komiss:=1500;
					end if;
					[EXCEL].Write(36, 4,  to_char(komiss,'999G999G999D99'));
					[EXCEL].Write(38, 1,  ::[RUNTIME].[STDLIB].N2Str(komiss,'RUB'));
					if nvl(substr(this.[KL_KT].[2].[1],1,3),0) in ('401')
						then 	[EXCEL].Write(36, 4,  '0.00');
								[EXCEL].Write(38, 1,  'Без комиссии');
					end if;
				else 	if  this.[ACC_DT].[CLIENT_V]=this.[ACC_KT].[CLIENT_V] or this.[ACC_DT].[CLIENT_V]=this.[ACC_KT].[CLIENT_R]
						then 	[EXCEL].Write(36, 4,  '0.00');
								[EXCEL].Write(38, 1,  'Без комиссии');
						else
								[EXCEL].Write(36, 4,  '30.00');
								[EXCEL].Write(38, 1,  'Тридцать рублей 00 копеек');
						end if;
				end if;
				
				[EXCEL].Write(46, 2,  to_char(this.[DATE_DOC],'DD.MM.YYYY'));
				[EXCEL].Write(47, 4,  ::[RUNTIME].[STDLIB].FIO(P_RAB_BANK.[NAME]));
								
				[EXCEL].Visible;
				[EXCEL].Release;
			end if;
			--debug_pipe('V_DEST='||V_DEST,0);			
			[EXCEL].Exec_Script(V_DEST);	
		end if;	
  end if;
end;
end;
end;
