				for prop in client_priv.[ADD_PROP] where prop.[GROUP_PROP].[CODE] = 'PSB_IN_INN' and prop.[DATE_BEG] <= P_DATE_PRINT and (prop.[DATE_END] is null or prop.[DATE_END] >=P_DATE_PRINT)
				loop
