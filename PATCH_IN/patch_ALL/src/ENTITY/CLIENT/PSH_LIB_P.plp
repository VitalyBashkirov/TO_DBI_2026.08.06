				P_DATA_1 := GetAddress(client_priv.[ADDRESSES],'ALL', 'REGISTRATION'); if P_DATA_1 is not null then P_DATA_1:='Регистрация: '||P_DATA_1||LF$; end if;
				P_DATA_2 := GetAddress(client_priv.[ADDRESSES],'ALL', 'TEMPORARY_REG');if P_DATA_2 is not null then P_DATA_2:='Временная регистрация: '||P_DATA_2||LF$; end if;
				P_DATA_3 := GetAddress(client_priv.[ADDRESSES],'ALL', 'REAL_LIVE');	   if P_DATA_3 is not null then P_DATA_3:='Место пребывания: '||P_DATA_3||LF$; end if;
				P_DATA_4 := GetAddress(client_priv.[ADDRESSES],'ALL', 'FACT');		   if P_DATA_4 is not null then P_DATA_4:='Место пребывания: '||P_DATA_4||LF$; end if;
