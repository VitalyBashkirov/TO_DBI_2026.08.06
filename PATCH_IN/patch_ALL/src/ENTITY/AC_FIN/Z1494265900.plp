class AC_FIN;

@import_plsql(true)
@name('[ПСХ] Среднедневные остатки 407-408 счетов куратора (с указанием периода)')
@tag('COPIED')
@speciality('filter')
static method Z1494265900 is
public v_d_start date;
public v_d_stop  date;
public v_period  number;

fmt string:='dd/mm/yyyy';
ft_usd ref [FT_MONEY];

-- используется в представлении для коклонки "Среднедневной остаток Валюта"
public function get_avg_saldo_v(acc ref [ac_fin]) return number is 
	ret number;
	d_cur date;
	cntr number;
	accu number;
begin
	v_d_start:=nvl(v_d_start,to_date(SYS_CONTEXT('IBS_USER','V_D_START'),'dd/mm/yyyy'));
	v_d_stop :=nvl(v_d_start,to_date(SYS_CONTEXT('IBS_USER','V_D_STOP'),'dd/mm/yyyy'));
	if v_d_start is null then
		pragma error('Пустая дата начала');
	end if;
	if v_d_stop is null then
		pragma error('Пустая дата конца');
	end if;
	if v_d_start > v_d_stop then
		pragma error('Дата начала не может быть больше даты конца');
	end if;

	d_cur := v_d_start;
	cntr := 0;
	accu := 0;
	while d_cur <= v_d_stop loop
		if cntr = 0 then
			--accu := (accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur+1),0))/2;
		--	accu := (accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur+1),0));
		accu := (accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur),0));
		else
		--	accu := accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur+1),0);
		accu := accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur),0);
		end if;	
		cntr := cntr + 1;		
		d_cur := d_cur + 1;	
	end loop;

	ret := accu / v_period;
	
	return ret;
end;

public function get_avg_saldo_d(acc ref [ac_fin]) return number is 
	ret number;
	d_cur date;
	cntr number;
	accu number;
	ft_acc ref [FT_MONEY];
begin
	v_d_start:=nvl(v_d_start,to_date(SYS_CONTEXT('IBS_USER','V_D_START'),'dd/mm/yyyy'));
	v_d_stop :=nvl(v_d_start,to_date(SYS_CONTEXT('IBS_USER','V_D_STOP'),'dd/mm/yyyy'));
	if v_d_start is null then
		pragma error('Пустая дата начала');
	end if;
	if v_d_stop is null then
		pragma error('Пустая дата конца');
	end if;
	if v_d_start > v_d_stop then
		pragma error('Дата начала не может быть больше даты конца');
	end if;

	ft_acc := acc.[FINTOOL];
	
	d_cur := v_d_start;
	cntr := 0;
	accu := 0;
	while d_cur <= v_d_stop loop
		accu := accu +
		::[DOCUMENT].[LIB_CUR].Cur2Cur(
			nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СВ',d_cur+1),0),
			ft_acc,
			ft_usd,
			d_cur	);
		cntr := cntr + 1;		
		d_cur := d_cur + 1;	
	end loop;

	ret := accu / v_period;
	
	return ret;
end;

pragma restrict_references(get_avg_saldo_v,wnds,wnps,trust);
pragma restrict_references(get_avg_saldo_r,wnds,wnps,trust);
pragma restrict_references(get_avg_saldo_d,wnds,wnps,trust);

-- используется в представлении для коклонки "Среднедневной остаток Рубли"
public function get_avg_saldo_r(acc ref [ac_fin]) return number is 
	ret number;
	d_cur date;
	cntr number;
	accu number;
begin
	v_d_start:=nvl(v_d_start,to_date(SYS_CONTEXT('IBS_USER','V_D_START'),'dd/mm/yyyy'));
	v_d_stop :=nvl(v_d_start,to_date(SYS_CONTEXT('IBS_USER','V_D_STOP'),'dd/mm/yyyy'));
	if v_d_start is null then
		pragma error('Пустая дата начала');
	end if;
	if v_d_stop is null then
		pragma error('Пустая дата конца');
	end if;
	if v_d_start > v_d_stop then
		pragma error('Дата начала не может быть больше даты конца');
	end if;

	d_cur := v_d_start;
	cntr := 0;
	accu := 0;
	while d_cur <= v_d_stop loop
		if cntr = 0 then
			--accu := (accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СН',d_cur+1),0))/2;
		--	accu := (accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СН',d_cur+1),0));
		accu := (accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СН',d_cur),0));
		else
		--	accu := accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СН',d_cur+1),0);
		accu := accu + nvl(F.A('В'||to_char(acc.[ARC_MOVE])||'СН',d_cur),0);
		end if;	
		cntr := cntr + 1;		
		d_cur := d_cur + 1;	
	end loop;

	ret := accu / v_period;
	
	return ret;
end;

begin
	ft_usd := ::[FT_MONEY]([CUR_SHORT]='USD');
exception when others then
	pragma error('Невозможно найти валюту USD');
end;

public function actual_accountant_name(acc	ref [AC_FIN], OnDate [DATE] default [SYSTEM].[OP_DATE]) return [STRING_100] is 
Cl ref [CLIENT];
begin
	if acc.[CLIENT_R] is not null then Cl:=acc.[CLIENT_R];
	else							   Cl:=acc.[CLIENT_V];
	end if;
	
	/*
	for lih in Cl.[LOAN_INS_HISTORY]
	where nvl(lih.[DATE_BEGIN],OnDate)<=OnDate and OnDate<=nvl(lih.[END_DATE],OnDate)
	loop
		debug_pipe('.actual_accountant_name -- OnDate='||to_char(OnDate,fmt)||
			' lih.[DATE_BEGIN]='||to_char(lih.[DATE_BEGIN],fmt)||
			' lih.[END_DATE]='||to_char(lih.[END_DATE],fmt)||
			' '||lih.[INSPECTOR].[NAME]
			,0);
		return lih.[INSPECTOR].[NAME];
	end loop;
	/*
	for (select lih(lih.[INSPECTOR].[NAME] : C_INSPECTOR_NAME) in Cl.[LOAN_INS_HISTORY]
	where nvl(lih.[DATE_BEGIN],OnDate)<=OnDate and OnDate<=nvl(lih.[END_DATE],OnDate))
	loop
		return lih.C_INSPECTOR_NAME;
	end loop;
	*/

	-->> VRI 18/02/2025 CFT-928 Среднемесячные остатки по счетам
	-- ФИО клиентского менеджера
	for (select u(analytic(max(u.[NAME]), 'keep (dense_rank last order by [1]) ', u.[OPER_DATE]) fio)
		in ::[CL_INFO_USER],
		  (::[CL_INFO_REQ] : inf) all
			where inf.[CL_WORK_USERS] = u%collection
				and u.[PERSON_TYPE] = ::[MARK_PERS_G]([CODE] = 'ACC_MANAGER')
				and inf.[CLIENT] = Cl
		)
	loop
		return u.fio;
	end loop; 	
	--<< VRI 18/02/2025 CFT-928

	return null;
end;
pragma restrict_references(actual_accountant_name,wnds,wnps,trust);

Z1494265900 (
	@name('Дата начала') P_D_START in [DATE],
	@name('Дата конца')  P_D_STOP  in [DATE],
	@name('Период')      P_PERIOD  in [DIG_16]
) is

validate is
begin
	if P_MESSAGE = 'DEFAULT' then
		p_d_start := nvl(v_d_start,::[SYSTEM].[OP_DATE]);
		p_d_stop  := nvl(v_d_stop ,::[SYSTEM].[OP_DATE]);
		
		if trunc(p_d_stop )>= trunc(p_d_start) then
			p_period  := trunc(p_d_stop ) - trunc(p_d_start) +1;
		end if;
		
	end if;
	
	if P_MESSAGE = 'VALIDATE' then
		if p_info = 'P_D_START' or p_info = 'P_D_STOP' then
			if trunc(p_d_stop )>= trunc(p_d_start) then
				p_period  := trunc(p_d_stop ) - trunc(p_d_start) +1;
			else
				p_period  := null;	
			end if;
		
		end if;
		
	end if;
	
end;

execute is
begin
	if p_d_start is null then
		pragma error('Пустая дата начала');
	end if;
	if p_d_start is null then
		pragma error('Пустая дата конца');
	end if;
	if p_d_start > p_d_stop then
		pragma error('Дата начала не может быть больше даты конца');
	end if;
	
	v_d_start := trunc(p_d_start);
	v_d_stop  := trunc(p_d_stop );
	v_period  := p_period;
--	v_period  := trunc(p_d_stop ) - trunc(p_d_start);

	executor.set_context('V_D_START', to_char(v_d_start,'dd/mm/yyyy'));
	executor.set_context('V_D_STOP',  to_char(v_d_stop,'dd/mm/yyyy'));
end;
end;
end;
