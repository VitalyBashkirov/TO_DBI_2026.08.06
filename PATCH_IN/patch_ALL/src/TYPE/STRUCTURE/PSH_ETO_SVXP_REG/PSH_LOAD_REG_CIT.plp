class PSH_ETO_SVXP_REG;

@name('[ПСБ] Загрузить реестр через интегратор')
static method PSH_LOAD_REG_CIT is

--#define alib ::[CIT_ABONENT].[LIB]
--#define ilib ::[CIT_BO].[ILIB]
--#define aq_lib ::[RUNTIME].[AQ_LIB]

/* Секция глобальных переменных *
@name('пример переменной 1') public V_EXAMPLE1 [STRING_100];
@name('пример переменной 2') public V_EXAMPLE2 [NUMBER];
/* Конец секции глобальных переменных */
	
/* Описания */

/* Блок инициализации */

/* Описания */
PSH_LOAD_REG_CIT (
	@name('Текст запроса') P_REQUEST_TEXT in [CLOB],
	@name('File name')     P_FILE_NAME    in [STRING_512] default null
) is

validate is
/* Секция "Проверка" */
begin
	if P_MESSAGE = 'DEFAULT' then
		null;
	end if;
end;

execute is
/* Секция "Тело" */
	vAb				const [CIT_ABONENT] := ::[CIT_ABONENT]([CODE] = 'BPC');
	vBo				const [CIT_BO] := ::[CIT_BO](/* * /[ABONENT] = vAb and/* */ [CODE] = 'BPC_SVXP');
	vSelf			const boolean := true;
	vQname			const ::[CIT_ABONENT].[AQ_IN]%type := case when vSelf then vAb.[AQ_IN] else vAb.[AQ_OUT] end;
	vQtype			const varchar2(30) := &alib.fix_queue_type(vAb.[QTYPE]);
	vMsg			&aq_lib.t_msg;
	vOptionCode		const varchar2(32) := 'CITBO#'||vBo.[CODE];
	vPriority		const integer := null;
	vCorrelation	const varchar2(128) := null;
	vRecepients		const varchar2(1000) := case when vQtype in (&aq_lib.cn_payload_jms_text, &aq_lib.cn_payload_jms_bytes) then
												null
											else
												case when vAb.[TARGET_AB_CODE] is not null then vAb.[CODE] else &ilib.our_sys.[CODE] end || '_AG;;;'
											end;
	vMsgId			varchar2(256);
	
	vCitRequest clob := empty_clob();
begin
--	::[CIT_BO].[SLIB].send([CIT_BO](CODE = 'ETO_SVXP')
--						, vRequest
--						, p_self == true);

	vCitRequest :=
'
<CIT_REQUEST>
	<SYSTEM>
		<BP_ID Value="' || vBo.[CODE] || '"/>
		<CIT_Version Value="1.0"/>
		<ERR Value=""/>
		<FORMAT Value="XML"/>
		<MAIN_ID Value=""/>
		<MSG_ID Value="' || case when P_FILE_NAME is null then 'MANUAL-' || to_char(sysdate, 'yyyymmddhh24miss') else substr('FILE-' || P_FILE_NAME, 1, [CIT_IN_REQUEST].[AB_ID]%size) end || '"/>
		<SYNC Value=""/>
		<SYS_ID Value="'||case when P_FILE_NAME is null then 'IBSO_NAVIGATOR' else 'BPC' end ||'"/>
		<TAR_ID Value="IBSO_DISTR"/>
		<Version Value="002"/>
	</SYSTEM>
	<DATA>
		<![CDATA[
' || P_REQUEST_TEXT || '
		]]>
	</DATA>
</CIT_REQUEST>
';

	vMsg.body_text_large := vCitRequest;

	::[RUNTIME].[AQ_LIB].init_put
		( message_type == vOptionCode
		, o_emmediate_put == not nvl(vBo.[TRANS_HANDLE],0) = 1 or vBo.[SYNC] = 2
		, o_transform == null
		, p_priority == coalesce(vPriority, vBo.[PRIORITY], 9)
		, p_delay_time == 0 -- время в секундах до доступности для извлечения
		, p_expire_time	==	case when vBo.[SYNC] = 2 then coalesce(vBo.[TIME_OUT], 120) else nvl(vBo.[EXP_TIME], 9999999) end -- время жизни сообщения в очереди в секундах
		, p_correlation	==	vCorrelation
		, p_recepient_list == vRecepients
		);
	vMsgId := rawtohex(&aq_lib.put(vQname, vOptionCode, vMsg, vQtype));

end;
end;
end;
