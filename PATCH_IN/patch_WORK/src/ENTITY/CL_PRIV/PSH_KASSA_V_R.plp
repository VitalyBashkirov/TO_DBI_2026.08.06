function Calc_Turn(p_date date, p_val varchar2(3)) return varchar(32) -- подсчет суммы оборотов по валюте
is
ret varchar(32);
ret_sum [SUMMA];
begin
	ret_sum := 0;
	for arch_op in [KASSA_V] where trunc(arch_op.[DATE]) = trunc(p_date) and (arch_op%state = 'PAY_ALL' or arch_op%state = 'CONFIRM') loop
		--if arch_op.[KOD_OPER].[KOD_OPER] != 'CON_OP' then -- По конверии в оборот попадает только сумма выданной валюты
		if arch_op.[KOD_OPER].[KOD_OPER] in ('SEL_OP','BUY_OP') or ( arch_op.[KOD_OPER].[KOD_OPER] = 'CON_OP' and p_val = '978' ) then 	
			if arch_op.[REQ_INPUT].[CURRENCY].[CODE_ISO] = p_val then
				ret_sum := ret_sum + arch_op.[REQ_INPUT].[AMOUNT];
			end if;
			
			if arch_op.[REQ_OUTPUT].[CURRENCY].[CODE_ISO] = p_val then
				ret_sum := ret_sum + arch_op.[REQ_OUTPUT].[AMOUNT];
			end if;
		end if;		
	end loop;

	return to_char(ret_sum, '999G999G999G999D99');
end;

function Calc_Netto(p_date date, p_val varchar2(3)) return varchar(32)-- подсчет суммы Нетто по валюте
is
ret varchar(32);
ret_sum [SUMMA];
begin
	ret_sum := 0;
	for arch_op in [KASSA_V] where trunc(arch_op.[DATE]) = trunc(p_date) and (arch_op%state = 'PAY_ALL' or arch_op%state = 'CONFIRM') and arch_op.[KOD_OPER].[KOD_OPER] in ('SEL_OP','BUY_OP','CON_OP') loop
		if arch_op.[REQ_INPUT].[CURRENCY].[CODE_ISO] = p_val then
			ret_sum := ret_sum + arch_op.[REQ_INPUT].[AMOUNT];
		end if;	
		if arch_op.[REQ_OUTPUT].[CURRENCY].[CODE_ISO] = p_val then
			ret_sum := ret_sum - arch_op.[REQ_OUTPUT].[AMOUNT];
		end if;	
	end loop;

	return to_char(ret_sum, '999G999G999G999D99');
end;

function compare_log_bl(
	p_cl ref [CLIENT]
	, bl ref [BLACKLIST]
	, tbl_cnt number default 1
	, cnt number default 1
	, P_LOG2PIPE boolean default true
	, P_LOG2FILE boolean default false
) return string(2000)
is
	cl_pr ref [CL_PRIV];
	cl_or ref [CL_ORG];
	bl_struct [BLACKLIST];
	str string(32000);
	v_withDop boolean;
	
	function clear_cert_numb(p_str varchar2(100)) return varchar2(100) is
	begin
		return upper(regexp_replace(p_str, '[[:space:]]|[[:punct:]]'));
	end;
begin
	if bl is not null then
		bl_struct := bl;	
		str := 'Клиент "' || p_cl.[NAME] || '" (id = ' || p_cl%id || ')';
		
		-- Признак проверки доп реквизитов клиента
		v_withDop := nvl( ::[FP_TUNE].[LIB].get_bool_value
							( '207P_CHECK_ADD_PROPS'
							, ::[FP_TUNE].[LIB].set_canons
								( '<CL_LEGAL_STATUS>'
								, case p_cl%class
									when 'CL_PRIV' then 'F'
									when 'CL_ORG'  then 'U'
								  end
								, '<TERROR_IPDL>'
								, 'BLACKLIST'
								)
							, '0'
							)
						, false
						);
		
		-- Тип клиента
		if p_cl%class = 'CL_PRIV' then
			cl_pr%id := p_cl%id;
		else
			cl_or%id := p_cl%id;
		end if;
		
		-- Вывод в строку информацию по клиенту
		
		if cl_pr.[DATE_PERS] is not null then
			str := str || '. Дата рождения: '|| to_char(cl_pr.[DATE_PERS], 'DD/MM/YYYY');
		end if;
		if v_withDop then
			if cl_pr.[DOC].[SER] is not null then
				str := str || '. Серия документа ' || upper(cl_pr.[DOC].[SER]);
			end if;
			if cl_pr.[DOC].[NUM] is not null then
				str := str || '. Номер документа: ' || upper(cl_pr.[DOC].[NUM]);
			end if;
			if cl_or.[INN] is not null then
				str := str || '. ИНН: ' || cl_or.[INN];
			end if;
			if cl_or.[KOD_OKPO] is not null then
				str := str || '. Код ОКПО: ' || upper(cl_or.[KOD_OKPO]);
			end if;
			if cl_or.[REGISTER].[GOS_REG_NUM_REC] is not null then
				str := str || '. ОГРН: ' || upper(cl_or.[REGISTER].[GOS_REG_NUM_REC]);
			elsif cl_or.[REGISTER].[NUM_REESTR] is not null then	
				str := str || '. Рег. номер: ' || upper(cl_or.[REGISTER].[NUM_REESTR]);
			end if;
			if nvl(cl_or.[REGISTER].[DATE_REG], cl_or.[REGISTER].[DATE_REESTR]) is not null then
				str := str || '. Дата регистрации: '
					|| to_char(nvl(cl_or.[REGISTER].[DATE_REG], cl_or.[REGISTER].[DATE_REESTR]), 'DD/MM/YYYY');
			end if;	
		end if;
		
		if tbl_cnt > 1 then
			str := str || ' - встречается в списке прочих подозрительных лиц несколько раз:';
		elsif tbl_cnt = 1 then
			str := str || ' - присутствует в списке прочих подозрительных лиц:';
		end if;

		str := str || NL$ || lpad(' ',3) || bool_char(tbl_cnt > 1,'Совпадение № ' || cnt || '. ','')
			|| 'Запись справочника: №' || bl_struct.[NUM]||' '|| bl_struct.[NAME]
			|| ' (id = ' || bl_struct%id || ')';
		
		-- Проверка совпадений по реквизитам клиента

		if p_cl%class = 'CL_PRIV' then
			if  cl_pr.[DATE_PERS] = bl_struct.[BD] then
				str := str || NL$ || lpad(' ',5) || 'Дата рождения совпадает';
			end if;
			if cl_pr.[DATE_PERS] is null and to_char(cl_pr.[DATE_PERS],'RRRR') = bl_struct.[BYR] then
				str := str || NL$ || lpad(' ',5) || 'Год рождения совпадает';
			end if;
			if clear_cert_numb(bl_struct.[DS]) = clear_cert_numb(cl_pr.[DOC].[SER])
				and clear_cert_numb(cl_pr.[DOC].[NUM]) = clear_cert_numb(bl_struct.[DN])
				and v_withDop
			then
				str := str || NL$ || lpad(' ',5) || 'Данные документа совпадают';
			end if;
		else
			if v_withDop then
				if cl_or.[INN] = bl_struct.[INN] then
					str := str || NL$ || lpad(' ',5)||'ИНН клиента совпадает';
				end if;
				if upper(cl_or.[KOD_OKPO]) = upper(bl_struct.[DS]) then
					str := str || NL$ || lpad(' ',5) || 'Код ОКПО совпадает';
				end if;
				if upper(cl_or.[REGISTER].[GOS_REG_NUM_REC]) = upper(bl_struct.[DN]) then
					str := str || NL$ || lpad(' ',5) || 'ОГРН совпадает';
				elsif upper(cl_or.[REGISTER].[NUM_REESTR]) = upper(bl_struct.[DN]) then
					str := str || NL$ || lpad(' ',5) || 'Рег. номер совпадает';
				end if;
				if nvl(cl_or.[REGISTER].[DATE_REG], cl_or.[REGISTER].[DATE_REESTR]) = bl_struct.[DATE_REG] then
					str := str || NL$ || lpad(' ',5) || 'Дата регистрации совпадает';
				end if;
			end if;	
		end if;
		--toLog(str, null, v_pipe_name, P_LOG2PIPE, P_LOG2FILE);
		&debug(bl%class||'.'||bl%id||' '||str,dp)
		return Substr(str,1,2000);
	end if;
end;

procedure AddInfoDay(arh_val ref [KASSA_V], P_DATE [DATE],
	CntDay in out integer,
  --CntSumRub in out [SUMMA],
	CntSumEurRub in out [SUMMA],
	CntSumUsdRub in out [SUMMA],
	TmpSum [SUMMA],
	CurShort [STRING_3]) is
begin
	if 	trunc(arh_val.[DATE])=trunc(P_DATE) then
		CntDay:=CntDay+1;
	  --CntSumRub:=CntSumRub+TmpSum;
		if    CurShort='EUR' then CntSumEurRub:=CntSumEurRub+TmpSum;
		elsif CurShort='USD' then CntSumUsdRub:=CntSumUsdRub+TmpSum;
		else pragma error('Ош.');
		end if;
	end if;
end;

procedure InitPCustProps(p_info varchar2, vThis ref [CL_PRIV], P_TYPE in out [TP_OPER_REF],
 P_DATE in out [DATE],
 ClPrivRef [CL_PRIV_REF],					-- Выбор клиента
 vCUST_PROPS in out [SHORT_CLIENT],
 vCUST_DOC_TYPE in out [CERTIFIC_REF],
 vPHONE in out [STRING_4000],
 V_EXCHG_POINT in out [S_NOTRADE],			-- Текущая касса
 V_AVAIL_FIN_TOOLS_STR in out [STRING_32000],-- Строка доступных финансовых инструментов
 V_AVAIL_OPERS_STR in out [STRING_32000],	-- Строка доступных операций
 V_TYPE_CODE in out [STRING_6],				-- Код типа
 V_NAT_CURR_CODE in out [STRING_3],			-- Код национальной валюты
 P_IN_CURR in out [FT_MONEY_REF],
 P_IN_AM in out [SUMMA],
 P_OUT_CURR in out [FT_MONEY_REF],
 P_OUT_AM in out [SUMMA],
 P_RATE in out [SUMMA_16_6],
 P_PAY_DOC_TYPE in out [CHECK_OTHER_REF],
 P_BACK in out [SUMMA_16_6],
 V_DUMB_CB_RATE in out [SUMMA_16_6],				-- Курс ЦБ для формы
 V_DUMB_RATE in out [SUMMA_16_6],			-- Курс для формы
 V_SOURCE_MONEY_PROVIDED in out [BOOLEAN],	-- [ПСБ] Предоставлен документ, подтверждающий источник происхождения денежных средств
 V_NOTE in out [MEMO]						-- [ПСБ] Примечание
 ) is
UpName [NAME]:=upper(replace(trim(vThis.[NAME]),' '));
v_back_rate boolean;
CURR			ref [FT_MONEY];
begin
	&debug('P_INFO='||P_INFO,dp)
	
	if V_EXCHG_POINT is null then
		&debug('Ищем '||UpName||' '||to_char(ClTmp.[DATE_PERS],fmt)||' г.р. в какой кассе была последняя операция '||to_char(P_DATE,fmt),dp)
		for arh_val in ::[KASSA_V] all
		where 	trunc(arh_val.[DATE])=P_DATE
			  	and arh_val.[KOD_OPER].[KOD_OPER] in ('SEL_OP','BUY_OP','CON_OP')
				and upper(replace(arh_val.[NEW_CLIENT].[NAME],' '))=UpName
			  	and trunc(arh_val.[NEW_CLIENT].[BIRTHDAY])=trunc(ClTmp.[DATE_PERS])
			  	and arh_val%state!='DELETED'
		order by arh_val.[DATE] desc
		loop
			V_EXCHG_POINT:=arh_val.[NUM_POINT];
			&debug('Касса, где '||to_char(P_DATE,fmt)||' была последняя операция клиента '||V_EXCHG_POINT.[NUM_PK]||'-'||V_EXCHG_POINT.[NAME_PK],dp)
			exit;
		end loop;
	end if;
	EXCHG_POINT_FILIAL:=V_EXCHG_POINT.[FILIAL];
	EXCHG_POINT_DEPART:=V_EXCHG_POINT.[DEPART];
	
	TruncDateOperKassaV :=trunc(P_DATE);
	KassaV_FIlial		:=EXCHG_POINT_FILIAL;
	KassaV_NumPoint 	:=V_EXCHG_POINT;

