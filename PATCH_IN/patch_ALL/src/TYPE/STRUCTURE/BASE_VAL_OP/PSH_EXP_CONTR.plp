class BASE_VAL_OP;

@import_plsql(true)
@name('[ПСБ] Сформировать XML файл для загрузки в БД "ТБСВК Контракты"')
@tag('COPIED')
batch method PSH_EXP_CONTR is

@name('V_VB')         public V_VB     [STRING_32000];
@name('Путь к файлу') public V_PATH   [FILE$PATH];
@name('Путь к файлу') public V_PATH_C [FILE$PATH];
@name('Путь к файлу') public V_PATH_V [FILE$PATH];
delim   const string(1) := '$' ;

--public type FieldTblRec is record ( 	  num		::[PSB_BASE_VAL_EXP].[NUM]%type
--								, code		::[PSB_BASE_VAL_EXP].[CODE]%type
