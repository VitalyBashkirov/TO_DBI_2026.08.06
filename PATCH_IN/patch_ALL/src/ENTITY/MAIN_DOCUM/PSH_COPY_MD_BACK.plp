class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Копировать безналичный документ с обратными реквизитами')
method PSH_COPY_MD_BACK is
PSH_COPY_MD_BACK is

validate is
Begin
	if p_message = 'DEFAULT' then
		if this.[VID_DOC] <> ::[NAME_PAYDOC]([CODE] = 'БЕЗН_ПЛ_ПОРУЧ') then
			pragma error ('Операция предназначена для копирования только Платежных поручений!');
		end if;
	end if;
End;

execute is
	doc				[MAIN_DOCUM_REF];
	doc_obj			[MAIN_DOCUM];
	doc_obj_new		[MAIN_DOCUM];
	tempNumDoc		[NUMBER_DOC];
	v_date_op		date;
	v_doc_prior		::[MAIN_DOCUM].[PRIORITET]%type;
	l_err_msg		varchar2 (1000);
	v_req_dt		[REQ_CLIENT];
	v_nazn			[MEMO];
	v_doc_rc		ref [DOCUM_RC]; 
	v_nazn_add		[MEMO];
	v_start			integer;
	v_length		integer;
begin
	if this.[FILIAL] is null then
		pragma error ('Не указан филиал документа');
	end if;
	-- получим номер = текущее значение счетчика + 1
	[MD_OTHERS].SetCounter([VID_DOC], tempNumDoc, true, false, false, [NUM_KS], [NUM_KS1], this.[DEPART]);
	
	v_date_op := ::[SYSTEM].[VARIABLES].Br2OpDate(this.[FILIAL]%id);
	
	doc_obj := this;
	doc_obj%init(true, true);
	doc_obj.[DOCUMENT_NUM]:= tempNumDoc + 1;
	
	v_doc_prior := doc_obj.[PRIORITET];

	v_req_dt := doc_obj.[KL_KT]; 
	if v_req_dt.[2].[3] = ::[SYSTEM].[VARIABLES].OurBank then
		v_req_dt.[2].[2] := coalesce(this.[ACC_KT].[CLIENT_R].[NAME], this.[ACC_KT].[CLIENT_V].[NAME]);
		v_req_dt.[2].[FRIENDS] := null;
		v_req_dt.[2].[PART] := null;
		v_req_dt.[2].[INN] := coalesce(this.[ACC_KT].[CLIENT_R].[INN], this.[ACC_KT].[CLIENT_V].[INN]);
		v_req_dt.[2].[KPP] := coalesce(this.[ACC_KT].[CLIENT_R].[INN], this.[ACC_KT].[CLIENT_V].[KPP]);
	end if;
	
	-- Получение документа РЦ
	v_doc_rc := ::[DOCUM_RC].[LIB_VIEW].GETDOCRC(this);
	-- Получить информационный документ РЦ по платежному документу РЦ (тип связи "ORIG_EPD(drc_drc)")
	if v_doc_rc is not null then
		for (select	l(l.[OBJ_TO] obj)
				in		::[RC_LINK] all
				where	l.[OBJ_FROM] = to_char(v_doc_rc)
					and l.[LINK_TYPE] = ::[RC_LINK_TYPE]([CODE]='ORIG_EPD(drc_drc)')
					order by l%id desc
			)
		loop
			if instr(l.obj->(DOCUM_RC)[DEST], 'ПРИЧИНА:') > 0 then 
				v_start := instr(l.obj->(DOCUM_RC)[DEST], 'ПРИЧИНА:') + length('ПРИЧИНА:'); 					 			
				v_length := instr(substr(l.obj->(DOCUM_RC)[DEST], v_start) , NL$)-1; 
				if v_length > 0 then
					v_nazn_add := substr(l.obj->(DOCUM_RC)[DEST], v_start, v_length);  				
					v_nazn_add := rtrim( rtrim( v_nazn_add, NL$), CR$);
				end if;
			end if;
			exit;
		end loop;
	end if;
	
	v_nazn := '{VO99020} ВОЗВРАТ СРЕДСТВ ПО ПП.N ' || this.[DOCUMENT_NUM] || ' ОТ ' || to_char(this.[DATE_DOC], 'DD.MM.YYYY') || '. ПРИЧИНА: ' || case when v_nazn_add is not null then v_nazn_add end;
	
	doc := ::[MAIN_DOCUM].[NEW#AUTO](
		   --doc_obj.[DOCUMENT_NUM],	-- Номер
		   tempNumDoc,				-- Номер
	       v_date_op,				-- Дата документа
	       doc_obj.[VID_DOC],		-- Вид документа
	       doc_obj.[VALUTA],		-- Валюта платежа
	       doc_obj.[SUM],			-- Сумма в валюте платежа
	       doc_obj.[SUM_PO],		-- Сумма зачисления
	       v_req_dt,				-- Реквизит счета  для списания
		   doc_obj.[KL_DT],			-- Реквизиты счета для зачисления	       
	       doc_obj.[SUM_NT],		-- Сумма нац.покрытия
	       doc_obj.[DATE_PL],		-- Срок оплаты
	       doc_obj.[PRIORITET],		-- Срочность платежа
	       null,					-- Дата валютирования
	       doc_obj.[DOC_SEND_REF],	-- Почта/телеграф
	       v_nazn,					-- Назначение платежа
	       doc_obj.[KOD_NAZN_PAY],	-- Код назначения платежа
	       doc_obj.[VID_OBOROTA],	-- Вид оборота
	       doc_obj.[TYPE_MESS],		-- Тип сообщения
	       doc_obj.[PACHKA],		-- Пачка
	       doc_obj.[VALUTA_PO],		-- Валюта зачисления
	       doc_obj.[MULTICURR],		-- Свойство валютности
	       null,					-- Символ кассы
	       null,					-- Номер кассы Дт
	       null,					-- Номер кассы Кт
	       true,					-- Без комиссий
	       null,
	       v_date_op,
	       v_date_op,
	       null, 					-- Папка
	       null,					-- не ломаться
	       doc_obj.[BUDGET_PAYMENT],
	       doc_obj.[REQ_MAN],
	       doc_obj.[BUD_REQS],
	       P_COND_PAY_MEMO == doc_obj.[COND_PAY_MEMO],
	       P_FILIAL == doc_obj.[FILIAL],
	       P_DEPART == doc_obj.[DEPART],
	       P_CODE == doc_obj.[CODE],
	       P_RESERVE == doc_obj.[RESERVE],
	       P_NAZN_CODE == doc_obj.[NAZN_CODE]
	   );	
	l_err_msg := doc%request;
	doc_obj_new := doc;
	
	doc_obj_new.[DATE_DOC] := v_date_op;
	doc_obj_new.[DATE_VAL] := null;

	doc_obj_new.[PRIORITET] := v_doc_prior;
	doc_obj_new.[CODE_DOC]		:= doc_obj.[CODE_DOC];
	doc_obj_new.[DOCUMENT_NUM]	:= doc_obj.[DOCUMENT_NUM];
	doc_obj_new.[CURR_OPER]		:= doc_obj.[CURR_OPER];
	doc_obj_new.[DEAL_PASP]		:= doc_obj.[DEAL_PASP];	

	doc := doc_obj_new;

	::[MAIN_DOCUM].[NEW#AUTO_LIB].set_manual(doc);
	
	stdio.put_line_buf('<% CALL MAIN_DOCUM CHOICE#EDIT ' || doc%id || ' %>');
end;
end;
end;
