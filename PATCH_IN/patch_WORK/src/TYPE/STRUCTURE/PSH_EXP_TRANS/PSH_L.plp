class PSH_EXP_TRANS;

@name('[ПСБ] Библиотека')
method PSH_L is
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);

function getRegionById(
	p_reg_ref number
) return varchar2(1024) is
	ret_name varchar2(1024);
begin
	select x(x.[NAME])
	in ::[ADDRESS_OBJ]
	where x%id = p_reg_ref
	fetch 1
	into ret_name;
exception
	when NO_DATA_FOUND then
	ret_name:=null;
end;

function getRegionByAOGUID(
	p_aoid [STRING_40]
	, p_aoguid [STRING_40]
) return varchar2(1024) is
	ret_name varchar2(1024);
begin
	if p_aoid is not null then
		begin
			select x(x.[NAME])
			in ::[ADDRESS_OBJ]
			where x.[AOGUID] = p_aoguid
			and x.[AOID] = p_aoid
			fetch 1
			into ret_name;
			return ret_name;
		exception
			when NO_DATA_FOUND then
			ret_name:=null;
		end;
	else
		begin
			select x(x.[NAME])
			in ::[ADDRESS_OBJ]
			where x.[AOGUID] = p_aoguid
			and x.[AOID] is null
			fetch 1
			into ret_name;
			return ret_name;
		exception
			when NO_DATA_FOUND then
			ret_name:=null;
		end;
	end if;
end;

public function GetNameAdrObjName
/*Получить наименование адресного элемента*/
(
	p_id ref [PSH_EXP_TRANS] -- updated CHANGE_QUALIFIER EXP_TRANS->PSH_EXP_TRANS 08/10/25
		/*Ссылка на объект*/
	,p_TypeInfo number default null
		/*Тип информации*/
)
/*Возвращает наименование*/
return varchar2(1024) is
	rRef [REFERENCE];
	rTrKindKladr integer;
	rTrAoid [STRING_40];
	rTrAoguid [STRING_40];
	msg string(2000);
	vClass string(32);
	oTrans [PSH_EXP_TRANS]; -- updated CHANGE_QUALIFIER EXP_TRANS->PSH_EXP_TRANS 08/10/25
	ExpSearchTransId boolean;
	ret_str varchar2(1024);
begin
	oTrans := p_id;
	if oTrans%id is null then
		return null;
	end if;
	ExpSearchTransId := coalesce(::[FP_TUNE].[LIB].get_bool_value('EXP_SEARCH_TRANS_ID',null, '0'),false);
	rTrAoid := oTrans.[TR_AOID];
	rTrAoguid := oTrans.[TR_AOGUID];
	vClass := oTrans.[TR_CLASS];
	rRef := oTrans.[TR_ID];
	if p_TypeInfo=1 then
		ret_str := rRef;
	else
		if ExpSearchTransId then
			ret_str := getRegionById(rRef);
		else
			if rTrAoguid is not null and rTrAoid is not null then
				ret_str := getRegionByAOGUID(rTrAoid,rTrAoguid);
				if ret_str is not null then
					msg:='Найдено по GUID('||rTrAoguid||') и AOID('||rTrAoid||')';
				end if;
			end if;
		end if;
		if ret_str is null and vClass in ('PEOPLE_PLACE', 'REGION', 'COUNTRY') then
			rTrKindKladr:=oTrans.[TR_KIND_KLADR];
			rTrAoid := lpad(oTrans.[TR_AOID],3,'0');
			if vClass='PEOPLE_PLACE' then
				begin
					select o(o.[NAME])
					in ::[PEOPLE_PLACE]
					where o.[KLADR]=rTrKindKladr
					fetch 1
					into ret_str;
				exception
					when NO_DATA_FOUND then
					ret_str:=null;
				end;
			elsif vClass='REGION' then
				begin
					select o(o.[NAME])
					in ::[REGION]
					where o.[KLADR]=rTrKindKladr
					fetch 1
					into ret_str;
				exception
					when NO_DATA_FOUND then
					ret_str:=null;
				end;
			elsif vClass='COUNTRY' then
				begin
					select o(o.[NAME])
					in ::[COUNTRY]
					where o.[CODE]=rTrAoid
					fetch 1
					into ret_str;
				exception
					when NO_DATA_FOUND then
					ret_str:=null;
				end;
			end if;
			
			if ret_str is not null and vClass in ('PEOPLE_PLACE', 'REGION', 'COUNTRY') then
				if vClass='PEOPLE_PLACE' then
					msg:='Найдено по ID ('||rTrKindKladr||')';
				elsif vClass='REGION' then
					msg:='Найдено по ID ('||rTrKindKladr||')';
				elsif vClass='COUNTRY' then
					msg:='Найдено по ID ('||rTrAoid||')';
				end if;
			end if;
		end if;
	end if;

	&debug(TB$||TB$||msg||' '||ret_str,1)
	return ret_str;
end;
end;
