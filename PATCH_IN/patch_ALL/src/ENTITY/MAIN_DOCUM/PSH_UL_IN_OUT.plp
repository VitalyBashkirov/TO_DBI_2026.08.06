class MAIN_DOCUM;

@import_plsql(true)
@name('[ПСБ] Отчет по входящим и исходящим платежам ЮЛ за дату (Excel)')
static method PSH_UL_IN_OUT is

pragma macro (xl,'[OOXML]::[API_XL]');
pragma macro(lp, '::[SHABLON_DOC].[LIB_OOXML]');
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);

li_cur_row		integer;
n				integer;
prev_cl	ref [CLIENT];

procedure draw(P_DATE date)
is
i integer;
begin
	&xl.cell(1, 5, P_DATE);
	li_cur_row := 3;
	n := 0;
	
	for (select doc(doc obj,
					rk obj1
				   )
		in ::[MAIN_DOCUM]
			,(::[RKO] all rk) all
		where doc%state = 'PROV'
			and doc.[DATE_PROV] >= P_DATE
			and doc.[DATE_PROV] <  P_DATE + 1
			and rk.[ACCOUNT] in (doc.[ACC_DT], doc.[ACC_KT])
			and (  (substr(doc.[ACC_DT].[MAIN_V_ID],1,5) in ('40701','40702','40703','40802','40807') 
					and substr(doc.[ACC_KT].[MAIN_V_ID],1,5) not in ('47422','47423')
					and substr(doc.[ACC_KT].[MAIN_V_ID],1,3) not in ('706','458')
				   )
			    or (substr(doc.[ACC_KT].[MAIN_V_ID],1,5) in ('40701','40702','40703','40802','40807')
					and doc.[ACC_DT].[MAIN_V_ID] not like '706%' 
					and doc.[ACC_DT].[MAIN_V_ID] not like '47422%'
				   )
			    )
		
		order by rk.[CLIENT],
				case when coalesce(doc.[KL_DT].[2].[3],  doc.[KL_DT].[1].[2].[FILIAL].[BANK]) <> ::[SYSTEM].[VARIABLES].OurBank then 1
					 when coalesce(doc.[KL_KT].[2].[3],  doc.[KL_KT].[1].[2].[FILIAL].[BANK]) <> ::[SYSTEM].[VARIABLES].OurBank then 2
					 else 3
				end,
				doc.[SUM]
		)
	loop
		li_cur_row := li_cur_row + 1;
		if prev_cl is null or prev_cl <> doc.obj1.[CLIENT] then
			&xl.merge(p_tl_row == li_cur_row,p_tl_col == 1, p_br_row == li_cur_row, p_br_col == 15, p_allign == &xl.xl_ah_left);
			&xl.cell(li_cur_row, 1, doc.obj1.[CLIENT].[NAME], p_fontId == &xl.get_font('Calibri', 2, 11, 1, false, false, true), p_fillId == &xl.get_fill_back_color('C1C1C1'), p_vertical == &xl.xl_av_bottom, p_horizontal == &xl.xl_ah_left);
			li_cur_row := li_cur_row + 1;
		end if;
		i:= 1;
		n := n + 1;
		
		&xl.put(li_cur_row, i, n);  i := i + 1;	-- Номер по порядку
		&xl.put(li_cur_row, i, case when coalesce(doc.obj.[KL_DT].[2].[3],  doc.obj.[KL_DT].[1].[2].[FILIAL].[BANK]) <> ::[SYSTEM].[VARIABLES].OurBank then 'Входящий'
									when coalesce(doc.obj.[KL_KT].[2].[3],  doc.obj.[KL_KT].[1].[2].[FILIAL].[BANK]) <> ::[SYSTEM].[VARIABLES].OurBank  then 'Исходящий'
									else 'Внутренний'
							   end);  i := i + 1;				-- Тип платежа
		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_DT].[2].[1], doc.obj.[KL_DT].[1].[2].[MAIN_V_ID]));  i := i + 1;			-- Счет плательщика		
		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_DT].[2].[2], doc.obj.[KL_DT].[1].[1].[NAME]));  	 i := i + 1;			-- Наименование плательщика 
		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_DT].[2].[INN], doc.obj.[KL_DT].[1].[1].[INN]));  	 i := i + 1;			-- ИНН плательщика
		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_DT].[2].[3].[BIC],  doc.obj.[KL_DT].[1].[2].[FILIAL].[BANK].[BIC]));  i := i + 1;	-- БИК банка плательщика
		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_DT].[2].[3].[NAME], doc.obj.[KL_DT].[1].[2].[FILIAL].[BANK].[NAME]));  i := i + 1;	-- Наименование банка плательщика

		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_KT].[2].[1], doc.obj.[KL_KT].[1].[2].[MAIN_V_ID]));  i := i + 1;			-- Счет получателя		
		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_KT].[2].[2], doc.obj.[KL_KT].[1].[1].[NAME]));  	 i := i + 1;			-- Наименование получателя 
		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_KT].[2].[INN], doc.obj.[KL_KT].[1].[1].[INN]));  	 i := i + 1;			-- ИНН получателя
		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_KT].[2].[3].[BIC],  doc.obj.[KL_KT].[1].[2].[FILIAL].[BANK].[BIC]));  i := i + 1;	-- БИК банка получателя
		&xl.put(li_cur_row, i, coalesce(doc.obj.[KL_KT].[2].[3].[NAME], doc.obj.[KL_KT].[1].[2].[FILIAL].[BANK].[NAME]));  i := i + 1;	-- Наименование банка получателя
		
		&xl.put(li_cur_row, i, doc.obj.[SUM]);  i := i + 1;						-- Сумма платежа
		&xl.put(li_cur_row, i, doc.obj.[VALUTA].[CUR_SHORT]); 	 i := i + 1;	-- Валюта платежа
		&xl.cell(li_cur_row, i, doc.obj.[NAZN], p_wrapText == true);  i := i + 1;					-- Назначение платежа
		prev_cl := doc.obj1.[CLIENT];
	end loop;
end;
PSH_UL_IN_OUT (
	@name('Дата отчёта') P_DATE in [DATE]
) is

validate is
v_ch	integer;
begin
	if p_message = 'DEFAULT' then
		P_DATE := ::[SYSTEM].[OP_DATE];
		
	elsif  P_MESSAGE = 'VALIDATE'  then
		if P_INFO = 'OK' then
				if not nvl(&xl.open_file(::[SHABLON_DOC]([CODE]= 'PSB_UL_IN_OUT').[RPT_TMPL]), False) then
					pragma error('Ошибка открытия шаблона с кодом '||'PSB_UL_IN_OUT');
		    	end if;
				&lp.xl_init('PSB_UL_IN_OUT');
		    	&xl.open_sheet(1);		    					
				-- Формирование отчёта
				draw(P_DATE);
				
				-- debug_pipe('Закончена обработка',10);
				&xl.Set_Format_Range(3, 1, li_cur_row, &xl.getSheetColCount ,p_borderId==&xl.get_border(p_top=='thin',p_bottom=='thin',p_left=='thin',p_right=='thin'));
				&xl.set_autofilter(3, 3, 1, &xl.getSheetColCount);
				&xl.RenameSheet(1,to_char(P_DATE, 'dd.mm.yyyy')||'г.');

				&lp.xl_finish;				
	    end if;
	end if;
end;
end;
end;
