class MAIN_DOCUM;

@name('[ПСБ] Изменить настройки по печати подписей 3352-У')
method PSH_EDIT_PODP_KA is
PSH_EDIT_PODP_KA is

execute is
/*********************************************************************
Назначение:

kurganov, последнее изменение 13 Март 2015 г.
*********************************************************************/
i number:=0;
begin
	for spr_podp in ::[PSH_PODP_3352U] where spr_podp.[USER]=STDLIB.USERID
	loop
	i:=i+1;
	Stdio.PUT_LINE_BUF('<% CALL PSH_PODP_3352U EDIT_AUTO ' || spr_podp%id || ' %>');
	end loop;
	
if i=0 then Stdio.PUT_LINE_BUF('<% PLPCALL [PSH_PODP_3352U].[PSH_NEW_AUTO]() %>');
--pragma error ('Вас нет индивидуальной записи в спровочнике "[ПСБ] подписанты по 3352-У!"'||chr(10)||'Создайте сначала её со своим "Пользователя" в соответствующей кнопке.');
end if;


end;
end;
end;
