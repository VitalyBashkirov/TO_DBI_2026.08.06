class CLIENT;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Карточка с образцами подписей и оттиска печати (OOXML)')
@tag('COPIED')
method PSH_0401026_N is

@name('Имя клиента')                           public V_CLIENT                  [STRING_250];
@name('Полное наименование')                   public V_CLIENT_FULL             [STRING_1000];
@name('Адрес клиента')                         public V_CLIENT_ADDR             [STRING_250];
@name('Наш банк')                              public V_BANK                    [BANK_RUS_REF];
@name('Счета')                                 public V_ACC            table of [STR_BOOL_ID];
@name('Телефон клиента')                       public V_TEL                     [STRING_1000];
@name('Список лиц, наделенных правом подписи') public V_SIGN_FIRST     table of [GRID_TEMPLATE];
@name('Должностное лицо')                      public V_RERSON_FIRST            [PERSONS_POS_REF];
@name('Имя клиента в родительном падеже')      public V_DECLCLIENTNAME          [STRING_250];
@name('Коллекция')                             public V_COL                     [PERSONS_POS_ARR];
@name('Строка')                                public V_DEST                    [STRING_32000];
-- Дополнительные коды

PRAGMA INCLUDE(::[DEBUG_TRIGGER].[MACRO_LIB]);

type StrRec is record (val string(250));
type StrTable	is table of StrRec index by string;

type str 			is record (val string(15));
type dstr			is record (fval string(20), sval string(20));
type DStringTable	is table of dstr index by string;
type StringTable 	is table of str index by string;

OpDate	date;

MonthTbl 			StringTable;
NumTbl 				DStringTable;
TenTbl				DStringTable;
subTbl				StringTable;
HunTbl				DStringTable;
ThsTbl				DStringTable;

--Выбранный счет для вызова по PLPCALL (CALL)
V_SEL_ACC ref [AC_FIN];

function getPhone(pThis ref [CLIENT]) return string is
ph	string;
begin
	ph := ' ';
	for(select	x(x.[NUMB] : N)
		in		pThis.[CONTACTS]
		where	x.[ACTIV]
				and x.[TYPE] in (::[COMUNICATION]([CODE] = 'PHONE'), ::[COMUNICATION]([CODE] = 'MOBILEPHONE'))
	)loop
		if trim(ph) is null then
			ph := x.N;
		else
			exit when length(ph)+length(x.N)+2 > 128;
			ph := ph ||', '|| x.N;
		end if;
	end loop;

	return ph;
end;

function frm( str varchar2(2000),n integer, kol integer,k out integer) return  varchar2(2000) is
begin
	return ::[RUNTIME].[FIN].formating(str, n, kol, k);
end;

function SplitNames(cName string(2000), cAddr string(2000), bName string(2000)) return StrTable is
	pos	integer;
	v_tbl StrTable;
begin
	v_tbl('CN1').val := frm(cName, 1, 35, pos);
	v_tbl('CN2').val := frm(cName, pos, 55, pos);
	v_tbl('CN3').val := frm(cName, pos, 55, pos);
	v_tbl('CN4').val := frm(cName, pos, 55, pos);

	v_tbl('BN1').val := frm(bName, 1, 35, pos);
	v_tbl('BN2').val := frm(bName, pos, 55, pos);
	v_tbl('BN3').val := frm(bName, pos, 55, pos);
	v_tbl('BN4').val := frm(bName, pos, 55, pos);
	v_tbl('BN5').val := frm(bName, pos, 55, pos);
	v_tbl('BN6').val := frm(bName, pos, 55, pos);
	v_tbl('BN7').val := frm(bName, pos, 55, pos);
	v_tbl('BN8').val := frm(bName, pos, 55, pos);

	v_tbl('AD1').val := frm(cAddr, 1, 35, pos);
	v_tbl('AD2').val := frm(cAddr, pos, 55, pos);
	v_tbl('AD3').val := frm(cAddr, pos, 55, pos);
	v_tbl('AD4').val := frm(cAddr, pos, 55, pos);
	v_tbl('AD5').val := frm(cAddr, pos, 55, pos);
	v_tbl('AD6').val := frm(cAddr, pos, 55, pos);
	return v_tbl;
end;

function DateToString(P_DATE [DATE]) return  varchar2(120) is
	dd_str varchar2(25);
	mm_str varchar2(10);
	yy_str varchar2(75);
	tmp_one varchar2(1);
	tmp_ten varchar2(1);
	tmp_hun varchar2(1);
	tmp_tho varchar2(1);
	str 	varchar2(100);
begin
	if P_DATE is null then
		return ' ';
	end if;

	--День прописью
	tmp_one := substr(to_char(P_DATE, 'dd'),2,1);
	tmp_ten := substr(to_char(P_DATE, 'dd'),1,1);

	if tmp_ten = '0' then
		dd_str := INITCAP(NumTbl(tmp_one).sval);
	else
		if tmp_one = '0' then
			dd_str := INITCAP(TenTbl(tmp_ten).sval);
		else
			if tmp_ten = '1' then
				dd_str := INITCAP(subTbl(tmp_ten || tmp_one).val);
			else
				dd_str := (INITCAP(TenTbl(tmp_ten).fval) || ' ' || NumTbl(tmp_one).sval);
			end if;
		end if;
	end if;

	--Месяц прописью
	mm_str := MonthTbl(to_char(P_DATE, 'mm')).val;

	--Год прописью
	tmp_one := substr(to_char(P_DATE, 'yyyy'),4,1);
	tmp_ten := substr(to_char(P_DATE, 'yyyy'),3,1);
	tmp_hun := substr(to_char(P_DATE, 'yyyy'),2,1);
	tmp_tho := substr(to_char(P_DATE, 'yyyy'),1,1);

	if tmp_one = '0' AND tmp_ten = '0' AND tmp_hun = '0' then
		yy_str := ThsTbl(tmp_tho).sval;

	elsif tmp_one = '0' AND tmp_ten = '0' then
		yy_str := ThsTbl(tmp_tho).fval || ' ' || HunTbl(tmp_hun).sval;

	elsif tmp_tho = '0' then
		if tmp_ten = '0' then
			yy_str := HunTbl(tmp_hun).fval || ' ' || NumTbl(tmp_one).sval;
		else
			if tmp_one = '0' then
				yy_str := HunTbl(tmp_hun).fval || ' ' || TenTbl(tmp_ten).sval;
			else
				if tmp_ten = '1' then
					yy_str := HunTbl(tmp_hun).fval || ' ' || subTbl(tmp_ten || tmp_one).val;
				else
					yy_str := HunTbl(tmp_hun).fval || ' ' || TenTbl(tmp_ten).fval || ' ' || NumTbl(tmp_one).sval;
				end if;
			end if;
		end if;

	elsif  tmp_hun = '0' then
		if tmp_ten = '0' then
			yy_str := ThsTbl(tmp_tho).fval || ' ' || NumTbl(tmp_one).sval;
		else
			if tmp_one = '0' then
				yy_str := ThsTbl(tmp_tho).fval || ' ' || TenTbl(tmp_ten).sval;
			else
				if tmp_ten = '1' then
					yy_str := ThsTbl(tmp_tho).fval || ' ' || subTbl(tmp_ten || tmp_one).val;
				else
					yy_str := ThsTbl(tmp_tho).fval || ' ' || TenTbl(tmp_ten).fval || ' ' || NumTbl(tmp_one).sval;
				end if;
			end if;
		end if;
	end if;

	str := dd_str || ' ' || mm_str || ' ' || yy_str || ' ' || 'года';
	return str;
end;

begin

/*-----------------------------Месяцы-----------------------------*/
	MonthTbl('01').val := 'января';
	MonthTbl('02').val := 'февраля';
	MonthTbl('03').val := 'марта';
	MonthTbl('04').val := 'апреля';
	MonthTbl('05').val := 'мая';
	MonthTbl('06').val := 'июня';
