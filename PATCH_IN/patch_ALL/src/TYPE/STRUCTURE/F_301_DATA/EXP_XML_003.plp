class F_301_DATA;
@generate_ansi_joins(true)
@name('Дельта (XML_301_2025-07-08 от 08.07.2025)')
library EXP_XML_003 is

pragma include (::[REPS_DATA].[LIB_VIEW]);
pragma include (::[REPS_DEBUG].[LIB]);
pragma include (::[REPS_DATA].[LIB_TYPE]);

pragma macro (lib_delta,	'::[REPS_DATA].[LIB_DELTA]');
pragma macro (lib_rca,		'::[REPS_CB_ACTS].[LIB]');
pragma macro(lib_exp,		'::[F_301_DATA].[LIB_EXP_002]');

--	Версия ядра
lcvCorever	const	varchar2(10)		:= '6:';
--	Ссылка на реализацию
lrParam				ref [REPS_PARAMS];
--	Ссылка на отчёт из реализации
lrRep				ref [REPS];
-- Флаг, определяющий, что реализация считается "ежемесячной"
lbIsMonthParam			boolean;
/**
 * Функция, возвращающая версию отчёта
 */
public function GetCoreVer
	return varchar2(10)
is
begin
	return lcvCorever;
end;


/**
 * Функция, возвращающая информацию о приложении
 */
public function GetCoreInfo
	return varchar2(4000)
is
	vStr	varchar2(4000);
begin
	::[RUNTIME].[STR].set_par(vStr, 'P_IS_EXT', '1');
	::[RUNTIME].[STR].set_par(vStr, 'P_PRIL_NAME', 'Экспорт данных отчета в формате XML для ПП "Дельта"');

	return vStr;
end;


function ExportR1
	return boolean
is
	subtype rec_Data is &lib_exp.cur_R1;
	curData	::[RUNTIME].[UTILS].ref_cursor;
	nOstatok	number;
	--флаг наличия данных в разделе
	bExistsData	boolean	default false;
begin
	--	Открытие тега Раздел1
	&lib_delta.OpenTag('Раздел1');

	curData := &lib_exp.OpenCurData(lrParam, 1);
	&for_opened_cursor(recData, curData, rec_Data, 1000)
		nOstatok	:=	recData.C_SALDO_MLN;

		if nOstatok <> 0 then
			--если данные есть изменяем флаг 
			if not bExistsData then
				bExistsData	:=	true;
			end if;
			&lib_delta.OpenTag('Расшифровки');

			&lib_delta.SetAttribute	(
										P_ATTR			==	'Счет2Пор'
									,	P_VALUE			==	recData.C_MAIN_USV
									,	P_LEN_MAX		==	5
									,	P_IS_REQUIRED	==	true
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'КодРасшифр'
									,	P_VALUE			==	recData.C_MAIN_USV_CODE
									,	P_LEN_MAX		==	2
									,	P_IS_REQUIRED	==	true
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'КодВал'
									,	P_VALUE			==	recData.C_CUR_CODE
									,	P_LEN_MAX		==	3
									,	P_IS_REQUIRED	==	true
									);
			&lib_delta.SetAttribute	(
										P_ATTR			==	'ОстатСредств'
									,	P_VALUE			==	nOstatok
									,	P_LEN_MAX		==	12
									,	P_PATTERN		==	'^-?[0-9]+$'
									,	P_IS_REQUIRED	==	true
									);

			&lib_delta.CLoseTag('Расшифровки');
		end if;
	&end_forcursor;

	--если данных нет в разделе 
	if not bExistsData then
		&lib_delta.OpenTag('Расшифровки');

		&lib_delta.SetAttribute	(
									P_ATTR			==	'Счет2Пор'
								,	P_VALUE			==	null
								,	P_LEN_MAX		==	5
								,	P_IS_REQUIRED	==	true
								);
		&lib_delta.SetAttribute	(
									P_ATTR			==	'КодРасшифр'
								,	P_VALUE			==	null
								,	P_LEN_MAX		==	2
								,	P_IS_REQUIRED	==	true
								);
		&lib_delta.SetAttribute	(
									P_ATTR			==	'КодВал'
								,	P_VALUE			==	null
								,	P_LEN_MAX		==	3
								,	P_IS_REQUIRED	==	true
								);
		&lib_delta.SetAttribute	(
									P_ATTR			==	'ОстатСредств'
								,	P_VALUE			==	null
								,	P_LEN_MAX		==	12
								,	P_PATTERN		==	'^-?[0-9]+$'
								,	P_IS_REQUIRED	==	true
								);

		&lib_delta.CLoseTag('Расшифровки');
	end if;
	&lib_delta.CloseTag('Раздел1');
	return bExistsData;
end;


