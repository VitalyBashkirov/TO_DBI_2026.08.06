class HOOK_BANK;

@name('РКО. Получение суммы для бизнес-операции. Вер.02 (точка вызова)')
method RKO_GETSUM_CP_2 is
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
dp  integer:=0;			--управление debug_pipe
dp1 integer:=0;			--управление debug_pipe
dp2 integer:=0;			--управление debug_pipe
dp3 integer:=0;			--управление debug_pipe
dp4 integer:=null;		--управление debug_pipe
dp5 integer:=null;		--управление debug_pipe

fmt	string(10):='dd/mm/yyyy';
fmt24  string(22):='dd/mm/yyyy HH24:MI:SS';
fmtHMS string(22):='dd/mm/yyyy HH24:MI:SS';

public function iif(v1 boolean, v2  varchar2(32767), v3 varchar2(32767)) return  varchar2(32767) is
begin if v1 then return v2; else return v3; end if; end;

public procedure do_debug(p_str varchar2, dp number default null) is
begin
	if	coalesce(::[FP_TUNE].[LIB].get_bool_value('ABS_DEBUG_KOMISS_RKO', stdlib.userid, 0), false) then
		 stdio.setup_pipes('KOMISS', 'KOMISS');
		 stdio.put_line_pipe(p_str, 'KOMISS');
		 &debug(p_str,dp)
	else &debug(p_str,dp)
	end if;
end;

public function GetTimeInterval(tEnd number, tBeg number) return number is
tMax    number:= 2147483647;
tMin    number:=-2147483648;
nLength number:=tMax - tMin + 1;
Minhalf number:=tMin/2;
Maxhalf number:=(tMax+1)/2;
begin
	if    tBeg>Maxhalf and tEnd<Minhalf then return tEnd-tBeg+nLength;
	elsif tBeg<Minhalf and tEnd>Maxhalf then return tEnd-tBeg-nLength;
	end if;
	return tEnd-tBeg;
end;

public function InfoDocS(d ref [DOCUMENT]) return string(32000) is
ExStr string(4000);
md ref [MAIN_DOCUM];
fp ref [FOLDER_PAY];
nErr integer:=0;
OkDoc boolean:=false;
OkProd boolean:=false;
RefProd ref [PRODUCT];
begin
	begin
		ExStr:=SubStr(ExStr||d%class||'.'||d%id||'.'||d%state||' №'||d.[DOCUMENT_NUM]||iif(d.[DOCUMENT_UNO],' UNO:'||d.[DOCUMENT_UNO],'')||' '||d.[DEPART].[CODE]||iif(d.[DOCUMENT_DATE] is null,'',' ДСозд:'||to_char(d.[DOCUMENT_DATE],fmt))||iif(d.[ASTR_DATE_PROV]is null,'',' ДПрАс:'||to_char(d.[ASTR_DATE_PROV],fmt24))||iif(d.[DOCUMENT_USER] is null,'',' UsrСозд:'||d.[DOCUMENT_USER].[USERNAME])||iif(d.[USER_EXEC]  is null,'',' UsrИсп:' ||d.[USER_EXEC].[USERNAME])||LF$,1,2000);
	exception when others then
		&debug('.InfoDocS -- В тип [DOCUMENT] передано что-то непонятное. Ищем объект id:'||d,dp)
		if d is not null then
			for (select dkm(dkm%id) in ::[DOCUMENT] all where dkm%id=d%id) loop
				OkDoc:=true;
				exit;
			end loop;
			if not OkDoc then
				&debug('.InfoDocS -- Это не документ!!!',dp)
			end if;
		end if;
		for (select prd(prd%id:C_ID) in ::[PRODUCT] all where prd%id=d%id) loop
			OkProd:=true;
			RefProd:=prd.C_ID;
			&debug('.InfoDocS -- Это продукт '||RefProd%class||'.'||RefProd%id,dp)
			exit;
		end loop;
		if not OkProd then
			&debug('.InfoDocS -- Это не продукт!!!',dp)
			ExStr:=SubStr('Объект id:'||d||' не опознан! '||ExStr,1,ExStr%size);
			--begin
			--	::[RKO].[ABS_OBJ](d%id);
			--exception when others then
			--	ExStr:=SubStr('Объект id:'||d||' не опознан! '||ExStr,1,ExStr%size);
			--	&debug('.InfoDocS -- Объект id:'||d||' не опознан!',dp)
			--end;
		end if;
	end;
	
	begin
		if d%class='MAIN_DOCUM' then md:=d;       ExStr:=SubStr(ExStr||md%class||'.'||md%id||'.'||md%state||' №'||md.[DOCUMENT_NUM]||iif(md.[DOCUMENT_UNO],' UNO:'||md.[DOCUMENT_UNO],'')||' '||md.[DEPART].[CODE]||' Папка(id:'||md.[IN_FOLDER]%id||'.'||md.[IN_FOLDER]%state||'){'||md.[IN_FOLDER].[DOCS_IN_FOLD]%size(0)||'}'
			||iif(md.[DATE_PROV] is null,'',' ДПров:'||to_char(md.[DATE_PROV],fmt24))||' '
			||md.[SUM]||' '||md.[VALUTA].[CUR_SHORT]||' '
			||md.[ACC_DT].[MAIN_V_ID]||'-'||md.[ACC_KT].[MAIN_V_ID]||' '
			||iif(md.[KL_DT].[0]=1,md.[KL_DT].[1].[2].[MAIN_V_ID],md.[KL_DT].[2].[1])
			||'-'
			||iif(md.[KL_KT].[0]=1,md.[KL_KT].[1].[2].[MAIN_V_ID],md.[KL_KT].[2].[1])
			||' '
			||md.[NAZN]||LF$,1,2000);
		elsif d%class='FOLDER_PAY' then fp:=d%id; ExStr:=SubStr(ExStr||fp%class||'.'||fp%id||'.'||fp%state||' №'||fp.[DOCUMENT_NUM]||iif(fp.[DOCUMENT_UNO],' UNO:'||fp.[DOCUMENT_UNO],'')||' '||fp.[DEPART].[CODE]||' {'||fp.[IN_FOLDER].[DOCS_IN_FOLD]%size(0)||'}'||' БО:'||fp.[BUSINESS_OP].[PATTERN_CODE]||'-'||fp.[BUSINESS_OP].[PATTERN_NAME]||LF$,1,2000);
		  for dif in fp.[IN_FOLDER].[DOCS_IN_FOLD] loop
		  ExStr:=SubStr(ExStr||TB$||rpad(dif.[NUM],5)||' '||Rpad('ID:'||dif.[PATT_REF]%id||'.'||dif.[PATT_REF].[NOTE],35)||' '||InfoDocS(dif.DOCUMENT),1,2000);
		  if nErr>20 then ExStr:=SubStr(ExStr||'...',1,2000); exit; end if;
		  end loop;
		end if;
	exception when others then
		&debug('.InfoDocS -- Объект id:'||d||' не опознан',dp)
	end;
	return SubStr(ExStr,1,2000);
end;
RKO_GETSUM_CP_2 (
	@name('Договор РКО')              P_RKO        in [RKO_REF],
	@name('Тип суммы')                P_TYPE_SUMMA in [SUM_GUIDE_REF],
	@name('Дополнительные параметры') P_ADDS       in [STRING_32000]
) return [SUMMA_16_6] is

execute is
timeStart number;	 --BVG 25.05.2017 Для расчета времени выполнения HOOKa
oSG [SUM_GUIDE]:=P_TYPE_SUMMA;
sumRet [SUMMA_16_6];
sumDlyKomRko [SUMMA];
IsKt varchar2(1);
doc ref [DOCUMENT];
md ref [MAIN_DOCUM];
oMD [MAIN_DOCUM];

FtUnit integer; -- Единица измерения валюты
d30 [DATE_TIME];
begin
	timeStart:=utils.get_time; --BVG 25.05.2017 Для расчета времени выполнения HOOKa
  --&debug('utils.call_stack='||utils.call_stack,dp)
	&debug('Старт:'||to_char(sysdate,'hh24:mm:ss')||' P_TYPE_SUMMA='||oSG.[COD]||'-'||oSG.[NAME]||' P_RKO='||P_RKO%class||'.'||P_RKO%id||' '||' P_ADDS='||P_ADDS,dp)
	
	[STR].get_par(P_ADDS, 'ДЛЯ_КОМИСС_РКО', sumDlyKomRko);
	[STR].get_par(P_ADDS, 'IS_KT', IsKt);
	begin
		[STR].get_par(P_ADDS, 'DOC_RKO', doc);
		if doc is not null and doc%class='MAIN_DOCUM' then md:=doc; oMD:=md;	do_debug(&METHOD$SNAME ||' -- '||InfoDocS(md),dp3);
		else 																	do_debug(&METHOD$SNAME||' -- '||InfoDocS(doc),dp3);
		end if;
	exception when others then
		do_debug('.RKO_GETSUM_CP_1 -- Ош.извлечения документа ~DOC_RKO~ из P_ADDS='||P_ADDS,dp3);
	end;
	
	if oSG.[COD]='СУММА_ДОКУМЕНТА_КУРС_ДТ'
	or oSG.[COD]='СУММА_ДОКУМЕНТА_КУРС_КТ'
	or oSG.[COD]='СУММА_ДОКУМЕНТА_ЕИВ_ДТ'
	or oSG.[COD]='СУММА_ДОКУМЕНТА_ЕИВ_КТ'
	then
		declare
			v_op_date	date;
			v_branch	ref [BRANCH];
			v_doc		ref [DOCUMENT];
			v_nat_cur	ref [FT_MONEY] := ::[SYSTEM].[VARIABLES].NatCur;
		begin
			if nvl(oMD.[SUM], 0) <= 0 then
				oMD := ::[RKO_INTERFACE].[PRX_DOCUMENT].BO_GET_MD_STRUCT; -- Структура документа для расчёта комиссии
				if nvl(oMD.[SUM], 0) <= 0 then
					-- Если структура не заполнена, возьмем из ссылки на документ
					v_doc := ::[RKO_INTERFACE].[PRX_DOCUMENT].BO_GET_DOC_REF;
					begin
						locate oMD in ::[MAIN_DOCUM] where oMD%id = v_doc%id;
					exception when no_data_found then
						null;	
					end;
				end if;
			end if;
			
			v_branch	:= coalesce(oMD.[FILIAL], ::[SYSTEM].[VARIABLES].OurBranch);
			v_op_date	:= coalesce(oMD.[DATE_PROV]
								   ,oMD.[DATE_VAL]
								   ,::[SYSTEM].[VARIABLES].Br2OpDate(v_branch%id));
			sumRet := null;
			if    oSG.[COD]='СУММА_ДОКУМЕНТА_КУРС_ДТ' then
				/** /
				sumRet:=oMd.[RATE_DT];
				if sumRet is null and oMD.[SUM] is not null then
					sumRet := ::[DOCUMENT].[LIB_CUR].Cur2Cur(oMD.[SUM], oMD.[VALUTA], v_nat_cur, v_op_date);
				end if;
				if sumRet is null then
					sumRet := oMD.[SUM_NT];
				end if;
				/**/
				if sumRet is null then
					sumRet:=1;
					if oMD.[RATE_DT] is null then
						d30:=trunc(coalesce(oMD.[DATE_VAL],oMD.[DATE_PROV],oMD.[FILIAL].[OP_DATE],[SYSTEM].[OP_DATE]));
						sumRet:=[DOCUMENT]::[LIB_CUR].get_rate_for_date(oMD.[ACC_DT].[FINTOOL], d30, FtUnit);
					  --sumRet:=sumRet/nvl(FtUnit,1);
					else
						sumRet:=oMD.[RATE_DT];
					end if;
				end if;
			elsif oSG.[COD]='СУММА_ДОКУМЕНТА_КУРС_КТ' then
				/** /
				sumRet:=oMd.[RATE_KT];
				if sumRet is null and oMD.[SUM_PO] is not null then	
					sumRet := ::[DOCUMENT].[LIB_CUR].Cur2Cur(oMD.[SUM_PO], oMD.[VALUTA_PO], v_nat_cur, v_op_date);
				end if;	
				if sumRet is null then
					sumRet := oMD.[SUM_NT];
				end if;
				/**/
				if sumRet is null then
					sumRet:=1;
					if oMD.[RATE_KT] is null then
						d30:=trunc(coalesce(oMD.[DATE_VAL],oMD.[DATE_PROV],oMD.[FILIAL].[OP_DATE],[SYSTEM].[OP_DATE]));
						sumRet:=[DOCUMENT]::[LIB_CUR].get_rate_for_date(oMD.[ACC_KT].[FINTOOL], d30, FtUnit);
					  --sumRet:=sumRet/nvl(FtUnit,1);
					else
						sumRet:=oMD.[RATE_KT];
					end if;
				end if;
			elsif oSG.[COD]='СУММА_ДОКУМЕНТА_ЕИВ_ДТ' then sumRet:=nvl(oMd.[VALUTA].[VAL_UNIT],1);
			elsif oSG.[COD]='СУММА_ДОКУМЕНТА_ЕИВ_КТ' then sumRet:=nvl(oMd.[VALUTA_PO].[VAL_UNIT],1);
			end if;
		end;
	end if;
	
	&debug('Стоп :'||to_char(sysdate,'hh24:mm:ss')||' ('||GetTimeInterval(utils.get_time,timeStart)||'сотыхСек.) '||oSG.[COD]||'-'||oSG.[NAME]||'->'||sumRet,dp)
	do_debug(oSG.[COD]||'-'||oSG.[NAME]||'->'||sumRet,dp);
	return sumRet;
end;
end;
end;
