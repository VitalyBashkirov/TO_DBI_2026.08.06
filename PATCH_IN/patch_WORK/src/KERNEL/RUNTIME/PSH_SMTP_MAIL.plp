/* DEPRECATED
Значение для поля "X-Mailer" служебного заголовка письма.  */
;

public BOUNDARY CONSTANT VARCHAR2(256) := '-----7D81B75CCC90D2974F7A1CBD'
/* DEPRECATED
Идентификатор границы вложения. */
;

public FIRST_BOUNDARY  CONSTANT VARCHAR2(256) := '--' || BOUNDARY || utl_tcp.CRLF
/* DEPRECATED
Верхняя граница вложения. */
;
public LAST_BOUNDARY   CONSTANT VARCHAR2(256) := '--' || BOUNDARY || '--' || utl_tcp.CRLF
/* DEPRECATED
Нижняя граница вложения. */
;

public MULTIPART_MIME_TYPE CONSTANT VARCHAR2(256) := 'multipart/mixed; boundary="'|| BOUNDARY || '"'
/* DEPRECATED
Заголовок, обозначающий наличие вложений. */
;
public MAX_BASE64_LINE_WIDTH CONSTANT PLS_INTEGER   := 76 / 4 * 3
/* DEPRECATED
Длина строки для base64. */
;

pragma include ([INTERFACE].[COMPILE_LIB]);

procedure check_api is
begin
	&check_api
end;

/*	Внимание!
	Процедуры, которые объявлены ниже, являются обёртками для вызова функции ::[RUNTIME].[EMAIL].send.
	Все подпрограммы (за исключением init_), определённые ниже комментария DEPRECATED, планируются к удалению в следующих версиях.
*/


function str2arr
	(p_str varchar2(32767)
	,p_delimiters varchar2 := ';'
	)
	return constant.string_table
is
	v_arr constant.string_table;
	v_pos1 pls_integer := 1;
	v_pos2 pls_integer;
	v_delimiter varchar2(1) := substr(p_delimiters,1,1);
	v_str varchar2(32767);
	v_one varchar2(32767);
begin
	if p_str is null then
		return v_arr;
	end if;
	v_str := translate(p_str,p_delimiters,rpad(v_delimiter,length(p_delimiters),v_delimiter));
	loop
		v_pos2 := instr(v_str,v_delimiter,v_pos1);
		v_one := trim(substr(v_str, v_pos1, case when v_pos2 > 0 then v_pos2 else length(v_str) + 1 end - v_pos1));
		if v_one is not null then
			v_arr(v_arr.count+1) := v_one;
		end if;
		exit when v_pos2 = 0 or v_pos2 is null;
		v_pos1 := v_pos2 + 1;
	end loop;
	return v_arr;
end;

function get_attachments_from_fio
/* Загружает файлы из FIO и возвращает массив с ними. */
	(p_dir varchar2(32767) default null
		/* Путь до файлов (в FIO). */
	,p_files varchar2(32767) default null
		/* Список имён файлов, разделённых ";". */
	)
	/* Массив с файлами. */
	return attach_array is
	v_attach attach_array;
	v_str_arr constant.string_table;
	v_file integer;
	v_len integer;
	v_raw raw(32767);
begin
	v_str_arr := str2arr(p_files,';');
	if v_str_arr.count > 0 then
		for i in 1..v_str_arr.count loop
			if v_attach is null then
				v_attach.init;
			end if;
			v_attach.extend(1);
			v_attach(v_attach.last).filename := substr(v_str_arr(i),1,256);
			dbms_lob.createtemporary(v_attach(v_attach.last).bdata,false,dbms_lob.call);
			v_file := stdio.open(nvl(p_dir,'.'), v_str_arr(i), 'r');
			loop
				v_len := stdio.f_read(v_file,v_raw,32767);
				exit when nvl(v_len,0) = 0;
				dbms_lob.writeappend(v_attach(v_attach.last).bdata,v_len,v_raw);
			end loop;
			stdio.close(v_file);
			if v_attach(v_attach.last).bdata is null or dbms_lob.getlength(v_attach(v_attach.last).bdata) = 0 then
				v_attach.delete(v_attach.last);
			end if;
		end loop;
	end if;
	return v_attach;
end;



procedure set_param_email is
begin
	[EMAIL].set_params
		(p_smtp_host == HOST
		,p_smtp_port == PORT
		,p_smtp_domain == HELO
		,p_sender_addr == ::[PCORE_INTERFACE].[INT_EMAIL_001].get_address_from_str(DEF_EMAIL)
		);
end;

public procedure set_auth
/* Выполняет изменение настроек, необходимых для аутентификации на сервере smtp. */
	(p_smtp_auth_user varchar2(30)
		/* Имя пользователя. */
	,p_smtp_auth_pass varchar2(30)
		/* Пароль. */
	,p_smtp_auth_scheme varchar2(50)
		/* Схема аутентификации. Поддержаны схемы 'PLAIN', 'LOGIN'. Также для Платформы 1 возможно использование схем аутентификации, поддерживаемых в пакете utl_smtp. */
	) is 
begin
	[EMAIL].set_auth
		(p_smtp_auth_user == p_smtp_auth_user
		,p_smtp_auth_pass == p_smtp_auth_pass
		,p_smtp_auth_scheme == p_smtp_auth_scheme
		);
end;	

public procedure send_mail
/* Выполняет отправку письма по электронной почте заданным адресатам. */
	(sToEMail varchar2
		/* Один или несколько адресов, разделенных ";" или ",". */
	,sSubject varchar2
		/* Тема письма. */
	,sMessage varchar2
		/* Текст письма. */
	,sFromEMail varchar2 default null
		/* Отправитель письма. */
	,bThrowExc boolean default false
		/* Признак вызова ошибки при неудачной отправке. */
	,isHtml boolean default false
		/* Признак того, что тип MIME для текста письма должен быть text/html. */
	) is 
	v_err varchar2(32767);
begin
	set_param_email;
	v_err := [EMAIL].send
		(p_recipients == ::[PCORE_INTERFACE].[INT_EMAIL_001].get_addresses_from_str(sToEMail)
		,p_sender == ::[PCORE_INTERFACE].[INT_EMAIL_001].get_address_from_str(sFromEMail)
		,p_subject == sSubject
		,p_message == to_clob(sMessage)
		,p_mimetype == case when isHtml then 'text/html' else 'text/plain' end
		,p_raise_error == bThrowExc
		);
	if v_err is not null then
		debug_pipe('Ошибка при отправке сообщения по электронной почте: '||v_err);
	end if;
end;

public procedure send_mail_to_cl
/* Выполняет отправку письма по электронной почте  на все действующие адреса в массиве контактов клиента. */
	(rClient in ref [CLIENT]
		/* Клиент. */
	,sSubject in varchar2
		/* Тема письма. */
	,sMessage in varchar2
		/* Текст письма. */
	,sFromEMail in varchar2 default null
		/* Отправитель письма. */
	,bThrowExc in boolean default false
		/* Признак вызова ошибки при неудачной отправке. */
	) is 
	v_recipients [EMAIL].address_array;
	v_name ::[CLIENT].[NAME]%type;
	v_err varchar2(32767);
begin
	set_param_email;
	v_recipients.init;
	if rClient is not null then
		v_name := rClient.[NAME];
		for
			(select r(regexp_replace(r.[NUMB],'\s'):email)
				in rClient.[CONTACTS]
				where r.[TYPE].[CODE] = 'MAIL'
					and r.[ACTIV]
					and regexp_like(regexp_replace(r.[NUMB],'\s'),'\S+@\S+') -- отсекаем пустые и заведомо некорректные адреса
			)
		loop
			v_recipients.extend(1);
			v_recipients(v_recipients.count).name := v_name;
			v_recipients(v_recipients.count).address := r.email;
		end loop;
		v_err := [EMAIL].send
			(p_recipients == v_recipients
			,p_sender == ::[PCORE_INTERFACE].[INT_EMAIL_001].get_address_from_str(sFromEMail)
			,p_subject == sSubject
			,p_message == to_clob(sMessage)
			,p_raise_error == bThrowExc
			);
		if v_err is not null then
			debug_pipe('Ошибка при отправке сообщения по электронной почте: '||v_err);
		end if;
	end if;
end;

public procedure SendMail4
	(sToEMail varchar2
		/* Один или несколько адресов, разделенных ";" или ",". */
	,sSubject varchar2
		/* Тема письма. */
	,sBodyMessage varchar2
		/* Текст письма. */
	,sFromEMail varchar2 default null
		/* Отправитель письма. */
	,attach_file_location varchar2 default null
		/* Путь до файлов (в FIO). */
	,attach_file_list varchar2(4000) default null
		/* Список имён файлов, разделённых ";". */
	,bThrowExc in boolean default false
		/* Признак вызова ошибки при неудачной отправке. */
	) is 
	v_err varchar2(32767);
begin
	set_param_email;
	v_err := [EMAIL].send
		(p_recipients == ::[PCORE_INTERFACE].[INT_EMAIL_001].get_addresses_from_str(sToEMail)
		,p_sender == ::[PCORE_INTERFACE].[INT_EMAIL_001].get_address_from_str(sFromEMail)
		,p_subject == sSubject
		,p_message == to_clob(sBodyMessage)
		,p_attachments == get_attachments_from_fio(p_dir == attach_file_location, p_files == attach_file_list)
		,p_raise_error == bThrowExc
		);
	if v_err is not null then
		debug_pipe('Ошибка при отправке сообщения по электронной почте: '||v_err);
	end if;
end;

public procedure SendMail
	(sToEMail varchar2
		/* Один или несколько адресов, разделенных ";" или ",". */
	,sSubject varchar2
		/* Тема письма. */
	,sBodyMessage varchar2
		/* Текст письма. */
	,sFromEMail varchar2 default null
		/* Отправитель письма. */
	,attach_file_location varchar2 default null
		/* Путь до файла (в FIO). */
	,attach_file_name varchar2 default null
		/* Имя файла. */
	,bThrowExc in boolean default false
		/* Признак вызова ошибки при неудачной отправке. */
	) is 
begin
	SendMail4
		(sToEMail == sToEMail
		,sSubject == sSubject
		,sBodyMessage == sBodyMessage
		,sFromEMail == sFromEMail
		,attach_file_location == attach_file_location
		,attach_file_list == attach_file_name
		,bThrowExc == bThrowExc
		);
end;

