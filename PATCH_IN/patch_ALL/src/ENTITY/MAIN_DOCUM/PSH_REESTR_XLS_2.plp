/*-----------------------------------------------------------------------------------------------------------------------*/						
				[EXCEL].Open_Sheet('Безналичные РУБЛЬ');
				[EXCEL].Visible;
				[EXCEL].Release;
				
			end if;
			
			[EXCEL].Exec_Script(V_DEST);	
		end if;	
  end if;
end;
end;
end;
end;
