class HOOK_BANK;

@this(create_on_start:=true)
@name('РКО. Получение реквизитов клиента для бизнес-операции')
@tag('COPIED')
method RKO_GET_REQ_CL_1 is
pragma INCLUDE(::[SYSTEM].[PRODUCTS_DBO]);
PRAGMA INCLUDE(::[DEBUG_TRIGGER].[MACRO_LIB]);

RKO_GET_REQ_CL_1 (
	@name('Договор')                  P_RKO      in [RKO_CURR_REF],
	@name('Тип счета')                P_TYPE_ACC in [TIP_ACC_REF],
	@name('Дополнительные параметры') P_ADDS     in [STRING_32000] default null
) return [REQ_CLIENT] is

execute is
v_type_acc_cod [TIP_ACC].[COD]%type;
ret_req_cl [REQ_CLIENT];
/* --29/01/2026
v0 number; 
v12 [ACCNUM]; 
v11 varchar2;
*/ --29/01/2026 
v_text		memo;
begin
	v_type_acc_cod:=P_TYPE_ACC.[COD];
	&debug(P_RKO%class||'.'||P_RKO%id||' P_TYPE_ACC='||v_type_acc_cod||', P_ADDS = '||P_ADDS||' this='||this%class||'.'||this%id, 0)
	
	/* --29/01/2026
	if v_type_acc_cod='СЧЕТ_КОМИССИИ_РКО' then --Башкиров В.Г. 10.04.2024 тянем с "Удержание разовой комиссии (расширение)"
		&debug(utils.call_stack,dp2)
		if InStr(utils.call_stack,'IBS.Z$MAIN_DOCUM_PSH_COMMIS_GT.PSH_COMMIS_GT_EXECUTE')>0 then -- 13-CR,10-LF
			&debug('PSH_COMMIS_GT.gReqClient_0  ='||::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_0  ,dp2)
			&debug('PSH_COMMIS_GT.gReqClient_1_1='||::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_1_1,dp2)
			&debug('PSH_COMMIS_GT.gReqClient_1_2='||::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_1_2,dp2)
			&debug('PSH_COMMIS_GT.gReqClient_2_1='||::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_2_1,dp2)
			&debug('PSH_COMMIS_GT.gReqClient_2_2='||::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_2_2,dp2)

			if ::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_1_2 is not null then
				ret_req_cl:=null;
				ret_req_cl.[0]     := ::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_0;
				ret_req_cl.[1].[1] := ::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_1_1;
				ret_req_cl.[1].[2] := ::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_1_2;
				ret_req_cl.[2].[1] := ::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_2_1;
				ret_req_cl.[2].[2] := ::[MAIN_DOCUM].[PSH_COMMIS_GT].gReqClient_2_2;
			end if;
		end if;
	end if;*/ --29/01/2026
		
	-->> PSH VRI 18/12/2025 для Prepaid
	if v_type_acc_cod='PSH_PREP_CL_ACC' then
		ret_req_cl.[0] := 1; 
		ret_req_cl.[1].[2] := ::[RUNTIME].[STR].get_num_par(P_ADDS, 'PSH_PREPAID_ACCOUNT');
	elsif v_type_acc_cod='PSH_PREP_CL_ACC_NEW' then
		ret_req_cl.[0] := 1; 
		ret_req_cl.[1].[2] := ::[RUNTIME].[STR].get_num_par(P_ADDS, 'PSH_PREPAID_ACCOUNT_NEW');
	--<< PSH VRI 18/12/2025 для Prepaid
	end if;
	
	-->> PSH VRI 12/02/2026 для СБП
	if v_type_acc_cod='PSH_SBP_CL_ACC' then
		ret_req_cl.[0] := 1; 
		ret_req_cl.[1].[2] := ::[RUNTIME].[STR].get_num_par(P_ADDS, 'PSH_SBP_CL_ACC');
	elsif v_type_acc_cod='PSH_SBP_NZR_ACC' then
		ret_req_cl.[0] := 1; 
		ret_req_cl.[1].[2] := ::[RUNTIME].[STR].get_num_par(P_ADDS, 'PSH_SBP_NZR_ACC');
	end if;
	--<< PSH VRI 12/02/2026 для СБП	

	-->> PSH VRI 17/02/2026 для MoneyTransfer
	if v_type_acc_cod='PSH_MTR_ACC_PL' then
		ret_req_cl.[0] := 1; 
		ret_req_cl.[1].[2] := ::[RUNTIME].[STR].get_num_par(P_ADDS, 'PSH_MTR_ACC_PL');
		v_text := ::[RUNTIME].[STR].get_str_par(P_ADDS, 'PSH_MTR_PLAT');
		if v_text is not null then
			ret_req_cl.[2].[2] := ret_req_cl.[1].[2].[CLIENT_V].[NAME] || v_text;
		end if;		
	elsif v_type_acc_cod='PSH_MTR_ACC_POL' then
		if ::[RUNTIME].[STR].get_num_par(P_ADDS, 'PSH_MTR_BIK_POL') = ::[SYSTEM].[VARIABLES].OurBank.[BIC] then
			ret_req_cl.[0] := 1; 
			for (select ac(ac obj)
				in ::[AC_FIN] all
				where ac.[MAIN_V_ID] = ::[RUNTIME].[STR].get_str_par(P_ADDS, 'PSH_MTR_ACC_POL')
					and ac.[DATE_CLOSE] is null
					fetch 1
				)
			loop
				ret_req_cl.[1].[2] := ac.obj;	
			end loop;
		else
			ret_req_cl.[0] := 2;
			ret_req_cl.[2].[1] := ::[RUNTIME].[STR].get_str_par(P_ADDS, 'PSH_MTR_ACC_POL');
			ret_req_cl.[2].[INN] := ::[RUNTIME].[STR].get_str_par(P_ADDS, 'PSH_MTR_INN_POL');
			ret_req_cl.[2].[2] := ::[RUNTIME].[STR].get_str_par(P_ADDS, 'PSH_MTR_POL');
			ret_req_cl.[2].[PART] := ::[CL_PART]([CODE] = '0020000000');
			for (select bnk(bnk obj) 
				in ::[CL_BANK_N] all
				where bnk.[BIC] = ::[RUNTIME].[STR].get_num_par(P_ADDS, 'PSH_MTR_BIK_POL')
					and bnk.[ACTIVE]
					fetch 1
				)
			loop
				ret_req_cl.[2].[3] := bnk.obj; 
			end loop;
		end if;
	end if;
	--<< PSH VRI 17/02/2026 для MoneyTransfer	


	/* --29/01/2026
	v0:=ret_req_cl.[0]; 
	v11:=ret_req_cl.[1].[1].[NAME]; 
	v12:=ret_req_cl.[1].[2].[MAIN_V_ID]; 
	&debug('<ret_req_cl.[0]='||v0||' Счет Клиента:'||v12||' Клиент:'||v11, 0)*/ --29/01/2026
	return ret_req_cl;
end;
end;
end;
