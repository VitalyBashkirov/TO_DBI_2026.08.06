/*************************************************************
 NGA Функция возвращает всех учредителей организации с %% через ;
**************************************************************/
procedure PSB_Get_FOUNDERS(p_cl [CL_CORP], p_used_length in integer, p_founders out [MEMO_32767], p_err out boolean, p_founder_counter out integer) is
	available_length integer := 32500 - p_used_length;
	adding_str [MEMO_32767];
begin
	for
	(
		select fonder
		(
			fonder.[FOUNDER].[NAME]: 	f_name,
		    fonder.percent         :    per 	
		)
	in p_cl.[REGISTER].[FOUNDERS]  order by 2 desc,1
	)
	loop
		--adding_str := to_char(p_founder_counter)||'. '||fonder.f_name||','||chr(13);
		adding_str := fonder.f_name||' '||fonder.per||'%; ';
		if length(adding_str) > available_length then
			p_founders := substr(rtrim(p_founders),1,length(p_founders)-2);
			p_err := true;
			return;
		else
			available_length := available_length - length(adding_str);
			--p_founders := p_founders||to_char(p_founder_counter)||'. '||fonder.f_name||','||chr(13);
		end if;
		p_founders := p_founders || adding_str;
	end loop;
	
	p_founders := substr(rtrim(p_founders),1,length(p_founders)-2);
end;

/**********************************************************
--Дианков А.В. 29.03.2016 Была ли смена документов клиента?
/*********************************************************/
--Дианков А.В. 29.03.2016 Была ли смена документов клиента?
public function CH_DOC(CL ref [CLIENT]) return string is 
begin
	
	for ( select x(x)
		  in ::[CL_HIST] all
		  where x.[CLIENT_REF] = CL
			  AND x.[QUAL] = 'DOC.NUM'
			  AND x.[VALUE] is not null
	) loop
		return '1';
	end loop;
	return '0';
end;


/********************************************************
 Возвращает всех должностных лиц из массива ALL_BOSS
 (ФИО, должность, паспортные данные, дата рождения, адрес)
*********************************************************/
procedure get_all_boss(p_cl in [CL_CORP], p_used_length in integer, p_bosses out [MEMO_32767], p_err out boolean, p_boss_counter out integer) is
	available_length integer := 32500 - p_used_length;
	adding_str [MEMO_32767];
begin
	p_err := false;
	p_bosses := '';
	p_boss_counter := 0;
	for
	(
		select dolg
		(
			dolg.[RANGE].[VALUE]: 	d_range,
			dolg.[FASE].[NAME]:		d_name
		)
	in p_cl.[ALL_BOSS]	
	where dolg.[FASE] is not null and
		  nvl(dolg.[WORK_BEGIN],op_dat) <= op_dat and
		  nvl(dolg.[WORK_END],op_dat) >= op_dat
	)
	loop
		adding_str := rtrim(dolg.d_range || ' ' || dolg.d_name) || chr(13);
		if length(adding_str)>available_length then
			p_err := true;
			return;
		else
			p_bosses := p_bosses || adding_str;
			available_length := available_length - length(adding_str);
			p_boss_counter := p_boss_counter+1;
		end if;
	end loop;
end;


/**************************************************************
 возвращает строку, содержащую все контакты типа contact_type
 и принадлежности contact_private
***************************************************************/
public function GetContacts(cont_arr [CONTACTS_ARR], contact_type string) return varchar2(1000) is 
str varchar2(1000);
begin
	str := '';
	if contact_type is not null  then
	-- optimaze
		for
		(
			select res
			(
				res.[PRIVATE].[VALUE]: 	c_priv,
				res.[TYPE].[VALUE]:		c_val,
				res.[NUMB]:				c_numb
			)
		in cont_arr
		where res.[ACTIV]=true and res.[NUMB] is not null and res.[TYPE].[CODE] = contact_type and (res.[PRIVATE].[CODE] in ('1', '2', '3','SMS','ADD','CONNECT','REAL_LIVE','REGISTRATION') or res.[PRIVATE] is null) order by res.[PRIVATE].[CODE]
		)	
		loop
			if InStr(Upper(res.c_priv),Upper(res.c_val))>0 then
		  		str := str||LTRIM(res.c_priv||' '||res.c_numb||NL$);
			elsif InStr(Upper(res.c_val),Upper(res.c_priv))>0 then
		  		str := str||LTRIM(res.c_val||' '||res.c_numb||NL$);
			else
		  		str := str||LTRIM(res.c_priv||' '||res.c_val||' '||res.c_numb||NL$);
			end if;
		end loop;
	else
		return '';
	end if;
	return str;
end;

/*******************************************
 Функция возвращает сведения о документах,
 подтверждающих право проживания в РФ
********************************************/
function Get_Visa(p_cl [CL_PRIV], p_date date) return varchar2(32000)
is
	str varchar2(32000) := '';
begin
	-- optimaze
	for
	(
		select v_visa
		(
			v_visa.[TYPE].[FULL_NAME]: 	v_name,
			v_visa.[SER]:				v_ser,
			v_visa.[NUM]:				v_num,			
			v_visa.[DATE]:				v_date,
			v_visa.[DATE_END]:			v_date_end,
			v_visa.[WHO]:				v_who
		)
	in p_cl.[DOC_ARR]
	where v_visa.[TYPE].[Residence_right]  and
		  nvl(v_visa.[DATE],p_date) <= p_date and
		  nvl(v_visa.[DATE_END],p_date) >= p_date	
	)	
	loop
		-- VISA инфо
		str :=  str||
				nvl(v_visa.v_name, '')||
				' Серия: '||nvl(v_visa.v_ser,'-')||' №: '||nvl(v_visa.v_num,'-')||
				' Действует с '||nvl(to_char(v_visa.v_date,'dd.mm.rr'),'-/-/--')||' по '||nvl(to_char(v_visa.v_date_end,'dd.mm.rr'),'-/-/--')||
				' Выдан: '||ltrim(rtrim(v_visa.v_who))
				||NL$;	
	end loop;	
	
	return str;
end;

/*******************************************
 Функция возвращает сведения о месте работы
********************************************/
function Get_Work(p_cl [CL_PRIV], p_date date) return varchar2(32000)
is
	str varchar2(32000) := '';
	op_dat [Date];
begin
	op_dat := nvl(p_date,[System].[Op_date]);
	for
		(
			select rabota
				( nvl(rabota.[CORP_R].[NAME], rabota.[CORP])	:vCorp
				, rabota.[RANGE]								:vRange
				)
			in p_cl.[WORK_ACTIVITY]
			where
				    (nvl(rabota.[START_DATE],op_dat) <= op_dat )
				and	(nvl(rabota.[END_DATE],op_dat) >= op_dat )
				and (rabota.[CORP_R] is not null or rabota.[CORP] is not null or rabota.[RANGE] is not null)
			order by nvl(rabota.[START_DATE],op_dat) desc
		)
	loop
		str := str||trim(rabota.vCorp||' '||rabota.vRange)||NL$;
	end loop;
	str := substr(str,1,length(str)-2);	
	return str;
end;

/**********************************************************
 Функция возвращает сведения обо всех минграционных картах
**********************************************************/
function Get_Migration_Card(p_cl [CL_PRIV], p_date date) return varchar2(32000) is
str varchar2(32000);
begin
	str :='';
	for (
		select x(x.[CARD_NUM]   :CARD_NUM
				,x.[DATE_BEG]   :DATE_BEG
				,x.[DATE_END]   :DATE_END
				,x.[CARD_SERIA] :CARD_SER)
		in p_cl.[MIGR_CARD]
		where	nvl(x.[DATE_BEG],p_date) <= p_date
			and	nvl(x.[DATE_END],p_date) >= p_date
		)
	loop
		--NGA16/10/2015 str := str|| 'Номер карты: '||nvl(x.[CARD_NUM], '-') ||' Действует с '||nvl(to_char(x.[DATE_BEG],'dd.mm.rr'), '-/-/--')||' по '||nvl(to_char(x.[DATE_END],'dd.mm.rr'), '-/-/--')||NL$;
		str := str ||'Серия карты: ' ||nvl(x.[CARD_SER], '-') ||
		             ' Номер карты: '||nvl(x.[CARD_NUM], '-') ||
		             ' Действует с ' ||nvl(to_char(x.[DATE_BEG],'dd.mm.rr'), '-/-/--')||
		             ' по '||nvl(to_char(x.[DATE_END],'dd.mm.rr'), '-/-/--')||NL$;
	end loop;	
	return str;	                        	
end;

/**********************************************************
 Функция возвращает ссылку минграционной карты
**********************************************************/
--Функция возвращает ссылку минграционной карты
public function Ref_Migration_Card(p_cl [CL_PRIV], p_date date) return ref [MIGRATION_CARD] is 
mig ref [MIGRATION_CARD]:=null;
begin
	
	for (
		select x(x :id)
		in p_cl.[MIGR_CARD]
		where	nvl(x.[DATE_BEG],p_date) <= p_date
			and	nvl(x.[DATE_END],p_date) >= p_date			
		)
	loop
		mig:=x.id;	
	end loop;	
	return mig;	                        	
end;

/**********************************************************
Функция возвращает паспортные данные клиента - физ лица.
**********************************************************/
public function Get_passport(p_cl [CL_PRIV]) return string is 
doc [CERTIFICATE];
begin
	null;
	doc := p_cl.[DOC];
	if doc.[type] is not null then
	 	return doc.[type].[NAME]||
	 		   bool_char(doc.[SER] is null, null, ' '||doc.[SER])||
 			   bool_char(doc.[NUM] is null, null, ' №'||doc.[NUM])||
			   bool_char(doc.[date]is null, null, '  выдан '||to_char(doc.[date],'dd/mm/yyyy'))||
			   bool_char(doc.[WHO] is null, null, ' '||doc.[WHO])||
			   bool_char(doc.[DEPART_CODE] is null, null, ' код подр. '||doc.[DEPART_CODE]);
	elsif doc.[WHO] is not null then
		return doc.[WHO];
	end if;
end;


/**********************************************************
Функция возвращает адрес строкой
**********************************************************/
--Функция возвращает адрес строкой
public Function GetAddress(	cl_adresses		[CLIENT].[ADDRESSES]%type
						,AddRecv varchar2(100) default null
						,AddrCode varchar2(20) default null
			)return varchar2(1000) is 
addr			varchar2(1000);
addr_ref		ref [PERSONAL_ADDRESS];
begin
	AddrCode := upper(AddrCode);
	begin
		select a(a)
			in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all : t ) all
			where	a%collection = cl_adresses
					and t = a.[TYPE]
					and t.[KOD] = AddrCode
					and rownum <= 1
			into addr_ref;
	exception
		when NO_DATA_FOUND then
			if AddrCode is null then   -- ищем любой адрес
				begin
					select a(a)
						in ::[PERSONAL_ADDRESS], (::[ADDRESS_TYPE] all: t) all
						where	a%collection = cl_adresses
								and t = a.[TYPE]
								and rownum <= 1
						into addr_ref;
				exception when NO_DATA_FOUND then
					null;
				end;
			end if;
	end;
	addr := VIEWFUN.GetAddressByRef(	a		== addr_ref,
										AddRecv	== AddRecv
										--,p_struct == 2
										);
	return addr;
end;

