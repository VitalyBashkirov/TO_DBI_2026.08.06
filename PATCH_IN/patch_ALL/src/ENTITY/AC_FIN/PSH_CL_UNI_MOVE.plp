class AC_FIN;

@import_plsql(true)
@name('[ПСБ] Универсальная выписка по счету')
@tag('COPIED')
method PSH_CL_UNI_MOVE is

@name('Счет')                       public V_ACC               [AC_FIN_REF];
@name('Дата начала периода')        public V_DATE_S            [DATE];
@name('Дата окончания периода')     public V_DATE_E            [DATE];
@name('Дополнительно выводить')     public V_ADD_TBL  table of [GRID_TEMPLATE];
@name('Маска счета корреспондента') public V_COR_MASK          [ACCNUM];
public type GRID_ARR is table of [GRID_TEMPLATE];
-- входящие на утро и разноска в этом числе
public diasDate date:=to_date('06052017','ddmmyyyy'); -- дата разнесения

-- global data
iBorderAll			integer;			-- Идентификатор для окантовок ячеек
iFont				integer;			-- Идентификатор для шрифта
numFmt 				integer;		    -- Формат числа
numFmt0				integer;		
--
NotEmpty			boolean:=false;
--
bShowNazn			boolean:=false;			-- Назначение
bShowN				boolean:=false;			-- В нац покрытии ( эквиваленте )
bShowSaldo			boolean:=false;			--
bShowDayItog		boolean:=false;			--
bShowRate			boolean:=false;			--
bShowExtAcc			boolean:=false;			--
bShowExtBIC			boolean:=false;			--
bShowExtBank		boolean:=false;			--
bShowExtINN			boolean:=false;			--
bShowExtName		boolean:=false;			--
bShowNoPereoc		boolean:=false;			--
bShowOtv			boolean:=false;			--
bShowExtCorr		boolean:=false;			--
bShowNoItog			boolean:=false;			--
sCorrAccMask        varchar(25):=null;

nOrd				integer:=1;
haveOborot      	boolean;
haveDiasOborot     	boolean;
nReportFistRow 		number;
diasAcc boolean;
svertkaDoc ref [MAIN_DOCUM];
diasOutRest [SUMMA];
---- for acc
acf ref [AC_FIN];
dateBeg date;
dateEnd date;
bMainVal			boolean;			-- Признак основной валюты счета (true - у счета код валюты совпадается с основной системной валютой, false - иначе)
vVidAccShort		varchar2(1);		-- Код вида счета (А - активный, П - пассивный)
vVidAcc				varchar2;			-- Вид счета (активный/пассивный)

nTableFirstRow     integer;
tableMaxCol		integer;
--
nSaldoIn		number;		-- Остаток по счету на начало периода
nSaldoOut		number;		-- Остаток по счету на конец периода
nSaldoNIn		number;		-- Остаток по счету на начало
nSaldoNOut		number;		-- Остаток по счету на конец
--
nSumDt			number;		-- Обороты по дебету
nSumKt			number;		-- Обороты по кредиту
nSumDtN			number;		-- Обороты по дебету экв
nSumKtN			number;		-- Обороты по кредиту экв
nCounter		number;		-- Количество операций
nRow 			number;
--
dateLast	   date;
rVal ref [FT_MONEY];
arcMove [AC_FIN].[ARC_MOVE]%type;
--ref [RECORDS];  -- выписка
sDepartment varchar(1000);
sFilial varchar(1000);
sOtv   varchar(1000);
accCode [AC_FIN].[MAIN_V_ID]%type;
accName [AC_FIN].[NAME]%type;
cliName [CLIENT].[NAME]%type;
--
procedure xlWriteH(row integer,col integer,val varchar) as
begin
	::[OOXML].[API_XL].WRITE(row,col, val, true, false, 10, 'Arial','MC',true);
end;
--
procedure xlWrite(row integer,col integer,val varchar) as
begin
	::[OOXML].[API_XL].WRITE(row,col, val, false, false, 10, 'Arial');
end;
--
procedure xlWriteNum(row integer,col integer,val number) as
begin
    ::[OOXML].[API_XL].cell(row, col, val, numFmt, iFont );
end;
--
procedure xlWriteText(row integer,col integer,val varchar) as
begin
	::[OOXML].[API_XL].WRITE(row,col, val, false, false, 10, 'Arial','L',true);
	--::[OOXML].[API_XL].cell_v_data(row,col, val, true);
end;
--##############################################################################################################
-- заполняем опции
--##############################################################################################################
public function makeGrid(gridTbl GRID_ARR) return GRID_ARR as 
line   [GRID_TEMPLATE];
begin
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+Назначение платежа';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+Эквивалент';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+Сальдо';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='Итоги по дням';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+Курс';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+Внешний счет';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+БИК банка кореспондента';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+Наименование банка кореспондента';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+ИНН кореспондента';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='Исключить переоценку';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='Ответ.исполнитель';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+Кор.счет банка корреспондента';
	gridTbl(gridTbl.count+1):=line;
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='+Наименовние корреспондента';
	gridTbl(gridTbl.count+1):=line;
	--
	--
    line.[BOOL_1]:=false;
    line.[FIELD_1]:='Без итогов';
	gridTbl(gridTbl.count+1):=line;
	return gridTbl;
end ;
--##############################################################################################################
-- начальные значения для Excel и общие параметры выписок
--##############################################################################################################
public procedure initRep(gridTbl GRID_ARR,vDateS date,vDateE date,vCorMask varchar,vNotEmpty boolean default false) is 
	nCol integer;
begin
	notEmpty:=vNotEmpty;
	-- Получение идентификатора для окантовок ячеек
	iBorderAll := ::[OOXML].[API_XL].get_border	( p_top 	== 'thin', p_bottom	== 'thin', p_left 	== 'thin', p_right 	== 'thin');
	-- Получение идентификатора шрифта
	iFont := ::[OOXML].[API_XL].get_font( p_name		== 'Arial', p_fontsize	== 10	);
	-- Формат чисел
	numFmt:=::[OOXML].[API_XL].get_numFmt('#,##0.00');
	numFmt0:=::[OOXML].[API_XL].get_numFmt('#0');
	--
	bShowNazn		:= gridTbl(1).[BOOL_1];			-- Назначение
	bShowN	 		:= gridTbl(2).[BOOL_1];			-- В нац покрытии ( эквиваленте )
	bShowSaldo 		:= gridTbl(3).[BOOL_1];         -- Остаток
	bShowDayItog	:= gridTbl(4).[BOOL_1];			-- Итоги по дням
	bShowRate		:= gridTbl(5).[BOOL_1];			-- Курс
	bShowExtAcc		:= gridTbl(6).[BOOL_1];			-- Внешний счет
	bShowExtBIC		:= gridTbl(7).[BOOL_1];			-- Внешний БИК
	bShowExtBAnk	:= gridTbl(8).[BOOL_1];			-- Внешний Бинк(Наименование)
	bShowExtINN		:= gridTbl(9).[BOOL_1];			-- Внешний ИНН
	bShowNoPereoc	:= gridTbl(10).[BOOL_1];		-- Исключить переоценку
	bShowOtv		:= gridTbl(11).[BOOL_1];		-- Ответственный исполнитель
	bShowExtCorr	:= gridTbl(12).[BOOL_1];		-- Коррсчет банка корреспондента
	bShowExtName	:= gridTbl(13).[BOOL_1];		-- Наименовние корреспондента
	bShowNoItog		:= gridTbl(14).[BOOL_1];		-- Без итогового сальдо и вх остатков
	
	sCorrAccMAsk  := trim(vCorMask);
	if sCorrAccMask is not null then
	   sCorrAccMask:=replace(sCorrAccMask,'*','%');
	   if sCorrAccMask='%' then sCorrAccMask:=null; end if;
	end if;
    -- даты
   	dateBeg:=vDateS;
	dateEnd:=vDateE;
	-- первая строка отчета
	nReportFistRow	:= 1;
	--  щирина колонок
	::[OOXML].[API_XL].SET_COLUMN_WIDTH(10,2,2);
	::[OOXML].[API_XL].SET_COLUMN_WIDTH(10,4,4);
	::[OOXML].[API_XL].SET_COLUMN_WIDTH(20,5,5);
	nCol:=5;
	-- доп опции
	-- внешний счет
	if bSHowExtAcc then
    	nCol:=nCol+1;
   		::[OOXML].[API_XL].SET_COLUMN_WIDTH(20,nCol,nCol);
	end if;
	if bSHowExtBIC then
	    nCol:=nCol+1;
   		::[OOXML].[API_XL].SET_COLUMN_WIDTH(10,nCol,nCol);
	end if;
	if bSHowExtBANK then
    	nCol:=nCol+1;
   		::[OOXML].[API_XL].SET_COLUMN_WIDTH(22,nCol,nCol);
	end if;
	if bSHowExtCorr then
	    nCol:=nCol+1;
   		::[OOXML].[API_XL].SET_COLUMN_WIDTH(20,nCol,nCol);
	end if;
	if bSHowExtINN then
	    nCol:=nCol+1;
	   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(10,nCol,nCol);
	end if;
	if bSHowExtName then
	    nCol:=nCol+1;
	   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(30,nCol,nCol);
	end if;
	-- заголовок обороты
	nCol:=nCol+1;
	::[OOXML].[API_XL].SET_COLUMN_WIDTH(18,nCol,nCol+1);
	nCol:=nCol+1;
	-- остатки
	if bSHowSaldo then
	    nCol:=nCol+1;
	   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(18,nCol,nCol);
	end if;
	--  в нац покрытии
	if bShowN then
    	nCol:=nCol+1;
   		::[OOXML].[API_XL].SET_COLUMN_WIDTH(18,nCol,nCol+1);
    	nCol:=nCol+1;
		if bSHowSaldo then
	       	nCol:=nCol+1;
			::[OOXML].[API_XL].SET_COLUMN_WIDTH(18,nCol,nCol);
    	end if;
	end if;
	if bSHowRate then
    	nCol:=nCol+1;
	end if;
	if bSHowNazn then
   		nCol:=nCol+1;
	   ::[OOXML].[API_XL].SET_COLUMN_WIDTH(150,nCol,nCol);  -- 200
	end if;
--
end;
--##############################################################################################################
-- Добавление разрыва страницы после указанной строки
--##############################################################################################################
public procedure pageBreak is 
begin
	if nCounter = 0 and notEmpty then  -- удаляем все что навставляли
		return;
	end if;
	::[OOXML].[API_XL].PutPageBreak( nRow );
end;
--##############################################################################################################
-- заключительные действия
--##############################################################################################################
public procedure finalRep is 
begin
	--Установка области печати
	::[OOXML].[API_XL].SetPrintArea(1, 1, nRow + 3, tableMaxCol, 1);
	-- Установка ориентации страницы  Значения: 1 - Альбомная, 2 - Книжная.
	if bShowNazn then   -- если с Назначением - поворачиваем
		::[OOXML].[API_XL].set_orientation(1);
	end if;
	--Вписывание данных по ширине страницы
	::[OOXML].[API_XL].fit_in_page_width(1);
end;
--##############################################################################################################
-- Выбирается информация по счету
--##############################################################################################################
procedure getAccountData is
tmpDate date;
begin
    diasOutRest:=0;
	diasAcc:=false;
	for	(	select x( d.[CODE]												: C_DEP_CODE
					, d.[NAME]												: C_DEP_NAME
					, x.[FILIAL].[SHORTLABEL]								: C_FIL_NAME
					, x.[FILIAL]											: C_FILIAL
					, x.[MAIN_V_ID]											: C_MAIN_V_ID
					, x.[NAME]												: C_ACC_NAME
					, x.[CLIENT_V].[NAME]									: C_CLI_NAME
					, x.[FINTOOL].[NAME]									: C_VAL_NAME
					, x.[FINTOOL].[CUR_ATTR].[ENTIER]						: C_VAL_SHORT_NAME
					, x.[FINTOOL]											: C_VAL
					, x.[ARC_MOVE]											: C_ARC_MOVE
					, x.[OTV].[NAME]										: C_OTV
					, decode(x.[VID].[CODE], 'А', 'актив', 'пассив')		: C_VID_AP
					)
				in	::[AC_FIN]
				,(	::[DEPART]	:d )
			where	x = acf
				and	nvl(x.[DEPART], x.[OTV]->(true)[DEPART]) = d
		)
	loop
		vVidAcc := x.C_VID_AP;
		rVal    := x.C_VAL;
		arcMove := x.C_ARC_MOVE;
		-- Проверяется валюта счета: на совпадение с основной валютой, заданной в системе
		if rVAL = ::[SYSTEM].[SYS_MAIN_VAL] then
			bMainVal := true;
		else
			bMainVal := false;
		end if;
		sDepartment:=x.C_DEP_CODE||'  '||x.C_DEP_NAME;		-- Наименование и номер  подразделения Банка
		--sFilial:= x.C_FIL_NAME||', '||::[REPS_DATA].[LIB_CLIENT].GetBranchInfo(x.C_FILIAL, dateEnd + 1).f_CORP_ADDR; -- Наименование Банка, Место расположения Банка
		sFilial:= x.C_FIL_NAME; -- Наименование Банка
		sOtv  := x.C_OTV;

		accCode := x.C_MAIN_V_ID;        -- Номер лицевого счета
		accName := x.C_ACC_NAME;         -- Наименование
		cliName := x.C_CLI_NAME;	 	 -- Наименование клиента
		dateLast:=f.date_last('В'||to_char(arcMove), dateBeg);
		-- Вычисляется остатки по счету за дату начала периода, на дату окончания периода   ВАЛЮТА СЧЕТ = НОМИНАЛ
		--
		-- 'ВXXXXXXXNM'  выписка с идентификатором XXXXXX  ( arc_move )
		--  N=С  Сальдо , Д оборот дебета К оборот кредита
		--  M=В  В валюте счета Н - нац покрытие (эквивалент)
	end loop;
    --debug_pipe(' arcMove='||to_char(arcMove)||' dateBeg='||to_char(dateBeg,'dd/mm/yyyy'));
	haveOborot      :=false;
	haveDiasOborot  :=false;
	nSaldoIn 	:= nvl(f.a('В'||to_char(arcMove)||'СВ', dateBeg),0);
	nSaldoNIn	:= nvl(f.a('В'||to_char(arcMove)||'СН', dateBeg),0);
	-- test
	--debug_pipe('ЦФТ saldoIn='||nSaldoIn||' nSaldoNIn='||nSaldoNIn);
	if vVidAcc = 'актив' then
		vVidAccShort := 'А';
		-- Остаток уже со знаком
		--nSaldoIn:=-nSaldoIn;
		--nSaldoNIn:=-nSaldoNIn;
	else
		vVidAccShort := 'П';
	end if;
    nSaldoOut:=nSaldoIn;
    nSaldoNOut:=nSaldoNIn;
    --
	nSumDt=nSumKt=nSumDtN=nSumKtN:=0;
	nCounter:=0;
	
    --debug_pipe(' before dias in saldo='||nSaldoIn||' nt='||nSaldoNIn||' dateBeg='||to_char(dateBeg,'dd/mm/yyyy'));
    --debug_pipe(' before dias out saldo='||nSaldoOut||' nt='||nSaldoNOut);
    -- DIAS
    --return;
	-- проверяем нет ли чего по =====   диасофту ======================================================================
	-- если дата начала позднее даты перехода - то ничего и не проверяем
    --debug_pipe(' ===> saldo='||nSaldoIn||' nt='||nSaldoNIn);
end;
--##############################################################################################################
-- Начальные данные и заголовок таблицы
--##############################################################################################################
procedure draw_header is
	nCol 			number;
begin
xlWrite(nReportFistRow,	1,	sDepartment);	-- Наименование и номер  подразделения Банка
xlWrite(nReportFistRow+1,	1,	sFilial); 		-- Наименование Банка, Место расположения Банка
xlWrite(nReportFistRow+2,   1,	to_char(sysdate, 'DD.MM.YYYY HH24:MI'));	-- Системная дата и время запуска выписки
--::[OOXML].[API_XL].merge(nReportFistRow,1,nReportFistRow,8);
--::[OOXML].[API_XL].merge(nReportFistRow+1,1,nReportFistRow+1,8);
--::[OOXML].[API_XL].merge(nReportFistRow+2,1,nReportFistRow+2,8);

xlWrite(nReportFistRow+4,	3,	'Движение по счету  '||accCode||'('||vVidAccShort||')');      -- Номер лицевого счета
--::[OOXML].[API_XL].merge(nReportFistRow+4,3,nReportFistRow+4,7);
xlWrite(nReportFistRow+5,	3,	'владельца:'||cliName);				-- Наименование клиента
--::[OOXML].[API_XL].merge(nReportFistRow+5,3,nReportFistRow+5,7);
xlWrite(nReportFistRow+6,	3,	'За период с '||to_char(dateBeg, 'DD.MM.YYYY')||' по '||to_char(dateEnd, 'DD.MM.YYYY'));			-- Период, за который рассчитывается выписки
--::[OOXML].[API_XL].merge(nReportFistRow+6,3,nReportFistRow+6,7);

-- Наименование счета и валюта		
xlWrite(nReportFistRow+8,	1,	accName);
--::[OOXML].[API_XL].merge(nReportFistRow+8,1,nReportFistRow+8,5);
xlWrite(nReportFistRow+8,	6,	'Валюта');
xlWrite(nReportFistRow+8,	7,	rVal.[NAME]);
		
nTableFirstRow:=nReportFistRow+10;
-- ========================== собственно таблица ==========================================================================
xlWriteH(nTableFirstRow,	1,	'№ п/п');
xlWriteH(nTableFirstRow,	2,	'Дата проводки');
xlWriteH(nTableFirstRow,	3,	'РО');
xlWriteH(nTableFirstRow,	4,	'Номер документа');
xlWriteH(nTableFirstRow,	5,	'Счет корреспондента');
nCol:=5;
-- доп опции
-- внешний счет
if bSHowExtAcc then
    nCol:=nCol+1;
    xlWriteH(nTableFirstRow,	nCol,	'Внешний счет');
--   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(20,nCol,nCol);
end if;
if bSHowExtBIC then
    nCol:=nCol+1;
    xlWriteH(nTableFirstRow,	nCol,	'БИК банка корреспондента');
--   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(10,nCol,nCol);
end if;
if bSHowExtBANK then
    nCol:=nCol+1;
    xlWriteH(nTableFirstRow,	nCol,	'Наименование банка корреспондента');
--   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(22,nCol,nCol);
end if;
if bSHowExtCorr then
    nCol:=nCol+1;
    xlWriteH(nTableFirstRow,	nCol,	'Кор.счет банка корреспондента');
--   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(20,nCol,nCol);
end if;
if bSHowExtINN then
    nCol:=nCol+1;
    xlWriteH(nTableFirstRow,	nCol,	'ИНН корреспондента');
--   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(10,nCol,nCol);
end if;
if bSHowExtName then
    nCol:=nCol+1;
    xlWriteH(nTableFirstRow,	nCol,	'Наименование корреспондента');
--   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(30,nCol,nCol);
end if;
-- заголовок обороты
nCol:=nCol+1;
--::[OOXML].[API_XL].SET_COLUMN_WIDTH(18,nCol,nCol+1);
xlWriteH(nTableFirstRow,	nCol,	'Дебет');
nCol:=nCol+1;
xlWriteH(nTableFirstRow,	nCol,	'Кредит');
-- остатки
if bSHowSaldo then
    nCol:=nCol+1;
    xlWriteH(nTableFirstRow,	nCol,	'Остаток');
--   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(18,nCol,nCol);
end if;
--  в нац покрытии
if bShowN then
    nCol:=nCol+1;
	xlWriteH(nTableFirstRow,	nCol,	'Дебет в нац.вал.');
	xlWriteH(nTableFirstRow,	nCol+1,	'Кредит в нац.вал.');
--   	::[OOXML].[API_XL].SET_COLUMN_WIDTH(18,nCol,nCol+1);
    nCol:=nCol+1;
	if bSHowSaldo then
       	nCol:=nCol+1;
	   	xlWriteH(nTableFirstRow,	nCol,	'Остаток в нац.вал.');
--		::[OOXML].[API_XL].SET_COLUMN_WIDTH(18,nCol,nCol);
    end if;
end if;
if bSHowRate then
    nCol:=nCol+1;
    xlWriteH(nTableFirstRow,	nCol,	'Курс');
end if;
if bSHowNazn then
   nCol:=nCol+1;
   xlWriteH(nTableFirstRow,	nCol,	'Назначение платежа');
--   ::[OOXML].[API_XL].SET_COLUMN_WIDTH(150,nCol,nCol);  -- 200
end if;
tableMaxCol:=nCol;
--
if not bShowNoItog then
-- ============================= первая строка с вход данными =====================================
xlWrite(nTableFirstRow+1,	2,	to_char(dateLast, 'dd.mm.yyyy'));   -- дата последней операции за перд период
xlWrite(nTableFirstRow+1,	3,	'Входящее сальдо');
--::[OOXML].[API_XL].merge(nTableFirstRow+1,3,nTableFirstRow+1,5);
nCol:=5;
-- внешний счет и прочие его данные
if bSHowExtAcc then
   nCol:=nCol+1;
   --xlwrite(nTableFirstRow+1,nCol,'EXTACC');
end if;
if bSHowExtBic then
   nCol:=nCol+1;
end if;
if bSHowExtBank then
   nCol:=nCol+1;
end if;
if bSHowExtCorr then
   nCol:=nCol+1;
end if;
if bSHowExtInn then
   nCol:=nCol+1;
   --xlwrite(nTableFirstRow+1,nCol,'INN');
end if;
if bSHowExtName then
   nCol:=nCol+1;
end if;
-- взодящие остатки /сальдо/
nCol:=nCol+1;
if vVidAccShort = 'А' then
   xlWriteNum(nTableFirstRow+1, nCol, -nSaldoIn);
else
   xlWriteNum(nTableFirstRow+1, nCol+1, nSaldoIn);
end if;
nCol:=nCol+1;
if bShowSaldo then  -- вход остаток идет в нужной колонке - повторять не будем
	nCol:=nCol+1;
    --xlwrite(nTableFirstRow+1,nCol,'saldo');
end if;
-- вход остатки /сальдо/ в нац покрытии
if bShowN then
    nCol:=nCol+1;
	if vVidAccShort = 'А' then
	   	xlWriteNum(nTableFirstRow+1, nCol, nvl(-nSaldoNIn,0));
	else
	   	xlWriteNum(nTableFirstRow+1, nCol+1, nvl(nSaldoNIn,0));
	end if;
    nCol:=nCol+1;
	if bShowSaldo then  -- вход остаток идет в нужной колонке - повторять не будем
		nCol:=nCol+1;
	end if;
end if;
end if; -- if not bShowNoItog then
--
end;
--##############################################################################################################
-- Итоги
--##############################################################################################################
procedure DRAW_ITOG(soTmp varchar,nRow integer,nSumDtDay [SUMMA],nSumKtDay [SUMMA],nSumDtNDay [SUMMA],nSumKtNDay [SUMMA]) as
nCol integer;
begin
	xlWrite(nRow, 3, 'Итого за '||soTmp);
	--::[OOXML].[API_XL].merge(nRow,3,nRow,5);
	nCol:=5;
	-- Внешние данные
   	if bSHowExtAcc then
       	nCol:=nCol+1;
   	end if;
   	if bSHowExtBic then
       	nCol:=nCol+1;
   	end if;
   	if bSHowExtBank then
       	nCol:=nCol+1;
   	end if;
   	if bSHowExtCorr then
       	nCol:=nCol+1;
   	end if;
   	if bSHowExtInn then
       	nCol:=nCol+1;
   	end if;
   	if bSHowExtName then
       	nCol:=nCol+1;
   	end if;
   	-- обственно итоги
	nCol:=nCol+1;
	xlWriteNum(nRow, nCol, nSumDtDay);
	xlWriteNum(nRow, nCol+1, nSumKtDay);
	nCol:=nCol+1;
	--
	if bShowSaldo then  -- повторяем в итоговой строке
		nCol:=nCol+1;
		/*
		if vVidAccShort = 'А' then
			xlWriteNum(nRow, nCol, -nSaldo );
		else
			xlWriteNum(nRow, nCol, nSaldo );
		end if;
		*/
	end if;
	if bShowN then  -- в нац покрытии
		nCol:=nCol+1;
		xlWriteNum(nRow, nCol, nSumDtNDay);
		xlWriteNum(nRow, nCol+1, nSumKtNDay);
		nCol:=nCol+1;
		if bShowSaldo then
			nCol:=nCol+1;
			/*
			if vVidAccShort = 'А' then
				xlWriteNum(nRow, nCol, -nSaldoN );
			else
				xlWriteNum(nRow, nCol, nSaldoN );
			end if;
			*/
		end if;
	end if;
end;
--##############################################################################################################
-- Обороты ДИАС
--##############################################################################################################
-- Обороты
--##############################################################################################################
procedure DRAW_OBOROT is
    -- в валюте счета - номинал
	nSaldo			number := 0;		-- Текущуй остаток
	nSumDtDay		number := 0;		-- Обороты по дебету за день
	nSumKtDay		number := 0;		-- Обороты по кредиту за день
	--     нац.покрытие - эквивалент
	nSaldoN			number := 0;		
	nSumDtNDay		number := 0;		-- Обороты по дебету за день
	nSumKtNDay		number := 0;		-- Обороты по кредиту за день
	--
	--dLastMove		date;
	soTmp			varchar(100);
	nCol 			number;
	debet           boolean;
	lItog			boolean;
begin
    nSaldo:=nSaldoIn;
    nSaldoN:=nSaldoNIn;
    /*  Афиновская сортировака
    1  Decode(nSortGroup, 2, a.Code, 3, SubStr(a.Code, 1, 5), To_Char(bb.OperDate,'YYYYMMDD')),
    2  trunc(bb.OperDate),
    3  Кред+Деб  ( сначала Кред )
    4  Сумма
    */
    -- нужно пропустить проводку по разноске средств
	--***************************************************************************************
	-- Получение оборотов по счету за период (по выписке)
	--***************************************************************************************
	for	(	select am
					( -- timestamp преобразуется в 2016-08-18 00:00:00.000000000
					--decode(nOrd,2,am.[ACC_CORR].[MAIN_V_ID],am.[STAMP])			: C_ORD
					--decode(nOrd,2,am.[ACC_CORR].[MAIN_V_ID],am.[STAMP])			: C_ORD
					to_char(am.[DATE],'yyyymmdd')||to_char(am.[DT])||to_char(am.[SUMMA],'9999999999999999990.00')    C_ORD
					, am.[DATE]								: C_DATE_MOVE
					, am.[DOC].[VID_DOC].[SHORT_CODE]		: C_TOPER_CODE
					, am.[DOC]								: C_DOCUM
					, am.[DOC].[DOCUMENT_NUM]				: C_DOC_NUM
					, am.[DOC].[NAZN]						: C_NAZN_PL
					, am.[ACC_CORR].[MAIN_V_ID]				: C_ACC_CORR
					, am.[DT]								: C_DT
					, nvl(am.[START_SUM_NAT], 0)			: C_START_SUM_NAT
					, nvl(am.[START_SUM],0)					: C_START_SUM
					, nvl(am.[SUMMA], 0)					: C_SUMMA
					, nvl(am.[SUMMA_NAT], 0)				: C_SUMMA_NAT
					--, rc.[NUMBER_DOC] : RC_NUM_DOC
					-- [MAIN_DOCUM].[KL_KT].[2].[2]
					, am.[DOC].[KL_DT].[2].[1] klAccDt
					, am.[DOC].[KL_DT].[2].[INN] klDtInn
					, am.[DOC].[KL_DT].[2].[2] klDTName
					, am.[DOC].[KL_DT].[2].[3].[BIC] klDtBic
					, am.[DOC].[KL_DT].[2].[3].[NAME] klDtBank
					, am.[DOC].[KL_DT].[2].[3].[KS] klDtKS
					--
					, am.[DOC].[KL_KT].[2].[1] klAccKt
					, am.[DOC].[KL_KT].[2].[INN] klKtInn
					, am.[DOC].[KL_KT].[2].[2] klKtName
					, am.[DOC].[KL_KT].[2].[3].[BIC] klKtBic
					, am.[DOC].[KL_KT].[2].[3].[NAME] klKtBank
					, am.[DOC].[KL_KT].[2].[3].[KS] klKtKS
					, nvl(am.[DOC].[KOD_NAZN_PAY],0):knp
					)
				in	(acf.[ARC_MOVE] :am)
			where	am.[DATE] >= dateBeg
				and	am.[DATE] < dateEnd + 1
				and (sCorrAccMask is null or am.[ACC_CORR].[MAIN_V_ID] like sCorrAccMask)
			 --
             --order by am.[STAMP]  -- в порядке выполения операций
             --order by 1 -- c_ord   комплексная параметрическая сортировка
             order by trunc(am.[DATE]),am.[DT],am.[SUMMA]  -- тоже комплексная но не параметрическая  - так быстрее
		)
	loop
	    --debug_pipe('++'||am.c_ord);
	    /*
	    if trunc(am.C_DATE_MOVE)=diasDate then
	       if am.C_NAZN_PL='Техническая проводка по переносу информации о лицевом счете в новую АБС' then
	       	  continue;
	       end if;
	    end if;
	    */
	    -- документ попадет в свертку если счет есть в списке
	    -- for test 40817810121210000410 NSK
	    -- 47425810020100001316 - оборот по свертке должен браться
	    --  если период начинается позднее  05.05.2017 то документа всертки не будет
	    if svertkaDoc is not null and am.C_DOCUM=svertkaDoc and abs(am.C_SUMMA-diasOutRest)<0.001 then
	    	--debug_pipe('++doc='||svertkaDoc||' sum='||svertkaDoc.[SUM]||' nSaldo='||nSaldo||' rest='||diasOutRest||' obSum='||am.C_SUMMA);
	    	-- сальдо берем первоначальное поэтому документ не берем а оборот учивываем в остатке
   			if debet then  -- Дебет
	    		nSaldo := nSaldo - am.C_SUMMA;
				nSaldoN := nSaldoN - am.C_SUMMA_NAT;
   			else
   				nSaldo := nSaldo + am.C_SUMMA;
				nSaldoN := nSaldoN + am.C_SUMMA_NAT;
			end if;
			continue;
	    end if;
		-- Заполнение итогов за день если отмечено ============================
		if bShowDayItog and soTmp is not null then  --  soTmp null на первом обороте
			lItog:=false;  -- отдельнвй флаг для иниверсальности
		    -- Если из сортировки убрана дата то итогов нет
			if nOrd=2 then
			    null;
			else
				if soTmp <> to_char(am.C_DATE_MOVE,'dd.mm.yyyy') then
					lItog:=true;
				end if;
			end if;
			if lItog then  -- выводим ?
				nRow := nRow + 1;
   		    	DRAW_ITOG(soTmp,nRow,nSumDtDay,nSumKtDay,nSumDtNDay,nSumKtNDay);
				nSumDtDay = nSumDtNDay	= nSumKtDay = nSumKtNDay := 0;
			end if;
		end if;
		-- запоминаем для итогов
	    if nOrd = 2 then
	        soTmp := '?'; -- не реализовано
	    else
			soTmp := to_char(am.C_DATE_MOVE,'dd.mm.yyyy');					--
	    end if;
		--debug_pipe(nCounter||'->'||am.C_ORD);
		--dLastMove := trunc(am.C_DATE_MOVE);
		--if nCounter = 1 and not bMainVal then
			-- Для счетов в валюте отличной от основной определяется курс
		--	::[OOXML].[API_XL].Put(15, 12, 'Курс ЦБ на '||to_char(nvl(dLastMove-1, ::[SYSTEM].[OP_DATE]), 'dd.mm.yyyy')||': '||::[DOCUMENT].[LIB_CUR].get_rate(rVal, dLastMove-1));
		--end if;
		debet := (am.C_DT='1');
		if debet then  -- Дебет
			-- обороты
			nSumDt := nSumDt + am.C_SUMMA;	
			nSumDtDay := nSumDtDay + am.C_SUMMA;
			-- остатки -А+П
			nSaldo := nSaldo - am.C_SUMMA;
			nSaldoN := nSaldoN - am.C_SUMMA_NAT;
			-- оброты эквивалент просто сумма - суммы в ЦФТ без знака - признак Д/К
			--debug_pipe('++ nSumDtN='||nSumDtN||' am.C_SUMMA_NAT='||am.C_SUMMA_NAT);
			nSumDtN := nSumDtN + am.C_SUMMA_NAT;		
			nSumDtNDay := nSumDtNDay + am.C_SUMMA_NAT;
		else  -- Кредит
			--
			nSumKt := nSumKt + am.C_SUMMA;	
			nSumKtDay := nSumKtDay + am.C_SUMMA;
			--
			nSaldo := nSaldo + am.C_SUMMA;
			nSaldoN := nSaldoN + am.C_SUMMA_NAT;
			--
			nSumKtN := nSumKtN + am.C_SUMMA_NAT;		
			nSumKtNDay := nSumKtNDay + am.C_SUMMA_NAT;
		end if;
		if bShowNoPereoc and
			(am.knp in
				(::[KOD_N_PAY]([kod_nazn]='RECONT'),
				 ::[KOD_N_PAY]([kod_nazn]='RECONT+'),
				 ::[KOD_N_PAY]([kod_nazn]='RATEDIFF')  -- курсовая разница
				 )
			or am.C_SUMMA=0   -- сумма в вадюте 0
			)
		then
			continue;  -- переоценку пропускаем
		end if;
		nCounter := nCounter + 1;
		nRow := nRow + 1;
		
		--=================================================================================
	    if not haveOborot then haveOborot:=true; end if;
		xlWrite(nRow, 1, nCounter);									-- Номер строки
		xlWrite(nRow, 2, to_char(am.C_DATE_MOVE, 'dd.mm.yyyy'));	-- Дата проводки
		xlWrite(nRow, 3, am.C_TOPER_CODE);							-- Вид операции
		xlWrite(nRow, 4, am.C_DOC_NUM);								-- Номер документа клиента
		xlWrite(nRow, 5, am.C_ACC_CORR);						    -- Счет плательщика/получателя
		--
		nCol:=5;
		-- добавляем что отмечено
		-- внешний счет
        if bSHowExtAcc then
            nCol:=nCol+1;
			if am.C_DT = '1' then  -- Дебет
				xlWrite(nRow, nCol,am.klAccKt);
			else
				xlWrite(nRow, nCol,am.klAccDt);
			end if;
		end if;
        if bSHowExtBic then
            nCol:=nCol+1;
			if not debet then  -- Д
				xlWrite(nRow, nCol,am.klKtBic);
			else
				xlWrite(nRow, nCol,am.klDtBic);
			end if;
		end if;
        if bSHowExtBank then
            nCol:=nCol+1;
			if not debet then  -- Д
				xlWrite(nRow, nCol,am.klKtBank);
			else
				xlWrite(nRow, nCol,am.klDtBank);
			end if;
		end if;
        if bSHowExtCorr then
            nCol:=nCol+1;
			if not debet then  -- Д
				xlWrite(nRow, nCol,am.klKtKS);
			else
				xlWrite(nRow, nCol,am.klDtKS);
			end if;
		end if;
        if bSHowExtINN then
            nCol:=nCol+1;
			if debet then  -- Д
				xlWrite(nRow, nCol,am.klKtInn);
			else
				xlWrite(nRow, nCol,am.klDtInn);
			end if;
		end if;
        if bSHowExtName then
            nCol:=nCol+1;
			if debet then  -- Д
				xlWrite(nRow, nCol,am.klKtName);
			else
				xlWrite(nRow, nCol,am.klDtName);
			end if;
		end if;
		-- обороты /безусловно/
		nCol:=nCol+1;
		if debet then  -- Дебет
			xlWriteNum(nRow, nCol, am.C_SUMMA);
			xlWriteNum(nRow, nCol+1, 0);
		else  -- Кредит
			xlWriteNum(nRow, nCol, 0);
			xlWriteNum(nRow, nCol+1, am.C_SUMMA);
		end if;
		nCol:=nCol+1;
		--debug_pipe('saldo='||nSaldo||' nSaldoN='||nSaldoN);
		-- остаток /Сальдо/
		if bShowSaldo then
			nCol:=nCol+1;
			if vVidAccShort = 'А' then
				xlWriteNum(nRow, nCol, -nSaldo );
			else
				xlWriteNum(nRow, nCol, nSaldo );
			end if;
		end if;
		--
		if bShowN then  -- в нац покрытии
			nCol:=nCol+1;
			if debet then --ДЕБ
				xlWriteNum(nRow, nCol, am.C_SUMMA_NAT);
				xlWriteNum(nRow, nCol+1, 0);
			else
				xlWriteNum(nRow, nCol, 0);
				xlWriteNum(nRow, nCol+1, am.C_SUMMA_NAT);
			end if;
			nCol:=nCol+1;
			if bShowSaldo then
				nCol:=nCol+1;
				if vVidAccShort = 'А' then
					xlWriteNum(nRow, nCol, -nSaldoN );
				else
					xlWriteNum(nRow, nCol, nSaldoN );
				end if;
			end if;
		end if;
		-- Курс
		if bShowRate then
			nCol:=nCol+1;
			xlWriteNum(nRow, nCol, ::[DOCUMENT].[LIB_CUR].get_rate(rVal, am.C_DATE_MOVE) );
		end if;
		-- Назначение
		if bShowNazn then
			nCol:=nCol+1;
			xlWriteText( nRow, nCol, am.C_NAZN_PL );
		   --::[OOXML].[API_XL].Put(nRow, nCol, am.C_NAZN_PL);
		end if;
	end loop;
	-- еще строка итогов если запрошено
	if bShowDayItog then
		nRow := nRow + 1;
	    DRAW_ITOG(soTmp,nRow,nSumDtDay,nSumKtDay,nSumDtNDay,nSumKtNDay);
	end if;

end;
--##############################################################################################################
-- Итоги
--##############################################################################################################
procedure draw_footer is
nCol 			number;
begin
-- нет данных в выписке и пустые не нужны
if nCounter = 0 and notEmpty then  -- удаляем все что навставляли
	::[OOXML].[API_XL].Delete_Row(nReportFistRow,nRow-nReportFistRow+1);
	return;
end if;
--
if haveOborot then  -- были в периоде оборотов => остатки берем стандартные - иначе они расчитались в диасе ?!
	nSaldoOut 	:= nvl(f.a('В'||to_char(arcMove)||'СВ', dateEnd+1),0);
	nSaldoNOut	:= nvl(f.a('В'||to_char(arcMove)||'СН', dateEnd+1),0);
	-- test
	--debug_pipe('+ haveOborot nSaldoOut='||nSaldoOut||' nSaldoNOut='||nSaldoNOut);
	/* уже со знаком
	if vVidAccShort = 'А' then
		nSaldoOut:=-nSaldoOut;
		nSaldoNOut:=-nSaldoNOut;
	end if;
	*/
end if;
if not bShowNoItog then
  -- обороты  ============================================================================
	nRow := nRow + 1;
	xlWrite(nRow,	2,	'Итого по счету');
	--::[OOXML].[API_XL].merge(nRow,2,nRow,3);
	::[OOXML].[API_XL].cell(nRow, 4, nCounter,numFmt0);
	nCol:=5;
	-- доп опции
    if bSHowExtAcc then
       nCol:=nCol+1;
	end if;
    if bSHowExtBic then
       nCol:=nCol+1;
	end if;
    if bSHowExtBank then
       nCol:=nCol+1;
	end if;
    if bSHowExtCorr then
       nCol:=nCol+1;
	end if;
    if bSHowExtInn then
       nCol:=nCol+1;
       --xlwrite(nRow,nCol,'xxxxx');
	end if;
    if bSHowExtName then
       nCol:=nCol+1;
	end if;
	--  итоги оборотов номинал
    nCol:=nCol+1;
	xlWriteNum(nRow, nCol, nSumDt);
    nCol:=nCol+1;
	xlWriteNum(nRow, nCol, nSumKt);
	-- В итогах остаток не нужен он отдельно над нужым столбцом
    if bSHowSaldo then
       nCol:=nCol+1;
	end if;
	--
	if bShowN then  -- в нац покрытии
       nCol:=nCol+1;
       --debug_pipe('в нац покрытии D='||nSumDtN||' K='||nSumKtN);
	   xlWriteNum(nRow, nCol, nSumDtN);
	   xlWriteNum(nRow, nCol+1, nSumKtN);
       nCol:=nCol+1;
	end if;
  -- остаток  ============================================================================ 	
	nRow := nRow + 1;
	xlWrite(nRow,2,'Исходящее сальдо');
	--::[OOXML].[API_XL].merge(nRow,2,nRow,4);
	nCol:=5;
	-- доп опции
    if bSHowExtAcc then
       nCol:=nCol+1;
	end if;
    if bSHowExtBic then
       nCol:=nCol+1;
	end if;
    if bSHowExtBank then
       nCol:=nCol+1;
	end if;
    if bSHowExtCorr then
       nCol:=nCol+1;
	end if;
    if bSHowExtInn then
       nCol:=nCol+1;
       --xlwrite(nRow,nCol,'xxxxx');
	end if;
    if bSHowExtName then
       nCol:=nCol+1;
	end if;
	--
	-- test footer
    --debug_pipe('out vVidAccShort='||vVidAccShort||' saldo out ='||nSaldoOut||' nt='||nSaldoNOut||' dateEnd='||to_char(dateEnd+1,'dd/mm/yyyy'));
    --
    nCol:=nCol+1;
    -- остаток в валюте
	if vVidAccShort = 'А' then
	    xlWriteNum(nRow, nCol, nvl(-nSaldoOut,0));
	else
	    xlWriteNum(nRow, nCol+1, nvl(nSaldoOut,0));
	end if;
    nCol:=nCol+1;
    -- собственно в столбец "сальдо" ничего не выводим
    if bSHowSaldo then
       nCol:=nCol+1;
	end if;
	-- остаток/сальдо в нац покрытии
	if bShowN then
       nCol:=nCol+1;
       if vVidAccShort = 'А' then
         xlWriteNum(nRow, nCol, nvl(-nSaldoNOut,0));
       else
         xlWriteNum(nRow, nCol+1, nvl(nSaldoNOut,0));
       end if;
   	   nCol:=nCol+1;
	end if;
end if;   --if not bShowNoItog then
	-- рисуем границы
	::[OOXML].[API_XL].Set_Format_Range(nTableFirstRow,1,nRow,tableMaxCol,p_borderId == iBorderAll);
	--
	--debug_pipe('nRow='||nRow||' bShowOtv='||bShowOtv);
if not bShowNoItog then
	if bShowOtv then
		nRow := nRow + 2;
		xlWrite(nRow,2,'Ответственный исполнитель по счету:'||sOtv);
  	    --::[OOXML].[API_XL].merge(nRow,2,nRow,nCol);
	end if;
end if;
end;
--##############################################################################################################
-- Заполнение выписки
--##############################################################################################################
public procedure DRAW_REPORT(vAcc ref [AC_FIN]) is 
begin
    nSaldoIn=nSaldoOut=nSaldoNIn=nSaldoNOut:=0;
	nSumDt=nSumKt=nSumDtN=nSumKtN:=0;
	nCounter:=0;
	acf:=vAcc;
	--
    getAccountData;
	draw_header;
    if not bShowNoItog then
		nRow := nTableFirstRow+1;
    else
		nRow := nTableFirstRow;
    end if;
	-- Собственно обороты
	draw_oborot;
	draw_footer;
	-- for next  если не удалили
	if nCounter = 0 and notEmpty then
	    null;
	else
    	nReportFistRow	:= nRow+1;
	end if;
end;
--
public function getCount return integer is 
begin
return nCounter;
end;
PSH_CL_UNI_MOVE is

validate is
usr ref [object]:=stdlib.userid;
Begin
	If P_MESSAGE = 'DEFAULT' Then
--		V_DATE_E		:= ::[SYSTEM].[OP_DATE];
--		V_DATE_S		:= V_DATE_E;
		V_DATE_S		:= nvl(::[DEFVALS].[SLIB].RestoreDate(usr, &METHOD$CLASS, &METHOD$SNAME, 'V_DATE_S'),::[SYSTEM].[OP_DATE]);
		V_DATE_E		:= nvl(::[DEFVALS].[SLIB].RestoreDate(usr, &METHOD$CLASS, &METHOD$SNAME, 'V_DATE_E'),::[SYSTEM].[OP_DATE]);
        -- test
		--V_DATE_E		:= to_date('22082016','ddmmyyyy');
		--V_DATE_S		:= V_DATE_E;
		--
		V_ACC			:= this;
	    P_INFO			:= '%VAR%.V_ACC';
	    V_ADD_TBL:=makeGrid(V_ADD_TBL);
	    --debug_pipe('V_ADD_TBL.cnt='||V_ADD_TBL.count);
	    --================================================================
	    for i in V_ADD_TBL.first..V_ADD_TBL.last loop
        	V_ADD_TBL(i).[BOOL_1]:= nvl(::[DEFVALS].[SLIB].RestoreBool(stdlib.userid, &METHOD$CLASS, &METHOD$SNAME, 'ATTR'||i), false);
		end loop;
	    --================================================================
	ElsIf P_MESSAGE = 'VALIDATE' Then
		if P_INFO = 'OK' Then
			If V_ACC is null then
				pragma error('Для формирования выписки указание счета является обязательным, пожалуйста, укажите счет.');
			End if;
		elsif P_INFO = 'SaveButton' then
		
		    if V_ADD_TBL.first is not null then
		    	for i in V_ADD_TBL.first..V_ADD_TBL.last loop
				  ::[DEFVALS].[SLIB].saveBool( stdlib.userid, &METHOD$CLASS, &METHOD$SNAME	, 'ATTR'||i	, V_ADD_TBL(i).[BOOL_1]	);
				end loop;
		    end if;
	   End If;
	End If;
End;

execute is
--	rpt_blob		blob;
--	rep_id			string;
	af ::[ac_fin];
	usr ref [object]:=stdlib.userid;
begin
    ::[DEFVALS].[SLIB].saveDate( usr, &METHOD$CLASS, &METHOD$SNAME, 'V_DATE_S', V_DATE_S);
    ::[DEFVALS].[SLIB].saveDate( usr, &METHOD$CLASS, &METHOD$SNAME, 'V_DATE_E', V_DATE_E);
    -- проверка доступа ! вызывающие отчеты должны проверять сами т.к эту проверку они обходят
    begin
    -- VW_CRIT_AC_FIN
    select x(x.id) in VW_CRIT_AC_FIN_NUM%rowtype where x.id=v_acc into af;
    exception when no_data_found then return;
    end;
--	::[OOXML].[API_XL].Init_XLS;
	::[SHABLON_DOC].[LIB_OOXML].xl_init;
	-- Общие данные отчета
	initRep(V_ADD_TBL,v_date_s,v_date_e,v_cor_mask);
	-- Формирование выписки
	DRAW_REPORT(v_acc);
	--
	finalRep;
	--
	::[SHABLON_DOC].[LIB_OOXML].xl_finish;
--	rpt_blob := empty_blob();
--	::[OOXML].[API_XL].finish(rpt_blob);
--	rep_id := ::[OOXML].[API_ORSA].putReport2Run(rpt_blob, 'xlsx', &METHOD$NAME);
End;
end;
end;
