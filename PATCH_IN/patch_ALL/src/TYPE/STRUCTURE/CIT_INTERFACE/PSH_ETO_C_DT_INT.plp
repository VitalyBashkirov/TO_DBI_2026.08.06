class CIT_INTERFACE;

@import_plsql(true)
@name('[ПСБ] ЕТО. Интерфейс списания с карты')
library PSH_ETO_C_DT_INT is

cv_action_payment	const varchar2(7) := 'payment';
cv_action_refund	const varchar2(6) := 'refund';
cv_action_cashback	const varchar2(8) := 'cashback';

cv_result_accept const varchar2(6) := 'accept';
cv_result_reject const varchar2(6) := 'reject';

type action_data_rec_type is record (id_int						varchar2(36)
									,id_ext						varchar2(36)
									,psUuid						varchar2(36)
									,cardNumber					varchar(24)
									,amount						number
									,currency					varchar(3)
--									,responseCode				varchar(2)
--									,processingCode				varchar(6)
									,systemTraceAuditNumber		number
									,localTransactionDate		date
--									,rrn						varchar2(12)
									,authorizationIdResponse	varchar2(11)
									,accountCurrencyAmount		number
									,refTrnId					varchar2(36)
									,merchantName				varchar2(256)
									);

cv_tag_request		const varchar2(13) := 'ETO_DEBIT_REQ';
cv_tag_response		const varchar2(14) := 'ETO_DEBIT_RESP';

cv_path_to_data		const varchar2(19) := '//CIT_REQUEST/DATA/';
cv_path_to_request	const varchar2(33) := cv_path_to_data || cv_tag_request;

cv_tag_action					const varchar2(47) := cv_path_to_request || '/action/@Value';
cv_tag_ID_INT					const varchar2(47) := cv_path_to_request || '/ID_INT/@Value';
cv_tag_ID_EXT					const varchar2(47) := cv_path_to_request || '/ID_EXT/@Value';
cv_tag_psUuid					const varchar2(47) := cv_path_to_request || '/psUuid/@Value';
cv_tag_cardNumber				const varchar2(51) := cv_path_to_request || '/cardNumber/@Value';
cv_tag_amount					const varchar2(47) := cv_path_to_request || '/amount/@Value';
cv_tag_currency					const varchar2(49) := cv_path_to_request || '/currency/@Value';
--cv_tag_responseCode				const varchar2(53) := cv_path_to_request || '/responseCode/@Value';
--cv_tag_processingCode			const varchar2(55) := cv_path_to_request || '/processingCode/@Value';
cv_tag_systemTraceAuditNumber	const varchar2(63) := cv_path_to_request || '/systemTraceAuditNumber/@Value';
cv_tag_localTransactionDate		const varchar2(61) := cv_path_to_request || '/localTransactionDate/@Value';
--cv_tag_rrn						const varchar2(44) := cv_path_to_request || '/rrn/@Value';
cv_tag_authorizationIdResponse	const varchar2(64) := cv_path_to_request || '/authorizationIdResponse/@Value';
cv_tag_accountCurrencyAmount	const varchar2(62) := cv_path_to_request || '/accountCurrencyAmount/@Value';
cv_tag_refTrnId					const varchar2(49) := cv_path_to_request || '/refTrnId/@Value';
cv_tag_merchantName				const varchar2(53) := cv_path_to_request || '/merchantName/@Value';

function processActionPayment(p_action_data in out nocopy action_data_rec_type, p_msg_struct [CIT_BO].[TLIB].data2pack_type) return integer;
function processActionRefund(p_action_data in out nocopy action_data_rec_type, p_msg_struct [CIT_BO].[TLIB].data2pack_type) return integer;
function tryExecuteBo(p_action_data in out nocopy action_data_rec_type, p_bo ref [PATTERN_DOC], p_msg_struct [CIT_BO].[TLIB].data2pack_type) return integer;
function getActionDataFromRequest(p_cit_req xmltype) return action_data_rec_type;
--function processAndGetResponse(p_cit_req xmltype, p_cit_res in out nocopy clob) return integer;
function processAndGetResponse(p_cit_req xmltype, p_cit_res in out nocopy clob, p_msg_struct [CIT_BO].[TLIB].data2pack_type) return integer;
function getResponse(p_action_data action_data_rec_type, p_result varchar2, p_message varchar2 := null) return clob;
function getResponse4Exception(p_req clob, p_result varchar2, p_message varchar2 := null) return clob;
function getTagValue(p_xmlclob in out nocopy clob, p_tag varchar2) return varchar2;
function action_data_to_char(p_action_data action_data_rec_type) return clob;

/*********************************************************************
Таблица кодов ошибок интерфейса обработки запроса
----------------------------------------------------------------------
  Код  |  Описание ошибки
----------------------------------------------------------------------
null   | Передача отклика не предусмотрена настройками
0      | Успешная обработка
1      | Непредусмотренная ошибка интерфейса
2      | *Ошибка разбора запроса
3      | Неподдерживаемый action запроса
4      | Не найдена карта, среди действующих карт
*********************************************************************/

pragma include(::[RUNTIME].[MACRO_LIB]);
pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma include(::[INTERFACE].[COMPILE_LIB]);

public function interface(p_msg_struct in out [CIT_BO].[TLIB].data2pack_type, p_reqres in out clob) return integer is
	cit_req			xmltype;
	cit_res			clob := empty_clob();
	ret_val			integer;
	error_message	[STRING_2000];
begin
	&debug('.interface Begin:', 0)
	&debug('.interface: p_reqres = ' || p_reqres, 0)
	&sp(start_int)

	cit_req := xmltype(p_reqres);
	&debug('.interface: p_reqres parsed successfully', 0)

	ret_val := processAndGetResponse(cit_req, cit_res, p_msg_struct);
	p_reqres := cit_res;

	&debug('.interface End: ret_val = ' || ret_val, 0)
	return ret_val;
exception when others then
	--Причина перехвата others: при возникновении любой ошибки необходимо корректно завершить обработку (записать ответ, вернуть результат обработки в точку вызова)
	&rb(start_int)
	&debug('.interface: exception = ' || utils.error_stack, 0)
	error_message := substr('Ошибка "' || &METHOD$NAME || '": ' || utils.error_stack, 1, error_message%size);

	p_reqres := getResponse4Exception(p_reqres, cv_result_reject, error_message);

	&debug('.interface End: with exception, retVal = 1', 0)
	return 1;
end;


function processAndGetResponse(p_cit_req xmltype, p_cit_res in out nocopy clob, p_msg_struct [CIT_BO].[TLIB].data2pack_type) return integer is
	action		varchar2(128);
	action_data	action_data_rec_type;
	v_retval	integer;
begin
	&debug('.processAndGetResponse Begin:', 0)
	action := [XT].get_xstring(p_cit_req, cv_tag_action);
	&debug('.processAndGetResponse: action = ' || action, 0)

	action_data := getActionDataFromRequest(p_cit_req);
	&debug('.processAndGetResponse: action_data = ' || action_data_to_char(action_data), 0)

	::[PSH_ETO_CARD].[LL].lockReleaseAwaiting(action_data.cardNumber);

	case action of
		:cv_action_payment:
			v_retval := processActionPayment(action_data, p_msg_struct);
		:cv_action_refund:
			v_retval := processActionRefund(action_data, p_msg_struct);
		else
			v_retval := 3;
	end;

	p_cit_res :=
		case
		when v_retval = 0 then getResponse(action_data, cv_result_accept)
		when v_retval = 3 then getResponse(action_data, cv_result_reject, 'action = "' || action || '" не обрабатывается, принимаются: "' || cv_action_payment || '", "' || cv_action_refund /*||  '", "' || cv_action_cashback*/ || '"')
		when v_retval = 4 then getResponse(action_data, cv_result_reject, 'Не найдена карта ' || action_data.cardNumber || ' среди действующих карт')
--		when v_retval = 5 then getResponse(action_data, cv_result_reject, 'Карта CARD_NUMBER = ' || v_eto_card.[CARD_NUMBER] || ' не найдена для выполнения ' || cv_action_enrollment || ' action')
		end;

	&debug('.processAndGetResponse End: v_retval = ' || v_retval, 0)
	return v_retval;
end;

function processActionPayment(p_action_data in out nocopy action_data_rec_type, p_msg_struct [CIT_BO].[TLIB].data2pack_type) return integer is
	cv_bo		const ref [PATTERN_DOC]	:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getBoFromMapByValue('PREP_DT_SBP_PAYMENT');
	v_retval	integer;
begin
	&debug('.processActionPayment Begin:', 0)
	v_retval := tryExecuteBo(p_action_data, cv_bo, p_msg_struct);
	&debug('.processActionPayment End: v_retval = ' || v_retval, 0)
	return v_retval;
end;

function processActionRefund(p_action_data in out nocopy action_data_rec_type, p_msg_struct [CIT_BO].[TLIB].data2pack_type) return integer is
	cv_bo		const ref [PATTERN_DOC]	:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getBoFromMapByValue('PREP_CT_SBP_REFUND');
	v_retval	integer;
begin
	&debug('.processActionRefund Begin:', 0)
	v_retval := tryExecuteBo(p_action_data, cv_bo, p_msg_struct);
	&debug('.processActionRefund End: v_retval = ' || v_retval, 0)
	return v_retval;
end;


function getCardNumberMasked(pCardNumber varchar2) return varchar2 is
	vFirstPartLen	const integer := 6;
	vLastPartLen	const integer := 4;
	vMaskPartLen	const integer := length(pCardNumber) - (vFirstPartLen + vLastPartLen);
	vMaskSymbol		const varchar2(1) := '*';
begin
	return substr(pCardNumber, 1, vFirstPartLen) || lpad(vMaskSymbol, vMaskPartLen, vMaskSymbol) || substr(pCardNumber, -vLastPartLen);
end;

function getMerchantNameForNazn(p_action_data action_data_rec_type) return varchar2 is
begin
	return 'В ' || p_action_data.merchantName || ' от ' || to_char(p_action_data.localTransactionDate, 'dd/mm/yyyy hh24:mi')
		|| ', сумма ' || p_action_data.amount || 'руб., карта ' || getCardNumberMasked(p_action_data.cardNumber);
end;

function tryExecuteBo(p_action_data in out nocopy action_data_rec_type, p_bo ref [PATTERN_DOC], p_msg_struct [CIT_BO].[TLIB].data2pack_type) return integer is
	cv_calc_par_card_account	const varchar2(19)	:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].cv_calc_par_card_account;
	cv_calc_par_card_amount		const varchar2(18)	:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].cv_calc_par_card_amount;
	cv_calc_par_merchant_name	const varchar2(15)	:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].cv_calc_par_merchant_name;
	cv_rko						const ref [RKO]		:= ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getRkoForBo();
	v_folder			ref [FOLDER_PAY];
	v_par4bo			[STRING_32767];
	v_card				[PSH_ETO_CARD];
	v_retval			integer;
	cv_bo_exec_timer	const varchar2(11) := 'BO_EXEC';
begin
	&debug('.tryExecuteBo Begin:', 0)

	v_card := ::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].getCard(p_action_data.cardNumber);

	if v_card.[CARD_ACCOUNT] is null then
		v_retval := 4;
	else
		[STR].set_par(v_par4bo, cv_calc_par_card_account, v_card.[CARD_ACCOUNT]);
		[STR].set_par(v_par4bo, cv_calc_par_card_amount, p_action_data.amount);
--		[STR].set_par(v_par4bo, cv_calc_par_merchant_name, p_action_data.merchantName);
		[STR].set_par(v_par4bo, cv_calc_par_merchant_name, getMerchantNameForNazn(p_action_data));

		&debug('.tryExecuteBo: exec BO beg sysdate = ' || sysdate || ', p_bo = ' || p_bo, 0)
		start_timer(cv_bo_exec_timer);
		p_bo.[BUSINESS_OP](null, cv_rko, null, null, null, v_folder, P#ADDS == v_par4bo);
		finish_timer(cv_bo_exec_timer);
		&debug('.tryExecuteBo: exec BO end sysdate = ' || sysdate || ', v_folder = ' || v_folder, 0)

		p_action_data.id_int := v_folder;

		::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].setDateValForFolderDocs(v_folder, p_action_data.localTransactionDate);
		::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].setDocumentUnoForFolderDocs(v_folder, 'PREPC');
		::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].setHistoryStateForFolderDocs(v_folder, 'PSH_PREP_PSUUID', p_action_data.psUuid);
		::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].writeBaseValOpForFolderDocs(v_folder);
		::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].postForProcess(v_folder);

		v_retval := 0;
	end if;

	::[PSH_ETO_CARD].[PSH_CIT_INT_LIB].writeCardOperation(v_card.[OPERATIONS], p_msg_struct.in_req_ref, v_folder, p_action_data.id_ext);

	&debug('.tryExecuteBo End: p_action_data.id_int = ' || p_action_data.id_int || ', v_retval = ' || v_retval, 0)

	return v_retval;
end;

function getActionDataFromRequest(p_cit_req xmltype) return action_data_rec_type is
	v_action_data	action_data_rec_type;
begin
	&debug('.getActionDataFromRequest Begin:', 0)
	v_action_data.id_int					:= [XT].get_xstring(p_cit_req, cv_tag_ID_EXT);
	v_action_data.id_ext					:= [XT].get_xstring(p_cit_req, cv_tag_ID_INT);
	v_action_data.psUuid					:= [XT].get_xstring(p_cit_req, cv_tag_psUuid);
	v_action_data.cardNumber				:= [XT].get_xstring(p_cit_req, cv_tag_cardNumber);
	v_action_data.amount					:= [XT].get_xstring(p_cit_req, cv_tag_amount) / 100;
	v_action_data.currency					:= [XT].get_xstring(p_cit_req, cv_tag_currency);
--	v_action_data.responseCode				:= [XT].get_xstring(p_cit_req, cv_tag_responseCode);
--	v_action_data.processingCode			:= [XT].get_xstring(p_cit_req, cv_tag_processingCode);
	v_action_data.systemTraceAuditNumber	:= [XT].get_xstring(p_cit_req, cv_tag_systemTraceAuditNumber);
	v_action_data.localTransactionDate		:= [XT].get_xdatetime(p_cit_req, cv_tag_localTransactionDate);
--	v_action_data.rrn						:= [XT].get_xstring(p_cit_req, cv_tag_rrn);
	v_action_data.authorizationIdResponse	:= [XT].get_xstring(p_cit_req, cv_tag_authorizationIdResponse);
	v_action_data.accountCurrencyAmount		:= [XT].get_xstring(p_cit_req, cv_tag_accountCurrencyAmount) / 100;
	v_action_data.refTrnId					:= [XT].get_xstring(p_cit_req, cv_tag_refTrnId);
	v_action_data.merchantName				:= [XT].get_xstring(p_cit_req, cv_tag_merchantName);

	&debug('.getActionDataFromRequest End: p_cit_req parsed successfully', 0)
	return v_action_data;
end;

function getResponse(p_action_data action_data_rec_type, p_result varchar2, p_message varchar2 := null) return clob is
	resp	clob := empty_clob();
begin
	&debug('.getResponse Begin: p_action_data.id_int = ' || p_action_data.id_int || ', p_result = ' || p_result || ', p_message = "' || p_message || '"', 0)
	resp := to_clob(
'
<' || cv_tag_response || '>
  <ID_INT Value="'		|| p_action_data.id_int || '"/>
  <ID_EXT Value="'		|| p_action_data.id_ext || '"/>
  <RESULT Value="'		|| p_result || '"/>
  <MESSAGE Value="'		|| [XT].escape_string(p_message) || '"/>
</' || cv_tag_response || '>
');
	&debug('.getResponse End: resp = ' || resp, 0)
	return resp;
end;

function getResponse4Exception(p_req clob, p_result varchar2, p_message varchar2 := null) return clob is
	resp	clob := empty_clob();
begin
	&debug('.getResponse4Exception Begin: ', 0)
	resp := to_clob(
'
<' || cv_tag_response || '>
  <ID_INT Value=""/>
  <ID_EXT Value="'		|| getTagValue(p_req, 'ID_INT') || '"/>
  <RESULT Value="'		|| p_result || '"/>
  <MESSAGE Value="'		|| [XT].escape_string(p_message) || '"/>
</' || cv_tag_response || '>
');
	&debug('.getResponse4Exception End: resp = ' || resp, 0)
	return resp;
end;

function getTagValue(p_xmlclob in out nocopy clob, p_tag varchar2) return varchar2 is
begin
	return regexp_substr(p_xmlclob, '<' || p_tag || ' Value="(.*?)"/>', 1, 1, 'c', 1);
end;

public procedure start_timer(p_timer_code varchar2(64)) is 
begin
	&call_int(CIT_INT, INT_TLIB, 2).start_timer(p_timer_code);
end;

public procedure finish_timer(p_timer_code varchar2(64)) is 
begin
	&call_int(CIT_INT, INT_TLIB, 2).finish_timer(p_timer_code);
end;


function action_data_to_char(p_action_data action_data_rec_type) return clob is
begin
	return to_clob(nl$
|| 'id_int = ['					|| p_action_data.id_int						|| '], ' || nl$
|| 'id_ext = ['					|| p_action_data.id_ext						|| '], ' || nl$
|| 'psUuid = ['					|| p_action_data.psUuid						|| '], ' || nl$
|| 'cardNumber = ['				|| p_action_data.cardNumber					|| '], ' || nl$
|| 'amount = ['					|| p_action_data.amount						|| '], ' || nl$
|| 'currency = ['				|| p_action_data.currency					|| '], ' || nl$
--|| 'responseCode = ['			|| p_action_data.responseCode				|| '], ' || nl$
--|| 'processingCode = ['			|| p_action_data.processingCode				|| '], ' || nl$
|| 'systemTraceAuditNumber = ['	|| p_action_data.systemTraceAuditNumber		|| '], ' || nl$
|| 'localTransactionDate = ['	|| p_action_data.localTransactionDate		|| '], ' || nl$
--|| 'rrn = ['					|| p_action_data.rrn						|| '], ' || nl$
|| 'authorizationIdResponse = ['|| p_action_data.authorizationIdResponse	|| '], ' || nl$
|| 'accountCurrencyAmount = ['	|| p_action_data.accountCurrencyAmount		|| '], ' || nl$
|| 'refTrnId = ['				|| p_action_data.refTrnId					|| ']'
);
end;

end;
