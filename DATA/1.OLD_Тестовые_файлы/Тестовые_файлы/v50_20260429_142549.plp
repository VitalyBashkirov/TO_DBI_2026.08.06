-- Тестовый файл для проверки правил: v50
-- Дата генерации: 2026-04-29 14:25:49

--[1] v50.п.1.1
-- outer join,oracle,ansi
-- Замена `(+)` на `LEFT/RIGHT JOIN`

begin --<добавлено при генерации теста>
  В Oracle используется оператор `(+)` для внешнего соединения. В PostgreSQL и ANSI SQL его нет. Заменить на явные `LEFT JOIN` или `RIGHT JOIN` с условием `ON`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[2] v50.п.1.2
-- rownum,limit,offset
-- Замена `rownum` на `FETCH FIRST`

begin --<добавлено при генерации теста>
  Псевдоколонка `rownum` не поддерживается в PostgreSQL. Использовать `FETCH FIRST N ROWS ONLY`. Для сдвига выборки использовать `OFFSET ON`. Не использовать `fetch` в подзапросе `EXISTS`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[3] v50.п.1.3
-- udf,function,performance
-- Запрет UDF в WHERE/GROUP BY/ORDER BY

begin --<добавлено при генерации теста>
  Пользовательские функции нельзя в условиях фильтрации, группировки и сортировки. Только в SELECT-листе верхнего уровня. Не поддерживается в подзапросах, UNION, выражениях. В представлениях не работают сортировка и фильтрация по UDF-колонкам.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[4] v50.п.1.6.1
-- decode,case,conditional
-- Замена `DECODE` на `CASE`

begin --<добавлено при генерации теста>
  Функция `DECODE` специфична для Oracle. Заменять на ANSI-конструкцию `CASE WHEN ... THEN ... ELSE ... END`. При ошибке компиляции case-конструкции требуется ручная замена.
  exit; --<добавлено при генерации теста>
end;

--============================================================

--[5] v50.п.1.8
-- hierarchical,connect by,cte
-- Замена `CONNECT BY` на `WITH RECURSIVE`

begin --<добавлено при генерации теста>
  Иерархические запросы с `CONNECT BY` не поддерживаются. Использовать рекурсивные CTE: `WITH RECURSIVE`. Нет аналога NOCYCLE — ограничение от зацикливания указывать в WHERE. Иерархические запросы по метаданным запрещены.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[6] v50.п.1.9
-- system view,oracle,session
-- Замена `v$session` на `VW_DB_SESSION`

begin --<добавлено при генерации теста>
  Системные представления Oracle недоступны. Использовать `VW_DB_SESSION` с полями SESSION_SID, STATUS, MODULE, ACTION. Представления `VW_SQL` не поддерживаются полностью.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[7] v50.п.1.23
-- context,userenv,database
-- Замена `sys_context('USERENV','DB_NAME')`

begin --<добавлено при генерации теста>
  Контекст `USERENV` не поддерживается. Использовать `::[RUNTIME].[ENVIRONMENT].ClassStorage('ТБП').dbName`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[8] v50.п.1.14
-- functional,attributes
-- Ограничения функциональных реквизитов

begin --<добавлено при генерации теста>
  Функциональные реквизиты можно использовать только в SELECT-листе запроса верхнего уровня. Во всех остальных местах недопустимо использование без секции «SQL значение».
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[9] v50.п.1.21
-- view,simple
-- Запрет простых представлений

begin --<добавлено при генерации теста>
  Простые представления отсутствуют в dbi проекте. Их нужно сконвертировать/переписать в PlPlus представления с учетом ANSI синтаксиса.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[10] v50.п.1.13
-- collection,array,table
-- Замена `SELECT FROM TABLE()`

begin --<добавлено при генерации теста>
  Синтаксис выборки из коллекций не формализован в ANSI SQL. Поддержана выборка из скалярных ассоциативных массивов и из массивов объектных типов.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[11] v50.п.1.17
-- dml,join,update,delete
-- Переписывание DML на подзапросы

begin --<добавлено при генерации теста>
  Нет совместимости синтаксиса `update/delete from (join)` между Oracle и PostgreSQL. Требуется переписать код, например, на подзапросы.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[12] v50.п.1.18
-- hints,optimizer
-- Удаление подсказок оптимизатора

begin --<добавлено при генерации теста>
  В PostgreSQL нет возможности управлять логикой работы Planner/Optimizer. Подсказки (hints) не работают, рекомендуется их удалять.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[13] v50.п.2.2
-- date,type,timestamp
-- Замена `DATE` на `DATE_TIME`

begin --<добавлено при генерации теста>
  В PostgreSQL тип `DATE` не хранит время. Использовать тип `DATE_TIME` (timestamp(0)). Для арифметики применять `INTERVAL`. Для вычитания дат использовать `to_number(to_char(date1-date2))`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[14] v50.п.2.8
-- temp table,varray
-- Замена временных таблиц на `VARRAY`

begin --<добавлено при генерации теста>
  Временные таблицы приводят к проблемам производительности (pg_catalog bloat). Заменять на `VARRAY` (до 10 000 записей) или использовать `init_temp_table()`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

--============================================================

--[15] v50.п.2.6.3
-- index,btree,size,limit
-- Учёт ограничения 2704 байт для BTREE

begin --<добавлено при генерации теста>
  Размер строки BTREE индекса не более 2704 байт. При превышении переходить на GIST/GIN индексы с опциями `gist_trgm_ops` или `gin_trgm_ops`.
  exit; --<добавлено при генерации теста>
end; --<добавлено при генерации теста>

