	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PSH_71');
	 		elsif p_info = 'PSH_ДОХОД' then
			--Сведения о источниках средств
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_SOURCES_OF_MONEY');
                if P_DATA is null then
		 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PSH_75'); --по старому
                end if;
	 		elsif p_info = 'ЦЕЛИ_ДЕЛ_ОТН' then
	 		--Сведения о целях установления деловых отношений с Банком
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PURPOSES_REL');
	 		elsif p_info = 'ХАРАКТЕР_ДЕЛ_ОТН' then
	 		--Сведения о предполагаемом характере деловых отношений с Банком
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_CHARACTER_REL');
	 		elsif p_info = 'ЦЕЛИ_ФИНХОЗ_ДЕЯТ' then
	 		--Сведения о целях финансово-хозяйственной деятельности
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PURPOSES_ACTIV');
	 		elsif p_info = 'ФИН_ПОЛОЖ' then
	 		--Сведения о текущем финансовом положении
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_FINANCIAL_POS');
	 		elsif p_info = 'РЕПУТАЦИЯ' then
	 		--Сведения о деловой репутации
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_REPUTATION_JUR');
	 		elsif p_info = 'ИСТОЧНИК_СРЕДСТВ' then
	 		--Сведения об источниках средств
			      P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_SOURCES_OF_MONEY');
			elsif p_info = 'ШТАТНАЯ_ЧИСЛЕННОСТЬ' then
	 			P_DATA := nvl(GetAddProps(P_DATE_PRINT, 'CL_ANK_SOTRUDNIKI'), client_corp.[NUMBERS]);
	 		elsif p_info = 'ФИН_ИСТОЧНИК' then
	 		--Сведения об источниках происхождения фин. средств
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_SOURCES_OF_MONEY');		
	 		elsif p_info = 'ФИН_ПДЛ' then --пока так
	 		--Сведения об источниках средств ПДЛ
			      P_DATA := 'нет';
	 		elsif p_info = 'КТО_ИДЕНТ_БЕН' then
	 		--кто идентифицмровал бенефициара
	 			P_DATA := nvl('Бенефициарный владелец определен клиентом', GetAddProps(P_DATE_PRINT, 'CL_ANK_PSH_IDENT_BEN_FIZ'));
			elsif p_info in ('КОЛ_ОП_СТР','CL_ANK_KOL_OP_STR') then
		 		
		 		--Сведения об объеме операций за квартал. если в CL_ANK_KOL_OP_STR пусто, выводим по-старому
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_KOL_OP_STR');
                if P_DATA is null then
 		 			temp_str := GetAddProps(P_DATE_PRINT, 'CL_ANK_KOL_OP');
 		 			
	                    -- Vorobey 30.05.2019 В переменной temp_str (если она не null) уже есть строка 'Количество операций за квартал: '
	                    --if temp_str is not null then temp_str:='Количество операций за квартал: '||temp_str;
	                    -- Vorobey 04.06.2019 --if temp_str is null then temp_str:='Количество операций за квартал: 0';
	                    if temp_str is null then temp_str:='Нет';
	                    end if;
		 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_SUM_OP');
		 			--debug_pipe('Vorobey (str 1114) - P_DATA = '||P_DATA,0); -- Vorobey 30.05.2019 debug
	                    -- Vorobey 04.06.2019 --if P_DATA is not null then P_DATA:=temp_str||' Сумма операций за квартал: '||P_DATA;
	                    if P_DATA is not null then P_DATA:=temp_str||P_DATA;
	                    else P_DATA := temp_str;
	                    end if;
                end if;
/***********
           elsif p_info = 'КОЛ_ОП' then
	 		--Сведения о количестве операций за квартал
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_KOL_OP');
    	   elsif p_info = 'СУМ_ОП' then
	 		--Сведения о сумме операций за квартал
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_SUM_OP');
************/
           elsif p_info = 'ВИД_ДОГ' then
