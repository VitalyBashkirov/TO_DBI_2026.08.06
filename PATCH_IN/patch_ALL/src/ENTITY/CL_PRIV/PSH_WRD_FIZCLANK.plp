					where nvl(x.[DATE_END], ::[SYSTEM].op_date + 1) >= ::[SYSTEM].op_date
				)
				loop
					P_DATA := P_DATA || nvl(x.ser, '-') || NL$;
				end loop;
				P_DATA := rtrim(ltrim(P_DATA), NL$);
			elsif p_info = 'ДОП_ДОК_НОМЕР' then
				for (select x(x.[NUM] : num)
