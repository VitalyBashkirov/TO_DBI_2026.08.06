EscChr		varchar2(300) :=           '(s12H(s3B&a0L&a-.25R&a-.25R&a-.25R&a-.25R&a-.25R&a-.25R&a-.25R&a-.25R';
EscChrDoc	varchar2(300) := '&l0O(s12H&l8D(s3B&a7L&a-.25R&a-.25R&a-.25R&a-.25R&a-.25R&a-.25R&a-.25R&a-.25R';
EscLineSpacing	varchar2(300) := Chr(027)||Chr(038)||Chr(108)||Chr(056)||Chr(068); --Line Spacing (Lines per inch)  8 lines/inch  Ec&l8D (d)  027 038 108 056 068 (100)  1B 26 6C 38 44 (64)
