class CL_PRIV;

@name('[ПСБ] Заявление-Анкета на ДБО ФЛ')
@tag('COPIED')
method PSH_ZAY_AN_DBO_F is

@name('V_DEST') public V_DEST [MEMO_32767];

-- Заполнение подряд
procedure put_per_cell(	p_row	number
					,	p_col	number
					,	p_str	varchar2(255)
) is
	iLen	integer;
begin
	if p_str is not null then
		iLen := length(p_str);

		for x in 1 .. iLen loop
			[EXCEL].Write(p_row, p_col + x - 1, substr(p_str, x, 1));
		end loop;

	end if;	
end;


PSH_ZAY_AN_DBO_F (
	@name('Дата Анкеты') P_DATE_PODP in [DATE],
	@name('Подписант')   P_PODPISANT in [USER_REF]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_DATE_PODP := [SYSTEM]::[OP_DATE];

end if;
-- End initialization of parameters and variables
declare
i 			number;

vColCount 	number; -- колво колонок в отчете
vLineCount 	number; -- первая строка в Excel
vFileName 	varchar2(250); -- имя Excel-шаблона
adres_reg ref [PERSONAL_ADDRESS];
adres_fact ref [PERSONAL_ADDRESS];
adres_post ref [PERSONAL_ADDRESS];
--kontact ref [CONTACTS];
osnov_ben varchar2(500);
tel_dom varchar2(18);
tel_rab varchar2(18);
tel_mob varchar2(18);
email varchar2(180);
benef ref [CL_PRIV];
V_REGION_AREA varchar2(40);
V_REGION varchar2(40);


begin
  if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
		[EXCEL].Init_Xls;
		P_PODPISANT:=stdlib.user_id;
		
					
  elsif P_MESSAGE = 'VALIDATE' then -- переход между полями

		if p_info = 'OK' then
  			
  			if P_DATE_PODP is null  then
  				pragma error('Не указана Дата заполнения!');
  			end if;

  			
  			vFileName := 'PSH_Заявление-Анкета ДБО ФЛ2.xlsx';
  			  			  	
			if [EXCEL].F_Click then
				[EXCEL].F_Click := False;

				vColCount := 5; -- всего колонок в отчете
				vLineCount := 15; -- первая строка в Excel
				i:=vLineCount;
				
				-- обнуляем переменные
				
				
				-- запуск Excel

				[EXCEL].open_file(::[REPS].[SLIB].GetPath('PATH_PRINT_EXCEL', vFileName),false);

				-- цикл по договорам

				-- вывод в Ексель
				
				put_per_cell (15, 6, this.[FAMILY_CL]);
				put_per_cell (17, 6, this.[NAME_CL]);
				put_per_cell (19, 6, this.[SNAME_CL]);
				put_per_cell (15, 34, to_char(this.[DATE_PERS],'DD')||'. '||substr(to_char(this.[DATE_PERS],'MM'),1,1)||substr(to_char(this.[DATE_PERS],'MM'),2,1)||' .'||to_char(this.[DATE_PERS],'YYYY'));
				
				if this.[SEX].[CODE]='М' then [EXCEL].Write(19, 31,'X');
				elsif this.[SEX].[CODE]='Ж' then [EXCEL].Write(19, 34,'X');
				end if;
				
				put_per_cell (21, 15, substr(this.[I_NAME],1,29));
				put_per_cell (22, 15, substr(this.[I_NAME],30));
				put_per_cell (24, 8, substr(this.[DOC].[BIRTH_PLACE],1,38));
								
				if this.[COUNTRY].[CODE]='643' then [EXCEL].Write(26, 8,'X');
				elsif this.[COUNTRY] is not null then [EXCEL].Write(26, 14,'X'); put_per_cell (26, 21, this.[COUNTRY].[VALUE]);
				end if;				
				
				if this.[NU_REZIDENT] then [EXCEL].Write(28, 17,'X');
				elsif not this.[NU_REZIDENT] then [EXCEL].Write(28, 25,'X');
				end if;									

				if this.[DOC].[TYPE].[KOD]='21' then [EXCEL].Write(32, 2,'X');
				else put_per_cell (32, 21, this.[DOC].[TYPE].[NAME]);
				end if;
				
				put_per_cell (34, 6, this.[DOC].[SER]);
				put_per_cell (34, 16, this.[DOC].[NUM]);
				put_per_cell (34, 34, to_char(this.[DOC].[DATE],'DD')||'. '||substr(to_char(this.[DOC].[DATE],'MM'),1,1)||substr(to_char(this.[DOC].[DATE],'MM'),2,1)||' .'||to_char(this.[DOC].[DATE],'YYYY'));
				put_per_cell (36, 6, substr(this.[DOC].[WHO],1,28));
				put_per_cell (37, 6, substr(this.[DOC].[WHO],29,40));
				put_per_cell (38, 6, substr(this.[DOC].[WHO],69));
				put_per_cell (40, 10, this.[DOC].[DEPART_CODE]);
				put_per_cell (42, 22, this.[INN]);
				
				if this.[COUNTRY].[CODE]!='643' then
				
					if this.[DOC].[TYPE].[KOD]='12' then
						put_per_cell (48, 10, this.[DOC].[TYPE].[NAME]);					
						put_per_cell (48, 34, to_char(this.[DOC].[DATE],'DD')||'. '||substr(to_char(this.[DOC].[DATE],'MM'),1,1)||substr(to_char(this.[DOC].[DATE],'MM'),2,1)||' .'||to_char(this.[DOC].[DATE],'YYYY'));
						put_per_cell (50, 8, this.[DOC].[SER]);
						put_per_cell (50, 17, this.[DOC].[NUM]);
						put_per_cell (52, 8, substr(this.[DOC].[WHO],1,38));
						put_per_cell (54, 10, to_char(this.[DOC].[DATE],'DD.MM.YY'));
						put_per_cell (54, 21, to_char(this.[DOC].[DATE_END],'DD.MM.YY'));
					else 	for x in this.[DOC_ARR] where x.[TYPE].[KOD] in ('VISA_N','OTHER_RESID_N','PERMISSION_N') and (x.[DATE_END] is null or x.[DATE_END]>=P_DATE_PODP)
									order by x.[DATE_END]
							loop
							put_per_cell (48, 9, x.[TYPE].[NAME]);
							put_per_cell (48, 34, to_char(x.[DATE],'DD')||'. '||substr(to_char(x.[DATE],'MM'),1,1)||substr(to_char(x.[DATE],'MM'),2,1)||' .'||to_char(x.[DATE],'YYYY'));
							put_per_cell (50, 8, x.[SER]);
							put_per_cell (50, 17, x.[NUM]);
							put_per_cell (52, 8, substr(x.[WHO],1,38));
							put_per_cell (54, 10, to_char(x.[DATE],'DD.MM.YY'));
							put_per_cell (54, 21, to_char(x.[DATE_END],'DD.MM.YY'));
							
							end loop;
					end if;	
				
				
				
					for x in this.[MIGR_CARD] order by x.[DATE_END] loop
					put_per_cell (56, 13, x.[CARD_NUM]);
					put_per_cell (58, 13, to_char(x.[DATE_BEG],'DD.MM.YY'));
					put_per_cell (58, 24, to_char(x.[DATE_END],'DD.MM.YY'));
					end loop;
				
				end if;
				
				
				
				adres_reg := null;
				adres_fact := null;
				adres_post := null;
				
				for x in this.[ADDRESSES] where x.[TYPE].[KOD]='REGISTRATION' loop
				adres_reg:=x;
				end loop;
				
				
				if adres_reg is not null then
				
					V_REGION := ::[PERSONAL_ADDRESS].[LIB].get_region(nvl(adres_reg.[CITY]%id,adres_reg.[STREET_REF]%id)).[SHORT_NAME];
					V_REGION_AREA := ::[PERSONAL_ADDRESS].[LIB].get_region_AREA(nvl(adres_reg.[CITY]%id,adres_reg.[STREET_REF]%id)).[SHORT_NAME];
					put_per_cell (64, 6, adres_reg.[CITY].[COUNTRY].[VALUE]);
					put_per_cell (64, 24, V_REGION);
					put_per_cell (66, 6, substr(V_REGION_AREA,1,14));
					put_per_cell (66, 24, adres_reg.[CITY].[NAME]);
					put_per_cell (68, 6, adres_reg.[STREET_REF].[FULL_NAME]);
					put_per_cell (70, 6, adres_reg.[HOUSE]);
					put_per_cell (70, 14, adres_reg.[KORPUS]);
					put_per_cell (70, 32, adres_reg.[FLAT]);
				end if;	
				
				for x in this.[ADDRESSES] where x.[TYPE].[KOD]='REAL_LIVE' loop
				adres_fact:=x;
				end loop;
				
				if adres_fact is not null and adres_reg.[STREET_REF].[KLADR]!=adres_fact.[STREET_REF].[KLADR] then
					V_REGION := ::[PERSONAL_ADDRESS].[LIB].get_region(nvl(adres_fact.[CITY]%id,adres_fact.[STREET_REF]%id)).[SHORT_NAME];
					V_REGION_AREA := ::[PERSONAL_ADDRESS].[LIB].get_region_AREA(nvl(adres_fact.[CITY]%id,adres_fact.[STREET_REF]%id)).[SHORT_NAME];
					put_per_cell (80, 6, adres_fact.[CITY].[COUNTRY].[VALUE]);
					put_per_cell (80, 24, V_REGION);
					put_per_cell (82, 6, substr(V_REGION_AREA,1,14));
					put_per_cell (82, 24, adres_fact.[CITY].[NAME]);
					put_per_cell (84, 6, adres_fact.[STREET_REF].[FULL_NAME]);
					put_per_cell (86, 6, adres_fact.[HOUSE]);
					put_per_cell (86, 14, adres_fact.[KORPUS]);
					put_per_cell (86, 32, adres_fact.[FLAT]);
				else [EXCEL].Write(78, 2,'X');	
				end if;	
				
				for x in this.[ADDRESSES] where x.[TYPE].[KOD]='POST' loop
				adres_post:=x;
				end loop;
				
				if adres_post is not null and adres_reg.[STREET_REF].[KLADR]!=adres_post.[STREET_REF].[KLADR] and adres_fact.[STREET_REF].[KLADR]!=adres_post.[STREET_REF].[KLADR] then
					V_REGION := ::[PERSONAL_ADDRESS].[LIB].get_region(nvl(adres_post.[CITY]%id,adres_post.[STREET_REF]%id)).[SHORT_NAME];
					V_REGION_AREA := ::[PERSONAL_ADDRESS].[LIB].get_region_AREA(nvl(adres_post.[CITY]%id,adres_post.[STREET_REF]%id)).[SHORT_NAME];
					put_per_cell (97, 6, adres_post.[CITY].[COUNTRY].[VALUE]);
					put_per_cell (97, 24, V_REGION);
					put_per_cell (99, 6, substr(V_REGION_AREA,1,14));
					put_per_cell (99, 24, adres_post.[CITY].[NAME]);
					put_per_cell (101, 6, adres_post.[STREET_REF].[FULL_NAME]);
					put_per_cell (103, 6, adres_post.[HOUSE]);
					put_per_cell (103, 14, adres_post.[KORPUS]);
					put_per_cell (103, 32, adres_post.[FLAT]);
				else if adres_reg.[STREET_REF].[KLADR]=adres_post.[STREET_REF].[KLADR] then [EXCEL].Write(93, 2,'X');
						end if;	
					if adres_fact.[STREET_REF].[KLADR]=adres_post.[STREET_REF].[KLADR] then [EXCEL].Write(95, 2,'X');
						end if;							
				end if;	
				
				for kont in this.[CONTACTS] where kont.[ACTIV] loop
				if kont.[TYPE].[CODE]='MOBILEPHONE' then tel_mob:= kont.[NUMB];
				elsif kont.[TYPE].[CODE]='MAIL' then email:= kont.[NUMB];
				elsif kont.[TYPE].[CODE]='PHONE' and kont.[PRIVATE].[CODE]='3' then tel_dom:= kont.[NUMB];
				elsif kont.[TYPE].[CODE]='PHONE' and kont.[PRIVATE].[CODE]='2' then tel_rab:= kont.[NUMB];
				end if;
				end loop;
				
				put_per_cell (113, 10, tel_dom);
				put_per_cell (113, 30, tel_rab);
				put_per_cell (115, 10, tel_mob);
				put_per_cell (117, 10, email);
												
				for ben in this.[LINKS_OTHER] where ben.[PARTNER]%class='CL_PRIV'
													and (ben.[DATE_END] is null or ben.[DATE_END]>=P_DATE_PODP)
													and ben.[VID_LINK].[CODE] in ('ПОД_КОНТ_БЕНЕФИЦИАРА','БЕНЕФИЦИАР')
													and rownum=1
				loop
				benef:=ben.[PARTNER];
				osnov_ben:=substr(ben.[FOUND],1,500);
				end loop;
				
				if nvl(benef,0)!=0
					then
					[EXCEL].Write(144, 27,'X');
					put_per_cell (149, 6, benef.[FAMILY_CL]);
					put_per_cell (151, 6, benef.[NAME_CL]);
					put_per_cell (153, 6,benef.[SNAME_CL]);
					put_per_cell (155, 34, to_char(benef.[DATE_PERS],'DD')||'. '||substr(to_char(benef.[DATE_PERS],'MM'),1,1)||substr(to_char(benef.[DATE_PERS],'MM'),2,1)||' .'||to_char(benef.[DATE_PERS],'YYYY'));
					
					if benef.[SEX].[CODE]='М' then [EXCEL].Write(149, 29,'X');
					elsif benef.[SEX].[CODE]='Ж' then [EXCEL].Write(149, 32,'X');
					end if;
					
					put_per_cell (155, 8, substr(benef.[DOC].[BIRTH_PLACE],1,18));
									
					if benef.[COUNTRY].[CODE]='643' then [EXCEL].Write(151, 32,'X');
					elsif benef.[COUNTRY] is not null then [EXCEL].Write(151, 35,'X'); put_per_cell (153, 27, benef.[COUNTRY].[VALUE]);
					end if;				
	
					if benef.[DOC].[TYPE].[KOD]='21' then [EXCEL].Write(157, 16,'X');
					else [EXCEL].Write(157, 16,'X'); put_per_cell (157, 24, benef.[DOC].[TYPE].[NAME]);
					end if;
					
					put_per_cell (161, 6, benef.[DOC].[SER]);
					put_per_cell (161, 16, benef.[DOC].[NUM]);
					put_per_cell (161, 34, to_char(benef.[DOC].[DATE],'DD')||'. '||substr(to_char(benef.[DOC].[DATE],'MM'),1,1)||substr(to_char(benef.[DOC].[DATE],'MM'),2,1)||' .'||to_char(benef.[DOC].[DATE],'YYYY'));
					put_per_cell (163, 6, substr(benef.[DOC].[WHO],1,26));
					put_per_cell (165, 6, substr(benef.[DOC].[WHO],27));
					put_per_cell (165, 39, benef.[DOC].[DEPART_CODE]);
					put_per_cell (167, 16, substr(osnov_ben,1,30));
				end if;
				
				
				put_per_cell (235, 27, to_char(P_DATE_PODP,'DD.MM.YYYY'));
				
				put_per_cell (244, 2,::[RUNTIME].[STDLIB].FIO(P_PODPISANT.[NAME]));
				
				put_per_cell (247, 5, to_char(P_DATE_PODP,'DD.MM.YYYY'));
				
				--[EXCEL].Borders(vLineCount, 2, i-1, vColCount+1, 'RLBTVH'); 		-- границы всюду
				/*
				i:=i+1;
				[EXCEL].Write(i, 1,::[CASE_GRAM].[LIB].get_case(P_PODPISANT.[CASTA].[DECL_CAST], ::[CASE_GRAM]([CODE]='И')));
				[EXCEL].Write(i, 6,::[RUNTIME].[STDLIB].FIO(P_PODPISANT.[NAME]));
				i:=i+2;
				*/

				[EXCEL].Visible;
				[EXCEL].Release;
				
			end if;
			
			[EXCEL].Exec_Script(V_DEST);	
		end if;	
  end if;
end;
end;
end;
end;
