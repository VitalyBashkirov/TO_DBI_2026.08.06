--   regex_patterns.for_search: (1) SELECT\s+.*\s+IN\s+\w+\s+REF\s+\[\w+\]; (2) FOR\s+\w+\s+IN\s+\(?SELECT.*\)?\s+REF\s+\[\w+\]
--   code_example_bad: for rec in (select a from v_cl_priv_ref) loop
--   fix_instruction: Переписать запрос: вместо SELECT FROM ref_var использовать SELECT FROM ::[TABLE] с соответствующими условиями.
--   fix_prompt: Выполни замену выборки из ссылок на прямой SELECT.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.SQL.REF_SELECT.п.1.27'.
--   priority: high
--   category: SQL
--   subcategory: SQL.DML.OTHER
--   source_files: v50.docx
--   source_sections: п.1.27
-- ============================================================================
PROCEDURE v50_SQL_REF_SELECT_p_1_27 IS
	v_cl_priv_ref REF [CL_PRIV];
	v_ref_cursor SYS_REFCURSOR;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: курсор по REF переменной
		for rec in (select a from v_cl_priv_ref) loop
			null;
		end loop;

		-- Вариант 2: SELECT в переменную из REF
		select * into v_ref_cursor from v_cl_priv_ref;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		-- Вариант 1: прямой SELECT из таблицы
		for rec in (select * from ::[CL_PRIV] where id in (select ...)) loop
			null;
		end loop;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 15: v50.STOR.DATE.п.2.2 - Замена DATE на DATE_TIME
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена DATE на DATE_TIME
--   Подробное описание: В PostgreSQL тип DATE не хранит время. Использовать тип DATE_TIME (timestamp(0)).
--   Пример кода для корректировки: DateTimeEnd date;
--   Пример исправленного кода: DateTimeEnd date_time;
--   Теги: date, type, timestamp
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: В PostgreSQL тип DATE не хранит время. Использовать тип DATE_TIME (timestamp(0)). При вычитании дат использовать to_number(to_char(date1-date2)).
--   plplus_materials_note: Тип DATE в PL+ отображается на Oracle DATE. Для DBI нужен DATE_TIME. В PostgreSQL TIMESTAMP-TIMESTAMP возвращает INTERVAL.
--   search_prompt: Найти объявления переменных, параметров и реквизитов типа DATE.
--   regex_patterns.for_search: (?<!\[)\bdate\b(?!\s*\[)
--   regex_patterns.for_ignore: TO_DATE\s*\(; '.*date.*'
--   code_example_bad: DateTimeEnd date;
--   code_example_bad2: p_date in date
--   fix_instruction: Заменить тип DATE на DATE_TIME. Для вычитания дат использовать to_number(to_char(date1-date2)).
--   fix_prompt: Выполни замену типа DATE на DATE_TIME. Проверь операции с датами.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.STOR.DATE.п.2.2' с объявлениями DATE.
--   examples.variable.bad: DateTimeEnd date;
--   examples.variable.good: DateTimeEnd date_time;
--   examples.parameter.bad: p_date in date
--   examples.parameter.good: p_date in date_time
--   priority: medium
--   category: STOR
--   subcategory: STOR.TYPES
--   source_files: v50.docx
--   source_sections: п.2.2
-- ============================================================================
PROCEDURE v50_STOR_DATE_p_2_2 IS
	DateTimeEnd DATE_TIME;
	v_bad_date DATE;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		v_bad_date := sysdate;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		DateTimeEnd := sysdate;
	-- end pl/sql
END;

-- ============================================================================
-- Правило 16: v50.STOR.TEMP.п.2.8 - Замена временных таблиц на VARRAY
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена временных таблиц на VARRAY
--   Подробное описание: Временные таблицы приводят к проблемам производительности. Заменять на VARRAY (до 10 000 записей).
--   Пример кода для корректировки: create global temporary table t (id number)
--   Пример исправленного кода: type t_varray is varray(10000) of number
--   Теги: temp table, varray
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Временные таблицы приводят к проблемам производительности (pg_catalog bloat). Заменять на VARRAY (до 10 000 записей) или использовать init_temp_table(). Для таблиц «на сессию» предварительно очищать.
--   plplus_materials_note: GLOBAL TEMPORARY TABLE не рекомендуется в DBI. Альтернатива — VARRAY или table of.
--   search_prompt: Найти создание и использование GLOBAL TEMPORARY TABLE, TEMP TABLE.
--   regex_patterns.for_search: \bCREATE\s+GLOBAL\s+TEMPORARY\s+TABLE\b
--   regex_patterns.for_ignore: ^\s*--.*TEMPORARY
--   code_example_bad: create global temporary table t (id number) on commit preserve rows
--   fix_instruction: Заменить GLOBAL TEMPORARY TABLE на VARRAY: type t_varray is varray(10000) of ...
--   fix_prompt: Преобразуй временную таблицу в VARRAY.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.STOR.TEMP.п.2.8' с временными таблицами.
--   examples.varray.bad: create global temporary table t (id number)
--   examples.varray.good: type t_varray is varray(10000) of number
--   priority: medium
--   category: STOR
--   subcategory: STOR.TABLES
--   source_files: v50.docx
--   source_sections: п.2.8
-- ============================================================================
PROCEDURE v50_STOR_TEMP_p_2_8 IS
	TYPE t_numbers_varray IS VARRAY(10000) OF NUMBER;
	v_array t_numbers_varray;
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		create global temporary table t (id number) on commit preserve rows;
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		type t_numbers_varray is varray(10000) of number;
		v_array := t_numbers_varray();
	-- end pl/sql
END;

-- ============================================================================
-- Правило 17: v50.STOR.UNIQUE_IDX.п.2.6.2 - NULL в составных уникальных индексах
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: NULL в составных уникальных индексах
--   Подробное описание: В PostgreSQL NULL значения входят в состав индекса. Для составных уникальных индексов, где все поля NULL, повторная вставка вызовет исключение. В Oracle — нет.
--   Пример кода для корректировки: CREATE UNIQUE INDEX idx ON t (c1, c2);
--   Пример исправленного кода: очистка дублей
--   Теги: unique index, null
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: В PostgreSQL NULL значения входят в состав индекса. Для составных уникальных индексов, где все поля NULL, повторная вставка вызовет исключение. В Oracle — нет. Требуется очистка дублей.
--   plplus_materials_note: Платформа создает уникальные составные индексы с параметром NULLS NOT DISTINCT для максимальной совместимости с Oracle, но поведение отличается.
--   search_prompt: Найти уникальные индексы на нескольких полях, где возможны NULL значения.
--   regex_patterns.for_search: \bCREATE\s+UNIQUE\s+INDEX\b.*\bON\b.*\(
--   code_example_bad: CREATE UNIQUE INDEX idx ON t (c1, c2); INSERT INTO t (c1,c2) VALUES (null, null);
--   fix_instruction: Если в таблице есть дубликаты записей с NULL в ключевых полях, необходимо избавиться от дублей перед миграцией на PostgreSQL.
--   fix_prompt: Выполни очистку дублей с NULL в уникальных индексах.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.STOR.UNIQUE_IDX.п.2.6.2'.
--   priority: high
--   category: STOR
--   subcategory: STOR.INDEXES
--   source_files: v50.docx
--   source_sections: п.2.6.2
-- ============================================================================
PROCEDURE v50_STOR_UNIQUE_IDX_p_2_6_2 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		CREATE UNIQUE INDEX idx ON t (c1, c2);
		INSERT INTO t (c1,c2) VALUES (null, null);
		INSERT INTO t (c1,c2) VALUES (null, null);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		DELETE FROM t WHERE rowid NOT IN (SELECT MIN(rowid) FROM t GROUP BY c1, c2);
	-- end pl/sql
END;

-- ============================================================================
-- Правило 18: v50.STOR.INDEX.п.2.6.3 - Учёт ограничения 2704 байт для BTREE
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Учёт ограничения 2704 байт для BTREE
--   Подробное описание: Размер строки BTREE индекса не более 2704 байт. При превышении переходить на GIST/GIN индексы.
--   Пример кода для корректировки: create index idx on t(long_text)
--   Пример исправленного кода: create index idx on t using gin(long_text gin_trgm_ops)
--   Теги: index, btree, size, limit
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Размер строки BTREE индекса не более 2704 байт. При превышении переходить на GIST/GIN индексы с опциями gist_trgm_ops или gin_trgm_ops. GIN быстрее при поиске, но медленнее при вставке.
--   plplus_materials_note: В зоне риска индексы с суммой текстовых полей > 676 символов (2704/4).
--   search_prompt: Найти создание индексов на текстовых полях. Проверить потенциальное превышение 2704 байт.
--   regex_patterns.for_search: \bCREATE\s+INDEX\b
--   code_example_bad: create index idx on t(long_text)
--   fix_instruction: Если размер индексируемых полей > 676 символов, заменить BTREE на GIN: create index idx on t using gin(long_text gin_trgm_ops). Для LIKE использовать gist_trgm_ops.
--   fix_prompt: Проанализируй индексируемые поля. При необходимости замени BTREE на GIST/GIN.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.STOR.INDEX.п.2.6.3' с индексами.
--   examples.gin.bad: create index idx on t(long_text)
--   examples.gin.good: create index idx on t using gin(long_text gin_trgm_ops)
--   priority: high
--   category: STOR
--   subcategory: STOR.INDEXES
--   source_files: v50.docx
--   source_sections: п.2.6.3
-- ============================================================================
PROCEDURE v50_STOR_INDEX_p_2_6_3 IS
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		create index idx on t(long_text);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		create index idx on t using gin(long_text gin_trgm_ops);
	-- end pl/sql
END;

-- ============================================================================
-- Правило 19: v50.PROC.CRYPTO.п.3.1.2 - Замена dbms_crypto на INT_EXT_CALL_001
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена dbms_crypto на INT_EXT_CALL_001
--   Подробное описание: Пакет dbms_crypto недоступен. Использовать ::[PCORE_INTERFACE].[INT_EXT_CALL_001].
--   Пример кода для корректировки: dbms_crypto.hash(src, dbms_crypto.hash_md5)
--   Пример исправленного кода: ::[PCORE_INTERFACE].[INT_EXT_CALL_001].HSH_B(...)
--   Теги: crypto, security, hash
-- 4.RUBRICATOR_PROMPTS.json (дополнительно):
--   documentation_text: Пакет dbms_crypto недоступен. Использовать ::[PCORE_INTERFACE].[INT_EXT_CALL_001]. Функции encrypt/decrypt требуют дополнительных параметров p_al, p_mod, p_pad.
--   plplus_materials_note: DBMS_CRYPTO — Oracle пакет, не поддерживается в DBI.
--   search_prompt: Найти вызовы DBMS_CRYPTO функций.
--   regex_patterns.for_search: \bDBMS_CRYPTO\.\w+\b
--   regex_patterns.for_ignore: ^\s*--.*DBMS_CRYPTO
--   code_example_bad: dbms_crypto.hash(src, dbms_crypto.hash_md5)
--   fix_instruction: Заменить DBMS_CRYPTO на ::[PCORE_INTERFACE].[INT_EXT_CALL_001]. Для hash/mac/randombytes меняется только имя библиотеки.
--   fix_prompt: Выполни замену DBMS_CRYPTO на INT_EXT_CALL_001.
--   test_generation_prompt: Сгенерируй тестовый PLPlus файл для проверки правила 'v50.PROC.CRYPTO.п.3.1.2' с вызовами DBMS_CRYPTO.
--   examples.hash.bad: dbms_crypto.hash(src, dbms_crypto.hash_md5)
--   examples.hash.good: ::[PCORE_INTERFACE].[INT_EXT_CALL_001].HSH_B(...)
--   priority: high
--   category: PROC
--   subcategory: PROC.PACKAGES
--   source_files: v50.docx
--   source_sections: п.3.1.2
-- ============================================================================
PROCEDURE v50_PROC_CRYPTO_p_3_1_2 IS
	v_src CLOB := 'test data';
	v_hash RAW(2000);
BEGIN
	-- [-] НЕПРАВИЛЬНО
	-- begin pl/sql
		v_hash := dbms_crypto.hash(v_src, dbms_crypto.HASH_MD5);
	-- end pl/sql

	-- [+] ПРАВИЛЬНО
	-- begin pl/sql
		v_hash := ::[PCORE_INTERFACE].[INT_EXT_CALL_001].HSH_B(v_src, ::[PCORE_INTERFACE].[INT_EXT_CALL_001].H_2);
	-- end pl/sql
END;

-- ============================================================================
-- Правило 20: v50.PROC.SMTP.п.3.1.3 - Замена utl_smtp на INT_EMAIL_001
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена utl_smtp на INT_EMAIL_001
--   Подробное описание: Пакет utl_smtp недоступен. Использовать ::[PCORE_INTERFACE].[INT_EMAIL_001].
--   Пример кода для корректировки: utl_smtp.mail(...)
