	TenTbl('9').fval := 'девяносто';	TenTbl('9').sval := 'девяностого';

	/*------------------------------Сотни------------------------------*/
	HunTbl('0').fval := '';				HunTbl('0').sval := 'сотого';
	HunTbl('1').fval := 'сто';			HunTbl('1').sval := 'сотого';
	HunTbl('2').fval := 'двести';       HunTbl('2').sval := 'двухсотого';
	HunTbl('3').fval := 'триста';       HunTbl('3').sval := 'трехсотого';
	HunTbl('4').fval := 'четыреста';    HunTbl('4').sval := 'четырехсотого';
	HunTbl('5').fval := 'пятьсот';      HunTbl('5').sval := 'пятисотого';
	HunTbl('6').fval := 'шестьсот';     HunTbl('6').sval := 'шестисотого';
