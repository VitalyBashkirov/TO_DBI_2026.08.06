# Автоопределение текстовых/бинарных файлов
* text=auto

# Явные правила для типов, где важен EOL
*.py    text eol=lf
*.json  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf
*.ps1   text eol=lf

*.md    text eol=crlf
*.txt   text eol=crlf
*.bat   text eol=crlf
*.vbs   text eol=crlf

# Бинарные файлы (без преобразования EOL)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.zip   binary
*.exe   binary
*.dll   binary
*.pyc   binary
*.pyo   binary