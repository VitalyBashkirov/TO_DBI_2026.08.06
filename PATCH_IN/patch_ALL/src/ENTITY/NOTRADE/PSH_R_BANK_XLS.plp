class NOTRADE;

@import_plsql(true)
@this(plsql_lock:=false)
@name('[ПСБ] Распечатать реестры по Банку в Excel')
@tag('COPIED')
method PSH_R_BANK_XLS is

@name('V_DEST') public V_DEST [STRING_32000];
dp number:=0; --управление debug_pipe
s01_810_810_IN  [SUMMA]; s02_810_810_IN  [SUMMA]; s00_810_810_IN  [SUMMA];
s01_810_840_IN  [SUMMA]; s02_810_840_IN  [SUMMA]; s00_810_840_IN  [SUMMA];
s01_810_978_IN  [SUMMA]; s02_810_978_IN  [SUMMA]; s00_810_978_IN  [SUMMA];
s01_810_Nul_IN  [SUMMA]; s02_810_Nul_IN  [SUMMA]; s00_810_Nul_IN  [SUMMA];
s01_840_810_IN  [SUMMA]; s02_840_810_IN  [SUMMA]; s00_840_810_IN  [SUMMA];
s01_840_840_IN  [SUMMA]; s02_840_840_IN  [SUMMA]; s00_840_840_IN  [SUMMA];
s01_840_978_IN  [SUMMA]; s02_840_978_IN  [SUMMA]; s00_840_978_IN  [SUMMA];
s01_840_Nul_IN  [SUMMA]; s02_840_Nul_IN  [SUMMA]; s00_840_Nul_IN  [SUMMA];
s01_978_810_IN  [SUMMA]; s02_978_810_IN  [SUMMA]; s00_978_810_IN  [SUMMA];
s01_978_840_IN  [SUMMA]; s02_978_840_IN  [SUMMA]; s00_978_840_IN  [SUMMA];
s01_978_978_IN  [SUMMA]; s02_978_978_IN  [SUMMA]; s00_978_978_IN  [SUMMA];
s01_978_Nul_IN  [SUMMA]; s02_978_Nul_IN  [SUMMA]; s00_978_Nul_IN  [SUMMA];
s01_810_810_OUT [SUMMA]; s02_810_810_OUT [SUMMA]; s00_810_810_OUT [SUMMA];
s01_810_840_OUT [SUMMA]; s02_810_840_OUT [SUMMA]; s00_810_840_OUT [SUMMA];
s01_810_978_OUT [SUMMA]; s02_810_978_OUT [SUMMA]; s00_810_978_OUT [SUMMA];
s01_810_Nul_OUT [SUMMA]; s02_810_Nul_OUT [SUMMA]; s00_810_Nul_OUT [SUMMA];
s01_840_810_OUT [SUMMA]; s02_840_810_OUT [SUMMA]; s00_840_810_OUT [SUMMA];
s01_840_840_OUT [SUMMA]; s02_840_840_OUT [SUMMA]; s00_840_840_OUT [SUMMA];
s01_840_978_OUT [SUMMA]; s02_840_978_OUT [SUMMA]; s00_840_978_OUT [SUMMA];
s01_840_Nul_OUT [SUMMA]; s02_840_Nul_OUT [SUMMA]; s00_840_Nul_OUT [SUMMA];
s01_978_810_OUT [SUMMA]; s02_978_810_OUT [SUMMA]; s00_978_810_OUT [SUMMA];
s01_978_840_OUT [SUMMA]; s02_978_840_OUT [SUMMA]; s00_978_840_OUT [SUMMA];
s01_978_978_OUT [SUMMA]; s02_978_978_OUT [SUMMA]; s00_978_978_OUT [SUMMA];
s01_978_Nul_OUT [SUMMA]; s02_978_Nul_OUT [SUMMA]; s00_978_Nul_OUT [SUMMA];

s03_840_978_IN  [SUMMA];
s03_840_978_OUT  [SUMMA];
s03_978_840_IN  [SUMMA];
s03_978_840_OUT  [SUMMA];
PSH_R_BANK_XLS (
	@name('Кассир')       P_CASHIER    in [USER_REF],
	@name('Дата с')       P_START_DATE in [DATE],
	@name('Дата по')      P_END_DATE   in [DATE],
	@name('Касса')        P_NOTRADE    in [S_NOTRADE],
	@name('Дата реестра') P_DATE       in [DATE]
) is

validate is
pragma macro(passport, 'kv.[NEW_CLIENT].[PASSPORT]|| '' '' ||kv.[NEW_CLIENT].[SERIA]|| '' '' ||kv.[NEW_CLIENT].[NUMBER]');
pragma MACRO(OPER_OUT_CODES,'(''SED_OP'',''COD_OP'',''VCV_OP'',''VCR_OP'')');
pragma MACRO(OPER_IN_CODES,'(''BUD_OP'',''BUC_OP'',''CDR_OP'',''CDD_OP'',''PCV_OP'',''PCR_OP'')');

vFileName 	varchar2(250); -- имя Excel-шаблона
i_line integer;
delta integer:=3;
fmt   string(10):='dd.mm.yyyy';
fmtH24 string(18):='HH24:MI';
vCodeOper [SHORT2]; --C_CODE_OPER
vCodeAcc [STRING_3]; --C_CUR_IN
vAmount [SUMMA]; --C_SUM_IN
vCodeAccOut [STRING_3]; --C_CUR_OUT
vAmountOut [SUMMA]; --C_SUM_OUT
vRate [SUMMA_16_6];
vPlasticCard string(1); --C_PLASTIC_CARD
vChecksAmount number; --C_CHECKS_AMOUNT
vChecksCurrency [STRING_3]; --C_CHECKS_CURRENCY

vChecksSumma [SUMMA]; --C_CHECKS_SUMMA
vAccountNum [ACCNUM]; --C_ACCOUNT_NUM
vIsLetter string(1); --C_IS_LETTER
vCountry varchar2(3); --C_COUNTRY
vClientName [SBRF_NAME]; --C_CLIENT_NAME
vClientDocument [STRING_250]; --C_CLIENT_DOCUMENT
vClientAddress [STRING_250]; --C_CLIENT_ADDRESS
vIPDL [STRING_3]; --C_IPDL
vBirthDayPlace string(300); --C_BIRTH_DAY_PLACE

procedure SetCACHIER
is
begin
	if P_NOTRADE is not null then
		for reg in P_NOTRADE.[ARR_REGISTER] where reg.[DATE] = P_DATE loop
			P_CASHIER := reg.[USER_CASH];
			exit;
		end loop;
	end if;		
end;



begin
	if P_MESSAGE = 'DEFAULT' then -- первый запуск процедуры
		s01_810_810_IN  :=0; s02_810_810_IN  :=0; s00_810_810_IN  :=0;
		s01_810_840_IN  :=0; s02_810_840_IN  :=0; s00_810_840_IN  :=0;
		s01_810_978_IN  :=0; s02_810_978_IN  :=0; s00_810_978_IN  :=0;
		s01_810_Nul_IN  :=0; s02_810_Nul_IN  :=0; s00_810_Nul_IN  :=0;
		s01_840_810_IN  :=0; s02_840_810_IN  :=0; s00_840_810_IN  :=0;
		s01_840_840_IN  :=0; s02_840_840_IN  :=0; s00_840_840_IN  :=0;
		s01_840_978_IN  :=0; s02_840_978_IN  :=0; s00_840_978_IN  :=0;
		s01_840_Nul_IN  :=0; s02_840_Nul_IN  :=0; s00_840_Nul_IN  :=0;
		s01_978_810_IN  :=0; s02_978_810_IN  :=0; s00_978_810_IN  :=0;
		s01_978_840_IN  :=0; s02_978_840_IN  :=0; s00_978_840_IN  :=0;
		s01_978_978_IN  :=0; s02_978_978_IN  :=0; s00_978_978_IN  :=0;
		s01_978_Nul_IN  :=0; s02_978_Nul_IN  :=0; s00_978_Nul_IN  :=0;
		s01_810_810_OUT :=0; s02_810_810_OUT :=0; s00_810_810_OUT :=0;
		s01_810_840_OUT :=0; s02_810_840_OUT :=0; s00_810_840_OUT :=0;
		s01_810_978_OUT :=0; s02_810_978_OUT :=0; s00_810_978_OUT :=0;
		s01_810_Nul_OUT :=0; s02_810_Nul_OUT :=0; s00_810_Nul_OUT :=0;
		s01_840_810_OUT :=0; s02_840_810_OUT :=0; s00_840_810_OUT :=0;
		s01_840_840_OUT :=0; s02_840_840_OUT :=0; s00_840_840_OUT :=0;
		s01_840_978_OUT :=0; s02_840_978_OUT :=0; s00_840_978_OUT :=0;
		s01_840_Nul_OUT :=0; s02_840_Nul_OUT :=0; s00_840_Nul_OUT :=0;
		s01_978_810_OUT :=0; s02_978_810_OUT :=0; s00_978_810_OUT :=0;
		s01_978_840_OUT :=0; s02_978_840_OUT :=0; s00_978_840_OUT :=0;
		s01_978_978_OUT :=0; s02_978_978_OUT :=0; s00_978_978_OUT :=0;
		s01_978_Nul_OUT :=0; s02_978_Nul_OUT :=0; s00_978_Nul_OUT :=0;
		
		s03_840_978_IN  :=0;
		s03_840_978_OUT :=0;
		s03_978_840_IN  :=0;
		s03_978_840_OUT :=0;

		[EXCEL].Init_Xls;
		stdio.close_all;
		stdio.disable_buf;
		p_info := 'OK';
		
		--P_NOTRADE := this;
		--begin
		--	for reg in this.[ARR_REGISTER] order by reg.[DATE] desc loop
		--		P_DATE := reg.[DATE];
		--		exit;
		--	end loop;	
		--end;		
		
		P_DATE := nvl(P_DATE,trunc(sysdate));
		-- P_DATE :=to_date(20/03/2020, 'DD/MM/YYYY');
		
		-- SetCACHIER;
		
		P_CASHIER := null; --::[USER](USERNAME = 'SHERBAKOVA_SV');
		P_START_DATE:=DATEFUN.bom(P_DATE);
		P_END_DATE  :=P_DATE;
		
	elsif P_MESSAGE = 'VALIDATE' then
		debug_pipe('p_info='||p_info||' length(V_DEST)='||length(V_DEST), dp);
		
		--if p_info = 'P_DATE' or p_info = 'P_NOTRADE' then
		--	SetCACHIER;
		--end if;
				
		if p_info = 'OK' then
		
			--if P_DATE is Null then
			--	pragma error('Необходимо указать дату реестра');
			--end if;		
			--if P_NOTRADE is Null then
			--	pragma error('Необходимо указать кассу');
			--end if;
			--if P_CASHIER is Null then
			--	pragma error('Необходимо указать кассира');
			--end if;
			
			--P_START_DATE := to_date(P_DATE, 'DD/MM/YYYY');
			--P_END_DATE   := to_date(P_DATE, 'DD/MM/YYYY');
			if P_START_DATE is null or P_END_DATE is null or P_START_DATE>P_END_DATE then
				pragma error('Укажите "Дата с" и "Дата по" корректно');
			end if;
			
		  --executor.set_context('RPT_CASHIER', P_CASHIER);
			executor.set_context('RPT_BEG_DATE', to_char(nvl(P_START_DATE, to_date('01.01.1900', fmt)), fmt));
			executor.set_context('RPT_END_DATE', to_char(nvl(P_END_DATE, to_date('01.01.2050', fmt)), fmt));
		  --executor.set_context('RPT_POINT', P_NOTRADE);
			executor.set_context('TUNE_COUNTRY', true);
			executor.set_context('TUNE_CLIENT', true);
			executor.set_context('TUNE_LETTER', true);		
			

			if excel.F_Click then
				excel.F_Click := False;
				
				vFileName := 'PSH_REESTR_136_I _Bank.xlt'; --'PSH_REESTR_136_I.xlt';
				[EXCEL].open_file(::[REPS].[SLIB].GetPath('PATH_PRINT_EXCEL', vFileName),false);
				
				--[EXCEL].Write(7, 5, P_NOTRADE.[NAME_PK]||','||NL$|| 'адрес: ' || P_NOTRADE.[ADDRESS] ); -- Наименование внутреннего структурного подразделения Банка и его местонахождение (адрес)
				--
				--[EXCEL].Write(9, 5, substr(to_char(P_START_DATE,'DDMMYYYY'),1,1) ); -- Дата заполнения Реестра
				--[EXCEL].Write(9, 6, substr(to_char(P_START_DATE,'DDMMYYYY'),2,1) );
				--[EXCEL].Write(9, 8, substr(to_char(P_START_DATE,'DDMMYYYY'),3,1) );
				--[EXCEL].Write(9, 9, substr(to_char(P_START_DATE,'DDMMYYYY'),4,1) );
				--[EXCEL].Write(9, 11, substr(to_char(P_START_DATE,'DDMMYYYY'),5,1) );
				--[EXCEL].Write(9, 12, substr(to_char(P_START_DATE,'DDMMYYYY'),6,1) );
				--[EXCEL].Write(9, 13, substr(to_char(P_START_DATE,'DDMMYYYY'),7,1) );
				--[EXCEL].Write(9, 14, substr(to_char(P_START_DATE,'DDMMYYYY'),8,1) );
				--
				--for reg in P_NOTRADE.[ARR_REGISTER] where reg.[DATE] = P_DATE and reg.[USER_CASH] =  P_CASHIER loop -- Порядковый номер Реестра в течение рабочего дня
				--	[EXCEL].Write(12, 8, ''''||reg.[NUM] );
				--	exit;
				--end loop;	
				[EXCEL].Write(  3, 4, 'операций с наличной валютой и чеками с '||to_char(P_START_DATE,fmt)||' по '||to_char(P_END_DATE,fmt));
				
				i_line := 9; --20;
				/** / 
				for (select kv(	to_char(kv.[C_NUM_OPER])								: C_NUM_OPER,
			          	kv.[C_DATE_OPER]												: C_DATE_OPER,
				        kv.[C_CODE_OPER]												: C_CODE_OPER,
				        trim(to_char(kv.[C_RATE_OPER], '9999999999999999999990.000000')): C_RATE_OPER,
				        kv.[C_CUR_IN]													: C_CUR_IN,
				        trim(to_char(kv.[C_SUM_IN], '9999999999999999999990.00'))		: C_SUM_IN,
				        kv.[C_CUR_OUT]													: C_CUR_OUT,
				        trim(to_char(kv.[C_SUM_OUT], '9999999999999999999990.00'))		: C_SUM_OUT,
				        kv.[C_PLASTIC_CARD]												: C_PLASTIC_CARD,
				        to_char(kv.[C_CHECKS_AMOUNT])									: C_CHECKS_AMOUNT,
				        to_char(kv.[C_CHECKS_CURRENCY])									: C_CHECKS_CURRENCY,
				        trim(to_char(kv.[C_CHECKS_SUMMA], '9999999999999999999990.00'))	: C_CHECKS_SUMMA,
				        to_char(kv.[C_COMMISS_CURRENCY])								: C_COMMISS_CURRENCY,
				        trim(to_char(kv.[C_COMMISS_SUMMA], '9999999999999999999990.00')): C_COMMISS_SUMMA,
				        kv.[C_ACCOUNT_NUM]												: C_ACCOUNT_NUM,
				        kv.[C_IS_LETTER]												: C_IS_LETTER,
				        kv.[C_COUNTRY]													: C_COUNTRY,
				        kv.[C_CLIENT_NAME]												: C_CLIENT_NAME,
				        kv.[C_CLIENT_DOCUMENT]											: C_CLIENT_DOCUMENT,
				        kv.[C_CLIENT_ADDRESS]											: C_CLIENT_ADDRESS,
				        trim(to_char(kv.[C_SUM_TAXE], '9999999999999999999990.00'))		: C_SUM_TAXE,
				        kv.[C_RESIDENT]													: C_RESIDENT,
				        kv.[C_IPDL]														: C_IPDL,
				        kv.[C_BIRTH_DAY_PLACE]											: C_BIRTH_DAY_PLACE,
				        to_char(kv.[C_NUM_OPER])										: C_SORT_COLUMN1,
				        kv.[C_DATE_OPER]												: C_SORT_COLUMN2,
				        '0'																: C_TOTAL,
				        '0'																: C_HEADER,
				        kv.[id]															: id)
				in VW_RPT_PSH_EXCHG_REGS_EL%rowtype
				order by kv.[C_NUM_OPER],  kv.[C_DATE_OPER], kv.[C_CUR_OUT]
				)
				/**/
				debug_pipe('->'||to_char(P_START_DATE,fmt)||'-'||to_char(P_END_DATE,fmt)
					||' Касса:'||P_NOTRADE.[NUM_PK]
					||' Кассир:'||stdlib.FIO(P_CASHIER.[NAME],'Ф И.О.')
					,dp);
				for kv in ::[KASSA_V] all
				where P_START_DATE<=trunc(kv.[DATE]) and trunc(kv.[DATE])<=P_END_DATE --Дата
				and nvl(P_CASHIER,kv.[USER_CASH])=kv.[USER_CASH]
				and nvl(P_NOTRADE,kv.[NUM_POINT])=kv.[NUM_POINT]
				and not kv%state='DELETED' --Башкиров В.Г. 22.11.2024
				order by trunc(kv.[DATE]), kv.[NUM_POINT], kv.[USER_EXEC], kv.[DOCUMENT_NUM] 
				loop
					
					[EXCEL].Copy_Text(i_line, 1, i_line, delta+28);
					[EXCEL].Ins_Row(i_line+1);
					
					[EXCEL].Write(i_line, 1, to_char(kv.[DATE],fmt));
					[EXCEL].Write(i_line, 2, ''''||kv.[NUM_POINT].[NUM_PK]);
					[EXCEL].Write(i_line, 3, stdlib.FIO(kv.[USER_CASH].[NAME],'Ф И.О.'));
					
					[EXCEL].Write(i_line, delta+1, kv.[DOCUMENT_NUM]);							--kv.C_NUM_OPER );
					[EXCEL].Write(i_line, delta+2, to_char(kv.[DATE],fmtH24));					--kv.C_DATE_OPER );
					
					vCodeOper:=to_char(kv.[KOD_OPER]->[NUM], '00');
					[EXCEL].Write(i_line, delta+3, ''''||vCodeOper);	--kv.C_CODE_OPER );
					
					--vRate:=DECODE(kv.[RATE], 0, Null, DECODE(kv.[RATE], 1, Null, kv.[RATE]));
					if    kv.[RATE]=0 then	vRate:=null;
					elsif kv.[RATE]=1 then	vRate:=null;
					else					vRate:= kv.[RATE];
					end if;
					[EXCEL].Write(i_line, delta+4, nvl(vRate,1));	--nvl(kv.C_RATE_OPER, 1) );
					
					vCodeAcc:=null; --C_CUR_IN
					if kv.[KOD_OPER].[KOD_OPER] not in &OPER_IN_CODES then
						vCodeAcc:=nvl(kv.[REQ_INPUT].[CURRENCY].[CODE_ACC], kv.[REQ_INPUT].[CURRENCY].[CODE_ISO]);
					end if;
					[EXCEL].Write(i_line, delta+5, ''''||vCodeAcc);  --kv.C_CUR_IN );
					
					vAmount:=null; --C_SUM_IN
					if kv.[KOD_OPER].[KOD_OPER] not in &OPER_IN_CODES or kv.[REQ_INPUT].[CURRENCY] is null then
						vAmount:=kv.[REQ_INPUT].[AMOUNT];
					end if;
					[EXCEL].Write(i_line, delta+8, vAmount); --kv.C_SUM_IN );
					
					vCodeAccOut:=null; --C_CUR_OUT
					if kv.[KOD_OPER].[KOD_OPER] not in &OPER_OUT_CODES then
						vCodeAccOut:=nvl(kv.[REQ_OUTPUT].[CURRENCY].[CODE_ACC], kv.[REQ_OUTPUT].[CURRENCY].[CODE_ISO]);
					end if;
					[EXCEL].Write(i_line, delta+13, ''''||vCodeAccOut); --kv.C_CUR_OUT );
					
					vAmountOut:=null; --C_SUM_OUT
					if kv.[KOD_OPER].[KOD_OPER] not in &OPER_OUT_CODES and kv.[REQ_OUTPUT].[CURRENCY] is not null then
						vAmountOut:=kv.[REQ_OUTPUT].[AMOUNT];
					end if;
					[EXCEL].Write(i_line, delta+16, vAmountOut); --kv.C_SUM_OUT );
					
					vPlasticCard:=null;
					if kv.[KOD_OPER].[NUM] in (14, 15, 16, 17) then vPlasticCard:='X'; end if;
					[EXCEL].Write(i_line, delta+17, vPlasticCard); --kv.C_PLASTIC_CARD );

					if kv.[KOD_OPER].[KOD_OPER] in &OPER_OUT_CODES or kv.[KOD_OPER].[KOD_OPER] in &OPER_IN_CODES then
						vChecksAmount:=kv.[ARR_CHECKS]%size(0); --(select x(count(1)) in kv.[ARR_CHECKS])
					end if;
					[EXCEL].Write(i_line, delta+18,vChecksAmount); --kv.C_CHECKS_AMOUNT );

					vChecksCurrency:=null; --C_CHECKS_CURRENCY
					if kv.[KOD_OPER].[KOD_OPER] in &OPER_OUT_CODES then		vChecksCurrency:=kv.[REQ_OUTPUT].[CURRENCY].[CODE_ISO];
					elsif kv.[KOD_OPER].[KOD_OPER] in &OPER_IN_CODES then	vChecksCurrency:=kv.[REQ_INPUT].[CURRENCY].[CODE_ISO];
					end if;
					[EXCEL].Write(i_line, delta+19,''''||vChecksCurrency); --kv.C_CHECKS_CURRENCY );
					
					
					vChecksSumma:=null; --C_CHECKS_SUMMA
					if kv.[KOD_OPER].[KOD_OPER] in &OPER_OUT_CODES   then	vChecksSumma:=kv.[REQ_OUTPUT].[AMOUNT];
					elsif kv.[KOD_OPER].[KOD_OPER] in &OPER_IN_CODES then	vChecksSumma:=kv.[REQ_INPUT].[AMOUNT];
					end if;
					[EXCEL].Write(i_line, delta+20, vChecksSumma); --kv.C_CHECKS_SUMMA );

					vAccountNum:=null; --C_ACCOUNT_NUM
					if substr(kv.[MAIN_DOC].[ACC_DT].[MAIN_V_ID],1,5)='20202' then	vAccountNum:=kv.[MAIN_DOC].[ACC_KT].[MAIN_V_ID];
					else															vAccountNum:=kv.[MAIN_DOC].[ACC_DT].[MAIN_V_ID];
					end if;
					[EXCEL].Write(i_line, delta+21,''''||vAccountNum); --kv.C_ACCOUNT_NUM );
					
					vIsLetter:=null; --C_IS_LETTER
					if kv.[LETTER] then vIsLetter:='X';
					else Null;
					end if;
					[EXCEL].Write(i_line, delta+22,vIsLetter); --kv.C_IS_LETTER );
					
					vCountry:=null; --C_COUNTRY
					vCountry:=coalesce(::[NOTRADE].[LIB_RPT].CountryCode136(kv, SYS_CONTEXT(USER_CONTEXT, 'TUNE_COUNTRY'))
						--Башкиров В.Г. 22.11.2024
						,kv.[NEW_CLIENT].[COUNTRY].[CODE]
						,kv.[NEW_CLIENT].[CLIENTREF].[COUNTRY].[CODE]);
					[EXCEL].Write(i_line, delta+23,''''||vCountry); --kv.C_COUNTRY );
					
					vClientName:=null; --C_CLIENT_NAME
					vClientName:=kv.[NEW_CLIENT].[NAME];
					[EXCEL].Write(i_line, delta+24,vClientName); --kv.C_CLIENT_NAME );

					vClientDocument:=null; --C_CLIENT_DOCUMENT
					vClientDocument:=&passport;
					[EXCEL].Write(i_line, delta+25,vClientDocument); --kv.C_CLIENT_DOCUMENT );
					
					vClientAddress:=null; --C_CLIENT_ADDRESS
					vClientAddress:=kv.[NEW_CLIENT].[ADDR];
					[EXCEL].Write(i_line, delta+26,vClientAddress); --kv.C_CLIENT_ADDRESS );
					
					vIPDL:=null; --C_IPDL
					if kv.[NEW_CLIENT].[NAME] is not null then 
						vIPDL:='Нет';
					end if;
					[EXCEL].Write(i_line, delta+27,vIPDL); --kv.C_IPDL );
					
					vBirthDayPlace:=null; --C_BIRTH_DAY_PLACE
					vBirthDayPlace:=to_char(kv.[NEW_CLIENT].[BIRTHDAY], fmt)||' '||kv.[NEW_CLIENT].[BIRTH_PLACE];
					[EXCEL].Write(i_line, delta+28,vBirthDayPlace); --kv.C_BIRTH_DAY_PLACE);
					
					if vCodeOper='01' and vCodeAccOut   ='810' then
						if vCodeOper='01' and vCodeAcc   ='810' then s01_810_810_IN :=s01_810_810_IN +nvl(vAmount   ,0); end if;
						if vCodeOper='01' and vCodeAcc   ='840' then s01_840_810_IN :=s01_840_810_IN +nvl(vAmount   ,0); end if;
						if vCodeOper='01' and vCodeAcc   ='978' then s01_978_810_IN :=s01_978_810_IN +nvl(vAmount   ,0); end if;
						--if vCodeOper='01' and(vCodeAcc is null or vCodeAcc not in ('810','840','978')) 
						--										   then s01_Nul_810_IN :=s01_Nul_810_IN +nvl(vAmount   ,0); end if;
					end if;
					if vCodeOper='01' and vCodeAccOut   ='840' then
						if vCodeOper='01' and vCodeAcc   ='810' then s01_810_840_IN :=s01_810_840_IN +nvl(vAmount   ,0); end if;
						if vCodeOper='01' and vCodeAcc   ='840' then s01_840_840_IN :=s01_840_840_IN +nvl(vAmount   ,0); end if;
						if vCodeOper='01' and vCodeAcc   ='978' then s01_978_840_IN :=s01_978_840_IN +nvl(vAmount   ,0); end if;
						--if vCodeOper='01' and(vCodeAcc is null or vCodeAcc not in ('810','840','978')) 
						--										   then s01_Nul_840_IN :=s01_Nul_840_IN +nvl(vAmount   ,0); end if;
					end if;
					if vCodeOper='01' and vCodeAccOut   ='878' then
						if vCodeOper='01' and vCodeAcc   ='810' then s01_810_978_IN :=s01_810_978_IN +nvl(vAmount   ,0); end if;
						if vCodeOper='01' and vCodeAcc   ='840' then s01_840_978_IN :=s01_840_978_IN +nvl(vAmount   ,0); end if;
						if vCodeOper='01' and vCodeAcc   ='978' then s01_978_978_IN :=s01_978_978_IN +nvl(vAmount   ,0); end if;
						--if vCodeOper='01' and(vCodeAcc is null or vCodeAcc not in ('810','840','978')) 
						--										   then s01_Nul_978_IN :=s01_Nul_978_IN +nvl(vAmount   ,0); end if;
					end if;

					if vCodeOper='01' and vCodeAcc   ='810' then
						if vCodeOper='01' and vCodeAccOut='810' then s01_810_810_OUT:=s01_810_810_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='01' and vCodeAccOut='840' then s01_810_840_OUT:=s01_810_840_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='01' and vCodeAccOut='978' then s01_810_978_OUT:=s01_810_978_OUT+nvl(vAmountOut,0); end if;
						--if vCodeOper='01' and(vCodeAccOut is null or vCodeAccOut not in ('810','840','978')) 
						--										   then s01_810_Nul_OUT:=s01_810_Nul_OUT+nvl(vAmountOut,0); end if;
					end if;
					if vCodeOper='01' and vCodeAcc   ='840' then
						if vCodeOper='01' and vCodeAccOut='810' then s01_840_810_OUT:=s01_840_810_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='01' and vCodeAccOut='840' then s01_840_840_OUT:=s01_840_840_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='01' and vCodeAccOut='978' then s01_840_978_OUT:=s01_840_978_OUT+nvl(vAmountOut,0); end if;
						--if vCodeOper='01' and(vCodeAccOut is null or vCodeAccOut not in ('810','840','978')) 
						--										   then s01_840_Nul_OUT:=s01_840_Nul_OUT+nvl(vAmountOut,0); end if;
					end if;
					if vCodeOper='01' and vCodeAcc   ='978' then
						if vCodeOper='01' and vCodeAccOut='810' then s01_978_810_OUT:=s01_978_810_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='01' and vCodeAccOut='840' then s01_978_840_OUT:=s01_978_840_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='01' and vCodeAccOut='978' then s01_978_978_OUT:=s01_978_978_OUT+nvl(vAmountOut,0); end if;
						--if vCodeOper='01' and(vCodeAccOut is null or vCodeAccOut not in ('810','840','978')) 
						--										   then s01_978_Nul_OUT:=s01_978_Nul_OUT+nvl(vAmountOut,0); end if;
					end if;
					
					if vCodeOper='02' and vCodeAccOut='810' then
						if vCodeOper='02' and vCodeAcc='810' then s02_810_810_IN:=s02_810_810_IN+nvl(vAmount,0); end if;
						if vCodeOper='02' and vCodeAcc='840' then s02_840_810_IN:=s02_840_810_IN+nvl(vAmount,0); end if;
						if vCodeOper='02' and vCodeAcc='978' then s02_978_810_IN:=s02_978_810_IN+nvl(vAmount,0); end if;
						--if vCodeOper='02' and(vCodeAcc is null or vCodeAccOut not in ('810','840','978')) 
						--										then s02_Nul_810_IN:=s02_Nul_810_IN+nvl(vAmount,0); end if;
					end if;
					if vCodeOper='02' and vCodeAccOut='840' then
						if vCodeOper='02' and vCodeAcc='810' then s02_810_840_IN:=s02_810_840_IN+nvl(vAmount,0); end if;
						if vCodeOper='02' and vCodeAcc='840' then s02_840_840_IN:=s02_840_840_IN+nvl(vAmount,0); end if;
						if vCodeOper='02' and vCodeAcc='978' then s02_978_840_IN:=s02_978_840_IN+nvl(vAmount,0); end if;
						--if vCodeOper='02' and(vCodeAcc is null or vCodeAccOut not in ('810','840','978')) 
						--										then s02_Nul_840_IN:=s02_Nul_840_IN+nvl(vAmount,0); end if;
					end if;
					if vCodeOper='02' and vCodeAccOut='978' then
						if vCodeOper='02' and vCodeAcc='810' then s02_810_978_IN:=s02_810_978_IN+nvl(vAmount,0); end if;
						if vCodeOper='02' and vCodeAcc='840' then s02_840_978_IN:=s02_840_978_IN+nvl(vAmount,0); end if;
						if vCodeOper='02' and vCodeAcc='978' then s02_978_978_IN:=s02_978_978_IN+nvl(vAmount,0); end if;
						--if vCodeOper='02' and(vCodeAcc is null or vCodeAccOut not in ('810','840','978')) 
						--										then s02_Nul_978_IN:=s02_Nul_978_IN+nvl(vAmount,0); end if;
					end if;

					if vCodeOper='02' and vCodeAcc='810' then
						if vCodeOper='02' and vCodeAccOut='810' then s02_810_810_OUT:=s02_810_810_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='02' and vCodeAccOut='840' then s02_810_840_OUT:=s02_810_840_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='02' and vCodeAccOut='978' then s02_810_978_OUT:=s02_810_978_OUT+nvl(vAmountOut,0); end if;
						--if vCodeOper='02' and(vCodeAccOut is null or vCodeAccOut not in ('810','840','978')) 
						--										   then s02_810_Nul_OUT:=s02_810_Nul_OUT+nvl(vAmountOut,0); end if;
					end if;
					if vCodeOper='02' and vCodeAcc='840' then
						if vCodeOper='02' and vCodeAccOut='810' then s02_840_810_OUT:=s02_840_810_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='02' and vCodeAccOut='840' then s02_840_840_OUT:=s02_840_840_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='02' and vCodeAccOut='978' then s02_840_978_OUT:=s02_840_978_OUT+nvl(vAmountOut,0); end if;
						--if vCodeOper='02' and(vCodeAccOut is null or vCodeAccOut not in ('810','840','978')) 
						--										   then s02_840_Nul_OUT:=s02_840_Nul_OUT+nvl(vAmountOut,0); end if;
					end if;
					if vCodeOper='02' and vCodeAcc='978' then
						if vCodeOper='02' and vCodeAccOut='810' then s02_978_810_OUT:=s02_978_810_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='02' and vCodeAccOut='840' then s02_978_840_OUT:=s02_978_840_OUT+nvl(vAmountOut,0); end if;
						if vCodeOper='02' and vCodeAccOut='978' then s02_978_978_OUT:=s02_978_978_OUT+nvl(vAmountOut,0); end if;
						--if vCodeOper='02' and(vCodeAccOut is null or vCodeAccOut not in ('810','840','978')) 
						--										   then s02_978_Nul_OUT:=s02_978_Nul_OUT+nvl(vAmountOut,0); end if;
					end if;

					if vCodeOper='03' and vCodeAcc='978' and vCodeAccOut='840' then
						s03_978_840_IN  :=s03_978_840_IN +nvl(vAmount,0);
						s03_978_840_OUT :=s03_978_840_OUT+nvl(vAmountOut,0);
					end if;
					if vCodeOper='03' and vCodeAcc='840' and vCodeAccOut='978' then
						s03_840_978_IN  :=s03_840_978_IN +nvl(vAmount,0);
						s03_840_978_OUT :=s03_840_978_OUT+nvl(vAmountOut,0);
					end if;

					/** /
					if nvl(vCodeOper,'00') not in ('01','02') and vCodeAcc   ='810' then s00_810_IN :=s00_810_IN +nvl(vAmount   ,0); end if;
					if nvl(vCodeOper,'00') not in ('01','02') and vCodeAcc   ='840' then s00_840_IN :=s00_840_IN +nvl(vAmount   ,0); end if;
					if nvl(vCodeOper,'00') not in ('01','02') and vCodeAcc   ='978' then s00_978_IN :=s00_978_IN +nvl(vAmount   ,0); end if;
					if nvl(vCodeOper,'00') not in ('01','02') and(vCodeAcc is null or vCodeAccOut not in ('810','840','978'))
																			 then s00_Nul_IN :=s00_Nul_IN +nvl(vAmount   ,0); end if;
					
					if nvl(vCodeOper,'00') not in ('01','02') and vCodeAccOut='810' then s00_810_OUT:=s00_810_OUT+nvl(vAmountOut,0); end if;
					if nvl(vCodeOper,'00') not in ('01','02') and vCodeAccOut='840' then s00_840_OUT:=s00_840_OUT+nvl(vAmountOut,0); end if;
					if nvl(vCodeOper,'00') not in ('01','02') and vCodeAccOut='978' then s00_978_OUT:=s00_978_OUT+nvl(vAmountOut,0); end if;
					if nvl(vCodeOper,'00') not in ('01','02') and(vCodeAccOut is null or vCodeAccOut not in ('810','840','978')) 
																			 then s00_Nul_OUT:=s00_Nul_OUT+nvl(vAmountOut,0); end if;
					/**/
					debug_pipe(rpad(i_line,7)||': '||to_char(kv.[DATE],fmt)||' '||kv.[NUM_POINT].[NUM_PK]
					||' '||rpad(stdlib.FIO(kv.[USER_CASH].[NAME],'Ф И.О.'),30)
					||' Док.№'||rpad(kv.[DOCUMENT_NUM],3)
					,dp);
					i_line:=i_line+1;
				end loop;
				[EXCEL].Delete_row(i_line);
				
				i_line := i_line + 2;
				
				/** /
				for (select ttl(	'Итого'												: C_NUM_OPER,
			          	'по реестру'													: C_DATE_OPER,
				        ttl.[C_CODE_OPER]												: C_CODE_OPER,
				        trim(to_char(ttl.[C_RATE_OPER], '9999999999999999999990.000000'))	: C_RATE_OPER,
				        ttl.[C_CUR_IN]													: C_CUR_IN,
				        trim(to_char(sum(ttl.[C_SUM_IN]), '9999999999999999999990.00'))	: C_SUM_IN,
				        ttl.[C_CUR_OUT]													: C_CUR_OUT,
				        trim(to_char(sum(ttl.[C_SUM_OUT]), '9999999999999999999990.00')): C_SUM_OUT,
				        ' '																: C_PLASTIC_CARD,
				        to_char(sum(ttl.[C_CHECKS_AMOUNT]))								: C_CHECKS_AMOUNT,
				        to_char(ttl.[C_CHECKS_CURRENCY])								: C_CHECKS_CURRENCY,
				        trim(to_char(sum(ttl.[C_CHECKS_SUMMA]), '9999999999999999999990.00')) : C_CHECKS_SUMMA,
				        to_char(ttl.[C_COMMISS_CURRENCY])								: C_COMMISS_CURRENCY,
				        trim(to_char(sum(ttl.[C_COMMISS_SUMMA]), '9999999999999999999990.00')): C_COMMISS_SUMMA,
				        ' '																: C_ACCOUNT_NUM,
				        ' '																: C_IS_LETTER,
				        ' ' 															: C_COUNTRY,
				        ' '																: C_CLIENT_NAME,
				        ' '																: C_CLIENT_DOCUMENT,
				        ' '																: C_CLIENT_ADDRESS,
				        trim(to_char(sum(ttl.[C_SUM_TAXE]), '9999999999999999999990.00'))	: C_SUM_TAXE,
				        ' '																: C_RESIDENT,
				        '9999'															: C_SORT_COLUMN1,
				        '99:99'															: C_SORT_COLUMN2,
				        '1'																: C_TOTAL,
				        '0'																: C_HEADER,
				        0																: id)
					in VW_RPT_PSH_EXCHG_REGS_EL%rowtype
					group by ttl.[C_CODE_OPER], ttl.[C_RATE_OPER], ttl.[C_CUR_IN], ttl.[C_CUR_OUT], ttl.[C_CHECKS_CURRENCY], ttl.[C_COMMISS_CURRENCY]
					order by ttl.[C_CODE_OPER], ttl.[C_CUR_IN], ttl.[C_RATE_OPER]
					)
				
				loop
					[EXCEL].Copy_Text(i_line, 1, i_line, 28);
					[EXCEL].Ins_Row(i_line+1);
					
				  --[EXCEL].Write(i_line, delta+1, ttl.C_NUM_OPER );
				  --[EXCEL].Write(i_line, delta+2, ttl.C_DATE_OPER );
					[EXCEL].Write(i_line, delta+3, ttl.C_CODE_OPER );
					[EXCEL].Write(i_line, delta+4, ttl.C_RATE_OPER );
					[EXCEL].Write(i_line, delta+5, ttl.C_CUR_IN );
					[EXCEL].Write(i_line, delta+8, ttl.C_SUM_IN );
					[EXCEL].Write(i_line, delta+13,ttl.C_CUR_OUT );
					[EXCEL].Write(i_line, delta+16,ttl.C_SUM_OUT );
					[EXCEL].Write(i_line, delta+17,ttl.C_PLASTIC_CARD );
					[EXCEL].Write(i_line, delta+18,ttl.C_CHECKS_AMOUNT );
					[EXCEL].Write(i_line, delta+19,ttl.C_CHECKS_CURRENCY );
					[EXCEL].Write(i_line, delta+20,ttl.C_CHECKS_SUMMA );
					
					i_line:=i_line+1;
				end loop;
				/**/
					debug_pipe('Итоги(1): '||rpad(i_line,7),dp);

					[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+1);
					[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+2);
				  --[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+3);

					[EXCEL].Write(i_line+0, delta+1, 'Итого по реестру');
					[EXCEL].Write(i_line+0, delta+3, '01'); [EXCEL].Write(i_line+0, delta+5, '840'); [EXCEL].Write(i_line+0, delta+ 8,  s01_840_810_IN);
															[EXCEL].Write(i_line+0, delta+13,'810'); [EXCEL].Write(i_line+0, delta+16,  s01_840_810_OUT);
					[EXCEL].Write(i_line+1, delta+3, '01'); [EXCEL].Write(i_line+1, delta+5, '978'); [EXCEL].Write(i_line+1, delta+ 8,  s01_978_810_IN);
															[EXCEL].Write(i_line+1, delta+13,'810'); [EXCEL].Write(i_line+1, delta+16,  s01_978_810_OUT);
				  --[EXCEL].Write(i_line+2, delta+3, '01'); [EXCEL].Write(i_line+2, delta+5, 'XXX'); [EXCEL].Write(i_line+2, delta+ 8,  s01_Nul_IN);
				  --										[EXCEL].Write(i_line+2, delta+13,'XXX'); [EXCEL].Write(i_line+2, delta+16,  s01_Nul_OUT);
					i_line:=i_line+2;
					debug_pipe('Итоги(2): '||rpad(i_line,7),dp);

					[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+1);
					[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+2);
				  --[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+3);

					[EXCEL].Write(i_line+0, delta+1, 'Итого по реестру');
					[EXCEL].Write(i_line+0, delta+3, '02'); [EXCEL].Write(i_line+0, delta+5, '810'); [EXCEL].Write(i_line+0, delta+ 8,  s02_810_840_IN);
															[EXCEL].Write(i_line+0, delta+13,'840'); [EXCEL].Write(i_line+0, delta+16,  s02_810_840_OUT);
					[EXCEL].Write(i_line+1, delta+3, '02'); [EXCEL].Write(i_line+1, delta+5, '810'); [EXCEL].Write(i_line+1, delta+ 8,  s02_810_978_IN);
															[EXCEL].Write(i_line+1, delta+13,'978'); [EXCEL].Write(i_line+1, delta+16,  s02_810_978_OUT);
				  --[EXCEL].Write(i_line+2, delta+3, '02'); [EXCEL].Write(i_line+2, delta+5, 'XXX'); [EXCEL].Write(i_line+2, delta+8,  s02_Nul_IN);
				  --										[EXCEL].Write(i_line+2, delta+13,'XXX'); [EXCEL].Write(i_line+2, delta+8,  s02_Nul_OUT);
					i_line:=i_line+2;
					debug_pipe('Итоги(3): '||rpad(i_line,7),dp);
					
					if s03_840_978_IN>0 or s03_840_978_OUT>0 or s03_978_840_IN>0 or s03_978_840_OUT>0 then
						[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+1);
						[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+2);
					  --[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+3);
	
						[EXCEL].Write(i_line+0, delta+1, 'Итого по реестру');
						[EXCEL].Write(i_line+0, delta+3, '03'); [EXCEL].Write(i_line+0, delta+5, '840'); [EXCEL].Write(i_line+0, delta+ 8,  s03_840_978_IN);
																[EXCEL].Write(i_line+0, delta+13,'978'); [EXCEL].Write(i_line+0, delta+16,  s03_840_978_OUT);
						[EXCEL].Write(i_line+1, delta+3, '03'); [EXCEL].Write(i_line+1, delta+5, '978'); [EXCEL].Write(i_line+1, delta+ 8,  s03_978_840_IN);
																[EXCEL].Write(i_line+1, delta+13,'840'); [EXCEL].Write(i_line+1, delta+16,  s03_978_840_OUT);
					  --[EXCEL].Write(i_line+2, delta+3, '03'); [EXCEL].Write(i_line+2, delta+5, 'XXX'); [EXCEL].Write(i_line+2, delta+8,  s02_Nul_IN);
					  --										[EXCEL].Write(i_line+2, delta+13,'XXX'); [EXCEL].Write(i_line+2, delta+8,  s02_Nul_OUT);
						i_line:=i_line+2;
						debug_pipe('Итоги(4): '||rpad(i_line,7),dp);
					end if;
/** /
					[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+1);
					[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+2);
				  --[EXCEL].Copy_Text(i_line, 1, i_line, 28); [EXCEL].Ins_Row(i_line+3);

					[EXCEL].Write(i_line+0, delta+1, 'Итого по реестру');
					[EXCEL].Write(i_line+0, delta+3, '00'); [EXCEL].Write(i_line+0, delta+5, 'XXX'); [EXCEL].Write(i_line+0, delta+ 8,  s00_810_IN);
															[EXCEL].Write(i_line+0, delta+13,'XXX'); [EXCEL].Write(i_line+0, delta+16,  s00_810_840_OUT);
					[EXCEL].Write(i_line+1, delta+3, '00'); [EXCEL].Write(i_line+1, delta+5, 'XXX'); [EXCEL].Write(i_line+1, delta+ 8,  s00_810_IN);
															[EXCEL].Write(i_line+1, delta+13,'XXX'); [EXCEL].Write(i_line+1, delta+16,  s00_810_978_OUT);
				  --[EXCEL].Write(i_line+2, delta+3, '00'); [EXCEL].Write(i_line+2, delta+5, 'XXX'); [EXCEL].Write(i_line+2, delta+ 8,  s00_Nul_IN);
				  --										[EXCEL].Write(i_line+2, delta+13,'XXX'); [EXCEL].Write(i_line+2, delta+16,  s00_Nul_OUT);
					i_line:=i_line+2;
					debug_pipe('Итоги(4): '||rpad(i_line,7),dp);
/**/
				[EXCEL].Delete_row(i_line);
				[EXCEL].Write(i_line+1, 5, P_NOTRADE.[NUM_PK]);
				[EXCEL].Write(i_line+2, 5, ::[RUNTIME].[STDLIB].FIO(P_CASHIER.[NAME]));
				
				excel.Visible;							--Перевод Excel в режим отображения данных
				excel.Release;							--Закрытие COM интерфейса Excel сервера
			end if;

			excel.Exec_Script(V_DEST);
		end if;
	end if;
end;
end;
end;
