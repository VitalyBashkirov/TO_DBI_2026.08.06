class USER;

@import_plsql(true)
@this(create_on_start:=true)
@name('[ПСБ] Изменить')
@tag('COPIED')
method PSH_EDIT#AUTO is

@name('Признак наличия в системе доступа') public V#SECURITY [BOOLEAN];
@name('Обработка формы')                   public V_DEST_STR [STRING_32000];
PSH_EDIT#AUTO (
	@name('Фамилия Имя Отчество')             P#NAME         in [STRING_100],
	@name('Сетевое имя')                      P#USERNAME     in [STRING_30],
	@name('Добавить в систему доступа')       P#SECURITY_ADD in [BOOLEAN],
	@name('Удалить из системы доступа')       P#SECURITY_DEL in [BOOLEAN],
	@name('Номер ответственного исполнителя') P#OTVET        in [STRING_5],
	@name('Должность')                        P#CASTA        in [CASTA_REF],
	@name('Подразделение')                    P#DEPART       in [DEPART_REF],
	@name('Физическое лицо')                  P#CL_PRIV_REF  in [CL_PRIV_REF],
	@name('Признаки должностного лица')       P#MARK_PERS    in [MARK_PERS_ARR],
	@name('Основание подписи')                P_BY_RIGHT     in [SIGN_BY_RIGH_ARR] default null,
	@name('Подписывает сегодня')              P_SIGN_TODAY   in [BOOLEAN]          default null
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P#NAME := this.[NAME];
	P#USERNAME := this.[USERNAME];
	P#OTVET := this.[OTVET];
	P#CASTA := this.[CASTA];
	P#DEPART := this.[DEPART];
	P#CL_PRIV_REF := this.[CL_PRIV_REF];
	P#MARK_PERS := this.[MARK_PERS];
	P_BY_RIGHT := this.[BY_RIGHT];
	P_SIGN_TODAY := this.[SIGN_TODAY];

end if;
-- End initialization of parameters and variables
declare
need_group boolean;

begin
	if P_MESSAGE = 'DEFAULT' then
		[CSMD].Init_Form(V_DEST_STR, &METHOD$CLASS, &METHOD$SNAME); -- Инициализация формы
		
		if P#USERNAME is null then
			[CSMD].Command(V_DEST_STR, 'P_USERNAME.locked = 0');
		end if;

		P_INFO := 'P#USERNAME,P#SECURITY_ADD,P#SECURITY_DEL';
		
		-- Установка значений параметров
		P#NAME := [NAME];										-- Фамилия Имя Отчество
		P#USERNAME := [USERNAME];								-- Сетевое имя
		V#SECURITY := Secadmin.CheckUser(P#USERNAME);			-- Признак наличия в ситеме доступа
		P#SECURITY_ADD := false;								-- Признак добавления в систему доступа
		P#SECURITY_DEL := false;								-- Признак удаления из системы доступа
	
	elsif P_MESSAGE = 'VALIDATE' Then
		P#SECURITY_ADD := P#SECURITY_ADD and not V#SECURITY;	-- Признак добавления в систему доступа
		P#SECURITY_DEL := P#SECURITY_DEL and V#SECURITY;		-- Признак удаления из системы доступа
		
		if p_info = 'P#USERNAME' and [USERNAME] is null then
			P#USERNAME := upper(P#USERNAME);
		end if;
		
		--if p_info = 'OK' and P#DEPART.[CODE] like '001-6%' then
		if p_info = 'OK' then
			 need_group := false;
			
			for bos_kas in ::[PSH_BOS_KASSES] where bos_kas.[PSH_KASSA].[DEPART] = P#DEPART loop
				need_group := nvl(bos_kas.[PSH_BUH_KASS], false);
			end loop;
			
			if need_group and Security.Check_Equal(P#USERNAME, 'KAS_WO_PODTV') !='1' then
				SECADMIN.Insert_User_To_Group(P#USERNAME, 'KAS_WO_PODTV');
			elsif not need_group and Security.Check_Equal(P#USERNAME, 'KAS_WO_PODTV') ='1' then
				SECADMIN.Delete_User_From_Group(P#USERNAME, 'KAS_WO_PODTV');
			end if;
		end if;
			
	end if;
end;
end;

execute is
V#USER				[USER_REF];					-- Ссылка на пользователя
ascii_user_name		integer;
is_dep_ch			boolean;
begin
	if P#NAME is null then
		pragma Error('Фамилия Имя Отчество не определено!');
	end if;

	if P#DEPART is null and P#USERNAME = OWNER then
		pragma error('У владельца схемы должно быть указано подразделение');
	end if;
	
	if P#USERNAME is null and V#SECURITY then
		pragma error('Сетевое имя не определено!');
	end if;
	
	if [USERNAME] is not null and P#USERNAME != [USERNAME] then
		pragma error('Нельзя изменять сетевое имя пользователя!');
	end if;
	
	begin
		locate V#USER in ::[USER] all where V#USER.[NAME] = P#NAME and V#USER.[USERNAME] = P#USERNAME and V#USER != this;
		
		if V#USER.[USERNAME] is null and V#USER.[BEG_DATE] is not null then
			pragma error('Уже есть сотрудник с Фамилией Именем Отчеством ' || P#NAME || ' и сетевым именем ' || P#USERNAME);
		else
			pragma error('Уже есть пользователь с Фамилией Именем Отчеством ' || P#NAME || ' и сетевым именем ' || P#USERNAME);
		end if;
	
	exception when NO_DATA_FOUND then
		null;
	end;
	
	for i in 1 .. nvl(length(P#USERNAME), 0) loop							-- Mishin. BFS00031015
		ascii_user_name := ascii(substr(P#USERNAME, i, 1));
		
		if not ((ascii_user_name >= 65 and ascii_user_name <= 90) or		-- A..Z
				(ascii_user_name >= 97 and ascii_user_name <= 122) or		-- a..z
				(ascii_user_name >= 48 and ascii_user_name <= 57) or		-- 0..9
				(ascii_user_name = 95)) then								-- '_'
			pragma error('Сетевое имя должно состоять только из символов A..Z, a..z, 0..9, - и _!');
		end if;
		
		if i = 1 and ((ascii_user_name >= 48 and ascii_user_name <= 57) or ascii_user_name = 95) then
			pragma error('Сетевое имя не должно начинаться на цифру или _ !');
		end if;
	end loop;

	begin
		locate V#USER in ::[USER] all where V#USER.[USERNAME] = P#USERNAME and V#USER != this;
		
		pragma error('Пользователь с сетевым именем ' || P#USERNAME || ' уже существует');
	
	exception when NO_DATA_FOUND then
		null;
	end;

	if P#SECURITY_ADD and P#USERNAME is not null then
		Secadmin.CreateUser(P#USERNAME, P#NAME);
	elsif P#SECURITY_DEL then
		Secadmin.DeleteUser(P#USERNAME);
	elsif [NAME] != P#NAME and V#SECURITY then
		Secadmin.EditUser(P#USERNAME, P#NAME);
	end If;

    -- BS00083081 - Закрытие сессий пользователя при смене его подразделения
    if nvl([DEPART]%id, 0) != nvl(P#DEPART%id, 0) and P#USERNAME is not null then
    	is_dep_ch := true;   		
    end if;

    -- Установка значений реквизитов
	[NAME] := P#NAME;			-- Фамилия Имя Отчество
	[USERNAME] := P#USERNAME;	-- Сетевое имя
	[OTVET] := P#OTVET;			-- Номер ответственного исполнитиля
	[CASTA] := P#CASTA;
	[DEPART] := P#DEPART;
	[FILIAL] := nvl(P#DEPART.[FILIAL], ::[SYSTEM].[VARIABLES].OurBranch);
	[CL_PRIV_REF] := P#CL_PRIV_REF;
	[SIGN_TODAY] := P_SIGN_TODAY;	
	if is_dep_ch then
		commit; -- BS00157077
		rtl.send_events(9, 'CLOSE', P#USERNAME);
	end if;
end;
end;
end;
