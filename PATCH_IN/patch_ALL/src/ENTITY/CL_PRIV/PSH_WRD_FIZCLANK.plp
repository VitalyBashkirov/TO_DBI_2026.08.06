				)
				loop
					P_DATA := to_char(x.date_end, 'dd.mm.yyyy');
				end loop;	
--Адреса	
			elsif p_info = 'РЕГ_АДРЕС_СТР' then
				for (select x(x.[IMP_STR] : imp_str,
						x.[CITY].[NAME] : city)
					in client_priv.[ADDRESSES]
					where x.[TYPE].[KOD] = 'REGISTRATION'
					)
				loop
					P_DATA := null;
					for (select y(y : idy)
						in ::[CIT_OBJ]
						where y.[OBJ_ID] = client_priv%id and 
							y.[CIT_AB] in ([CIT_ABONENT]([CODE] = 'BSS'), [CIT_ABONENT]([CODE] = 'CRS'), [CIT_ABONENT]([CODE] = 'ETO'))
					)
					loop
						P_DATA := x.city || ', ';
					end loop;
					P_DATA := rtrim(P_DATA || x.imp_str, ', ');
				end loop;
			elsif p_info = 'ФАКТ_АДРЕС_СТР'	then
				for (select x(x.[IMP_STR] : imp_str,
						x.[CITY].[NAME] : city)
					in client_priv.[ADDRESSES]
					where x.[TYPE].[KOD] = 'REAL_LIVE'
					)
				loop
					P_DATA := null;
					for (select y(y : idy)
						in ::[CIT_OBJ]
						where y.[OBJ_ID] = client_priv%id and 
							y.[CIT_AB] in ([CIT_ABONENT]([CODE] = 'BSS'), [CIT_ABONENT]([CODE] = 'CRS'), [CIT_ABONENT]([CODE] = 'ETO'))
					)
					loop
						P_DATA := x.city || ', ';
					end loop;
					P_DATA := rtrim(P_DATA || x.imp_str, ', ');
				end loop;
			elsif p_info = 'РЕГ_АДРЕС' then      --Адрес регистрации
