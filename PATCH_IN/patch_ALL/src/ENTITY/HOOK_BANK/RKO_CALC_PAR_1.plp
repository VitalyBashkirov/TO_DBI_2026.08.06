		if P_PAR = 'ОРЛ_БЮДЖЕТ' then
			if mn_ref.[BUDGET_PAYMENT] then
				if mn_ref.[PRIORITET]>=5 then
					varRet:= '0'; goto nnn;
				else
					varRet:= '1'; goto nnn;
				end if;
			else
				varRet:= '0'; goto nnn;
			end if;
		end if;
		
		if P_PAR = 'ОРЛ_ПЛ_ДБ' then
			vacc := P_PROD->([RKO])[ACCOUNT];
			declare
				sm number;
				sm_nt number;
				smx number;
			begin
				sm := 0;
				sm_nt := 0;
				smx := 0;
				smx:=mn_ref.[SUM];
				if mn_ref%state = 'PROV' then
					dtt := trunc(mn_ref.[DATE_PROV]);
					--dtt := [SYSTEM]::[OP_DATE];
					dta := mn_ref.[ASTR_DATE_PROV];
				else
					dtt := [SYSTEM]::[OP_DATE];
					dta := [SYSTEM]::[OP_DATE]+1;
				end if;
				&debug(dtt||' '||dta,dp)
				--22.6.05
				&debug(vacc.[MAIN_V_ID]||' '||nvl(vacc.[GET_SALDO](dtt-1, sm, sm_nt, null),0)||' '||smx,dp)
				&debug(vacc.[MAIN_V_ID]||' '||nvl(vacc.[GET_SALDO](dtt, sm, sm_nt, null),0)||' '||smx,dp)
				for doo in CURSOR mndc_a Loop null;
					&debug(doo.COUNT_DOC||' '||doo.SUMMA,dp)
					if doo.SUMMA<=sm then
						varRet:= '0'; goto nnn;
					else
						varRet:= '1'; goto nnn;
					end if;
				end Loop;
			end;
		end if;
		
		&debug(TB$||'[11]',dp5)
		
		if P_PAR = 'ОРЛ_СУМ_ПР_ЗАЯ' then
			vacc := P_PROD->([RKO])[ACCOUNT];
			declare
				sm number;
				sk number;
				sp number;
				rko ref	[RKO];
				dc ref	[MAIN_DOCUM];
			begin
				begin
					sm := 0;
					sk := 0;
					sp := 0;
					dc := null;
					rko := P_PROD;
					
					if mn_ref%state = 'PROV' then
						dtt := trunc(mn_ref.[DATE_PROV]);
						dta := mn_ref.[ASTR_DATE_PROV];
					else
						dtt := [SYSTEM]::[OP_DATE];
						dta := [SYSTEM]::[OP_DATE]+1;
					end if;
					
					for s in rko.[DAILY] where s.[DAT] = trunc(nvl(mn_ref.[DATE_PROV],mn_ref.[DATE_DOC])) loop
						sk := sk + s.[TO_ARM];
						&debug('1 '||sk,dp)
					end loop;
					
					for doo in CURSOR mndc_kas Loop null;
						&debug(doo.dc||' '||doo.SM,dp)
						for ksim in doo.dc.[SUM_KSPL] loop
							if ksim.[1].[1]<>40 and ksim.[1].[1]<>50 then
								sm := sm + ksim.[2];
								--&debug('2 '||ksim.[2],dp)
								
								if sm <= sk then
									null;
								else
									if sp = 0 then
										sp := sm - sk;
									else
										sp := ksim.[2];
									end if;
								end if;
								
							end if;
						end loop;
						
						dc := mn_ref;
						if doo.dc = mn_ref then
							exit;
						end if;
					end Loop;
					
					&debug(sm||' '||sk||' '||sp,dp)
					varRet:= sp; goto nnn;
				exception
				when NO_DATA_FOUND then
					Null;
				end;
				varRet:= Null; goto nnn;
			end;
		end if;
	end if;
	

	--Башкиров В.Г. 20.01.2023
	if P_PROD%CLASS IN ('RKO','RKO_CUR') then
		refRko := P_PROD;
	end if;
	&debug(TB$||'[12] P_PAR='||P_PAR||' '||refRko%class||'.'||refRko%id||' refRko.[CLIENT]='||refRko.[CLIENT]%class||'.'||refRko.[CLIENT]%id||' '||refRko.[CLIENT].[NAME],dp5) 
	
	if P_PAR = 'ОБОРОТ_РКО' then
		d_Val:=coalesce(g_date_begin, md.[DATE_PROV],md.[DATE_VAL],refRko.[FILIAL].[OP_DATE],sysdate);
		date_begin:=DATEFUN.Bom(d_Val);
		date_end:=DATEFUN.Eom(d_Val);
		varRet := f.a('И'||refRko.[ACCOUNT]%id||'ДН', trunc(date_begin), trunc(date_end));
		&debug('(1)d_Val='||to_char(d_Val,fmt)||' g_date_begin='||to_char(g_date_begin,fmt)||' date_begin='||to_char(date_begin,fmt)||' date_end='||to_char(date_end,fmt)||' ОБОРОТ_РКО='||varRet,dp5)
	elsif P_PAR = 'ОБОРОТ_РКО_КТ' then
		d_Val:=coalesce(g_date_begin, md.[DATE_PROV],md.[DATE_VAL],refRko.[FILIAL].[OP_DATE],sysdate);
		date_begin:=DATEFUN.Bom(d_Val);
		date_end:=DATEFUN.Eom(d_Val);
		varRet := f.a('И'||refRko.[ACCOUNT]%id||'КН', trunc(date_begin), trunc(date_end));
		&debug('(2)d_Val='||to_char(d_Val,fmt)||' g_date_begin='||to_char(g_date_begin,fmt)||' date_begin='||to_char(date_begin,fmt)||' date_end='||to_char(date_end,fmt)||' ОБОРОТ_РКО='||varRet,dp5)
	elsif P_PAR = 'PSB_VIP' then --[ПСБ] VIP-тариф RKO.CALC_PAR
		varRet:='0';
		d_Val:=coalesce(md.[DATE_PROV],md.[DATE_VAL],refRko.[FILIAL].[OP_DATE],sysdate);
		for (select tp(tp.[TAR_PLAN].[CODE] : C_TAR_PLAN_CODE) in refRko.[TARIF_PLAN] 
		where tp.[DATE_BEGIN]<=d_Val
		order by tp.[DATE_BEGIN] desc)
		loop
			if tp.C_TAR_PLAN_CODE like '%VIP%' then
 					varRet:='1';				
			end if;
			exit;
		end loop;
	elsif P_PAR = 'PSB_3_MONTH' then --[ПСБ] 3 месяца с даты регистрации на момент открытия счета
		varRet:='0';
		ClRef:=refRko.[CLIENT];
		&debug(TB$||'[13] '||clRef%class||'.'||clRef%id||' '||clRef.[NAME],dp5)
		if ClRef%class='CL_ORG' then 
			ClOrgRef:=ClRef%id;
			d_Registr:=coalesce(ClOrgRef.[REGISTER].[DATE_REG],ClOrgRef.[REGISTER].[DATE_REESTR]);
			d_Val    :=coalesce(md.[DATE_PROV],md.[DATE_VAL],refRko.[FILIAL].[OP_DATE],sysdate);
			&debug('d_Val='||to_char(d_Val,fmt)||' d_Registr='||to_char(d_Registr,fmt)||' refRko.[ACCOUNT].[DATE_OP]='||to_char(refRko.[ACCOUNT].[DATE_OP],fmt),dp2)
			&debug(' MONTHS_BETWEEN(refRko.[ACCOUNT].[DATE_OP],d_Registr)='||MONTHS_BETWEEN(refRko.[ACCOUNT].[DATE_OP],d_Registr),dp2)
			&debug(' MONTHS_BETWEEN(d_Val,refRko.[ACCOUNT].[DATE_OP])    ='||MONTHS_BETWEEN(d_Val,refRko.[ACCOUNT].[DATE_OP]),dp2)
			if MONTHS_BETWEEN(refRko.[ACCOUNT].[DATE_OP],d_Registr)>=3 
			or MONTHS_BETWEEN(d_Val,refRko.[ACCOUNT].[DATE_OP])>=4 
			then
				varRet:='1';
			end if;
		end if;
	elsif P_PAR in ('PSB_CODE_DEPART','PSB_DEPART_CODE') then --[ПСБ] Код подразделения договора РКО
		varRet:=refRko.[DEPART].[CODE];
	elsif P_PAR='PSB_DOC_USER' then --Пользователь-создатель документа комиссии-пользователь, проведший основной документ
		&debug(TB$||'[12.0]',dp5) 
		
		varRet:=stdlib.userid.[NAME];
		BusinessOpDocRef:=::[PATTERN_DOC].[BUSINESS_OP].doc_ref; --Документ, с которого удерживается комиссия
		oBusinessOpDocRef:=BusinessOpDocRef;
		&debug('BusinessOpDocRef ->'||::[HOOK_BANK].[RKO_CALC_PAR_1].InfoDoc(BusinessOpDocRef),dp)
		
		if BusinessOpDocRef%class='MAIN_DOCUM' then --::[PATTERN_DOC].[BUSINESS_OP].doc_ref%class='MAIN_DOCUM' then
			&debug(TB$||'[12.1]',dp5) 

			if oBusinessOpDocRef.[ACC_DT].[MAIN_V_ID] like '4%' and oBusinessOpDocRef.[ACC_KT].[MAIN_V_ID] like '3%' 
			then
				&debug(TB$||'[12.2]',dp5) 
				PsbDocUser := nvl(::[FP_TUNE].[LIB].get_bool_value('PSB_DOC_USER', null, '0'), false);
				&debug('PsbDocUser='||PsbDocUser, dp)
				
				if PsbDocUser and oBusinessOpDocRef.[IN_FOLDER].[DOCS_IN_FOLD]%size(1)>0 then
					&debug(TB$||'[12.3]',dp5) 
					UserProvMainDoc := oBusinessOpDocRef.[PROV_USER];
					&debug('UserProvMainDoc='||UserProvMainDoc.[NAME], dp)
					
					if UserProvMainDoc is not null then
						&debug(TB$||'[12.4]',dp5) 
						for (select dif(dif.[DOCUMENT] : C_DOCUMENT) in oBusinessOpDocRef.[IN_FOLDER].[DOCS_IN_FOLD] 
						where dif.[DOCUMENT]%class='MAIN_DOCUM')
						loop
							&debug(TB$||'[12.5]',dp5) 
							md4:=dif.C_DOCUMENT;
							oMd4:=md4;
							/**/
							&debug('             md4 ->'||::[HOOK_BANK].[RKO_CALC_PAR_1].InfoDoc(md4),dp)
							
							if oMd4.[ACC_KT].[MAIN_V_ID] like '706%' and oMd4.[DOCUMENT_USER].[NAME] like 'Банковский Расчетный Центр%'
							then
								&debug(TB$||'[12.6]',dp5) 
								&debug('У документа комиссии ID:'||md4%id||' меняем Создателя "'||oMd4.[DOCUMENT_USER].[NAME]||'"->"'||UserProvMainDoc.[NAME]||'"', dp)
								md4.[DOCUMENT_USER]:=UserProvMainDoc;
							end if;
							/**/
						end loop;
					end if;
				end if;
			end if;
			
			/** /
			for dif in FolderPay.[DOCS_IN_FOLD] where dif.[DOCUMENT]%class='MAIN_DOCUM'
			loop
				md3:=dif.[DOCUMENT];
				oMd3:=md3;
				if oMd3.[ACC_KT].[MAIN_V_ID] like '70601%' and oMd3.[DOCUMENT_USER]<>stdlib.userid then
					md3.[DOCUMENT_USER]:=stdlib.userid;
				end if;
			end loop;
			/**/
		--[ПСБ]  Перевести депозит из "Помечен к закрытию" в "Работает" для документов шаблонов БО DEP_RET
		elsif P_PAR='PSB_DEP_RET' then
			&debug(TB$||'[12.7]',dp5)
			varRet:=P_PAR;
			for dif in FolderPay.[DOCS_IN_FOLD] where dif.[DOCUMENT]%class='MAIN_DOCUM'
			loop
				md3:=dif.[DOCUMENT];
				oMd3:=md3;
				AccountDepn:=oMd3.[ACC_DT];
				if AccountDepn.[MAIN_V_ID] like '423%' then
					&debug(TB$||'[12.8] Ищем депозит для '||AccountDepn.[MAIN_V_ID]||' в статусе "Помечен к закрытию"',dp5)
					for d in ::[DEPN] all 
					where d.[ACCOUNT]=AccountDepn and d.[COM_STATUS]=::[COM_STATUS_PRD]([CODE]='TO_CLOSE') 
					loop
						&debug(TB$||'[12.8] Вернем депозиту №'||d.[NUM_DOG]||' статус WORK',dp5)
						d.[COM_STATUS]:=::[COM_STATUS_PRD]([CODE]='WORK');
						exit;
					end loop;
				end if;
			end loop;
		end if;
	end if;
	
	--Ильин Д.А. 06.11.2024---
	if P_PAR = 'CHARGE' then
		declare
			charge [CHARGES];
		begin
			doc_rc := ::[DOCUM_RC]([MAIN_DOC] = md);
			charge := ::[CHARGES]([VALUE] = doc_rc.[CHARGPAY]);
			varRet := charge.[CODE];
		end;
	end if;
	if P_PAR = 'URGENCY' then
		doc_rc := ::[DOCUM_RC]([MAIN_DOC] = md);
		varRet := doc_rc.[HOWLONG];
	end if;
	if P_PAR = 'VAL_RC' then
		doc_rc := ::[DOCUM_RC]([MAIN_DOC] = md);
		varRet := doc_rc.[ISO];
	end if;
	if P_PAR = 'IS_OUR_BANK' then
		begin
			locate doc_rc in ::[DOCUM_RC] where doc_rc.[MAIN_DOC] = md;
			if doc_rc.[RECEIVER].[ACC] like '3%' then
				varRet := '1';
			else
				varRet := '0';
			end if;
		exception when NO_DATA_FOUND then
			varRet := '0';
		end;
	end if;
	if P_PAR = 'IS_DBO_DOC' then
		if md.[DOCUMENT_UNO] like 'DBO%' then
			varRet := '1';
		else varRet := '0';
		end if;
	end if;

	-->> VRI 05/02/2025 CFT-468 Внедрение новых тарифов http://jira.bank.local:8080/browse/CFT-468
	if P_PAR = 'PSB_COT_CHECK' then	-- Возвращает 1 , если документ проводится в послеоперационное время, иначе 0
		if md.[DOCUMENT_UNO] like 'DBO%' and to_number(to_char(md.[DATE_REC], 'sssss')) > ::[MAIN_DOCUM].[PSH_L].cut_off(md) and md.[DOCUMENT_DATE] = ::[SYSTEM].[OP_DATE] then -- Проверка на после операционное время по документам ДБО -- updated CHANGE_SHORT_NAME PSB_L->PSH_L 14/10/25
			varRet := '1';
		elsif (md.[DOCUMENT_UNO] not like 'DBO%' or md.[DOCUMENT_UNO] is null) and to_number(to_char(sysdate, 'sssss')) > (::[MAIN_DOCUM].[PSH_L].cut_off(md) - 3600) and md.[DOCUMENT_DATE] = ::[SYSTEM].[OP_DATE] then  -- Проверка на после операционное время по ручным документам (окончание на час раньше ДБО)
			varRet := '1'; 
		else varRet := '0';
		end if;
	end if;

	if P_PAR = 'PSB_TAR_PLAN' then	-- Возвращает код действующего тарифного плана по РКО
		varRet := 'Не найден привязанный тарифный план';
		if P_PROD%CLASS IN ('RKO','RKO_CUR') then
			refRko := P_PROD;
		end if;
		
		for (select tp(tp.[TAR_PLAN].[CODE] : C_TAR_PLAN) 
			in refRko.[TARIF_PLAN]
			where tp.[DATE_BEGIN] <= ::[SYSTEM].[OP_DATE] and coalesce(tp.[DATE_END], ::[SYSTEM].[OP_DATE]) >= ::[SYSTEM].[OP_DATE]
			order by tp.[DATE_BEGIN] desc
			fetch 1
		)
		loop
			varRet := tp.C_TAR_PLAN;
		end loop;
	end if;

	if P_PAR = 'PSB_VK_UNK' then	-- Возвращает 1 если при проводке мы исполняем функции агента ВК в рамках УНК, и 2 если не в рамках УНК 
		var hs ref [HISTORY_STATES];
		begin
			locate hs in md.[HISTORY_STATE] 
				where hs.[STATE] in ('PSB_UNK','PSB_UNK_SEL') 
					and not exists(select hs1(hs1)
									in md.[HISTORY_STATE]
									where hs1.[STATE] = 'RKO_COMISS' and hs1.[ADD_INFO] in ('PSB_DOC_VK_UNK', 'PSB_DOC_VK_NOT_UNK')  
								  )
				fetch 1;
			if hs.[ADD_INFO] = '1' then
				varRet := '1';
			elsif hs.[ADD_INFO] = '2' then
				varRet := '2';
			end if;
		exception when NO_DATA_FOUND then
			varRet := '0';
		end;		
	end if;
	
	if P_PAR = 'PSB_DOC_KL_BANK' then	-- Возвращает 1 если документ создан в клиент-банке, иначе 0 
		if      md.[DOCUMENT_UNO] like 'DBO%' 
			and md.[DT_SEND] = ::[RKC_DOC_STATES]([CODE]='IBANK2')
			and md.[DOCUMENT_USER] = ::[USER]([USERNAME] = 'IBANK')
		then
			varRet := '1';
		else varRet := '0';
		end if;
	end if;
	
	--<< VRI 05/02/2025 CFT-468
	
	-->> VRI 21/02/2025 CFT-982 Настройка Бизнес-операций Агентский платеж
	if P_PAR = 'PSB_DOC_RC_70' then	-- Возвращает значение поле 70 
		doc_rc := ::[DOCUM_RC].[LIB_VIEW].GETDOCRC(::[MAIN_DOCUM].[PSH_COMMIS_GT].V_DOC);
		varRet := replace(replace(doc_rc.[DEST], '{'), '}');
	end if;
	
	if P_PAR = 'PSB_DOC_RC_SUM' then	-- Возвращает сумму из документа РЦ 
		doc_rc := ::[DOCUM_RC].[LIB_VIEW].GETDOCRC(::[MAIN_DOCUM].[PSH_COMMIS_GT].V_DOC);
		varRet := doc_rc.[SUMMA];
	end if;

	if P_PAR = 'PSB_DOC_RC_CUR' then	-- Возвращает валюту из документа РЦ 
		doc_rc := ::[DOCUM_RC].[LIB_VIEW].GETDOCRC(::[MAIN_DOCUM].[PSH_COMMIS_GT].V_DOC);
		varRet := doc_rc.[ISO];
	end if;

	if P_PAR = 'PSB_DOC_RC_PAYER' then	-- Возвращает наименование плательщика из документа РЦ 
		doc_rc := ::[DOCUM_RC].[LIB_VIEW].GETDOCRC(::[MAIN_DOCUM].[PSH_COMMIS_GT].V_DOC);
		varRet := replace(replace(doc_rc.[PAYER].[NAME], '{'), '}');
		n := instr(varRet,  NL$) - 1;
		if n = -1 then n := length(varRet); end if;
		if varRet like '1/%' then
			varRet := substr(varRet, 3, n - 2);
		else
			varRet := substr(varRet, 1, n);
		end if;
		if varRet like '%.' or varRet like '%,' then
			varRet := substr(varRet, 1, length(varRet) - 1);
		end if;
	end if;

	if P_PAR = 'PSB_GT_SUM' then	-- Возвращает сумму платежа из удержания разовой комиссии 
		varRet := ::[MAIN_DOCUM].[PSH_COMMIS_GT].V_SUM_PL;
	end if;

	if P_PAR = 'PSB_GT_COM' then	-- Возвращает сумму комиссии из удержания разовой комиссии 
		varRet := ::[MAIN_DOCUM].[PSH_COMMIS_GT].V_SUM_COM; 
	end if;

	if P_PAR = 'PSB_GT_VO' then	-- Возвращает код VO из удержания разовой комиссии 
		varRet := ::[MAIN_DOCUM].[PSH_COMMIS_GT].V_CURR_CODE;
	end if;
	--<< VRI 21/02/2025 CFT-982

	-->> PSB VRI 18/06/2025 CFT-1761 Получение суммы переводов физикам за текущий календарный месяц
	if P_PAR = 'PSB_SUM_AL_TO_FL' then	 
		varRet := coalesce(get_sum_to_fl(refRko.[ACCOUNT], '0'), 0); -- на чужие счета ФЛ
	elsif P_PAR = 'PSB_SUM_MY_TO_FL' then
		varRet := coalesce(get_sum_to_fl(refRko.[ACCOUNT], '1'), 0); -- на свои счета ФЛ
	end if;
	--<< PSB VRI 18/06/2025 CFT-1761 Получение суммы переводов физикам за текущий календарный месяц

	-->> PSB VRI 12/09/2025 CFT-1939 Новый вид комиссии исх. на 30111
	if P_PAR = 'PSB_ACC_KT_POL' then	-- Возвращает счет получателя из документа 
		varRet := coalesce(trim(md.[KL_KT].[2].[1]), md.[ACC_KT].[MAIN_V_ID], '0');
	end if;
	--<< PSB VRI 12/09/2025 CFT-1939 Новый вид комиссии исх. на 30111

	-->> PSB VRI 12/09/2025 CFT-2464 Изменения в тарифах ВК п. 7.10
	if P_PAR = 'PSB_ACC_DT_PL' then	-- Возвращает счет плательщика из документа 
		varRet := coalesce(trim(md.[KL_DT].[2].[1]), md.[ACC_DT].[MAIN_V_ID], '0');
	end if;
	--<< PSB VRI 12/09/2025 CFT-2464 Изменения в тарифах ВК п. 7.10
	
	-->> PSH VRI 27/10/2025 CFT-2694 - Доработка разовых комиссий
	if P_PAR = 'PSB_GT_COM_MAN' then	-- Возвращает сумму разовой комиссии из удержания разовой комиссии 
		varRet := ::[MAIN_DOCUM].[PSH_COMMIS_GT].V_SUM_COM_GT; 
	end if;
	if P_PAR = 'PSB_GT_COM_NAZN' then	-- Возвращает назначение платежа из удержания разовой комиссии 
		varRet := ::[MAIN_DOCUM].[PSH_COMMIS_GT].V_COM_NAZN; 
	end if;
	--<< PSH VRI 27/10/2025 CFT-2694 - Доработка разовых комиссий

	-->> PSH VRI 03/12/2025 CFT-3040 расчет и списание ежемесячной комиссии за ведение счета
		-- Возвращает '1',  если в выписке по расчетному счету договора РКО есть записи за последние 2 месяца без комиссий, инкассовых поручений и переоценки
		-- (считая от даты операционного дня), либо '0' в противном случае
	if P_PAR = 'PSH_ОБОР_БЕЗ_КОМ' then
		varRet := '0';
		for m in refRko.[ACCOUNT].[ARC_MOVE] 
			where   m.[DATE] >= add_months(trunc(::[SYSTEM].[OP_DATE],'MM'), -1) 		-- Первый день предыдущего месяца
				and m.[DATE] < (add_months(trunc(::[SYSTEM].[OP_DATE] ,'MM'), 1) - 1) 	-- Последний день текущего месяца
				and m.[DOC].[VID_DOC] <> ::[NAME_PAYDOC]([CODE] = 'БЕЗН_ИНКАСС_ПОР')
				and m.[ACC_CORR].[MAIN_V_ID] not like '706%'
				and not (m.[DT] and substr(m.[ACC_CORR].[MAIN_V_ID],1,5) in ('47422', '60309', '45811', '45812', '45813', '45814', '45816'))  
		loop
			varRet := '1';
			exit;
		end loop;
	end if;
	-->> PSH VRI 03/12/2025 CFT-3040 расчет и списание ежемесячной комиссии за ведение счета

	-->> PSH VRI 18/12/2025 для Prepaid
	if P_PAR = 'PSH_PREP_SUMM' then	-- Возвращает сумму для бизнес-операций PREPAID 
		::[RUNTIME].[STR].get_par(P_PATT, 'PSH_PREPAID_AMOUNT', varRet);
		varRet := nvl(varRet, 0);
	elsif P_PAR = 'PSH_PREP_RETAIL' then	-- Возвращает данные торговой точки для бизнес-операций PREPAID 
		::[RUNTIME].[STR].get_par(P_PATT, 'PSH_PREP_RETAIL', varRet);
		varRet := nvl(varRet, 0);
	end if;
	--<< PSH VRI 18/12/2025 для Prepaid
	
	-->> PSH VRI 24/11/2025 CFT-2894 Начисление %% на остаток по счету ЮЛ
	-- Удержание налога с процентов
	if P_PAR = 'PSB_CL_NAL_RATE' then
		if not coalesce(refRko.[CLIENT].[NU_REZIDENT], false) then 
			 varRet := get_st_nalog(refRko.[CLIENT]); 
		else varRet := 0;
		end if;
	elsif P_PAR = 'PSB_CL_NAL_PRС' then
		varRet := refRko.[GET_SUMMS]('ПРОЦЕНТОВ_К_ПОГАШЕНИЮ');
	elsif P_PAR = 'PSB_CL_NAL_SUM' then
		if not coalesce(refRko.[CLIENT].[NU_REZIDENT], false) then
			 varRet := get_st_nalog(refRko.[CLIENT]);
		else varRet := 0;
		end if;
	end if;
	--<< PSH VRI 24/11/2025 CFT-2894 Начисление %% на остаток по счету ЮЛ
	
	--------------------------
	-- debug_pipe('varRet ='||varRet, 0);
	
	<<nnn>>	
	&debug(Substr('<="'||varRet||'" P_PAR='||P_PAR||' Стоп :'||to_char(sysdate,'hh24:mm:ss')||' ('||GetTimeInterval(utils.get_time,timeStart)||'сотыхСек.)',1,2000),dp)
	return varRet;
END;
end;
end;
