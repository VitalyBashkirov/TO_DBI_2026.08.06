class TAX_CL_PROFIT;

@import_plsql(true)
@name('[ПСБ] Библиотека (отладка)')
@tag('COPIED')
library PSH_LIB is

pragma include(::[DEBUG_TRIGGER].[MACRO_LIB]);
pragma include(::[TAX_CL_PROFIT].[LIB_TC]);

/**
 * Проверка включения приложения.
 * @param p_codeApp	код приложения
 * @return			если приложение не включено, или не запрещено лицензией, возвращается сообщение об ошибке,
 * 					иначе пусто.
 */
public function checkApp(p_codeApp varchar2) return varchar2 is
v_res		boolean;
begin
	&debug('Проверка приложения p_codeApp =' || p_codeApp, 0)
	if p_codeApp is not null then
		v_res := nvl(::[FP_TUNE].[LIB].get_bool_value(p_codeApp, null, '0'), false);
		
		if not v_res then
			return 'Приложение с кодом "' || p_codeApp ||'" не включено!';	
		end if;
	end if;	
	return null;
end;

/**
 * Добавление элемента в документ или атрибута в элемент.
 * @param p_doc			XML документ
 * @param p_parent 		Родительский элемент/элемент в который добавляется атрибут.
 * @param p_name 		Имя элемента. Если имя начинается с символа @, то добавляется атрибут к p_parent.
 * @param p_value		Значение элемента или атрибута.
 * @param p_required	Обязательный элемент
 * @return				Возвращает элемент
 */
public function addNode(
	  p_doc			&xml.DOMDocument
	, p_parent 		&xml.DOMNode
	, p_name 		varchar2(32767)
	, p_value		varchar2(32767) default null
	, p_required	boolean default false
)
return &xml.DOMNode is
node 		&xml.DOMNode;
attrName	varchar2(32767);
begin
	if p_name is not null then
		if p_name like '@%' then
			attrName := substr(p_name, 2);
			if p_value is not null then
				&xml.setAttribute(&xml.makeElement(p_parent), attrName, p_value);
			elsif p_value is null and p_required then
				pragma error('Не указано значение обязательного атрибута <' || attrName || '>');
			end if;
		else
			node := &xml.appendChild(p_parent, &xml.makeNode(&xml.createElement(p_doc, p_name)));
		end if;
	end if;

	return node;
end;

/**
 * Создание текста запроса в информационную компоненту.
 * @param p_dataReq	Ссылка на запрос данных
 * @param p_data 	Сформированный текст запроса (входной/выходной параметр)
 */
public procedure createRequest(p_dataReq ref [TAX_CL_PR_D_REQ], p_data in out nocopy clob, p_sysAb ref [CIT_ABONENT] default null)
is
document	&xml.DOMDocument;
node		&xml.DOMNode;
node1		&xml.DOMNode;
node2		&xml.DOMNode;
node3		&xml.DOMNode;

clientId	number;
clientObj	[TAX_CLIENTS];
lastname 	varchar2(100);
firstname  	varchar2(100);
surname  	varchar2(100);
begin 
	dbms_lob.trim(p_data, 0);
	document := &xml.newDOMDocument;
	
	node := addNode(document, &xml.makeNode(document), 'ЗапросВыплПроц');
	node1 := addNode(document, node, 'Период');
	node2 := addNode(document, node1, '@ДатаНач', &date2str(p_dataReq.[PERIOD_BEG]));
	node2 := addNode(document, node1, '@ДатаОк', &date2str(p_dataReq.[PERIOD_END]));	
	node1 := addNode(document, node, '@ТипЗапр', p_dataReq.[REQ_TYPE]);

	if p_dataReq.[CLIENT] is not null then
		-- корректировка
		
		if p_sysAb.[IS_OUR_SYS] then
			clientId := p_dataReq.[CLIENT].[CLIENT];
		else
			for (
					select	x(x.[EXT_ID] : extId)
					in		::[TAX_EXT_CL_DATA] all
					where	x.[TAX_CLIENT] = p_dataReq.[CLIENT]
						and x.[SYS_AB] = p_sysAb
			) loop
				-- для каждой системы-абонента необходимо отправить ее ID
				clientId := x.extId;
				exit;
			end loop;
		end if;
		
		node1 := addNode(document, node, 'Клиент');
		
		if clientId is not null then
			node2 := addNode(document, node1, '@КлиентИд', clientId);
		else
			clientObj := p_dataReq.[CLIENT];

			node2 := addNode(document, node1, '@Гражд', clientObj.[CITIZENSHIP].[CODE], true);
			node2 := addNode(document, node1, '@ДатаРожд', &date2str(clientObj.[BIRTH_DATE]), true);
			node2 := addNode(document, node1, '@ИННФЛ', clientObj.[INN]);

			node2 := addNode(document, node1, 'ФИО');
			node3 := addNode(document, node2, '@Фамилия',clientObj.[FIO].[LASTNAME], true);
			node3 := addNode(document, node2, '@Имя', clientObj.[FIO].[FIRSTNAME], true);
			node3 := addNode(document, node2, '@Отчество', clientObj.[FIO].[PARTRONYMIC]);	

			node2 := addNode(document, node1, 'УдЛичнФЛ');
			node3 := addNode(document, node2, '@КодВидДок', clientObj.[CERT_TYPE].[CODE_GNI], true);
			node3 := addNode(document, node2, '@СерНомДок', clientObj.[CERT_SER_NUM], true);
			node3 := addNode(document, node2, '@ДатаВыд', &date2str(clientObj.[CERT_ISSUE_DATE]), true);			

		end if;
		
	end if;

	if p_dataReq.[OBJECT_ID] is not null then
		node1 := addNode(document, node, '@ИдПрод', p_dataReq.[OBJECT_ID]);
	end if;
	
	if p_dataReq.[PROD_CODE] is not null then
		node1 := addNode(document, node, '@Продукт', p_dataReq.[PROD_CODE]);
	end if;

	&xml.writeToCLOB(document, p_data);
	&xml.freeDocument(document);
end;

public function createAccInfo(
	p_clProfit ref [TAX_CL_PROFIT]
	, p_prodId string(128)
	, p_prodCode string(16)
	, p_profSumm [SUMMA]
	, p_isCHP boolean
	, p_prodNum string
	, p_prodDateBeg date
	, p_dataReq ref [TAX_CL_PR_D_REQ]
	, p_isCorr boolean
	, p_sysAb ref [CIT_ABONENT]
	, p_createZero boolean default false
) return ref [TAX_CL_PR_AC_INF]
is
createZero	boolean := false; 
accInfReq	[TAX_CL_PR_AC_INF];
begin
	if coalesce(p_profSumm, 0) = 0 and not p_createZero then
		-- проверка, что до этого была не нулевая сумма
		for (
				select	x(x : xref)
				in		::[TAX_CL_PR_AC_INF] all
				where	x.[CL_PROFIT] = p_clProfit
					and x.[SYS_AB] = p_sysAb
					and x.[PROD_CODE] = p_prodCode
					and x.[PROD_ID] = p_prodId
					and coalesce(x.[PROF_SUMM], 0) > 0
		) loop
			createZero := true;
		end loop;
	end if;
	
	if coalesce(p_profSumm, 0) > 0 or p_createZero or createZero then
		-- добавляем:
		-- * любую запись с ненулевой суммой
		-- * нулевую сумму по договору, если это корректировка и не было вообще никаких записей по клиенту
		-- * либо если была ненулевая запись по такому договору		
		accInfReq%init(true);
		accInfReq.[CL_PROFIT] := p_clProfit;
		accInfReq.[PROD_ID] := p_prodId;
		accInfReq.[PROD_CODE] := p_prodCode;
		accInfReq.[PROF_SUMM] := p_profSumm;
		accInfReq.[IS_CHP] := p_isCHP;
		accInfReq.[PROD_NUM] := p_prodNum;
		accInfReq.[PROD_DATE_BEG] := p_prodDateBeg;
		accInfReq.[DATA_REQ] := p_dataReq;
		accInfReq.[DATA_DT] := sysdate;
		accInfReq.[IS_CORR] := p_isCorr;
		accInfReq.[SYS_AB] := p_sysAb;
					
		return ::[TAX_CL_PR_AC_INF]%insert(accInfReq);
	end if;

	return null;
end;

public function getClProfit(
	p_client ref [TAX_CLIENTS]
	, p_begDate date
	, p_endDate date
	, p_reorgInfo [TAX_CL_PR_REORG] default null
) return ref [TAX_CL_PROFIT]
is
begin
	for (
			select	x(x : prf)
			in		::[TAX_CL_PROFIT] all
			where	x.[CLIENT] = p_client
				and x.[PERIOD_BEG] = p_begDate
				and x.[PERIOD_END] = p_endDate
				and nvl(x.[REORG_INFO].[INN], '-1') = nvl(p_reorgInfo.[INN], '-1')
				and nvl(x.[CORR_NUM], 0) != 99 -- исключаем аннулированные строки 
	) loop
		return x.prf;
	end loop;
	
	return ::[TAX_CL_PROFIT].[NEW_AUTO](p_client, p_begDate, p_endDate, P_REORG_BANK == p_reorgInfo);	
end;


public function createDataRequest(
	p_reqType integer
	, p_dateBeg date
	, p_dateEnd date
	, p_client ref [TAX_CLIENTS] default null
	, p_objId string(128) default null
	, p_prodCode string(16) default null
)
return ref [TAX_CL_PR_D_REQ]
is
errMess string;
reqObj [TAX_CL_PR_D_REQ];
reqRef ref [TAX_CL_PR_D_REQ];
begin
	errMess := checkApp('1B030100');
	
	if errMess is not null then
		pragma error(errMess);
	end if;
	
	-- проверка на наличие
	if p_reqType = 0 then
		for d in ::[TAX_CL_PR_D_REQ] all
		where d.[PERIOD_BEG] = p_dateBeg
			and d.[PERIOD_END] = p_dateEnd
			and d.[REQ_TYPE] = p_reqType
			and (d.[CLIENT] = p_client or d.[CLIENT] is null and p_client is null)
		loop
			pragma error('Уже есть запрос за указанный период! ID:'||d%class||'.'||d%id);
		end loop;
	end if;
	
	reqObj%init(true, true);
	reqObj.[REQ_TYPE] := p_reqType;
	reqObj.[PERIOD_BEG] := p_dateBeg;
	reqObj.[PERIOD_END] := p_dateEnd;
	reqObj.[CLIENT] := p_client;
	reqObj.[OBJECT_ID] := p_objId;
	reqObj.[PROD_CODE] := p_prodCode;
	reqObj.[STATUS] := ::[TAX_CL_PROFIT].[LIB_TC].stRNew;
	reqObj.[CREATE_DATE] := sysdate;
	
	reqRef := ::[TAX_CL_PR_D_REQ]%insert(reqObj);
	
	return reqRef;
	
end;

public function sendRequest(p_dataReq ref [TAX_CL_PR_D_REQ], p_abonent ref [CIT_ABONENT], p_text in out clob) return ref [TAX_CL_PR_REQS] is 
requestObj		[TAX_CL_PR_REQS];
requestRef	ref [TAX_CL_PR_REQS];
begin
	&debug('>> sendRequest', 0)
	&debug('p_text = ' || p_text, 0)

	requestObj.[REQ_DATA]	:= p_dataReq;
	requestObj.[STATE_REQ]	:= &tc.stRSend;
	requestObj.[TIME_REQ] 	:= sysdate;
	requestObj.[CONTENT]  	:= p_text;
	requestObj.[IS_OUT] 	:= true;
	requestObj.[SYS_AB] 	:= p_abonent;
	requestObj.[CODE_BO] 	:= &tc.BPSendCode;

	requestRef := ::[TAX_CL_PR_REQS]%insert(requestObj);
	
	requestRef.[SEND];	

	&debug('requestRef ' || requestRef.[REQ] ,0)
	return requestRef;
end;

public procedure parseAnswer(p_req ref [TAX_CL_PR_REQS], p_data clob, p_msgId varchar2, p_bpCode varchar2, p_ans boolean default true)
is
inReqObj 		[TAX_CL_PR_REQS];
inReqRef	ref [TAX_CL_PR_REQS];
dataReqRef	ref [TAX_CL_PR_D_REQ];
answState		[TAX_CL_PR_D_REQ].[STATUS]%type;
begin
	&debug('>> parseAnswer' ,0)
	
	inReqObj.[CONTENT] 		:= p_data;
	inReqObj.[REQ]%id		:= p_msgId;
	inReqObj.[STATE_REQ]	:= &tc.stRNew;
	inReqObj.[TIME_REQ] 	:= sysdate;
	inReqObj.[IS_OUT] 		:= false;
	inReqObj.[INITIAL_REQ]	:= p_req;
	inReqObj.[SYS_AB] 		:= p_req.[SYS_AB];
	inReqObj.[CODE_BO] 		:= p_bpCode;	
	
	inReqRef := [TAX_CL_PR_REQS]%insert(inReqObj);
	&debug('inReqRef = ' || inReqRef ,0)
	
	dataReqRef := p_req.[REQ_DATA];
	
	if p_ans then
		p_req.[STATE_REQ] := &tc.stRAnswered;

		commit;

		-- нужно изменить состояние у исходного сообщения
		answState := getAnswState(dataReqRef);
		if dataReqRef.[STATUS] != answState then
			dataReqRef.[STATUS] := answState;
		end if;
	end if;
	
end;

/**
 * Процедура создания запросов корректировок по входящему сообщению от продукта.
 * @param p_sysAbCode	код системы-абонента, из которой пришел запрос
 * @param p_data		текст сообщения
 * @param p_msgId		id запроса интегратора
 * @param p_bpCode		код бизнес-процесса
 */
public procedure makeCorr(p_sysAbCode string, p_data clob, p_msgId string, p_bpCode string)
is
x				XMLType;
clientId		number;
dateBeg			date;
dateEnd			date;
objId			string(128);
prodCode		string(16);

clientRef	ref [TAX_CLIENTS];

yearBeg			integer;
yearEnd			integer;

periodBeg		date;
periodEnd		date;

firstReq	ref [TAX_CL_PR_D_REQ];
dataReq		ref [TAX_CL_PR_D_REQ];

sysAbRef	ref [CIT_ABONENT];
inReqObj 		[TAX_CL_PR_REQS];
inReqRef	ref [TAX_CL_PR_REQS];
begin
	&debug('>> makeCorr' ,0)
	
	sysAbRef := ::[CIT_ABONENT]([CODE] = p_sysAbCode);
	
	-- извлечение информации об изменениях
	x := XMLType(p_data);
	if x.existsNode('/Корректировка/@КлиентИд') > 0 then
		clientId := x.extract('/Корректировка/@КлиентИд').getStringVal();
	end if;
	dateBeg := &str2date(x.extract('/Корректировка/@ДатаНач').getStringVal());
	dateEnd := &str2date(x.extract('/Корректировка/@ДатаОк').getStringVal());
	objId := x.extract('/Корректировка/@ИдПрод').getStringVal();
	prodCode := x.extract('/Корректировка/@Продукт').getStringVal();

	&debug('-------------XML-------------', 0)
	&debug('ИД клиента clientId (ext) = '||clientId, 0)
	&debug('Дата начала dateBeg = '||&date2str(dateBeg), 0)
	&debug('Дата окончания dateEnd = '||&date2str(dateEnd), 0)
	&debug('ИД продукта objId = '||objId, 0)
	&debug('Код продукта prodCode = '||prodCode, 0)
	&debug('-----------------------------', 0)
	
	yearBeg := to_char(dateBeg, 'YYYY');
	yearEnd := to_char(dateEnd, 'YYYY');
	
	&debug('yearBeg = '||yearBeg, 0)
	&debug('yearEnd = '||yearEnd, 0)
	
	if clientId is not null then
		-- поиск клиента по ID
		clientRef := ::[TAX_CLIENTS].[LIB].getClientByIdent(clientId, sysAbRef);
		&debug('Клиент найден по id.', 0)
		if clientRef is null then
			-- если еще нет такого клиента в справочнике, то для создания запроса
			-- создадим пустую запись только с внешним ID
			-- когда придет ответ, придут и все данные клиента
			clientRef := ::[TAX_CLIENTS].[LIB].createSimpleClient(clientId, sysAbRef);
			&debug('Добавлен пустой клиент.', 0)
		end if;
	end if;
	
	&debug('Ссылка на клиента clientRef = '||clientRef, 0)
	
	for i in yearBeg..yearEnd loop
		&debug('year = '||i, 0)
		
		firstReq := null;
		periodBeg := to_date('01/01/'||i, 'dd/mm/yyyy');
		periodEnd := to_date('31/12/'||i, 'dd/mm/yyyy');
		
		&debug('periodBeg = '||&date2str(periodBeg), 0)
		&debug('periodEnd = '||&date2str(periodEnd), 0)		
		
		-- проверка, был ли запрос первичных данных по данному налоговому периоду
		for (
				select	r(r : req)
				in		::[TAX_CL_PR_D_REQ] all
				where	r.[REQ_TYPE] = 0
					and r.[PERIOD_BEG] = periodBeg
					and r.[PERIOD_END] = periodEnd
					and exists
						(
							select a(null)
							in ::[TAX_CL_PR_AC_INF] all
							where a.[DATA_REQ] = r%id
								and a.[PROD_ID] = objId
								and a.[PROD_CODE] = prodCode
						)
				fetch 1
		) loop
			firstReq := r.req;
			exit;
		end loop;
		
		&debug('firstReq = '||firstReq, 0)
		
		if firstReq is null then
			-- еще не было первоначального запроса данных за период
			-- корректировку делать не нужно
			-- переходим к следующему периоду
			&debug('Еще не было первоначального запроса данных за период. Корректировку делать не нужно.', 0)
			&debug('<< makeCorr' ,0)
			continue;
		end if;
		
		-- создать запрос корректировки
		dataReq := createDataRequest(1, periodBeg, periodEnd, clientRef, objId, prodCode);
		
		&debug('Корректировка dataReq = '||dataReq, 0)
		
		-- создать входящий запрос с информацией об изменении в данных
		-- будет входящим запросом без инициирущего запроса, привязан к запросу данных
		-- на каждый отчетный период будет создан отдельный экземпляр запроса,
		-- привязанный к тому же запросу интегратора
		inReqObj%init(true, true);
		inReqObj.[CONTENT] 		:= p_data;
		inReqObj.[REQ]%id		:= p_msgId;
		inReqObj.[STATE_REQ]	:= &tc.stRNew;
		inReqObj.[TIME_REQ] 	:= sysdate;
		inReqObj.[IS_OUT] 		:= false;
		inReqObj.[SYS_AB] 		:= sysAbRef;
		inReqObj.[CODE_BO] 		:= p_bpCode;	
		inReqObj.[REQ_DATA]		:= dataReq;
		
		inReqRef := [TAX_CL_PR_REQS]%insert(inReqObj);
		&debug('inReqRef = ' || inReqRef ,0)	
		
		-- отправить запрос
		dataReq.[SEND](sysAbRef);
	end loop;

	&debug('<< makeCorr' ,0)
end;

/**
 * Функция определения состояния запроса данных по состояниям его запросов в компоненты
 * @param p_doc		ссылка на запрос данных
 * @param p_excReq	ссылка на запрос в компоненту, который следует исключить из анализа (востребовано, например, при удалении запроса)
 * @result			возвращает:
 * 								состояние stRAnswered (Получен ответ) - если по всем запросам получены ответы
 * 								состояние stRSend (Отправлен) - если есть запросы без ответа
 * 								состояние stRNew (Новый) - если нет запросов
 */
public function getAnswState(p_doc ref [TAX_CL_PR_D_REQ], p_excReq ref [TAX_CL_PR_REQS] default null) return varchar2(16)
is
allCount integer := 0;
ansCount integer := 0;
begin
	&debug('>> getAnswState',0)
	&debug(' p_doc='||p_doc,0)
	&debug(' p_excReq='||p_excReq,0)
	
	for (
		select	x(
					  analytic(count(1), 'over()') : allCnt
					, analytic(count(case when x.[STATE_REQ] = &tc.stRAnswered then 1 end), 'over ()') : ansCnt
				)
		in		::[TAX_CL_PR_REQS] all
		where	x.[REQ_DATA] = p_doc
			and x.[IS_OUT] = true
			and (x != p_excReq or p_excReq is null)
			
	) loop 
		allCount := x.allCnt;
		ansCount := x.ansCnt;
		
		exit;
	end loop;

	&debug(' allCount='||allCount,0)
	&debug(' ansCount='||ansCount,0)

	if allCount = 0 then
		return &tc.stRNew;
		
	elsif allCount - ansCount = 0 then
		return &tc.stRAnswered;
	
	else
		return &tc.stRSend;
		
	end if;
end;

public procedure startDoc(
	p_taxPeriod string(4)
	, p_branch ref [BRANCH]
	, p_doc out &xml.DOMDocument
	, p_node out &xml.DOMNode
	, p_reorgInfo [TAX_CL_PR_REORG] default null
)
is
elem 		&xml.DOMElement;
node 		&xml.DOMNode;
node1 		&xml.DOMNode;
node2 		&xml.DOMNode;

bankRef	ref [CL_BANK];
taxInsp	ref [TAX_INSPECT];
nameBank	string(1000);
begin
	p_doc := &xml.newDomDocument(to_clob('<tns:FLPROCRequest '||::[GM_TAX_PROF_REQ].[LIB].getNamespace||'/>'));
	elem := &xml.getDocumentElement(p_doc);
	p_node := &xml.makeNode(elem);
	&xml.setAttribute(elem, 'ИдЗапрос', regexp_replace(rawtohex(sys_guid()), '(.{8})(.{4})(.{4})(.{4})(.{12})', '\1-\2-\3-\4-\5'));
	&xml.setAttribute(elem, 'Период', p_taxPeriod);
	taxInsp := ::[FP_TUNE].[LIB].get_ref_value('TAX_NI', ::[FP_TUNE].[LIB].set_canons(::[BRANCH]%class, p_branch%id), '0');
	&xml.setAttribute(elem, 'КодНО', substr(taxInsp.[NUM], 1, 4));
	
	bankRef := nvl(p_branch.[BANK_REQ], p_branch.[BANK]);
	
	node := addNode(p_doc, p_node, 'tns:СведБанк');
	
	-- RP0647376. При наличии реорганизованного банка - указываем его наименование из ТБП "Клиенты Банка России"
	if p_reorgInfo.[INN] is not null then
		begin
			select x(substr(x.[LONG_NAME], 1, 1000))
				in ::[CL_BANK_N]
				where x.[INN] = p_reorgInfo.[INN]
					and x.[KPP] = p_reorgInfo.[KPP]
					and instr(x.[REG_NUM], '/') = 0 --исключаем филиалы
				order by x.[DATE_EDIT] desc
				fetch 1
				into nameBank;
		exception when NO_DATA_FOUND then
			nameBank := substr(::[BRANCH].[SLIB].GET_BANK_NAME(p_branch, 0), 1, 1000);
		end;
	else
		nameBank := substr(::[BRANCH].[SLIB].GET_BANK_NAME(p_branch, 0), 1, 1000);
	end if;
	node1 := addNode(p_doc, node, '@НаимБанк', nameBank, true);
	
	node1 := addNode(p_doc, node, '@ИНН', ::[BRANCH].[SLIB].GET_INN(p_branch), true);
	node1 := addNode(p_doc, node, '@КПП', bankRef.[KPP], true);	
	
	if p_reorgInfo.[INN] is not null then
		node1 := addNode(p_doc, node, 'tns:СвРеоргЮЛ');
		node2 := addNode(p_doc, node1, '@ФормРеорг', p_reorgInfo.[CODE_REORG], true);
		node2 := addNode(p_doc, node1, '@ИННЮЛ', p_reorgInfo.[INN]);
		node2 := addNode(p_doc, node1, '@КПП', p_reorgInfo.[KPP]);
	end if; 
end;

public procedure addSigner(
	p_branch ref [BRANCH]
	, p_doc in out &xml.DOMDocument
	, p_node in out &xml.DOMNode
)
is
node 			&xml.DOMNode;
node1 			&xml.DOMNode;
node2 			&xml.DOMNode;

userRef 	ref [USER];
userCasta		varchar2(250);
userName		varchar2(100);
userLastName	varchar2(100);
userFirstName	varchar2(100);
userSurName		varchar2(100);
begin
	userRef%id := ::[FP_TUNE].[LIB].get_ref_value('FNS_RESPONSE_PERSON', ::[FP_TUNE].[LIB].set_canons(::[BRANCH]%class, p_branch%id, '<GNI_EXCH_KIND>', '102'), '0')%id;
	if userRef is null then
		userRef := nvl(::[BRANCH].[SLIB].getGeneralAcc(p_branch), stdlib.userId);
	end if;
	
	begin
		select	x(
					  x.[CASTA].[VALUE]
					, x.[NAME]
					, x.[CL_PRIV_REF].[FAMILY_CL]
					, x.[CL_PRIV_REF].[NAME_CL]
					, x.[CL_PRIV_REF].[SNAME_CL]
				)
		in		::[USER] all
		where	x = userRef
		into	  userCasta
				, userName
				, userLastName
				, userFirstName
				, userSurName;
		
	exception
		when NO_DATA_FOUND then
			null;
	end;
	
	if userLastName is null and userFirstName is null and userName is not null then
		userLastName	:= substr(stdlib.Fio(userName, 'Ф'), 1, userLastName%size);
		userFirstName	:= substr(stdlib.Fio(userName, 'И'), 1, userFirstName%size);
		userSurName		:= substr(stdlib.Fio(userName, 'О'), 1, userSurName%size);
	end if;
	
	node := addNode(p_doc, p_node, 'tns:Подписант');	
	node1 := addNode(p_doc, node, '@Должн', substr(userCasta, 1, 100), true);
	node1 := addNode(p_doc, node, '@ДатаПодп', &date2str(sysdate), true);
	node1 := addNode(p_doc, node, 'tns:ФИО');
	node2 := addNode(p_doc, node1, '@Фамилия', userLastName, true);
	node2 := addNode(p_doc, node1, '@Имя', userFirstName, true);
	node2 := addNode(p_doc, node1, '@Отчество', userSurName);				
end;

public function finishDoc(
	p_mess ref [TAX_CL_PR_MESS]
	, p_branch ref [BRANCH]
	, p_doc in out &xml.DOMDocument
	, p_node in out &xml.DOMNode
	, p_profList in out &tc.TProfitsInfo
	, p_errCount in out integer
	, p_errMess in out [MEMO]
) return ref [GOV_MESSAGE]
is
messText		clob;
govMessage	ref [GOV_MESSAGE];
begin
	addSigner(p_branch, p_doc, p_node);
	
	dbms_lob.createTemporary(messText, true);
	&xml.writeToClob(p_doc, messText);
	&xml.freeDocument(p_doc);

	govMessage := ::[GM_TAX_PROF_REQ].[NEW_AUTO](p_mess, messText, p_errMess);

	if p_profList.count > 0 then
		for i in p_profList.first..p_profList.last loop
			::[TAX_CL_PR_LINK].[NEW_AUTO](
											p_profList(i).profId
											, govMessage
											, p_profList(i).linkType
											, p_profList(i).corrNum
											, p_profList(i).profSumm
											, p_profList(i).profSummChp
										);
		end loop;
		
		p_profList.delete;
	end if;
	
	p_errCount := 0;
	p_errMess := '';
	
	dbms_lob.freeTemporary(messText);	
	
	return govMessage;
end;

/**
 * Создание сообщения ФНС
 */
public function makeTaxMessage(p_taxPeriod string(4), p_isOut boolean, p_isCorr boolean)
return ref [TAX_CL_PR_MESS]
is
taxMessObj		[TAX_CL_PR_MESS];
taxMessRef	ref [TAX_CL_PR_MESS];
begin
	taxMessObj%init(true, true);
	taxMessObj.[CORR] := p_isCorr;
	taxMessObj.[IS_OUT] := p_isOut;
	taxMessObj.[MESS_DT] := sysdate;
	taxMessObj.[TAX_PERIOD] := p_taxPeriod;
	
	taxMessRef := ::[TAX_CL_PR_MESS]%insert(taxMessObj);
	
	return taxMessRef;
end;

public procedure makeProfitDoc(
	p_mess in out ref [TAX_CL_PR_MESS]
	, p_doc in out &xml.DOMDocument
	, p_headNode in out &xml.DOMNode
	, p_num in out integer
	, p_namespace varchar2(500)
	, p_taxPeriod varchar2(4)
	, p_finish boolean default false
	, p_profList in out &tc.TProfitsInfo
	, p_errCount in out integer
	, p_errMess in out [MEMO]
	, p_reorgInfo [TAX_CL_PR_REORG] default null
	, p_lastReorgINN in out string(10)
)
is
branchRef	ref [BRANCH];
messSize		integer;
begin
	if p_mess is null then
		p_mess := makeTaxMessage(p_taxPeriod, true, false);
	end if;
	
	messSize := nvl(::[FP_TUNE].[LIB].get_num_value('TAX_PROC_MESS_SIZE', null, '0'), 10000);
	
	if 
		&xml.isNull(p_doc)
			or
		p_num = messSize + 1
			or
		(not &xml.isNull(p_doc) and nvl(p_lastReorgINN, '-1') != nvl(p_reorgInfo.[INN], '-1'))
			or
		p_finish
	then
		branchRef := ::[SYSTEM].[VARIABLES].headBranch;
		
		if p_num = messSize + 1 or p_finish or (not &xml.isNull(p_doc) and nvl(p_lastReorgINN, '-1') != nvl(p_reorgInfo.[INN], '-1')) then
			-- отправка готовой части
			-- добавляем подвал
			finishDoc(p_mess, branchRef, p_doc, p_headNode, p_profList, p_errCount, p_errMess);
			
			p_num := 1;
		end if;
		
		if not p_finish then
			startDoc(p_taxPeriod, branchRef, p_doc, p_headNode, p_reorgInfo);
		end if;
		
		p_lastReorgINN := p_reorgInfo.[INN];
	end if;
end;

public procedure makeAnswerByClient(
	p_doc &xml.DOMDocument
	, p_node &xml.DOMNode
	, p_taxClient ref [TAX_CLIENTS]
	, p_corrNum integer
	, p_reqType integer
	, p_profSumm [SUMMA]
	, p_ptofSummCHP [SUMMA]
	, p_taxCorrReq ref [GM_TAX_PROF_CORR] default null
)
is
node1 &xml.DOMNode;
node2 &xml.DOMNode;
node3 &xml.DOMNode;
node4 &xml.DOMNode;

C_DOC_CODES_PATT const string := '^(0[3,7,8]|1[0-5,8]|2[1,3,4]|91)$';
C_OTHER_CODE const string := '91';

clNum integer;
countryCode ::[COUNTRY].[CODE]%type;
birthDate date;
inn	string(12);
certTypeCode ::[CERTIFIC_TYPE].[CODE_GNI]%type;
certSerNum ::[TAX_CLIENTS].[CERT_SER_NUM]%type;
certDate date;
lastname 	varchar2(100);
firstname  	varchar2(100);
surname  	varchar2(100);
begin
	for (
			select	x(
						  x.[CL_NUM] : clNum
						, x.[CITIZENSHIP].[CODE] : countryCode
						, x.[BIRTH_DATE] : birthDate
						, x.[INN] : inn
						, x.[FIO].[FIRSTNAME] : firstname
						, x.[FIO].[LASTNAME] : lastname
						, x.[FIO].[PARTRONYMIC] : partronymic
						, nvl(x.[CERT_TYPE].[CODE_GNI], C_OTHER_CODE) : certTypeCode
						, x.[CERT_SER_NUM] : certSerNum
						, x.[CERT_ISSUE_DATE] : certDate				
					)
			in		::[TAX_CLIENTS] all
			where	x = p_taxClient
	) loop
		clNum := x.clNum;
		countryCode := x.countryCode;
		birthDate := x.birthDate;
		inn	:= x.inn;
		lastname := x.lastname;
		firstname := x.firstname;
		surname := x.partronymic;
		certTypeCode := x.certTypeCode;
		certSerNum := x.certSerNum;
		certDate := x.certDate;
		
		exit;		
	end loop;

	certTypeCode := case when not regexp_like(certTypeCode, C_DOC_CODES_PATT) then C_OTHER_CODE else certTypeCode end;
	
	node1 := addNode(p_doc, p_node, 'tns:СведПроц');
	node2 := addNode(p_doc, node1, '@ПорядНом', clNum, true);
	node2 := addNode(p_doc, node1, '@НомКорр', lpad(nvl(p_corrNum, 0), 2, '0'), true);
	
	if ::[GM_TAX_PROF_REQ].[LIB].getVersion = '4.0.1' or p_reqType > 0 then
		node2 := addNode(p_doc, node1, '@ПрКорр', case when p_reqType = 2 then '2' else '1' end, true);
	end if;

	if ::[GM_TAX_PROF_REQ].[LIB].getVersion = '4.0.2' and p_reqType = 2 then
		node2 := addNode(p_doc, node1, '@ИдЗапросНО', p_taxCorrReq.[TAX_MESS_ID]);
	end if;
	
	node2 := addNode(p_doc, node1, 'tns:СведФЛ');
	node3 := addNode(p_doc, node2, '@Гражд', countryCode, true);
	node3 := addNode(p_doc, node2, '@ДатаРожд', &date2str(birthDate), true);
	node3 := addNode(p_doc, node2, '@ИННФЛ', inn);
	node3 := addNode(p_doc, node2, '@СумПроц', p_profSumm, true);
	node3 := addNode(p_doc, node2, '@СумПроцИнд', p_ptofSummCHP, true);
	
	node3 := addNode(p_doc, node2, 'tns:ФИО');
	node4 := addNode(p_doc, node3, '@Фамилия', lastname, true);
	node4 := addNode(p_doc, node3, '@Имя', firstname, true);
	node4 := addNode(p_doc, node3, '@Отчество', surname);	
	
	node3 := addNode(p_doc, node2, 'tns:УдЛичнФЛ');
	node4 := addNode(p_doc, node3, '@КодВидДок', certTypeCode, true);
	node4 := addNode(p_doc, node3, '@СерНомДок', certSerNum, true);
	node4 := addNode(p_doc, node3, '@ДатаВыд', &date2str(certDate), true);			
end;

/**
 * Процедура изменения состояния всех запросов, привязанных к исходящему сообщению, на основе состояний всех исходящих сообщений.
 * @param p_outMess ссылка на исходящее сообщение
 */
public procedure changeReqsStatus(p_outMess ref [TAX_CL_PR_MESS])
is
formErr		boolean;
errText		[MEMO];
begin
	-- проверка остальных сообщений и работа с запросом данных
	for (
			select	m(m.[STATUS] : status, m.[ADD_INFO] : addInfo)
			in		::[GM_TAX_PROF_REQ] all
			where	m.[TAX_MESS] = p_outMess
				and not exists(select s(1) in ::[GM_TAX_PROF_REQ] all where s.[SRC_MSG] = m) -- убираем сообщения, по которым была переотправка
	) loop
		if m.status in (::[GOV_MESSAGE].[LIB].v_status_err, ::[GOV_MESSAGE].[LIB].v_status_rej)
			or
			m.status = ::[GOV_MESSAGE].[LIB].v_status_new and m.addInfo is not null
		then
			formErr := true;
			errText := substr(errText || m.addInfo || NL$, 1, errText%size);
		end if;
	end loop;	
	
	update	x(
				  x.[STATUS] = case when formErr = true then &tc.stRErr else &tc.stRSendAnsw end
				, x.[ADD_INFO] = case when formErr = true then errText else null end
			)
	in		::[TAX_CL_PR_D_REQ] all
	where	x in (select r(r) in ::[TAX_CL_PR_D_REQ] all where r.[OUT_MESS] = p_outMess);					
end;

/**
 * Процедура перевычисления параметров на выплаченных суммах по массиву связи с сообщениями.
 * @param p_profList	список выплаченных сумм
 */
public procedure reCalcParamsProfits(p_profList in out &tc.TProfits)
is
idx integer;
clProf ref [TAX_CL_PROFIT];
corrNum integer;
profSumm [SUMMA];
profSummChp [SUMMA];
begin
	idx := p_profList.first;
	while idx is not null loop
		corrNum := 0;
		profSumm := null;
		profSummChp := null;
		
		for (
				select	x(				
							x.corrNum : corrNum
							, x.profSumm : profSumm
							, x.profSummChp : profSummChp
						)
				in		(
							select	l(
										l.[CORR_NUM] : corrNum
										, l.[PROF_SUMM] : profSumm
										, l.[PROF_SUMM_CHP] : profSummChp
									)
							in		::[TAX_CL_PR_LINK] all
							where	l.[TAX_PROFIT] = p_profList(idx)
							order by l.[CORR_NUM] desc
						)
				fetch	1
		) loop
			corrNum := x.corrNum;
			profSumm := x.profSumm;
			profSummChp := x.profSummChp;
		end loop;

		clProf%id := p_profList(idx);		
		clProf.[CORR_NUM] := corrNum;
		clProf.[PROF_SUMM] := profSumm;
		clProf.[PROF_SUMM_CHP] := profSummChp;			
		
		idx := p_profList.next(idx);
	end loop;	
end;

/**
 * Вычисление актуальных сумм доходов клиента.
 * @param p_clProfit	ссылка на доход клиента
 * @param p_profSumm	сумма, выплаченная, как ФЛ
 * @param p_profSummChp	сумма, выплаченная, как ИП
 */
public procedure getProcSums(
	  p_clProfit	ref [TAX_CL_PROFIT]
	, p_profSumm	out [SUMMA]
	, p_profSummChp	out [SUMMA]
)
is
saveSys		string(128) := '-1';
saveId		string(128) := '-1';
saveCode	string(128) := '-1';
begin
	p_profSumm := 0;
	p_profSummChp := 0;

	for (
			select	a(
						  a.[PROD_ID]		: prodId
						, a.[PROD_CODE]		: prodCode
						, a.[IS_CHP]		: chp
						, a.[IS_CORR]		: corr
						, a.[SYS_AB].[CODE]	: sys
						, a.[PROF_SUMM]		: summ
					)
			in		::[TAX_CL_PR_AC_INF] all
			where	a.[CL_PROFIT] = p_clProfit
			order by a.[PROD_ID], a.[PROD_CODE], a.[SYS_AB], a.[IS_CORR] desc nulls last, a.[DATA_DT] desc
	) loop
		if a.prodId != saveId or a.prodCode != saveCode or a.sys != saveSys then
			if a.chp then
				p_profSummChp := p_profSummChp + a.summ;
			else
				p_profSumm := p_profSumm + a.summ;
			end if;						
		end if;
		
		saveSys := a.sys;
		saveId := a.prodId;
		saveCode := a.prodCode;					
	end loop;
end;
end;
