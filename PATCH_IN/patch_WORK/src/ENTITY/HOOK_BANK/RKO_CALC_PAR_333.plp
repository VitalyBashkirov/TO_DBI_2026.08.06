                        --ExMemo:= (SUMA_FIL_SH3 - SUM_DEN); goto nnn;
                     END IF;  	
                  END IF;
			    END IF;	
			
			    IF SUMA > 0 AND SUMA <= SUM_ZAYAV AND SUM_DEN > 0 THEN
			       ExMemo:= SUMA;
			    ELSIF SUMA > 0 AND SUMA >= SUM_ZAYAV AND SUM_ZAYAV > 0 AND SUM_DEN > 0 THEN
			       ExMemo:= SUM_ZAYAV; goto nnn;
			    ELSIF SUM_ZAYAV = 0 AND SUM_DEN > 0 THEN
			       ExMemo:= 0;
			    END IF;				
			    		
				if suma <= SUMA_FIL_SH2 then
					ExMemo:= 0; goto nnn;
				elsif suma > SUMA_FIL_SH2 and suma <= SUMA_FIL_SH3 then
				    SUMA := suma - SUMA_FIL_SH2;
					--ExMemo:= suma - SUMA_FIL_SH2;
				else
				    SUMA := SUMA_FIL_SH3 - SUMA_FIL_SH2;
					--ExMemo:= SUMA_FIL_SH3 - SUMA_FIL_SH2; goto nnn;
				end if;	
				
			    IF SUMA > 0 AND SUMA <= SUM_ZAYAV THEN
			       ExMemo:= SUMA;
			    ELSIF SUMA > 0 AND SUMA >= SUM_ZAYAV AND SUM_ZAYAV > 0 THEN
			       ExMemo:= SUM_ZAYAV; goto nnn;
			    ELSIF SUM_ZAYAV = 0 THEN
			       ExMemo:= 0;
			    END IF;					
				
				ExMemo:= 0;	 goto nnn;
			elsif P_PAR = 'СУММА_РАСЧ_ИНД_ПРЕД305' THEN
			    IF NVL(SUM_DEN,0) > 0 THEN
			      SUM_ZAYAV := SUM_ZAYAV - SUM_DEN;
			      IF SUM_ZAYAV < 0 THEN
			         SUM_ZAYAV := 0;
			      END IF;			
                  IF (SUM_DEN + SUMA) > SUMA_FIL_SH2 AND (SUM_DEN + SUMA) <= SUMA_FIL_SH3 THEN
			         IF SUM_DEN > SUMA_FIL_SH2 THEN
			             SUMA := SUMA;
			             --ExMemo:= SUMA;
			         ELSE
			             SUMA := (SUM_DEN + SUMA - SUMA_FIL_SH2);
			             --ExMemo:= (SUM_DEN + SUMA - SUMA_FIL_SH2); goto nnn;
			         END IF;
                  ELSIF (SUM_DEN + SUMA) <= SUMA_FIL_SH2 THEN
                     ExMemo:= 0;	
                  ELSIF (SUM_DEN + SUMA) > SUMA_FIL_SH3 THEN
                     IF SUM_DEN > SUMA_FIL_SH3 THEN
                        ExMemo:= 0; goto nnn;
                     ELSIF SUM_DEN < SUMA_FIL_SH2 THEN
                        SUMA := (SUMA_FIL_SH3 - SUMA_FIL_SH2);
                        --ExMemo:= (SUMA_FIL_SH3 - SUMA_FIL_SH2);
                     ELSIF SUM_DEN > SUMA_FIL_SH2 AND SUM_DEN < SUMA_FIL_SH3 THEN
                        SUMA := (SUMA_FIL_SH3 - SUM_DEN);
                        --ExMemo:= (SUMA_FIL_SH3 - SUM_DEN); goto nnn;
                     END IF;  	
                  END IF;
			    END IF;	
			
			    IF SUMA > 0 AND SUMA <= SUM_ZAYAV AND SUM_DEN > 0 THEN
			       ExMemo:= 0;
			    ELSIF SUMA > 0 AND SUMA > SUM_ZAYAV AND SUM_DEN > 0 THEN
			       ExMemo:= SUMA - SUM_ZAYAV; goto nnn;
			    END IF;				
			    		
				if suma <= SUMA_FIL_SH2 then
					ExMemo:= 0;
				elsif suma > SUMA_FIL_SH2 and suma <= SUMA_FIL_SH3 then
				    SUMA := suma - SUMA_FIL_SH2;
					--ExMemo:= suma - SUMA_FIL_SH2; goto nnn;
				else
				    SUMA := SUMA_FIL_SH3 - SUMA_FIL_SH2;
					--ExMemo:= SUMA_FIL_SH3 - SUMA_FIL_SH2;
				end if;	
				
			    IF SUMA > 0 AND SUMA <= SUM_ZAYAV THEN
			       ExMemo:= 0; goto nnn;
			    ELSIF SUMA > 0 AND SUMA > SUM_ZAYAV THEN
			       ExMemo:= SUMA - SUM_ZAYAV;
			    END IF;					
				
				ExMemo:= 0;								 goto nnn;
			elsif P_PAR = 'СУММА_РАСЧ_ИНД_ПРЕД4' THEN
			   IF NVL(SUM_DEN,0) > 0 THEN
			     SUM_ZAYAV := SUM_ZAYAV - SUM_DEN;
			     IF SUM_ZAYAV < 0 THEN
			        SUM_ZAYAV := 0;
			     END IF;			
                 IF (SUM_DEN + SUMA) > SUMA_FIL_SH3 THEN
			       IF SUM_DEN < SUMA_FIL_SH3 THEN
			          SUMA := (SUM_DEN + SUMA - SUMA_FIL_SH3);
			          --ExMemo:= (SUM_DEN + SUMA - SUMA_FIL_SH3);
			       ELSIF SUM_DEN > SUMA_FIL_SH3 THEN
			          SUMA := SUMA;
			          --ExMemo:= SUMA; goto nnn;
			       END IF;
                 ELSIF (SUM_DEN + SUMA) <= SUMA_FIL_SH3 THEN
                      ExMemo:= 0;
                 END IF;
			   END IF;	
			
			   IF SUMA > 0 AND SUMA <= SUM_ZAYAV AND SUM_DEN > 0 THEN
			      ExMemo:= 0; goto nnn;
			   ELSIF SUMA > 0 AND SUMA >= SUM_ZAYAV AND SUM_ZAYAV > 0 AND SUM_DEN > 0 THEN
			      ExMemo:= SUM_ZAYAV;
			   ELSIF SUM_ZAYAV = 0 AND SUM_DEN > 0 THEN
			      ExMemo:= 0; goto nnn;
			   END IF;			
			   		
			   if suma <= SUMA_FIL_SH3 then
				  ExMemo:= 0;
			   else
				  SUMA := suma - SUMA_FIL_SH3;
				  --ExMemo:= suma - SUMA_FIL_SH3; goto nnn;
		       end if;	
		
			   IF SUMA > 0 AND SUMA <= SUM_ZAYAV THEN
			      ExMemo:= 0;
			   ELSIF SUMA > 0 AND SUMA >= SUM_ZAYAV AND SUM_ZAYAV > 0 THEN
			      ExMemo:= SUM_ZAYAV; goto nnn;
			   ELSIF SUM_ZAYAV = 0 THEN
			      ExMemo:= 0;
			   END IF;		
		
		       ExMemo:= 0; goto nnn;
			elsif P_PAR = 'СУММА_РАСЧ_ИНД_ПРЕД405' THEN
			   IF NVL(SUM_DEN,0) > 0 THEN
			     SUM_ZAYAV := SUM_ZAYAV - SUM_DEN;
			     IF SUM_ZAYAV < 0 THEN
			        SUM_ZAYAV := 0;
			     END IF;			
                 IF (SUM_DEN + SUMA) > SUMA_FIL_SH3 THEN
			       IF SUM_DEN < SUMA_FIL_SH3 THEN
			          SUMA := (SUM_DEN + SUMA - SUMA_FIL_SH3);
			          --ExMemo:= (SUM_DEN + SUMA - SUMA_FIL_SH3);
			       ELSIF SUM_DEN > SUMA_FIL_SH3 THEN
			          SUMA := SUMA;
			          --ExMemo:= SUMA; goto nnn;
			       END IF;
                 ELSIF (SUM_DEN + SUMA) <= SUMA_FIL_SH3 THEN
                      ExMemo:= 0;
