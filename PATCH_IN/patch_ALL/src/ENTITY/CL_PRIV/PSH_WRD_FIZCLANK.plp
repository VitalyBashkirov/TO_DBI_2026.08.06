				end loop;
				P_DATA:=nvl(trim(temp_data,chr(13)),'.');
				P_DATA:=replace(P_DATA,'Не выявлено совпадений','Нет совпадений');
				debug_pipe(P_DATA,dp3);

			elsif p_info = 'ДАТА_ООН4' then -- KAS 24/01/21 Разделил вывод истории результатов проверок на 2 параметра
				temp_data:=null; 
				--Башкиров В.Г. 07.04.2023 Добавлено ограничение
				for rez in ::[CL_CHECK_RESULT] 
				where rez.[CHECK_OBJ]=this 
				and rez.[CHECK_TYPE].[CODE]='LIST_OON'
				and date_terr_rez_3<rez.[CHECK_DATE]
				order by rez.[CHECK_DATE]
				loop
					debug_pipe(p_info||' '||to_char(rez.[CHECK_DATE],SortFmt)||' date_terr_rez_2='||to_char(date_terr_rez_2,fmt)||' date_terr_rez_3='||to_char(date_terr_rez_3,SortFmt), dp3);
					temp_data:=temp_data||';'||chr(13)||'Проверен '||to_char(rez.[CHECK_DATE],ShortFmt)||' по '||rez.[LEGAL_LIST_REF].[FILE_NAME]||'. '||rez.[CHECK_VAL].[NAME];
					if Length(temp_data)>=temp_data%size-i100 then
						temp_data:=temp_data||'...'||CHR(13)||'(Информации много. Вывод ограничен '||temp_data%size||' Байтами)';
						exit;
					end if;
				end loop;
				P_DATA:=nvl(trim(temp_data,chr(13)),'.');
				P_DATA:=replace(P_DATA,'Не выявлено совпадений','Нет совпадений');
				debug_pipe(P_DATA,dp3);

				---------------------------------------------------------------------------------------------------------------------
			elsif p_info = 'ПЕРЕВОД_НЕРЕЗ' then
	 		--Сведения о переводах клиента нерезидентам
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'CL_ANK_PLAN_NEREZ');
			end if; --end P_info значимых полей
			&debug('[30]P_DATE('||Length(P_DATA)||')='||P_DATA,dp3)

			--Башкиров В.Г. 18.04.2019 Добавлен поиск произвольного доп.свойства
			--Башкиров В.Г. 21.05.2019 Добавлен поиск произвольного доп.свойства
			--Башкиров В.Г. 22.05.2019 Для РЕПУТАЦИЯ_PLUS и ФИНПОЛОЖЕНИЕ_PLUS null,Да - Положительная(ое) Нет - Отрицательная(ое) (Письмо от Лопухова С.Н., Карзановой Е.В. от 22.05.2019)
			if p_info='НЕ_ПРЕД_КЛ_ИЛИ_БЕНЕФ' then
				&debug('Ищем доп.свойство "ПРЕД_КЛ" P_DATE_PRINT='||to_char(P_DATE_PRINT,fmt),dp2)	
				if GetAddProps(P_DATE_PRINT, 'ПРЕД_КЛ') is null and
				   GetAddProps(P_DATE_PRINT, 'БЕНЕФ') is null then
				   P_DATA:= ' V '; --'Да' "Птица" для квадратика в анкете
				end if;
	 		elsif p_info = 'РЕПУТАЦИЯ_PLUS' then
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'РЕПУТАЦИЯ_PLUS');
                if    P_DATA is null or Upper(trim(P_DATA))='ДА'  then P_DATA := 'Положительная';
                elsif Upper(trim(P_DATA))='НЕТ' 				  then P_DATA := 'Отрицательная';
                end if;

	 		elsif p_info = 'ФИНПОЛОЖЕНИЕ_PLUS' then
	 			P_DATA := GetAddProps(P_DATE_PRINT, 'ФИНПОЛОЖЕНИЕ_PLUS');
                if    P_DATA is null or Upper(trim(P_DATA))='ДА'  then P_DATA := 'Положительное';
                elsif Upper(trim(P_DATA))='НЕТ' 				  then P_DATA := 'Отрицательное';
                end if;

            -- KAS 20/05/2021 для анкет по 499-П
	 		elsif p_info = 'НАЛОГОВЫЙ_СТАТУС2' then
	 		--7.1.	Сведения о наличии статуса налогового резидента иностранного государства

                temp_str := GetAddPropVal(this, 'НАЛОГОВЫЙ_СТАТУС2', P_DATE_PRINT);
                if client_priv.[NU_REZIDENT] and temp_str is null then
		 			P_DATA := 'являюсь налоговым резидентом только РФ';
                elsif  temp_str is not null then
		 			P_DATA := 'являюсь налоговым резидентом иностранного государства ';
		 			P_DATA := P_DATA||temp_str;
                else
		 			P_DATA := 'являюсь налоговым резидентом иностранного государства ';
		 				if client_priv.[COUNTRY].[NAME] is not null then
					    	P_DATA :=P_DATA||client_priv.[COUNTRY].[NAME];
					    	
						end if;
		 		end if;	
           	
 	 		elsif p_info = 'SITIZEN_USA' then
 			-- 7.2. Если Вы указали страну рождения США, являетесь ли Вы гражданином США   	 		
		 		temp_str := GetAddPropVal(this, 'SITIZEN_USA', P_DATE_PRINT);
		 		P_DATA :=temp_str;

			end if;
			
			if trim(P_DATA) is null then
				--Башкиров В.Г. 28.05.2019 Для кодов типа CL_ANK_PDL_INFO_ (последний символ "_") если значение пустое - выдавать " " вместо "нет"
				if Substr(p_info,Length(p_info))='_' then
					&debug('Обрезаем последний символ кода "_" (признак вывода " " вместо "Нет") '||p_info||'->'||Substr(p_info,1,Length(p_info)-1),dp2)
					p_info:=Substr(p_info,1,Length(p_info)-1); flSpace:=true;
				end if;
				--
				&debug('Ищем доп.свойство "'||p_info||'" P_DATE_PRINT='||to_char(P_DATE_PRINT,fmt),dp2)
	
				temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
				for dop in this.[ADD_PROP]
				where Upper(dop.[GROUP_PROP].[CODE])=Upper(p_info) and
					nvl(dop.[DATE_BEG],P_DATE_PRINT)<=P_DATE_PRINT and P_DATE_PRINT<=nvl(dop.[DATE_END],P_DATE_PRINT)
				loop
					temp_str := trim(
						iif(dop.[GROUP_PROP].[TYPE_VALUE] is null ,dop.[PROP].[NAME],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='NUMBER',to_char(dop.[NUM],'999G999G999G999G990D0099'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='STRING',dop.[STR],'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='DATE'  ,to_char(dop.[V_DATE],fmt),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='BOOL'  ,iif(dop.[BOOL],'Да','Нет'),'')||
						iif(dop.[GROUP_PROP].[TYPE_VALUE]='REF'   ,::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),'')
						           );
					&debug('Нашли группу '||dop.[GROUP_PROP].[CODE]||'-'||dop.[GROUP_PROP].[NAME]||' С типом значения:'||dop.[GROUP_PROP].[TYPE_VALUE]||' -> '||temp_str,dp2)
					
					if temp_str is null then
						rPropGRP:=dop.[GROUP_PROP];
						&debug('Ищем в "Противодействие легализации. Список шаблонов сведений" Свойства договора:'||rPropGRP.[CODE]||'-'||rPropGRP.[NAME],dp2)
						temp_str := null;
						for templateOne in ::[CL_ANK_TEMPLATES]
						where templateOne.[ADDITIONAL_PROP]=rPropGRP
						loop
							temp_str := trim(temp_str || templateOne.[VALUE]||LF$);
						end loop;
						temp_str:=trim(temp_str,LF$);
					end if;
					exit;
				end loop;

				if temp_str is null then
					var p_info2 varchar(100);
					if InStr(Upper(p_info),'_ЛОГИКА')>0 then p_info2:=SubStr(Upper(p_info),1,InStr(Upper(p_info),'_ЛОГИКА')-1);
						&debug('Ищем доп.свойство "'||p_info2||'" P_DATE_PRINT='||to_char(P_DATE_PRINT,fmt),dp2)
			
						temp_str := null; --GetAddProps(P_DATE_PRINT, 'PSH_PDL_RODSTVO');
						for dop in this.[ADD_PROP]
						where Upper(dop.[GROUP_PROP].[CODE])=Upper(p_info2) and
							nvl(dop.[DATE_BEG],P_DATE_PRINT)<=P_DATE_PRINT and P_DATE_PRINT<=nvl(dop.[DATE_END],P_DATE_PRINT)
						loop
							temp_str := trim(
								iif(dop.[GROUP_PROP].[TYPE_VALUE] is null ,dop.[PROP].[NAME],'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='NUMBER',to_char(dop.[NUM],'999G999G999G999G990D0099'),'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='STRING',dop.[STR],'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='DATE'  ,to_char(dop.[V_DATE],fmt),'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='BOOL'  ,iif(dop.[BOOL],'Да','Нет'),'')||
								iif(dop.[GROUP_PROP].[TYPE_VALUE]='REF'   ,::[RUNTIME].[OBJ].GetObjValue(dop.[OBJ], dop.[GROUP_PROP].[TBP]),'')
								           );
							if temp_str='Да' then temp_str:=' V ';   --dop.[PROP].[NAME]; типа 'Да' "Птица" для квадратика в анкете
							else				  temp_str:='     '; --пять пробелов для пустышки а квадратике
							end if;
							&debug('Для %_ЛОГИКА Нашли группу '||dop.[GROUP_PROP].[CODE]||'-'||dop.[GROUP_PROP].[NAME]||' С типом значения:'||dop.[GROUP_PROP].[TYPE_VALUE]||' -> "'||'"',dp2)
							exit;
						end loop;
						if temp_str is null then
							temp_str:='     '; --пять пробелов для пустышки а квадратике
						end if;
					end if;
				end if;

				if temp_str is not null then P_DATA:=temp_str;
				elsif p_info='CL_ANK_BDB' then P_DATA:='Бенефициарный владелец определен клиентом'; -- Vorobey 20190611 Значение по умолчанию для CL_ANK_BDB
				elsif p_info='CL_ANK_PROF_INC_TAX' then P_DATA:='нет, не нахожусь на специальном налоговом режиме "Налог на профессиональный доход"'; -- Vorobey 20190708 Значение по умолчанию для CL_ANK_PROF_INC_TAX
				else
					if flSpace then P_DATA:=' ';   &debug('flSpace='||flSpace,dp)--Башкиров В.Г. 28.05.2019 Для кодов типа CL_ANK_PDL_INFO_ (последний символ "_") если значение пустое - выдавать " " вместо "нет"
					else	  	    P_DATA:=empty_filler; -- Ильин Д.А. 'нет' изменено на '-'
					end if;
				end if;
			end if;
			--&debug('На '||to_char(P_DATE_PRINT,fmt)||' '||Rpad(p_info,22)||'->'||P_DATA,dp)

		end if; --end P_info[ACC_BANK]
		if P_BATCH then
    	    [CSMD].command(V_VB,'Form1.ScriptPostEvent OK, "CLICK"');
		end if;    
		if P_info='OK' then
			&debug('('||Length(V_VB)||')'||SubStr(V_VB,1,2000),dp)
		end if;
	end if; --end p_message
end;

execute is
/*********************************************************************
Назначение:

Maa, последнее изменение 4 Март 2003 г.
*********************************************************************/
begin
	/*
						ВНИМАНИЕ!
	В КЛИЕНТ-СКРИПТЕ ЕСТЬ УДАЛЕНИЕ СТРОК ТАБЛИЦЫ В ШАБЛОНЕ ПО НОМЕРУ СТРОКИ!
	ЕСЛИ ВЫ ДОБАВЛЯЕТЕ В ШАБЛОН НОВУЮ СТРОКУ В ТАБЛИЦЕ, УБЕДИТЕСЬ ЧТО ЭТО НЕ ПОВЛИЯЕТ НА УДАЛЕНИЕ
	МОЖЕТ ПОЛУЧИТЬСЯ ТАК, ЧТО СТАНЕТ УДАЛЯТЬСЯ НЕ ТА СТРОКА, СООТВЕТСТВЕННО ОПЕРАЦИЯ БУДЕТ РАБОТАТЬ НЕКОРРЕКТНО
	ТАКЖЕ ОБРАТИТЕ ВНИМАНИЕ ЧТО ЕСТЬ ЕЩЁ И УДАЛЕНИЕ ТАБЛИЦЫ ПО ЕЁ НОМЕРУ
	*/
	-- сброс значения глобальных переменных после отработки сервер- и клиент валидатора
   	if client_org_ref is not null then
   		client_org_ref.[DATE_ANK] := P_DATE_ANK;
		client_org_ref.[DATE_FORM_UPD_F] := P_DATE_FORM_UPD;
   	else
   		[DATE_ANK] := P_DATE_ANK;
		[DATE_FORM_UPD_F] := P_DATE_FORM_UPD;
   	end if;

	client_org_ref := null;
	cl_org_dolg_fase := null;
	executor.set_context( 'CL_INFO_COLLECTION', null);
	executor.set_context( 'CL_INFO_DATE', null);
end;
end;
end;
