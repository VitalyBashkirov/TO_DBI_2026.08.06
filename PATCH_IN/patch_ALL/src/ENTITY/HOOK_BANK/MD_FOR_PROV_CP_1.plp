--- end if;

	-- by smith 13/03/2025 via CFT-38
	if P_MESS='BEGIN'
	    and DOCUMENT%state = 'FORM'
	    and not ::[DOCUMENT].[DOC_LIB].check_history_state(DOCUMENT, 'AUX_CTRL')     
        and ::[AUX_CTRL_COND].[LIB_CHECK].get_actual_ctrl_type(this%id, 'MAIN_DOCUM') is null
        and upper(P_ADDS) like ('%BANK_FOR_PROV%BEFORE%') and upper(P_ADDS) not like ('%NEXT_CALL%')
	    --and coalesce(V_MD_FOR_PROV, '0') <> 'check_online '||DOCUMENT%ID 
	    then
        --V_MD_FOR_PROV := 'check_online '||DOCUMENT%ID;	    

	    if (
	            (
	            --if substr(ACCOUNT_DT.[MAIN_V_ID],1,3) in ( '423', '408') and  substr(ACCOUNT_CT.[MAIN_V_ID],1,8) in ('20202840','20202978') then
	            substr(ACCOUNT_DT.[MAIN_V_ID],1,1) = '4' and substr(ACCOUNT_CT.[MAIN_V_ID],1,5) = '20202'
	            and DOCUMENT.[ACC_DT].[CLIENT_V]%id <> ::[SYSTEM].[VARIABLES].OurBank
	            
	            )    
	            or 
	            (
	            --if DOCUMENT.[SUM_NT]>1000000 or DOCUMENT.[SUM]>1000000 or DOCUMENT.[SUM_PO]>1000000 then
	             --(DOCUMENT.[SUM_NT]>=250000 or DOCUMENT.[SUM]>=250000 or DOCUMENT.[SUM_PO]>=250000)
	             (
                  (::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT]) is not null
                   and (
                        DOCUMENT.[SUM_NT]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT])
                        or DOCUMENT.[SUM]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT])
                        or DOCUMENT.[SUM_PO]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT])
                        ) 
                   )
--                  or (::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT]) is not null
  --                    and (
    --                       DOCUMENT.[SUM_NT]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT])
      --                     or DOCUMENT.[SUM]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT])
        --                   or DOCUMENT.[SUM_PO]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT])
          --                 ) 
            --          )
                  or (
                      ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT]) is null
--                      and ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT]) is null
                      and (DOCUMENT.[SUM_NT]>=250000 or DOCUMENT.[SUM]>=250000 or DOCUMENT.[SUM_PO]>=250000)
                      )
	              )
	             --and (substr(ACCOUNT_DT.[MAIN_V_ID],1,3) in ( '423', '408'/*, '407'*/)  /*or substr(ACCOUNT_CT.[MAIN_V_ID],1,3) in ('423', '408', '407')*/)
	             and (substr(ACCOUNT_DT.[MAIN_V_ID],1,3) in ('407', '408') 
	                  and substr(ACCOUNT_CT.[MAIN_V_ID],1,3) in ('407', '408', '301')
	                  )
	             and DOCUMENT.[VID_DOC].[CODE] not in ('БЕЗН_ИНКАСС_ПОР', 'ИСПОЛНИТ_ДОКУМ')
                 and (
                      ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Check_PSH_CL_UFMPAYOK(DOCUMENT.[KL_DT]) is null
--                      and ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Check_PSH_CL_UFMPAYOK(DOCUMENT.[KL_KT]) is null
                      )
	            )
	            or 
	            (
	            --if DOCUMENT.[SUM_NT]>1000000 or DOCUMENT.[SUM]>1000000 or DOCUMENT.[SUM_PO]>1000000 then
	             --(DOCUMENT.[SUM_NT]>=250000 or DOCUMENT.[SUM]>=250000 or DOCUMENT.[SUM_PO]>=250000)
                 (
                  (::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT]) is not null
                   and (
                        DOCUMENT.[SUM_NT]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT])
                        or DOCUMENT.[SUM]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT])
                        or DOCUMENT.[SUM_PO]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT])
                        ) 
                   )
--                  or (::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT]) is not null
  --                    and (
    --                       DOCUMENT.[SUM_NT]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT])
      --                     or DOCUMENT.[SUM]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT])
        --                   or DOCUMENT.[SUM_PO]>=::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT])
          --                 ) 
            --          )
                  or (
                      ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_DT]) is null
--                      and ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Get_AUXCTRL_OVER_SUM(DOCUMENT.[KL_KT]) is null
                      and (DOCUMENT.[SUM_NT]>=250000 or DOCUMENT.[SUM]>=250000 or DOCUMENT.[SUM_PO]>=250000)
                      )
                  )
	             --and (substr(ACCOUNT_DT.[MAIN_V_ID],1,3) in ( '423', '408'/*, '407'*/)  /*or substr(ACCOUNT_CT.[MAIN_V_ID],1,3) in ('423', '408', '407')*/)
	             and (substr(ACCOUNT_DT.[MAIN_V_ID],1,5) = '30111' 
	                   and (substr(ACCOUNT_CT.[MAIN_V_ID],1,3) in ('407', '408') 
	                        or (substr(ACCOUNT_CT.[MAIN_V_ID],1,3) = '301'
	                            and substr(trim(nvl(DOCUMENT.[KL_KT].[2].[1], DOCUMENT.[NUM_KT])),1,3) in ('407', '408')
	                            )
	                        )
	                  )
	             and (
                      ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Check_PSH_CL_UFMPAYOK(DOCUMENT.[KL_DT]) is null
--                      and ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Check_PSH_CL_UFMPAYOK(DOCUMENT.[KL_KT]) is null
	                  )
	            )
	        )  then
	        
			DOCUMENT%state := 'AUX_CTRL';
		    message_text:='Внимание! Документ приостановлен на этапе "Доп. контроль".';		
			DOCUMENT.[TEXT_VOZV]:=message_text;
			--ANALYSE_OK := false;
			stdio.put_line_buf(message_text);		

        elsif (
               ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Check_PSH_CL_UFMPAYOK(DOCUMENT.[KL_DT])
--                or ::[HOOK_BANK].[MD_FOR_PROV_CP_1].Check_PSH_CL_UFMPAYOK(DOCUMENT.[KL_KT])
              ) then
             

			DOCUMENT%state := 'AUX_CTRL';
		    message_text:='Документ приостановлен на этапе "Доп. контроль" по отметке УФМ на клиенте: требуется доп. контроль платежей.';
		    DOCUMENT.[TEXT_VOZV]:=message_text;
			--ANALYSE_OK := false;		    
			stdio.put_line_buf(message_text);	
        
		end if;

		for(	
			select md(md 		: c_md
			, decode(f.[INN],md.[KL_DT].[2].[INN],1,0) : c_is_pl
			, case 
				when f.[RISK_LEVEL].[0] = 2 then 'высокий' 
				--when f.[RISK_LEVEL].[0] = 1 and f.[REASONS].[TYPOLOGY] is null then 'средний'
				when f.[RISK_LEVEL].[0] = 1 and f.[REASONS].[TYPOLOGY] is not null then 'средний c типологией'
			end : rlvl_text
			)in ::[MAIN_DOCUM]
			, (::[KYC_LIST_RISKS] :f)
			where md%id = DOCUMENT
            and coalesce(f.[RISK_DATE], f.[DATE_INCLUDE]) <= sysdate/*< md.[DATE_DOC] via CFT-3262*/ 
            and coalesce(f.[DATE_EXCLUDE], sysdate) >= sysdate/*md.[DATE_DOC] via CFT-3262*/
			and (f.[INN] = md.[KL_KT].[2].[INN] or f.[INN] = md.[KL_DT].[2].[INN] )
			and (
					f.[RISK_LEVEL].[0]=2 /*by smith 25/03/2025 via CFT-1012*/
					or (
						(f.[RISK_LEVEL].[0]=1 and f.[REASONS].[TYPOLOGY] is not null) /*via CFT-38*/
						and substr(md.[ACC_KT].[MAIN_V_ID], 1, 3) = '301'
	--					and md.[ACC_KT].[CLIENT_V]%id <> ::[SYSTEM].[VARIABLES].OurBank
						)
				)
			
			and DOCUMENT%state <> 'AUX_CTRL' 
			and rownum = 1
		) loop
		
		    DOCUMENT%state := 'AUX_CTRL';
            message_text:='Внимание! ';
            if md.c_is_pl = 1 then
                message_text:=message_text||'Плательщик ';
            else
                message_text:=message_text||'Получатель ';
            end if; 
            message_text:=message_text||'по документу имеет '||md.rlvl_text||' уровень риска ЗСК';
	        DOCUMENT.[TEXT_VOZV]:=message_text;
            --ANALYSE_OK := false;
		    stdio.put_line_buf(message_text||' Документ приостановлен на этапе "Доп. контроль. '||md.rlvl_text||' уровень риска ЗСК"');

		end loop;

		if DOCUMENT%state = 'AUX_CTRL' then
		
	         aux_ctrl_accept:= ::[AUX_CTRL_ACCEPT].[NEW_AUTO](
	                                       null		--Породившее условие
                                           ,::[AUX_CTRL_TYPE]([CODE]='COMMON')		--Вид операции
										   ,true		--Разрешен контроль одним пользователем
										   ,DOCUMENT%id	--Объект контроля
										   ,::[COM_STATUS_PRD]([CODE]='WAIT_CONF')		--Статус подтверждения
										   ,[SYSTEM]::[OP_DATE]		--Дата контроля
										   ,null		--Подтвердивший пользователь
									       ,usr		--Пользователь-создатель
	                                       ,1		--Приоритет
									       ,false	--Архивная запись
										);
			aux_ctrl_accept.[CREATE_DATE]:=	[SYSTEM]::[OP_DATE];

		end if;
	end if;

    /*end*/		

