class MAIN_DOCUM;

@import_plsql(true)
@name('ПСХ. Сводное платежное поручение (OOXML)')
@tag('COPIED')
batch method PSH_SVOD_PAY is
public type rec is record ( gr number, doc	ref [MAIN_DOCUM]);  -- составной тип


public type tbl_t is table of rec;  -- табличный тип
public grDocs tbl_t;



public type tbl_doc is table of ref [MAIN_DOCUM];  -- табличный тип
public docs tbl_doc; -- массив документов

pragma macro(xl,'[OOXML]::[API_XL]');

/*
procedure write_to_file
			( p_blob	in	out	blob
			, p_dir				varchar2(128)
			, p_fname			varchar2(128)
			)
is
	l_file_out 		integer;
	l_max_len 		integer;
	l_byte_to_read	integer;
	l_offset 		integer;
	l_str 			raw(32767);
	l_wb			integer;
begin
	l_file_out := stdio.open(p_dir, p_fname, 'w');
	l_max_len := 32765;
	l_byte_to_read := dbms_lob.getlength(p_blob);
	l_offset := 1;
	while l_byte_to_read > 0 loop
		dbms_lob.read(p_blob, l_max_len, l_offset, l_str);
		l_offset := l_offset + l_max_len;
		l_byte_to_read := l_byte_to_read - l_max_len;
		l_wb := stdio.fwrite(l_file_out, l_str, utl_raw.length(l_str));
	end loop;
	stdio.close(l_file_out);
end;
v_FN integer;
--========================================

*/

procedure Get_docs(PROV [BOOLEAN],
			patt_dt [ACCNUM],
			patt_kt [ACCNUM],
			P_DATE_PROV date,
			P_USER ref [USER],
			P_OTV_DT  ref [USER],
			P_OTV_KT ref [USER],
			P_FILIAL ref [BRANCH],
			P_DEPART ref [DEPART])
is
gr 			integer;
patt		varchar2(1024);
new_patt	varchar2(1024);
i			integer;
begin
	grDocs.Delete;
	gr := 0;
	patt := '***';
	i := 0;
	if patt_dt <> '%' and patt_kt <> '%' then	

		for md in ::[MAIN_DOCUM] where
  			md%state = 'PROV' and
			nvl(md.[KL_DT].[2].[1], md.[ACC_DT]->(true)[MAIN_V_ID]) like PATT_DT and
			nvl(md.[KL_KT].[2].[1], md.[ACC_KT]->(true)[MAIN_V_ID]) like PATT_KT and
			md.[DATE_PROV] >= P_DATE_PROV and
			md.[DATE_PROV] < P_DATE_PROV + 1 and
			(md.[DOCUMENT_USER] = P_USER or P_USER is null) and
			(md.[ACC_DT]->(true)[OTV] = P_OTV_DT or P_OTV_DT is null) and
			(md.[ACC_KT]->(true)[OTV] = P_OTV_KT or P_OTV_KT is null) and
			md.[FILIAL] = P_FILIAL  and
			(md.[DEPART] = P_DEPART or P_DEPART is null)
			order by md.[date_doc] , nvl(md.[KL_DT].[2].[1], md.[ACC_DT]->(true)[MAIN_V_ID]), nvl(md.[KL_KT].[2].[1], md.[ACC_KT]->(true)[MAIN_V_ID]), md.[KL_KT].[2].[2]
		loop
			new_patt := to_char(md.date_doc, 'yyyymmdd')||'*'||nvl(md.[KL_DT].[2].[1],  md.[ACC_DT].[MAIN_V_ID])||'*'||nvl(md.[KL_KT].[2].[1], md.[ACC_KT].[MAIN_V_ID])||'*'||md.[KL_KT].[2].[2];
			if new_patt <> patt then
				gr := gr + 1;	
				patt := new_patt;
			end if;
			grDocs(i).gr := gr;
			grDocs(i).doc := md;
			i := i + 1;
		end loop;
	else
		pragma hint ('index (a1 idx_z#MAIN_DOCUM_DATE_PROV)');
		for md in ::[MAIN_DOCUM] where
  				md%state = 'PROV' and
			md.[NUM_DT] like PATT_DT and
			md.[DATE_PROV] >= P_DATE_PROV and
			md.[DATE_PROV] < P_DATE_PROV + 1 and
			md.[NUM_KT] like PATT_KT and
			(md.[DOCUMENT_USER] = P_USER or P_USER is null) and
			(md.[ACC_DT]->(false)[OTV] = P_OTV_DT or P_OTV_DT is null) and
			(md.[ACC_KT]->(false)[OTV] = P_OTV_KT or P_OTV_KT is null) and
			md.[FILIAL] = P_FILIAL  and
			(md.[DEPART] = P_DEPART or P_DEPART is null)
			order by md.[date_doc] , nvl(md.[KL_DT].[2].[1], md.[ACC_DT]->(true)[MAIN_V_ID]), nvl(md.[KL_KT].[2].[1], md.[ACC_KT]->(true)[MAIN_V_ID]), md.[KL_KT].[2].[2]
		loop
			new_patt := to_char(md.date_doc, 'yyyymmdd')||'*'||nvl(md.[KL_DT].[2].[1],  md.[ACC_DT].[MAIN_V_ID])||'*'||nvl(md.[KL_KT].[2].[1], md.[ACC_KT].[MAIN_V_ID])||'*'||md.[KL_KT].[2].[2];
			if new_patt <> patt then
				gr := gr + 1;	
				patt := new_patt;
			end if;
			grDocs(i).gr := gr;
			grDocs(i).doc := md;
			i := i + 1;
		end loop;
	end if;
end;


PSH_SVOD_PAY (
	@name('Дата')                           P_DATE      in [DATE],
	@name('Филиал')                         P_FILIAL    in [BRANCH_REF],
	@name('Подразделение')                  P_DEPART    in [DEPART_REF],
	@name('Первая подпись')                 P_BOSS1     in [USER_REF],
	@name('Вторая подпись')                 P_BOSS2     in [USER_REF],
	@name('Номер сводного П/П')             P_NUM       in [NUM10],
	@name('Ответственный по счету дебета')  P_DT_USER   in [USER_REF],
	@name('Ответственный по счету кредита') P_KT_USER   in [USER_REF],
	@name('Создано пользователем')          P_CR_USER   in [USER_REF],
	@name('Только проведенные')             P_ONLY_PROV in [BOOLEAN],
	@name('Назначение платежа')             P_NAZN      in [STRING_500],
	@name('Шаблон выборки документа')       P_TEMPL     in [STRING_200]
) is

validate is


procedure DrawReestr(docs tbl_doc, Sheet number) is
idx		integer;
nRow	integer;
rDoc	ref [MAIN_DOCUM];
iFormat integer;
iBorder	integer;
iFont	integer;

nSum	number;

sDateIn		varchar2;
sDateProv	varchar2;
bFirst 		boolean;
rCurrency	ref [FT_MONEY];

	PAYER 			[PAYER_NAME];
	RECIPIENT 		[PAYER_NAME];
	INN_PAY 		[STRING];
	INN_REC 		[STRING];
	KPP_PAY			[STRING];
	KPP_REC			[STRING];
	ACC_REC 		[ACCNUM];
	ACC_PAY 		[ACCNUM];
	BANK_PAY 		[STRING_250];
	BANK_REC 		[STRING_250];
	KS_BANK_PAY 	[ACCNUM];
	KS_BANK_REC 	[ACCNUM];
	BIK_BANK_PAY 	[STRING_16];
	BIK_BANK_REC 	[STRING_16];
	P#DATE_PL 		[STRING];
	P#REZERV 		[STRING];
	VID_OP 			[STRING];
	P_NAME_DOC 		[STRING_100];
	DATE_DOC 		[STRING];
	DAT_P 			[STRING];
	VID_SEND 		[STRING];
	l_nazn			[MEMO];
	v_383			boolean;
	v_md_bank		ref [CL_BANK_N];	--	Ссылка на банк, указанный в филиале документа
	v_stamp			varchar2(512);
	v_adds			varchar2(2000);
	rDepart			ref [DEPART];
	sCode			varchar2(25);

begin
	&xl.AddCopySheet('Svod', 'Svod'||to_char(Sheet));
	&xl.AddCopySheet('Reestr', 'Reestr'||to_char(Sheet));

	&xl.Open_Sheet('Reestr'||to_char(Sheet));
	nRow := 0;
	iFormat := &xl.get_numFmt('#################0.00');
	iBorder := &xl.get_border(&xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin, &xl.xl_b_thin);
	
	iFont	:= &xl.get_font
		( p_name			== 'Calibri'
		, p_family			== 2
		, p_fontsize		== 10
		, p_theme			== 1
		, p_underline		== false
		, p_italic			== false
		, p_bold			== false
		, p_rgb				== null
		);
		
	
	
	nSum := 0;
	bFirst := true;
	idx := docs.first;
	while idx is not null loop
	
		nRow := nRow + 1;
		rDoc := docs(idx);
		
		if bFirst then
			bFirst := false;
			sDateIn := to_char(rDoc.[DATE_DOC], 'dd.mm.yyyy');
			sDateProv := to_char(rDoc.[DATE_PROV], 'dd.mm.yyyy');
			
			rCurrency := rDoc.[VALUTA];
			rDepart := rDoc.[DEPART];
			sCode := rDoc.[CODE];
				
			::[MAIN_DOCUM].[MD_OTHERS].SetCounter(::[NAME_PAYDOC]([code]='СВОД_ПЛ_ПОРУЧ'), P_NUM, true, true, false, null, null, rDepart);
			
			::[MAIN_DOCUM].[PRINT_SRV].InitSomeProps (rDoc ,null, null, PAYER, RECIPIENT, INN_PAY, INN_REC, ACC_PAY, ACC_REC, BANK_PAY,
			BANK_REC, KS_BANK_PAY, KS_BANK_REC, BIK_BANK_PAY, BIK_BANK_REC);
			if rDoc.[FILIAL] is null then
				pragma error ('Не указан филиал документа');
			end if;
			v_md_bank := ::[SYSTEM].[VARIABLES].Br2Bank(rDoc.[FILIAL]);
			PAYER		:= rDoc.[ACC_DT].[CLIENT_V].[NAME];

			-- Взять значение реквизита [Сумма в валюте платежа]

			P#DATE_PL:=to_char(rDoc.[DATE_PL],'DD.MM.YYYY');
			P#REZERV :=to_char(rDoc.[DPP], 'DD.MM.YYYY');

			P_NAME_DOC := upper(rDoc.[VID_DOC].[NAME]);
			DATE_DOC :=to_char(rDoc.[DATE_DOC],'DD.MM.YYYY'); --[DOCUMENT_DATE]
			v_383 := nvl(::[FP_TUNE].[LIB].get_date_value('BEGIN_383', null, '0') <= rDoc.[DATE_DOC], false);
			-- вид операции (шифр)
			if rDoc.[CODE_DOC] is not null then
				VID_OP := rDoc.[CODE_DOC].[CODE];
			else
				VID_OP := rDoc.[VID_DOC].[SHORT_CODE];
			end if;
			
			if rDoc.[BUDGET_PAYMENT] or rDoc.[BUD_REQS].[KBK_STR] is not null then
				KPP_PAY := rDoc.[ACC_DT].[CLIENT_V].[KPP];
				KPP_REC := rDoc.[KL_KT].[2].[KPP];
			end if;
			
			VID_SEND := rDoc.[DOC_SEND_REF].[VID_SEND];
			
			dat_p := rpad(nvl(bool_char(rDoc%state in ('PROV', 'PAY'), to_char(rDoc.[DATE_PROV],'dd.mm.yyyy'), ''),' '),14);
			
			[STR].set_par(v_adds, 'STAMP_DATE', to_char(P_DATE, 'DD/MM/RRRR'));			
			[STR].set_par(v_adds, 'STAMP_USER', stdlib.user_id.[name]);
			v_stamp := ::[PRINT_ATTR_VALUE].[PRINT_LIB].get_field_by_code(rDoc, 'STAMP', null, v_adds);
			
		end if;

	
		IF (TRIM(INN_PAY)='0') then
		    KPP_PAY:='0';
		end if;
			
		nSum := nSum + rDoc.[SUM];

		&xl.Write(3+nRow, 2, nRow, null, null, 10, null, 'M');
		&xl.Write(3+nRow, 3, rDoc.[DOCUMENT_NUM], null, null, 10, null, 'M');
		&xl.Write(3+nRow, 4, to_char(rDoc.[DATE_DOC], 'dd.mm.yyyy'), null, null, 10, null, 'M');
		&xl.Write(3+nRow, 5, nvl( rDoc.[KL_DT].[2].[1], rDoc.[KL_DT].[1].[2].[MAIN_V_ID]), null, null, 10, null, 'M');
		&xl.Write(3+nRow, 6, nvl( rDoc.[KL_KT].[2].[1], rDoc.[KL_KT].[1].[2].[MAIN_V_ID]), null, null, 10, null, 'M');
		&xl.Write(3+nRow, 7, rDoc.[NAZN], null, null, 10, null, 'M', true);
		&xl.Write(3+nRow, 8, rDoc.[BUD_REQS].[KBK_STR], null, null, 10, null, 'M');
		&xl.Write(3+nRow, 9, rDoc.[BUD_REQS].[NUM_EXP], null, null, 10, null, 'M');
		&xl.Write(3+nRow, 10, rDoc.[CODE], null, null, 10, null, 'M');
		&xl.Write(3+nRow, 11, nvl( rDoc.[KL_KT].[2].[2], rDoc.[KL_KT].[1].[1].[NAME]), null, null, 10, null, 'M', true);
		
		&xl.cell
			( 3+nRow
			, 12
			, rDoc.[Sum]
			, iFormat
			, iFont
			, null
			, iBorder
			, &xl.xl_av_center
			, &xl.xl_ah_right
			);

		idx := docs.next(idx);
	end loop;

	&xl.Write(2, 2, 'для сводного платежного поручения № '||P_NUM||' дата ' || to_char(P_DATE, 'dd.mm.yyyy'), null, null, 10, null, 'CM');

	&xl.Write(4+nRow, 3, 'Итого:', null, null, 12, null, 'MС');
	&xl.Set_format_range(4, 2,  4+nRow, 12, p_BorderID == iBorder);

	&xl.cell
		( 4+nRow
		, 12
		, nSum
		, iFormat
		, iFont
		, null
		, iBorder
		, &xl.xl_av_center
		, &xl.xl_ah_right
		);
	
	&xl.Write(5+nRow, 5, 'М.П.', null, null, 10, null, 'MС');

	&xl.Merge(6+nRow, 2, 6+nRow, 4);
	&xl.Write(6+nRow, 2, p_boss1.[casta].[value], null, null, 10, null, 'MС', true);
	&xl.Write(6+nRow, 6, ::[RUNTIME].[STDLIB].fio(p_boss1.[NAME],'Ф И. О.'));
	
	
	&xl.Merge(8+nRow, 2, 8+nRow, 4);
	&xl.Write(8+nRow, 2, p_boss2.[casta].[value], null, null, 10, null, 'MС', true);
	&xl.Write(8+nRow, 6, ::[RUNTIME].[STDLIB].fio(p_boss2.[NAME],'Ф И. О.'));
	


	-- Печатаем сводник -----------------------------------------------------
	l_nazn:= 'Перечисление денежных средств от физических лиц  согласно реестра //реестр// № '||p_num||' от ' ||to_char(P_DATE, 'dd.mm.yyyy')||'. Кол-во распоряжений '||nRow;

	&xl.Open_Sheet('Svod'||to_char(Sheet));

	&xl.Write(2, 1, sDateIn, null, null, 10, null, 'CM');
	&xl.Write(2, 9, sDateProv, null, null, 10, null, 'CM');
	&xl.Write(5, 18, to_char(P_DATE,'dd.mm.yyyy'), null, null, 10, null, 'CM');
	
	&xl.Write(5, 12, P_NUM, null, null, 10);
	
	&xl.Write(7, 5, STDLIB.N2STR(nSum, rCurrency.[CUR_SHORT]), null, null, 10, null, 'LT', true);
	&xl.Write(10, 25, [PRINTFUN].PrintNumSumm(nSum), null, null, 10);
	
	&xl.Write(10, 3, INN_PAY, null, null, 10);
	&xl.Write(10, 13, KPP_PAY, null, null, 10);
	&xl.Write(12, 1, PAYER, null, null, 10, null, 'LT', true);
	&xl.Write(13, 25, ACC_PAY, null, null, 10);
	&xl.Write(16, 1, BANK_PAY, null, null, 10, null, 'LT', true);
	&xl.Write(16, 25, BIK_BANK_PAY, null, null, 10);
	&xl.Write(17, 25, KS_BANK_PAY, null, null, 10);
		
	&xl.Write(22, 3, INN_REC, null, null, 10);
	&xl.Write(22, 13, KPP_REC, null, null, 10);
	&xl.Write(24, 1, RECIPIENT, null, null, 10, null, 'LT', true);
	&xl.Write(22, 25, ACC_REC, null, null, 10);
	&xl.Write(19, 1, BANK_REC, null, null, 10, null, 'LT', true);
	&xl.Write(19, 25, BIK_BANK_REC, null, null, 10);
	&xl.Write(20, 25, KS_BANK_REC, null, null, 10);
	
	&xl.Write(25, 24, VID_OP, null, null, 10);
	&xl.Write(26, 32, rDoc.[PRIORITET], null, null, 10);
	&xl.Write(27, 24, sCode, null, null, 10);
	&xl.Write(29, 1, l_nazn, null, null, 10, null, 'LT', true);
	
	&xl.Write(36, 25, v_stamp, null, null, 10, null, 'CT', true);
	
end;


	xl_out		blob		:= empty_blob();
	gr			number;
	vRepId		string;
	patt_dt		string;
	patt_kt		string;
	
	
Begin
	if P_MESSAGE = 'DEFAULT' then
		P_DATE := trunc(::[SYSTEM].[OP_DATE]);
		P_NUM := 1;
		P_FILIAL := StdLib.user_id.filial;
		P_DEPART := null;
		P_TEMPL := '40911% | 40101%';

		P_BOSS1 := StdLib.user_id;	
		P_BOSS2 := ::[CL_CORP].[EDIT_ANKETA].get_chief_user(::[SYSTEM].[VARIABLES].OurDepart, 'DEPART_BOSS');

	elsif P_MESSAGE = 'VALIDATE' then
		if P_INFO = 'P_DATE'and P_DATE is null	then
			pragma error('Введите отчетную дату');
		elsif P_INFO = 'CANCEL' then
			null;
		elsif P_INFO = 'OK' then
			
			if p_filial is null then
				pragma error('Укажите филиал');
			end if;
			
			patt_dt := trim(substr(p_templ, 1, instr(p_templ, '|')-1));
			patt_kt := trim(substr(p_templ, instr(p_templ, '|')+1));
			
			Get_docs(true, patt_dt, patt_kt, p_date, P_CR_USER, P_DT_USER, P_KT_USER, P_FILIAL, P_DEPART);
			
			
            [SHABLON_DOC]::[LIB_OOXML].load_blob('PSH_SVOD_PLAT',xl_out);
			If not [OOXML]::[API_XL].open_file(xl_out) Then				
				pragma error('Ошибка преобразования шаблона !');
			End If;

			docs.Delete;
			gr := 0;
			var Sheet number;
			Sheet := 0;
			
			for idx in 0..grDocs.count-1 loop
				if gr<>0 and grDocs(idx).gr<>gr then
					Sheet := Sheet + 1;
	    			DrawReestr(Docs, Sheet);
					Docs.Delete;
				end if;
				
				gr := grDocs(idx).gr;
				Docs(Docs.Count) := grDocs(idx).doc;
			end loop;

			-- Последняя группа
			if Docs.Count > 0 then
				Sheet := Sheet + 1;
				DrawReestr(Docs, Sheet);
			end if;

			&xl.delSheet('Reestr');
			&xl.delSheet('Svod');

			&xl.finish(xl_out);		
			-- Отправка файла отчёта пользователю на клиентскую машину
			vRepId	:= [OOXML]::[API_ORSA].putReport2Run(xl_out,'xlsx','Сводное платежное поручение № '||P_NUM||' от '||to_char(P_DATE,'dd-mm-yyyy'));
			
			Docs.Delete;
			grDocs.Delete;
		end If;
	end if;
End;

execute is

begin
   Null;
end;
end;
end;
