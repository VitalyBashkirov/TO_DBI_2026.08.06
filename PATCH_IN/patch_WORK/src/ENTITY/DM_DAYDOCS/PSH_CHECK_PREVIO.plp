class DM_DAYDOCS;

@optimize(false)
@this(create_on_start:=true)
@name('[ПСБ] Проверка предыдущих обработок (отпключены pragma error)')
@tag('COPIED')
method PSH_CHECK_PREVIO is
PSH_CHECK_PREVIO (
	@name('Экземпляр из массива обработки ПФИ') P_PROC_DM in [DM_PROC_REF],
	@name('Операция')                           P_OPER    in [DOG_OPER_REF]
) is

execute is
--#include stock.msg
V_PREV_WORK_DAY [DATE];
V_OUR_PORT_ID ref [DM_PORT_ID];
V_DFT ref [DM_DERIVATIVES];
v_str varchar2(500);
begin
	--AND
	--После появления признака на продукте DO_SVU недостаточно совпадения типа операции в предыдущем продукте.
	--Необходимо еще совпадение по признакам DO_BUH и/или DO_SVU

	--V_PREV_WORK_DAY := [CALENDAR].Next_Date('HOLIDAYS', '0', [DATE_BEGIN] - 1, -1);
	select x(max(x.[DATE_BEGIN])) in ::[DM_DAYDOCS]
	where x.[DATE_BEGIN]<[DATE_BEGIN]
	and x%state='TO_EXEC'
	and (x.[DO_OWN] and [DO_OWN] or x.[DO_CLI] and [DO_CLI])
	and x.[OPER].[OPER_TYPE]=P_OPER.[OPER_TYPE]
	--AND
	and (x.[DO_BUH] and [DO_BUH] or x.[DO_SVU] and [DO_SVU])
	into V_PREV_WORK_DAY;
	
	V_OUR_PORT_ID:=::[DM_DAYDOCS].[SLIB].GetOurPortId;
&dmess('V_PREV_WORK_DAY='||to_char(V_PREV_WORK_DAY,'dd/mm/yyyy')||' V_OUR_PORT_ID='||V_OUR_PORT_ID);	
	if P_PROC_DM is not null then
		select x(x.[DFT]) in this.[PROCESS_DM] where x=P_PROC_DM
		into V_DFT;
		/*AND
		for(select x(1) in ::[DM_PROC] all
			where x.[DATE_OP]=V_PREV_WORK_DAY
			and x.[DFT]=V_DFT
			and x.[PORT_ID]=V_OUR_PORT_ID
			and x.[OPER_TYPE]=P_OPER.[OPER_TYPE]
			and x%state not in ('PROCESSED','NO_MOVE')
			)
		loop
			pragma error('В продукте за дату '||to_char(V_PREV_WORK_DAY,'dd/mm/yyyy')||' не завершена обработка операции "'||P_OPER.[OPER_TYPE].[NAME]||'" по ПФИ '||V_DFT.[CODE]);
		end loop;*/	
		v_str:=null;
		for(select x(x.[DO_BUH]:DO_BUH,
					x.[DO_SVU]:DO_SVU
					) in  ::[DM_DAYDOCS]
			where x.[DATE_BEGIN]=V_PREV_WORK_DAY
			and (x.[DO_OWN] and [DO_OWN] or x.[DO_CLI] and [DO_CLI])
			and (x.[DO_BUH] and [DO_BUH] or x.[DO_SVU] and [DO_SVU])
			and x.[PROCESS_DM].[DFT]=V_DFT
			and ([DO_OWN] and x.[PROCESS_DM].[PORT_ID]=V_OUR_PORT_ID
				or
				[DO_CLI] and x.[PROCESS_DM].[PORT_ID]<>V_OUR_PORT_ID
				)
			and x.[PROCESS_DM].[OPER_TYPE]=P_OPER.[OPER_TYPE]
			and x.[PROCESS_DM]%state not in ('PROCESSED','NO_MOVE')
			)
		loop
			if [DO_BUH]=true and x.DO_BUH=1 or [DO_SVU]=true and x.DO_SVU=1 then
				if [DO_BUH]=true and x.DO_BUH=1 then
					v_str:='в части бухгалтерских документов';
				end if;	
				if [DO_SVU]=true and x.DO_SVU=1 then
					if v_str is null then
						v_str:='в части документов СВУ';
					else
						v_str:=v_str||' и документов СВУ';
					end if;
				end if;
			end if;
			pragma error('В продукте за дату '||to_char(V_PREV_WORK_DAY,'dd/mm/yyyy')||' не завершена обработка операции "'||P_OPER.[OPER_TYPE].[NAME]||'" по ПФИ '||V_DFT.[CODE]||' '||v_str);
		end loop;
	else
		--В массиве Обработанных ПФИ (this.[PROCESS_DM]) операции P_OPER есть необработанные записи.
		--Некоторые из их аналогов в предыдущих продуктах не обработаны.
		/*AND
		for(select x(1) in ::[DM_PROC], (this.[PROCESS_DM]:y) all
			where x.[DATE_OP]=V_PREV_WORK_DAY
			and y.[OPER]=P_OPER
			and y%state in ('PREPARE','CANCELED','ERROR','NEED_CHECK')
			and x.[DFT]=y.[DFT]
			and x.[PORT_ID]=V_OUR_PORT_ID
			and x.[OPER_TYPE]=P_OPER.[OPER_TYPE]
			and x%state not in ('PROCESSED','NO_MOVE')
			)
		loop
			pragma error('В продукте за дату '||to_char(V_PREV_WORK_DAY,'dd/mm/yyyy')||' не завершена обработка операции "'||P_OPER.[OPER_TYPE].[NAME]||'"');
		end loop;	
		*/
		v_str:=null;
		for(select x(x.[DO_BUH]:DO_BUH,
					x.[DO_SVU]:DO_SVU
					) in  ::[DM_DAYDOCS],(this.[PROCESS_DM]:y)
			where x.[DATE_BEGIN]=V_PREV_WORK_DAY
			and (x.[DO_OWN] and [DO_OWN] or x.[DO_CLI] and [DO_CLI])
			and (x.[DO_BUH] and [DO_BUH] or x.[DO_SVU] and [DO_SVU])
			and y.[OPER]=P_OPER
			and y%state in ('PREPARE','CANCELED','ERROR','NEED_CHECK')
			and x.[PROCESS_DM].[DFT]=y.[DFT]
			and ([DO_OWN] and x.[PROCESS_DM].[PORT_ID]=V_OUR_PORT_ID
				or
				[DO_CLI] and x.[PROCESS_DM].[PORT_ID]<>V_OUR_PORT_ID
				)
			and x.[PROCESS_DM].[OPER_TYPE]=P_OPER.[OPER_TYPE]
			and x.[PROCESS_DM]%state not in ('PROCESSED','NO_MOVE')
			)
		loop
			if [DO_BUH]=true and x.DO_BUH=1 or [DO_SVU]=true and x.DO_SVU=1 then
				if [DO_BUH]=true and x.DO_BUH=1 then
					v_str:='в части бухгалтерских документов';
				end if;	
				if [DO_SVU]=true and x.DO_SVU=1 then
					if v_str is null then
						v_str:='в части документов СВУ';
					else
						v_str:=v_str||' и документов СВУ';
					end if;
				end if;
			end if;
			--Башкиров В.Г. 17.10.2024 (отключены pragma error)
			--pragma error('В продукте за дату '||to_char(V_PREV_WORK_DAY,'dd/mm/yyyy')||' не завершена обработка операции "'||P_OPER.[OPER_TYPE].[NAME]||'" '||v_str);
			&dmess('ОТКЛЮЧЕНО pragma error(В продукте за дату '||to_char(V_PREV_WORK_DAY,'dd/mm/yyyy')||' не завершена обработка операции "'||P_OPER.[OPER_TYPE].[NAME]||'" '||v_str);
		end loop;
	end if;	
end;
end;
end;
