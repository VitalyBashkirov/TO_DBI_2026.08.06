class REPS;

@name('[ПСБ] Изменить')
@tag('CREATED')
method PSH_EDIT_AUTO is
PSH_EDIT_AUTO (
	@name('Наименование')                         P_NAME          in [STRING_250],
	@name('Код')                                  P_CODE          in [STRING_16],
	@name('Отчетность ЦБ')                        P_CB            in [BOOLEAN],
	@name('Срок хранения данных отчета (в днях)') P_KEEP_DATA     in [SHORT4],
	@name('Операция стандартного заполнения')     P_TUN_FILL_METH in [NAME],
	@name('Массив нормативных актов ЦБ')          P_CB_ACTS_ARR   in [CB_ACTS_ARR]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_NAME := this.[NAME];
	P_CODE := this.[CODE];
	P_CB := this.[CB];
	P_KEEP_DATA := this.[KEEP_DATA];
	P_TUN_FILL_METH := this.[TUN_FILL_METH];
	P_CB_ACTS_ARR := this.[CB_ACTS_ARR];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	-- Установка значения реквизита "Наименование"
	[NAME] := P_NAME;
	-- Установка значения реквизита "Код"
	[CODE] := P_CODE;
	-- Установка значения реквизита "Отчетность ЦБ"
	[CB] := P_CB;
	-- Установка значения реквизита "Срок хранения данных отчета (в днях)"
	[KEEP_DATA] := P_KEEP_DATA;
	-- Установка значения реквизита "Операция стандартного заполнения"
	[TUN_FILL_METH] := P_TUN_FILL_METH;
end;
end;
end;
