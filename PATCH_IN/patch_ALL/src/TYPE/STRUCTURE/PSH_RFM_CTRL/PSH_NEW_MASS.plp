class PSH_RFM_CTRL;

@name('[ПСБ] Служебная. Массовое заполнение записей')
static method PSH_NEW_MASS is
dp2 integer:=null;	--управление debug_pip

function GetNextWord(p_find_string string(32767), p_word_num number, p_find_word string(128) default null, separator string(4) default ' ' ) return string(128) is 
ExStr string(128);
v_from number;
v_to   number;
res    boolean;
begin
	p_find_word := '';
	res := false;
	
	if separator <> ' ' then
		p_find_string := translate(p_find_string, separator, rpad('~',length(separator),'~'));
		separator := '~';
		debug_pipe('PSB_EDIT_SEX.GetNextWord -- p_find_string='||p_find_string,dp2);
	end if;
	
	--первое слово?
	if p_word_num = 1 then
		v_from	:= 0;
		v_to	:= instr(p_find_string, separator);
	else
		v_from := instr(p_find_string, separator, 1, p_word_num - 1);
		if v_from >= 1 then
			v_to   := instr(p_find_string, separator, v_from + 1);
		else
			v_to := 0;
		end if;
	end if;

	--конец строки!
	if (v_from = 0) and (v_to = 0) and (p_word_num > 1) then
		p_find_word := '';
		p_find_word:=Replace(p_find_word,'~');
		debug_pipe('PSB_EDIT_SEX.GetNextWord -- '||p_word_num||' "'||separator||'" -='||ExStr||'=- '||p_find_string,dp2);
		return ExStr;
		--return false;
	end if;
	
	--последнее слово?
	if (v_to = 0) and (length(p_find_string) > v_from) then
		v_to := length(p_find_string);
	end if;
	
	--выкусить нужное слово
	if (v_to > 0) then
		p_find_word := trim(substr(p_find_string, v_from + 1, v_to - v_from));
		res := true;
	end if;
	
	p_find_word:=Replace(p_find_word,'~');
	--return res;
	ExStr:=p_find_word;
	debug_pipe('PSB_EDIT_SEX.GetNextWord -- '||p_word_num||' "'||separator||'" -='||ExStr||'=- '||p_find_string,dp2);
	return ExStr;
end;
PSH_NEW_MASS (
	@name('Запись')           P_CTRL_REC      in [MEMO],
	@name('Тип записи')       P_CTRL_TYPE     in [ONE_FROM_THREE],
	@name('Частота проверки') P_CTRL_PERIOD   in [CASE_BETWEEN_TWO],
	@name('Дата добавления')  P_CTRL_ADD_DATE in [DATE],
	@name('Добавил')          P_CTRL_USER     in [STRING_60],
	@name('Примечание')       P_CTRL_NOTE     in [MEMO]             default null
) is

validate is
begin
if p_message = 'DEFAULT' then
	P_CTRL_TYPE.[0] := 1;
	P_CTRL_PERIOD.[0] := 1;
	P_CTRL_ADD_DATE := ::[SYSTEM].[OP_DATE];
	P_CTRL_USER := ::[RUNTIME].[STDLIB].fio(stdlib.userid.[NAME], 'Ф И. О.');
end if;
end;

execute is
i integer := 1;
rec string;
same_rec INTEGER;
begin
	if instr(P_CTRL_REC, ',,') > 0 then
		pragma error('В тексте присутствуют две запятые подряд. Разбор не может быть выполнен!');
	end if;
	while trim(GetNextWord(P_CTRL_REC, i, null, ',')) is not null
	loop
		rec := trim(GetNextWord(P_CTRL_REC, i, null, ','));
		select x(count(x)) in ::[PSH_RFM_CTRL]
			where x.[CTRL_REC] = rec
			into same_rec;
		if same_rec = 0 then
			::[PSH_RFM_CTRL].[PSH_NEW](rec, P_CTRL_TYPE, P_CTRL_PERIOD, P_CTRL_ADD_DATE, P_CTRL_USER, P_CTRL_NOTE);
		end if;
		i := i + 1;
	end loop;
end;
end;
end;
