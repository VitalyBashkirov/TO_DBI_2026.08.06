class PSH_CUST_DOCS;

@import_plsql(true)
@name('[ПСБ] 5.1.Сформировать ответ на документ')
@tag('COPIED')
batch method PSH_CREATE_MES_O is
pragma include(::[PSH_CUST_DOCS].[PSH_LIB]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
pragma include(::[PSH_CUST_DOCS].[PSH_LIB_TC]); -- updated CHANGE_QUALIFIER PSB_CUST_DOCS->PSH_CUST_DOCS 08/10/25
PSH_CREATE_MES_O is

execute is
/*
Операция для формирования общего сообщения по ответам из подсистем
*/

v_tab_docs	&lib.T_Doc;
begin
	for i in 1..this.count loop
		if this(i).[DOC_STATE] = &libtc.stAnswer and this(i)%class = ::[PSH_CUST_DOCS_IN]%class then		
			v_tab_docs(i).doc		:= this(i);
			v_tab_docs(i).doc_type	:= this(i).[DOC_TYPE];
			v_tab_docs(i).doc_state	:= this(i).[DOC_STATE];
		end if;
	end loop;

	&lib.create_messages(v_tab_docs);
end;
end;
end;
