class COMBO_BOXES;

@this(create_on_start:=true)
@generate_ansi_joins(true)
@name('[ПСБ] Стандартные заполнения из операций')
@tag('COPIED')
method PSH_STD_LOAD is
	vOpCode			string;
	iOrder			integer;	-- Номер п/п

Procedure Write( P_NAME	::[COMBO_BOXES].[NAME]%type ) is
	rec				[COMBO_BOXES];
	rCBox		ref [COMBO_BOXES];
Begin
	iOrder	:= iOrder + 1;

	for	(	select u( u%id			: rid
					, u.[NAME]			: C_NAME
					)
				in	::[COMBO_BOXES] all
			Where	u.[CODE] = vOpCode
				and	u.[NUM] = iOrder
		)
	Loop
		If u.C_NAME = P_NAME Then
			return;
		End If;

		update y( y.[NAME]	= P_NAME)
			in	::[COMBO_BOXES]
		where	y%id = u.rid;

		return;
	End Loop;

	rec.[CODE]	:= vOpCode;
	rec.[NUM]	:= iOrder;
	rec.[NAME]	:= P_NAME;
	rCBox		:= ::[COMBO_BOXES]%insert(rec);
End;
PSH_STD_LOAD (
	@name('Код операции') P_CODE in [STRING]
) is

execute is
-- Сортировка в выпадающем списке по названию.
-- Чтобы 1-ой строкой было "Нет", ставим пробел/ы или тире...

Begin
	vOpCode	:= P_CODE;
	iOrder	:= 0;

	case P_CODE of

	:'DOCS_LIST_UNI':	-- Универсальный реестр документов

		Write('  ---- Нет ----'							);	-- 1
		Write(' Валюта'									);	-- 2
		Write(' Подразделение'							);	-- 3
		Write(' Пользователь'							);	-- 4
		Write(' Вид'									);	-- 5
		Write(' Дополнительные группировки'				);	-- 6
		Write(' Балансовый счет'						);	-- 7
		Write(' Балансовый счет верхнего уровня'		);	-- 8
		Write(' Пачка'									);	-- 9
		Write(' Клиент'									);	-- 10
		Write(' Лицевой счет'							);	-- 11
		Write(' Документы РБО / Документы для свода дня');	-- 12
		Write(' Документы ДБО / Документы не ДБО'		);	-- 13

	:'ACCMOVE':			-- Выписка

		Write('  ---- Нет ----'							);	-- 1
		Write(' Подразделение'							);	-- 2
		Write(' Ответственный'							);	-- 3
		Write(' Владелец'								);	-- 4
		Write(' Балансовый счет'						);	-- 5
		Write(' Валюта'									);	-- 6
		Write(' Код назначения платежа '				);	-- 7	-- СБ РФ г.Ростов

	:'ACC_TURN':		-- Ведомости (Оборотная и Сальдовая) с валютным эквивалентом	и пр.

		Write('  ---- Нет ----'							);	-- 1
		Write(' Балансовый счет'						);	-- 2
		Write(' Ответственный'							);	-- 3
		Write(' Клиент'									);	-- 4
		Write(' Валюта'									);	-- 5
		Write(' Актив/Пассив'							);	-- 6
		Write(' Л/с после 10-го символа'				);	-- 7
		Write(' Л/с: Символы с 14 по 20'				);	-- 8	-- СБ РФ г.Псков:	символ доходов Ф-102
		Write(' Л/с: Символы с 17 по 20'				);	-- 9	-- 					код филиала
		Write(' Подразделение'							);	-- 10
		Write(' Л/с: Символы с 14 по 18'				);	-- 11
		Write(' Категория клиента'						);	-- 12
		Write(' Основной ОКВЭД'							);	-- 13
		Write(' Л/с: Символы с 21 по 25'				);	-- 14	-- СБ РФ г.Пермь
		Write(' ОКАТО'									);	-- 15	--28.03.2024 ОКАТО

	:'ACC_TURN_CALCTYPE':		-- Оборотная ведомость с валютным эквивалентом

		Write(' Сводный'								);	-- 1
		Write(' По филиалу (подразделению)'				);	-- 2
		Write(' По нескольким подразделениям филиала'	);	-- 3

	:'CASH_REP':		-- Универсальный кассовый отчет

		Write('  ---- Нет ----'							);	-- 1
		Write(' Валюта'									);	-- 2
		Write(' Приход/Расход'							);	-- 3
		Write(' Номер кассы'							);	-- 4
		Write(' Вид документа'							);	-- 5
		Write(' Подсимвол кассы'						);	-- 6
		Write(' Кассир'									);	-- 7

	:'CJ2481U':			-- Кассовый журнал (формы 0401704, 0401705)

		Write('  ---- Нет ---- '						);	-- 1
		Write(' Б/с корреспондента'						);	-- 2
		Write(' Кассир'									);	-- 3
		Write(' Шифр документа'							);	-- 4
		Write(' Контролер'								);	-- 5

	:'CJ2481U_ORDER':	-- Касссовый журнал (формы 0401704, 0401705)	-- Порядок печати

		Write('  ---- Нет ---- '						);	-- 1
		Write(' Валюта'									);	-- 2
		Write(' Дата проводки'							);	-- 3
		Write(' Счёт кассы'								);	-- 4

	:'F_401_NEREZ':		-- ОП Ф-401 Справочник кодов нерезидентов
		
		Write('Тип нерезидента'							);	-- 1
		Write('Сектор нерезидента'						);	-- 2
		Write('Признак ПСН'								);	-- 3
		
	 Else
		pragma error('Список выпадающего меню в операции для ' || P_CODE || ' не определён!');
	End;

--	delete	u in ::[COMBO_BOXES]
--	Where	u.[CODE] = P_CODE
--		and	u.[NUM] > iOrder;
End;
end;
end;
