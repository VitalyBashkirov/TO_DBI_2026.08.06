			return 'Перед отключением приложения необходимо очистить справочник "ОП Срочные сделки. Разработочная таблица" (DM_DATA)';
		end if;

	:'1B620071':	-- Проверка наличия данных по приложению 'Расчет данных H25'
		-- Если отмена регистрации, то проверить наличие записей
		select	y(count(1))
		in	(	select	y(y)
				in		::[H25_DATA]
				fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо очистить справочник "ОП Нормативы. Н25. Данные" (H25_DATA)';
		end if;

	:'1B618005':	-- Проверка наличия данных по приложению 'Расчет коэффициента фондирования'
		-- Если отмена регистрации, то проверить наличие записей
		select	y(count(1))
		in	(	select	y(y)
				in		::[NORM_DATA]
					,	(::[REPS_PARAMS] : p)
					,	(::[REPS] : r)
				where	y.[PARAM] = p
					and	p.[REPORT] = r
					and	r.[CODE] = 'FUNDED'
					and	y.[PARAM] is not null
					fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить все реализации отчета "Расчет коэффициента фондирования"';
		end if;

	:'1B620214':-- Проверка наличия данных по приложению "Форма 0409303. Расчет данных по кредитным договорам"
		select	d(count(1))
		in	(	select	x(x)
				in		::[F_303_CRED_DATA]
				fetch 1
			)
		into iCount;

		if iCount > 0 then
			return 'Перед отключением приложения необходимо удалить все данные справочника "ОП Ф-303. Данные по кредитам"';
		end if;

