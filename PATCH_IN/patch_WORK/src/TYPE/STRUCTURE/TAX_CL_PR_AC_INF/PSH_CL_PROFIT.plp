class TAX_CL_PR_AC_INF;

@name('[ПСБ] Привязать клиента  (служебная)')
method PSH_CL_PROFIT is
PSH_CL_PROFIT (
	@name('Доход клиента') P_CL_PROFIT in [TAX_CL_PROFI_REF]
) is

validate is
begin
-- Start initialization of parameters and variables
if p_message = 'DEFAULT' then
	P_CL_PROFIT := this.[CL_PROFIT];
end if;
-- End initialization of parameters and variables
end;

execute is
begin
	this.[CL_PROFIT]:=P_CL_PROFIT;
end;
end;
end;
