class HOOK_BANK;

@name('РЦ. Получить счет договора для собственных договоров')
@tag('COPIED')
method RC_ZDOG_ACC_1 is
/*
begin
	pragma IF_DEF( PSKOV );
		if P_DT then
			return p_dog.[ACCOUNT];
		end if;

		-- Псковское ОСБ: счета незав.расчетов по зачислению в филиалах ведутся в разрезе:
		-- от собственных участников (доп.счет с кодом "ACC_TR_FIL_Z") и от всех остальных
		declare
			dog_rc_dt ref [TRC];
			dog_rc_kt ref [TRC];
		begin
			if p_doc_rc is null then
				dog_rc_dt := ::[DOCUM_RC].[LIB_NEW].[get_dog](p_doc.[KL_DT].[2].[PART],null,p_doc.[VALUTA]);
				dog_rc_kt := ::[DOCUM_RC].[LIB_NEW].[get_dog](p_doc.[KL_KT].[2].[PART],null,nvl(p_doc.[VALUTA_PO],p_doc.[VALUTA]));
			else
				dog_rc_dt := p_doc_rc.[DOG_SD];
				dog_rc_kt := p_doc_rc.[DOG_RC];
			end if;
			if dog_rc_kt = p_dog and
			   dog_rc_kt.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'Z') and
			   dog_rc_dt.[TYPE_DOG] = ::[CONTRACT_TYPE]([IDENT] = 'Z') and
			   dog_rc_kt.[ACCOUNT] is not NULL
			then
				for x in p_dog.[ARRAY_DOG_ACC] where x.[NAME_ACCOUNT] = ::[TIP_ACC]([COD] = 'ACC_TR_FIL_Z') loop
					return x.[ACCOUNT_DOG].[1].[2];
				end loop;
			end if;
		end;
	pragma END_IF;
end;
*/
RC_ZDOG_ACC_1 (
	@name('Договор РЦ')         P_DOG    in [TRC_REF],
	@name('Документ РЦ')        P_DOC_RC in [DOCUM_RC_REF],
	@name('Платежный документ') P_DOC    in [MAIN_DOCUM_REF],
	@name('Признак дебета')     P_DT     in [BOOLEAN]
) return [AC_FIN_REF] is

execute is
begin
	-->> PSH VRI 20/01/2026 CFT-3348 Автоматизация обработки межбанковского вознаграждения / CFT-3528
	if P_DOC_RC.[SDCLCODE] = '0020000000' and P_DOC_RC.[RCCLCODE] = '0030000000' 
		and ( 
				(P_DOC_RC.[ORIGINAL].[TYPE_DOC] = '001' and P_DOC_RC.[RECEIVER].[ACC] is null)
				 or
				(P_DOC_RC.[ORIGINAL].[TYPE_DOC] = '002' and P_DOC_RC.[PAYER].[ACC] is null)
			)
	then
		for (select rec(rec.[PATTERN_CORR] obj)
				in ::[ANALYTIC_CODE]([CODE] = 'PSB_RC_ZDOG_ACC_1').[PATT_NORMAL]
				where P_DOC_RC.[ORIGINAL].[TYPE_DOC] = substr(rec.[PATTERN], 1, instr(rec.[PATTERN], '|') - 1)
					and instr(upper(P_DOC_RC.[DEST]), upper(substr(rec.[PATTERN], instr(rec.[PATTERN], '|') + 1, (instr(rec.[PATTERN], '|', - 1) - instr(rec.[PATTERN], '|') - 1)))) > 0
					and (P_DOC_RC.[ANS_DOC_1].[BUSINES_SCENARIO] = substr(rec.[PATTERN], instr(rec.[PATTERN], '|', - 1) + 1) or P_DOC_RC.[ANS_DOC_1].[BUSINES_SCENARIO] is null)
					and rec.[PRODUCT] = ::[PATTERN_PRODUCT]([CODE] = 'PSB_NORM_DT_KT')
	 				and rec.[OR_DOWN] = '1'
			)
		loop
			return ::[AC_FIN]([MAIN_V_ID] = rec.obj and [DATE_CLOSE] is null)%id;
		end loop;
	end if;
	--<< PSH VRI 20/01/2026 CFT-3348 Автоматизация обработки межбанковского вознаграждения / CFT-3528
	
	return null;
	
	/*if P_DOC_RC.[ORIGINAL].[TYPE_DOC] = '002' and instr(P_DOC_RC.[DEST],'Межбанковское вознаграждение по реестру')>0  then --and P_DOC_RC.RECEIVER.ACC is null	
		return ::[AC_FIN]([MAIN_V_ID] = '70606810401004710413' and [DATE_CLOSE] is null)%id; --4140405573;
	elsif P_DOC_RC.[ORIGINAL].[TYPE_DOC] = '002' and instr(P_DOC_RC.[DEST],'Оплата услуг Банка России')>0  then
		return ::[AC_FIN]([MAIN_V_ID] = '70606810801004710301' and [DATE_CLOSE] is null)%id;
	else
		return null;
	end if;*/
end;
end;
end;
