-- ============================================================================
--  4: v50.SQL.CONNECTBY.п.1.8 - Замена CONNECT BY на WITH RECURSIVE
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена CONNECT BY на WITH RECURSIVE
--   Подробное описание: Иерархические запросы с CONNECT BY не поддерживаются. Использовать рекурсивные CTE: WITH RECURSIVE. Нет аналога NOCYCLE. Иерархические запросы по метаданным запрещены.
--   Пример кода (плохой): select * from t connect by prior id = parent_id start with parent_id is null
--   Пример кода (исправленный): with recursive cte as (select * from t where parent_id is null union all select t2.* from t t2 join cte on t2.parent_id = cte.id) select * from cte
--   Теги: v50, SQL, CONNECTBY, п, 1, 8
-- 4.RUBRICATOR_PROMPTS.json (расширенный):
--   documentation_text: Иерархические запросы с CONNECT BY не поддерживаются. Использовать рекурсивные CTE: WITH RECURSIVE. Нет аналога NOCYCLE. Иерархические запросы по метаданным запрещены.
--   plplus_materials_note: CONNECT BY — Oracle синтаксис, в PostgreSQL нет.
--   search_prompt: Найти использование CONNECT BY в запросах. Игнорировать комментарии.
--   regex_patterns.for_search: (1) CONNECT BY
--   code_example_bad: select * from t connect by prior id = parent_id start with parent_id is null
--   fix_instruction: Преобразовать CONNECT BY в WITH RECURSIVE:
WITH RECURSIVE cte AS (
  SELECT * FROM t WHERE start_condition
  UNION ALL
  SELECT t2.* FROM t t2 JOIN cte ON t2.parent_id = cte.id
) SELECT * FROM cte
--   test_generation_prompt: Сгенерировать тестовый PLPlus файл для проверки правила 'v50.SQL.CONNECTBY.п.1.8' с проблемными конструкциями.
--   examples.simple.bad: select * from t connect by prior id = parent_id start with parent_id is null
--   examples.simple.good: with recursive cte as (select * from t where parent_id is null union all select t2.* from t t2 join cte on t2.parent_id = cte.id) select * from cte
--   priority: HIGH
--   category: SQL
--   subcategory: SQL.DML.HIERARCHICAL
--   source_files: v50.docx
--   source_sections: 8
-- ============================================================================
PROCEDURE v50_SQL_CONNECTBY_p_1_8 IS
	-- Объявления переменных из примеров
BEGIN
	-- [-] Неправильный код
	-- begin pl/sql
		select * from t connect by prior id = parent_id start with parent_id is null
	-- end pl/sql

	-- [+] Исправленный код
	-- begin pl/sql
		with recursive cte as (select * from t where parent_id is null union all select t2.* from t t2 join cte on t2.parent_id = cte.id) select * from cte
	-- end pl/sql
END;


-- ============================================================================
--  5: v50.SQL.DECODE.п.1.6.1 - Замена DECODE на CASE
-- ============================================================================
-- 3.RUBRICATOR_FIXES.md:
--   Короткое описание: Замена DECODE на CASE
--   Подробное описание: Функция DECODE специфична для Oracle. Заменять на ANSI-конструкцию CASE WHEN. В ТЯ 7.6.10.10 при APPLICATION.DBI = 1 реализована компиляция decode в case, но при ошибке требуется ручная замена.
--   Пример кода (плохой): select decode(status,1,'A',2,'B','?') from t
--   Пример кода (исправленный): select case status when 1 then 'A' when 2 then 'B' else '?' end from t
--   Теги: v50, SQL, DECODE, п, 1, 6, 1
-- 4.RUBRICATOR_PROMPTS.json (расширенный):
--   documentation_text: Функция DECODE специфична для Oracle. Заменять на ANSI-конструкцию CASE WHEN. В ТЯ 7.6.10.10 при APPLICATION.DBI = 1 реализована компиляция decode в case, но при ошибке требуется ручная замена.
--   plplus_materials_note: DECODE не рекомендуется использовать в новом коде из-за неявного приведения типов.
--   search_prompt: Найти вызовы функции DECODE в SQL-запросах. Игнорировать комментарии.
--   regex_patterns.for_search: (1) Вызов DECODE
--   code_example_bad: select decode(status,1,'A',2,'B','?') from t
--   fix_instruction: Заменить DECODE на CASE WHEN:
DECODE(expr, v1, r1, v2, r2, default) -> CASE expr WHEN v1 THEN r1 WHEN v2 THEN r2 ELSE default END
--   test_generation_prompt: Сгенерировать тестовый PLPlus файл для проверки правила 'v50.SQL.DECODE.п.1.6.1' с проблемными конструкциями.
--   examples.simple.bad: select decode(status,1,'A',2,'B','?') from t
--   examples.simple.good: select case status when 1 then 'A' when 2 then 'B' else '?' end from t
--   priority: HIGH
--   category: SQL
--   subcategory: SQL.DML.FUNCTIONS
--   source_files: v50.docx
--   source_sections: 1
-- ============================================================================
PROCEDURE v50_SQL_DECODE_p_1_6_1 IS
	-- Объявления переменных из примеров
BEGIN
	-- [-] Неправильный код
	-- begin pl/sql
		select decode(status,1,'A',2,'B','?') from t
	-- end pl/sql

	-- [+] Исправленный код
	-- begin pl/sql
		select case status when 1 then 'A' when 2 then 'B' else '?' end from t
	-- end pl/sql
END;


