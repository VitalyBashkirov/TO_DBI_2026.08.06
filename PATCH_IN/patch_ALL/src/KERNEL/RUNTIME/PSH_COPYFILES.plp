class RUNTIME;

@import_plsql(true)
@name('[ПСБ] Вызов копирования файлов из клиент-скрипта')
@tag('COPIED')
static method PSH_COPYFILES is

@name('Количество файлов') public V_COUNT [NUM10];
PSH_COPYFILES is

execute is
/*********************************************************************
Назначение: позволяет вызывать операцию копирования файла [DOCUMENT].[COPYFILES] многократно через клиент-скрипт.
Операция определена как недоступная пользователю и не отображает экранную форму.
Параметр V_COUNT передаётся при вызове операции и определяет количество вызовов операции [DOCUMENT].[COPYFILES].

*********************************************************************/
begin
	null;
end;
end;
end;
